<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('team_header_eyebrow') %></span>
    <h1><%= C('team_header_t1') %> <span style="color:var(--accent);"><%= C('team_header_accent') %></span></h1>
    <p><%= C('team_header_sub') %></p>
  </div>
</header>

<%
  function renderGrid(members) {
%>
  <% if (members && members.length) { %>
    <div class="leaders-grid reveal-stagger">
      <% members.forEach(m => { %>
        <% const displayName = m.user_full_name || m.name; %>
        <% const displayImg  = m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg'; %>
        <% if (m.user_username) { %>
          <a href="/profile/<%= m.user_username %>" class="leader-card has-image linked-member">
            <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
            <div class="leader-body">
              <h3><%= displayName %></h3>
              <p class="role"><%= m.role %></p>
              <% if (m.bio) { %><p class="leader-bio"><%= m.bio %></p><% } %>
              <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল দেখুন</span>
            </div>
          </a>
        <% } else { %>
          <div class="leader-card has-image">
            <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
            <div class="leader-body">
              <h3><%= displayName %></h3>
              <p class="role"><%= m.role %></p>
              <% if (m.bio) { %><p class="leader-bio"><%= m.bio %></p><% } %>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-users"></i>
      <h3>এই ক্যাটাগরিতে এখনও কোনো সদস্য যোগ হয়নি</h3>
    </div>
  <% } %>
<%
  }
%>

<!-- Central committee -->
<section class="section reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">কেন্দ্রীয়</span>
        <h2 class="section-title">কেন্দ্রীয় <span class="accent">কার্যনির্বাহী কমিটি</span><% if (centralTerm) { %> (<%= centralTerm %>)<% } %></h2>
        <span class="accent-divider"></span>
      </div>
    </div>
    <% renderGrid(central); %>
  </div>
</section>

<!-- Advisory board -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">উপদেষ্টা</span>
        <h2 class="section-title">উপদেষ্টা <span class="accent">পর্ষদ</span></h2>
        <span class="accent-divider"></span>
      </div>
    </div>
    <% renderGrid(advisory); %>
  </div>
</section>

<!-- Founders -->
<section class="section reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">প্রতিষ্ঠাতা</span>
        <h2 class="section-title">প্রতিষ্ঠাতা <span class="accent">সদস্য</span></h2>
        <span class="accent-divider"></span>
      </div>
    </div>
    <% renderGrid(founders); %>
  </div>
</section>

<!-- Branch committees -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">বিশ্ববিদ্যালয় শাখা</span>
        <h2 class="section-title">বিশ্ববিদ্যালয় <span class="accent">শাখা কমিটি</span></h2>
        <span class="accent-divider"></span>
      </div>
    </div>
    <% renderGrid(branch); %>
  </div>
</section>
