<header class="page-header">
  <div class="container">
    <span class="eyebrow">পরামর্শদাতা</span>
    <h1>উপদেষ্টা পরিষদ</h1>
    <p>বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়। সংগঠনের পরামর্শদাতামণ্ডলী</p>
  </div>
</header>

<style>
.adv-filter-bar {
  display: flex; justify-content: flex-end; align-items: center;
  gap: 10px; margin-bottom: 20px;
}
.adv-filter-bar label {
  font-size: 14px; font-weight: 600; color: var(--text-soft, #475569);
  font-family: 'Hind Siliguri', sans-serif !important;
}
.adv-filter-bar select {
  padding: 8px 16px; border: 1.5px solid var(--border, #e2e8f0);
  border-radius: 5px; background: #fff; font-family: 'Hind Siliguri', sans-serif !important;
  font-size: 14px; color: var(--text, #334155); cursor: pointer;
  transition: border-color .15s;
}
.adv-filter-bar select:focus {
  outline: none; border-color: var(--accent, #059669);
}
.adv-year-group { margin-bottom: 32px; }
.adv-year-label {
  font-size: 16px; font-weight: 700; color: var(--brand, #0a1f44);
  margin-bottom: 12px; padding-bottom: 6px;
  border-bottom: 2px solid var(--accent, #059669);
  display: inline-block;
}
.leader-card { position: relative; overflow: hidden; }
.leader-card img { transition: transform .35s ease; }
.leader-card:hover img { transform: scale(1.06); }
.leader-card.linked-member::after {
  content: '\f061';
  font-family: 'Font Awesome 6 Free'; font-weight: 900;
  position: absolute; top: 12px; right: 12px;
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--accent, #059669); color: #fff; font-size: 0.72rem;
  opacity: 0; transform: translate(6px, -6px);
  transition: opacity .2s, transform .2s;
}
.leader-card.linked-member:hover::after { opacity: 1; transform: translate(0, 0); }
.member-term-tag {
  position: absolute; top: 12px; left: 12px; z-index: 1;
  padding: 3px 10px; border-radius: 999px;
  background: rgba(10,31,68,.82); color: #fff;
  font-size: 0.68rem; font-weight: 700; letter-spacing: .02em;
  backdrop-filter: blur(3px);
}
.term-empty {
  text-align: center; padding: 54px 24px;
  background: var(--bg-soft, #f8fafc);
  border: 1.5px dashed var(--border, #cbd5e1); border-radius: 16px;
}
.term-empty i { font-size: 2rem; color: var(--accent, #059669); margin-bottom: 12px; }
.term-empty h3 { margin: 0 0 6px; color: var(--brand, #0a1f44); font-size: 1.15rem; }
.term-empty p { margin: 0; color: var(--text-muted, #64748b); font-size: .93rem; }
</style>

<% const bnNum = (n) => String(n).replace(/[0-9]/g, (d) => '০১২৩৪৫৬৭৮৯'[d]); %>

<%
  // Group advisors by term_year
  const bnTermSort = (s) => parseInt(String(s || '').replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d)), 10) || 0;
  const yearGroups = {};
  const noYearAdvisors = [];
  advisory.forEach(m => {
    const terms = (m.terms && m.terms.length) ? m.terms : (m.term_year ? [m.term_year] : []);
    if (terms.length === 0) {
      noYearAdvisors.push(m);
    } else {
      terms.forEach(t => {
        if (!yearGroups[t]) yearGroups[t] = [];
        yearGroups[t].push(m);
      });
    }
  });
  const sortedYears = Object.keys(yearGroups).sort((a, b) => bnTermSort(b) - bnTermSort(a));
%>

<section class="section reveal">
  <div class="container">

    <% if (sortedYears.length > 0) { %>
    <!-- কার্যবর্ষ ড্রপডাউন ফিল্টার -->
    <div class="adv-filter-bar">
      <label for="advYearFilter"><i class="fas fa-calendar-alt"></i> কার্যবর্ষ:</label>
      <select id="advYearFilter" onchange="filterAdvisoryYear(this.value)">
        <option value="all">সকল কার্যবর্ষ</option>
        <% sortedYears.forEach(y => { %>
          <option value="<%= y %>"><%= y %></option>
        <% }) %>
      </select>
    </div>
    <% } %>

    <% if (advisory && advisory.length) { %>

      <% // Render year-grouped advisors %>
      <% sortedYears.forEach((year) => { %>
        <div class="adv-year-group" data-year="<%= year %>">
          <div class="adv-year-label"><i class="far fa-calendar"></i> <%= year %> কার্যবর্ষ — <%= bnNum(yearGroups[year].length) %> জন</div>
          <div class="leaders-grid">
            <% yearGroups[year].forEach(m => { %>
              <% const displayName = m.user_full_name || m.name; %>
              <% const displayImg  = m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg'; %>
              <% if (m.user_username) { %>
                <a href="/profile/<%= m.user_username %>" class="leader-card has-image clickable-card linked-member">
                  <span class="member-term-tag"><%= year %></span>
                  <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" />
                  <div class="leader-body">
                    <h3><%= displayName %></h3>
                    <p class="role"><%= m.role %></p>
                    <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
                  </div>
                </a>
              <% } else { %>
                <div class="leader-card has-image clickable-card">
                  <span class="member-term-tag"><%= year %></span>
                  <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" />
                  <div class="leader-body">
                    <h3><%= displayName %></h3>
                    <p class="role"><%= m.role %></p>
                    <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
                  </div>
                </div>
              <% } %>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <% // Render advisors without term_year (no year header) %>
      <% if (noYearAdvisors.length > 0) { %>
        <div class="adv-year-group" data-year="no-year">
          <% if (sortedYears.length > 0) { %>
            <div class="adv-year-label"><i class="fas fa-users"></i> সাধারণ উপদেষ্টা — <%= bnNum(noYearAdvisors.length) %> জন</div>
          <% } %>
          <div class="leaders-grid">
            <% noYearAdvisors.forEach(m => { %>
              <% const displayName = m.user_full_name || m.name; %>
              <% const displayImg  = m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg'; %>
              <% if (m.user_username) { %>
                <a href="/profile/<%= m.user_username %>" class="leader-card has-image clickable-card linked-member">
                  <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" />
                  <div class="leader-body">
                    <h3><%= displayName %></h3>
                    <p class="role"><%= m.role %></p>
                    <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
                  </div>
                </a>
              <% } else { %>
                <div class="leader-card has-image clickable-card">
                  <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" />
                  <div class="leader-body">
                    <h3><%= displayName %></h3>
                    <p class="role"><%= m.role %></p>
                    <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
                  </div>
                </div>
              <% } %>
            <% }) %>
          </div>
        </div>
      <% } %>

    <% } else { %>
      <div class="term-empty">
        <i class="far fa-folder-open"></i>
        <h3>উপদেষ্টাদের তালিকা এখনো সংরক্ষিত হয়নি</h3>
        <p>তথ্য পাওয়ামাত্র এখানে যুক্ত করা হবে, ইনশাআল্লাহ।</p>
      </div>
    <% } %>

  </div>
</section>

<script>
function filterAdvisoryYear(year) {
  const groups = document.querySelectorAll('.adv-year-group');
  groups.forEach(g => {
    if (year === 'all' || g.dataset.year === year || (year === 'no-year' && g.dataset.year === 'no-year')) {
      g.style.display = '';
    } else {
      g.style.display = 'none';
    }
  });
}
</script>
