<header class="page-header">
  <div class="container">
    <span class="eyebrow">পরামর্শদাতা</span>
    <h1>উপদেষ্টা পরিষদ</h1>
    <p>বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়। সংগঠনের পরামর্শদাতামণ্ডলী</p>
  </div>
</header>

<style>
.term-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.term-chip {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 8px 16px; border-radius: 999px;
  border: 1.5px solid var(--border, #e2e8f0);
  background: #fff; color: var(--text, #334155);
  font-size: 0.92rem; font-weight: 600; text-decoration: none;
  transition: border-color .18s, background .18s, color .18s, transform .18s, box-shadow .18s;
}
.term-chip:hover { border-color: var(--accent, #059669); color: var(--accent, #059669); transform: translateY(-1px); }
.term-chip.active {
  background: var(--accent, #059669); border-color: var(--accent, #059669);
  color: #fff; box-shadow: 0 6px 16px rgba(5,150,105,.25);
}
.term-chip .tc-count {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 22px; height: 20px; padding: 0 6px; border-radius: 999px;
  background: rgba(5,150,105,.12); color: var(--accent, #059669);
  font-size: 0.74rem; font-weight: 700;
}
.leader-card { position: relative; overflow: hidden; }
.leader-card img { transition: transform .35s ease; }
.leader-card:hover img { transform: scale(1.06); }
.leader-card.linked-member::after {
  content: '\f061';
  font-family: 'Font Awesome 6 Free'; font-weight: 900;
  position: absolute; top: 12px; right: 12px;
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--accent, #059669); color: #fff; font-size: 0.72rem;
  opacity: 0; transform: translate(6px, -6px);
  transition: opacity .2s, transform .2s;
}
.leader-card.linked-member:hover::after { opacity: 1; transform: translate(0, 0); }
.member-term-tag {
  position: absolute; top: 12px; left: 12px; z-index: 1;
  padding: 3px 10px; border-radius: 999px;
  background: rgba(10,31,68,.82); color: #fff;
  font-size: 0.68rem; font-weight: 700; letter-spacing: .02em;
  backdrop-filter: blur(3px);
}
.term-empty {
  text-align: center; padding: 54px 24px;
  background: var(--bg-soft, #f8fafc);
  border: 1.5px dashed var(--border, #cbd5e1); border-radius: 16px;
}
.term-empty i { font-size: 2rem; color: var(--accent, #059669); margin-bottom: 12px; }
.term-empty h3 { margin: 0 0 6px; color: var(--brand, #0a1f44); font-size: 1.15rem; }
.term-empty p { margin: 0; color: var(--text-muted, #64748b); font-size: .93rem; }
</style>

<% const bnNum = (n) => String(n).replace(/[0-9]/g, (d) => '০১২৩৪৫৬৭৮৯'[d]); %>

<%
  // Group advisors by term_year
  const bnTermSort = (s) => parseInt(String(s || '').replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d)), 10) || 0;
  const yearGroups = {};
  advisory.forEach(m => {
    const terms = (m.terms && m.terms.length) ? m.terms : (m.term_year ? [m.term_year] : ['অনির্দিষ্ট']);
    terms.forEach(t => {
      if (!yearGroups[t]) yearGroups[t] = [];
      yearGroups[t].push(m);
    });
  });
  const sortedYears = Object.keys(yearGroups).sort((a, b) => bnTermSort(b) - bnTermSort(a));
%>

<% if (advisory && advisory.length) { %>
  <% sortedYears.forEach((year, gi) => { %>
    <section class="section reveal" style="padding-top:<%= gi === 0 ? '20px' : '0' %>">
      <div class="container">
        <div class="section-head" style="flex-direction:column;align-items:flex-start;gap:10px">
          <div>
            <span class="eyebrow"><i class="far fa-calendar"></i> <%= year %> কার্যবর্ষ</span>
            <h2 class="section-title">উপদেষ্টা <span class="accent">পরিষদ</span> (<%= year %>)</h2>
            <span class="accent-divider"></span>
            <p class="term-intro">এই কার্যবর্ষে <strong><%= bnNum(yearGroups[year].length) %></strong> জন উপদেষ্টা।</p>
          </div>
        </div>
        <div class="leaders-grid" style="margin-top:20px">
          <% yearGroups[year].forEach(m => { %>
            <% const displayName = m.user_full_name || m.name; %>
            <% const displayImg  = m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg'; %>
            <% if (m.user_username) { %>
              <a href="/profile/<%= m.user_username %>" class="leader-card has-image clickable-card linked-member">
                <span class="member-term-tag"><%= year %></span>
                <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" />
                <div class="leader-body">
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                  <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
                </div>
              </a>
            <% } else { %>
              <div class="leader-card has-image clickable-card"
                   onclick="openMemberModal('adv-<%= m.id %>')"
                   data-member="adv-<%= m.id %>"
                   data-name="<%= String(m.name).replace(/'/g, '&#39;') %>"
                   data-role="<%= String(m.role || '').replace(/'/g, '&#39;') %>"
                   data-designation="<%= String(m.designation || '').replace(/'/g, '&#39;').replace(/"/g, '&quot;') %>"
                   data-bio="<%= String(m.bio || '').replace(/'/g, '&#39;').replace(/"/g, '&quot;') %>"
                   data-image="<%= m.image_url || '/assets/img/avatar-placeholder.svg' %>">
                <span class="member-term-tag"><%= year %></span>
                <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" />
                <div class="leader-body">
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                  <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>
<% } else { %>
  <section class="section reveal">
    <div class="container">
      <div class="term-empty" style="margin-top:26px">
        <i class="far fa-folder-open"></i>
        <h3>উপদেষ্টাদের তালিকা এখনো সংরক্ষিত হয়নি</h3>
        <p>তথ্য পাওয়ামাত্র এখানে যুক্ত করা হবে, ইনশাআল্লাহ।</p>
      </div>
    </div>
  </section>
<% } %>

<!-- বিস্তারিত মডাল -->
<div class="modal-overlay" id="memberModal" onclick="if(event.target===this) closeMemberModal()">
  <div class="modal-dialog">
    <div class="modal-head">
      <h3>বিস্তারিত</h3>
      <button class="modal-close" onclick="closeMemberModal()" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-member-inner" id="modalBody"></div>
  </div>
</div>

<script>
function openMemberModal(id) {
  const card = document.querySelector('[data-member="' + id + '"]');
  if (!card) return;
  const data = {
    name: card.dataset.name,
    role: card.dataset.role,
    designation: card.dataset.designation,
    bio: card.dataset.bio,
    image: card.dataset.image
  };
  const body = document.getElementById('modalBody');
  body.innerHTML = '<img loading="lazy" decoding="async" src="' + data.image + '" alt="' + data.name + '">'
    + '<h3 class="mm-name">' + data.name + '</h3>'
    + '<p class="mm-role">' + data.role + '</p>'
    + (data.designation ? '<p class="mm-desig">' + data.designation + '</p>' : '')
    + (data.bio ? '<p class="mm-bio">' + data.bio + '</p>' : '<p class="mm-bio" style="text-align:center;color:var(--text-muted)">বিস্তারিত বিবরণ শীঘ্রই যোগ করা হবে।</p>');
  document.getElementById('memberModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeMemberModal() {
  document.getElementById('memberModal').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMemberModal(); });
</script>
