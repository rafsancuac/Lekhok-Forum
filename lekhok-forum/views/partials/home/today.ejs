                <span class="epk291-edge"></span>
                <span class="epk291-backname" id="epk291BackL">—</span>
                <span class="epk291-mocklines"></span>
              </div>
              <div class="epk291-sheet epk291-back epk291-back-r" aria-hidden="true">
                <span class="epk291-edge"></span>
                <span class="epk291-backname" id="epk291BackR">—</span>
                <span class="epk291-mocklines"></span>
              </div>
              <a class="epk291-sheet epk291-front" id="epk291Front" href="<%= teHref233(teActive233) %>">
                <span class="epk291-edge" aria-hidden="true"></span>
                <span class="epk291-fold" aria-hidden="true"></span>
                <span class="epk291-masthead">
                  <span class="epk291-kicker"><%= teHasToday233 ? 'আজকের মুদ্রিত সংস্করণ' : 'সর্বশেষ সিঙ্কড সংস্করণ' %></span>
                  <span class="epk291-name" id="epk291Name"><%= teActive233 ? teActive233.paperName : 'ই-পেপার' %></span>
                  <span class="epk291-rule" aria-hidden="true"></span>
                  <span class="epk291-dateline"><%= teDateBn291 %></span>
                </span>
                <span class="epk291-media">
                  <%# সেশন ২৯১: প্রথম-পেপারের থাম্ব SSR-প্রি-রেন্ডার (no-JS-এও সঠিক; একক-ট্যাগ — দ্বৈত-id-শূন্য) %>
                  <img class="epk291-img" id="epk291Img" <%- teImgAttrs291 %> loading="lazy" decoding="async">
                  <span class="epk291-mockcols" id="epk291Mock" aria-hidden="true" <%- teFirstThumb291 ? 'hidden' : '' %>>
                    <span class="epk291-mcol"></span><span class="epk291-mcol epk291-mcol-mid"></span><span class="epk291-mcol"></span>
                  </span>
                </span>
                <span class="epk291-foot">
                  <span>লেখক ফোরাম ডিজিটাল সংস্করণ</span>
                  <span class="epk291-turn">পাতা উল্টান <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                </span>
              </a>
            </div>

            <!-- ফিল্মস্ট্রিপ -->
            <div class="epk291-filmwrap">
              <div class="epk291-film" id="epk291Film" role="tablist" aria-label="আজকের পত্রিকা নির্বাচন">
                <% tePapers233.forEach((p, i) => { %>
                <button type="button" role="tab" class="epk291-film-btn"
                        aria-selected="<%= i === 0 ? 'true' : 'false' %>"
                        data-epk-i="<%= i %>"
                        style="--epkAcc291: <%= teAcc291(i) %>">
                  <% if (p.thumb) { %><span class="epk291-film-thumb" aria-hidden="true"><img class="epk291-film-thumb-img" src="<%= p.thumb %>" alt="" loading="lazy" decoding="async"></span><% } %>
                  <span class="epk291-film-kicker">দৈনিক</span>
                  <span class="epk291-film-name"><%= p.paperName %></span>
                </button>
                <% }) %>
              </div>
            </div>

            <!-- স্ক্রিন-রিডার ঘোষণা -->
            <p class="epk291-live" id="epk291Live" aria-live="polite"></p>
          </div>
          <% } else { %>
          <div class="te-card233">
            <div class="te-cardhead233">
              <div class="te-ico233" aria-hidden="true"><i class="fas fa-newspaper"></i></div>
              <div class="te-cardbody233">
                <div class="te-namerow233">
                  <h4 class="te-name233">ই-পেপার আর্কাইভ</h4>
                </div>
                <p class="te-cardsub233">দৈনিক পত্রিকার সংরক্ষিত সংস্করণ</p>
                <div class="te-meta233">
                  <span class="te-metachip233"><i class="fas fa-book-open" aria-hidden="true"></i> পৃষ্ঠা উল্টে পড়ার ভিউয়ার</span>
                  <span class="te-metachip233"><i class="fas fa-print" aria-hidden="true"></i> হাই-রেজোলিউশন প্রিন্ট</span>
                </div>
              </div>
              <a href="/epaper" class="te-go233" aria-label="ই-পেপার খুলুন"><i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="te-pillrow233">
              <span class="te-pilllabel233">দ্রুত পড়ুন:</span>
              <div class="te-pills233">
                <a href="/epaper" class="te-pill233">আর্কাইভ দেখুন</a>
                <% if (typeof epaperLatestDateBn !== 'undefined' && epaperLatestDateBn) { %>
                <span class="te-pillsoon233">আজকের সংস্করণ আসন্ন — সর্বশেষ: <%= epaperLatestDateBn %></span>
                <% } %>
              </div>
