  var current = 0, timer = null, paused = false;
  var pagesEl311 = document.getElementById('epk310Pages');   /* সেশন ৩১১: ব্যাজ-র‍্যাপার */
  var pagesTxt311 = document.getElementById('epk310PagesTxt'); /* সেশন ৩১১: ব্যাজ-টেক্সট */

  /* ═══ সেশন ৩২৬: কভার-লোডার — সব-কভার একসাথে প্রি-লোড (অগ্রাধিকার-ক্রম, সমান্তরাল ≤৩), ধীর-উৎসে হেজড-প্যারালাল-রিট্রাই,
         ব্যর্থে ব্যাকঅফ-রিট্রাই (cache-buster); অটো-স্লাইড শুধু প্রস্তুত-কভারে যায় — কখনো "কয়েকটা আসে, কয়েকটা আসে না" নয় ═══ */
  var HEDGE_MS = 2200, ATTEMPT_MS = 12000, MAX_FAILS = 3;
  var cov = papers.map(function () { return { state: 'idle', src: '', img: null, p: null, fails: 0 }; });
  function chainFor310(i) {
    var p = papers[i];
    if (!p) return [];
    var c310 = (p.thumbs && p.thumbs.length) ? p.thumbs.slice() : [];
