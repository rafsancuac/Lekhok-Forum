              <i class="fas fa-newspaper" aria-hidden="true"></i>
              <span id="teKioskCtaText291"><%= teActive233 ? (teActive233.paperName + ' পড়ুন') : (teHasToday233 ? 'আজকের ই-পেপার পড়ুন' : 'সর্বশেষ ই-পেপার পড়ুন') %></span>
              <i class="fas fa-arrow-right te-arrow233" aria-hidden="true"></i>
            </a>
            <a href="/epaper" class="te-btn233 te-btn-ghost233">
              <i class="fas fa-book-open" aria-hidden="true"></i>
              <span>পুরোনো পেপার আর্কাইভ</span>
