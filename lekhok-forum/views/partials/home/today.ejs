<%# সেশন ৩১০: ফুল-কভার স্লাইডার-ইঞ্জিন — অটো-স্লাইড ৪সে + hover/focus-পজ + IO/ট্যাব-গেট +
    সোয়াইপ + ডট-নেভিগেশন + CTA-সিঙ্ক + ইমেজ-চেইন (২-স্ট্রাইক) + QA-হুক-পরিবার ── %>
<script>
(function () {
  if (window.__epk310wired) return; window.__epk310wired = true;
  var kiosk = document.getElementById('epKiosk310');
  var papers = <%- teJson310 %>;

  /* session297-চুক্তি: ভিউপোর্ট-সচেতন অটো-স্লাইড-স্টেট + QA-হুক (papers-শূন্যে-ও সংজ্ঞায়িত) */
  var epk310InView = true, epk310TabVisible = true, epk310TickN = 0, epk310IO = null;
  function qaSync310() {}
  window.__epk297QA = {
    inView: function () { return epk310InView; },
    tabVisible: function () { return epk310TabVisible; },
    ioOn: function () { return !!epk310IO; },
    timerOn: function () { return !!timer; },
    tickN: function () { return epk310TickN; },
    current: function () { return papers.length ? current : -1; },
    tick: function () { if (papers.length) { applySlide((current + 1) % papers.length); return true; } return false; },
    sync: qaSync310
  };
  window.__epk310QA = {
    count: function () { return papers.length; },
    current: function () { return papers.length ? current : -1; },
    colorAt: function (i) { return papers[i] ? papers[i].color : ''; },
    hrefAt: function (i) { return papers[i] ? papers[i].href : ''; },
    nameAt: function (i) { return papers[i] ? papers[i].name : ''; },
    mastShown: function () { return !!(mast && !mast.hidden); },
    tickN: function () { return epk310TickN; },
    tick: window.__epk297QA.tick
  };

  /* session299-চুক্তি: রিডার-ডিপ-লিংক-প্রিফেচ-ফানেল (ডিডুপ + অফলাইন/saveData-গার্ড) */
  var epk299Count = 0, epk299Warmed = {}, epk299Last = '';
  window.__epk299QA = {
    prefetched: function () { return epk299Count; },
    has: function (u) { return !!epk299Warmed[u]; },
    last: function () { return epk299Last; },
    links: function () { try { return document.querySelectorAll('link[rel="prefetch"][data-epk299]').length; } catch (e299) { return 0; } }
  };
  if (!papers.length || !kiosk) return;

  function epk299Prefetch299(url, reason299) {
    if (!url || epk299Warmed[url]) return false;
    var cn299 = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    if (navigator.onLine === false || (cn299 && cn299.saveData)) return false;
    epk299Warmed[url] = String(reason299 || 'intent');
    epk299Count++; epk299Last = String(reason299 || 'intent');
    try {
      var l299 = document.createElement('link');
      l299.rel = 'prefetch'; l299.as = 'document'; l299.href = url;
      l299.setAttribute('data-epk299', '1');
      document.head.appendChild(l299);
    } catch (e299) {}
    return true;
  }

  var reduceMotion = false;
  try { reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  var card = document.getElementById('epk310Card'),
      stripe = document.getElementById('epk310Stripe'),
      link = document.getElementById('epk310Link'),
      img = document.getElementById('epk310Img'),
      mast = document.getElementById('epk310Mast'),
      mastName = document.getElementById('epk310MastName'),
      hoverName = document.getElementById('epk310HoverName'),
      footLink = document.getElementById('epk310FootLink'),
      countEl = document.getElementById('epk310Count'),
      live = document.getElementById('epk310Live'),
      dotsWrap = document.getElementById('epk310Dots'),
      dots = dotsWrap ? Array.prototype.slice.call(dotsWrap.querySelectorAll('.epk310-dot')) : [],
      stage = document.getElementById('epk310Stage');

  var current = 0, timer = null, paused = false;

  /* ── ইমেজ-চেইন: সারির-নিজ-সম্পদ + ২-স্ট্রাইক রিট্রাই (cache-buster) — কখনো ভাঙা-ছবি নয় ── */
  var chain = [], strikes = {}, loadedFor = -1;
  function showImg310() {
    if (img.complete && img.naturalWidth > 0 && img.getAttribute('src')) { img.hidden = false; mast.hidden = true; }
  }
  function chainFor310(i) {
    var p = papers[i];
    if (!p) return [];
    var c310 = (p.thumbs && p.thumbs.length) ? p.thumbs.slice() : [];
    if (p.thumb && c310.indexOf(p.thumb) === -1) c310.push(p.thumb);
    return c310;
  }
  function setImg310(i) {
    var p = papers[i];
    if (!p) return;
    chain = chainFor310(i);
    mastName.textContent = p.name;
    if (chain.length) {
      img.alt = p.name + ' — ই-পেপার প্রথম পাতা';
      img.hidden = true; mast.hidden = false; /* লোড-পর্যন্ত মাস্টহেড-দৃশ্যমান */
      img.src = chain[0];
      showImg310(); /* ক্যাশড-সোর্সে তাৎক্ষণিক */
    } else {
      img.hidden = true;
      img.removeAttribute('src');
      mast.hidden = false;
    }
  }
  img.addEventListener('load', function () {
    loadedFor = current;
    strikes[img.src] = 0;
    showImg310();
  });
  img.addEventListener('error', function () {
    var src310 = img.getAttribute('src');
    if (!chain.length || src310 !== chain[0]) return; /* বাসি-অনুরোধের error — উপেক্ষা */
    strikes[src310] = (strikes[src310] || 0) + 1;
    if (strikes[src310] < 2) { /* ২-স্ট্রাইক রিট্রাই — cache-buster */
      img.src = src310 + (src310.indexOf('?') !== -1 ? '&' : '?') + 'r=' + strikes[src310];
      return;
    }
    chain.shift();
    if (chain.length) { img.src = chain[0]; showImg310(); return; }
    img.hidden = true;
    img.removeAttribute('src');
    mast.hidden = false; /* সব-ব্যর্থে টেক্সট-মাস্টহেড */
  });

  /* ── স্লাইড-প্রয়োগ: fade-রিস্টার্ট + স্ট্রাইপ/ডট/CTA/কাউন্টার-সিঙ্ক ── */
  function applySlide(i) {
    var p = papers[i];
    if (!p) return;
    link.href = p.href;
    footLink.href = p.href;
    if (stripe) stripe.style.background = p.color;
    if (hoverName) hoverName.textContent = p.name;
    if (countEl) { countEl.textContent = bnDigits310(i + 1) + ' / ' + bnDigits310(papers.length); countEl.setAttribute('aria-label', 'স্লাইড ' + bnDigits310(i + 1) + ' / ' + bnDigits310(papers.length)); }
    if (live) live.textContent = 'প্রদর্শিত পত্রিকা: ' + p.name;
    var cta = document.getElementById('teKioskCta291'), ctaText = document.getElementById('teKioskCtaText291');
    if (cta && ctaText) { cta.href = p.href; ctaText.textContent = p.name + ' পড়ুন'; }
    dots.forEach(function (d, di) {
      d.setAttribute('aria-selected', di === i ? 'true' : 'false');
      d.style.background = di === i ? papers[di].color : 'var(--lf-line-strong, #CED0D4)';
    });
    setImg310(i);
    /* fade/উত্থান-অ্যানিমেশন রিস্টার্ট */
    if (!reduceMotion) {
      card.classList.remove('is-flip');
      void card.offsetWidth;
      card.classList.add('is-flip');
    }
    if (epk299Warmed[p.href]) link.classList.add('epk299-warm'); else link.classList.remove('epk299-warm');
    current = i;
  }
  function bnDigits310(n) { return String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); }

  /* ── অটো-স্লাইড: ৪ সেকেন্ড — hover/focus-পজ + IO/ট্যাব-গেট (session297-চুক্তি) ── */
  function startTimer() {
    if (reduceMotion || timer) return;
    timer = setInterval(function () {
      if (!paused && epk310InView && epk310TabVisible) { epk310TickN++; applySlide((current + 1) % papers.length); }
    }, 4000);
  }
  function resetTimer() { clearInterval(timer); timer = null; startTimer(); }
  function qaSync310Impl() {
    if (!papers.length) return;
    var run310 = epk310InView && epk310TabVisible;
    if (run310 && !timer) startTimer();
    else if (!run310 && timer) { clearInterval(timer); timer = null; }
  }
  qaSync310 = qaSync310Impl;

  /* ডট-ক্লিক/কীবোর্ড */
  dots.forEach(function (d) {
    d.addEventListener('click', function () {
      var i = parseInt(d.getAttribute('data-epk310-i'), 10);
      if (!isNaN(i) && papers[i]) { applySlide(i); resetTimer(); epk299Prefetch299(papers[i].href, 'select'); }
    });
    d.addEventListener('focus', function () { paused = true; });
    d.addEventListener('blur', function () { paused = false; });
  });
  if (dotsWrap) dotsWrap.addEventListener('keydown', function (e) {
    var n = papers.length;
    if (n <= 1) return;
    if (e.key === 'ArrowRight') { e.preventDefault(); applySlide((current + 1) % n); resetTimer(); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); applySlide((current - 1 + n) % n); resetTimer(); }
    else if (e.key === 'Home') { e.preventDefault(); applySlide(0); resetTimer(); }
    else if (e.key === 'End') { e.preventDefault(); applySlide(n - 1); resetTimer(); }
  });

  /* hover/focus-ইচ্ছা → প্রিফেচ-ফানেল (session299-চুক্তি) */
  function epk299Hover299() { if (papers[current]) epk299Prefetch299(papers[current].href, 'hover'); }
  link.addEventListener('mouseenter', epk299Hover299);
  link.addEventListener('focusin', epk299Hover299);
  var ctaEl = document.getElementById('teKioskCta291');
  if (ctaEl) ctaEl.addEventListener('mouseenter', function () { if (papers[current]) epk299Prefetch299(papers[current].href, 'cta'); });

  /* hover + keyboard-focus — দুই ক্ষেত্রেই থামে */
  var section = document.getElementById('today-epaper') || kiosk;
  section.addEventListener('mouseenter', function () { paused = true; });
  section.addEventListener('mouseleave', function () { paused = false; });
  kiosk.addEventListener('focusin', function () { paused = true; });
  kiosk.addEventListener('focusout', function (e) {
    if (!kiosk.contains(e.relatedTarget)) paused = false;
  });

  /* সোয়াইপ (মোবাইল) — threshold 42px */
  var swipeX310 = null;
  if (stage) {
    stage.addEventListener('pointerdown', function (e) { swipeX310 = e.clientX; });
    stage.addEventListener('pointerup', function (e) {
      if (swipeX310 == null) return;
      var d310 = e.clientX - swipeX310;
      if (Math.abs(d310) > 42) { var n310 = papers.length; applySlide(d310 < 0 ? (current + 1) % n310 : (current - 1 + n310) % n310); resetTimer(); }
      swipeX310 = null;
    });
  }

  /* IO + visibilitychange — অদৃশ্য-সেকশনে/ব্যাকগ্রাউন্ড-ট্যাবে টাইমার-সম্পূর্ণ-বন্ধ */
  try {
    if ('IntersectionObserver' in window) {
      epk310IO = new IntersectionObserver(function (entries310) {
        var en310 = entries310 && entries310[0];
        epk310InView = !!(en310 && en310.isIntersecting);
        qaSync310Impl();
      }, { threshold: 0.12 });
      epk310IO.observe(section);
    }
  } catch (e310) { epk310IO = null; epk310InView = true; }
  document.addEventListener('visibilitychange', function () {
    epk310TabVisible = !(document.hidden === true);
    qaSync310Impl();
  });

  applySlide(0);
  startTimer();
})();
</script>
