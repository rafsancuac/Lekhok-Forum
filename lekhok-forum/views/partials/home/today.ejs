<%# ── সেশন ২৩৩: "আজকের ই-পেপার" — ই-পেপার-কেন্দ্রিক প্রিমিয়াম শোকেস (ইউজার-স্পেক) ──
    পুরনো জেনেরিক 'আজকের কন্টেন্ট' ব্যান্ড (ক্যারোসেল-সহ) বাদ — এখন পুরোপুরি ডিজিটাল
    নিউজস্ট্যান্ড: বামে লাইভ-ব্যাজ + শিরোনাম + চেকমার্ক-পয়েন্ট + ডুয়াল-CTA, ডানে
    আজকের তাজা-সংস্করণ কার্ড (বাস্তব epaper_files ডেটা) + কুইক-সুইচ পিলস +
    অটো-সিঙ্ক স্ট্যাটাস। প্রতিটি পিল/অ্যারো /epaper?file=<id>-তে deep-link —
    epaper-অ্যাপের session233-boot-hook সেই পত্রিকাই সরাসরি খুলে দেয়।
    ডেটা: routes/pages.js home-route (epaperToday/epaperLatest/todayBn)।
    আজকের সংখ্যা না-থাকলে মর্যাদাপূর্ণ "সংস্করণ আসন্ন"-অবস্থা (সর্বশেষ সিঙ্কড-তারিখ সহ)। ── %>
<% const bnN233 = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]); %>
<%
  const tePapers233 = (typeof epaperToday !== 'undefined' && epaperToday && epaperToday.length) ? epaperToday
                     : (typeof epaperLatest !== 'undefined' ? epaperLatest : []);
  const teHasToday233 = (typeof epaperHasToday !== 'undefined') ? !!epaperHasToday : false;
  const teActive233 = tePapers233[0] || null;
  const teHref233 = (p) => p ? ('/epaper?file=' + encodeURIComponent(p.id)) : '/epaper';
%>
<section class="section today-epaper-section reveal" id="today-epaper">
  <div class="container">
    <div class="te-band233">
      <div class="te-decor233" aria-hidden="true"></div>
      <div class="te-decor2a233" aria-hidden="true"></div>
      <div class="te-grid233">

        <!-- ═══ বাম কলাম: ই-পেপার বিবরণ ও ফিচারসমূহ ═══ -->
        <div class="te-left233">
          <div class="te-badge233">
            <span class="te-live233" aria-hidden="true"></span>
            <span><%= C('home_ep_eyebrow') %></span>
          </div>

          <h2 class="te-title233"><%= C('home_ep_t1') %> <span class="accent"><%= C('home_ep_accent') %></span> <%= C('home_ep_t2') %></h2>
          <div class="te-bar233" aria-hidden="true"></div>

          <p class="te-lead233"><%= C('home_ep_lead') %></p>

          <ul class="te-points233">
            <li><span class="te-tick233" aria-hidden="true">✓</span> প্রথম আলো, ইত্তেফাক, সমকাল ও বণিক বার্তাসহ শীর্ষ জাতীয় সংবাদপত্র</li>
            <li><span class="te-tick233" aria-hidden="true">✓</span> ক্যাম্পাস সংবাদ ও বিশেষ সাহিত্য ক্রোড়পত্রের পূর্ণাঙ্গ পাতা</li>
            <li><span class="te-tick233" aria-hidden="true">✓</span> মোবাইল ও পিসিতে দ্রুত পড়ার জন্য মেমোরি-অপটিমাইজড ভিউয়ার</li>
          </ul>

          <div class="te-ctas233">
            <a href="<%= teHref233(teActive233) %>" class="te-btn233 te-btn-main233">
              <i class="fas fa-newspaper" aria-hidden="true"></i>
              <span><%= teHasToday233 ? 'আজকের ই-পেপার পড়ুন' : 'সর্বশেষ ই-পেপার পড়ুন' %></span>
              <i class="fas fa-arrow-right te-arrow233" aria-hidden="true"></i>
            </a>
            <a href="/epaper" class="te-btn233 te-btn-ghost233">
              <i class="fas fa-book-open" aria-hidden="true"></i>
              <span>পুরোনো পেপার আর্কাইভ</span>
            </a>
          </div>
        </div>

        <!-- ═══ ডান কলাম: লাইভ পত্রিকা প্রিভিউ কার্ড ═══ -->
        <div class="te-right233">
          <div class="te-sidehead233">
            <span class="te-fresh233"><i class="fas fa-bolt" aria-hidden="true"></i> <%= teHasToday233 ? 'আজকের তাজা সংস্করণ' : 'সর্বশেষ সিঙ্কড সংস্করণ' %></span>
            <span class="te-date233"><%= (typeof todayBn !== 'undefined' && todayBn) ? todayBn : '' %></span>
          </div>

          <div class="te-card233">
            <div class="te-cardhead233">
              <div class="te-ico233" aria-hidden="true"><i class="fas fa-newspaper"></i></div>
              <div class="te-cardbody233">
                <div class="te-namerow233">
                  <h4 class="te-name233"><%= teActive233 ? teActive233.paperName : 'ই-পেপার আর্কাইভ' %></h4>
                  <% if (teActive233) { %>
                  <span class="te-freshbadge233"><%= teHasToday233 ? 'আজকের সংখ্যা' : 'সর্বশেষ' %></span>
                  <% } %>
                </div>
                <p class="te-cardsub233">
                  <% if (teHasToday233 && tePapers233.length > 1) { %>
                    আজকের <%= bnN233(tePapers233.length) %>টি সংস্করণ · সরাসরি ডিজিটাল রিডারে
                  <% } else if (teActive233) { %>
                    <%= teHasToday233 ? 'আজকের' : (typeof epaperLatestDateBn !== 'undefined' ? epaperLatestDateBn : '') %> মুদ্রিত রূপ · সরাসরি ডিজিটাল রিডারে
                  <% } else { %>
                    দৈনিক পত্রিকার সংরক্ষিত সংস্করণ
                  <% } %>
                </p>
                <div class="te-meta233">
                  <span class="te-metachip233"><i class="fas fa-book-open" aria-hidden="true"></i> পৃষ্ঠা উল্টে পড়ার ভিউয়ার</span>
                  <span class="te-metachip233"><i class="fas fa-print" aria-hidden="true"></i> হাই-রেজোলিউশন প্রিন্ট</span>
                </div>
              </div>
              <a href="<%= teHref233(teActive233) %>" class="te-go233" aria-label="ই-পেপার খুলুন"><i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>

            <div class="te-pillrow233">
              <span class="te-pilllabel233">দ্রুত পড়ুন:</span>
              <div class="te-pills233">
                <% if (teHasToday233 && tePapers233.length) { %>
                  <% tePapers233.slice(0, 4).forEach(p => { %>
                  <a href="<%= teHref233(p) %>"
                     class="te-pill233<%= (teActive233 && String(teActive233.id) === String(p.id)) ? ' active' : '' %>"
                     data-te-name="<%= p.paperName %>"
                     data-te-sub="মুদ্রিত রূপ · সরাসরি ডিজিটাল রিডারে"
                     data-te-tag="<%= teHasToday233 ? 'আজকের সংখ্যা' : 'সর্বশেষ' %>"
                     data-te-href="<%= teHref233(p) %>"><%= p.paperName %></a>
                  <% }) %>
                <% } else { %>
                  <a href="/epaper" class="te-pill233">আর্কাইভ দেখুন</a>
                  <% if (typeof epaperLatestDateBn !== 'undefined' && epaperLatestDateBn) { %>
                  <span class="te-pillsoon233">আজকের সংস্করণ আসন্ন — সর্বশেষ: <%= epaperLatestDateBn %></span>
                  <% } %>
                <% } %>
              </div>
            </div>
          </div>

          <div class="te-sync233">
            <span class="te-sync-l233"><span class="te-dot233" aria-hidden="true"></span> সর্বশেষ আনুষ্ঠানিক ডিজিটাল মুদ্রণ</span>
            <span class="te-sync-r233">সার্বক্ষণিক হালনাগাদ</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
<%# সেশন ২৭৩-প্রিমিয়াম: পিল-ক্লিকে রিলোড-ছাড়া প্রিভিউ-সুইচ (href-রক্ষিত — নতুন-ট্যাব/ফলব্যাক-নেভিগেশন অটুট) ── %>
<script>
(function () {
  if (window.__te233wired) return; window.__te233wired = true;
  var card = document.querySelector('.te-card233'); if (!card) return;
  var name = card.querySelector('.te-name233'),
      sub = card.querySelector('.te-cardsub233'),
      tag = card.querySelector('.te-freshbadge233'),
      go = card.querySelector('.te-go233'),
      cta = document.querySelector('.te-btn-main233');
  document.querySelectorAll('.te-pills233 .te-pill233[data-te-name]').forEach(function (pill) {
    pill.addEventListener('click', function (e) {
      e.preventDefault();
      if (name) name.textContent = pill.dataset.teName;
      if (sub) sub.textContent = pill.dataset.teSub;
      if (tag) tag.textContent = pill.dataset.teTag;
      if (go) go.setAttribute('href', pill.dataset.teHref || pill.getAttribute('href'));
      if (cta) cta.setAttribute('href', pill.dataset.teHref || pill.getAttribute('href'));
      document.querySelectorAll('.te-pills233 .te-pill233').forEach(function (el) { el.classList.remove('active'); });
      pill.classList.add('active');
    });
  });
})();
</script>
