<%# সেশন ২৯১: কিয়স্ক-ইঞ্জিন — অটো-স্লাইড ৩.৫সে + hover/focus-পজ + ম্যানুয়াল-নির্বাচন + CTA-সিঙ্ক ── %>
<script>
(function () {
  if (window.__epk291wired) return; window.__epk291wired = true;
  var kiosk = document.getElementById('epKiosk291');
  if (!kiosk) return;
  var papers = <%- teJson291 %>;
  if (!papers.length) return;

  var reduceMotion = false;
  try { reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  var front = document.getElementById('epk291Front'),
      img = document.getElementById('epk291Img'),
      mock = document.getElementById('epk291Mock'),
      nameEl = document.getElementById('epk291Name'),
      backL = document.getElementById('epk291BackL'),
      backR = document.getElementById('epk291BackR'),
      cta = document.getElementById('teKioskCta291'),
      ctaText = document.getElementById('teKioskCtaText291'),
      live = document.getElementById('epk291Live'),
      film = document.getElementById('epk291Film'),
      btns = film ? Array.prototype.slice.call(film.querySelectorAll('.epk291-film-btn')) : [];

  var current = 0, timer = null, paused = false;

  function applyPaper(i) {
    var p = papers[i];
    if (!p) return;
    front.href = p.href;
    front.style.setProperty('--epkAcc291', p.acc);
    nameEl.textContent = p.name;
    backL.textContent = papers[(i + 1) % papers.length].name;
    backR.textContent = papers[(i + 2) % papers.length].name;
    if (cta && ctaText) {
      cta.href = p.href;
      ctaText.textContent = p.name + ' পড়ুন';
    }
    if (live) live.textContent = 'প্রদর্শিত পত্রিকা: ' + p.name;
    // থাম্বনেইল কেবল নাম-মিলে-আসা সোর্সেই; না-থাকলে টেক্সট-মাস্টহেড (ভুল-ছবি-অসম্ভব)
    if (p.thumb) {
      img.hidden = false;
      mock.hidden = true;
      img.alt = p.name + ' — ই-পেপার মাস্টহেড';
      if (img.getAttribute('src') !== p.thumb) img.src = p.thumb;
    } else {
      img.hidden = true;
      img.removeAttribute('src');
      mock.hidden = false;
    }
    btns.forEach(function (b, bi) { b.setAttribute('aria-selected', bi === i ? 'true' : 'false'); });
    // ফ্লিপ-অ্যানিমেশন রিস্টার্ট
    if (!reduceMotion) {
      front.classList.remove('is-flip');
      void front.offsetWidth;
      front.classList.add('is-flip');
    }
    current = i;
  }

  function startTimer() {
    if (reduceMotion || timer) return;
    timer = setInterval(function () {
      if (!paused) applyPaper((current + 1) % papers.length);
    }, 3500);
  }
  function resetTimer() {
    clearInterval(timer); timer = null; startTimer();
  }

  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var i = parseInt(b.getAttribute('data-epk-i'), 10);
      if (!isNaN(i)) { applyPaper(i); resetTimer(); }
    });
  });

  // hover + keyboard-focus — দুই ক্ষেত্রেই থামে (পাঠক নির্বাচনে স্বাচ্ছন্দ্য)
  var section = document.getElementById('today-epaper') || kiosk;
  section.addEventListener('mouseenter', function () { paused = true; });
  section.addEventListener('mouseleave', function () { paused = false; });
  kiosk.addEventListener('focusin', function () { paused = true; });
  kiosk.addEventListener('focusout', function (e) {
    if (!kiosk.contains(e.relatedTarget)) paused = false;
  });

  // থাম্ব-লোড-ব্যর্থতায় নিরীহ টেক্সট-মাস্টহেডে ফলব্যাক (কখনো ভাঙা-ছবি নয়)
  img.addEventListener('error', function () {
    img.hidden = true;
    img.removeAttribute('src');
    mock.hidden = false;
  });

  // session292: ফিল্ম-মিনি-থাম্ব লোড-ব্যর্থতায় থাম্ব-স্প্যান লুকান — টেক্সট-অনলি-ফলব্যাক
  // (ভাঙা-ছবি-কখনো-নয়); error ইভেন্ট non-bubbling → film-কনটেইনারে capture-ফেজে শোনা হয়
  if (film) {
    film.addEventListener('error', function (e) {
      var t = e.target;
      if (!t || !t.classList || !t.classList.contains('epk291-film-thumb-img')) return;
      var w = t.parentNode;
      if (w && w.classList && w.classList.contains('epk291-film-thumb')) w.hidden = true;
    }, true);
    window.__epk292QA = {
      total: function () { return film.querySelectorAll('.epk291-film-thumb').length; },
      hidden: function () { return film.querySelectorAll('.epk291-film-thumb[hidden]').length; },
      imgs: function () { return film.querySelectorAll('.epk291-film-thumb-img').length; }
    };
  }

  applyPaper(0);
  startTimer();
})();
</script>
