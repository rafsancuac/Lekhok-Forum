<%# ── সেশন ৩১০: "আজকের ই-পেপার" — ফুল-কভার প্রচ্ছদ অটো-স্লাইডার (প্রিভিউ session297-অনুমোদিত) ──
    ইউজার-স্পেক (session297-প্রিভিউ, প্রোড-পোর্ট):
    • ডান-কলামের বড় কার্ডে শুধু প্রচ্ছদ — উপরে কোনো টেক্সট-হেডার/নাম নেই (প্রচ্ছদেই নাম স্পষ্ট)।
    • নিচের ছোট থাম্বনেইল-কার্ড (ফিল্মস্ট্রিপ) সম্পূর্ণ বিলোপ — শুধু রঙিন ডট-ইন্ডিকেটর।
    • প্রতি ৪ সেকেন্ডে প্রচ্ছদ অটো-স্লাইড (fade); হোভার/ফোকাসে থামে; ট্যাব-ব্যাকগ্রাউন্ডে থামে;
      সোয়াইপ-সমর্থিত; ডটে ক্লিক + কীবোর্ড ←/→/Home/End; ক্লিকে রিডারে যায়।
    • ৩ডি স্ট্যাকড-পেপার ফ্রেম (পেছনে ২ শিট ±২°) + পত্রিকা-নির্দিষ্ট টপ-স্ট্রাইপ + কার্ড-ফুটার।
    • স্লাইড-সারি = অ্যাডমিন-নিয়ন্ত্রিত (home_epaper_slides — /admin/home-epaper ড্যাশবোর্ড);
      খালি হলে লাইভ-সিঙ্কড পেপারে (epaperLatest) গ্রেসফুল-ফলব্যাক — সেকশন কখনো ফাঁকা নয়।
    • ইমেজ-চেইন (মিসম্যাচ-অসম্ভব — s291/s296-নীতি): অ্যাডমিন-থাম্ব → নাম-মিল-প্রথম-পাতা-চেইন →
      টেক্সট-মাস্টহেড; ২-স্ট্রাইক রিট্রাই (cache-buster) — কখনো ভাঙা-ছবি নয়।
    • deep-link: /epaper?file=<id> (সর্বোচ্চ-অগ্রাধিকার) → /epaper?paper=<নাম> → /epaper।
    • QA-চুক্তি-সামঞ্জস্য: __epk297QA (inView/tabVisible/ioOn/timerOn/tickN/current/tick/sync),
      __epk299QA (prefetch-ফানেল), __epk310QA (নতুন ফুল-কভার-চুক্তি) — papers-শূন্যে-ও সংজ্ঞায়িত।
    • a11y: carousel-roledescription + tablist/tab dots + aria-live + focus-visible + reduced-motion।
    ডেটা: routes/pages.js হোম-রাউন্ড (epaperSlides310 + epaperToday/epaperLatest + todayBn + epaperStats296)। ── %>
<% const bnN310 = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]); %>
<% const teStats310 = (typeof epaperStats296 !== 'undefined' && epaperStats296) ? epaperStats296 : { papers: 0, totalPapers: 0, totalIssues: 0 }; %>
<%
  const tePapers310 = (typeof epaperToday !== 'undefined' && epaperToday && epaperToday.length) ? epaperToday
                     : (typeof epaperLatest !== 'undefined' ? epaperLatest : []);
  const teHasToday310 = (typeof epaperHasToday !== 'undefined') ? !!epaperHasToday : false;
  const teDateBn310 = (typeof todayBn !== 'undefined' && todayBn) ? todayBn : '';
  // লাইভ-ফলব্যাকের টোকেন-প্যালেট (হেক্স-শূন্য — session291-রীতি)
  const teAccents310 = ['var(--lf-danger)', 'var(--lf-danger-deep)', 'var(--lf-brand-primary)', 'var(--lf-danger-deep)', 'var(--lf-cyan-ink)', 'var(--lf-amber-deep)', 'var(--lf-dlx-gold)'];
  // ── স্লাইড-সারি: অ্যাডমিন-নিয়ন্ত্রিত → খালি হলে লাইভ-সিঙ্কড পেপার ──
  const teAdminSlides310 = (typeof epaperSlides310 !== 'undefined' && Array.isArray(epaperSlides310)) ? epaperSlides310 : [];
  const teSlides310 = teAdminSlides310.length
    ? teAdminSlides310.map(function (s) {
        return { id: 's' + s.id, name: String(s.name || ''), color: s.color || '#006A4E',
                 href: s.href || '/epaper', thumbs: (s.thumbs && s.thumbs.length) ? s.thumbs : (s.thumb ? [s.thumb] : []) };
      })
    : tePapers310.map(function (p, i) {
        return { id: 'p' + p.id, name: String(p.paperName || ''), color: teAccents310[i % teAccents310.length],
                 href: p ? ('/epaper?file=' + encodeURIComponent(p.id)) : '/epaper',
                 thumbs: (p.thumbs && p.thumbs.length) ? p.thumbs : (p.thumb ? [p.thumb] : []) };
      });
  const teActive310 = teSlides310[0] || null;
  // একক-ট্যাগ-গঠন (audit:views duplicate-id-নিরাপদ): img-এ src/alt/hidden — খালি-src কখনো নয়
  const teFirstSrc310 = teActive310 ? (teActive310.thumbs[0] || '') : '';
  const teImgAttrs310 = teFirstSrc310
    ? ('src="' + teFirstSrc310 + '" alt="' + String(teActive310.name).replace(/"/g, '&quot;') + ' — ই-পেপার প্রথম পাতা"')
    : 'alt="" hidden';
  const teJson310 = JSON.stringify(teSlides310);
%>
