  <div class="container">
    <div class="te-band233">
      <div class="te-decor233" aria-hidden="true"></div>
      <div class="te-decor2a233" aria-hidden="true"></div>
      <div class="te-grid233">

        <!-- ═══ বাম কলাম: ই-পেপার বিবরণ ও ডায়নামিক CTA ═══ -->
        <div class="te-left233">
