<%# সেশন ২৯১: কিয়স্ক-ইঞ্জিন — অটো-স্লাইড ৩.৫সে + hover/focus-পজ + ম্যানুয়াল-নির্বাচন + CTA-সিঙ্ক ── %>
<script>
(function () {
  if (window.__epk291wired) return; window.__epk291wired = true;
  var kiosk = document.getElementById('epKiosk291');
  if (!kiosk) return;
  var papers = <%- teJson291 %>;

  /* session297: ভিউপোর্ট-সচেতন অটো-স্লাইড-স্টেট + QA-হুক (papers-শূন্যে-ও __epk297QA সংজ্ঞায়িত —
     পরিবার-চুক্তি; session296-প্রস্তাব: অদৃশ্য-সেকশনে/লুকানো-ট্যাবে ইঞ্জিন-স্থগিত — CPU-সাশ্রয়) */
  var epk297InView = true, epk297TabVisible = true, epk297TickN = 0, epk297IO = null;
  window.__epk297QA = {
    inView: function () { return epk297InView; },
    tabVisible: function () { return epk297TabVisible; },
    ioOn: function () { return !!epk297IO; },
    timerOn: function () { return !!timer; },
    tickN: function () { return epk297TickN; },
    current: function () { return papers.length ? current : -1; },
    tick: function () { if (papers.length) { applyPaper((current + 1) % papers.length); return true; } return false; },
    sync: epk297Sync297
  };
  if (!papers.length) return;

  var reduceMotion = false;
  try { reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  var front = document.getElementById('epk291Front'),
      img = document.getElementById('epk291Img'),
      mock = document.getElementById('epk291Mock'),
      nameEl = document.getElementById('epk291Name'),
      backL = document.getElementById('epk291BackL'),
      backR = document.getElementById('epk291BackR'),
      cta = document.getElementById('teKioskCta291'),
      ctaText = document.getElementById('teKioskCtaText291'),
      live = document.getElementById('epk291Live'),
      film = document.getElementById('epk291Film'),
      btns = film ? Array.prototype.slice.call(film.querySelectorAll('.epk291-film-btn')) : [];

  var current = 0, timer = null, paused = false;

  // সেশন ২৯৬: প্রথম-পাতা-থাম্ব-চেইন — সারির-নিজ সম্পদ (মিসম্যাচ-অসম্ভব); ব্যর্থতায়
  // পরের-প্রার্থী → শেষে নাম-মিলে লোগো-ব্যানার → সব-ব্যর্থে টেক্সট-মাস্টহেড (কখনো ভাঙা-ছবি নয়)।
  // নেগোশিয়েশন-চলাকালীন মাস্টহেড+মক-কলাম দৃশ্যমান থাকে — ফাঁকা-শিট-ফ্ল্যাশ-শূন্য।
  var chain = [];
  function showImg296() {
    if (img.complete && img.naturalWidth > 0 && img.getAttribute('src')) { img.hidden = false; mock.hidden = true; }
  }
  function setImg296(p) {
    chain = (p.thumbs && p.thumbs.length) ? p.thumbs.slice() : [];
    if (p.thumb) chain.push(p.thumb); // লোগো-ব্যানার = শেষ-ইমেজ-ফলব্যাক
    if (chain.length) {
      img.alt = p.name + ' — ই-পেপার প্রথম পাতা';
      img.hidden = true; mock.hidden = false; // লোড-পর্যন্ত মাস্টহেড-দৃশ্যমান
      img.src = chain[0];
      showImg296(); // ক্যাশড-সোর্সে তাৎক্ষণিক
    } else {
      img.hidden = true;
      img.removeAttribute('src');
      mock.hidden = false;
    }
  }

  function applyPaper(i) {
    var p = papers[i];
    if (!p) return;
    front.href = p.href;
    front.style.setProperty('--epkAcc291', p.acc);
    nameEl.textContent = p.name;
    backL.textContent = papers[(i + 1) % papers.length].name;
    backR.textContent = papers[(i + 2) % papers.length].name;
    if (cta && ctaText) {
      cta.href = p.href;
      ctaText.textContent = p.name + ' পড়ুন';
    }
    if (live) live.textContent = 'প্রদর্শিত পত্রিকা: ' + p.name;
    // থাম্বনেইল কেবল সারির-নিজ-চেইন/নাম-মিলে-আসা সোর্সেই; না-থাকলে টেক্সট-মাস্টহেড
    setImg296(p);
    btns.forEach(function (b, bi) { b.setAttribute('aria-selected', bi === i ? 'true' : 'false'); });
    // ফ্লিপ-অ্যানিমেশন রিস্টার্ট
    if (!reduceMotion) {
      front.classList.remove('is-flip');
      void front.offsetWidth;
      front.classList.add('is-flip');
    }
    current = i;
  }

  function startTimer() {
    if (reduceMotion || timer) return;
    timer = setInterval(function () {
      if (!paused && epk297InView && epk297TabVisible) { epk297TickN++; applyPaper((current + 1) % papers.length); }
    }, 3500);
  }
  function resetTimer() {
    clearInterval(timer); timer = null; startTimer();
  }

  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var i = parseInt(b.getAttribute('data-epk-i'), 10);
      if (!isNaN(i)) { applyPaper(i); resetTimer(); }
    });
  });

  // hover + keyboard-focus — দুই ক্ষেত্রেই থামে (পাঠক নির্বাচনে স্বাচ্ছন্দ্য)
  var section = document.getElementById('today-epaper') || kiosk;
  section.addEventListener('mouseenter', function () { paused = true; });
  section.addEventListener('mouseleave', function () { paused = false; });
  kiosk.addEventListener('focusin', function () { paused = true; });
  kiosk.addEventListener('focusout', function (e) {
    if (!kiosk.contains(e.relatedTarget)) paused = false;
  });

  /* session297: ভিউপোর্ট-সচেতন অটো-স্লাইড — IO (threshold .12) + visibilitychange দু-স্তরে
     ইঞ্জিন-স্থগিত (অদৃশ্য-সেকশনে টাইমার-সম্পূর্ণ-বন্ধ — CPU-সাশ্রয়); দৃশ্যমানতায় পুনঃ-সূচনা।
     IO-অসমর্থিত-ব্রাউজারে epk297InView=true-পূর্বস্থ — আচরণ-অপরিবর্তিত (গ্রেসফুল-ডিগ্রেডেশন)। */
  function epk297Sync297() {
    if (!papers.length) return;
    var run297 = epk297InView && epk297TabVisible;
    if (run297 && !timer) startTimer();
    else if (!run297 && timer) { clearInterval(timer); timer = null; }
  }
  try {
    if ('IntersectionObserver' in window) {
      epk297IO = new IntersectionObserver(function (entries297) {
        var en297 = entries297 && entries297[0];
        epk297InView = !!(en297 && en297.isIntersecting);
        epk297Sync297();
      }, { threshold: 0.12 });
      epk297IO.observe(section);
    }
  } catch (e297) { epk297IO = null; epk297InView = true; }
  document.addEventListener('visibilitychange', function () {
    epk297TabVisible = !(document.hidden === true);
    epk297Sync297();
  });

  // সফল-লোডে মাস্টহেড-থেকে-ছবি (ফ্ল্যাশ-শূন্য)
  img.addEventListener('load', showImg296);
  // থাম্ব-লোড-ব্যর্থতায় চেইন-অগ্রগতি: পরের-প্রার্থী; সব-শেষ → টেক্সট-মাস্টহেড (কখনো ভাঙা-ছবি নয়)
  img.addEventListener('error', function () {
    if (!chain.length || img.getAttribute('src') !== chain[0]) return; // বাসি-অনুরোধের error — উপেক্ষা
    chain.shift();
    if (chain.length) { img.src = chain[0]; showImg296(); return; }
    img.hidden = true;
    img.removeAttribute('src');
    mock.hidden = false;
  });

  // session292: ফিল্ম-মিনি-থাম্ব লোড-ব্যর্থতায় থাম্ব-স্প্যান লুকান — টেক্সট-অনলি-ফলব্যাক
  // (ভাঙা-ছবি-কখনো-নয়); error ইভেন্ট non-bubbling → film-কনটেইনারে capture-ফেজে শোনা হয়
  if (film) {
    film.addEventListener('error', function (e) {
      var t = e.target;
      if (!t || !t.classList || !t.classList.contains('epk291-film-thumb-img')) return;
      var w = t.parentNode;
      if (w && w.classList && w.classList.contains('epk291-film-thumb')) w.hidden = true;
    }, true);
    window.__epk292QA = {
      total: function () { return film.querySelectorAll('.epk291-film-thumb').length; },
      hidden: function () { return film.querySelectorAll('.epk291-film-thumb[hidden]').length; },
      imgs: function () { return film.querySelectorAll('.epk291-film-thumb-img').length; }
    };
  }

  applyPaper(0);
  startTimer();
})();
</script>
