        </div>

        <!-- ═══ ডান কলাম: ৩ডি পেপার কিয়স্ক (অটো-স্লাইড) ═══ -->
        <div class="te-right233">
          <div class="te-sidehead233">
            <span class="te-fresh233"><i class="fas fa-bolt" aria-hidden="true"></i> <%= teHasToday233 ? 'আজকের তাজা সংস্করণ' : 'সর্বশেষ সিঙ্কড সংস্করণ' %></span>
            <span class="te-date233"><%= teDateBn291 %></span>
          </div>

          <% if (tePapers233.length) { %>
          <div class="epk291" id="epKiosk291">
            <!-- ৩ডি স্টেজ -->
            <div class="epk291-stage" id="epk291Stage">
              <div class="epk291-shadow" aria-hidden="true"></div>
