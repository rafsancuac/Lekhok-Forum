<%# ── সেশন ১৯৩: "আজকের কন্টেন্ট — আজ বিশেষ কী আছে?" — সম্পূর্ণ নতুন ডিজাইন ──
    ইউজার-স্পেক: হুবহু 'সোশ্যাল ফিড / ইউজার ফিড' (feed-showcase) ব্লকের আদলে
    ২-কলাম প্রিমিয়াম ব্যান্ড — বামে ব্যাজ+শিরোনাম+চেকমার্ক-পয়েন্ট+ডুয়াল-বাটন,
    ডানে '⚡ এক নজরে' ইন্টারঅ্যাক্টিভ কনটেন্ট-স্লাইডার (অটো-অ্যাডভান্স + ডট)।
    আগের today-grid স্ট্যাটিক-কার্ড গ্রিড বাদ — আজকের বাস্তব ডেটা (todayByType)
    এখন স্লাইডারেই ঘুরে আসে; কুইজ-চ্যালেঞ্জ ব্যান্ড সক্রিয় থাকলে কুইজ-স্লাইড
    ডুপ্লিকেশন এড়াতে বাদ (আগের today-grid-এর সেইম চুক্তি)।
    রুট-ম্যাপ: মকআপ /posts→/articles, /memories→/on-this-day (session192 চুক্তি)। ── %>
<section class="section today-special-section reveal" id="today-special">
  <div class="container">
    <div class="feed-showcase ts-showcase193">
      <div class="fs-decor ts-decor-193a"></div>
      <div class="fs-decor ts-decor-193b"></div>
      <div class="ts-grid193">
        <div class="fs-info">
          <span class="fs-eyebrow"><i class="fas fa-thumbtack"></i> <%= C('home_today_eyebrow') %></span>
          <h2 class="fs-title"><%= C('home_today_t1') %> <span class="accent"><%= C('home_today_accent') %></span> <%= C('home_today_t2') %></h2>
          <p class="fs-lead"><%= C('home_today_lead') %></p>
          <ul class="fs-points">
            <li><i class="fas fa-check-circle"></i> ইতিহাসের এই দিনে বিশেষ তাৎপর্য ও সাহিত্যিক স্মৃতিচারণ</li>
            <li><i class="fas fa-check-circle"></i> দৈনিক ই-পেপার ও জাতীয় সংবাদপত্রের সাহিত্য পাতা সরাসরি পঠন</li>
            <li><i class="fas fa-check-circle"></i> আজকের নির্বাচিত পাঠকপ্রিয় রচনা ও পাঠ প্রতিক্রিয়া</li>
          </ul>
          <div class="fs-cta">
            <a href="/articles" class="btn fs-btn-main"><i class="fas fa-arrow-right"></i> আজকের লেখা পড়ুন</a>
            <a href="/on-this-day" class="btn fs-btn-ghost"><i class="far fa-calendar-alt"></i> আর্কাইভ দেখুন</a>
          </div>
        </div>
        <div class="fs-side">
          <div class="fs-side-label"><i class="fas fa-bolt"></i> এক নজরে</div>
          <div class="fs-carousel" id="todayCarousel" aria-roledescription="carousel" aria-label="আজকের বিশেষ কনটেন্ট">
            <div class="fc-track" id="todayTrack">
              <% (typeof todaySlides !== 'undefined' && todaySlides ? todaySlides : []).forEach(s => { %>
              <a class="fc-slide" href="<%= s.href %>">
                <span class="fc-icon"><i class="fas <%= s.icon %>"></i></span>
                <span class="fc-body"><strong><%= s.title %></strong><small><%= s.sub %></small></span>
                <i class="fas fa-arrow-right fc-go"></i>
              </a>
              <% }) %>
            </div>
            <div class="fc-dots" id="todayDots" role="tablist" aria-label="স্লাইড নির্বাচন"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
/* সেশন ১৯৩: 'এক নজরে' স্লাইডার — ফিড-ক্যারোসেলের একই আচরণ (অটো-৪সে, হোভার-বিরতি,
   reduced-motion-সম্মান) — main.js-এর feedCarousel-এর মিরর, নিজস্ব id-স্কোপে। */
(function () {
  var root = document.getElementById('todayCarousel');
  var track = document.getElementById('todayTrack');
  var dotsBox = document.getElementById('todayDots');
  if (!root || !track || !dotsBox) return;
  var n = track.children.length;
  if (n < 2) return; /* এক/শূন্য-স্লাইডে ডট ও অটো-অ্যাডভান্স দরকার নেই */
  var idx = 0;
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var timer = null, btns = [];
  for (var i = 0; i < n; i++) {
    (function (i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'fc-dot' + (i === 0 ? ' active' : '');
      b.setAttribute('aria-label', 'স্লাইড ' + (i + 1));
      b.addEventListener('click', function () { go(i); restart(); });
      dotsBox.appendChild(b);
      btns.push(b);
    })(i);
  }
  function go(i) {
    idx = (i % n + n) % n;
    track.style.transform = 'translateX(-' + (100 * idx) + '%)';
    btns.forEach(function (b, j) { b.classList.toggle('active', j === idx); });
  }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  function start() { if (!reduced && !timer) timer = setInterval(function () { if (!document.hidden) go(idx + 1); }, 4000); }
  function restart() { stop(); start(); }
  root.addEventListener('mouseenter', stop);
  root.addEventListener('mouseleave', start);
  root.addEventListener('focusin', stop);
  root.addEventListener('focusout', start);
  go(0);
  start();
})();
</script>
