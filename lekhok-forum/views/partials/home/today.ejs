<%# ── সেশন ২৩৩ + ২৯১ + ২৯৬: "আজকের ই-পেপার" — প্রশস্ত প্রিমিয়াম ৩ডি নিউজপেপার কিয়স্ক ──
    সেশন ২৩৩-এর প্রিমিয়াম ব্যান্ডের ওপর সেশন ২৯১-এ ইউজার-স্পেক কিয়স্ক:
    • ডান কলাম = ৩ডি পেপার-স্টেজ (পেছনের ২ শিট + সামনের ইন্টারঅ্যাকটিভ শিট) +
      ফিল্মস্ট্রিপ (প্রতি পত্রিকায় এক বাটন, accent-আন্ডারলাইন)।
    • প্রতি ৩.৫ সেকেন্ডে স্লাইড — hover/focus-এ থামে (Pause); ক্লিকে ম্যানুয়াল-নির্বাচন।
    • বাম কলামের মূল CTA স্লাইডের সাথে সিঙ্কে পত্রিকার নাম বদলায় ("প্রথম আলো পড়ুন →")।
    • থাম্বনেইল কেবল নাম-মিলে (routes/pages.js epaperThumbByName291 — চতুঃস্তর-লক
      data/newspaperLinks সোর্স); মিল-নেই → টেক্সট-মাস্টহেড ফলব্যাক — ভুল-পত্রিকার ছবি
      কোনোভাবেই যায় না (ইউজার-নীতি: এক ই-পেপারের থাম্বনিল অন্য ইপেপারে যায় না)।
    • থাম্ব-লোড-ব্যর্থতায় JS নিজেই টেক্সট-মাস্টহেডে ফিরে যায় (কখনো ভাঙা-ছবি নয়)।
    • deep-link: /epaper?file=<id> — epaper-অ্যাপের session233-boot-hook সরাসরি খোলে।
    • session292: ফিল্মস্ট্রিপ বাটনে মিনি-থাম্ব-প্রিভিউ — একই epaperThumbByName291 নাম-মিল-সোর্স
      (ভুল-পত্রিকার-ছবি-অসম্ভব); লোড-ব্যর্থতায় JS থাম্ব-স্প্যান লুকায় — টেক্সট-অনলি-ফলব্যাক।
    • session296 (ইউজার-স্পেক — প্রশস্ত প্রিমিয়াম): ① শিট প্রশস্ত + aspect-ratio — প্রথম পাতার
      থাম্বনেইল সম্পূর্ণ দৃশ্যমান (cover→contain — ব্যানার/শিরোনাম কাটা-যাবে-না);
      ② হোভার-ওভারলে "পূর্ণাঙ্গ পাতা পড়ুন" (hover:none-টাচে বিলোপ — ট্যাপই রিডারে);
      ③ বাম-কলাম চেকমার্কে শীর্ষ-৭ জনপ্রিয় পত্রিকা (প্রথম আলো, ইত্তেফাক, যুগান্তর, সমকাল,
      কালের কণ্ঠ, আমার দেশ, মানবকণ্ঠ); ④ ফিল্মস্ট্রিপ বড়-কার্ড (routes/pages.js
      epPopularRank296 প্রাধিকার-ক্রম + LIMIT 14)।
    • a11y: tablist/tab + aria-selected + aria-live ঘোষণা + focus-visible + reduced-motion।
    ডেটা: routes/pages.js হোম-রাউন্ড (epaperToday/epaperLatest + p.thumb)। ── %>
<% const bnN233 = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]); %>
<% const teStats296 = (typeof epaperStats296 !== 'undefined' && epaperStats296) ? epaperStats296 : { papers: 0, totalPapers: 0, totalIssues: 0 }; %>
<%
  const tePapers233 = (typeof epaperToday !== 'undefined' && epaperToday && epaperToday.length) ? epaperToday
                     : (typeof epaperLatest !== 'undefined' ? epaperLatest : []);
  const teHasToday233 = (typeof epaperHasToday !== 'undefined') ? !!epaperHasToday : false;
  const teActive233 = tePapers233[0] || null;
  const teHref233 = (p) => p ? ('/epaper?file=' + encodeURIComponent(p.id)) : '/epaper';
  // সেশন ২৯১: প্রতি-পত্রিকা accent — নির্ধারিত-ক্রমের টোকেন-প্যালেট (হেক্স-শূন্য)।
  const teAccents291 = ['var(--lf-danger)', 'var(--lf-ink-max)', 'var(--lf-brand-primary)', 'var(--lf-danger-deep)', 'var(--lf-cyan-ink)', 'var(--lf-amber-deep)', 'var(--lf-dlx-gold)'];
  const teAcc291 = (i) => teAccents291[i % teAccents291.length];
  const teDateBn291 = (typeof todayBn !== 'undefined' && todayBn) ? todayBn : '';
  // সেশন ২৯৬: মূল-কার্ড-উৎস — সারির-নিজ প্রথম-পাতা-চেইনের প্রথম-প্রার্থী, নইলে নাম-মিলে লোগো-ব্যানার
  const teFirstSrc296 = teActive233 ? ((teActive233.thumbs && teActive233.thumbs[0]) || teActive233.thumb || '') : '';
  // একক-ট্যাগ-গঠন (audit:views duplicate-id-নিরাপদ): img-এ src/alt/hidden — খালি-src কখনো নয়
  const teImgAttrs291 = teFirstSrc296
    ? ('src="' + teFirstSrc296 + '" alt="' + String(teActive233.paperName).replace(/"/g, '&quot;') + ' — ই-পেপার প্রথম পাতা"')
    : 'alt="" hidden';
  const teJson291 = JSON.stringify(tePapers233.map((p, i) => ({
    id: p.id, name: p.paperName, thumb: p.thumb || '', thumbs: p.thumbs || [], href: teHref233(p), acc: teAcc291(i)
  })));
