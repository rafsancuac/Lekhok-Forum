  }
  function shine326() {
    if (!canAnim326 || !shineEl) return;
    shineEl.animate([{ transform: 'translateX(-140%) skewX(-18deg)', opacity: 0 }, { opacity: 1, offset: 0.3 }, { transform: 'translateX(140%) skewX(-18deg)', opacity: 0 }], { duration: 720, delay: 110, easing: 'ease-out' });
  }
