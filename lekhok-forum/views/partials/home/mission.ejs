<!-- Mission — section-alt with reveal -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><%= C('home_mission_eyebrow') %></span>
      <h2 class="section-title"><%= C('home_mission_t1') %> <span class="accent"><%= C('home_mission_accent') %></span></h2>
      <span class="accent-divider center"></span>
      <p class="lead"><%= C('home_mission_lead') %></p>
    </div>
    <div class="feature-grid reveal-stagger">
      <div class="feature"><i class="fas <%= C('home_feature1_icon') %>"></i><h3><%= C('home_feature1_title') %></h3><p><%= C('home_feature1_text') %></p></div>
      <div class="feature"><i class="fas <%= C('home_feature2_icon') %>"></i><h3><%= C('home_feature2_title') %></h3><p><%= C('home_feature2_text') %></p></div>
      <div class="feature"><i class="fas <%= C('home_feature3_icon') %>"></i><h3><%= C('home_feature3_title') %></h3><p><%= C('home_feature3_text') %></p></div>
      <div class="feature"><i class="fas <%= C('home_feature4_icon') %>"></i><h3><%= C('home_feature4_title') %></h3><p><%= C('home_feature4_text') %></p></div>
      <div class="feature"><i class="fas <%= C('home_feature5_icon') %>"></i><h3><%= C('home_feature5_title') %></h3><p><%= C('home_feature5_text') %></p></div>
      <div class="feature"><i class="fas <%= C('home_feature6_icon') %>"></i><h3><%= C('home_feature6_title') %></h3><p><%= C('home_feature6_text') %></p></div>
      <div class="feature"><i class="fas <%= C('home_feature7_icon') %>"></i><h3><%= C('home_feature7_title') %></h3><p><%= C('home_feature7_text') %></p></div>
      <div class="feature"><i class="fas <%= C('home_feature8_icon') %>"></i><h3><%= C('home_feature8_title') %></h3><p><%= C('home_feature8_text') %></p></div>
    </div>
  </div>
</section>

