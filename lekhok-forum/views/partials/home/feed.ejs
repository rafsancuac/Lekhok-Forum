    { n: 'ইমরান কবির', h: '@imran · ৩ ঘণ্টা', t: 'লাইব্রেরির নতুন সাহিত্য-কর্নার নিয়ে একটা প্রতিবেদন লিখছি।', a: '৬৫', c: '৯', s: '২', img: true },
    { n: 'ফারহানা ইসলাম', h: '@farhana · ৪ ঘণ্টা', t: 'আগামী শুক্রবারের লেখালেখি-কর্মশালায় কারা কারা যোগ দিচ্ছেন?', a: '১১৯', c: '২৬', s: '৭', img: false }
  ];
  // ── সেশন ৩০৭ (sfs307): বাস্তব-ফিড-হাইড্রেশন (SSR — লগইন-বিহীন পাবলিক-পোস্ট) ──
  // routes/pages.js থেকে sfsRealPosts (সর্বশেষ ৮ পাবলিক-পোস্ট)। গ্রুপ-এ = সর্বশেষ ৪
  // (published_at DESC); গ্রুপ-বি = বাকি ৪ জনপ্রিয়তা-ক্রমে (engagement DESC — 'জনপ্রিয়
  // আলোচনা'-লেবেল-সত্যতা)। ঘাটতিতে ডেমো-সারি পূরণ (সর্বদা ৪+৪ = সিমলেস-লুপ-স্থিতিশীল)।
  const sfsReal307 = (typeof sfsRealPosts !== 'undefined' && Array.isArray(sfsRealPosts)) ? sfsRealPosts : [];
  const sfsStrip307 = (s) => String(s || '').replace(/<[^>]*>/g, ' ').replace(/&[a-z]+;/gi, ' ').replace(/\s+/g, ' ').trim();
  const sfsAgo307 = (dt) => {
    if (!dt) return '';
    const t307 = new Date(String(dt).replace(' ', 'T') + 'Z').getTime();
    if (!isFinite(t307)) return '';
    const m307 = Math.max(0, Math.round((Date.now() - t307) / 60000));
    if (m307 < 1) return 'এইমাত্র';
    if (m307 < 60) return toBn(m307) + ' মিনিট';
    if (m307 < 1440) return toBn(Math.round(m307 / 60)) + ' ঘণ্টা';
    return toBn(Math.round(m307 / 1440)) + ' দিন';
  };
  const sfsRow307 = (p) => ({
    n: ((p.pen_name && String(p.pen_name).trim()) || p.full_name || 'লেখক'),
    h: '@' + String(p.username || 'writer') + (sfsAgo307(p.published_at) ? ' · ' + sfsAgo307(p.published_at) : ''),
    t: (sfsStrip307(p.excerpt || p.body || '').slice(0, 110)) || String(p.title || '').slice(0, 110),
    a: toBn(p.like_count), c: toBn(p.comment_count), s: toBn(p.view_count),
    img: !!p.cover_image, real: true
  });
  const sfsEng307 = (p) => (Number(p.like_count) || 0) + (Number(p.comment_count) || 0);
  const sfsRealA307 = sfsReal307.slice(0, 4).map(sfsRow307);
  const sfsRealB307 = sfsReal307.slice(4, 8).slice().sort((x, y) => sfsEng307(y) - sfsEng307(x)).map(sfsRow307);
  const sfsFill307 = (real, demo) => [0, 1, 2, 3].map((i) => real[i] || demo[i]);
  const sfsPostsA292 = sfsFill307(sfsRealA307, sfsDemoA292);
  const sfsPostsB292 = sfsFill307(sfsRealB307, sfsDemoB292);
  const sfsRealCount307 = sfsReal307.length;
  const sfsStories292 = [
    { l: 'আপনার', i: '', you: true },
    { l: 'মেহেদী', i: 'মে' },
    { l: 'রিয়া', i: 'রি' },
    { l: 'তানভীর', i: 'তা' },
    { l: 'নুসরাত', i: 'নু' }
  ];
  const sfsInitial292 = (n) => n.trim().charAt(0);
  // সেশন ৩০৭: চিপ ×২→×৩ (feedSlides-রেজিস্ট্রির পূর্ণ-ব্যবহার)
  const sfsChips292 = (typeof feedSlides !== 'undefined' && feedSlides ? feedSlides : []).slice(0, 3);
%>
<section class="section feed-showcase-section reveal" id="user-feed">
  <div class="container">
    <div class="sfs292-card">
      <div class="sfs292-grid">
        <%# ── বাম: তথ্য-প্যানেল (রো-উচ্চতা এটাই ঠিক করে) ── %>
        <div class="sfs292-info">
          <span class="sfs292-eyebrow"><i class="fas fa-stream" aria-hidden="true"></i> <%= C('home_feed_eyebrow') %></span>
          <h2 class="sfs292-title"><%= C('home_feed_title') %></h2>
          <p class="sfs292-lead"><%= C('home_feed_desc') %></p>
          <% if (sfsRealCount307 > 0) { %><span class="sfs307-live"><span class="sfs307-live-dot" aria-hidden="true"></span> ফিডে এখন বাস্তব পোস্ট · <%= toBn(sfsRealCount307) %></span><% } %>
          <ul class="sfs292-points">
            <li><i class="fas fa-check-circle" aria-hidden="true"></i> <%= C('home_feed_point1') %></li>
            <li><i class="fas fa-check-circle" aria-hidden="true"></i> <%= C('home_feed_point2') %></li>
            <li><i class="fas fa-check-circle" aria-hidden="true"></i> <%= C('home_feed_point3') %></li>
          </ul>
          <div class="sfs292-cta">
            <a href="/dashboard" class="btn sfs292-btn-main"><i class="fas fa-arrow-right" aria-hidden="true"></i> <%= C('home_feed_btn') %></a>
            <a href="/register" class="btn sfs292-btn-ghost"><i class="fas fa-user-plus" aria-hidden="true"></i> <%= C('home_feed_btn2') %></a>
          </div>
          <p class="sfs292-hint"><i class="fas fa-hand-pointer" aria-hidden="true"></i> ডানদিকের ফোনে ক্লিক করলেই সোশ্যাল ফিড খুলবে</p>
        </div>
        <%# ── ডান: স্টেজ — ফোন সেকশন-কার্ডের সম্পূর্ণ উচ্চতায় (অ্যাবসোলিউট ফুল-ব্লিড) ── %>
        <div class="sfs292-stage">
          <a class="sfs292-phone" href="/dashboard" aria-label="লেখক ফোরাম অ্যাপের প্রিভিউ — ইউজার ফিড (ড্যাশবোর্ড) খুলুন">
            <span class="sfs292-frame" aria-hidden="true">
              <span class="sfs292-screen">
                <span class="sfs292-status">
                  <span class="sfs292-time">৯:৪১</span>
                  <span class="sfs292-island"></span>
                  <span class="sfs292-status-ic"><i class="fas fa-signal"></i><i class="fas fa-wifi"></i><i class="fas fa-battery-full"></i></span>
                </span>
                <span class="sfs292-appbar">
                  <span class="sfs292-app-logo"><i class="fas fa-pen-nib"></i></span>
                  <span class="sfs292-app-name">লেখক ফোরাম<small>চট্টগ্রাম বিশ্ববিদ্যালয়</small></span>
                  <span class="sfs292-app-actions"><i class="fas fa-search"></i><i class="fas fa-bell sfs292-bell"></i></span>
                </span>
                <span class="sfs292-stories">
                  <% sfsStories292.forEach((s) => { %>
                  <span class="sfs292-story<%= s.you ? ' is-you' : '' %>">
                    <span class="sfs292-ring"><% if (s.you) { %><i class="fas fa-plus"></i><% } else { %><%= s.i %><% } %></span>
                    <small><%= s.l %></small>
                  </span>
                  <% }) %>
                </span>
              </span>
              <span class="sfs292-feed">
                <span class="sfs292-track">
                  <span class="sfs292-half">
                    <span class="sfs292-glabel"><i class="fas fa-bolt"></i> সর্বশেষ লেখা</span>
                    <% sfsPostsA292.forEach((p) => { %>
                    <span class="sfs292-post<%= p.img ? ' has-img' : '' %><%= p.real ? ' is-real307' : '' %>">
                      <span class="sfs292-phead"><span class="sfs292-pav"><%= sfsInitial292(p.n) %></span><span class="sfs292-pwho"><strong><%= p.n %></strong><small><%= p.h %></small></span><i class="fas fa-ellipsis-h"></i></span>
                      <span class="sfs292-ptext"><%= p.t %></span>
                      <% if (p.img) { %><span class="sfs292-pimg"><i class="fas fa-image"></i></span><% } %>
                      <span class="sfs292-pacts"><span><i class="fas fa-heart"></i> <%= p.a %></span><span><i class="fas fa-comment"></i> <%= p.c %></span><span><i class="fas fa-<%= p.real ? 'eye' : 'share' %>"></i> <%= p.s %></span></span>
                    </span>
                    <% }) %>
                    <span class="sfs292-glabel"><i class="fas fa-fire"></i> জনপ্রিয় আলোচনা</span>
                    <% sfsPostsB292.forEach((p) => { %>
                    <span class="sfs292-post<%= p.img ? ' has-img' : '' %><%= p.real ? ' is-real307' : '' %>">
                      <span class="sfs292-phead"><span class="sfs292-pav"><%= sfsInitial292(p.n) %></span><span class="sfs292-pwho"><strong><%= p.n %></strong><small><%= p.h %></small></span><i class="fas fa-ellipsis-h"></i></span>
                      <span class="sfs292-ptext"><%= p.t %></span>
                      <% if (p.img) { %><span class="sfs292-pimg"><i class="fas fa-image"></i></span><% } %>
                      <span class="sfs292-pacts"><span><i class="fas fa-heart"></i> <%= p.a %></span><span><i class="fas fa-comment"></i> <%= p.c %></span><span><i class="fas fa-<%= p.real ? 'eye' : 'share' %>"></i> <%= p.s %></span></span>
                    </span>
                    <% }) %>
                  </span>
                  <span class="sfs292-half" aria-hidden="true">
                    <span class="sfs292-glabel"><i class="fas fa-bolt"></i> সর্বশেষ লেখা</span>
                    <% sfsPostsA292.forEach((p) => { %>
                    <span class="sfs292-post<%= p.img ? ' has-img' : '' %><%= p.real ? ' is-real307' : '' %>">
                      <span class="sfs292-phead"><span class="sfs292-pav"><%= sfsInitial292(p.n) %></span><span class="sfs292-pwho"><strong><%= p.n %></strong><small><%= p.h %></small></span><i class="fas fa-ellipsis-h"></i></span>
                      <span class="sfs292-ptext"><%= p.t %></span>
                      <% if (p.img) { %><span class="sfs292-pimg"><i class="fas fa-image"></i></span><% } %>
                      <span class="sfs292-pacts"><span><i class="fas fa-heart"></i> <%= p.a %></span><span><i class="fas fa-comment"></i> <%= p.c %></span><span><i class="fas fa-<%= p.real ? 'eye' : 'share' %>"></i> <%= p.s %></span></span>
                    </span>
                    <% }) %>
                    <span class="sfs292-glabel"><i class="fas fa-fire"></i> জনপ্রিয় আলোচনা</span>
                    <% sfsPostsB292.forEach((p) => { %>
                    <span class="sfs292-post<%= p.img ? ' has-img' : '' %><%= p.real ? ' is-real307' : '' %>">
                      <span class="sfs292-phead"><span class="sfs292-pav"><%= sfsInitial292(p.n) %></span><span class="sfs292-pwho"><strong><%= p.n %></strong><small><%= p.h %></small></span><i class="fas fa-ellipsis-h"></i></span>
                      <span class="sfs292-ptext"><%= p.t %></span>
                      <% if (p.img) { %><span class="sfs292-pimg"><i class="fas fa-image"></i></span><% } %>
                      <span class="sfs292-pacts"><span><i class="fas fa-heart"></i> <%= p.a %></span><span><i class="fas fa-comment"></i> <%= p.c %></span><span><i class="fas fa-<%= p.real ? 'eye' : 'share' %>"></i> <%= p.s %></span></span>
                    </span>
                    <% }) %>
                  </span>
                </span>
              </span>
              <span class="sfs292-tabbar" aria-hidden="true">
                <span class="sfs292-tab is-on"><i class="fas fa-home"></i></span>
                <span class="sfs292-tab"><i class="fas fa-compass"></i></span>
                <span class="sfs292-tab sfs292-tab-plus"><i class="fas fa-plus"></i></span>
                <span class="sfs292-tab"><i class="fas fa-bell"></i></span>
                <span class="sfs292-tab"><i class="fas fa-user"></i></span>
              </span>
            </span>
          </a>
          <%# ── ভাসমান-চিপ ×২ — feedSlides-রেজিস্ট্রি (অ্যাডমিন-রিঅর্ডারযোগ্য) ── %>
          <% sfsChips292.forEach((s, i) => { %>
          <a class="sfs292-chip sfs292-chip-<%= ['a', 'b', 'c'][i] || 'a' %>" href="<%= s.href %>" aria-label="<%= s.title %> — <%= s.sub %>">
            <span class="sfs292-chip-ic"><i class="fas <%= s.icon %>" aria-hidden="true"></i></span>
            <span class="sfs292-chip-tx"><strong><%= s.title %></strong><small><%= s.sub %></small></span>
          </a>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
<script>
/* session307 (sfs307): kiosk-স্টাইল IntersectionObserver-পজ — সেকশন ভিউপোর্ট-বহির্ভূত হলে
   ট্র্যাক-অ্যানিমেশন স্থগিত (CPU-সাশ্রয়) + QA-হুক __sfs307QA (papers-শূন্যে-ও-সংজ্ঞায়িত ধর্ম) */
(function () {
  var q307 = { real: <%= sfsRealCount307 %>, total: <%= sfsPostsA292.length + sfsPostsB292.length %>, chips: <%= sfsChips292.length %>, io: 0, ioOff: null, err: '' };
  try {
    var c307 = document.querySelector('.sfs292-card');
    if (c307 && 'IntersectionObserver' in window) {
      var o307 = new IntersectionObserver(function (es307) {
        es307.forEach(function (en307) {
          var off307 = !en307.isIntersecting;
          c307.classList.toggle('sfs307-io-off', off307);
          q307.ioOff = off307;
        });
      }, { threshold: 0.14 });
      o307.observe(c307);
      q307.io = 1;
    }
  } catch (e307) { q307.err = String((e307 && e307.message) || e307); }
  window.__sfs307QA = q307;
})();
</script>
</section>

