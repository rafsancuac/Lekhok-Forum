<script>
/* session314 (sfs314): গ্রুপ-লেবেল aria-জোড়া + কীবোর্ড-roving-হাইলাইট (PLANS session313-প্রস্তাব-②)
   • ArrowDown/ArrowUp = দৃশ্যমান-হাফের গ্রুপ-লেবেল roving-হাইলাইট (ওয়ার্প-সহ); Escape = বিলোপ।
   • IO-গেট (s307-রীতি): সেকশন ভিউপোর্টে থাকলে-ই কেবল অ্যারো-ইন্টারসেপ্ট — বহির্ভূতে নেটিভ-স্ক্রল।
   • Enter/Tab-অস্পৃশ্য (s306-একক-লিঙ্ক-চুক্তি — ফোন-লিঙ্কের নেটিভ-নেভিগেশন অটুট)।
   • QA-হুক __sfs314QA {pairs, focus, keys, io, err} — সারি-শূন্যে-ও-সংজ্ঞায়িত (s306b-ধর্ম)। */
(function () {
  var q314 = { pairs: 0, focus: -1, keys: 0, io: 0, err: '' };
  try {
    var phone314 = document.querySelector('.sfs292-phone');
    var labs314 = document.querySelectorAll('.sfs292-half:not([aria-hidden="true"]) .sfs292-glabel[id]');
    var grows314 = document.querySelectorAll('.sfs314-grows[id]');
    q314.pairs = grows314.length;
    var clear314 = function () {
      Array.prototype.forEach.call(labs314, function (l314) { l314.classList.remove('sfs314-gfocus'); });
      if (q314.focus !== -1 && phone314) phone314.removeAttribute('data-sfs314-focus');
      if (window.__sfs315Unfreeze) window.__sfs315Unfreeze(phone314); /* s315: সংশোধনী-বিলোপ */
      if (window.__sfs317Clear) window.__sfs317Clear(); /* s317: ঘোষণা-বিলোপ */
      if (window.__sfs318Hide) window.__sfs318Hide(); /* s318: ব্যাজ-বিলোপ */
      if (window.__sfs319Hide) window.__sfs319Hide(); /* s319: নাম-চিপ-বিলোপ */
      q314.focus = -1;
    };
    var apply314 = function (i314) {
      Array.prototype.forEach.call(labs314, function (l314, k314) { l314.classList.toggle('sfs314-gfocus', k314 === i314); });
      q314.focus = i314;
      if (phone314) phone314.setAttribute('data-sfs314-focus', String(labs314[i314].id).replace('sfs314-glab-', ''));
      if (window.__sfs315Freeze) window.__sfs315Freeze(labs314[i314], phone314); /* s315: দৃশ্যমানতা-স্ক্রল-সমন্বয় */
      if (window.__sfs317Announce) window.__sfs317Announce(labs314[i314], i314, labs314.length); /* s317: SR-ঘোষণা */
      if (window.__sfs318Show) window.__sfs318Show(labs314[i314], i314, labs314.length); /* s318: দৃশ্যমান-ব্যাজ */
      if (window.__sfs319Show) window.__sfs319Show(labs314[i314], i314, labs314.length); /* s319: গ্রুপ-নাম-চিপ */
    };
    if (phone314 && labs314.length === grows314.length && labs314.length > 0) {
      var in314 = true;
      if ('IntersectionObserver' in window) {
        var card314 = document.querySelector('.sfs292-card');
        if (card314) {
          in314 = false;
          var io314 = new IntersectionObserver(function (es314) {
            es314.forEach(function (en314) {
              in314 = en314.isIntersecting;
              if (!in314) clear314();
            });
          }, { threshold: 0.14 });
          io314.observe(card314);
          q314.io = 1;
        }
      }
      phone314.addEventListener('keydown', function (e314) {
        var k314 = e314.key;
        if (k314 !== 'ArrowDown' && k314 !== 'ArrowUp' && k314 !== 'Escape') return;
        if (!in314) return;
        if (k314 === 'Escape') { clear314(); return; }
        e314.preventDefault();
        q314.keys += 1;
        var n314 = labs314.length;
        var next314 = q314.focus < 0
          ? (k314 === 'ArrowDown' ? 0 : n314 - 1)
          : (q314.focus + (k314 === 'ArrowDown' ? 1 : -1) + n314) % n314;
        apply314(next314);
      });
      phone314.addEventListener('blur', clear314);
    }
  } catch (e314x) { q314.err = String((e314x && e314x.message) || e314x); }
  window.__sfs314QA = q314;
})();
</script>
<script>
/* session315 (sfs315): keynav-হাইলাইট স্ক্রল-সমন্বয় (PLANS session314-প্রস্তাব-②)
   • মার্কি-বিরতি-মোডে দৃশ্যমানতা-গ্যারান্টি: হাইলাইট-গ্রুপ-লেবেল track-ভিউপোর্টের
     বাইরে থাকলে track-এ স্বাধীন translate-প্রোপার্টি — লেবেল feed-শীর্ষের
     +22px-প্যাডে (mask-fade-ব্যান্ডের নিচে) আনা হয়।
   • কেন-track-translate: .sfs292-half inline — transform-প্রয়োগ-অযোগ্য (computed-হয়
     কিন্তু-রেন্ডার-হয়-না — রান-১-এ-প্রমাণিত); track block-level — translate কার্যকর,
     এবং CSS Transforms L2-অনুযায়ী animation-এর transform-এর সাথে সংযুক্তি (কীফ্রেম-অস্পৃশ্য)।
   • নিরাপত্তা: কেবল-মাপা-সংশোধনী (চলতি-কম্পিউটেড-translate-সচেতন — transition-ল্যাগ-সম্মত;
     animation-অস্পৃশ্য (s314 CSS-গেট-ই বিরত-উৎস); ক্লিয়ারে translate-বিলোপ →
     মার্কি স্থগিত-কীফ্রেম থেকেই চলে (শূন্য-থেকে-পুনঃআরম্ভ-লাফ নেই)।
   • চুক্তি: __sfs315Freeze(lab, phone) / __sfs315Unfreeze(phone) — s314-ইঞ্জিনের
     guarded-হুক (dcfChipSync296-রীতি); ইঞ্জিন-অনুপস্থিতে নীরব-নন-ফায়ার।
   • QA-হুক __sfs315QA {frozen, shifts, err} — সারি-শূন্যে-ও-সংজ্ঞায়িত (s306b-ধর্ম)। */
(function () {
  var q315 = { frozen: 0, shifts: 0, err: '' };
  try {
    var trackFrozen315 = null;
    window.__sfs315Freeze = function (lab315, phone315) {
      try {
        if (!lab315 || !phone315) return;
        var feed315 = phone315.querySelector('.sfs292-feed');
        var track315 = phone315.querySelector('.sfs292-track');
        if (!feed315 || !track315) return;
        var fTop = feed315.getBoundingClientRect().top;
        var lTop = lab315.getBoundingClientRect().top;
        /* চলতি-কম্পিউটেড-translate পার্স (transition-ল্যাগ-সচেতন: gBCR ও getComputedStyle
           এক-স্ন্যাপশট-সচেতন — শূন্যীকরণ-মাপা-কৌশল নিষিদ্ধ — transition ঘোষিত-মানকে
           অবিলম্বে-প্রয়োগ-করে-না — রান-২-গোটচা) → চূড়ান্ত = পূর্ববর্তী + সংশোধনী */
        var prevY315 = 0;
        var comp315 = getComputedStyle(track315).translate;
        if (comp315 && comp315 !== 'none') {
          var m315 = comp315.match(/(-?\d+(?:\.\d+)?)px(?:\s+(-?\d+(?:\.\d+)?)px)?/);
          if (m315) prevY315 = m315[2] !== undefined ? parseFloat(m315[2]) : 0;
        }
        var shift = prevY315 + (fTop + 22) - lTop; /* লেবেল feed-শীর্ষ+২২px-প্যাডে — mask-fade-ব্যান্ড-নিচে */
        track315.style.translate = '0px ' + shift.toFixed(2) + 'px';
        track315.classList.add('sfs315-frozen');
        trackFrozen315 = track315;
        q315.frozen = 1;
        q315.shifts += 1;
      } catch (e315a) { q315.err = String((e315a && e315a.message) || e315a); }
    };
    window.__sfs315Unfreeze = function () {
      try {
        if (trackFrozen315) {
          trackFrozen315.classList.remove('sfs315-frozen');
          trackFrozen315.style.translate = '';
          trackFrozen315 = null;
        }
        q315.frozen = 0;
      } catch (e315b) { q315.err = String((e315b && e315b.message) || e315b); }
    };
  } catch (e315x) { q315.err = String((e315x && e315x.message) || e315x); }
  window.__sfs315QA = q315;
})();
</script>
<script>
/* session317 (sfs317): keynav aria-live ঘোষণা (PLANS session316-নোটের প্রস্তাব-②)
   • sfs314-keynav-হাইলাইটের স্ক্রিন-রিডার-ঘোষণা: গ্রুপ-লেবেল + বাংলা-অবস্থান (n/মোট) —
     visually-hidden role=status aria-live=polite অঞ্চলে; অঞ্চল-টি phone-অ্যাংকরের
     বাইরে (s306-একক-লিঙ্ক-চুক্তি অটুট — লিঙ্কের accessible-name-অপরিবর্তিত)।
   • চুক্তি: __sfs317Announce(lab, idx, total) / __sfs317Clear() — s314-ইঞ্জিনের
     guarded-হুক (sfs315-রীতি); ইঞ্জিন-অনুপস্থিতে নীরব-নন-ফায়ার।
   • QA-হুক __sfs317QA {announces, last, live(), text(), err} — সারি-শূন্যে-ও-সংজ্ঞায়িত (s306b-ধর্ম)। */
(function () {
  var q317 = { announces: 0, last: '', err: '' };
  try {
    var live317 = document.querySelector('.sfs317-live');
    var bn317 = function (n317) { return String(n317).replace(/[0-9]/g, function (d317) { return '০১২৩৪৫৬৭৮৯'.charAt(+d317); }); };
    window.__sfs317Announce = function (lab317, i317, n317) {
      try {
        if (!live317 || !lab317) return;
        var nm317 = String(lab317.textContent || '').replace(/\s+/g, ' ').trim();
        if (!nm317) return;
        var tx317 = nm317 + ((typeof i317 === 'number' && typeof n317 === 'number' && n317 > 0) ? ' — ' + bn317(i317 + 1) + '/' + bn317(n317) : '');
        live317.textContent = tx317;
        q317.announces += 1;
        q317.last = tx317;
      } catch (e317b) { q317.err = String((e317b && e317b.message) || e317b); }
    };
    window.__sfs317Clear = function () {
      try { if (live317) live317.textContent = ''; } catch (e317c) { q317.err = String((e317c && e317c.message) || e317c); }
    };
    q317.live = function () { return !!document.querySelector('.sfs317-live'); };
    q317.text = function () { var l317 = document.querySelector('.sfs317-live'); return l317 ? l317.textContent : ''; };
  } catch (e317x) { q317.err = String((e317x && e317x.message) || e317x); }
  window.__sfs317QA = q317;
})();
</script>
<script>
/* session318 (sfs318): keynav-অবস্থান-ব্যাজ (PLANS session317-নোটের প্রস্তাব-②)
   • sfs317-SR-ঘোষণার দৃশ্যমান-সমকক্ষ: keynav-হাইলাইট-মুহূর্তে ফোন-প্রিভিউতে ছোট-ব্যাজ
     "n/মোট" (বাংলা-অঙ্ক) — কীবোর্ড-ব্যবহারকারীর চাক্ষুষ-অবস্থা-প্রমাণ (SR-এর প্রতিটি
     ঘোষণার দৃশ্যমান-প্রতিরূপ — parity-নীতি)।
   • দ্বি-গেট: phone[data-sfs314-focus] (keynav-সক্রিয়) × data-sfs318-on (ব্যাজ-লেখা) —
     মাউস-ব্যবহারকারীর জন্য চির-অদৃশ্য (kbdhint-রীতি)।
