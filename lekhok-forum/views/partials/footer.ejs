<footer class="btclf-footer site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <h2><%= getContent('footer', 'brand', 'name', 'বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়') %></h2>
