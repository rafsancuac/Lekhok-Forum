<footer class="btclf-footer site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <h2><%= C('header_brand_line1') %></h2>
      <p><%= C('footer_brand_desc') %></p>
      <div class="f-socials">
        <%# session33: placeholder (#) লিংক → settings-এর আসল URL (হেডারের dropdown-এর মতোই) %>
        <a href="<%= typeof getSetting === 'function' ? (getSetting('facebook_url') || '#') : '#' %>" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
        <a href="<%= typeof getSetting === 'function' ? (getSetting('twitter_url') || '#') : '#' %>" target="_blank" rel="noopener" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
        <a href="<%= typeof getSetting === 'function' ? (getSetting('youtube_url') || '#') : '#' %>" target="_blank" rel="noopener" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
      </div>
    </div>
    <div>
      <h4 class="f-widget-title"><%= C('footer_links_title') %></h4>
      <ul class="f-links">
        <li><a href="/articles"><i class="fas fa-circle"></i> প্রকাশিত লেখা</a></li>
        <li><a href="/qa"><i class="fas fa-circle"></i> প্রশ্নোত্তর</a></li>
        <li><a href="/members"><i class="fas fa-circle"></i> সদস্য তালিকা</a></li>
        <li><a href="/committee"><i class="fas fa-circle"></i> কমিটি সদস্য</a></li>
        <li><a href="/constitution"><i class="fas fa-circle"></i> গঠনতন্ত্র</a></li>
        <li><a href="/about"><i class="fas fa-circle"></i> আমাদের সম্পর্কে</a></li>
      </ul>
    </div>
    <div>
      <h4 class="f-widget-title"><%= C('footer_contact_title') %></h4>
      <ul class="f-contact">
        <li><i class="fas fa-envelope"></i> <span><%= (typeof getSetting === 'function' && getSetting('contact_email')) || 'info@lekhokforum.org' %></span></li>
        <li><i class="fas fa-phone"></i> <span><%= (typeof getSetting === 'function' && getSetting('contact_phone')) || '০১********* (বিকাশ/নগদ)' %></span></li>
        <li><i class="fas fa-map-marker-alt"></i> <span><%= (typeof getSetting === 'function' && getSetting('contact_address')) || 'চট্টগ্রাম বিশ্ববিদ্যালয়, চট্টগ্রাম, বাংলাদেশ' %></span></li>
      </ul>
    </div>
    <div class="f-newsletter">
      <h4 class="f-widget-title"><%= C('footer_newsletter_title') %></h4>
      <p class="f-newsletter-desc"><%= C('footer_newsletter_desc') %></p>
      <form class="newsletter-form" id="newsletterForm" action="/api/newsletter/subscribe" method="post">
        <input type="email" name="email" id="newsletterEmail" placeholder="<%= C('footer_newsletter_placeholder') %>" required>
        <button type="submit"><%= C('footer_newsletter_btn') %></button>
      </form>
      <p class="f-newsletter-msg" id="newsletterMsg" role="status" aria-live="polite"></p>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> <%= C('footer_copyright') %></p>
      <p class="footer-credit"><%= C('footer_credit_label') %> <a href="https://rafsandaily.blogspot.com/p/blog-page_5.html" target="_blank" rel="noopener"><%= C('footer_credit_name') %></a></p>
    </div>
  </div>
</footer>
