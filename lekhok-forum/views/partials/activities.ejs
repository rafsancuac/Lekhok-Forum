<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>সাংগঠনিক কার্যক্রম — লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-calendar-check"></i> সাংগঠনিক কার্যক্রম</h1>
    </div>

    <% if (activities.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-calendar-check"></i><p>কোনো কার্যক্রম প্রকাশ করা হয়নি।</p></div>
    <% } else { %>
      <div class="articles-grid">
        <% activities.forEach(a => { %>
          <div class="post-card">
            <% if (a.image_url) { %><img src="<%= a.image_url %>" alt="cover" class="post-cover"><% } %>
            <div class="post-card-body">
              <div class="post-meta-top"><span class="post-date"><i class="far fa-calendar"></i> <%= a.scheduled_date %></span></div>
              <a href="/activities#item-<%= a.id %>" class="post-title"><%= a.title %></a>
              <p class="post-excerpt"><%= a.body.substring(0, 200) %>...</p>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
