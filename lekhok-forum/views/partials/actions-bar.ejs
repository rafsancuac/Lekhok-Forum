<%
  // Shared reactions + share + bookmark actions bar.
  // Params: targetId, targetType ('post'|'comment'), counts {like..angry}, mine, link,
  //         bookmarked (optional bool), showBookmark (optional, default true),
  //         commentCount / shareCount / viewCount (optional numbers — summary strip-এ দেখায়)
  //
  // ── সেশন ১০৫ (FB-২০২৪ পোস্ট-ফুটার সম্পূর্ণ-আপগ্রেড — ইউজার-স্পেসিফিকেশন) ──
  // ① মেট্রিক-রো: বামে ওভারল্যাপিং ইমোজি-সার্কেল (FB-হুবহু) + বোল্ড মোট-কাউন্ট —
  //    ক্লিকে রিঅ্যাক্টরস-মডাল (কে কোন রিঅ্যাক্ট দিয়েছে → ট্যাব-ফিল্টার → প্রোফাইল-লিংক;
  //    reactors-modal.js + GET /api/reactions/:type/:id/reactors)
  // ② ডানে কমেন্ট-কাউন্ট + শেয়ার-কাউন্ট পাশাপাশি — এখন সর্বদা দৃশ্যমান (০ হলেও,
  //    FB-রেফারেন্স লেআউট: "2 💬 20 ↪️")
  // ③ অ্যাকশন-রো: লাইক (হোভার-প্যালেট) · মন্তব্য · শেয়ার · সেভ — আগের মতোই
  // ④ শেয়ার-বাটন এখন একটিই (share-trigger) — ক্লিকে ঠিক ৩টি অপশনের মেনু:
  //    টাইমলাইনে শেয়ার করুন / মেসেজে পাঠান / পোস্টের লিংক কপি করুন
  //    (main.js-এর timeline/user/copy হ্যান্ডলার অপরিবর্তিত; সাবটাইটেলসহ FB-ধাঁচ)
  // ⑤ ৭ম রিঅ্যাকশন 'রাগ' (angry 😡) — সব-স্তরে (API REACTIONS + প্যালেট + ম্যাপ)
  // ⑥ আগের share-now এক-ক্লিক-বাটন সরানো হয়েছে — FB-স্পেক: একটিই শেয়ার-বাটন → মেনু
  //
  // সেশন ৮৭ (মার্জ-সেফ): summary-তে .reaction-summary/.rs-emojis/.rs-count ডুয়াল-ক্লাস —
  // main.js-এর hold+slide রিঅ্যাকশন-আপডেটার summary লাইভ-আপডেট করে (অক্ষত রাখুন)।
  // সেশন ৮৯: .rs-faces ফেসপাইল + lf:reactupdate লাইভ-অ্যাভাটার — অক্ষত।
  if (typeof showBookmark === 'undefined') showBookmark = true;
  if (typeof showShare === 'undefined') showShare = true;
  if (typeof bookmarked === 'undefined') bookmarked = false;
  if (typeof commentCount === 'undefined') commentCount = 0;
  if (typeof shareCount === 'undefined') shareCount = 0;
  if (typeof reactorFaces === 'undefined') reactorFaces = [];
  // সেশন ৯৩: inlineComments — ফিড-মোডে 'মন্তব্য' বাটন আর আলাদা-পেজে যায় না;
  // একই কার্ডে .fc-drawer টগল করে (comment-tools.js)। ডিফল্ট-false —
  // article-single/qa-single-এ আগের anchor-আচরণ অপরিবর্তিত।
  if (typeof inlineComments === 'undefined') inlineComments = false;
  var _meta = { like: '👍', love: '❤️', care: '🤗', haha: '😂', wow: '😮', sad: '😢', angry: '😡' };
  var _labels = { like: 'লাইক', love: 'ভালোবাসা', care: 'কেয়ার', haha: 'হাহা', wow: 'বিস্ময়', sad: 'দুঃখ', angry: 'রাগ' };
  var _mine = mine || 'like';
  var _topEmojis = Object.entries(counts || {}).filter(e => e[1] > 0).sort((a, b) => b[1] - a[1]).slice(0, 3).map(e => _meta[e[0]]);
  var _total = Object.values(counts || {}).reduce((a, b) => a + (b || 0), 0);
%>
<div class="actions-block">
  <div class="actions-bar">
    <% if (targetType === 'post') { %>
    <%# সেশন ৮৭: summary এখন actions-bar-এর ভেতরে (flex-basis:100% → নিজস্ব-রো) —
        main.js-এর আপডেটার t.parentElement(=.actions-bar)-এর ভেতরে .reaction-summary
        খোঁজে; সেশন ১০৫: .reaction-summary এখন <button> — ক্লিকে রিঅ্যাক্টরস-মডাল
        (data-reactors-for/type দেখে reactors-modal.js); লাইভ-আপডেট-শৃঙ্খল অক্ষত। %>
    <div class="actions-summary">
      <span class="as-left">
        <button type="button" class="reaction-summary as-click" data-reactors-for="<%= targetId %>" data-reactors-type="<%= targetType %>" title="কে কোন প্রতিক্রিয়া দিয়েছে দেখুন" aria-haspopup="dialog"><span class="rs-faces"<% if (!reactorFaces.length) { %> hidden<% } %>><% reactorFaces.forEach(function (f) { %><img loading="lazy" decoding="async" class="rsf-av" src="<%= f.avatar_url || '/avatar/' + f.id %>" alt="" data-uid="<%= f.id %>" title="<%= (f.pen_name || f.full_name || '') %>" onerror="this.style.display='none'"><% }); %></span><span class="as-emojis rs-emojis"><% if (_total > 0) { _topEmojis.forEach(function (em) { %><span><%= em %></span><% }); } %></span><span class="as-count rs-count"><% if (_total > 0) { %><%= _total %><% } %></span></button>
      </span>
      <span class="as-right">
        <% if (inlineComments) { %>
        <button type="button" class="as-stat as-stat-btn" title="মন্তব্য" data-toggle-comments="<%= targetId %>"><span><%= commentCount || 0 %></span><i class="far fa-comment"></i></button>
        <% } else { %>
        <a href="<%= link %>#comments" class="as-stat" title="মন্তব্য"><span><%= commentCount || 0 %></span><i class="far fa-comment"></i></a>
        <% } %>
        <%# সেশন ১০৫: শেয়ার-কাউন্ট সর্বদা (FB-রেফারেন্স: 20 ↪️) %>
        <span class="as-stat" title="শেয়ার"><span><%= shareCount || 0 %></span><i class="fas fa-share"></i></span>
        <% if (typeof viewCount !== 'undefined' && viewCount !== null) { %><span class="as-stat" title="পঠিত"><span><%= viewCount %></span><i class="far fa-eye"></i></span><% } %>
      </span>
    </div>
    <% } %>
    <div class="react-wrap" data-target-id="<%= targetId %>" data-target-type="<%= targetType %>">
      <div class="reaction-picker" role="menu" aria-label="প্রতিক্রিয়া নির্বাচন">
        <% Object.keys(_meta).forEach(function (k) { %>
          <button type="button" class="reaction-opt<%= mine === k ? ' selected' : '' %>" data-reaction="<%= k %>" title="<%= _labels[k] %>"><%= _meta[k] %></button>
        <% }); %>
      </div>
      <button type="button" class="reaction-btn main-react <%= mine ? 'active' : '' %>" data-mine="<%= mine || '' %>" aria-label="প্রতিক্রিয়া দিন">
        <span class="rb-emoji"><%= mine ? _meta[mine] : '👍' %></span>
        <span class="rb-label"><%= mine ? _labels[mine] : 'লাইক' %></span>
      </button>
    </div>

    <%# সেশন ৯৩: ফিডে ইনলাইন-টগল (কোনো রিডাইরেক্ট নেই) · পেজে আগের anchor %>
    <% if (inlineComments) { %>
    <button type="button" class="reaction-btn" data-toggle-comments="<%= targetId %>"><i class="far fa-comment"></i> মন্তব্য</button>
    <% } else { %>
    <a class="reaction-btn" href="<%= link %>#comments"><i class="far fa-comment"></i> মন্তব্য</a>
    <% } %>

    <% if (showShare) { %>
    <%# সেশন ১০৫: FB-স্পেক — একটিই শেয়ার-বাটন, ক্লিকে ঠিক ৩টি অপশনসমৃদ্ধ মেনু
        (টাইমলাইন / মেসেজে পাঠান / লিংক কপি)। সাব-টেক্সটসহ স্মুথ ড্রপডাউন। %>
    <div class="share-wrap">
      <button type="button" class="reaction-btn share-trigger" aria-haspopup="menu" title="শেয়ার অপশন">
        <i class="fas fa-share"></i> <span>শেয়ার</span>
      </button>
      <div class="share-menu share-menu--fb" role="menu" data-share-url="<%= typeof link !== 'undefined' ? link : '' %>" data-share-post="<%= targetType === 'post' ? targetId : '' %>">
        <% if (typeof user !== 'undefined' && user && targetType === 'post') { %>
        <button type="button" class="smx-item" data-share="timeline" role="menuitem">
          <span class="smx-ico"><i class="fas fa-retweet"></i></span>
          <span class="smx-txt"><strong>টাইমলাইনে শেয়ার করুন</strong><small>এখনই আপনার ফিডে প্রকাশ করুন</small></span>
        </button>
        <button type="button" class="smx-item" data-share="user" role="menuitem">
          <span class="smx-ico"><i class="far fa-paper-plane"></i></span>
          <span class="smx-txt"><strong>মেসেজে পাঠান</strong><small>বন্ধুদের ইনবক্সে ফরোয়ার্ড করুন</small></span>
        </button>
        <% } else if (targetType === 'post') { %>
        <a class="smx-item" href="/login" role="menuitem">
          <span class="smx-ico"><i class="fas fa-retweet"></i></span>
          <span class="smx-txt"><strong>টাইমলাইনে শেয়ার করুন</strong><small>শেয়ার করতে লগইন করুন</small></span>
        </a>
        <% } %>
        <button type="button" class="smx-item" data-share="copy" role="menuitem">
          <span class="smx-ico"><i class="fas fa-link"></i></span>
          <span class="smx-txt"><strong class="smx-copylabel">পোস্টের লিংক কপি করুন</strong><small>সরাসরি শেয়ার করার জন্য</small></span>
        </button>
      </div>
    </div>
    <% } %>

    <% if (showBookmark && user) { %>
    <button type="button" class="reaction-btn bookmark-btn <%= bookmarked ? 'active' : '' %>" data-bookmark-id="<%= targetId %>" aria-label="সংরক্ষণ">
      <i class="<%= bookmarked ? 'fas' : 'far' %> fa-bookmark"></i>
    </button>
    <% } %>
  </div>
</div>
