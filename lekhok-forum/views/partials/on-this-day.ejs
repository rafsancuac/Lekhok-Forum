<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>আজকের এই দিনে — বাংলাদেশ তরুণ কলাম লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <div class="page-wrap" style="max-width:700px">
    <div class="page-header">
      <h1><i class="fas fa-calendar-day"></i> আজকের এই দিনে</h1>
      <span class="today-date"><i class="far fa-calendar"></i> <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    </div>

    <% if (today) { %>
      <div class="daily-card history-card">
        <div class="daily-card-badge history"><i class="fas fa-history"></i> ইতিহাস</div>
        <h2><%= today.title %></h2>
        <% if (today.image_url) { %>
          <img src="<%= today.image_url %>" alt="image" style="max-width:100%;border-radius:8px;margin:12px 0">
        <% } %>
        <p class="daily-body"><%= today.body %></p>
        <div class="daily-meta">প্রকাশ: <%= new Date(today.created_at).toLocaleDateString('bn-BD') %></div>
      </div>
    <% } else { %>
      <div class="empty-state-full">
        <i class="fas fa-calendar-day"></i>
        <p>আজকের জন্য কোনো তথ্য নেই।</p>
      </div>
    <% } %>
  </div>
</body>
</html>
