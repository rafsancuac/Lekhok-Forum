<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' && title ? title : 'বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/feed.css?v=<%= AV %>" />
  <%# পেজ-নির্দিষ্ট স্টাইলশিট (HTML nesting fix-এর পর পেজের নিজস্ব head আর নেই —
      সেখান থেকে এখানে এসেছে) —%>
  <% if (typeof extra_css !== 'undefined' && extra_css) { extra_css.forEach(function (href) { %>
  <link rel="stylesheet" href="<%= href %><%= href.indexOf('/') === 0 ? '?v=' + AV : '' %>" />
  <% }) } %>
</head>
<body>
<%# Apply per-user display preferences (theme / font size / font family) early to avoid flash %>
<% if (user) { %>
<script>
(function () {
  try {
    var prefs = <%- JSON.stringify(typeof displayPrefs !== 'undefined' ? displayPrefs : {}) %>;
    var c = document.documentElement.classList;
    if (prefs.theme === 'dark') c.add('theme-dark');
    if (prefs.theme === 'light') c.add('theme-light');
    if (prefs.font_size === 'small') c.add('fs-small');
    if (prefs.font_size === 'large') c.add('fs-large');
    // Apply font family class to body as soon as DOM is ready
    var ALLOWED_FF = ['bn','serif','sans','mixed','hand','display','durnibar','lipi'];
    var ff = ALLOWED_FF.indexOf(prefs.font_family) >= 0 ? prefs.font_family : 'bn';
    document.addEventListener('DOMContentLoaded', function () {
      document.body.classList.add('font-' + ff);
    });
  } catch (e) {}
})();
</script>
<% } %>

<!-- ============= Top bar ============= -->
<div class="btclf-topbar topbar" id="topbar">
  <div class="topbar-inner">

    <a href="/" class="brand">
      <div class="logo-wrap">
        <div class="logo-text logo-text-v2">
          <strong>বাংলাদেশ তরুণ কলাম লেখক ফোরাম</strong>
          <strong class="brand-line2">চট্টগ্রাম বিশ্ববিদ্যালয়</strong>
        </div>
      </div>
    </a>

    <!-- 4 main tabs (visible on desktop, hidden on mobile) -->
    <% if (user) { %>
    <nav class="topbar-tabs">
      <a href="/dashboard" class="topbar-tab <%= currentPath === '/dashboard' ? 'active' : '' %>">
        <i class="fas fa-globe-asia"></i> কমিউনিটি ফিড
      </a>
      <a href="/me" class="topbar-tab <%= currentPath === '/me' ? 'active' : '' %>">
        <i class="fas fa-user-circle"></i> ব্যক্তিগত ফিড
      </a>
      <a href="/messages" class="topbar-tab <%= currentPath && currentPath.indexOf('/messages') === 0 ? 'active' : '' %>">
        <i class="fas fa-comments"></i> মেসেজ
        <% if (typeof msgBadge !== 'undefined' && msgBadge > 0) { %><span class="badge"><%= msgBadge %></span><% } %>
      </a>
      <a href="/settings" class="topbar-tab <%= currentPath && currentPath.indexOf('/settings') === 0 ? 'active' : '' %>">
        <i class="fas fa-sliders-h"></i> সেটিংস
      </a>
    </nav>
    <% } else { %>
    <nav class="topbar-tabs">
      <a href="/" class="topbar-tab <%= currentPath === '/' ? 'active' : '' %>">হোম</a>
      <div class="topbar-dropdown">
        <a href="/about" class="topbar-tab <%= currentPath === '/about' || currentPath === '/constitution' ? 'active' : '' %>">পরিচিতি <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
        <div class="topbar-dropdown-menu">
          <a href="/about"><i class="fas fa-info-circle"></i> সংগঠন পরিচিতি</a>
          <a href="/about#activities"><i class="fas fa-tasks"></i> আমাদের কার্যাক্রম</a>
          <a href="/about#magazine"><i class="fas fa-book"></i> পত্রিকায় পাতায় লেখক ফোরাম</a>
          <a href="/constitution"><i class="fas fa-scroll"></i> গঠনতন্ত্র</a>
          <a href="/about#soldier"><i class="fas fa-fighter-jet"></i> কলম সৈনিক হতে চান?</a>
          <a href="/about#conditions"><i class="fas fa-clipboard-list"></i> সদস্য হওয়ার শর্তাবলি</a>
        </div>
      </div>
      <div class="topbar-dropdown">
        <a href="/committee" class="topbar-tab <%= currentPath === '/committee' || currentPath === '/members' || currentPath === '/committee/past' ? 'active' : '' %>">কার্যনির্বাহী পরিষদ <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
        <div class="topbar-dropdown-menu">
          <a href="/committee#advisory"><i class="fas fa-user-tie"></i> উপদেষ্টাদের তালিকা</a>
          <a href="/committee"><i class="fas fa-users-cog"></i> রানিং কমিটি</a>
          <a href="/members"><i class="fas fa-users"></i> সদস্য পরিচিতি</a>
        </div>
      </div>
      <div class="topbar-dropdown">
