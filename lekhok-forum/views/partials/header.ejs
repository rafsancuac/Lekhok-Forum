        <a href="/admin"><i class="fas fa-shield-alt"></i> অ্যাডমিন প্যানেল</a>
      <% } %>
      <a href="/logout" class="mobile-logout"><i class="fas fa-sign-out-alt"></i> লগআউট</a>
    </div>
  <% } else { %>
    <div class="mobile-section">
      <a href="/"><i class="fas fa-home"></i> হোম</a>
      <a href="/about"><i class="fas fa-info-circle"></i> পরিচিতি</a>
      <a href="/committee"><i class="fas fa-users-cog"></i> কমিটি</a>
      <a href="/gallery"><i class="fas fa-images"></i> গ্যালারি</a>
      <a href="/contact"><i class="fas fa-envelope"></i> যোগাযোগ</a>
    </div>
    <a href="/login" class="mobile-cta"><i class="fas fa-sign-in-alt"></i> লগইন</a>
    <a href="/register" class="mobile-cta primary"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন</a>
  <% } %>
</aside>

