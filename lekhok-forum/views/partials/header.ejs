        <button type="button" class="dlx-trigger" id="dlxTrigger" aria-haspopup="true" aria-expanded="false" aria-controls="dlxPanel" aria-label="ফোরাম ডিরেক্টরি — সব ফিচার ও আয়োজন" title="ফোরাম ডিরেক্টরি" onclick="toggleDlx(event)">
