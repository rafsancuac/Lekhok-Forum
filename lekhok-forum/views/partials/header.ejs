          </button>
          <div class="notif-dropdown" id="notifDropdown">
            <div class="notif-header">
              <span>বিজ্ঞপ্তি</span>
              <a href="/notifications" class="notif-see-all">সব দেখুন</a>
            </div>
            <%# সেশন ১৪৪: ?type= কুইক-ফিল্টার-চিপ (session-১২১-ঐচ্ছিক-বকেয়া) —
                রেজিস্ট্রি helpers/notif-groups.js (app.locals.notifGroups) — ফুল-পেজের
                server-side প্রি-ফিল্টার-হোয়াইটলিস্টের সাথে সমলয়। খাঁটি-লিঙ্ক (noscript-নিরাপদ);
                ড্রপডাউনের ভেতরের লাইভ-লিস্ট অপরিবর্তিত (লিঙ্কে-গেলেই প্রি-ফিল্টারড ফুল-পেজ)। %>
            <% if (notifGroups && notifGroups.G117) { %>
              <div class="nq-chiprow" role="navigation" aria-label="বিজ্ঞপ্তির ধরন-অনুযায়ী দ্রুত ফিল্টার">
                <% notifGroups.G117.forEach(function (g140) { if (!g140.types.length) return; %>
                  <a class="nq-chip" href="/notifications?type=<%= g140.key %>" title="<%= g140.label %> বিজ্ঞপ্তি দেখুন">
                    <i class="fas <%= g140.icon %>" aria-hidden="true"></i><span><%= g140.label %></span>
                  </a>
                <% }) %>
              </div>
            <% } %>
            <div id="notifList">
              <% if (typeof recentNotifs !== 'undefined' && recentNotifs && recentNotifs.length) { %>
                <% var _ico = { message: 'fa-comment-dots', like: 'fa-thumbs-up', react: 'fa-heart', reaction: 'fa-heart', reply: 'fa-reply', comment: 'fa-comment', share: 'fa-share', follow: 'fa-user-plus', complaint: 'fa-flag', notice: 'fa-bullhorn', mention: 'fa-at', answer: 'fa-question-circle', answer_accepted: 'fa-circle-check', call: 'fa-phone-slash' }; %>
                <% recentNotifs.forEach(n => { %>
                  <%# সেশন ১২৩: data-n restore-পেলোড — ফুল-পেজ (notifications.ejs) ও paintList-চুক্তি অভিন্ন %>
                  <a href="<%= n.link || '/notifications' %>" class="notif-item <%= n.is_read ? '' : 'unread' %>" data-n="<%= JSON.stringify({ i: n.id, t: n.type, ti: n.title || '', b: n.body || '', l: n.link || '', r: n.is_read ? 1 : 0, ts: n.created_at || '' }) %>">
                    <%# সেশন ১০২-ইউনিয়ন: actor-avatar (actor_id JOIN + legacy link-fallback) — ছবি নাহলে টাইপ-রঙা আইকন (live.js-এর সাথে সমান) %>
                    <% if (n.actor_id) { %>
                      <span class="notif-ico has-avatar"><img class="notif-avatar" src="<%= n.actor_avatar || ('/avatar/' + n.actor_id) %>" alt="" loading="lazy" onerror="this.parentNode.classList.remove('has-avatar');this.remove()"><i class="fas <%= _ico[n.type] || 'fa-bell' %>"></i></span>
                    <% } else { %>
                      <span class="notif-ico ico-<%= n.type %>"><i class="fas <%= _ico[n.type] || 'fa-bell' %>"></i></span>
                    <% } %>
                    <span class="notif-text">
                      <span class="notif-body"><%= n.body %></span>
                      <%# সেশন ১২২: রিলেটিভ-টাইম (LekhokRelTime [data-ts]-চুক্তি) — কাঁচা ডেটটাইম আর নয় %>
                      <span class="notif-time" data-ts="<%= n.created_at %>"><%= n.created_at %></span>
                      <% if (n.type === 'call') { %><span class="notif-missed" title="মিসড কল"><i class="fas fa-phone-slash"></i> মিসড কল</span><% } %>
                    </span>
                    <% if (!n.is_read) { %><span class="notif-dot" title="অপঠিত"></span><% } %>
                    <%# সেশন ১২১: ড্রপডাউনেও dismiss ✕ (session117-①; ফুল-পেজের .notif-dismiss-প্যারিটি) —
                        বাটন-ইন-অ্যাঙ্কর = session114-প্রেসিডেন্সি; preventDefault-এ নেভিগেশন-বন্ধ %>
                    <button type="button" class="notif-x" data-dismiss="<%= n.id %>" aria-label="বিজ্ঞপ্তিটি সরান" title="সরান"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                  </a>
                <% }); %>
              <% } else { %>
                <div class="notif-empty"><i class="far fa-bell"></i><p>কোনো বিজ্ঞপ্তি নেই</p></div>
              <% } %>
            </div>
          </div>
        </div>
        <%# সেশন ১২১: ড্রপডাউন dismiss-হ্যান্ডলার — #notifList-এ ডেলিগেটেড (live.js-রি-রেন্ডারেও টিকে থাকে);
            সার্ভার-সত্য-ব্যাজ /api/notifications/count দিয়ে; খালি-হলে empty-state। main.js (মিনিফাইড) অস্পৃশ্য %>
        <script>
          (function () {
            var list121 = document.getElementById('notifList');
            if (!list121 || list121.dataset.xBound121) return;
            list121.dataset.xBound121 = '1';
            function badge121() {
              fetch('/api/notifications/count', { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                  if (!d || typeof d.unread !== 'number') return;
                  var b = document.getElementById('notifBadge');
                  if (d.unread <= 0) { if (b) b.remove(); return; }
                  if (!b) {
                    var btn = document.querySelector('.notif-bell-btn');
                    if (!btn) return;
                    b = document.createElement('span'); b.className = 'notif-badge'; b.id = 'notifBadge';
                    btn.appendChild(b);
                  }
                  b.textContent = d.unread > 9 ? '9+' : String(d.unread);
                }).catch(function () {});
            }
            function empty121() {
              if (list121.querySelector('.notif-item')) return;
              list121.innerHTML = '<div class="notif-empty"><i class="far fa-bell"></i><p>কোনো বিজ্ঞপ্তি নেই</p></div>';
            }
            function dismiss121(btn) {
              var row = btn.closest('.notif-item');
              if (!row || row.dataset.xBusy121) return;
              row.dataset.xBusy121 = '1';
              /* সেশন ১২৩: restore-পেলোড ক্যাপচার — টোস্টের 'বাতিল করুন' এতে ফিরিয়ে দেয় */
              var payload = null;
              try { payload = JSON.parse(row.getAttribute('data-n') || 'null'); } catch (_) {}
              fetch('/api/notifications/' + encodeURIComponent(btn.getAttribute('data-dismiss')) + '/dismiss', { method: 'POST', credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                  if (d && d.ok) {
                    row.classList.add('dx-out');
                    setTimeout(function () { row.remove(); empty121(); }, 200);
                    badge121();
                    /* সেশন ১২৩: আন্ডু-টোস্ট (lfUndoShow — undo-toast.js; ফুল-পেজের সাথে প্যারিটি) */
                    if (payload && window.lfUndoShow) {
                      window.lfUndoShow({
                        message: 'বিজ্ঞপ্তি সরানো হয়েছে',
                        ms: 7000,
                        onUndo: function (after) {
                          fetch('/api/notifications/restore', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'same-origin',
                            body: JSON.stringify(payload)
                          }).then(function (r) { return r.json(); }).then(function (j) {
                            if (j && j.ok) {
                              row.classList.remove('dx-out');
                              delete row.dataset.xBusy121;
                              /* এম্পটি-স্টেট এঁকে-থাকলে সরাও; রো ফিরিয়ে আনো */
                              var emp = list121.querySelector('.notif-empty');
                              if (emp) emp.remove();
                              var first = list121.querySelector('.notif-item');
                              if (row.parentNode) row.parentNode.removeChild(row);
                              if (first) list121.insertBefore(row, first);
                              else list121.appendChild(row);
                              /* session133: রিস্টোর-রো-সহ ড্রপডাউনের আপেক্ষিক-সময় রি-পেইন্ট —
                                 data-ts→LekhokRelTime চুক্তি (7s-টোস্টে 'N মিনিট আগে' বাউন্ডারি-স্লিপ প্রতিরোধ) */
                              try { if (window.LekhokRelTime) window.LekhokRelTime.render(list121); } catch (_) {}

                              badge121();
                            } else if (window.showToast) showToast('বাতিল করা যায়নি', 'error');
                            after();
                          }).catch(function () {
                            if (window.showToast) showToast('বাতিল করা যায়নি', 'error');
                            after();
                          });
                        }
                      });
                    }
                  } else { delete row.dataset.xBusy121; }
                })
                .catch(function () { delete row.dataset.xBusy121; });
            }
            list121.addEventListener('click', function (e) {
              var x = e.target.closest('.notif-x');
              if (!x) return;
              e.preventDefault(); e.stopPropagation();
              dismiss121(x);
            });
            list121.addEventListener('keydown', function (e) {
              if (e.key !== 'Enter' && e.key !== ' ') return;
              var x = e.target.closest('.notif-x');
              if (!x) return;
              e.preventDefault(); e.stopPropagation();
              dismiss121(x);
            });
          })();
        </script>

