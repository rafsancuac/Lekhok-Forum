              <section class="dlx-sec">
                <h3 class="dlx-sec-title"><%= sec.title %></h3>
                <div class="dlx-grid">
                  <% sec.items.forEach(function (it) { %>
                    <a href="<%= it.href %>" class="dlx-item" data-dlx-item>
                      <span class="dlx-ico" style="--dlx-t: var(<%= it.tok %>)" aria-hidden="true"><i class="fas <%= it.icon %>"></i></span>
                      <span class="dlx-meta">
