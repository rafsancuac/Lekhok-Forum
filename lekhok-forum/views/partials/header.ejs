<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="MwDt57-lqUDC5XAeiiYy0BH11xb5mPRzcyp7A4aibCg" />
  <%
    // ── SEO locals (guarded — every var optional; passed via include params) ─
    var BRAND_FULL = 'লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়';
    var seoTitle = (typeof title !== 'undefined' && title ? title : (typeof seoTitle !== 'undefined' && seoTitle ? seoTitle : BRAND_FULL));
    var seoDesc = (typeof metaDesc !== 'undefined' && metaDesc)
      ? metaDesc
      : (typeof seoDesc !== 'undefined' && seoDesc ? seoDesc : BRAND_FULL + ', একটি শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। মূলমন্ত্র: তারুণ্যের শাণিত কলমে আলোকিত ধরনী।');
    var seoType = (typeof ogType !== 'undefined' && ogType) ? ogType : 'website';
    // সেশন ৭২ (GSC-ফিক্স): ডিফল্ট OG-ইমেজ — আগে ইমেজহীন শেয়ার-কার্ড যেত
    var seoImg = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : ((typeof siteUrl !== 'undefined' ? siteUrl : '') + '/assets/img/og-default.png');
    var seoPub = (typeof publishedTime !== 'undefined') ? publishedTime : null;
    var seoAuth = (typeof authorName !== 'undefined') ? authorName : null;
    var seoUrl = (typeof siteUrl !== 'undefined' ? siteUrl : '') + ((typeof canonicalPath !== 'undefined' && canonicalPath) ? canonicalPath : (typeof currentPath !== 'undefined' ? currentPath : '/'));
    // Private app areas must never be indexed
    // সেশন ৭২ (GSC-ফিক্স): (১) 'quiz' বাদ — আজকের কুইজ পাবলিক ডেইলি-কনটেন্ট, GSC-তে
    // "Excluded by noindex" হয়ে সূচিবদ্ধ হচ্ছিল না; উত্তর সার্ভার-সাইডে যাচাই হয়
    // (view-source চিটিং সম্ভব নয়) তাই ইনডেক্স করা নিরাপদ। (২) অ্যাংকর+ওয়ার্ড-বাউন্ডারি —
    // আগের সাবস্ট্রিং-regex `/me`-র কারণে ভবিষ্যতে `/members`-জাতীয় পাবলিক পাথও ম্যাচ করত।
    var seoNoindex = /^\/(admin|dashboard|messages|me|settings|notifications|bookmarks|complaints)(\/|$|\?)/.test(typeof currentPath !== 'undefined' ? currentPath : '/');
  %>
  <title><%= seoTitle %></title>
  <meta name="description" content="<%= seoDesc %>" />
  <% if (seoNoindex) { %><meta name="robots" content="noindex, nofollow" /><% } %>
  <link rel="canonical" href="<%= seoUrl %>" />
  <meta property="og:site_name" content="<%= BRAND_FULL %>" />
  <meta property="og:type" content="<%= seoType %>" />
  <meta property="og:title" content="<%= seoTitle %>" />
  <meta property="og:description" content="<%= seoDesc %>" />
  <meta property="og:url" content="<%= seoUrl %>" />
  <meta property="og:locale" content="bn_BD" />
  <% if (seoImg) { %>
  <meta property="og:image" content="<%= seoImg %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="<%= seoImg %>" />
  <% } else { %>
  <meta name="twitter:card" content="summary" />
  <% } %>
  <meta name="twitter:title" content="<%= seoTitle %>" />
  <meta name="twitter:description" content="<%= seoDesc %>" />
  <% if (seoType === 'article') { %>
    <% if (seoPub) { %><meta property="article:published_time" content="<%= seoPub %>" /><% } %>
    <% if (seoAuth) { %><meta property="article:author" content="<%= seoAuth %>" /><% } %>
  <% } %>
  <%# সেশন ৭২ (GSC-ফিক্স): সাইট-ওয়াইড JSON-LD — Organization + WebSite/SearchAction %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%= siteUrl %>/#organization",
        "name": "<%= typeof siteName !== 'undefined' ? siteName : 'লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়' %>",
        "url": "<%= siteUrl %>/",
        "logo": "<%= siteUrl %>/assets/img/og-default.png",
        "description": "<%= seoDesc %>"
      },
      {
        "@type": "WebSite",
        "@id": "<%= siteUrl %>/#website",
        "url": "<%= siteUrl %>/",
        "name": "<%= typeof siteName !== 'undefined' ? siteName : 'লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়' %>",
        "inLanguage": "bn",
        "publisher": { "@id": "<%= siteUrl %>/#organization" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "<%= siteUrl %>/search?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>
  <link rel="alternate" type="application/rss+xml" title="লেখক ফোরাম — সাম্প্রতিক লেখা" href="/rss.xml" />
  <%# সেশন ৭২: preconnect — আসল CSS-উৎস cdnjs %>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>" />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>" />
  <link rel="stylesheet" href="/assets/css/feed.css?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>" />
  <%# সেশন ৫৮: প্রিমিয়াম-রেস্পন্সিভ-অ্যানিমেটেড পলিশ-লেয়ার (additive) -%>
  <link rel="stylesheet" href="/assets/css/premium.css?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>" />
  <%# পেজ-নির্দিষ্ট স্টাইলশিট (HTML nesting fix-এর পর পেজের নিজস্ব head আর নেই,
      সেখান থেকে এখানে এসেছে) -%>
  <% if (typeof extra_css !== 'undefined' && extra_css) { extra_css.forEach(function (href) { %>
  <link rel="stylesheet" href="<%= href %><%= href.indexOf('/') === 0 ? '?v=' + AV + (typeof XTPQ !== 'undefined' ? XTPQ : '') : '' %>" />
  <% }) } %>
  <%# সেশন ৯৪: গ্লোবাল কল-রিংগার-স্টাইল — লগড-ইন ইউজারের যেকোনো পেজে আসন্ন-কল-মোডাল রেন্ডার হতে পারে %>
  <% if (typeof user !== 'undefined' && user) { %>
  <link rel="stylesheet" href="/assets/css/calls.css?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>" />
  <% } %>
  <%# ── সেশন ১০৫: গ্লোবাল ডিজাইন-সিস্টেম (Single Source of Truth) ──
      tokens.css সর্বশেষ লোড হয় (ক্যাসকেড-গ্যারান্টি: লিগ্যাসি :root-ওভাররাইড জয়ী)।
      কেউ এই দুই লিংকের অর্ডার বদলাবেন না — guard-design-system.js ধরে ফেলবে। %>
  <link rel="stylesheet" href="/assets/css/shared.css?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>" />
  <%# ── সেশন ১১৯: স্যান্ডবক্স-গেটওয়ে fetch-পোর্ট-সংরক্ষণ (header-পার্শিয়াল-পেজগুলোতে) —
      session116-এর প্যাচ কেবল layout.ejs/admin-sidebar-এ ছিল; header-পার্শিয়াল দিয়ে খোলা
      পেজে (qa-single/profile/settings/notifications…) JS-fetch('/api/…') প্যারাম-হীন যেত →
      গেটওয়ে Next.js-অ্যাপে 404-HTML (ডিসমিস/রিড/রিঅ্যাক্ট সব নীরবে ফেইল)। এখানে একই
      আইডেম্পোটেন্ট প্যাচ (guard ভাগ) — layout-সহ পেজে ডাবল-প্যাচ অসম্ভব। প্রোডাকশনে
      location.search-এ প্যারাম নেই → নো-অপ (বাইট-অভিন্ন আচরণ)। ── %>
  <script>
  (function () {
    var m = /(?:[?&])XTransformPort=(\d+)/.exec(location.search);
    if (!m || window.__xtpFetchPatched) return;
    window.__xtpFetchPatched = true;
    var qp = 'XTransformPort=' + m[1];
    var _fetch = window.fetch ? window.fetch.bind(window) : null;
    if (!_fetch) return;
    window.fetch = function (input, init) {
      try {
        var url = (input && typeof input === 'object' && input.url) ? input.url : String(input || '');
        if (url.charAt(0) === '/' && url.indexOf('XTransformPort=') === -1) {
          input = url + (url.indexOf('?') > -1 ? '&' : '?') + qp;
        }
      } catch (e) {}
      return _fetch(input, init);
    };
  })();
  </script>
  <%# সেশন ১৪৭: বাংলা-সংখ্যা চুক্তি — ক্লায়েন্ট-মিরর (single-source helpers/bn-number.js;
      layout.ejs-টুইনেও আছে)। main.js-রিঅ্যাকশন-ইঞ্জিন (.rs-count) ও comment-tools.js
      (bnNum) এর উপর ডেলিগেট করে — ফিড/প্রোফাইল/একক-পোস্ট সব সারফেসে কাউন্টার বাংলায় লক। %>
  <script>
  window.toBnNumber = window.toBnNumber || function (num) {
    if (num === undefined || num === null || num === '') return '০';
    var s = String(num);
    if (s.trim() === '' || s.trim() === 'NaN') return '০';
    return s.replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; });
  };
  </script>
</head>
<body data-auth="<%= (typeof user !== 'undefined' && user) ? '1' : '0' %>"<% if (typeof user !== 'undefined' && user) { %> data-uid="<%= user.id %>" data-avatar="<%= user.avatar_url || ('/avatar/' + user.id) %>" data-name="<%= ((user.pen_name || user.full_name) || '').replace(/"/g, '&quot;') %>" data-uname="<%= user.username %>"<% } %>>
  <%# সেশন ৭২: ক্যাশড-অ্যানোনিমাস পেজে লগড-ইন ইউজার ধরলে ?_u= রিফ্রেশ (ক্যাশ-বাইপাস) — বিস্তারিত auth-sync.js-এ %>
  <script src="/assets/js/auth-sync.js?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>"></script>
  <%# সেশন ৯৪: গ্লোবাল কল-রিংগার — লগড-ইন ইউজার মেসেঞ্জারের বাইরেও (ড্যাশবোর্ড/প্রোফাইল/
      লেখা ইত্যাদি সব মেম্বার-পেজে) আসন্ন কলের রিং শোনেন ও গ্রহণ/প্রত্যাখ্যান করতে পারেন।
      মেসেঞ্জার-ভিউগুলো পরে window.LekhokCallCtx সমৃদ্ধ করে (convId/peer) — মডিউল লেজি-পাঠ করে। %>
  <% if (typeof user !== 'undefined' && user) { %>
  <script>
    window.LekhokCallCtx = {
      me: <%- parseInt(user.id, 10) %>,
      meName: <%- jesc(user.full_name || user.username) %>,
      meAvatar: <%- jesc(user.avatar_url || ('/avatar/' + user.id)) %>,
      convId: 0,
      convUsername: null,
      isGroup: false,
      peer: null
    };
    <% /* সেশন ৯৭: env-configurable TURN (Metered.ca-গ্রাউন্ডওয়ার্ক) — openrelay
          অস্থিতিশীল হওয়ায় Vercel-এ LEKHOK_TURN_URLS/LEKHOK_TURN_USERNAME/
          LEKHOK_TURN_CREDENTIAL দিলে সেটিই ব্যবহার হয় (ডিফল্ট openrelay অক্ষত)।
          নোট: TURN ক্রেডেনশিয়াল WebRTC-তে স্বভাবতই ক্লায়েন্ট-দৃশ্যমান — সীমাবদ্ধ
          কোটা-ক্রেডেনশিয়ালই স্ট্যান্ডার্ড প্র্যাকটিস। */
      var _turnUrls = String(process.env.LEKHOK_TURN_URLS || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean); %>
    <% if (_turnUrls.length) { %>
    window.LekhokCallCtx.iceServers = [
      { urls: 'stun:stun.l.google.com:19302' },
      { urls: 'stun:stun1.l.google.com:19302' },
      { urls: <%- JSON.stringify(_turnUrls) %>, username: <%- jesc(process.env.LEKHOK_TURN_USERNAME || '') %>, credential: <%- jesc(process.env.LEKHOK_TURN_CREDENTIAL || '') %> }
    ];
    <% } %>
  </script>
  <script src="/assets/js/webrtc-call.js?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>"></script>
  <% } %>
  <%# সেশন ১২৩: ডিসমিস-আন্ডু টোস্ট — window.lfUndoShow; ড্রপডাউন dismiss121-IIFE-এর আগে লোড হওয়া জরুরি (non-defer) %>
  <script src="/assets/js/undo-toast.js?v=<%= AV %><%= typeof XTPQ !== 'undefined' ? XTPQ : '' %>"></script>
<%# সেশন ৬৭: data-auth — main.js লগইন-গার্ডের নির্ভরযোগ্য সোর্স (যেকোনো লেআউটে) -%>
  <!-- Back to top (session 59) -->
  <button type="button" class="back-to-top" id="backToTop" aria-label="উপরে ফিরে যান" title="উপরে ফিরে যান"><i class="fas fa-chevron-up"></i></button>
<%# Apply per-user display preferences (theme / font size / font family) early to avoid flash %>
<% if (user) { %>
<script>
(function () {
  try {
    var prefs = <%- jesc(typeof displayPrefs !== 'undefined' ? displayPrefs : {}) %>;
    var c = document.documentElement.classList;
    if (prefs.theme === 'dark') c.add('theme-dark');
    if (prefs.theme === 'light') c.add('theme-light');
    // সেশন ৮০: সেপিয়া (বইয়ের পাতার আভা) + লাইন-স্পেসিং ক্লাস
    if (prefs.theme === 'sepia') c.add('theme-sepia');
    if (prefs.font_size === 'small') c.add('fs-small');
    if (prefs.font_size === 'large') c.add('fs-large');
    if (prefs.line_height === 'compact') c.add('lh-compact');
    if (prefs.line_height === 'relaxed') c.add('lh-relaxed');
    // Apply font family class to body as soon as DOM is ready
    var ALLOWED_FF = ['bn','serif','sans','mixed','hand','display','durnibar','lipi'];
    var ff = ALLOWED_FF.indexOf(prefs.font_family) >= 0 ? prefs.font_family : 'bn';
    document.addEventListener('DOMContentLoaded', function () {
      document.body.classList.add('font-' + ff);
    });
  } catch (e) {}
})();
</script>
<% } %>

<!-- ============= Top bar ============= -->
<div class="btclf-topbar topbar" id="topbar">
  <div class="topbar-inner">

    <a href="/" class="brand">
      <div class="logo-wrap">
        <div class="logo-text logo-text-v2">
          <strong><%= C('header_brand_line1') %></strong>
          <strong class="brand-line2"><%= C('header_brand_line2') %></strong>
        </div>
      </div>
    </a>

    <!-- 4 main tabs (visible on desktop, hidden on mobile) -->
    <% if (user) { %>
    <nav class="topbar-tabs">
      <a href="/dashboard" class="topbar-tab <%= currentPath === '/dashboard' ? 'active' : '' %>">
        <i class="fas fa-globe-asia"></i> কমিউনিটি ফিড
      </a>
      <a href="/me" class="topbar-tab <%= currentPath === '/me' ? 'active' : '' %>">
        <i class="fas fa-user-circle"></i> ব্যক্তিগত ফিড
      </a>
      <a href="/messages" class="topbar-tab <%= currentPath && currentPath.indexOf('/messages') === 0 ? 'active' : '' %>">
        <i class="fas fa-comments"></i> মেসেজ
        <% if (typeof msgBadge !== 'undefined' && msgBadge > 0) { %><span class="badge"><%= msgBadge %></span><% } %>
      </a>
      <% if (user && (user.role === 'moderator' || user.role === 'admin' || user.role === 'superadmin' || user.role === 'senior_moderator' || user.role === 'junior_moderator' || user.role === 'content_moderator')) { %>
        <% if (user.role === 'admin') { %>
        <a href="/admin/switch" style="color:#d4a017;"><i class="fas fa-user-shield"></i> অ্যাডমিন প্যানেল</a>
        <% } else if (user.role === 'superadmin') { %>
        <a href="/admin" style="color:#d4a017;"><i class="fas fa-crown"></i> অ্যাডমিন প্যানেল</a>
        <% } else { %>
        <a href="/moderator/switch" style="color:#d4a017;"><i class="fas fa-shield-alt"></i> মডারেটর প্যানেল</a>
        <% } %>
        <% } %>
        <a href="/settings" class="topbar-tab <%= currentPath && currentPath.indexOf('/settings') === 0 ? 'active' : '' %>">
        <i class="fas fa-sliders-h"></i> সেটিংস
      </a>
    </nav>
    <% } else { %>
    <nav class="topbar-tabs">
      <a href="/" class="topbar-tab <%= currentPath === '/' ? 'active' : '' %>">হোম</a>
      <% (typeof navConfig !== 'undefined' ? navConfig : []).forEach(item => { if (item.href === '/') return; const _navActive = navItemActive(item, currentPath); %>
        <% if (item.children && item.children.length) { %>
          <div class="topbar-dropdown">
            <a href="<%= item.href %>" class="topbar-tab <%= _navActive ? 'active' : '' %>"><%= item.label %> <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
            <div class="topbar-dropdown-menu">
              <% item.children.forEach(c => { %>
                <a href="<%= c.href %>"><i class="fas <%= c.icon || 'fa-circle' %>"></i> <%= c.label %></a>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <a href="<%= item.href %>" class="topbar-tab <%= _navActive ? 'active' : '' %>"><%= item.label %></a>
        <% } %>
      <% }) %>
    </nav>
    <% } %>

    <!-- Global search -->
    <div class="global-search-wrap" id="globalSearchWrap">
      <button class="global-search-btn" onclick="toggleGlobalSearch()" aria-label="সার্চ" title="সার্চ (/)">
        <i class="fas fa-search"></i>
      </button>
      <div class="global-search-dropdown" id="globalSearchDropdown" hidden>
        <div class="gs-input-wrap">
          <i class="fas fa-search"></i>
          <input type="search" id="globalSearchInput" placeholder="লেখা, প্রশ্ন, সদস্য খুঁজুন..." autocomplete="off" />
          <kbd class="gs-kbd">Esc</kbd>
        </div>
        <div class="gs-results" id="globalSearchResults">
          <div class="gs-hint">সার্চ করতে টাইপ করুন...</div>
        </div>
      </div>
    </div>

