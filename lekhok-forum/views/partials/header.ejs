          <a href="/articles?filter=column"><i class="fas fa-pen-nib"></i> প্রকাশিত কলাম</a>
          <a href="/articles?filter=letter"><i class="fas fa-envelope"></i> প্রকাশিত চিঠি</a>
        </div>
      </div>
      <a href="/gallery" class="topbar-tab <%= currentPath === '/gallery' ? 'active' : '' %>">গ্যালারি</a>
      <a href="/resources" class="topbar-tab <%= currentPath === '/resources' ? 'active' : '' %>">রিসোর্স</a>
      <a href="/contact" class="topbar-tab <%= currentPath === '/contact' ? 'active' : '' %>">যোগাযোগ</a>
    </nav>
    <% } %>

    <div class="topbar-right">
      <% if (user) { %>
        <!-- Notification bell -->
        <div class="notif-bell-wrap" id="notifBell">
          <button class="notif-bell-btn" onclick="toggleNotifs()">
            <i class="fas fa-bell"></i>
            <% if (unread > 0) { %><span class="notif-badge" id="notifBadge"><%= unread > 9 ? '9+' : unread %></span><% } %>
          </button>
          <div class="notif-dropdown" id="notifDropdown">
            <div class="notif-header">
              <span>বিজ্ঞপ্তি</span>
              <a href="/notifications" class="notif-see-all">সব দেখুন</a>
            </div>
            <div id="notifList">
              <% if (typeof recentNotifs !== 'undefined' && recentNotifs && recentNotifs.length) { %>
                <% recentNotifs.forEach(n => { %>
                  <a href="<%= n.link || '/notifications' %>" class="notif-item <%= n.is_read ? '' : 'unread' %>">
                    <div class="notif-title"><%= n.title %></div>
                    <div class="notif-body"><%= n.body %></div>
                  </a>
                <% }); %>
              <% } else { %>
                <div class="notif-empty">কোনো বিজ্ঞপ্তি নেই</div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- User avatar dropdown -->
        <div class="user-menu-wrap">
          <button class="user-menu-btn" onclick="toggleUserMenu()">
            <img src="<%= user.avatar_url || '/avatar/' + user.id %>" class="user-mini-avatar" onerror="this.onerror=null;this.src='/avatar/<%= user.id %>'">
            <span><%= user.username %></span>
            <i class="fas fa-chevron-down"></i>
          </button>
          <div class="user-dropdown" id="userDropdown">
            <a href="/profile/<%= user.username %>"><i class="fas fa-user"></i> আমার প্রোফাইল</a>
            <a href="/me"><i class="fas fa-stream"></i> ব্যক্তিগত ফিড</a>
            <div class="user-socials">
              <span class="user-socials-label">আমাদের অনুসরণ করুন</span>
              <a href="<%= typeof getSetting === 'function' ? (getSetting('facebook_url') || '#') : '#' %>" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
              <a href="<%= typeof getSetting === 'function' ? (getSetting('youtube_url') || '#') : '#' %>" target="_blank" rel="noopener" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
              <a href="<%= typeof getSetting === 'function' ? (getSetting('twitter_url') || '#') : '#' %>" target="_blank" rel="noopener" aria-label="X"><i class="fab fa-twitter"></i></a>
            </div>
            <a href="/articles/new"><i class="fas fa-pen-nib"></i> নতুন লেখা</a>
            <a href="/qa/new"><i class="fas fa-question"></i> নতুন প্রশ্ন</a>
            <a href="/bookmarks"><i class="fas fa-bookmark"></i> সংরক্ষিত</a>
            <a href="/complaints"><i class="fas fa-user-shield"></i> অভিযোগ</a>
            <hr style="border:none;border-top:1px solid #eee;margin:6px 0">
            <a href="/settings"><i class="fas fa-cog"></i> সেটিংস</a>
            <% if (user.role === 'admin' || user.role === 'moderator') { %>
              <a href="/admin" class="admin-link"><i class="fas fa-shield-alt"></i> অ্যাডমিন প্যানেল</a>
            <% } %>
            <a href="/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i> লগআউট</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="topbar-nav a nav-login"><i class="fas fa-sign-in-alt"></i> লগইন</a>
        <a href="/register" class="topbar-nav a nav-register"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন</a>
      <% } %>

      <!-- Mega menu trigger (desktop) -->
      <div class="mega-wrap" id="megaWrap">
        <button class="mega-trigger" onclick="toggleMega(event)">
          <i class="fas fa-th"></i> আরও <i class="fas fa-chevron-down" style="font-size:11px"></i>
        </button>
        <div class="mega-menu" id="megaMenu">
          <div class="mega-col">
            <h4>কন্টেন্ট</h4>
            <a href="/articles"><i class="fas fa-pen-nib"></i> সকল লেখা</a>
            <a href="/qa"><i class="fas fa-question-circle"></i> প্রশ্নোত্তর</a>
            <a href="/resources"><i class="fas fa-folder-open"></i> রিসোর্স ও ফাইল</a>
          </div>
          <div class="mega-col">
            <h4>ঘোষণা ও আয়োজন</h4>
            <a href="/notices"><i class="fas fa-bullhorn"></i> ঘোষণা</a>
            <a href="/events"><i class="fas fa-calendar-alt"></i> আয়োজন</a>
            <a href="/activities"><i class="fas fa-calendar-check"></i> সাংগঠনিক কার্যক্রম</a>
            <a href="/best-writer"><i class="fas fa-star"></i> মাসিক সেরা লেখক</a>
          </div>
          <div class="mega-col">
            <h4>প্রতিষ্ঠান</h4>
            <a href="/achievements"><i class="fas fa-trophy"></i> অর্জন ও সম্মাননা</a>
            <a href="/notices"><i class="fas fa-bullhorn"></i> বিজ্ঞপ্তি</a>
            <a href="/events"><i class="fas fa-calendar-alt"></i> ইভেন্ট</a>
          </div>
          <div class="mega-col">
            <h4>আরও</h4>
            <a href="/birthdays"><i class="fas fa-birthday-cake"></i> আজকের জন্মদিন</a>
            <a href="/on-this-day"><i class="fas fa-calendar-day"></i> এই দিনে</a>
            <a href="/quiz"><i class="fas fa-brain"></i> আজকের কুইজ</a>
            <a href="/epaper"><i class="fas fa-newspaper"></i> আজকের ই-পেপার</a>
          </div>
        </div>
      </div>

      <button class="menu-toggle" id="menuToggle" aria-label="মেনু খুলুন">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>
</div>

