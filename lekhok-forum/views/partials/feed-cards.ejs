<%#
  session105: DELEGATE SHIM — ক্যানোনিকাল সোর্স এখন views/shared/post/FeedPostCard.ejs
  (ডিজাইন-সিস্টেম গার্ড: এই ফাইলে নতুন মার্কআপ লেখা নিষিদ্ধ — সব এডিট ক্যানোনিকালে)
  প্রত্যাশিত: feed (ডেকোরেটেড অ্যারে), user, myBookmarkedIds — প্রতি-আইটেম FeedPostCard %>
<% (feed || []).forEach(function (item) {
     if (item._orphan) return; // skip reposts whose original was deleted %>
  <%- include('../shared/post/FeedPostCard', { item: item }) %>
<% }); %>
