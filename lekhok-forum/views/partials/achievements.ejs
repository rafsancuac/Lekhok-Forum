<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>বিশেষ অর্জন — লেখক ফোরাম</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-trophy"></i> বিশেষ অর্জন</h1>
    </div>

    <% if (achievements.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-trophy"></i><p>কোনো অর্জন যোগ করা হয়নি।</p></div>
    <% } else { %>
      <div class="achievements-grid">
        <% achievements.forEach(a => { %>
          <div class="achievement-card">
            <% if (a.image_url) { %>
              <img src="<%= a.image_url %>" alt="<%= a.title %>" class="achievement-img">
            <% } else { %>
              <div class="achievement-icon"><i class="fas fa-trophy"></i></div>
            <% } %>
            <div class="achievement-body">
              <div class="achievement-year"><%= a.year %></div>
              <h3><%= a.title %></h3>
              <p class="achievement-recipient"><i class="fas fa-user"></i> <%= a.recipient_name %></p>
              <p class="achievement-desc"><%= a.description %></p>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
