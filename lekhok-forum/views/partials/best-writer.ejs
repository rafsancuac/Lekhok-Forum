<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>মাসিক সেরা লেখক — লেখক ফোরাম</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-star"></i> মাসিক সেরা লেখক</h1>
      <p class="header-sub">প্রতি মাসে সেরা প্রকাশিত লেখাসমূহ</p>
    </div>

    <% if (posts.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-star"></i><p>এই মাসে কোনো বিশেষ লেখা নেই।</p></div>
    <% } else { %>
      <div class="articles-grid">
        <% posts.forEach(post => { %>
          <div class="post-card featured">
            <div class="featured-badge"><i class="fas fa-star"></i> সেরা লেখা</div>
            <% if (post.cover_image) { %><img src="<%= post.cover_image %>" alt="cover" class="post-cover"><% } %>
            <div class="post-card-body">
              <a href="/articles/<%= post.id %>" class="post-title"><%= post.title %></a>
              <p class="post-excerpt"><%= post.excerpt || post.body.substring(0, 200) %>...</p>
              <div class="post-author-row">
                <img src="<%= post.avatar_url || '/avatar/' + post.author_id %>" class="post-author-avatar">
                <a href="/profile/<%= post.username %>" class="post-author-name"><%= post.author_name %></a>
              </div>
              <div class="post-actions">
                <span><i class="far fa-heart"></i> <%= post.like_count || 0 %></span>
                <span><i class="far fa-comment"></i> <%= post.comment_count || 0 %></span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
