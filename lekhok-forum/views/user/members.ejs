<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'সদস্য পরিচিতি — বাংলাদেশ তরুণ কলাম লেখক ফোরাম' }) %>

  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-users"></i> সদস্য পরিচিতি</h1>
      <p>আমাদের প্রতিষ্ঠানের নেতৃত্ব ও সকল সদস্য</p>
    </div>

    <div class="container">

      <!-- Categorized committee sections -->
      <% if (grouped.central.length > 0) { %>
        <!-- ── সর্বশেষ কার্যবর্ষের কার্যনির্বাহী কমিটি ── -->
        <section class="member-section" id="executive-committee">
          <div class="section-head">
            <h2 class="section-title"><i class="fas fa-crown"></i> কেন্দ্রীয় কার্যনির্বাহী কমিটি<% if (execTermYear) { %> — <%= execTermYear %><% } %></h2>
            <span class="badge"><%= grouped.central.length %> জন</span>
          </div>
          <div class="leaders-grid">
            <% grouped.central.forEach(m => { %>
              <% const displayName = m.user_full_name || m.name; %>
              <% const displayImg  = m.user_avatar_url || m.image_url; %>
              <% if (m.user_username) { %>
                <a href="/profile/<%= m.user_username %>" class="leader-card large linked-member" style="text-decoration:none;color:inherit;">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-lg" style="border-radius:50%;margin:0 auto 12px;"> <% } else { %>
                    <div class="avatar avatar-lg"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                  <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 100) %><%= m.bio.length > 100 ? '…' : '' %></p><% } %>
                  <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল দেখুন</span>
                </a>
              <% } else { %>
                <article class="leader-card large">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-lg" style="border-radius:50%;margin:0 auto 12px;"> <% } else { %>
                    <div class="avatar avatar-lg"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                  <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 100) %><%= m.bio.length > 100 ? '…' : '' %></p><% } %>
                </article>
              <% } %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (grouped.advisory.length > 0) { %>
        <section class="member-section">
          <div class="section-head">
            <h2 class="section-title"><i class="fas fa-graduation-cap"></i> উপদেষ্টা পর্ষদ</h2>
            <span class="badge"><%= grouped.advisory.length %> জন</span>
          </div>
          <div class="leaders-grid">
            <% grouped.advisory.forEach(m => { %>
              <% const displayName = m.user_full_name || m.name; %>
              <% const displayImg  = m.user_avatar_url || m.image_url; %>
              <% if (m.user_username) { %>
                <a href="/profile/<%= m.user_username %>" class="leader-card linked-member" style="text-decoration:none;color:inherit;">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-md" style="border-radius:50%;margin:0 auto 10px;"> <% } else { %>
                    <div class="avatar avatar-md"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                  <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল</span>
                </a>
              <% } else { %>
                <article class="leader-card">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-md" style="border-radius:50%;margin:0 auto 10px;"> <% } else { %>
                    <div class="avatar avatar-md"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                </article>
              <% } %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (grouped.branch.length > 0) { %>
        <section class="member-section">
          <div class="section-head">
            <h2 class="section-title"><i class="fas fa-university"></i> বিশ্ববিদ্যালয় শাখা কমিটি</h2>
            <span class="badge"><%= grouped.branch.length %> জন</span>
          </div>
          <div class="leaders-grid">
            <% grouped.branch.forEach(m => { %>
              <% const displayName = m.user_full_name || m.name; %>
              <% const displayImg  = m.user_avatar_url || m.image_url; %>
              <% if (m.user_username) { %>
                <a href="/profile/<%= m.user_username %>" class="leader-card linked-member" style="text-decoration:none;color:inherit;">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-md" style="border-radius:50%;margin:0 auto 10px;"> <% } else { %>
                    <div class="avatar avatar-md"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                </a>
              <% } else { %>
                <article class="leader-card">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-md" style="border-radius:50%;margin:0 auto 10px;"> <% } else { %>
                    <div class="avatar avatar-md"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                </article>
              <% } %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (grouped.founder.length > 0) { %>
        <section class="member-section">
          <div class="section-head">
            <h2 class="section-title"><i class="fas fa-star"></i> প্রতিষ্ঠাতা সদস্য</h2>
            <span class="badge"><%= grouped.founder.length %> জন</span>
          </div>
          <div class="leaders-grid">
            <% grouped.founder.forEach(m => { %>
              <% const displayName = m.user_full_name || m.name; %>
              <% const displayImg  = m.user_avatar_url || m.image_url; %>
              <% if (m.user_username) { %>
                <a href="/profile/<%= m.user_username %>" class="leader-card large linked-member" style="text-decoration:none;color:inherit;">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-lg" style="border-radius:50%;margin:0 auto 12px;"> <% } else { %>
                    <div class="avatar avatar-lg"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                </a>
              <% } else { %>
                <article class="leader-card large">
                  <% if (displayImg) { %><img loading="lazy" decoding="async" src="<%= displayImg %>" class="avatar-lg" style="border-radius:50%;margin:0 auto 12px;"> <% } else { %>
                    <div class="avatar avatar-lg"><%= displayName.charAt(0) %></div>
                  <% } %>
                  <h3><%= displayName %></h3>
                  <p class="role"><%= m.role %></p>
                </article>
              <% } %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <!-- All registered users search -->
      <section class="member-section" style="margin-top:40px;">
        <div class="section-head">
          <h2 class="section-title"><i class="fas fa-search"></i> সকল নিবন্ধিত সদস্য</h2>
          <span class="badge"><%= totalUsers %> জন</span>
        </div>
        <form method="GET" class="search-form member-filter-form">
          <input class="input" type="text" name="q" value="<%= search || '' %>" placeholder="নাম বা পদবি দিয়ে খুঁজুন…">
          <select class="input" name="dept" aria-label="বিভাগ অনুযায়ী ফিল্টার">
            <option value="">সকল বিভাগ</option>
            <% departments.forEach((d, i) => { %>
              <% const slug = deptSlugs[i]; %>
              <option value="<%= slug %>" <%= selectedCanon === d ? 'selected' : '' %>><%= d %></option>
            <% }); %>
          </select>
          <select class="input" name="role" aria-label="ভূমিকা অনুযায়ী ফিল্টার">
            <option value="">সকল ভূমিকা</option>
            <% uniqueRoles.forEach(r => { %>
              <option value="<%= r %>" <%= currentRole === r ? 'selected' : '' %>><%= roleMap[r] || r %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn-primary"><i class="fas fa-filter"></i> ফিল্টার</button>
          <% if (currentDept || currentRole || search) { %>
            <a href="/members" class="btn-ghost" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px;padding:10px 16px;border-radius:10px;border:1px solid var(--border);"><i class="fas fa-times"></i> মুছুন</a>
          <% } %>
        </form>

        <% if (members.length === 0) { %>
          <div class="empty"><div class="icon"><i class="fas fa-user-slash"></i></div><h3>কোনো সদস্য পাওয়া যায়নি</h3></div>
        <% } else { %>
          <div class="leaders-grid">
            <% members.forEach(m => { %>
              <a href="/profile/<%= m.username %>" class="leader-card" style="text-decoration:none;color:inherit;">
                <% if (m.avatar_url) { %>
                  <div class="avatar-wrap">
                    <img loading="lazy" decoding="async" src="<%= m.avatar_url %>" class="avatar-md" style="border-radius:50%;margin:0 auto 10px;" onerror="this.onerror=null;this.src='/avatar/<%= m.id %>'">
                    <% if (m.last_login && (Date.now() - new Date(m.last_login).getTime()) < 5*60*1000) { %><span class="online-dot"></span><% } %>
                  </div>
                <% } else { %>
                  <div class="avatar avatar-md"><%= m.full_name.charAt(0) %></div>
                <% } %>
                <h3 style="font-size:15px;"><%= m.full_name %></h3>
                <% if (m.designation) { %><p class="role" style="font-size:12px;"><%= m.designation %></p><% } %>
                <small style="color:var(--text-muted);">@<%= m.username %></small>
              </a>
            <% }); %>
          </div>
        <% } %>
      </section>
    </div>
  </div>

  <style>
    .member-section { padding: 30px 0; border-bottom: 1px solid var(--border); }
    .member-section:last-child { border-bottom: 0; }
    .section-title i { color: var(--accent); margin-right: 6px; }
    .follow-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
    .follow-card {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      padding: 16px 12px; background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius); text-align: center; transition: var(--transition);
    }
    .follow-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--accent); }
    .member-filter-form {
      display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
      max-width: 720px; margin-bottom: 20px;
    }
    .member-filter-form .input { flex: 1; min-width: 160px; }
    .member-filter-form select { flex: 0 0 160px; }
    @media (max-width: 600px) {
      .member-filter-form { flex-direction: column; }
      .member-filter-form .input,
      .member-filter-form select { width: 100%; flex: none; }
    }
  </style>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
