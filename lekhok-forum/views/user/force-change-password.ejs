<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>নতুন পাসওয়ার্ড সেট করুন | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/premium.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/member-accounts.css?v=<%= AV %>" />
</head>
<body class="auth-split" data-auth="1">
  <div class="as-shell">

    <!-- ── বাম ব্র্যান্ড-প্যানেল ── -->
    <aside class="as-brand">
      <div class="as-brand-top">
        <span class="as-logo"><i class="fas fa-feather-alt"></i></span>
        <span class="as-brand-name">লেখক ফোরাম</span>
      </div>
      <div class="as-brand-mid">
        <p class="as-eyebrow">চট্টগ্রাম বিশ্ববিদ্যালয়</p>
        <h2 class="as-tagline">লেখক ফোরাম</h2>
        <p class="as-intro">শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটানোই আমাদের প্রত্যয়।</p>
      </div>
      <div class="as-brand-bottom">© ২০২৬ লেখক ফোরাম। সর্বস্বত্ব সংরক্ষিত।</div>
    </aside>

    <!-- ── ডান ফর্ম-প্যানেল ── -->
    <main class="as-form-panel">
      <div class="as-form-card">

        <div class="fcp-notice">
          <i class="fas fa-shield-halved"></i>
          <div>
            <strong>স্বাগতম, <%= userName %>!</strong>
            আপনি একটি <em>অস্থায়ী পাসওয়ার্ডে</em> লগইন করেছেন। নিরাপত্তার জন্য এখনই
            আপনার নিজস্ব নতুন পাসওয়ার্ড সেট করুন — এটি সম্পন্ন না হওয়া পর্যন্ত আপনি
            ফোরামের অন্য কোনো পেজে যেতে পারবেন না।
          </div>
        </div>

        <h1 class="as-title">নতুন পাসওয়ার্ড সেট করুন</h1>
        <p class="as-sub">নিজের পছন্দের পাসওয়ার্ড দিন ও নিশ্চিত করুন (কমপক্ষে ৬ অক্ষর)।</p>
        <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
        <form method="POST" action="/force-change-password" class="as-loading-form" data-submit-label='<i class="fas fa-key"></i> নতুন পাসওয়ার্ড সেট করুন'>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="ff has-toggle">
            <input type="password" id="fcpPass" name="password" required minlength="6" autocomplete="new-password" placeholder=" ">
            <label for="fcpPass">নতুন পাসওয়ার্ড *</label>
            <button type="button" class="pw-toggle" aria-label="পাসওয়ার্ড দেখান"><i class="far fa-eye"></i></button>
          </div>
          <div class="ff has-toggle">
            <input type="password" id="fcpPass2" name="confirmPassword" required minlength="6" autocomplete="new-password" placeholder=" ">
            <label for="fcpPass2">পাসওয়ার্ড নিশ্চিত করুন *</label>
            <button type="button" class="pw-toggle" aria-label="পাসওয়ার্ড দেখান"><i class="far fa-eye"></i></button>
          </div>
          <button type="submit" class="btn-primary"><i class="fas fa-key"></i> নতুন পাসওয়ার্ড সেট করুন</button>
        </form>

        <p class="mc-foot">
          <a href="/logout"><i class="fas fa-right-from-bracket"></i> আপাতত লগআউট করতে চাই</a>
        </p>
      </div>
    </main>
  </div>

  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/auth.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <style>
    /* ফোর্স-চেঞ্জ নোটিশ — অস্থায়ী-পাসওয়ার্ড ব্যাখ্যা (auth-split-এর সাথে মানানসই) */
    .fcp-notice{display:flex;gap:12px;align-items:flex-start;background:rgba(5,150,105,.08);border:1px solid rgba(5,150,105,.25);border-radius:10px;padding:13px 15px;font-size:13px;line-height:1.75;color:#0b6b4b;margin-bottom:18px}
    .fcp-notice>i{font-size:19px;margin-top:2px;color:#047857}
    .fcp-notice strong{display:block;margin-bottom:3px;color:#047857}
    .fcp-notice em{font-style:normal;font-weight:700}
    .mc-foot{margin-top:18px;text-align:center;font-size:12.5px}
    .mc-foot a{color:#65676b;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .mc-foot a:hover{color:#050505;text-decoration:underline}
  </style>
</body>
</html>
