<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'সাধারণ জিজ্ঞাসা | লেখক ফোরাম' }) %>

  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-question-circle"></i> সাধারণ জিজ্ঞাসা</h1>
      <% if (user) { %>
        <a href="/questions/new" class="btn-write"><i class="fas fa-plus"></i> নতুন প্রশ্ন</a>
      <% } %>
    </div>

    <div class="qa-list">
      <% if (questions.length === 0) { %>
        <div class="empty-state-full">
          <i class="fas fa-question-circle"></i>
          <p>কোনো প্রশ্ন করা হয়নি।</p>
          <% if (user) { %><a href="/questions/new" class="btn-primary-sm">প্রথম প্রশ্ন করুন</a><% } %>
        </div>
      <% } else { %>
        <% questions.forEach(q => { %>
          <div class="qa-item">
            <div class="qa-votes">
              <span class="vote-count"><%= q.like_count || 0 %></span>
              <small><i class="far fa-thumbs-up"></i>প্রাসঙ্গিক</small>
            </div>
            <div class="qa-content">
              <a href="/questions/<%= q.id %>" class="qa-title"><%= q.title %></a>
              <% if (q.body) { %><p class="qa-excerpt"><%= q.body.substring(0, 150) %>...</p><% } %>
              <div class="qa-meta">
                <img loading="lazy" decoding="async" src="<%= q.avatar_url || '/avatar/' + q.author_id %>" class="mini-avatar">
                <a href="/profile/<%= q.username %>" class="qa-author"><%= q.full_name %></a>
                <span>&middot;</span>
                <span><i class="far fa-comment"></i> <%= q.comment_count || 0 %> উত্তর</span>
                <span>&middot;</span>
                <span data-ts="<%= new Date(q.created_at).toISOString() %>"><i class="far fa-clock"></i> <%= new Date(q.created_at).toLocaleDateString('bn-BD') %></span>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
