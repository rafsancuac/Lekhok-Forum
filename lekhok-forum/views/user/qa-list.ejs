<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'সাধারণ জিজ্ঞাসা | লেখক ফোরাম' }) %>
<%# সেশন ১১৯: বাংলা-অঙ্ক হেল্পার + ফিল্টার-স্টেট (qaFilter: 'all'|'unanswered'|'accepted', qaCounts) — social.js-রুট থেকে %>
<% const bn118 = n => String(n).replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[+d]); %>

  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-question-circle"></i> সাধারণ জিজ্ঞাসা</h1>
      <% if (user) { %>
        <a href="/questions/new" class="btn-write"><i class="fas fa-plus"></i> নতুন প্রশ্ন</a>
      <% } %>
    </div>

    <%# সেশন ১১৯: FB-প্যারিটি ফিল্টার-চিপ — সব/অনুত্তরিত/গ্রহণকৃত (session131), কাউন্ট-ব্যাজসহ;
        ?filter=ডিপ-লিংকযোগ্য (সার্ভার-রেন্ডার্ড active-স্টেট) %>
    <%# সেশন ১৪০: ইনলাইন-কম্পোজার — নতুন-প্রশ্ন এখন /qa-তেই (optimistic-কার্ড → /api/qa/new
        canonical-HTML-swap; session124-CommentItem-রীতির QA-মিরর)। গেস্টে লগইন-CTA।
        পূর্ণাঙ্গ-ফর্ম (/qa/new) পেজ-হেডারের নতুন-প্রশ্ন-বাটনে অক্ষুণ্ণ। %>
    <% if (user) { %>
      <%# সেশন ১৫৮: সর্বজনীন কম্পোজার-ট্রিগার — session140 ইনলাইন-কম্পোজারের প্রতিস্থাপন
          (স্পেক: সব পেজে ফেসবুকের মতো একই পোস্ট কম্পোজার ইন্টারফেস) — এ-পেজে প্রশ্ন-প্রি-সিলেক্টেড;
          পুরনো qa-composer.js অক্ষুণ্ণ (মার্কআপ-অনুপস্থিতিতে স্ব-নিষ্ক্রিয় — null-guard চুক্তি) %>
      <%- include('../shared/post/UniversalPostTrigger', { composerDefaultType: 'question' }) %>
    <% } else { %>
      <a class="qac-guest140" href="/login">
        <i class="fas fa-circle-question" aria-hidden="true"></i>
        <span>প্রশ্ন করতে লগইন করুন — উত্তর পাবেন ফোরামের অভিজ্ঞ লেখকদের কাছ থেকে</span>
        <i class="fas fa-arrow-right qac-guest-arrow140" aria-hidden="true"></i>
      </a>
    <% } %>

    <div class="qa-filter-bar" role="navigation" aria-label="প্রশ্ন-ফিল্টার">
      <a href="/qa" class="qa-filter-chip <%= qaFilter !== 'unanswered' && qaFilter !== 'accepted' ? 'active' : '' %>" <%= qaFilter !== 'unanswered' && qaFilter !== 'accepted' ? 'aria-current="page"' : '' %>>
        <i class="fas fa-list-ul" aria-hidden="true"></i> সব প্রশ্ন <span class="qf-count"><%= bn118(qaCounts.all) %></span>
      </a>
      <a href="/qa?filter=unanswered" class="qa-filter-chip <%= qaFilter === 'unanswered' ? 'active' : '' %>" <%= qaFilter === 'unanswered' ? 'aria-current="page"' : '' %>>
        <i class="far fa-circle-question" aria-hidden="true"></i> অনুত্তরিত <span class="qf-count <%= qaCounts.unanswered > 0 ? 'has' : '' %>"><%= bn118(qaCounts.unanswered) %></span>
      </a>
      <%# সেশন ১৩১: গ্রহণকৃত-উত্তর-ফিল্টার — প্রশ্নকর্তা-গ্রহীতা উত্তর-যুক্ত প্রশ্ন %>
      <a href="/qa?filter=accepted" class="qa-filter-chip qa-filter-accepted127 <%= qaFilter === 'accepted' ? 'active' : '' %>" <%= qaFilter === 'accepted' ? 'aria-current="page"' : '' %>>
        <i class="fas fa-circle-check" aria-hidden="true"></i> গ্রহণকৃত উত্তর <span class="qf-count <%= qaCounts.accepted > 0 ? 'has' : '' %>"><%= bn118(qaCounts.accepted) %></span>
      </a>
    </div>

    <div class="qa-list">
      <% if (questions.length === 0) { %>
        <div class="empty-state-full">
          <i class="fas fa-<%= qaFilter === 'unanswered' ? 'circle-check' : (qaFilter === 'accepted' ? 'circle-check' : 'question-circle') %>"></i>
          <% if (qaFilter === 'unanswered') { %>
            <p>দারুণ! কোনো অনুত্তরিত প্রশ্ন নেই — সব প্রশ্নের উত্তর মিলেছে।</p>
            <a href="/qa" class="btn-primary-sm">সব প্রশ্ন দেখুন</a>
          <% } else if (qaFilter === 'accepted') { %>
            <p>এখনো কোনো প্রশ্নকর্তা-গ্রহীতা উত্তর নেই — প্রশ্নের উত্তর দিন, প্রশ্নকর্তার গ্রহণের প্রথম হোন!</p>
            <a href="/qa" class="btn-primary-sm">সব প্রশ্ন দেখুন</a>
          <% } else { %>
            <p>কোনো প্রশ্ন করা হয়নি।</p>
            <% if (user) { %><a href="/questions/new" class="btn-primary-sm">প্রথম প্রশ্ন করুন</a><% } %>
          <% } %>
        </div>
      <% } else { %>
        <%# সেশন ১৪০: লুপ-মার্কআপ এখন shared/qa/QaListItem.ejs (single-source) —
            /api/qa/new canonical-HTML-এর সাথে অক্ষরে-অক্ষরে এক (গার্ড: এ-মার্কআপ এখানে
            সরাসরি সম্পাদনা নিষিদ্ধ — পার্শিয়ালেই সম্পাদনা করুন) %>
        <% questions.forEach(q => { %>
          <%- include('../shared/qa/QaListItem', { q }) %>
        <% }); %>
      <% } %>
    </div>
  </div>
  <link rel="stylesheet" href="/assets/css/rich-editor.css?v=<%= AV %>" />
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <%# সেশন ১৪৪: রিচ-এডিটর ইঞ্জিন — কম্পোজারের আগে লোড (qa-composer ম্যানুয়ালি init করে) %>
  <script src="/assets/js/rich-editor.js?v=<%= AV %>"></script>
  <%# সেশন ১৪০: ইনলাইন-কম্পোজার-ইঞ্জিন (লগইন-পেজেই লোড হয়; গেস্টে স্ব-নিষ্ক্রিয়) %>
  <script src="/assets/js/qa-composer.js?v=<%= AV %>"></script>
  <%# সেশন ১৪৪: মেনশন-অটোকমপ্লিট — textarea[data-mention] সারফেসে (cc-input-বহির্ভূত) %>
  <script src="/assets/js/mention-anywhere.js?v=<%= AV %>"></script>
  <%# সেশন ১৫৮: সর্বজনীন কম্পোজার-মোডাল (css+js পার্শিয়াল-ই লোড করে) %>
  <%- include('../shared/post/UniversalComposerModal') %>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
