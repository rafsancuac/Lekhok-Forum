<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

  <meta charset="UTF-8" />
  <title>নতুন পাসওয়ার্ড | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/premium.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/member-accounts.css?v=<%= AV %>" />
</head>
<body class="auth-split">
  <div class="as-shell">

    <!-- ── বাম ব্র্যান্ড-প্যানেল ── -->
    <aside class="as-brand">
      <div class="as-brand-top">
        <span class="as-logo"><i class="fas fa-feather-alt"></i></span>
        <span class="as-brand-name">লেখক ফোরাম</span>
      </div>
      <div class="as-brand-mid">
        <p class="as-eyebrow">চট্টগ্রাম বিশ্ববিদ্যালয়</p>
        <h2 class="as-tagline">বাংলাদেশ তরুণ কলাম লেখক ফোরাম</h2>
        <p class="as-intro">শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটানোই আমাদের প্রত্যয়।</p>
      </div>
      <div class="as-brand-bottom">© ২০২৬ লেখক ফোরাম। সর্বস্বত্ব সংরক্ষিত।</div>
    </aside>

    <!-- ── ডান ফর্ম-প্যানেল ── -->
    <main class="as-form-panel">
      <div class="as-form-card">
        <a href="/login" class="back-home"><i class="fas fa-arrow-left"></i> লগইনে ফিরে যান</a>

        <h1 class="as-title">নতুন পাসওয়ার্ড</h1>
        <p class="as-sub">নতুন পাসওয়ার্ড দিন ও নিশ্চিত করুন।</p>
        <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
        <% if (token) { %>
          <form method="POST" class="as-loading-form" data-submit-label='<i class="fas fa-key"></i> পাসওয়ার্ড পরিবর্তন করুন'>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="token" value="<%= token %>">
            <div class="ff has-toggle">
              <input type="password" id="rpPass" name="password" required minlength="6" autocomplete="new-password" placeholder=" ">
              <label for="rpPass">নতুন পাসওয়ার্ড *</label>
              <button type="button" class="pw-toggle" aria-label="পাসওয়ার্ড দেখান"><i class="far fa-eye"></i></button>
            </div>
            <div class="ff has-toggle">
              <input type="password" id="rpPass2" name="confirmPassword" required minlength="6" autocomplete="new-password" placeholder=" ">
              <label for="rpPass2">পাসওয়ার্ড নিশ্চিত করুন *</label>
              <button type="button" class="pw-toggle" aria-label="পাসওয়ার্ড দেখান"><i class="far fa-eye"></i></button>
            </div>
            <button type="submit" class="btn-primary"><i class="fas fa-key"></i> পাসওয়ার্ড পরিবর্তন করুন</button>
          </form>
        <% } else { %>
          <p class="mc-foot"><a href="/forgot-password">নতুন রিসেট লিংক চান</a></p>
        <% } %>
      </div>
    </main>
  </div>

  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/auth.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
