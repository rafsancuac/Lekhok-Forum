<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
  <meta charset="UTF-8" />
  <title>নতুন পাসওয়ার্ড | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css" />
  <link rel="stylesheet" href="/assets/css/member-accounts.css" />
</head>
<body>
  <div class="auth-card mc-wrap">
    <a href="/login" class="back-home"><i class="fas fa-arrow-left"></i> লগইনে ফিরে যান</a>
    <div class="auth-brand">
      <span class="auth-logo"><i class="fas fa-feather-alt"></i></span>
      <span class="auth-brand-name">লেখক ফোরাম</span>
    </div>
    <h1 class="auth-title">নতুন পাসওয়ার্ড</h1>
    <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
    <% if (token) { %>
      <form method="POST">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="form-group">
          <label>নতুন পাসওয়ার্ড *</label>
          <input type="password" name="password" required minlength="6" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label>পাসওয়ার্ড নিশ্চিত করুন *</label>
          <input type="password" name="confirmPassword" required minlength="6" autocomplete="new-password">
        </div>
        <button type="submit" class="btn-primary"><i class="fas fa-key"></i> পাসওয়ার্ড পরিবর্তন করুন</button>
      </form>
    <% } else { %>
      <p class="mc-foot"><a href="/forgot-password">নতুন রিসেট লিংক চান</a></p>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
