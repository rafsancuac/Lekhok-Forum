<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

  <meta charset="UTF-8" />
  <title>দ্বি-স্তর যাচাই | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css" />
  <link rel="stylesheet" href="/assets/css/premium.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/member-accounts.css" />
</head>
<body class="auth-split">
  <div class="as-shell">

    <!-- ── বাম ব্র্যান্ড-প্যানেল ── -->
    <aside class="as-brand">
      <div class="as-brand-top">
        <span class="as-logo"><i class="fas fa-feather-alt"></i></span>
        <span class="as-brand-name">লেখক ফোরাম</span>
      </div>
      <div class="as-brand-mid">
        <p class="as-eyebrow">চট্টগ্রাম বিশ্ববিদ্যালয়</p>
        <h2 class="as-tagline">লেখক ফোরাম</h2>
        <p class="as-intro">শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। তরুণ সমাজকে লিখালিখির জগতে নিয়ে আসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটানোই আমাদের প্রত্যয়।</p>
      </div>
      <div class="as-brand-bottom">© ২০২৬ লেখক ফোরাম। সর্বস্বত্ব সংরক্ষিত।</div>
    </aside>

    <!-- ── ডান ফর্ম-প্যানেল: ধাপ ২ ── -->
    <main class="as-form-panel">
      <div class="as-form-card as-mfa">
        <a href="/login" class="back-home"><i class="fas fa-arrow-left"></i> আবার লগইন করুন</a>

        <span class="mfa-badge"><i class="fas fa-shield-halved"></i></span>
        <h1 class="as-title">দ্বি-স্তর যাচাই</h1>
        <% if (hint) { %><p class="as-sub"><%= hint %> — পাসওয়ার্ড মিলেছে, এখন শেষ ধাপ।</p><% } else { %><p class="as-sub">পাসওয়ার্ড মিলেছে, এখন শেষ ধাপ।</p><% } %>

        <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

        <form method="POST" action="/login/2fa" class="as-loading-form" data-submit-label='<i class="fas fa-shield-halved"></i> যাচাই করুন'>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="ff mfa-code-wrap">
            <input type="text" id="mfaCode" name="totp_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,8}" maxlength="8" placeholder=" " autofocus required aria-label="৬-অঙ্কের যাচাই কোড">
            <label for="mfaCode">অ্যাপে দেখানো ৬-অঙ্কের কোড</label>
          </div>
          <p class="mfa-hint"><i class="fas fa-mobile-screen-button"></i> Google Authenticator / Authy / 1Password-এ বর্তমান কোডটি দেখুন। কোড ৩০ সেকেন্ড পর বদলে যায়।</p>
          <button type="submit" class="btn-primary"><i class="fas fa-shield-halved"></i> যাচাই করুন</button>
        </form>

        <div class="mfa-alt">
          <button type="button" id="mfaAltBtn" class="mfa-alt-btn">ফোনে অ্যাপ নেই? <b>ব্যাকআপ কোড</b> ব্যবহার করুন</button>
          <p class="mfa-alt-note" id="mfaAltNote">সেটিংসে 2FA চালু করার সময় পাওয়া ৮-অঙ্কের কোডগুলোর একটি এখানে বসান। প্রতিটি কোড একবারই ব্যবহার হয়।</p>
        </div>

        <p class="as-foot mfa-foot">অ্যাকাউন্ট আরও সুরক্ষিত করতে <a href="/settings">সেটিংসে</a> 2FA সক্রিয় রাখুন।</p>
      </div>
    </main>
  </div>

  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/auth.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <script>
  (function () {
    var inp = document.getElementById('mfaCode');
    if (!inp) return;
    // শুধু সংখ্যা রাখি
    inp.addEventListener('input', function () {
      this.value = this.value.replace(/\D/g, '').slice(0, 8);
      var f = this.closest('.ff');
      if (f) { if (this.value) { f.classList.add('is-filled'); } else { f.classList.remove('is-filled'); } }
      // ৬ অঙ্ক পূর্ণ হলে অটো-সাবমিট (প্রিমিয়াম টাচ)
      if (this.value.length === 6) {
        var form = this.form;
        if (form && !form.dataset.autoSent) {
          form.dataset.autoSent = '1';
          setTimeout(function () { if (inp.value.length === 6) form.submit(); }, 380);
        }
      }
    });
    setTimeout(function () { try { inp.focus({ preventScroll: true }); } catch (e) { inp.focus(); } }, 220);
    // ব্যাকআপ-কোড নোট টগল
    var alt = document.getElementById('mfaAltBtn');
    var note = document.getElementById('mfaAltNote');
    if (alt && note) {
      note.style.display = 'none';
      alt.addEventListener('click', function () {
        var open = note.style.display !== 'none';
        note.style.display = open ? 'none' : 'block';
        alt.classList.toggle('is-open', !open);
        if (!open) { try { inp.focus({ preventScroll: true }); } catch (e) { inp.focus(); } }
      });
    }
  })();
  </script>
</body>
</html>
