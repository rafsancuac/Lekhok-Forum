<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'বিশেষ অর্জন | বাংলাদেশ তরুণ কলাম লেখক ফোরাম' }) %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-trophy"></i> বিশেষ অর্জন</h1>
    </div>

    <% if (items.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-trophy"></i><p>কোনো অর্জন যোগ করা হয়নি।</p></div>
    <% } else { %>
      <div class="achievements-grid">
        <% items.forEach(a => { %>
          <div class="achievement-card">
            <% if (a.image_url) { %>
              <img loading="lazy" decoding="async" src="<%= a.image_url %>" alt="<%= a.title %>" class="achievement-img">
            <% } else { %>
              <div class="achievement-icon"><i class="fas fa-trophy"></i></div>
            <% } %>
            <div class="achievement-body">
              <div class="achievement-year"><%= a.year %></div>
              <h3><%= a.title %></h3>
              <p class="achievement-recipient"><i class="fas fa-user"></i> <%= a.recipient_name %></p>
              <p class="achievement-desc"><%= a.description %></p>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
