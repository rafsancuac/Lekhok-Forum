<%# ────────────────────────────────────────────────────────────────────────────
    সেশন ৯১ (D2): পাবলিক সংরক্ষণ-তালিকা — /profile/:username/bookmarks
    • bookmarks_public=1 হলে যে-কেউ দেখতে পারে; বন্ধ থাকলে মালিক ছাড়া সবাই লক-স্ক্রিন
    • প্রোফাইলের pf-* ডিজাইন-ভাষা (profile.css) + নিজস্ব pbk-* স্কোপ
    • কার্ড-গ্রিড: কভার-থাম্ব / এক্সসারপ্ট / পড়ার-সময় / সংরক্ষণ-তারিখ (সাপেক্ষ)
──────────────────────────────────────────────────────────────────────────── %>
<%- include('../partials/header', { title: (profile.full_name) + ' — সংরক্ষিত লেখা | লেখক ফোরাম', extra_css: ['/assets/css/profile.css'] }) %>

<style>
  /* ═══ pbk-* — এই পেজ-স্কোপড ব্লক (profile.css-এর টোকেন পুনঃব্যবহার) ═══ */
  .pbk-wrap{max-width:1080px;margin:0 auto;padding:24px 16px 48px}
  .pbk-hero{display:flex;gap:16px;align-items:center;background:var(--pf-card,#fff);
    border:1px solid var(--pf-border-soft,#e4e9ef);border-radius:16px;padding:20px;
    box-shadow:0 1px 2px rgba(16,24,40,.04);position:relative;overflow:hidden}
  .pbk-hero::before{content:'';position:absolute;inset:0 0 auto 0;height:64px;
    background:linear-gradient(135deg,#065F46,#0d9268);opacity:.08;pointer-events:none}
  .pbk-hero-avatar{width:72px;height:72px;border-radius:50%;object-fit:cover;flex:0 0 auto;
    border:3px solid #fff;box-shadow:0 2px 10px rgba(6,95,70,.25);position:relative}
  .pbk-hero-main{min-width:0;position:relative}
  .pbk-hero-name{font-size:1.15rem;font-weight:700;color:#111827;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .pbk-hero-name a{color:inherit;text-decoration:none}
  .pbk-hero-name a:hover{text-decoration:underline}
  .pbk-hero-sub{font-size:.85rem;color:#6b7280;margin-top:2px}
  .pbk-hero-sub b{color:#065F46;font-weight:600}
  .pbk-privacy-chip{display:inline-flex;align-items:center;gap:5px;font-size:.72rem;font-weight:600;
    padding:3px 10px;border-radius:999px;border:1px solid transparent}
  .pbk-privacy-on{background:#ECFDF5;color:#047857;border-color:#A7F3D0}
  .pbk-privacy-off{background:#FEF3C7;color:#92400E;border-color:#FDE68A}
  .pbk-stats{margin-left:auto;display:flex;gap:10px;flex-wrap:wrap;position:relative}
  .pbk-stat{background:#F9FAFB;border:1px solid #EEF1F4;border-radius:12px;padding:8px 14px;text-align:center;min-width:74px}
  .pbk-stat b{display:block;font-size:1.05rem;color:#065F46}
  .pbk-stat span{font-size:.72rem;color:#6b7280}
  @media (max-width:640px){
    .pbk-hero{flex-wrap:wrap}
    .pbk-stats{margin-left:0;width:100%}
    .pbk-stat{flex:1;min-width:0}
  }

  /* ব্যাক-লিংক বার */
  .pbk-backbar{display:flex;align-items:center;gap:10px;margin:18px 2px 14px}
  .pbk-back{display:inline-flex;align-items:center;gap:6px;font-size:.85rem;color:#065F46;
    text-decoration:none;font-weight:600;padding:6px 12px;border-radius:999px;background:#ECFDF5;border:1px solid #A7F3D0;transition:.15s}
  .pbk-back:hover{background:#D1FAE5;transform:translateY(-1px)}
  .pbk-count-pill{font-size:.8rem;color:#6b7280}
  .pbk-count-pill b{color:#111827}

  /* কার্ড-গ্রিড */
  .pbk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
  @media (max-width:640px){.pbk-grid{grid-template-columns:1fr}}
  .pbk-card{background:var(--pf-card,#fff);border:1px solid var(--pf-border-soft,#e4e9ef);border-radius:14px;
    overflow:hidden;display:flex;flex-direction:column;text-decoration:none;color:inherit;
    transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease;position:relative}
  .pbk-card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(6,95,70,.10);border-color:#A7F3D0}
  .pbk-card:focus-visible{outline:2px solid #0d9268;outline-offset:2px}
  .pbk-thumb{height:150px;background:#F0F2F5;position:relative;overflow:hidden}
  .pbk-thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s ease}
  .pbk-card:hover .pbk-thumb img{transform:scale(1.04)}
  .pbk-thumb-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,#ECFDF5,#D1FAE5)}
  .pbk-thumb-ph i{font-size:2rem;color:#34D399;opacity:.9}
  .pbk-type-badge{position:absolute;top:10px;left:10px;font-size:.68rem;font-weight:700;padding:3px 9px;border-radius:999px;
    background:rgba(6,95,70,.85);color:#fff;letter-spacing:.2px}
  .pbk-type-badge.q{background:rgba(180,83,9,.88)}
  .pbk-saved-chip{position:absolute;bottom:10px;right:10px;font-size:.68rem;color:#374151;
    background:rgba(255,255,255,.92);border:1px solid #E5E7EB;border-radius:999px;padding:2px 8px;backdrop-filter:blur(4px)}
  .pbk-card-body{padding:13px 15px 14px;display:flex;flex-direction:column;gap:8px;flex:1}
  .pbk-card-title{font-size:.98rem;font-weight:700;color:#111827;line-height:1.4;margin:0;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .pbk-card-excerpt{font-size:.83rem;color:#4b5563;line-height:1.55;margin:0;
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .pbk-card-foot{margin-top:auto;display:flex;align-items:center;gap:10px;padding-top:8px;border-top:1px dashed #EEF1F4;font-size:.75rem;color:#6b7280}
  .pbk-foot-author{display:flex;align-items:center;gap:6px;min-width:0;text-decoration:none;color:inherit}
  .pbk-foot-author:hover{color:#065F46}
  .pbk-foot-author img{width:22px;height:22px;border-radius:50%;object-fit:cover;flex:0 0 auto}
  .pbk-foot-author span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pbk-foot-meta{margin-left:auto;display:flex;gap:10px;flex:0 0 auto}
  .pbk-foot-meta i{color:#34D399;margin-right:2px}
  .pbk-owner-unsave{position:absolute;top:10px;right:10px;z-index:2;width:32px;height:32px;border-radius:50%;
    border:1px solid #E5E7EB;background:rgba(255,255,255,.95);color:#DC2626;cursor:pointer;
    display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.12);transition:.15s}
  .pbk-owner-unsave:hover{background:#FEF2F2;transform:scale(1.08)}

  /* খালি অবস্থা */
  .pbk-empty{text-align:center;padding:56px 20px;background:var(--pf-card,#fff);border:1px dashed #CBD5E1;border-radius:16px}
  .pbk-empty-icon{width:64px;height:64px;margin:0 auto 14px;border-radius:50%;background:#ECFDF5;
    display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:#059669;position:relative}
  .pbk-empty-icon::after{content:'';position:absolute;inset:-6px;border-radius:50%;border:2px solid #A7F3D0;opacity:.5;animation:pbkPulse 2s ease-out infinite}
  @keyframes pbkPulse{0%{transform:scale(.9);opacity:.6}100%{transform:scale(1.25);opacity:0}}
  .pbk-empty h3{margin:0 0 6px;color:#111827}
  .pbk-empty p{margin:0;color:#6b7280;font-size:.9rem}

  /* লক-স্ক্রিন (প্রাইভেসি-ব্লকড) */
  .pbk-locked{max-width:460px;margin:48px auto;text-align:center;background:var(--pf-card,#fff);
    border:1px solid var(--pf-border-soft,#e4e9ef);border-radius:18px;padding:40px 28px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
  .pbk-lock-badge{width:76px;height:76px;margin:0 auto 16px;border-radius:50%;background:#FEF3C7;
    display:flex;align-items:center;justify-content:center;font-size:1.7rem;color:#B45309}
  .pbk-locked h2{margin:0 0 8px;color:#111827;font-size:1.2rem}
  .pbk-locked p{margin:0 0 18px;color:#6b7280;font-size:.9rem;line-height:1.6}
  .pbk-locked .pbk-back{font-size:.9rem}
</style>

<div class="pbk-wrap">
  <%# ── মিনি-হিরো ── %>
  <header class="pbk-hero">
    <img loading="lazy" decoding="async" src="<%= profile.avatar_url || '/avatar/' + profile.id %>" alt="<%= profile.full_name %>" class="pbk-hero-avatar">
    <div class="pbk-hero-main">
      <h1 class="pbk-hero-name">
        <a href="/profile/<%= profile.username %>"><%= profile.full_name %></a>
        <% if (isPublic) { %>
          <span class="pbk-privacy-chip pbk-privacy-on" title="এই তালিকা পাবলিক — সেটিংস থেকে যেকোনো সময় বন্ধ করা যায়"><i class="fas fa-globe-asia"></i> পাবলিক তালিকা</span>
        <% } else if (isOwner) { %>
          <span class="pbk-privacy-chip pbk-privacy-off" title="শুধু আপনি দেখছেন — পাবলিক করতে সেটিংস → গোপনীয়তা"><i class="fas fa-lock"></i> শুধু আপনার জন্য</span>
        <% } %>
      </h1>
      <p class="pbk-hero-sub">
        <i class="fas fa-bookmark" style="color:#34D399"></i>
        সংরক্ষিত লেখার তালিকা
        <% if (items.length) { %> · <b><%= bn(items.length) %></b>টি লেখা<% } %>
      </p>
    </div>
    <div class="pbk-stats" aria-label="প্রোফাইল স্ট্যাট">
      <div class="pbk-stat"><b><%= bn(totalPosts) %></b><span>লেখা</span></div>
      <div class="pbk-stat"><b><%= bn(followerCount) %></b><span>অনুসারী</span></div>
    </div>
  </header>

  <%# ── লক-স্ক্রিন: প্রাইভেট তালিকা, অপরিচিত ভিজিটর ── %>
  <% if (privacyBlocked) { %>
    <div class="pbk-locked" role="alert">
      <div class="pbk-lock-badge"><i class="fas fa-lock"></i></div>
      <h2>এই তালিকা প্রাইভেট</h2>
      <p><%= profile.full_name %> তাঁর সংরক্ষিত-লেখা তালিকা পাবলিক করেননি।<br>প্রোফাইলের বাকি অংশ দেখতে ফিরে যান।</p>
      <a class="pbk-back" href="/profile/<%= profile.username %>"><i class="fas fa-arrow-left"></i> প্রোফাইলে ফিরুন</a>
    </div>
  <% } else if (items.length === 0) { %>
    <div class="pbk-backbar">
      <a class="pbk-back" href="/profile/<%= profile.username %>"><i class="fas fa-arrow-left"></i> প্রোফাইল</a>
    </div>
    <div class="pbk-empty">
      <div class="pbk-empty-icon"><i class="far fa-bookmark"></i></div>
      <h3>কোনো লেখা সংরক্ষিত নেই</h3>
      <p><% if (isOwner) { %>পছন্দের লেখায় 📂 সংরক্ষণ-বাটন চাপলেই এখানে জমা হবে।<% } else { %><%= profile.full_name %> এখনো কোনো লেখা সংরক্ষণ করেননি।<% } %></p>
    </div>
  <% } else { %>
    <div class="pbk-backbar">
      <a class="pbk-back" href="/profile/<%= profile.username %>"><i class="fas fa-arrow-left"></i> প্রোফাইল</a>
      <span class="pbk-count-pill"><b><%= bn(items.length) %></b>টি লেখা সংরক্ষিত</span>
    </div>

    <div class="pbk-grid">
      <% items.forEach(function (it) { %>
        <article class="pbk-card-wrap" style="position:relative">
          <% if (isOwner) { %>
            <button type="button" class="pbk-owner-unsave" data-unsave="<%= it.id %>"
                    aria-label="সংরক্ষণ সরান" title="সংরক্ষণ সরান"><i class="fas fa-times"></i></button>
          <% } %>
          <a class="pbk-card" href="/<%= it.type === 'question' ? 'qa' : 'articles' %>/<%= it.id %>">
            <div class="pbk-thumb">
              <% if (it.cover_image && /^(https?:\/\/|\/)/.test(it.cover_image)) { %>
                <img loading="lazy" decoding="async" src="<%= it.cover_image %>" alt="<%= it.title %>">
              <% } else { %>
                <div class="pbk-thumb-ph"><i class="fas fa-feather-alt"></i></div>
              <% } %>
              <span class="pbk-type-badge <%= it.type === 'question' ? 'q' : '' %>"><%= it.type === 'question' ? 'প্রশ্ন' : 'লেখা' %></span>
              <span class="pbk-saved-chip" data-ts="<%= it.saved_at %>" title="সংরক্ষিত হয়েছে"><i class="far fa-clock"></i></span>
            </div>
            <div class="pbk-card-body">
              <h3 class="pbk-card-title"><%= it.title %></h3>
              <% if (it.display_excerpt) { %><p class="pbk-card-excerpt"><%= it.display_excerpt %></p><% } %>
              <div class="pbk-card-foot">
                <span class="pbk-foot-author">
                  <img loading="lazy" decoding="async" src="<%= it.author_avatar || '/avatar/' + it.author_id %>" alt="<%= it.author_name %>">
                  <span><%= it.author_name %></span>
                </span>
                <span class="pbk-foot-meta">
                  <span><i class="fas fa-heart"></i><%= bn(it.like_count || 0) %></span>
                  <span><i class="far fa-comment"></i><%= bn(it.comment_count || 0) %></span>
                  <span><i class="far fa-clock"></i><%= bn(it.read_min) %> মি</span>
                </span>
              </div>
            </div>
          </a>
        </article>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
  /* সাপেক্ষ-সময় (main.js-এর LekhokRelTime-এর সাথে সংগতি) + মালিকের আনসেভ */
  (function () {
    var BN = '০১২৩৪৫৬৭৮৯';
    function bn(n) { return String(n).replace(/\d/g, function (d) { return BN[+d]; }); }
    function relTime(ts) {
      var d = new Date(String(ts).replace(' ', 'T') + (String(ts).indexOf('Z') > -1 ? '' : 'Z'));
      if (isNaN(d.getTime())) return '';
      var m = Math.floor(Math.max(0, Date.now() - d.getTime()) / 60000);
      if (m < 1) return 'এইমাত্র';
      if (m < 60) return bn(m) + ' মিনিট আগে';
      var h = Math.floor(m / 60);
      if (h < 24) return bn(h) + ' ঘণ্টা আগে';
      var dd = Math.floor(h / 24);
      if (dd < 7) return bn(dd) + ' দিন আগে';
      return d.getUTCDate() + '/' + (d.getUTCMonth() + 1);
    }
    document.querySelectorAll('.pbk-saved-chip[data-ts]').forEach(function (el) {
      var t = relTime(el.getAttribute('data-ts'));
      el.innerHTML = '<i class="far fa-clock"></i> ' + (t || '');
      el.title = 'সংরক্ষিত: ' + el.getAttribute('data-ts');
    });
    document.querySelectorAll('.pbk-owner-unsave').forEach(function (btn) {
      btn.addEventListener('click', async function (e) {
        e.preventDefault();
        if (btn.disabled) return;
        btn.disabled = true;
        try {
          var res = await fetch('/api/bookmark', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ post_id: btn.getAttribute('data-unsave') })
          });
          if (res.ok) {
            var card = btn.closest('.pbk-card-wrap');
            card.style.transition = 'opacity .25s, transform .25s';
            card.style.opacity = '0'; card.style.transform = 'scale(.96)';
            setTimeout(function () { card.remove(); }, 240);
            if (window.showToast) showToast('সংরক্ষণ সরানো হয়েছে', 'success');
          } else if (res.status === 401) { location.href = '/login'; }
        } catch (err) { /* নীরব */ }
        btn.disabled = false;
      });
    });
  })();
</script>

<%- include('../partials/sandbox-preview') %>
</body>
</html>
