<%# ═══════════════════════════════════════════════════════════════════════════
    সেশন ৮৩ — ফেসবুক-স্ট্যান্ডার্ড পার্সোনাল প্রোফাইল ও টাইমলাইন
    ① হিরো-হেডার: ৩:১ কভার (মোবাইলে ১৬:৯) + ওভারল্যাপিং ১৬৮px অ্যাভাটার + অনলাইন-ডট
      + কলমী নাম + ভেরিফায়েড-টিক + মিউচুয়াল-স্ন্যাপশট + ডুয়াল CTA (অনুসরণ/মেসেজ/•••)
    ② স্টিকি সাব-ন্যাভ (পোস্টসমূহ | পরিচিতি | অনুসরণকারী | অনুসরণ | ছবি)
    ③ ২-কলাম গ্রিড: বামে Intro/ছবি/অনুসারী সাইডবার-কার্ড, ডানে টাইমলাইন-ফিড
    ④ পিনড-পোস্ট (মালিক ৩-ডট মেনু থেকে পিন/আনপিন) + FB-স্টাইল পোস্ট-কার্ড
    ═══════════════════════════════════════════════════════════════════════ %>
<%- include('../partials/header', { title: (profile.full_name) + ' | লেখক ফোরাম', extra_css: ['/assets/css/profile.css'] }) %>

  <% if (typeof req !== 'undefined' && req.query.ok === 'avatar') { %>
    <div class="profile-toast success" onclick="this.remove()"><i class="fas fa-check-circle"></i> প্রোফাইল ছবি সফলভাবে পরিবর্তন হয়েছে</div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.ok === 'cover') { %>
    <div class="profile-toast success" onclick="this.remove()"><i class="fas fa-check-circle"></i> কভার ফটো সফলভাবে পরিবর্তন হয়েছে</div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.ok === 'pinned') { %>
    <div class="profile-toast success" onclick="this.remove()"><i class="fas fa-thumbtack"></i> পিন আপডেট হয়েছে</div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.err) { %>
    <div class="profile-toast error" onclick="this.remove()"><i class="fas fa-exclamation-circle"></i> ত্রুটি: <%= req.query.err === 'upload' ? 'ফাইল আপলোড ব্যর্থ' : req.query.err === 'no_file' ? 'কোনো ফাইল নির্বাচিত হয়নি' : 'সংরক্ষণ ব্যর্থ' %></div>
  <% } %>

  <div class="pf-shell">
  <div class="pf-wrap">

    <%# ═══════════ হিরো-হেডার (কভার + অ্যাভাটার + CTA + সাব-ন্যাভ) ═══════════ %>
    <header class="pf-hero" role="banner">
      <div class="pf-cover"<% if (profile.cover_url) { %> style="background-image:url('<%= profile.cover_url %>');"<% } %>>
        <% if (isOwner) { %>
          <button type="button" class="pf-cover-btn" id="coverCamBtn" title="কভার ফটো"><i class="fas fa-camera"></i><span>কভার পরিবর্তন</span></button>
          <div class="pic-menu" id="coverMenu" hidden>
            <% if (profile.cover_url) { %><button type="button" data-view="<%= profile.cover_url %>"><i class="fas fa-eye"></i> কভার ফটো দেখুন</button><% } %>
            <button type="button" onclick="document.getElementById('coverUpload').click()"><i class="fas fa-image"></i> কভার ফটো পরিবর্তন করুন</button>
          </div>
        <% } %>
      </div>

      <div class="pf-hero-row">
        <%# অ্যাভাটার — কভারের উপর অর্ধেক ওভারল্যাপ + অনলাইন-ডট %>
        <div class="pf-avatar-area">
          <div class="pf-avatar-wrap">
            <img loading="lazy" decoding="async" src="<%= profile.avatar_url || '/avatar/' + profile.id %>" alt="<%= profile.full_name %>" class="pf-avatar">
            <% if (isOnline) { %><span class="pf-online-dot" title="এখন অনলাইনে" aria-label="অনলাইন"></span><% } %>
            <% if (isOwner) { %>
              <button type="button" class="pf-avatar-cam" id="avatarCamBtn" title="প্রোফাইল ছবি"><i class="fas fa-camera"></i></button>
              <div class="pic-menu" id="avatarMenu" hidden>
                <button type="button" data-view="<%= profile.avatar_url || '/avatar/' + profile.id %>"><i class="fas fa-eye"></i> প্রোফাইল পিকচার দেখুন</button>
                <button type="button" onclick="document.getElementById('avatarUpload').click()"><i class="fas fa-user-circle"></i> প্রোফাইল পিকচার পরিবর্তন করুন</button>
              </div>
              <form method="POST" action="/settings/avatar" enctype="multipart/form-data" id="avatarForm" style="display:none">
                <input type="file" name="avatar" id="avatarUpload" accept="image/*" onchange="document.getElementById('avatarForm').submit()">
              </form>
            <% } %>
          </div>
        </div>

        <%# নাম + কলমী নাম + ভেরিফায়েড + স্ট্যাট-লাইন %>
        <div class="pf-id-block">
          <h1 class="pf-name">
            <%= profile.full_name %>
            <% if (profile.pen_name) { %><span class="pf-pen-name">(<%= profile.pen_name %>)</span><% } %>
            <% if (isVerified) { %><span class="pf-verified" title="যাচাইকৃত সংগঠন-পদাধিকারী" aria-label="ভেরিফায়েড"><i class="fas fa-check"></i></span><% } %>
            <%# সেশন ৯০: স্টাফ-রোল ব্যাজ — সুস্পষ্ট পদ-চিপ (মডারেটর/এডমিন/সুপার এডমিন) %>
            <% if (typeof roleBadge !== 'undefined' && roleBadge) { %><span class="pf-role-badge <%= roleBadge.cls %>" title="ফোরাম-দায়িত্ব: <%= roleBadge.label %>"><i class="fas <%= roleBadge.icon %>"></i> <%= roleBadge.label %></span><% } %>
          </h1>
          <p class="pf-sub-line">
            <button type="button" class="pf-meta-link" data-tab="followers"><strong><%= bn(followerCount) %></strong> জন অনুসারী</button>
            <span class="pf-dot-sep">•</span>
            <span><strong><%= bn(totalPosts) %></strong> লেখা</span>
            <% if (totalLikes > 0) { %><span class="pf-dot-sep">•</span><span><strong><%= bn(totalLikes) %></strong> প্রতিক্রিয়া</span><% } %>
          </p>
          <%# সেশন ১৪৭: FB-হেডার বায়ো + ইনলাইন-মেটা চিপ (ঠিকানা/প্রতিষ্ঠান/রক্ত/ওয়েবসাইট) %>
          <% if (profile.bio) { %><p class="pf-bio147"><%= profile.bio %></p><% } %>
          <%
            const metaChips147 = [];
            if (profile.address) metaChips147.push({ ico: 'fas fa-map-marker-alt', txt: profile.address + '-এ বসবাস' });
            if (profile.institution) metaChips147.push({ ico: 'fas fa-graduation-cap', txt: profile.academic_year ? (profile.institution + ' · ' + profile.academic_year) : profile.institution });
            if (profile.hometown) metaChips147.push({ ico: 'fas fa-home', txt: 'নিজ জেলা: ' + profile.hometown });
            if (profile.blood_group) metaChips147.push({ ico: 'fas fa-tint', txt: 'রক্তের গ্রুপ: ' + profile.blood_group });
          %>
          <% if (metaChips147.length) { %>
            <p class="pf-meta-chips147">
              <% metaChips147.forEach(function (m) { %>
                <span class="pf-meta-chip147"><i class="<%= m.ico %>" aria-hidden="true"></i> <%= m.txt %></span>
              <% }) %>
            </p>
          <% } %>
          <% if (mutuals && mutuals.length) { %>
            <p class="pf-mutual-line">
              <span class="pf-mutual-avatars">
                <% mutuals.slice(0, 5).forEach(m => { %>
                  <img loading="lazy" decoding="async" src="<%= m.avatar_url || '/avatar/' + m.id %>" alt="<%= m.full_name %>" title="<%= m.full_name %>">
                <% }) %>
              </span>
              <button type="button" class="pf-meta-link" data-tab="followers"><%= bn(mutuals.length) %> জন মিউচুয়াল সংযোগ</button>
            </p>
          <% } %>
          <p class="pf-presence <%= isOnline ? 'on' : 'off' %>">
            <% if (isOnline) { %>এখন অনলাইনে<% } else if (lastSeenBn) { %>সক্রিয় ছিলেন <%= lastSeenBn %><% } %>
          </p>
        </div>

        <%# অ্যাকশন-বার: মালিক → সম্পাদনা/নতুন-লেখা/••• ; ভিজিটর → অনুসরণ/মেসেজ/••• %>
        <div class="pf-actions">
          <% if (isOwner) { %>
            <a href="/articles/new" class="pf-btn primary"><i class="fas fa-plus"></i> নতুন লেখা</a>
            <a href="/profile/edit" class="pf-btn gray"><i class="fas fa-pen"></i> প্রোফাইল সম্পাদনা</a>
            <div class="pf-menu-wrap">
              <button type="button" class="pf-btn gray icon-only" id="profile3DotBtn" onclick="toggleProfile3Dot(event)" title="আরও অপশন" aria-label="আরও অপশন"><i class="fas fa-ellipsis-h"></i></button>
              <div class="pf-menu" id="profile3DotMenu">
                <button type="button" onclick="document.getElementById('coverUpload').click()"><i class="fas fa-image"></i> কভার ফটো পরিবর্তন</button>
                <button type="button" onclick="document.getElementById('avatarUpload').click()"><i class="fas fa-user-circle"></i> প্রোফাইল ছবি পরিবর্তন</button>
                <a href="/settings"><i class="fas fa-cog"></i> সেটিংস ও গোপনীয়তা</a>
                <a href="/dashboard"><i class="fas fa-chart-line"></i> ড্যাশবোর্ড</a>
              </div>
              <form method="POST" action="/settings/cover" enctype="multipart/form-data" id="coverForm" style="display:none">
                <input type="file" name="cover" id="coverUpload" accept="image/*" onchange="document.getElementById('coverForm').submit()">
              </form>
            </div>
          <% } else { %>
            <% if (user) { %>
              <button type="button" class="pf-btn <%= isFollowing ? 'gray' : 'primary' %> pf-follow-btn" data-user="<%= profile.id %>">
                <i class="fas fa-<%= isFollowing ? 'check' : 'plus' %>"></i> <%= isFollowing ? 'অনুসরণ করছেন' : 'অনুসরণ করুন' %>
              </button>
              <a href="/messages/<%= profile.username %>" class="pf-btn gray"><i class="fab fa-facebook-messenger"></i> মেসেজ</a>
              <div class="pf-menu-wrap">
                <button type="button" class="pf-btn gray icon-only" onclick="toggleProfile3Dot(event)" title="আরও অপশন" aria-label="আরও অপশন"><i class="fas fa-ellipsis-h"></i></button>
                <div class="pf-menu" id="profile3DotMenu">
                  <button type="button" id="pfCopyLink"><i class="fas fa-link"></i> প্রোফাইল লিংক কপি</button>
                  <a href="/complaints"><i class="fas fa-flag"></i> প্রোফাইল রিপোর্ট করুন</a>
                  <% if (!iBlockedHim) { %><button type="button" class="pf-danger-item" id="pfBlockUser" data-user="<%= profile.id %>"><i class="fas fa-ban"></i> ব্লক করুন</button><% } %>
                </div>
              </div>
            <% } else { %>
              <a href="/login?next=<%= encodeURIComponent('/profile/' + profile.username) %>" class="pf-btn primary"><i class="fas fa-plus"></i> অনুসরণ করুন</a>
              <a href="/login?next=<%= encodeURIComponent('/profile/' + profile.username) %>" class="pf-btn gray"><i class="fab fa-facebook-messenger"></i> মেসেজ</a>
              <div class="pf-menu-wrap">
                <button type="button" class="pf-btn gray icon-only" onclick="toggleProfile3Dot(event)" title="আরও অপশন" aria-label="আরও অপশন"><i class="fas fa-ellipsis-h"></i></button>
                <div class="pf-menu" id="profile3DotMenu">
                  <button type="button" id="pfCopyLink"><i class="fas fa-link"></i> প্রোফাইল লিংক কপি</button>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

      <%# স্টিকি সাব-ন্যাভ — হেডারের নিচেই আটকে থাকে %>
      <nav class="pf-subnav" role="tablist" aria-label="প্রোফাইল সেকশন">
        <button type="button" class="pf-tab active" data-tab="posts" role="tab" aria-selected="true"><i class="far fa-newspaper"></i> পোস্টসমূহ</button>
        <button type="button" class="pf-tab" data-tab="about" role="tab" aria-selected="false"><i class="far fa-id-badge"></i> পরিচিতি</button>
        <button type="button" class="pf-tab" data-tab="followers" role="tab" aria-selected="false"><i class="fas fa-users"></i> অনুসরণকারী</button>
        <button type="button" class="pf-tab" data-tab="following" role="tab" aria-selected="false"><i class="fas fa-user-friends"></i> অনুসরণ</button>
        <button type="button" class="pf-tab" data-tab="photos" role="tab" aria-selected="false"><i class="far fa-images"></i> ছবি</button>
        <% if (isOwner || Number(profile.bookmarks_public) === 1) { %>
          <%# D2 (সেশন ৯১): পাবলিক সংরক্ষণ-তালিকা লিংক-ট্যাব (মালিক সবসময়; অন্যরা bookmarks_public=1 হলে) %>
          <a class="pf-tab pf-tab-href" href="/profile/<%= profile.username %>/bookmarks" role="tab" aria-selected="false"><i class="fas fa-bookmark"></i> সংরক্ষণ</a>
        <% } %>
        <% if (isOwner) { %>
          <button type="button" class="pf-tab" data-tab="bookmarks" role="tab" aria-selected="false"><i class="fas fa-bookmark"></i> সংরক্ষিত</button>
          <button type="button" class="pf-tab" data-tab="drafts" role="tab" aria-selected="false"><i class="fas fa-file"></i> ড্রাফট</button>
          <button type="button" class="pf-tab" data-tab="categories" role="tab" aria-selected="false"><i class="fas fa-tags"></i> ক্যাটাগরি</button>
        <% } %>
      </nav>
    </header>

    <%# ═══════════ ২-কলাম বডি গ্রিড (৩৬০px সাইডবার + ফ্লেক্স টাইমলাইন) ═══════════ %>
    <div class="pf-body">

      <%# ── কলাম ১: বাম সাইডবার (পরিচিতি / ছবি / অনুসারী) ── %>
      <aside class="pf-side" aria-label="প্রোফাইল সাইডবার">

        <%# ১. পরিচিতি কার্ড %>
        <div class="pf-card">
          <h3 class="pf-card-title">পরিচিতি</h3>
          <% if (profile.bio) { %><p class="pf-bio"><%= profile.bio %></p><% } else if (isOwner) { %><p class="pf-bio muted">আপনার পরিচিতি লিখুন — <a href="/profile/edit">সম্পাদনা করুন</a></p><% } %>
          <ul class="pf-detail-list">
            <% if (profile.designation) { %><li><i class="fas fa-briefcase"></i><span><%= profile.designation %></span></li><% } %>
            <% if (joinedBn) { %><li><i class="far fa-calendar-plus"></i><span><%= joinedBn %> এ যুক্ত হয়েছেন</span></li><% } %>
            <% if (profile.address) { %><li><i class="fas fa-map-marker-alt"></i><span><%= profile.address %>-এ বসবাস<% if (profile.hometown) { %> · নিজ জেলা <%= profile.hometown %><% } %></span></li><% } %>
            <%# সেশন ১৪৭: FB-বিস্তারিত পরিচিতি — প্রতিষ্ঠান/শিক্ষাবর্ষ/রক্তের-গ্রুপ %>
            <% if (profile.institution) { %><li><i class="fas fa-graduation-cap"></i><span>অধ্যয়ন করেছেন: <strong><%= profile.institution %></strong><% if (profile.academic_year) { %><small class="pf-detail-sub147"><%= profile.academic_year %></small><% } %></span></li><% } %>
            <% if (profile.blood_group) { %><li><i class="fas fa-tint"></i><span>রক্তের গ্রুপ: <strong><%= profile.blood_group %></strong></span></li><% } %>
            <% if (isOwner || (profile.show_birth && profile.birth_date)) { %>
              <% if (profile.birth_date) { %><li><i class="fas fa-birthday-cake"></i><span><%= profile.birth_date %></span></li><% } %>
            <% } %>
            <% if ((isOwner || (profile.show_email && profile.email)) && profile.email) { %>
              <li><i class="fas fa-envelope"></i><a href="mailto:<%= profile.email %>" class="pf-link"><%= profile.email %></a></li>
            <% } %>
            <% if ((isOwner || (profile.show_phone && profile.phone)) && profile.phone) { %><li><i class="fas fa-phone"></i><span><%= profile.phone %></span></li><% } %>
          </ul>
          <%
            const safeUrl83 = u => (typeof u === 'string' && /^https?:\/\//i.test(u.trim())) ? u.trim() : null;
            const socials83 = [
              { u: safeUrl83(profile.social_fb),       ico: 'fab fa-facebook-f',     lbl: 'Facebook' },
              { u: safeUrl83(profile.social_twitter),  ico: 'fab fa-x-twitter',      lbl: 'Twitter / X' },
              { u: safeUrl83(profile.social_linkedin), ico: 'fab fa-linkedin-in',    lbl: 'LinkedIn' },
              { u: safeUrl83(profile.social_telegram), ico: 'fab fa-telegram-plane', lbl: 'Telegram' },
              { u: safeUrl83(profile.social_website),  ico: 'fas fa-globe',          lbl: 'ওয়েবসাইট' },
            ].filter(s => s.u);
            // সেশন ৮০ (মার্জ-সংরক্ষণ): settings-এ নির্বাচিত সাহিত্য-ধারা (genres JSON)
            let genres83 = [];
            try { genres83 = JSON.parse(profile.genres || '[]'); if (!Array.isArray(genres83)) genres83 = []; } catch (_) {}
          %>
          <% if (genres83.length) { %>
            <div class="pf-genres"><% genres83.forEach(function (g) { %><span class="pf-genre-badge"><i class="fas fa-feather"></i> <%= g %></span><% }) %></div>
          <% } %>
          <% if (socials83.length) { %>
            <div class="pf-social-row">
              <% socials83.forEach(function (s) { %>
                <a href="<%= s.u %>" target="_blank" rel="noopener" class="pf-social-chip" aria-label="<%= s.lbl %>" title="<%= s.lbl %>"><i class="<%= s.ico %>"></i></a>
              <% }) %>
            </div>
          <% } %>
          <% if (interests.length) { %>
            <div class="pf-interests">
              <% interests.forEach(t => { %><a href="/articles?tag=<%= encodeURIComponent(t) %>" class="tag-chip">#<%= t %></a><% }); %>
            </div>
          <% } %>
          <a href="/profile/edit" class="pf-btn gray full-w"><i class="fas fa-pen"></i> পরিচিতি সম্পাদনা</a>
        </div>

        <%# ১(খ). সেশন ১৪৭: হাইলাইটস ক্যারোসেল — সর্বাধিক-এনগেজড ৩ লেখার উল্লম্ব
            কার্ড-স্ট্রিপ (সত্য-ডেটা: রিঅ্যাকশন×২ + কমেন্ট×৩ + ভিউ×০.২) — FB-হাইলাইটস-প্যারিটি %>
        <% if (highlights && highlights.length) { %>
          <div class="pf-card">
            <div class="pf-card-head">
              <h3 class="pf-card-title"><i class="fas fa-star pf-title-ico"></i> হাইলাইটস</h3>
              <span class="pf-card-more as-text147">সর্বাধিক আলোচিত</span>
            </div>
            <div class="pf-highlights147">
              <% highlights.forEach(function (h) { %>
                <a href="/articles/<%= h.id %>" class="pf-hl-card147">
                  <span class="pf-hl-media147">
                    <% if (h.cover_image) { %>
                      <img loading="lazy" decoding="async" src="<%= h.cover_image %>" alt="">
                    <% } else { %>
                      <span class="pf-hl-fallback147"><i class="fas fa-feather-alt"></i></span>
                    <% } %>
                    <span class="pf-hl-views147"><i class="fas fa-eye" aria-hidden="true"></i> <%= bn(h.view_count || 0) %></span>
                  </span>
                  <span class="pf-hl-title147"><%= h.title %></span>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>

        <%# ২. ছবি কার্ড (৩×৩ স্ন্যাপশট) %>
        <div class="pf-card">
          <div class="pf-card-head">
            <h3 class="pf-card-title">ছবি</h3>
            <button type="button" class="pf-card-more" data-tab="photos">সব ছবি দেখুন</button>
          </div>
          <div class="pf-photo-grid">
            <% photos.slice(0, 9).forEach(p => { %>
              <% if (p.postId) { %>
                <a href="/articles/<%= p.postId %>" class="pf-photo-tile" title="<%= p.title || 'ছবি' %>"><img loading="lazy" decoding="async" src="<%= p.url %>" alt="<%= p.title || 'ছবি' %>"><% if (p.title) { %><span class="pf-photo-cap"><%= p.title %></span><% } %></a>
              <% } else { %>
                <a href="<%= p.url %>" target="_blank" rel="noopener" class="pf-photo-tile"><img loading="lazy" decoding="async" src="<%= p.url %>" alt="ছবি"></a>
              <% } %>
            <% }) %>
          </div>
        </div>

        <%# ৩. অনুসারী কার্ড (৩×৩ অ্যাভাটার-স্ন্যাপশট) %>
        <div class="pf-card">
          <div class="pf-card-head">
            <h3 class="pf-card-title">অনুসরণকারী</h3>
            <button type="button" class="pf-card-more" data-tab="followers">সবাইকে দেখুন</button>
          </div>
          <% if (followers.length === 0) { %>
            <p class="pf-side-empty">এখনো কোনো অনুসরণকারী নেই।</p>
          <% } else { %>
            <div class="pf-follower-grid">
              <% followers.slice(0, 9).forEach(f => { %>
                <a href="/profile/<%= f.username %>" class="pf-follower-tile">
                  <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" alt="<%= f.full_name %>">
                  <span><%= f.full_name %></span>
                  <%# সেশন ১৪৭: FB-মিউচুয়াল-কাউন্ট — ভিজিটর ও টাইল-ব্যক্তি উভয়েই যাঁদের অনুসরণ করেন %>
                  <% if (tileMutuals && tileMutuals[f.id]) { %><small class="pf-tile-mutual147"><%= bn(tileMutuals[f.id]) %> জন মিউচুয়াল</small><% } %>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>

        <%# ৪. সংগঠনে দায়িত্ব %>
        <% if (orgRoles && orgRoles.length) { %>
          <div class="pf-card">
            <h3 class="pf-card-title"><i class="fas fa-award pf-title-ico"></i> সংগঠনে দায়িত্ব</h3>
            <div class="pf-role-chips">
              <% orgRoles.forEach(r => { %>
                <span class="pf-role-chip"><strong><%= r.role %></strong><% if (r.term_year) { %><small><%= r.term_year %></small><% } %></span>
              <% }) %>
            </div>
          </div>
        <% } %>

        <%# ৫. কুইজ-পারফরম্যান্স (সেশন ৬২ — পাবলিক) %>
        <% if (quizStats) { %>
          <div class="quiz-profile-card">
            <h4><i class="fas fa-bullseye"></i> কুইজ পারফরম্যান্স</h4>
            <div class="qpc-row">
              <span class="qpc-item"><i class="fas fa-circle-check"></i> সঠিক <strong><%= bn(quizStats.correct) %>/<%= bn(quizStats.answered) %></strong></span>
              <span class="qpc-item"><i class="fas fa-bullseye"></i> নির্ভুলতা <strong><%= bn(quizStats.accuracy) %>%</strong></span>
              <span class="qpc-item<%= quizStats.streak > 0 ? ' has-fire' : '' %>"><i class="fas fa-fire"></i> ধারাবাহিক <strong><%= bn(quizStats.streak) %></strong></span>
            </div>
            <a href="/quiz" class="qpc-link"><i class="fas fa-arrow-left"></i> আজকের কুইজ খেলুন</a>
          </div>
        <% } %>
      </aside>

      <%# ── কলাম ২: টাইমলাইন / ট্যাব-প্যানেলসমূহ ── %>
      <main class="pf-main">

        <%# ═══ সেশন ১৪৭: FB-কম্পোজার-স্ট্রিপ (মালিক) — প্রোফাইল-টাইমলাইনের শীর্ষে
            'আপনার মনের কথা লিখুন…' + দ্রুত-অ্যাকশন (লেখা/প্রশ্ন/ছবি) ═══ %>
        <% if (isOwner) { %>
          <div class="pf-card pf-composer147">
            <div class="pf-composer-row147">
              <img loading="lazy" decoding="async" src="<%= profile.avatar_url || '/avatar/' + profile.id %>" alt="" class="pf-composer-av147">
              <a href="/articles/new" class="pf-composer-cta147"><%= profile.full_name.split(' ')[0] %>, আপনার মনের কথা লিখুন…</a>
            </div>
            <div class="pf-composer-acts147">
              <a href="/articles/new" class="pf-composer-act147 is-green"><i class="fas fa-pen-nib" aria-hidden="true"></i> লেখা লিখুন</a>
              <a href="/articles/new" class="pf-composer-act147 is-red"><i class="far fa-images" aria-hidden="true"></i> ছবি/ভিডিও</a>
              <a href="/qa/new" class="pf-composer-act147 is-blue"><i class="fas fa-question-circle" aria-hidden="true"></i> প্রশ্ন করুন</a>
            </div>
          </div>
        <% } %>

        <%# ═══ ট্যাব: পোস্টসমূহ (পিনড + ফিল্টার-পিল + FB-ফিড) ═══ %>
        <%# session139: ফিল্টার-বার tab-posts-এর বাইরে তোলা হলো — চার-প্যানেল-সুইচেও
            বার দৃশ্যমান থাকে (আগে tab-posts-এর ভেতরে থাকায় অন্য-প্যানে-গেলে বার
            নিখোঁজ হতো + প্রশ্ন/মন্তব্য/প্রতিক্রিয়া-পিল প্যানে-অনুপস্থিতিতে নীরব-মৃত ছিল) %>
        <div class="pf-filter-bar pf-card">
          <button type="button" class="pf-pill active" data-tab="posts"><i class="fas fa-pen-nib"></i> লেখা</button>
          <button type="button" class="pf-pill" data-tab="questions"><i class="fas fa-question-circle"></i> প্রশ্ন</button>
          <button type="button" class="pf-pill" data-tab="comments"><i class="far fa-comment"></i> মন্তব্য</button>
          <button type="button" class="pf-pill" data-tab="reactions"><i class="far fa-heart"></i> প্রতিক্রিয়া</button>
          <a href="/articles?author=<%= encodeURIComponent(profile.username) %>" class="pf-all-posts" title="<%= profile.full_name %> এর সব লেখা"><i class="fas fa-layer-group"></i> সব লেখা</a>
        </div>

        <section class="tab-content active" id="tab-posts" role="tabpanel" aria-label="লেখাসমূহ">
          <%# পিনড-পোস্ট — টাইমলাইনের শীর্ষে — সেশন ১০৫: ক্যানোনিকাল FeedPostCard %>
          <% if (pinnedPost) { %>
            <%- include('../shared/post/FeedPostCard', { item: pinnedPost, user: user, myBookmarkedIds: (typeof myBookmarkedIds !== 'undefined' ? myBookmarkedIds : []), opts: { profileMode: true, showPin: isOwner, cardClass: 'pf-post pinned', pinnedLabel: 'পিন করা লেখা' } }) %>
          <% } %>

          <% if (posts.length === 0) { %>
            <div class="pf-card pf-empty">
              <i class="fas fa-pen-nib"></i>
              <p>এখনো কোনো লেখা প্রকাশ করা হয়নি।</p>
              <% if (isOwner) { %><a href="/articles/new" class="pf-btn primary">প্রথম লেখা লিখুন</a><% } %>
            </div>
          <% } else { %>
            <div class="pf-feed">
              <% posts.forEach(post => { %>
                <%# সেশন ১০৫: ক্যানোনিকাল FeedPostCard — প্রোফাইল-টাইমলাইনেও একই পোস্ট-কার্ড %>
                <%- include('../shared/post/FeedPostCard', { item: post, user: user, myBookmarkedIds: (typeof myBookmarkedIds !== 'undefined' ? myBookmarkedIds : []), opts: { profileMode: true, showPin: isOwner, cardClass: 'pf-post' } }) %>
              <% }); %>
            </div>
          <% } %>
        </section>

        <%# ═══ session139: ট্যাব: প্রশ্ন (প্যানে-নির্মাণ — পিল নীরব-মৃত ছিল) ═══ %>
        <section class="tab-content" id="tab-questions" role="tabpanel" aria-label="প্রশ্নসমূহ">
          <% if (!questions || questions.length === 0) { %>
            <div class="pf-card pf-empty">
              <i class="fas fa-question-circle"></i>
              <p>এখনো কোনো প্রশ্ন করা হয়নি।</p>
              <% if (isOwner) { %><a href="/qa/new" class="pf-btn primary">প্রশ্ন করুন</a><% } %>
            </div>
          <% } else { %>
            <div class="pf-feed">
              <% questions.forEach(q => { %>
                <article class="pf-card pf-mini">
                  <div class="pf-mini-top">
                    <span class="pf-mini-kind"><i class="fas fa-question-circle" aria-hidden="true"></i> প্রশ্ন</span>
                    <% if (q.accepted_comment_id) { %><span class="pf-ansbadge" title="এই প্রশ্নের উত্তর গৃহীত হয়েছে"><i class="fas fa-circle-check" aria-hidden="true"></i> গৃহীত</span><% } %>
                    <span class="pf-mini-date"><i class="far fa-clock" aria-hidden="true"></i> <%= bnRelTime ? bnRelTime(q.published_at || q.created_at) : new Date(q.published_at || q.created_at).toLocaleDateString('bn-BD') %></span>
                  </div>
                  <h3 class="pf-mini-title"><a href="/qa/<%= q.id %>"><%= q.title %></a></h3>
                  <% if (q.body) { %><p class="pf-mini-excerpt"><%= mdPlain(q.body, 160) %></p><% } %>
                  <div class="pf-mini-meta">
                    <span><i class="far fa-comment" aria-hidden="true"></i> <%= bn(q.answer_count || q.ans_count || 0) %> উত্তর</span>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>

        <%# ═══ session139: ট্যাব: মন্তব্য (প্যানে-নির্মাণ + গৃহীত-উত্তর ব্যাজ — session132-অবশিষ্ট ①) ═══ %>
        <section class="tab-content" id="tab-comments" role="tabpanel" aria-label="মন্তব্যসমূহ">
          <% if (!comments || comments.length === 0) { %>
            <div class="pf-card pf-empty">
              <i class="far fa-comment"></i>
              <p>এখনো কোনো মন্তব্য নেই।</p>
            </div>
          <% } else { %>
            <div class="pf-feed">
              <% comments.forEach(c => { %>
                <article class="pf-card pf-mini">
                  <div class="pf-mini-top">
                    <span class="pf-mini-kind"><i class="<%= c.post_type === 'question' ? 'fas fa-question-circle' : 'fas fa-pen-nib' %>" aria-hidden="true"></i> <%= c.post_type === 'question' ? 'প্রশ্নে' : 'লেখায়' %></span>
                    <% if (c.accepted_flag) { %><span class="pf-ansbadge" title="এই উত্তরটি গ্রহণকৃত"><i class="fas fa-circle-check" aria-hidden="true"></i> গৃহীত উত্তর</span><% } %>
                    <span class="pf-mini-date"><i class="far fa-clock" aria-hidden="true"></i> <%= bnRelTime ? bnRelTime(c.created_at) : new Date(c.created_at).toLocaleDateString('bn-BD') %></span>
                  </div>
                  <p class="pf-mini-excerpt"><%= mdPlain(c.body, 200) %></p>
                  <div class="pf-mini-meta">
                    <a href="<%= c.post_type === 'question' ? '/qa/' + c.post_id : '/articles/' + c.post_id %>" class="pf-mini-link"><%= c.post_title %> <i class="fas fa-angle-right" aria-hidden="true"></i></a>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>

        <%# ═══ session139: ট্যাব: প্রতিক্রিয়া (প্যানে-নির্মাণ — পিল নীরব-মৃত ছিল) ═══ %>
        <section class="tab-content" id="tab-reactions" role="tabpanel" aria-label="প্রতিক্রিয়াসমূহ">
          <% if (!reactions || reactions.length === 0) { %>
            <div class="pf-card pf-empty">
              <i class="far fa-heart"></i>
              <p>এখনো কোনো প্রতিক্রিয়া নেই।</p>
            </div>
          <% } else { %>
            <% const EMO139 = { like: '👍', love: '❤️', care: '🤗', haha: '😂', wow: '😮', sad: '😢', angry: '😡' }; %>
            <div class="pf-feed">
              <% reactions.forEach(r => { %>
                <article class="pf-card pf-mini">
                  <div class="pf-mini-top">
                    <span class="pf-mini-kind"><%= EMO139[r.reaction_type] || '👍' %> প্রতিক্রিয়া</span>
                    <span class="pf-mini-date"><i class="far fa-clock" aria-hidden="true"></i> <%= bnRelTime ? bnRelTime(r.created_at) : new Date(r.created_at).toLocaleDateString('bn-BD') %></span>
                  </div>
                  <h3 class="pf-mini-title"><a href="<%= r.post_type === 'question' ? '/qa/' + r.post_id : '/articles/' + r.post_id %>"><%= r.title %></a></h3>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>

        <%# ═══ ট্যাব: পরিচিতি (বিস্তারিত) ═══ %>
        <section class="tab-content" id="tab-about" role="tabpanel">
          <div class="pf-card">
            <h3 class="pf-card-title">পরিচিতি</h3>
            <% if (profile.bio) { %><p class="pf-bio"><%= profile.bio %></p><% } else { %><p class="pf-bio muted">কোনো বায়ো যোগ করা হয়নি।</p><% } %>
            <ul class="pf-detail-list">
              <% if (profile.designation) { %><li><i class="fas fa-briefcase"></i><span>পদবি: <strong><%= profile.designation %></strong></span></li><% } %>
              <% if (joinedBn) { %><li><i class="far fa-calendar-plus"></i><span><%= joinedBn %> এ যুক্ত হয়েছেন</span></li><% } %>
              <% if (profile.address) { %><li><i class="fas fa-map-marker-alt"></i><span>ঠিকানা: <%= profile.address %><% if (profile.hometown) { %> · নিজ জেলা <%= profile.hometown %><% } %></span></li><% } %>
              <%# সেশন ১৪৭: FB-বিস্তারিত পরিচিতি (tab-about মিরর) %>
              <% if (profile.institution) { %><li><i class="fas fa-graduation-cap"></i><span>অধ্যয়ন করেছেন: <strong><%= profile.institution %></strong><% if (profile.academic_year) { %><small class="pf-detail-sub147"><%= profile.academic_year %></small><% } %></span></li><% } %>
              <% if (profile.blood_group) { %><li><i class="fas fa-tint"></i><span>রক্তের গ্রুপ: <strong><%= profile.blood_group %></strong></span></li><% } %>
              <% if (isOwner || (profile.show_birth && profile.birth_date)) { %>
                <% if (profile.birth_date) { %><li><i class="fas fa-birthday-cake"></i><span>জন্ম: <%= profile.birth_date %></span></li><% } %>
              <% } %>
              <% if ((isOwner || (profile.show_email && profile.email)) && profile.email) { %><li><i class="fas fa-envelope"></i><span>ইমেইল: <a href="mailto:<%= profile.email %>" class="pf-link"><%= profile.email %></a></span></li><% } %>
              <% if ((isOwner || (profile.show_phone && profile.phone)) && profile.phone) { %><li><i class="fas fa-phone"></i><span>ফোন: <%= profile.phone %></span></li><% } %>
            </ul>
            <% if (orgRoles && orgRoles.length) { %>
              <div class="pf-about-block">
                <h4><i class="fas fa-award"></i> সংগঠনে দায়িত্ব</h4>
                <div class="pf-role-chips">
                  <% orgRoles.forEach(r => { %><span class="pf-role-chip"><strong><%= r.role %></strong><% if (r.term_year) { %><small><%= r.term_year %></small><% } %></span><% }) %>
                </div>
              </div>
            <% } %>
            <% if (socials83 && socials83.length) { %>
              <div class="pf-about-block">
                <h4><i class="fas fa-link"></i> সোশ্যাল লিংক</h4>
                <div class="pf-social-row">
                  <% socials83.forEach(function (s) { %><a href="<%= s.u %>" target="_blank" rel="noopener" class="pf-social-chip" aria-label="<%= s.lbl %>"><i class="<%= s.ico %>"></i></a><% }) %>
                </div>
              </div>
            <% } %>
            <% if (genres83 && genres83.length) { %>
              <div class="pf-about-block">
                <h4><i class="fas fa-feather"></i> সাহিত্য-ধারা</h4>
                <div class="pf-genres"><% genres83.forEach(function (g) { %><span class="pf-genre-badge"><i class="fas fa-feather"></i> <%= g %></span><% }) %></div>
              </div>
            <% } %>
            <% if (interests.length) { %>
              <div class="pf-about-block">
                <h4><i class="fas fa-tags"></i> আগ্রহের বিষয়</h4>
                <div class="pf-interests">
                  <% interests.forEach(t => { %><a href="/articles?tag=<%= encodeURIComponent(t) %>" class="tag-chip">#<%= t %></a><% }); %>
                </div>
              </div>
            <% } %>
            <% if (isOwner) { %><a href="/profile/edit" class="pf-btn gray full-w"><i class="fas fa-pen"></i> সম্পাদনা করুন</a><% } %>
          </div>
        </section>

        <%# ═══ ট্যাব: অনুসরণকারী ═══ %>
        <section class="tab-content" id="tab-followers" role="tabpanel">
          <div class="pf-list-head"><h3>অনুসরণকারী <span class="pf-count-badge"><%= bn(followerCount) %></span></h3></div>
          <% if (followers.length === 0) { %>
            <div class="pf-card pf-empty"><i class="fas fa-users"></i><p>কোনো অনুসরণকারী নেই।</p></div>
          <% } else { %>
            <% if (isOwner) { %><p class="manage-hint"><i class="fas fa-sliders-h"></i> আপনার অনুসরণকারী ব্যবস্থাপনা, সরান বা ব্লক করুন</p><% } %>
            <div class="pf-list">
              <% followers.forEach(f => { %>
                <div class="pf-user-row pf-card">
                  <a href="/profile/<%= f.username %>" class="pf-user-main">
                    <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="pf-user-avatar" alt="">
                    <span><strong><%= f.full_name %></strong><small><%= f.designation || 'সদস্য' %></small></span>
                  </a>
                  <% if (isOwner) { %>
                    <span class="pf-user-actions">
                      <button type="button" class="pf-btn gray sm remove-follower" data-user="<%= f.id %>" title="অনুসরণকারী সরান"><i class="fas fa-user-minus"></i> সরান</button>
                      <button type="button" class="pf-btn danger sm block-user" data-user="<%= f.id %>" title="ব্লক করুন"><i class="fas fa-ban"></i></button>
                    </span>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
        </section>

        <%# ═══ ট্যাব: অনুসরণ ═══ %>
        <section class="tab-content" id="tab-following" role="tabpanel">
          <div class="pf-list-head"><h3>অনুসরণ করছেন <span class="pf-count-badge"><%= bn(followingCount) %></span></h3></div>
          <% if (following.length === 0) { %>
            <div class="pf-card pf-empty"><i class="fas fa-user-friends"></i><p>কাউকে অনুসরণ করছেন না।</p></div>
          <% } else { %>
            <div class="pf-list">
              <% following.forEach(f => { %>
                <div class="pf-user-row pf-card">
                  <a href="/profile/<%= f.username %>" class="pf-user-main">
                    <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="pf-user-avatar" alt="">
                    <span><strong><%= f.full_name %></strong><small><%= f.designation || 'সদস্য' %></small></span>
                  </a>
                </div>
              <% }) %>
            </div>
          <% } %>
        </section>

        <%# ═══ ট্যাব: ছবি (গ্যালারি) ═══ %>
        <section class="tab-content" id="tab-photos" role="tabpanel">
          <div class="pf-list-head"><h3>ছবিসমূহ</h3></div>
          <div class="pf-card pf-photo-gallery">
            <% if (photos.length === 0) { %>
              <p class="pf-side-empty">কোনো ছবি নেই।</p>
            <% } else { %>
              <div class="pf-photo-grid big">
                <% photos.forEach(p => { %>
                  <% if (p.postId) { %>
                    <a href="/articles/<%= p.postId %>" class="pf-photo-tile" title="<%= p.title || 'ছবি' %>"><img loading="lazy" decoding="async" src="<%= p.url %>" alt="<%= p.title || 'ছবি' %>"><% if (p.title) { %><span class="pf-photo-cap"><%= p.title %></span><% } %></a>
                  <% } else { %>
                    <a href="<%= p.url %>" target="_blank" rel="noopener" class="pf-photo-tile"><img loading="lazy" decoding="async" src="<%= p.url %>" alt="ছবি"></a>
                  <% } %>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>

        <% if (isOwner) { %>
        <%# ═══ ট্যাব: সংরক্ষিত (মালিক) ═══ %>
        <section class="tab-content" id="tab-bookmarks" role="tabpanel">
          <div class="pf-list-head"><h3>সংরক্ষিত পোস্ট</h3></div>
          <% if (bookmarks.length === 0) { %>
            <div class="pf-card pf-empty"><i class="fas fa-bookmark"></i><p>কোনো সংরক্ষিত পোস্ট নেই।</p></div>
          <% } else { %>
            <div class="pf-list">
              <% bookmarks.forEach(b => { %>
                <div class="pf-card pf-mini-row">
                  <div class="pf-mini-title"><a href="<%= b.type === 'question' ? '/qa/' + b.id : '/articles/' + b.id %>"><%= b.title %></a></div>
                  <div class="pf-mini-meta"><span class="pf-badge"><%= b.type === 'question' ? 'প্রশ্ন' : 'লেখা' %></span> সংরক্ষিত <%= bnRelTime(b.bookmarked_at) %></div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </section>

        <%# ═══ ট্যাব: ড্রাফট (মালিক) ═══ %>
        <section class="tab-content" id="tab-drafts" role="tabpanel">
          <div class="pf-list-head"><h3>আমার কন্টেন্ট ব্যবস্থাপনা</h3></div>
          <% if (drafts.length === 0 && myDaily.length === 0) { %>
            <div class="pf-card pf-empty"><i class="fas fa-file"></i><p>কোনো ড্রাফট বা শিডিউল করা কন্টেন্ট নেই।</p></div>
          <% } %>
          <div class="pf-list">
            <% drafts.forEach(d => { %>
              <div class="pf-card pf-mini-row">
                <div class="pf-mini-title"><%= d.title || 'শিরোনামহীন ড্রাফট' %></div>
                <div class="pf-mini-meta"><span class="pf-badge muted"><%= d.type === 'question' ? 'প্রশ্ন ড্রাফট' : 'লেখা ড্রাফট' %></span> <%= bnRelTime(d.created_at) %></div>
              </div>
            <% }); %>
            <% myDaily.forEach(d => { %>
              <div class="pf-card pf-mini-row">
                <div class="pf-mini-title"><%= d.title || '(শিরোনাম নেই)' %></div>
                <div class="pf-mini-meta"><span class="pf-badge <%= d.published ? '' : 'muted' %>"><%= d.published ? 'প্রকাশিত' : 'শিডিউল' %></span> <%= d.content_type %><% if (d.scheduled_date) { %> • <%= d.scheduled_date %><% } %></div>
              </div>
            <% }); %>
          </div>
        </section>

        <%# ═══ ট্যাব: ক্যাটাগরি (মালিক) ═══ %>
        <section class="tab-content" id="tab-categories" role="tabpanel">
          <div class="pf-list-head"><h3>আগ্রহের বিষয়</h3></div>
          <div class="pf-card">
            <p class="manage-hint"><i class="fas fa-tags"></i> আগ্রহের বিষয় নির্বাচন করুন, এগুলো আপনার ফিড ব্যক্তিগত করবে</p>
            <div class="tag-cloud" id="interestPool">
              <% tagPool.forEach(t => { %>
                <button type="button" class="tag-chip interest-opt <%= interests.includes(t.tag) ? 'selected' : '' %>" data-tag="<%= t.tag %>">#<%= t.tag %></button>
              <% }); %>
              <% if (tagPool.length === 0) { %><span class="side-text">এখনো কোনো ট্যাগ পুল নেই।</span><% } %>
            </div>
            <button type="button" class="pf-btn primary" id="saveInterests"><i class="fas fa-save"></i> সংরক্ষণ করুন</button>
          </div>
        </section>
        <% } %>
      </main>
    </div>
  </div>
  </div><%# /.pf-shell %>

  <%# সেশন ৮৭: কভার-পরিবর্তন প্রিভিউ-মোডাল (মালিক) — আপলোডের আগে ৩:১ প্রিভিউ %>
  <% if (isOwner) { %>
  <div class="pf-modal" id="pfCoverModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="pfCoverTitle">
    <div class="pf-modal-card">
      <h3 id="pfCoverTitle"><i class="fas fa-image"></i> কভার প্রিভিউ</h3>
      <p class="pf-modal-sub">নতুন কভার এভাবেই দেখাবে — ডেস্কটপে ৩:১ রেশিও, মোবাইলে উপর-নিচ সামান্য কাটা যাবে।</p>
      <div class="pf-modal-cover"><img id="pfCoverPreview" alt="নতুন কভারের প্রিভিউ"></div>
      <div class="pf-modal-btns">
        <button type="button" class="pf-btn gray" id="pfCoverCancel">বাতিল</button>
        <button type="button" class="pf-btn primary" id="pfCoverConfirm"><i class="fas fa-upload"></i> কভার স্থাপন করুন</button>
      </div>
    </div>
  </div>
  <% } %>

  <%- include('../partials/share-modal') %>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <%# সেশন ১০৫: কমেন্ট-ড্রয়ার/প্যালেট/৩-ডট/রিঅ্যাক্টরস-মডাল ইঞ্জিন — ক্যানোনিকাল কম্পোনেন্ট-চুক্তি %>
  <script src="/assets/js/comment-tools.js?v=<%= AV %>"></script>
  <%# সেশন ১০৫: রিঅ্যাক্টরস-মডাল (PostFooterActions কাউন্টার-বারের ক্লিক-টার্গেট) %>
  <%- include('../shared/post/ReactorsModal') %>
  <script>
    // ── ট্যাব-সুইচ (সাব-ন্যাভ + ফিল্টার-পিল + স্ট্যাট-বাটন একই মেকানিজম) ──
    document.querySelectorAll('[data-tab]').forEach(btn => {
      btn.addEventListener('click', function (e) {
        const target = this.dataset.tab;
        if (!target || !document.getElementById('tab-' + target)) return;
        document.querySelectorAll('.pf-tab').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        document.querySelectorAll('.pf-pill').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');
        document.getElementById('tab-' + target).classList.add('active');
        // ট্যাব-বদলে মৃদু-স্ক্রল (শুধু মেইন-কনটেন্ট দেখা যায় এমন পজিশনে)
        if (window.innerWidth < 900) {
          document.querySelector('.pf-body')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // ── অনুসরণ/আনফলো (অপ্টিমিস্টিক টগল) ──
    document.querySelector('.pf-follow-btn')?.addEventListener('click', async function () {
      this.disabled = true;
      try {
        const res = await fetch('/follow/' + this.dataset.user, { method: 'POST' });
        const data = await res.json();
        if (data.following) {
          this.classList.remove('primary'); this.classList.add('gray');
          this.innerHTML = '<i class="fas fa-check"></i> অনুসরণ করছেন';
          showToast('অনুসরণ করছেন ✓', 'success');
        } else {
          this.classList.add('primary'); this.classList.remove('gray');
          this.innerHTML = '<i class="fas fa-plus"></i> অনুসরণ করুন';
          showToast('অনুসরণ বাতিল হয়েছে', '');
        }
      } catch (e) {
        showToast('সম্ভব হয়নি — আবার চেষ্টা করুন', 'error');
      } finally {
        this.disabled = false;
      }
    });

    // ── প্রোফাইল লিংক কপি (••• মেনু) ──
    document.getElementById('pfCopyLink')?.addEventListener('click', async function () {
      try {
        await navigator.clipboard.writeText(location.href);
        showToast('প্রোফাইল লিংক কপি হয়েছে ✓', 'success');
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = location.href; document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); ta.remove();
        showToast('প্রোফাইল লিংক কপি হয়েছে ✓', 'success');
      }
      document.getElementById('profile3DotMenu')?.classList.remove('open');
    });

    // ── ব্লক (ভিজিটর ••• মেনু) ──
    document.getElementById('pfBlockUser')?.addEventListener('click', async function () {
      if (!confirm('এই ব্যবহারকারীকে ব্লক করবেন?')) return;
      const res = await fetch('/api/block/' + this.dataset.user, { method: 'POST' });
      const data = await res.json();
      if (data.ok) {
        showToast('ব্যবহারকারী ব্লক করা হয়েছে', 'success');
        setTimeout(() => location.href = '/', 900);
      } else showToast('ব্লক করা যায়নি', 'error');
    });

    <% if (isOwner) { %>
    // ── পিনড-পোস্ট টগল (মালিক) — সফল হলে পুনরায় লোড (শীর্ষে স্থানান্তর) ──
    document.querySelectorAll('.pf-pin-toggle').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const res = await fetch('/profile/<%= profile.username %>/pin', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postId: Number(btn.dataset.post) })
        });
        const data = await res.json();
        if (data.ok) {
          showToast(data.pinned ? 'লেখাটি প্রোফাইলের শীর্ষে পিন হয়েছে 📌' : 'পিন সরানো হয়েছে', 'success');
          setTimeout(() => location.reload(), 700);
        } else {
          showToast('পিন করা যায়নি', 'error');
        }
      });
    });

    // অনুসরণকারী সরান
    document.querySelectorAll('.remove-follower').forEach(btn => {
      btn.addEventListener('click', async () => {
        const res = await fetch('/api/followers/' + btn.dataset.user + '/remove', { method: 'POST' });
        if (res.ok) btn.closest('.pf-user-row').remove();
      });
    });
    // ব্লক করুন (অনুসারী-তালিকা)
    document.querySelectorAll('.block-user').forEach(btn => {
      btn.addEventListener('click', async () => {
        const res = await fetch('/api/block/' + btn.dataset.user, { method: 'POST' });
        const data = await res.json();
        if (data.ok && data.blocked) showToast('ব্যবহারকারী ব্লক করা হয়েছে', 'success');
        btn.closest('.pf-user-row')?.remove();
      });
    });
    // আগ্রহ-পিকার
    document.querySelectorAll('.interest-opt').forEach(chip => {
      chip.addEventListener('click', () => chip.classList.toggle('selected'));
    });
    document.getElementById('saveInterests')?.addEventListener('click', async function () {
      const tags = [...document.querySelectorAll('.interest-opt.selected')].map(c => c.dataset.tag);
      const res = await fetch('/api/me/interests', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tags })
      });
      if (res.ok) { showToast('আগ্রহের বিষয় সংরক্ষিত হয়েছে', 'success'); setTimeout(() => location.reload(), 800); }
    });
    <% } %>

    // ── ৩-ডট মেনু (হিরো) ──
    function toggleProfile3Dot(e) {
      e.stopPropagation();
      const m = document.getElementById('profile3DotMenu');
      m.classList.toggle('open');
    }
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.pf-menu-wrap')) {
        document.getElementById('profile3DotMenu')?.classList.remove('open');
      }
    });

    <%# সেশন ১০৫: পোস্ট ৩-ডট মেনু এখন ক্যানোনিকাল PostActionMenu (.pm-wrap —
        comment-tools.js গ্লোবাল ইঞ্জিন) — পুরনো inline ৩-ডট/শেয়ার হ্যান্ডলার অবচিত-অপসারিত %>

    // ── স্টিকি সাব-ন্যাভ — সাইট-ওয়াইড body{overflow-x:hidden}-এ position:sticky
    //     অকার্যকর, তাই FB-ম্যাট-প্যাটার্ন: টপে পৌঁছালে fixed-ক্লাস + প্লেসহোল্ডার-জাম্পগার্ড ──
    (function () {
      var nav = document.querySelector('.pf-subnav');
      if (!nav) return;
      var ph = document.createElement('div');
      ph.style.height = '0px';
      nav.parentNode.insertBefore(ph, nav);
      var docTop = 0, ticking = false;
      function measure() {
        docTop = nav.getBoundingClientRect().top + (window.scrollY || 0) - ph.offsetHeight;
        apply();
      }
      function apply() {
        var y = window.scrollY || 0;
        var stuck = y + 1 >= docTop;
        if (stuck) {
          if (ph.style.height === '0px') ph.style.height = nav.offsetHeight + 'px';
          nav.classList.add('fixed');
        } else {
          ph.style.height = '0px';
          nav.classList.remove('fixed');
        }
      }
      window.addEventListener('scroll', function () {
        if (!ticking) { requestAnimationFrame(function () { apply(); ticking = false; }); ticking = true; }
      }, { passive: true });
      window.addEventListener('resize', measure);
      window.addEventListener('load', measure);
      setTimeout(measure, 300);
      measure();
    })();

    // ── সেশন ৮৭: কভার-প্রিভিউ মোডাল — ফাইল-নির্বাচন → ৩:১ প্রিভিউ → নিশ্চিত-সাবমিট ──
    <% if (isOwner) { %>
    (function () {
      var inp = document.getElementById('coverUpload');
      var modal = document.getElementById('pfCoverModal');
      if (!inp || !modal) return;
      // লিগেসি inline onchange="coverForm.submit()" সরাও — নইলে প্রিভিউ-মোডালের
      // আগেই ফর্ম সাবমিট হয়ে যায় (JS-বিহীন ব্রাউজারে অ্যাট্রিবিউট ততক্ষণে অক্ষত)
      inp.removeAttribute('onchange');
      var img = document.getElementById('pfCoverPreview');
      var form = document.getElementById('coverForm');
      function close() { modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; inp.value = ''; }
      inp.addEventListener('change', function () {
        var f = this.files && this.files[0];
        if (!f) return;
        if (!/^image\//.test(f.type)) { showToast('শুধু ছবি-ফাইল নির্বাচন করুন', 'error'); inp.value = ''; return; }
        var r = new FileReader();
        r.onload = function (e) {
          img.src = e.target.result;
          modal.classList.add('open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        };
        r.readAsDataURL(f);
      });
      document.getElementById('pfCoverCancel').addEventListener('click', close);
      document.getElementById('pfCoverConfirm').addEventListener('click', function () {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (form) form.submit();
      });
      modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('open')) close(); });
    })();
    <% } %>

    // ── ক্যামেরা-মেনু ওয়্যারিং (কভার/অ্যাভাটার) ──
    (function () {
      function wire(btnId, menuId) {
        var b = document.getElementById(btnId), m = document.getElementById(menuId);
        if (!b || !m) return;
        b.addEventListener('click', function (e) {
          e.stopPropagation();
          document.querySelectorAll('.pic-menu:not([hidden])').forEach(x => { if (x !== m) x.hidden = true; });
          m.hidden = !m.hidden;
        });
        m.addEventListener('click', function (e) {
          var v = e.target.closest('[data-view]');
          if (v) { window.open(v.dataset.view, '_blank'); m.hidden = true; }
        });
      }
      wire('avatarCamBtn', 'avatarMenu');
      wire('coverCamBtn', 'coverMenu');
      document.addEventListener('click', function () { document.querySelectorAll('.pic-menu:not([hidden])').forEach(x => x.hidden = true); });
    })();
  </script>

<%- include('../partials/sandbox-preview') %>
</body>
</html>
