<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: (profile.full_name) + ' | লেখক ফোরাম', extra_css: ['/assets/css/profile.css'] }) %>

  <% if (typeof req !== 'undefined' && req.query.ok === 'avatar') { %>
    <div class="profile-toast success" onclick="this.remove()"><i class="fas fa-check-circle"></i> প্রোফাইল ছবি সফলভাবে পরিবর্তন হয়েছে</div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.ok === 'cover') { %>
    <div class="profile-toast success" onclick="this.remove()"><i class="fas fa-check-circle"></i> কভার ফটো সফলভাবে পরিবর্তন হয়েছে</div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.err) { %>
    <div class="profile-toast error" onclick="this.remove()"><i class="fas fa-exclamation-circle"></i> ত্রুটি: <%= req.query.err === 'upload' ? 'ফাইল আপলোড ব্যর্থ' : req.query.err === 'no_file' ? 'কোনো ফাইল নির্বাচিত হয়নি' : 'সংরক্ষণ ব্যর্থ' %></div>
  <% } %>
  <div class="profile-wrap">
    <div class="profile-cover card">
      <div class="profile-banner"<% if (profile.cover_url) { %> style="background-image:url('<%= profile.cover_url %>'); background-size:cover; background-position:center;"<% } %>></div>
      <div class="profile-avatar-row">
        <div class="profile-avatar-wrap">
          <img loading="lazy" decoding="async" src="<%= profile.avatar_url || '/avatar/' + profile.id %>" alt="<%= profile.full_name %>" class="profile-avatar profile-avatar-lg" onclick="<%= isOwner ? 'document.getElementById(\'avatarUpload\').click()' : '' %>" style="<%= isOwner ? 'cursor:pointer' : '' %>" title="<%= isOwner ? 'প্রোফাইল ছবি পরিবর্তন করুন' : '' %>">
          <% if (isOwner) { %>
            <div class="avatar-change-hint"><i class="fas fa-camera"></i></div>
            <form method="POST" action="/settings/avatar" enctype="multipart/form-data" id="avatarForm" style="display:none">
              <input type="file" name="avatar" id="avatarUpload" accept="image/*" onchange="document.getElementById('avatarForm').submit()">
            </form>
          <% } %>
        </div>
        <% if (isOwner) { %>
          <div class="profile-owner-actions">
            <a href="/profile/edit" class="btn btn-ghost btn-sm"><i class="fas fa-pen"></i> সম্পাদনা</a>
            <a href="/settings" class="btn btn-ghost btn-sm"><i class="fas fa-sliders-h"></i> সেটিংস</a>
            <a href="/articles/new" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> নতুন লেখা</a>
            <div class="profile-3dot-wrap">
              <button class="profile-3dot-btn" onclick="toggleProfile3Dot(event)" title="আরও"><i class="fas fa-ellipsis-v"></i></button>
              <div class="profile-3dot-menu" id="profile3DotMenu">
                <button type="button" onclick="document.getElementById('coverUpload').click()"><i class="fas fa-image"></i> কভার ফটো পরিবর্তন</button>
                <button type="button" onclick="document.getElementById('avatarUpload').click()"><i class="fas fa-user-circle"></i> প্রোফাইল ছবি পরিবর্তন</button>
                <a href="/settings"><i class="fas fa-cog"></i> সেটিংস</a>
              </div>
              <form method="POST" action="/settings/cover" enctype="multipart/form-data" id="coverForm" style="display:none">
                <input type="file" name="cover" id="coverUpload" accept="image/*" onchange="document.getElementById('coverForm').submit()">
              </form>
            </div>
          </div>
        <% } else if (user) { %>
          <div class="profile-owner-actions">
            <button class="btn <%= isFollowing ? 'btn-ghost' : 'btn-primary' %> btn-sm btn-follow" data-user="<%= profile.id %>">
              <i class="fas fa-<%= isFollowing ? 'check' : 'plus' %>"></i> <%= isFollowing ? 'অনুসরণ করছেন' : 'অনুসরণ করুন' %>
            </button>
            <a href="/messages/<%= profile.username %>" class="btn btn-ghost btn-sm"><i class="far fa-envelope"></i> মেসেজ</a>
          </div>
        <% } %>
      </div>
    </div>

    <div class="profile-body">
      <div class="profile-left">
        <div class="card profile-info-card">
          <h2><%= profile.full_name %></h2>
          <p class="profile-username">@<%= profile.username %></p>
          <% if (profile.designation) { %><p class="profile-designation"><i class="fas fa-briefcase"></i> <%= profile.designation %></p><% } %>
          <% if (profile.bio) { %><p class="profile-bio"><%= profile.bio %></p><% } %>

          <% if (orgRoles && orgRoles.length) { %>
            <div class="org-roles">
              <h4><i class="fas fa-award"></i> সংগঠনে দায়িত্ব</h4>
              <div class="org-role-chips">
                <% orgRoles.forEach(r => { %>
                  <span class="org-role-chip">
                    <strong><%= r.role %></strong>
                    <% if (r.term_year) { %><small><%= r.term_year %> কার্যবর্ষ</small><% } %>
                  </span>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="profile-stats">
            <button class="stat tab-jump" data-tab="posts"><span><%= postCount %></span><small>লেখা</small></button>
            <button class="stat tab-jump" data-tab="followers"><span><%= followerCount %></span><small>অনুসরণকারী</small></button>
            <button class="stat tab-jump" data-tab="following"><span><%= followingCount %></span><small>অনুসরণ</small></button>
          </div>

          <div class="profile-contact">
            <% if (isOwner || (profile.show_email && profile.email)) { %>
              <div><i class="fas fa-envelope"></i> <a href="mailto:<%= profile.email %>"><%= profile.email %></a></div>
            <% } %>
            <% if (isOwner || (profile.show_phone && profile.phone)) { %>
              <div><i class="fas fa-phone"></i> <%= profile.phone %></div>
            <% } %>
            <% if (profile.address) { %>
              <div><i class="fas fa-map-marker-alt"></i> <%= profile.address %></div>
            <% } %>
            <% if (isOwner || (profile.show_birth && profile.birth_date)) { %>
              <div><i class="fas fa-birthday-cake"></i> <%= profile.birth_date %></div>
            <% } %>
          </div>

          <div class="profile-social">
            <% if (profile.social_fb) { %><a href="<%= profile.social_fb %>" target="_blank" rel="noopener" class="social-link"><i class="fab fa-facebook"></i></a><% } %>
            <% if (profile.social_twitter) { %><a href="<%= profile.social_twitter %>" target="_blank" rel="noopener" class="social-link"><i class="fab fa-twitter"></i></a><% } %>
            <% if (profile.social_linkedin) { %><a href="<%= profile.social_linkedin %>" target="_blank" rel="noopener" class="social-link"><i class="fab fa-linkedin"></i></a><% } %>
            <% if (profile.social_website) { %><a href="<%= profile.social_website %>" target="_blank" rel="noopener" class="social-link"><i class="fas fa-globe"></i></a><% } %>
          </div>

          <% if (interests.length) { %>
            <div class="interests-row">
              <h4><i class="fas fa-tags"></i> আগ্রহের বিষয়</h4>
              <div class="tag-cloud">
                <% interests.forEach(t => { %><a href="/articles?tag=<%= encodeURIComponent(t) %>" class="tag-chip">#<%= t %></a><% }); %>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <div class="profile-right">
        <div class="profile-tabs">
          <button class="tab-btn active" data-tab="posts"><i class="fas fa-pen-nib"></i> লেখা</button>
          <button class="tab-btn" data-tab="questions"><i class="fas fa-question-circle"></i> প্রশ্ন</button>
          <button class="tab-btn" data-tab="comments"><i class="far fa-comment"></i> মন্তব্য</button>
          <button class="tab-btn" data-tab="reactions"><i class="far fa-heart"></i> প্রতিক্রিয়া</button>
          <button class="tab-btn" data-tab="followers"><i class="fas fa-users"></i> অনুসরণকারী</button>
          <button class="tab-btn" data-tab="following"><i class="fas fa-user-friends"></i> অনুসরণ</button>
          <% if (isOwner) { %>
            <button class="tab-btn" data-tab="bookmarks"><i class="fas fa-bookmark"></i> সংরক্ষিত</button>
            <button class="tab-btn" data-tab="drafts"><i class="fas fa-file"></i> ড্রাফট</button>
            <button class="tab-btn" data-tab="categories"><i class="fas fa-tags"></i> ক্যাটাগরি</button>
          <% } %>
        </div>

        <!-- Tab: Posts -->
        <div class="tab-content active" id="tab-posts">
          <% if (posts.length === 0) { %>
            <div class="empty-state card">
              <i class="fas fa-pen-nib"></i>
              <p>এখনো কোনো লেখা প্রকাশ করা হয়নি।</p>
              <% if (isOwner) { %><a href="/articles/new" class="btn btn-primary btn-sm">প্রথম লেখা লিখুন</a><% } %>
            </div>
          <% } else { %>
            <% posts.forEach(post => { %>
              <div class="post-card card">
                <% if (post.cover_image) { %><img loading="lazy" decoding="async" src="<%= post.cover_image %>" alt="cover" class="post-cover"><% } %>
                <div class="post-card-body">
                  <div class="post-meta-top">
                    <span class="post-tag"><%= post.tags ? post.tags.split(',')[0].trim() : 'সাধারণ' %></span>
                    <span class="post-date"><i class="far fa-clock"></i> <%= new Date(post.published_at).toLocaleDateString('bn-BD') %></span>
                    <% if (isOwner) { %>
                    <div class="post-3dot-wrap">
                      <button class="post-3dot-btn" onclick="togglePost3Dot(event, <%= post.id %>)" title="আরও"><i class="fas fa-ellipsis-v"></i></button>
                      <div class="post-3dot-menu" id="post3dot-<%= post.id %>">
                        <a href="/articles/<%= post.id %>/edit"><i class="fas fa-pen"></i> সম্পাদনা</a>
                        <a href="/articles/<%= post.id %>"><i class="fas fa-eye"></i> দেখুন</a>
                        <a href="#" onclick="sharePost(<%= post.id %>);return false"><i class="fas fa-share"></i> শেয়ার</a>
                        <form method="POST" action="/articles/<%= post.id %>/delete" onsubmit="return confirm('মুছে ফেলবেন?')" style="margin:0">
                          <button type="submit" class="post-delete-btn"><i class="fas fa-trash"></i> মুছুন</button>
                        </form>
                      </div>
                    </div>
                    <% } %>
                  </div>
                  <a href="/articles/<%= post.id %>" class="post-title"><%= post.title %></a>
                  <p class="post-excerpt"><%= (post.excerpt || post.body || '').substring(0, 150) %>…</p>
                  <div class="post-actions">
                    <span><i class="far fa-heart"></i> <%= post.like_count || 0 %></span>
                    <span><i class="far fa-comment"></i> <%= post.comment_count || 0 %></span>
                    <span><i class="far fa-eye"></i> <%= post.view_count || 0 %></span>
                    <span><i class="fas fa-share"></i> <%= post.share_count || 0 %></span>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Tab: Questions -->
        <div class="tab-content" id="tab-questions">
          <% if (questions.length === 0) { %>
            <div class="empty-state card">
              <i class="fas fa-question-circle"></i>
              <p>এখনো কোনো প্রশ্ন করা হয়নি।</p>
              <% if (isOwner) { %><a href="/qa/new" class="btn btn-primary btn-sm">প্রশ্ন করুন</a><% } %>
            </div>
          <% } else { %>
            <% questions.forEach(q => { %>
              <div class="qa-card card">
                <div class="qa-q"><i class="fas fa-question-circle"></i> <a href="/qa/<%= q.id %>"><%= q.title %></a></div>
                <div class="qa-meta"><%= q.comment_count || 0 %> উত্তর &middot; <%= new Date(q.created_at).toLocaleDateString('bn-BD') %></div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Tab: Comments -->
        <div class="tab-content" id="tab-comments">
          <% if (comments.length === 0) { %>
            <div class="empty-state card"><i class="far fa-comment"></i><p>কোনো মন্তব্য নেই।</p></div>
          <% } else { %>
            <% comments.forEach(c => { %>
              <div class="qa-card card">
                <p class="comment-excerpt"><%= c.body.substring(0, 180) %><%= c.body.length > 180 ? '…' : '' %></p>
                <div class="qa-meta">
                  <span class="badge badge-muted"><%= c.post_type === 'question' ? 'প্রশ্নে' : 'লেখায়' %></span>
                  <a href="<%= c.post_type === 'question' ? '/qa/' + c.post_id : '/articles/' + c.post_id %>"><%= c.post_title %></a>
                  &middot; <%= new Date(c.created_at).toLocaleDateString('bn-BD') %>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Tab: Reactions -->
        <div class="tab-content" id="tab-reactions">
          <% const emo = REACTION_META; %>
          <% if (reactions.length === 0) { %>
            <div class="empty-state card"><i class="far fa-heart"></i><p>কোনো প্রতিক্রিয়া দেওয়া হয়নি।</p></div>
          <% } else { %>
            <% reactions.forEach(r => { %>
              <div class="qa-card card">
                <div class="qa-meta">
                  <span class="badge"><%= emo[r.reaction_type || 'like'].emoji %> <%= emo[r.reaction_type || 'like'].label %></span>
                  <span><i class="far fa-clock"></i> <%= new Date(r.created_at).toLocaleDateString('bn-BD') %></span>
                </div>
                <div class="qa-q"><a href="<%= r.post_type === 'question' ? '/qa/' + r.post_id : '/articles/' + r.post_id %>"><%= r.title %></a></div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Tab: Followers (manageable by owner) -->
        <div class="tab-content" id="tab-followers">
          <% if (followers.length === 0) { %>
            <div class="empty-state card"><i class="fas fa-users"></i><p>কোনো অনুসরণকারী নেই।</p></div>
          <% } else { %>
            <% if (isOwner) { %><p class="manage-hint"><i class="fas fa-sliders-h"></i> আপনার অনুসরণকারী ব্যবস্থাপনা, সরান বা ব্লক করুন</p><% } %>
            <% followers.forEach(f => { %>
              <div class="user-row card">
                <a href="/profile/<%= f.username %>" class="side-user-main">
                  <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="side-avatar" alt="">
                  <span><strong><%= f.full_name %></strong><small>@<%= f.username %></small></span>
                </a>
                <% if (isOwner) { %>
                  <span class="user-row-actions">
                    <button type="button" class="btn btn-ghost btn-sm remove-follower" data-user="<%= f.id %>" title="অনুসরণকারী সরান"><i class="fas fa-user-minus"></i> সরান</button>
                    <button type="button" class="btn btn-danger btn-sm block-user" data-user="<%= f.id %>" title="ব্লক করুন"><i class="fas fa-ban"></i></button>
                  </span>
                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Tab: Following -->
        <div class="tab-content" id="tab-following">
          <% if (following.length === 0) { %>
            <div class="empty-state card"><i class="fas fa-user-friends"></i><p>কাউকে অনুসরণ করছেন না।</p></div>
          <% } else { %>
            <% following.forEach(f => { %>
              <div class="user-row card">
                <a href="/profile/<%= f.username %>" class="side-user-main">
                  <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="side-avatar" alt="">
                  <span><strong><%= f.full_name %></strong><small>@<%= f.username %></small></span>
                </a>
              </div>
            <% }); %>
          <% } %>
        </div>

        <% if (isOwner) { %>
        <!-- Tab: Bookmarks (owner only) -->
        <div class="tab-content" id="tab-bookmarks">
          <% if (bookmarks.length === 0) { %>
            <div class="empty-state card"><i class="fas fa-bookmark"></i><p>কোনো সংরক্ষিত পোস্ট নেই।</p></div>
          <% } else { %>
            <% bookmarks.forEach(b => { %>
              <div class="qa-card card">
                <div class="qa-q"><a href="<%= b.type === 'question' ? '/qa/' + b.id : '/articles/' + b.id %>"><%= b.title %></a></div>
                <div class="qa-meta"><span class="badge"><%= b.type === 'question' ? 'প্রশ্ন' : 'লেখা' %></span> সংরক্ষিত <%= new Date(b.bookmarked_at).toLocaleDateString('bn-BD') %></div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Tab: Drafts + content management (owner only) -->
        <div class="tab-content" id="tab-drafts">
          <p class="manage-hint"><i class="fas fa-layer-group"></i> আমার কন্টেন্ট ব্যবস্থাপনা</p>
          <% if (drafts.length === 0 && myDaily.length === 0) { %>
            <div class="empty-state card"><i class="fas fa-file"></i><p>কোনো ড্রাফট বা শিডিউল করা কন্টেন্ট নেই।</p></div>
          <% } %>
          <% drafts.forEach(d => { %>
            <div class="qa-card card">
              <div class="qa-q"><%= d.title || 'শিরোনামহীন ড্রাফট' %></div>
              <div class="qa-meta">
                <span class="badge badge-muted"><%= d.type === 'question' ? 'প্রশ্ন ড্রাফট' : 'লেখা ড্রাফট' %></span>
                <%= new Date(d.created_at).toLocaleDateString('bn-BD') %>
              </div>
            </div>
          <% }); %>
          <% myDaily.forEach(d => { %>
            <div class="qa-card card">
              <div class="qa-q"><%= d.title || '(শিরোনাম নেই)' %></div>
              <div class="qa-meta">
                <span class="badge <%= d.published ? '' : 'badge-muted' %>"><%= d.published ? 'প্রকাশিত' : 'শিডিউল' %></span>
                <%= d.content_type %><% if (d.scheduled_date) { %> &middot; <%= d.scheduled_date %><% } %>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Tab: Categories (owner only) -->
        <div class="tab-content" id="tab-categories">
          <p class="manage-hint"><i class="fas fa-tags"></i> আগ্রহের বিষয় নির্বাচন করুন, এগুলো আপনার ফিড ব্যক্তিগত করবে</p>
          <div class="card interest-picker">
            <div class="tag-cloud" id="interestPool">
              <% tagPool.forEach(t => { %>
                <button type="button" class="tag-chip interest-opt <%= interests.includes(t.tag) ? 'selected' : '' %>" data-tag="<%= t.tag %>">#<%= t.tag %></button>
              <% }); %>
              <% if (tagPool.length === 0) { %><span class="side-text">এখনো কোনো ট্যাগ পুল নেই।</span><% } %>
            </div>
            <button type="button" class="btn btn-primary" id="saveInterests"><i class="fas fa-save"></i> সংরক্ষণ করুন</button>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('../partials/share-modal') %>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script>
    // Tabs
    document.querySelectorAll('.tab-btn, .tab-jump').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        const target = btn.dataset.tab;
        const tb = document.querySelector('.tab-btn[data-tab="' + target + '"]');
        if (tb) tb.classList.add('active');
        document.getElementById('tab-' + target)?.classList.add('active');
      });
    });

    // Follow / unfollow
    document.querySelector('.btn-follow')?.addEventListener('click', async function () {
      const res = await fetch('/follow/' + this.dataset.user, { method: 'POST' });
      const data = await res.json();
      if (data.following) {
        this.classList.remove('btn-primary'); this.classList.add('btn-ghost');
        this.innerHTML = '<i class="fas fa-check"></i> অনুসরণ করছেন';
      } else {
        this.classList.add('btn-primary'); this.classList.remove('btn-ghost');
        this.innerHTML = '<i class="fas fa-plus"></i> অনুসরণ করুন';
      }
    });

    <% if (isOwner) { %>
    // Remove follower
    document.querySelectorAll('.remove-follower').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('এই অনুসরণকারীকে সরাতে চান?')) return;
        const res = await fetch('/api/followers/' + btn.dataset.user + '/remove', { method: 'POST' });
        if (res.ok) btn.closest('.user-row').remove();
      });
    });
    // Block user
    document.querySelectorAll('.block-user').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('এই ব্যবহারকারীকে ব্লক করতে চান? দুই দিক থেকেই ফলো বাতিল হবে।')) return;
        const res = await fetch('/api/block/' + btn.dataset.user, { method: 'POST' });
        const data = await res.json();
        if (data.ok && data.blocked) showToast('ব্যবহারকারী ব্লক করা হয়েছে', 'success');
        btn.closest('.user-row')?.remove();
      });
    });
    // Interest picker
    document.querySelectorAll('.interest-opt').forEach(chip => {
      chip.addEventListener('click', () => chip.classList.toggle('selected'));
    });
    document.getElementById('saveInterests')?.addEventListener('click', async function () {
      const tags = [...document.querySelectorAll('.interest-opt.selected')].map(c => c.dataset.tag);
      const res = await fetch('/api/me/interests', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tags })
      });
      if (res.ok) { showToast('আগ্রহের বিষয় সংরক্ষিত হয়েছে', 'success'); setTimeout(() => location.reload(), 800); }
    });
    <% } %>
  </script>

<script>
function toggleProfile3Dot(e) {
  e.stopPropagation();
  const m = document.getElementById('profile3DotMenu');
  m.classList.toggle('open');
}
document.addEventListener('click', function(e) {
  if (!e.target.closest('.profile-3dot-wrap')) {
    document.getElementById('profile3DotMenu')?.classList.remove('open');
  }
});
</script>

<script>
function togglePost3Dot(e, id) {
  e.stopPropagation();
  e.preventDefault();
  const m = document.getElementById('post3dot-' + id);
  // Close others
  document.querySelectorAll('.post-3dot-menu.open').forEach(x => { if (x.id !== 'post3dot-' + id) x.classList.remove('open'); });
  m.classList.toggle('open');
}
document.addEventListener('click', function(e) {
  if (!e.target.closest('.post-3dot-wrap')) {
    document.querySelectorAll('.post-3dot-menu.open').forEach(x => x.classList.remove('open'));
  }
});
function sharePost(id) {
  const url = window.location.origin + '/articles/' + id;
  if (navigator.share) {
    navigator.share({ title: 'লেখক ফোরাম', url: url });
  } else {
    navigator.clipboard.writeText(url);
    alert('লিংক কপি হয়েছে');
  }
}
</script>
</body>
</html>
