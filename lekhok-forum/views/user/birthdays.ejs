<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%# সেশন ৭৬: কাউন্টডাউন-চিপ + বয়স + 'এই সপ্তাহে' হাইলাইট; ডুপ্লিকেট পদবি-রেন্ডার ফিক্স %>
<%- include('../partials/header', { title: 'জন্মদিনের শুভেচ্ছা | লেখক ফোরাম' }) %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-birthday-cake"></i> জন্মদিনের শুভেচ্ছা</h1>
      <span class="today-date"><i class="far fa-calendar"></i> <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    </div>

    <% if (todayList.length > 0) { %>
      <div class="birthdays-today">
        <h2 class="birthday-section-title">আজকের জন্মদিন 🎂</h2>
        <div class="birthday-list">
          <% todayList.forEach(m => { %>
            <div class="birthday-card is-today">
              <img loading="lazy" decoding="async" src="<%= m.avatar_url || '/avatar/' + m.id %>" class="birthday-avatar" alt="<%= m.full_name %>">
              <div class="birthday-info">
                <h3><%= m.full_name %></h3>
                <p class="birthday-desig"><%= m.designation || 'সদস্য' %></p>
                <div class="birthday-chips">
                  <span class="bd-chip bd-chip--today"><i class="fas fa-star"></i> আজ জন্মদিন</span>
                  <% if (m.age) { %><span class="bd-chip bd-chip--age"><i class="fas fa-hourglass-half"></i> আজ <%= String(m.age).replace(/\d/g, function(d){ return '০১২৩৪৫৬৭৮৯'[d]; }) %> বছর পূর্ণ করছেন</span><% } %>
                </div>
              </div>
              <div class="birthday-cake">🎂</div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state-full"><i class="fas fa-birthday-cake"></i><p>আজ কারো জন্মদিন নেই।</p></div>
    <% } %>

    <% if (upcoming.length > 0) { %>
      <h2 class="birthday-section-title" style="margin-top:40px"><i class="far fa-calendar-plus" style="color:#059669;margin-right:6px"></i> আসন্ন জন্মদিন</h2>
      <div class="birthday-list upcoming">
        <% upcoming.forEach(m => { %>
          <div class="birthday-card small <%= m.this_week ? 'is-soon' : '' %>">
            <img loading="lazy" decoding="async" src="<%= m.avatar_url || '/avatar/' + m.id %>" class="birthday-avatar" alt="<%= m.full_name %>">
            <div class="birthday-info">
              <h3><%= m.full_name %></h3>
              <p class="birthday-desig"><%= m.designation || 'সদস্য' %></p>
              <div class="birthday-chips">
                <% if (m.date_bn) { %><span class="bd-chip bd-chip--date"><i class="far fa-calendar"></i> <%= m.date_bn %></span><% } %>
                <span class="bd-chip <%= m.this_week ? 'bd-chip--soon' : 'bd-chip--count' %>">
                  <% if (m.days_until === 1) { %><i class="fas fa-bolt"></i> আগামীকাল
                  <% } else { %><i class="far fa-clock"></i> <%= String(m.days_until).replace(/\d/g, function(d){ return '০১২৩৪৫৬৭৮৯'[d]; }) %> দিন পরে<% } %>
                </span>
                <% if (m.age) { %><span class="bd-chip bd-chip--age"><i class="fas fa-hourglass-half"></i> <%= String(m.age).replace(/\d/g, function(d){ return '০১২৩৪৫৬৭৮৯'[d]; }) %> হবেন</span><% } %>
              </div>
            </div>
            <% if (m.this_week) { %><div class="birthday-cake soon">🎈</div><% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state-full" style="margin-top:24px"><i class="far fa-calendar-plus"></i><p>আসন্ন কোনো জন্মদিন তালিকাভুক্ত নেই।</p></div>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
