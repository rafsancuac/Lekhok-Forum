<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'অভিযোগ — মডারেটর প্যানেল', extra_css: ['/assets/css/dashboard.css'] }) %>
<style>
    .mod-wrap { max-width: 760px; margin: 20px auto; padding: 0 16px; }
    .complaint-card { background:#fff; border-radius:10px; padding:16px; margin-bottom:14px; }
    .status-badge { padding: 3px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
    .status-new { background: #fee2e2; color: #b91c1c; }
    .status-in_progress { background: #fef9c3; color: #854d0e; }
    .status-resolved { background: #dcfce7; color: #166534; }
  </style>
  <div class="mod-wrap">
    <p><a href="/moderator"><i class="fas fa-arrow-right"></i> মডারেটর প্যানেলে ফিরুন</a></p>
    <h2><i class="fas fa-flag"></i> অভিযোগসমূহ (প্রাইভেট)</h2>
    <p style="color:#666;">এই তালিকা শুধু এডমিন ও অনুমোদিত মডারেটররাই দেখতে পান।</p>
    <% if (items.length === 0) { %><p style="color:#999;">কোনো অভিযোগ নেই।</p><% } %>
    <% items.forEach(c => { %>
      <div class="complaint-card">
        <div style="display:flex; justify-content:space-between;">
          <strong><%= c.subject %></strong>
          <span class="status-badge status-<%= c.status %>"><%= c.status %></span>
        </div>
        <p style="color:#666; font-size:0.9rem; margin:6px 0;"><%= c.full_name %> (@<%= c.username %>) — <%= new Date(c.created_at).toLocaleString('bn-BD') %></p>
        <% if (c.body) { %><p><%= c.body %></p><% } %>
        <% if (c.file_url) { %><p><a href="<%= c.file_url %>" target="_blank"><i class="fas fa-paperclip"></i> <%= c.file_name || 'সংযুক্ত ফাইল' %></a></p><% } %>
        <form method="POST" action="/moderator/complaints/<%= c.id %>/status" style="margin-top:10px; display:flex; gap:8px;">
          <select name="status" style="padding:6px 10px; border-radius:6px; border:1px solid #ddd;">
            <option value="new" <%= c.status === 'new' ? 'selected' : '' %>>নতুন</option>
            <option value="in_progress" <%= c.status === 'in_progress' ? 'selected' : '' %>>প্রক্রিয়াধীন</option>
            <option value="resolved" <%= c.status === 'resolved' ? 'selected' : '' %>>সমাধান হয়েছে</option>
          </select>
          <input type="text" name="admin_notes" value="<%= c.admin_notes || '' %>" placeholder="নোট" style="flex:1; padding:6px 10px; border-radius:6px; border:1px solid #ddd;">
          <button class="btn btn-primary btn-sm" type="submit">আপডেট</button>
        </form>
      </div>
    <% }) %>
  </div>
  <script src="/assets/js/main.js"></script>
</body>
</html>
