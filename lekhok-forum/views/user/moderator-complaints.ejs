<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>অভিযোগ | মডারেটর প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body>
<%- include('../../admin/views/admin/partials/sidebar') %>
<div class="admin-main">
<div class="mod-wrap">
    <p><a href="/moderator"><i class="fas fa-arrow-right"></i> মডারেটর প্যানেলে ফিরুন</a></p>
    <h2><i class="fas fa-flag"></i> অভিযোগসমূহ (প্রাইভেট)<label style="font-size:.85rem;font-weight:600;color:#65676b;display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-left:10px;"><input type="checkbox" data-bulk-all style="width:16px;height:16px;"> সব সিলেক্ট</label></h2>
  <form method="POST" action="/moderator/complaints/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড অভিযোগগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
  </form>

    <p style="color:#666;">এই তালিকা শুধু এডমিন ও অনুমোদিত মডারেটররাই দেখতে পান।</p>
    <% if (items.length === 0) { %><p style="color:#999;">কোনো অভিযোগ নেই।</p><% } %>
    <% items.forEach(c => { %>
      <div class="complaint-card">
        <input type="checkbox" name="bulk_ids" value="<%= c.id %>" aria-label="সিলেক্ট" style="width:16px;height:16px;flex-shrink:0;margin-bottom:8px;">
        <div style="display:flex; justify-content:space-between;">
          <strong><%= c.subject %></strong>
          <span class="status-badge status-<%= c.status %>"><%= c.status %></span>
        </div>
        <p style="color:#666; font-size:0.9rem; margin:6px 0;"><%= c.full_name %> (@<%= c.username %>), <%= new Date(c.created_at).toLocaleString('bn-BD') %></p>
        <% if (c.body) { %><p><%= c.body %></p><% } %>
        <% if (c.file_url) { %><p><a href="<%= c.file_url %>" target="_blank"><i class="fas fa-paperclip"></i> <%= c.file_name || 'সংযুক্ত ফাইল' %></a></p><% } %>
        <form method="POST" action="/moderator/complaints/<%= c.id %>/status" style="margin-top:10px; display:flex; gap:8px;">
          <select name="status" style="padding:6px 10px; border-radius:5px; border:1px solid #ddd;">
            <option value="new" <%= c.status === 'new' ? 'selected' : '' %>>নতুন</option>
            <option value="in_review" <%= c.status === 'in_review' ? 'selected' : '' %>>পর্যালোচনাধীন</option>
            <option value="resolved" <%= c.status === 'resolved' ? 'selected' : '' %>>সমাধান হয়েছে</option>
            <option value="dismissed" <%= c.status === 'dismissed' ? 'selected' : '' %>>বাতিল</option>
          </select>
          <input type="text" name="admin_notes" value="<%= c.admin_notes || '' %>" placeholder="নোট" style="flex:1; padding:6px 10px; border-radius:5px; border:1px solid #ddd;">
          <button class="btn btn-primary btn-sm" type="submit">আপডেট</button>
        </form>
      </div>
    <% }) %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
