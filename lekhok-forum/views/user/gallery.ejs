<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'গ্যালারি — বাংলাদেশ তরুণ কলাম লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css'] }) %>

  <div class="gallery-wrap">
    <div class="page-header">
      <h1><i class="fas fa-images"></i> গ্যালারি</h1>
      <p class="header-sub">সংগঠনের সেরা মুহূর্তগুলো</p>
    </div>

    <% if (Object.keys(byCategory).length === 0) { %>
      <div class="empty-state-full">
        <i class="fas fa-images"></i>
        <p>এখনো কোনো ছবি যোগ করা হয়নি।</p>
      </div>
    <% } else { %>
      <% Object.keys(byCategory).forEach(cat => { %>
        <div class="gallery-section">
          <h2><%= { general:'সাধারণ', event:'ইভেন্ট', events:'ইভেন্ট', seminar:'সেমিনার', seminars:'সেমিনার', workshop:'কর্মশালা', workshops:'কর্মশালা', meeting:'সভা', meetings:'সভা', award:'পুরস্কার', awards:'পুরস্কার', press:'প্রেস ও মিডিয়া', media:'প্রেস ও মিডিয়া', cultural:'সাংস্কৃতিক', sports:'ক্রীড়া', achievement:'অর্জন', achievements:'অর্জন', others:'অন্যান্য' }[cat] || cat %></h2>
          <div class="gallery-grid">
            <% byCategory[cat].forEach(item => { %>
              <div class="gallery-card">
                <img src="<%= item.image_url %>" alt="<%= item.title || 'gallery' %>" class="gallery-img" loading="lazy">
                <div class="gallery-caption">
                  <h3><%= item.title || 'ছবি' %></h3>
                  <p><%= item.caption || '' %></p>
                  <small><%= new Date(item.created_at).toLocaleDateString('bn-BD') %></small>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
