<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'গ্যালারি — লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css'] }) %>

  <div class="gallery-wrap">
    <div class="page-header">
      <h1><i class="fas fa-images"></i> গ্যালারি</h1>
      <p class="header-sub">সংগঠনের সেরা মুহূর্তগুলো</p>
    </div>

    <% if (Object.keys(byCategory).length === 0) { %>
      <div class="empty-state-full">
        <i class="fas fa-images"></i>
        <p>এখনো কোনো ছবি যোগ করা হয়নি।</p>
      </div>
    <% } else { %>
      <% Object.keys(byCategory).forEach(cat => { %>
        <div class="gallery-section">
          <h2><%= cat === 'general' ? 'সাধারণ' : cat === 'events' ? 'ইভেন্ট' : cat === 'meetings' ? 'সভা' : cat === 'awards' ? 'পুরস্কার' : cat === 'workshops' ? 'কর্মশালা' : cat %></h2>
          <div class="gallery-grid">
            <% byCategory[cat].forEach(item => { %>
              <div class="gallery-card">
                <img src="<%= item.image_url %>" alt="<%= item.title || 'gallery' %>" class="gallery-img" loading="lazy">
                <div class="gallery-caption">
                  <h3><%= item.title || 'ছবি' %></h3>
                  <p><%= item.caption || '' %></p>
                  <small><%= new Date(item.created_at).toLocaleDateString('bn-BD') %></small>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
  <script src="/assets/js/main.js"></script>
</body>
</html>
