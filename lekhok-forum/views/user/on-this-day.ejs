<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'আজকের এই দিনে | লেখক ফোরাম' }) %>
  <div class="page-wrap" style="max-width:700px">
    <div class="page-header">
      <h1><i class="fas fa-calendar-day"></i> আজকের এই দিনে</h1>
      <span class="today-date"><i class="far fa-calendar"></i> <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    </div>

    <% if (today) { %>
      <div class="daily-card history-card">
        <div class="daily-card-badge history"><i class="fas fa-history"></i> ইতিহাস</div>
        <h2><%= today.title %></h2>
        <% if (today.image_url) { %>
          <img loading="lazy" decoding="async" src="<%= today.image_url %>" alt="image" style="max-width:100%;border-radius:8px;margin:12px 0">
        <% } %>
        <p class="daily-body"><%= today.body %></p>
        <div class="daily-meta">প্রকাশ: <%= new Date(today.created_at).toLocaleDateString('bn-BD') %></div>
      </div>
    <% } else { %>
      <div class="empty-state-full">
        <i class="fas fa-calendar-day"></i>
        <p>আজকের জন্য কোনো তথ্য নেই।</p>
      </div>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
