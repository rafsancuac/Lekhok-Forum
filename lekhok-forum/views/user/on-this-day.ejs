<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'আজকের এই দিনে | লেখক ফোরাম' }) %>
  <div class="page-wrap" style="max-width:700px">
    <div class="page-header">
      <h1><i class="fas fa-calendar-day"></i> আজকের এই দিনে</h1>
      <span class="today-date"><i class="far fa-calendar"></i> <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    </div>

    <% if (today) { %>
      <div class="daily-card history-card">
        <div class="daily-card-badge history"><i class="fas fa-history"></i> ইতিহাস</div>
        <h2><%= today.title %></h2>
        <% if (today.images && today.images.length) { %>
          <div style="margin:12px 0;"><%- include('../partials/post-gallery', { images: today.images, alt: today.title, height: '300px', group: 'otd-' + today.id }) %></div>
        <% } %>
        <p class="daily-body"><%= today.body %></p>
        <div class="daily-meta">প্রকাশ: <%= new Date(today.created_at).toLocaleDateString('bn-BD') %></div>
      </div>
    <% } else { %>
      <div class="empty-state-full">
        <i class="fas fa-calendar-day"></i>
        <p>আজকের জন্য কোনো তথ্য নেই।</p>
      </div>
    <% } %>

    <%# ── সেশন ৭৪: পূর্বের 'এই দিনে' আর্কাইভ — রুট এতদিন ৩০টি আইটেম এনে ব্যবহার করত না ── %>
    <% const otArch = (archive || []).filter(a => !today || a.id !== today.id); %>
    <% if (otArch.length) { %>
      <section class="daily-archive">
        <div class="section-head">
          <h2 class="section-title"><i class="fas fa-clock-rotate-left"></i> আগের দিনগুলোতে ইতিহাস</h2>
          <span class="daily-arch-count"><%= otArch.length %>টি দিন</span>
        </div>
        <div class="daily-arch-list">
          <% otArch.forEach(function(it, i) { %>
            <details class="daily-arch-item history-arch"<%= i === 0 && !today ? ' open' : '' %>>
              <summary>
                <span class="da-date"><i class="far fa-calendar"></i> <%= new Date(it.scheduled_date || it.created_at).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                <span class="da-title"><%= it.title %></span>
                <i class="fas fa-chevron-down da-chev"></i>
              </summary>
              <div class="da-body">
                <% if (it.images && it.images.length) { %>
                  <div class="da-thumbs">
                    <% it.images.slice(0, 3).forEach(function(src) { %>
                      <img src="<%= src %>" alt="<%= it.title %>" loading="lazy" class="da-thumb" />
                    <% }) %>
                  </div>
                <% } %>
                <p class="da-text"><%= it.body %></p>
              </div>
            </details>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <script src="/assets/js/post-gallery.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
