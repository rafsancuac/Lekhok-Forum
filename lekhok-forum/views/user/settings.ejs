<%# সেশন ১৪২ — সেটিংস ও গোপনীয়তা: ফেসবুক-ঘরানার মাস্টার-ডিটেইল পুনর্নির্মাণ
    বাঁয়ে সার্চযোগ্য ৫-গ্রুপ মেনু, ডানে প্যানে → সাব-মেনু → ডিটেইল দুই-স্তর নেভিগেশন।
    সব পুরনো ফর্ম-এন্ডপয়েন্ট/ফিল্ড-নাম/CSRF অক্ষুণ্ণ; পুরনো হ্যাশ (#account, #privacy)
    কম্প্যাট-ম্যাপে নতুন সেকশনে ম্যাপ করা। স্কিন: settings.css (শুধু --lf-* টোকেন) %>
<%- include('../partials/header', { title: 'সেটিংস ও গোপনীয়তা | লেখক ফোরাম', extra_css: ['/assets/css/settings.css'] }) %>

<%# বাংলা-অঙ্ক: ক্যানোনিকাল toBn (session150, helpers/bn-number.js) ব্যবহার; ফলব্যাকসহ %>
<% var bn142 = (typeof toBn === 'function') ? toBn : function (n) { return String(n == null ? 0 : n).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; }); }; %>

<div class="st142-wrap">
  <div class="st142-topbar">
    <a href="/me" class="st142-backlink"><i class="fas fa-arrow-left"></i> ফিডে ফিরুন</a>
    <h1>সেটিংস ও গোপনীয়তা</h1>
    <% if (ok) { %>
      <span class="badge save-ok"><i class="fas fa-check"></i>
        <%= ok === 'unblocked' ? 'ব্লক সরানো হয়েছে' : ok === 'session_revoked' ? 'ডিভাইস লগআউট হয়েছে' : ok === 'sessions_revoked' ? 'অন্য সব ডিভাইস লগআউট হয়েছে' : ok === 'profile' ? 'প্রোফাইল সংরক্ষিত হয়েছে' : ok === 'privacy' ? 'গোপনীয়তা সংরক্ষিত হয়েছে' : ok === 'notifications' ? 'বিজ্ঞপ্তি-পছন্দ সংরক্ষিত হয়েছে' : ok === 'email_saved' ? 'ইমেইল সংরক্ষিত হয়েছে' : ok === 'password' ? 'পাসওয়ার্ড পরিবর্তন হয়েছে' : ok === 'display' ? 'প্রদর্শন-পছন্দ সংরক্ষিত হয়েছে' : 'সংরক্ষিত' %>
      </span>
    <% } else if (err) { %>
      <span class="badge save-err"><i class="fas fa-exclamation-triangle"></i>
        <%= err === 'delete_password' ? 'পাসওয়ার্ড ভুল — অ্যাকাউন্ট মুছা হয়নি' : err === 'delete_confirm' ? 'নিশ্চিত করতে ঠিক DELETE শব্দটি লিখুন' : err === 'export' ? 'ডেটা এক্সপোর্টে সমস্যা হয়েছে' : err === 'email_password_wrong' ? 'বর্তমান পাসওয়ার্ড ভুল' : err === 'email_invalid' ? 'সঠিক ইমেইল লিখুন' : err === 'email_taken' ? 'ইমেইল অন্য অ্যাকাউন্টে ব্যবহৃত' : err === 'password_mismatch' ? 'নতুন পাসওয়ার্ড দুটি মিলছে না' : err === 'password_short' ? 'পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের হতে হবে' : err === 'password_wrong' ? 'বর্তমান পাসওয়ার্ড ভুল' : err === 'social_bad' ? 'সংযোগ বিচ্ছিন্ন করা যায়নি' : err === 'social_url' ? 'সঠিক http/https লিংক দিন' : 'সমস্যা হয়েছে' %>
      </span>
    <% } %>
  </div>

