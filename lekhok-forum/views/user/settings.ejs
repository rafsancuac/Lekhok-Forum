    <main class="st142-main" id="stMain">

      <!-- ১. ব্যক্তিগত তথ্য ও ছদ্মনাম -->
      <section class="st142-pane on" data-pane="profile" aria-label="ব্যক্তিগত তথ্য ও ছদ্মনাম">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>ব্যক্তিগত তথ্য ও ছদ্মনাম</h2><p>লেখক ফোরামে আপনার পরিচয় ও পরিচিতি — আসল নাম গোপন থাকে, চাইলে কলমী নামে লেখেন।</p></div>
        </div>
        <div class="st142-card">
          <form method="POST" action="/settings/profile" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="field" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label>পুরো নাম</label>
                <input class="input" name="full_name" value="<%= profileUser.full_name %>" required>
                <div class="hint" style="margin-top:6px;">নথি-সদস্যের আসল নাম (গোপন থাকবে)</div>
              </div>
              <div>
                <label>ছদ্মনাম / কলমী নাম (ঐচ্ছিক)</label>
                <input class="input" name="pen_name" value="<%= profileUser.pen_name || '' %>" maxlength="60" placeholder="যেমন: বনফুল, সুনন্দ…">
                <div class="hint">আসল নাম না বাহর করে এই নামেই লেখক-পরিচয় দেখাবে</div>
              </div>
            </div>
            <div class="field">
              <label>পছন্দের সাহিত্য-ধারা <span class="genre-count" id="genreCount"><%= genres.length %>/৫</span></label>
              <div class="genre-chip-wrap" id="genreChips">
                <%
                  const GENRE_LIST_80 = ['কবিতা','ছোটগল্প','উপন্যাস','কল্পবিজ্ঞান','গোয়েন্দা ও থ্রিলার','প্রবন্ধ ও গবেষণা','অনুবাদ সাহিত্য','ভ্রমণকাহিনী','ইতিহাস','নাটক ও নাটিকা','শিশুসাহিত্য'];
                  GENRE_LIST_80.forEach(function (g) { %>
                  <button type="button" class="genre-chip<%= genres.includes(g) ? ' selected' : '' %>" data-genre="<%= g %>"><%= genres.includes(g) ? '✓ ' : '+ ' %><%= g %></button>
                <% }) %>
              </div>
              <input type="hidden" name="genres" id="genreInput" value="<%= JSON.stringify(genres) %>">
              <div class="hint">আপনি কোন ধারার লেখক — প্রোফাইল-পেজে ব্যাজ হিসেবে দেখাবে</div>
            </div>
            <div class="field">
              <label>পরিচিতি (Bio)</label>
              <textarea class="textarea" name="bio" rows="3" placeholder="নিজের সম্পর্কে কিছু লিখুন…"><%= profileUser.bio || '' %></textarea>
              <div class="hint">সর্বোচ্চ ৩০০ অক্ষর</div>
            </div>
            <div class="field">
              <label>পদবি / Designation</label>
              <input class="input" name="designation" value="<%= profileUser.designation || '' %>" placeholder="যেমন: সাহিত্যিক, শিক্ষক…">
            </div>
            <div class="field">
              <label>ঠিকানা</label>
              <input class="input" name="address" value="<%= profileUser.address || '' %>">
            </div>
            <div class="field" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label>লিঙ্গ</label>
                <select class="select" name="gender">
                  <option value="male"   <%= profileUser.gender === 'male'   ? 'selected' : '' %>>পুরুষ</option>
                  <option value="female" <%= profileUser.gender === 'female' ? 'selected' : '' %>>নারী</option>
                  <option value="other"  <%= profileUser.gender === 'other'  ? 'selected' : '' %>>অন্যান্য</option>
                </select>
              </div>
              <div>
                <label>জন্ম তারিখ</label>
                <input class="input" type="date" name="birth_date" value="<%= profileUser.birth_date || '' %>">
              </div>
            </div>
            <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
          </form>
        </div>
      </section>

      <!-- ২. অ্যাকাউন্ট ইমেইল -->
      <section class="st142-pane" data-pane="email" aria-label="অ্যাকাউন্ট ইমেইল">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>অ্যাকাউন্ট ইমেইল</h2><p>ইমেইল-ওটিপি 2FA-র কোড এই ঠিকানায় যায় — সঠিক ও নিজের-নিয়ন্ত্রণে থাকা ইমেইল রাখুন।</p></div>
        </div>
        <div class="st142-card">
          <% if (ok === 'email_saved') { %><div class="badge save-ok"><i class="fas fa-check"></i> ইমেইল সংরক্ষিত হয়েছে।</div><% } %>
          <% if (err === 'email_password_wrong') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> বর্তমান পাসওয়ার্ড ভুল।</div><% } %>
          <% if (err === 'email_invalid') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> সঠিক ইমেইল ঠিকানা লিখুন।</div><% } %>
          <% if (err === 'email_taken') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> এই ইমেইল অন্য কোনো অ্যাকাউন্টে ব্যবহৃত।</div><% } %>
          <form method="POST" action="/settings/account/email">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="field"><label>ইমেইল ঠিকানা</label><input class="input" type="email" name="email" value="<%= profileUser.email || '' %>" placeholder="you@example.com" required></div>
            <div class="field"><label>বর্তমান পাসওয়ার্ড (নিশ্চিতকরণ)</label><input class="input" type="password" name="current_password" required autocomplete="current-password"></div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i> ইমেইল সংরক্ষণ করুন</button>
          </form>
        </div>
      </section>

      <!-- ৩. পাসওয়ার্ড -->
      <section class="st142-pane" data-pane="password" aria-label="পাসওয়ার্ড">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>পাসওয়ার্ড</h2><p>নিয়মিত পাসওয়ার্ড বদলান এবং অন্য কোথাও ব্যবহৃত পাসওয়ার্ড পুনরায় ব্যবহার করবেন না।</p></div>
        </div>
        <div class="st142-card">
          <form method="POST" action="/settings/account/password">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="field"><label>বর্তমান পাসওয়ার্ড</label><input class="input" type="password" name="current_password" required></div>
            <div class="field"><label>নতুন পাসওয়ার্ড</label><input class="input" type="password" name="new_password" required minlength="6"></div>
            <div class="field"><label>পুনরায় নতুন পাসওয়ার্ড</label><input class="input" type="password" name="confirm_password" required minlength="6"></div>
            <button type="submit" class="btn btn-primary">পাসওয়ার্ড পরিবর্তন</button>
          </form>
        </div>
      </section>

      <!-- ৪. নিরাপত্তা ও ২-ফ্যাক্টর (সাব-মেনু সহ) -->
      <section class="st142-pane" data-pane="security" aria-label="নিরাপত্তা ও ২-ফ্যাক্টর">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div>
            <h2>নিরাপত্তা ও ২-ফ্যাক্টর</h2>
            <p>পাসওয়ার্ডের পরে দ্বিতীয় স্তরের যাচাই — লগইনে ৬-অঙ্কের কোড চাওয়া হবে।</p>
          </div>
          <span class="st142-pill <%= totpEnabled ? 'on' : 'off' %>"><i class="fas <%= totpEnabled ? 'fa-shield-halved' : 'fa-shield' %>"></i> <%= totpEnabled ? '2FA সক্রিয়' : '2FA বন্ধ' %></span>
        </div>

        <% if (backupFlash && backupFlash.length) { %>
          <div class="st142-card" style="margin-bottom:14px;">
            <div class="sec-backup-box">
              <h3><i class="fas fa-key"></i> ব্যাকআপ কোড (একবারই দেখানো হয়)</h3>
              <p>ফোন হারিয়ে গেলে বা অ্যাপে ঢুকতে না পারলে লগইনের দ্বিতীয় ধাপে এই কোডগুলোর একটি ব্যবহার করুন। প্রতিটি কোড একবারই কাজ করে, নিরাপদ জায়গায় সংরক্ষণ করুন (লিখে রাখুন বা কপি করে রাখুন)।</p>
              <div class="sec-codes-grid"><% backupFlash.forEach(function (c) { %><div class="sec-code-chip"><%= c %></div><% }) %></div>
              <button type="button" class="btn btn-sm sec-copy-btn" id="secCopyCodes"><i class="fas fa-copy"></i> সব কোড কপি করুন</button>
            </div>
          </div>
        <% } %>

        <% if (secMsg === 'enrolled') { %><div class="badge save-ok"><i class="fas fa-check"></i> 2FA সক্রিয় হয়েছে। উপরের ব্যাকআপ কোডগুলো এখনই সংরক্ষণ করুন।</div><% } %>
        <% if (secMsg === 'disabled') { %><div class="badge save-ok"><i class="fas fa-check"></i> 2FA বন্ধ করা হয়েছে।</div><% } %>
        <% if (secMsg === 'backup') { %><div class="badge save-ok"><i class="fas fa-rotate"></i> নতুন ব্যাকআপ কোড তৈরি হয়েছে। পুরনো কোডগুলো বাতিল।</div><% } %>
        <% if (secMsg === 'email_sent') { %><div class="badge save-ok"><i class="fas fa-envelope"></i> কোড <%= emailMask || 'আপনার ইমেইল' %>-এ পাঠানো হয়েছে (মেয়াদ ৫ মিনিট)। ইনবক্স/স্প্যাম ফোল্ডার দেখুন।</div><% } %>
        <% if (secErr === 'bad_code') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> কোড মিলছে না। অ্যাপে দেখানো বর্তমান ৬-অঙ্কের কোড দিন (৩০ সেকেন্ডে বদলায়)।</div><% } %>
        <% if (secErr === 'no_pending') { %><div class="badge save-err"><i class="fas fa-circle-info"></i> কোনো অপেক্ষমাণ সেটআপ নেই। "2FA চালু করুন" দিয়ে নতুন করে শুরু করুন।</div><% } %>
        <% if (secErr === 'password_wrong') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> বর্তমান পাসওয়ার্ড ভুল।</div><% } %>
        <% if (secErr === 'no_2fa') { %><div class="badge save-err"><i class="fas fa-circle-info"></i> 2FA সক্রিয় নেই।</div><% } %>
        <% if (secErr === 'otp_rate') { %><div class="badge save-err"><i class="fas fa-hourglass-half"></i> খুব দ্রুত আবার-পাঠানোর চেষ্টা — আরও <%= typeof r !== 'undefined' && r ? r : 'কয়েক' %> সেকেন্ড অপেক্ষা করুন।</div><% } %>
        <% if (secErr === 'otp_bad') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> কোড ভুল বা মেয়াদোত্তীর্ণ।<%= typeof left !== 'undefined' && left ? ' আর ' + left + ' বার চেষ্টা করতে পারবেন।' : '' %></div><% } %>
        <% if (secErr === 'no_email') { %><div class="badge save-err"><i class="fas fa-circle-info"></i> ইমেইল-ওটিপির জন্য অ্যাকাউন্টে নিবন্ধিত ইমেইল দরকার — <a href="/settings#email" style="text-decoration:underline;">অ্যাকাউন্ট ইমেইল সেটিংসে যোগ করুন</a>।</div><% } %>
        <% if (secErr === 'email_fail') { %><div class="badge save-err"><i class="fas fa-cloud-arrow-down"></i> ইমেইল পাঠানো যায়নি — কিছুক্ষণ পরে আবার চেষ্টা করুন।</div><% } %>

        <div class="st142-card st142-submenu" style="margin-top:14px;">
          <div class="st142-rows">
            <button type="button" class="st142-row" data-goto="sec-status">
              <span class="st142-ico"><i class="fas fa-shield-halved"></i></span>
              <span class="st142-rmeta"><b>2FA অবস্থা ও মাধ্যম</b><small>সক্রিয়তা দেখুন, অ্যাপ/ইমেইল-ওটিপি মাধ্যম বদলান বা নতুন সেটআপ শুরু করুন</small></span>
              <i class="fas fa-chevron-right st142-rchev"></i>
            </button>
            <button type="button" class="st142-row" data-goto="sec-backup">
              <span class="st142-ico"><i class="fas fa-key"></i></span>
              <span class="st142-rmeta"><b>ব্যাকআপ কোড</b><small>ফোন হারালে কাজের বিমা — নতুন সেট তৈরি করুন (পুরনো বাতিল হবে)</small></span>
              <i class="fas fa-chevron-right st142-rchev"></i>
            </button>
            <button type="button" class="st142-row is-danger" data-goto="sec-off">
              <span class="st142-ico"><i class="fas fa-unlock"></i></span>
              <span class="st142-rmeta"><b>2FA বন্ধ করুন</b><small>পাসওয়ার্ড নিশ্চিত করে দ্বি-স্তর যাচাই বন্ধ করুন</small></span>
              <i class="fas fa-chevron-right st142-rchev"></i>
            </button>
          </div>
          <p class="st142-note"><i class="fas fa-circle-info"></i> দুটো মাধ্যমই সম্পূর্ণ বিনামূল্যের — SMS-গেটওয়ে ফি লাগে না; ব্যাকআপ-কোড দুই মাধ্যমেই কাজ করে।</p>
        </div>

        <div class="st142-detail" data-detail="sec-status">
          <button type="button" class="st142-backbtn"><i class="fas fa-arrow-left"></i> নিরাপত্তা মেনুতে ফিরুন</button>
          <div class="st142-card">
            <% if (totpEnabled && !secPending && !emailPending) { %>
              <div class="sec-status on">
                <span class="sec-status-ico"><i class="fas fa-shield-halved"></i></span>
                <span class="sec-status-meta">
                  <strong>2FA সক্রিয় আছে</strong>
                  <small>লগইনে পাসওয়ার্ডের পরে <%= twofaMethod === 'email' ? 'নিবন্ধিত ইমেইলে পাঠানো' : 'অ্যাপে দেখানো' %> ৬-অঙ্কের কোড চাওয়া হয় — বর্তমান মাধ্যম: <b><%= twofaMethod === 'email' ? 'ইমেইল ওটিপি' : 'অথেনটিকেটর অ্যাপ' %></b>, অ্যাকাউন্ট দ্বি-স্তরে সুরক্ষিত।</small>
                </span>
              </div>
              <h3 style="margin:18px 0 4px;font-size:15px;"><i class="fas fa-right-left"></i> মাধ্যম বদলান</h3>
              <p style="color:var(--text-muted);font-size:13.5px;margin:0 0 10px;">অন্য ফ্রি মাধ্যমে সুইচ করতে এনরোল করুন — কনফার্ম করলেই বর্তমান মাধ্যমের সেটআপ বদলে যাবে (যাচাই শেষ না হওয়া পর্যন্ত বর্তমান মাধ্যমই চলবে)।</p>
              <div class="sec-method-grid">
                <% if (twofaMethod !== 'totp') { %>
                <form method="POST" action="/settings/security/enroll" class="sec-method-card">
                  <span class="sec-mico">🔐</span>
                  <span class="sec-mname">অথেনটিকেটর অ্যাপ</span>
                  <span class="sec-mnote">QR স্ক্যান — প্রতি ৩০ সেকেন্ডে বদলানো কোড</span>
                  <span class="sec-mfree">১০০% ফ্রি ও অফলাইন</span>
                  <button type="submit" class="btn btn-ghost btn-sm sec-mbtn">এই মাধ্যমে সুইচ করুন</button>
                </form>
                <% } %>
                <% if (twofaMethod !== 'email') { %>
                <form method="POST" action="/settings/security/enroll-email" class="sec-method-card">
                  <span class="sec-mico">✉️</span>
                  <span class="sec-mname">ইমেইল ওটিপি</span>
                  <span class="sec-mnote"><%= userEmail || 'নিবন্ধিত ইমেইল' %>-এ ৬-অঙ্কের কোড</span>
                  <span class="sec-mfree blue">বিনামূল্যে (Resend)</span>
                  <button type="submit" class="btn btn-ghost btn-sm sec-mbtn">এই মাধ্যমে সুইচ করুন</button>
                </form>
                <% } %>
              </div>
            <% } else if (emailPending) { %>
              <div class="sec-enroll">
                <div class="sec-status on" style="margin-bottom:16px;">
                  <span class="sec-status-ico"><i class="fas fa-envelope-circle-check"></i></span>
                  <span class="sec-status-meta">
                    <strong>ইমেইলে কোড পাঠানো হয়েছে</strong>
                    <small><%= emailMask || 'আপনার ইমেইল' %> — ইনবক্স বা স্প্যাম ফোল্ডার দেখুন। কোডের মেয়াদ ৫ মিনিট।</small>
                  </span>
                </div>
                <form method="POST" action="/settings/security/confirm-email" class="sec-inline-form">
                  <div class="field"><label>ইমেইলে প্রাপ্ত ৬-অঙ্কের কোড</label><input class="input" type="text" name="email_otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus placeholder="যেমন: ৪৫৮২১৩"></div>
                  <button type="submit" class="btn btn-primary"><i class="fas fa-shield-halved"></i> সক্রিয় করুন</button>
                </form>
                <form method="POST" action="/settings/security/enroll-email" style="margin-top:12px;">
                  <button type="submit" class="btn btn-ghost btn-sm"><i class="fas fa-rotate"></i> কোড আসেনি? আবার পাঠান (৪৫ সেকেন্ড কুলডাউন)</button>
                </form>
              </div>
            <% } else if (secPending) { %>
              <div class="sec-enroll">
                <div class="sec-qr-row">
                  <a href="<%= secOtpauth %>" class="sec-qr-box" title="অথেনটিকেটর অ্যাপে খুলুন">
                    <img src="/settings/security/qr" alt="2FA QR কোড, Google Authenticator-এ স্ক্যান করুন" width="172" height="172" onerror="this.parentElement.style.display='none'">
                  </a>
                  <div class="sec-qr-steps">
                    <p class="sec-step"><span class="sec-step-num">১</span> Google Authenticator / Authy / 1Password-এ <b>+ নতুন অ্যাকাউন্ট</b> → <b>QR স্ক্যান</b> বেছে নিয়ে বাঁয়ের কোড স্ক্যান করুন। স্ক্যান করতে না পারলে "Setup key" অপশনে নিচের সিক্রেটটি বসান।</p>
                    <div class="sec-secret-box"><%= secPending %></div>
                    <p class="sec-step"><span class="sec-step-num">২</span> এরপর অ্যাপে দেখানো <b>বর্তমান</b> ৬-অঙ্কের কোড নিচে দিন, মিললেই 2FA সক্রিয় হয়ে যাবে।</p>
                  </div>
                </div>
                <form method="POST" action="/settings/security/confirm" class="sec-inline-form">
                  <div class="field"><label>৬-অঙ্কের কোড</label><input class="input" type="text" name="totp_code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus placeholder="যেমন: ৪৫৮২১৩"></div>
                  <button type="submit" class="btn btn-primary"><i class="fas fa-shield-halved"></i> সক্রিয় করুন</button>
                </form>
                <p class="hint" style="margin-top:10px;"><i class="fas fa-circle-info"></i> otpauth লিংক (ম্যানুয়াল): <span class="sec-otp"><%= secOtpauth %></span></p>
              </div>
            <% } else { %>
              <div class="sec-status">
                <span class="sec-status-ico"><i class="fas fa-shield"></i></span>
                <span class="sec-status-meta">
                  <strong>2FA সক্রিয় নয়</strong>
                  <small>দ্বি-স্তর যাচাই চালু করে আপনার আইডি আরও সুরক্ষিত করুন — নিচের যেকোনো একটি <b>সম্পূর্ণ বিনামূল্যের</b> মাধ্যম বেছে নিন।</small>
                </span>
              </div>
              <div class="sec-method-grid" style="margin-top:14px;">
                <form method="POST" action="/settings/security/enroll" class="sec-method-card">
                  <span class="sec-mico">🔐</span>
                  <span class="sec-mname">অথেনটিকেটর অ্যাপ (TOTP)</span>
                  <span class="sec-mnote">Google Authenticator / Authy / 1Password-এ QR স্ক্যান করে প্রতি ৩০ সেকেন্ডে বদলানো কোড দিন।</span>
                  <span class="sec-mfree">১০০% ফ্রি ও অফলাইন</span>
                  <button type="submit" class="btn btn-primary btn-sm sec-mbtn"><i class="fas fa-qrcode"></i> সেটআপ শুরু করুন</button>
                </form>
                <form method="POST" action="/settings/security/enroll-email" class="sec-method-card">
                  <span class="sec-mico">✉️</span>
                  <span class="sec-mname">ইমেইল ওটিপি</span>
                  <span class="sec-mnote">নিবন্ধিত ইমেইলে (<%= userEmail || '—' %>) লগইনের সময় ৬-অঙ্কের তাৎক্ষণিক কোড পাঠানো হবে।</span>
                  <span class="sec-mfree blue">বিনামূল্যে (Resend)</span>
                  <button type="submit" class="btn btn-primary btn-sm sec-mbtn"><i class="fas fa-paper-plane"></i> কোড পাঠান</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>

        <div class="st142-detail" data-detail="sec-backup">
          <button type="button" class="st142-backbtn"><i class="fas fa-arrow-left"></i> নিরাপত্তা মেনুতে ফিরুন</button>
          <div class="st142-card">
            <h3 style="margin:0 0 8px;font-size:15px;"><i class="fas fa-rotate"></i> নতুন ব্যাকআপ কোড</h3>
            <p style="color:var(--text-muted);font-size:13.5px;margin:0 0 10px;">পুরনো ব্যাকআপ কোড হারিয়ে গেলে বা শেষ হয়ে গেলে নতুন সেট তৈরি করুন (পুরনোগুলো বাতিল হয়ে যায়)।</p>
            <form method="POST" action="/settings/security/backup-regen" class="sec-inline-form">
              <div class="field"><label>বর্তমান পাসওয়ার্ড</label><input class="input" type="password" name="current_password" required autocomplete="current-password"></div>
              <button type="submit" class="btn btn-primary"><i class="fas fa-rotate"></i> নতুন কোড তৈরি করুন</button>
            </form>
          </div>
        </div>

        <div class="st142-detail" data-detail="sec-off">
          <button type="button" class="st142-backbtn"><i class="fas fa-arrow-left"></i> নিরাপত্তা মেনুতে ফিরুন</button>
          <div class="st142-card">
            <h3 style="margin:0 0 8px;font-size:15px;color:#dc2626;"><i class="fas fa-unlock"></i> 2FA বন্ধ করুন</h3>
            <p style="color:var(--text-muted);font-size:13.5px;margin:0 0 10px;">এতে অ্যাকাউন্ট কম সুরক্ষিত হবে, লগইনে শুধু পাসওয়ার্ড লাগবে। নিশ্চিত হতে বর্তমান পাসওয়ার্ড দিতে হবে।</p>
            <form method="POST" action="/settings/security/disable" class="sec-inline-form" onsubmit="return confirm('2FA বন্ধ করবেন? অ্যাকাউন্ট কম সুরক্ষিত হবে।');">
              <div class="field"><label>বর্তমান পাসওয়ার্ড</label><input class="input" type="password" name="current_password" required autocomplete="current-password"></div>
              <button type="submit" class="btn btn-danger"><i class="fas fa-unlock"></i> 2FA বন্ধ করুন</button>
            </form>
          </div>
        </div>
      </section>

      <!-- ৫. ডিভাইস ও সেশন -->
      <section class="st142-pane" data-pane="sessions" aria-label="ডিভাইস ও সেশন">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>ডিভাইস ও সেশন</h2><p>আপনার অ্যাকাউন্ট কোন কোন ডিভাইসে লগইন করা আছে — চেনা-যায় না এমন ডিভাইস দেখলে সঙ্গে সঙ্গে লগআউট করুন।</p></div>
        </div>
        <div class="st142-card">
          <div class="sess-list">
            <% activeSessions.forEach(function (s) { %>
              <div class="sess-row<%= s.current ? ' current' : '' %>">
                <span class="sess-ico"><i class="fas <%= s.icon %>"></i></span>
                <span class="sess-meta">
                  <strong><%= s.label %><% if (s.current) { %> <span class="sess-badge">এই ডিভাইস</span><% } %></strong>
                  <small>
                    <% if (s.ip) { %>আইপি: <%= s.ip %> · <% } %>
                    <% if (s.loginAt) { %>লগইন: <time data-ts="<%= s.loginAt %>"></time> · <% } %>
                    <% if (s.lastActive) { %>সর্বশেষ সক্রিয়: <time data-ts="<%= s.lastActive %>"></time><% } %>
                  </small>
                </span>
                <% if (!s.current) { %>
                  <form method="POST" action="/settings/sessions/revoke" class="sess-form" data-confirm="এই ডিভাইস থেকে লগআউট করবেন?">
                    <input type="hidden" name="sid" value="<%= s.sid %>">
                    <button type="submit" class="btn btn-ghost btn-sm sess-revoke"><i class="fas fa-right-from-bracket"></i> লগআউট</button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
          <% if (activeSessions.length > 1) { %>
            <form method="POST" action="/settings/sessions/revoke-all" style="margin-top:16px;" data-confirm="অন্য সব ডিভাইস থেকে লগআউট করবেন?">
              <button type="submit" class="btn btn-danger-outline"><i class="fas fa-power-off"></i> অন্য সব ডিভাইস থেকে লগআউট করুন</button>
            </form>
          <% } %>
        </div>
      </section>

      <!-- ৬. বিপজ্জনক অঞ্চল -->
      <section class="st142-pane" data-pane="danger" aria-label="বিপজ্জনক অঞ্চল">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>বিপজ্জনক অঞ্চল</h2><p>এই কার্যগুলো ফিরিয়ে আনা যাবে না — আগে "আপনার কার্যক্রম" থেকে লেখার ব্যাকআপ নিয়ে নিন।</p></div>
        </div>
        <div class="st142-card">
          <form method="POST" action="/settings/account/deactivate" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="btn btn-danger"><i class="fas fa-pause"></i> অ্যাকাউন্ট নিষ্ক্রিয় করুন</button>
          </form>

          <div class="dz-card danger" style="margin-top:16px;">
            <div class="dz-meta">
              <strong>অ্যাকাউন্ট স্থায়ীভাবে মুছে ফেলুন</strong>
              <span>প্রোফাইল, সব লেখা, মন্তব্য, বার্তা চিরতরে মুছে যাবে। নিচে পাসওয়ার্ড দিয়ে <b>DELETE</b> লিখে নিশ্চিত করুন।</span>
            </div>
            <div class="dz-del-form">
              <input class="input" type="password" name="current_password" placeholder="বর্তমান পাসওয়ার্ড" required autocomplete="current-password">
              <input class="input dz-del-confirm" type="text" placeholder="নিশ্চিত করতে DELETE লিখুন" required autocomplete="off" style="text-transform:uppercase;">
              <button type="button" class="btn btn-danger"><i class="fas fa-trash-can"></i> চিরতরে মুছুন</button>
            </div>
            <form method="POST" action="/settings/account/delete" id="permDeleteForm80" hidden>
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"></form>
          </div>
        </div>
      </section>

      <!-- ৭. বিজ্ঞপ্তি -->
      <section class="st142-pane" data-pane="notifications" aria-label="বিজ্ঞপ্তি">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>বিজ্ঞপ্তি</h2><p>কোন ঘটনায় ইন-অ্যাপ বা ইমেইল-নোটিফিকেশন পাবেন — অপ্রয়োজনীয়গুলো বন্ধ রাখুন।</p></div>
        </div>
        <div class="st142-card">
          <%
            const np80 = notifyPrefs || {};
            const inAppDef = function (k, legacy) { return np80[k] !== undefined ? !!np80[k] : (legacy !== undefined ? !!legacy : true); };
            const emailDef = function (k, legacy) { return np80[k] !== undefined ? !!np80[k] : (legacy !== undefined ? !!legacy : false); };
          %>
          <form method="POST" action="/settings/notifications">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="notif-matrix">
              <div class="nm-head">
                <div>ঘটনা</div><div><i class="fas fa-desktop"></i> ইন-অ্যাপ</div><div><i class="fas fa-envelope"></i> ইমেইল</div>
              </div>
              <label class="nm-row">
                <span class="nm-event"><strong>লেখায় প্রতিক্রিয়া</strong><small>কেউ আপনার লেখায় লাইক/ভালোবাসা দিলে</small></span>
                <input type="checkbox" name="notify_reactions" value="1" <%= inAppDef('notify_reactions', np80.push_like) ? 'checked' : '' %>>
                <input type="checkbox" name="email_reactions" value="1" <%= emailDef('email_reactions') ? 'checked' : '' %>>
              </label>
              <label class="nm-row">
                <span class="nm-event"><strong>নতুন মন্তব্য ও মেনশন</strong><small>পোস্টে মন্তব্য বা @উল্লেখ হলে</small></span>
                <input type="checkbox" name="notify_comments" value="1" <%= inAppDef('notify_comments') ? 'checked' : '' %>>
                <input type="checkbox" name="email_comment" value="1" <%= emailDef('email_comment', np80.email_comment) ? 'checked' : '' %>>
              </label>
              <label class="nm-row">
                <span class="nm-event"><strong>নতুন অনুসরণকারী</strong><small>কেউ আপনাকে ফলো করা শুরু করলে</small></span>
                <input type="checkbox" name="notify_follows" value="1" <%= inAppDef('notify_follows') ? 'checked' : '' %>>
                <input type="checkbox" name="email_follows" value="1" <%= emailDef('email_follows') ? 'checked' : '' %>>
              </label>
              <label class="nm-row">
                <span class="nm-event"><strong>প্রাইভেট বার্তা</strong><small>ইনবক্সে নতুন বার্তা এলে</small></span>
                <input type="checkbox" name="notify_messages" value="1" <%= inAppDef('notify_messages') ? 'checked' : '' %>>
                <input type="checkbox" name="email_messages" value="1" <%= emailDef('email_messages') ? 'checked' : '' %>>
              </label>
              <label class="nm-row">
                <span class="nm-event"><strong>সাপ্তাহিক সাহিত্য-ডাইজেস্ট</strong><small>ফোরামের সেরা নির্বাচিত লেখার ইমেইল-সংকলন</small></span>
                <span class="nm-dash">—</span>
                <input type="checkbox" name="weekly_digest" value="1" <%= np80.weekly_digest !== undefined ? (np80.weekly_digest ? 'checked' : '') : (np80.daily_digest ? 'checked' : '') %>>
              </label>
            </div>
            <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
          </form>
        </div>
      </section>

      <!-- ৮. প্রদর্শন ও ডার্ক মোড -->
      <section class="st142-pane" data-pane="display" aria-label="প্রদর্শন ও ডার্ক মোড">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>প্রদর্শন ও ডার্ক মোড</h2><p>থিম, ফন্ট ও লাইন-স্পেসিং — পড়ার আরাম নিজের চোখের মতো সাজান।</p></div>
        </div>
        <div class="st142-card">
          <form method="POST" action="/settings/display">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="field">
              <label>থিম</label>
              <select class="select" name="theme">
                <option value="auto" <%= (displayPrefs.theme || 'auto') === 'auto' ? 'selected' : '' %>>অটো (সিস্টেম অনুসারে)</option>
                <option value="light" <%= displayPrefs.theme === 'light' ? 'selected' : '' %>>হালকা</option>
                <option value="dark" <%= displayPrefs.theme === 'dark' ? 'selected' : '' %>>গাঢ়</option>
                <option value="sepia" <%= displayPrefs.theme === 'sepia' ? 'selected' : '' %>>সেপিয়া (বইয়ের পাতার আভা)</option>
              </select>
            </div>
            <div class="field">
              <label>ফন্ট স্টাইল</label>
              <select class="select" name="font_family">
                <option value="bn"       <%= (displayPrefs.font_family || 'bn') === 'bn'       ? 'selected' : '' %>>হিন্দ সিলিগুড়ি (সহজ, পড়ার জন্য আদর্শ)</option>
                <option value="serif"    <%= displayPrefs.font_family === 'serif'             ? 'selected' : '' %>>লিপি মল্লিকা (ক্লাসিক বাংলা সিরিফ)</option>
                <option value="sans"     <%= displayPrefs.font_family === 'sans'             ? 'selected' : '' %>>সিস্টেম স্ট্যান্ডার্ড (আধুনিক)</option>
                <option value="mixed"    <%= displayPrefs.font_family === 'mixed'            ? 'selected' : '' %>>মিশ্র (হিন্দ বডি + আখন্দ শীর্ষক)</option>
                <option value="hand"     <%= displayPrefs.font_family === 'hand'             ? 'selected' : '' %>>বেনসেন (হাতে লেখা স্টাইল)</option>
                <option value="display"  <%= displayPrefs.font_family === 'display'          ? 'selected' : '' %>>আখন্দ বাংলা (বোল্ড ডিসপ্লে)</option>
                <option value="durnibar" <%= displayPrefs.font_family === 'durnibar'         ? 'selected' : '' %>>দুর্নিবার (সুন্দর বাংলা সিরিফ)</option>
                <option value="lipi"     <%= displayPrefs.font_family === 'lipi'             ? 'selected' : '' %>>লিপি মল্লিকা (প্রিমিয়াম সিরিফ)</option>
              </select>
            </div>
            <div class="field">
              <label>ফন্ট সাইজ</label>
              <select class="select" name="font_size">
                <option value="small"  <%= displayPrefs.font_size === 'small'  ? 'selected' : '' %>>ছোট</option>
                <option value="medium" <%= (displayPrefs.font_size || 'medium') === 'medium' ? 'selected' : '' %>>মাঝারি</option>
                <option value="large"  <%= displayPrefs.font_size === 'large'  ? 'selected' : '' %>>বড়</option>
              </select>
            </div>
            <div class="field">
              <label>লাইন-স্পেসিং</label>
              <select class="select" name="line_height" id="lhSelect">
                <option value="compact" <%= (displayPrefs.line_height || 'normal') === 'compact' ? 'selected' : '' %>>ঘন (১.৫)</option>
                <option value="normal"  <%= (displayPrefs.line_height || 'normal') === 'normal'  ? 'selected' : '' %>>স্বাভাবিক (১.৭)</option>
                <option value="relaxed" <%= (displayPrefs.line_height || 'normal') === 'relaxed' ? 'selected' : '' %>>আরামদায়ক (১.৯)</option>
              </select>
              <div class="hint">দীর্ঘ পড়ার সময় চোখের আরাম বাড়াতে লাইনের ব্যবধান</div>
            </div>
            <div class="field">
              <label>ভাষা</label>
              <select class="select" name="language">
                <option value="bn" <%= (displayPrefs.language || 'bn') === 'bn' ? 'selected' : '' %>>বাংলা</option>
                <option value="en" <%= displayPrefs.language === 'en' ? 'selected' : '' %>>English</option>
              </select>
            </div>
            <div class="dp-preview-wrap">
              <div class="dp-preview-label"><i class="fas fa-eye"></i> লাইভ প্রিভিউ</div>
              <div class="dp-preview" id="dpPreview">সাহিত্য আসলে আয়নার মতো — যা আমাদের না বলা ব্যথা ও আনন্দকে নতুন করে ভাষা দেয়। বইয়ের পাতা উল্টানোর মতো আনন্দ আর কিছুতেই নেই।</div>
            </div>
            <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
          </form>
        </div>
      </section>

      <!-- ৯. মিডিয়া ও কল পারমিশন ডায়াগনস্টিকস (নতুন, সেশন ১৪২) -->
      <section class="st142-pane" data-pane="media" aria-label="মিডিয়া ও কল পারমিশন">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>মিডিয়া ও কল পারমিশন</h2><p>মেসেঞ্জারে অডিও/ভিডিও কলের আগে মাইক, ক্যামেরা ও নেটওয়ার্ক ঠিক আছে কিনা যাচাই করুন — সব পরীক্ষা আপনার ব্রাউজারেই চলে, কোনো রেকর্ড রাখা হয় না।</p></div>
        </div>
        <div class="st142-card">
          <div class="st142-diag">

            <div class="st142-dcard">
              <div class="st142-dhead">
                <b><i class="fas fa-lock"></i> ব্রাউজার-পারমিশন</b>
                <span class="st142-dstat" id="permStat142">অপেক্ষমাণ</span>
              </div>
              <div class="st142-dbody">
                মাইক ও ক্যামেরার অনুমতি-অবস্থা:
                <ul id="diagPerms142"><li><i class="fas fa-circle-minus"></i> নিচের পরীক্ষা চালালে ব্রাউজার নিজেই জিজ্ঞেস করবে</li></ul>
              </div>
              <div class="st142-dactions"><button type="button" class="btn btn-ghost btn-sm" id="btnPerms142"><i class="fas fa-rotate"></i> আবার দেখুন</button></div>
            </div>

            <div class="st142-dcard">
              <div class="st142-dhead">
                <b><i class="fas fa-headset"></i> ডিভাইস-তালিকা</b>
                <span class="st142-dstat" id="devStat142">অপেক্ষমাণ</span>
              </div>
              <div class="st142-dbody">
                সংযুক্ত অডিও/ভিডিও ডিভাইস:
                <ul id="diagDevs142"><li><i class="fas fa-circle-minus"></i> পরীক্ষা চালালে ডিভাইসের নাম দেখা যাবে</li></ul>
              </div>
              <div class="st142-dactions"><button type="button" class="btn btn-ghost btn-sm" id="btnDevs142"><i class="fas fa-rotate"></i> ডিভাইস স্ক্যান</button></div>
            </div>

            <div class="st142-dcard">
              <div class="st142-dhead">
                <b><i class="fas fa-microphone"></i> মাইক-টেস্ট</b>
                <span class="st142-dstat" id="micStat142">অপেক্ষমাণ</span>
              </div>
              <div class="st142-dbody">
                কথা বলুন — নিচের মিটার কাঁপবে:
                <div class="st142-meter" style="margin-top:8px;"><i id="micMeter142"></i></div>
              </div>
              <div class="st142-dactions">
                <button type="button" class="btn btn-primary btn-sm" id="btnMicStart142"><i class="fas fa-play"></i> শুরু</button>
                <button type="button" class="btn btn-ghost btn-sm" id="btnMicStop142" hidden><i class="fas fa-stop"></i> বন্ধ</button>
              </div>
            </div>

            <div class="st142-dcard">
              <div class="st142-dhead">
                <b><i class="fas fa-video"></i> ক্যামেরা-টেস্ট</b>
                <span class="st142-dstat" id="camStat142">অপেক্ষমাণ</span>
              </div>
              <video class="st142-cam" id="camVideo142" autoplay playsinline muted></video>
              <div class="st142-dactions">
                <button type="button" class="btn btn-primary btn-sm" id="btnCamStart142"><i class="fas fa-play"></i> শুরু</button>
                <button type="button" class="btn btn-ghost btn-sm" id="btnCamStop142" hidden><i class="fas fa-stop"></i> বন্ধ</button>
              </div>
            </div>

            <div class="st142-dcard">
              <div class="st142-dhead">
                <b><i class="fas fa-tower-broadcast"></i> নেটওয়ার্ক (STUN/TURN)</b>
                <span class="st142-dstat" id="netStat142">অপেক্ষমাণ</span>
              </div>
              <div class="st142-dbody">
                কল-সার্ভারে পৌঁছানো যায় কিনা (ICE-যাচাই):
                <ul id="netBox142"><li><i class="fas fa-circle-minus"></i> পরীক্ষা চালালে NAT/TURN-অবস্থা জানা যাবে</li></ul>
              </div>
              <div class="st142-dactions"><button type="button" class="btn btn-ghost btn-sm" id="btnNet142"><i class="fas fa-rotate"></i> নেটওয়ার্ক-যাচাই</button></div>
            </div>

          </div>
        </div>
      </section>

      <!-- ১০. লেখার দর্শক ও যোগাযোগ -->
      <section class="st142-pane" data-pane="audience" aria-label="লেখার দর্শক ও যোগাযোগ">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>লেখার দর্শক ও যোগাযোগ</h2><p>কারা আপনার ব্যক্তিগত তথ্য দেখতে পারবে এবং কে আপনাকে সরাসরি বার্তা দিতে পারবে — নিয়ন্ত্রণ করুন।</p></div>
        </div>
        <div class="st142-card">
          <form method="POST" action="/settings/privacy">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="field-row">
              <div class="label-block"><strong>ইমেইল দেখান</strong><span>অন্যরা আপনার ইমেইল দেখতে পারবে</span></div>
              <label class="toggle-switch"><input type="checkbox" name="show_email" value="1" <%= profileUser.show_email ? 'checked' : '' %>><span class="toggle-slider"></span></label>
            </div>
            <div class="field-row">
              <div class="label-block"><strong>ফোন নম্বর দেখান</strong><span>অন্যরা আপনার ফোন নম্বর দেখতে পারবে</span></div>
              <label class="toggle-switch"><input type="checkbox" name="show_phone" value="1" <%= profileUser.show_phone ? 'checked' : '' %>><span class="toggle-slider"></span></label>
            </div>
            <div class="field-row">
              <div class="label-block"><strong>জন্ম তারিখ দেখান</strong><span>অন্যরা আপনার জন্ম তারিখ দেখতে পারবে</span></div>
              <label class="toggle-switch"><input type="checkbox" name="show_birth" value="1" <%= profileUser.show_birth ? 'checked' : '' %>><span class="toggle-slider"></span></label>
            </div>
            <div class="perm-box">
              <div class="perm-title"><i class="fas fa-comment-dots"></i> ইনবক্সে বার্তা পাঠানোর অনুমতি</div>
              <p class="perm-desc">কে আপনাকে নতুন প্রাইভেট-বার্তা পাঠাতে পারবে — অবাঞ্ছিত স্প্যাম থেকে বাঁচতে নিয়ন্ত্রণ করুন।</p>
              <div class="perm-options">
                <label class="perm-opt">
                  <input type="radio" name="allow_messages_from" value="everyone" <%= (profileUser.allow_messages_from || 'everyone') === 'everyone' ? 'checked' : '' %>>
                  <span><strong>সবাই</strong><small>ফোরামের যে কেউ সরাসরি বার্তা দিতে পারবে</small></span>
                </label>
                <label class="perm-opt">
                  <input type="radio" name="allow_messages_from" value="followers" <%= profileUser.allow_messages_from === 'followers' ? 'checked' : '' %>>
                  <span><strong>শুধুমাত্র অনুসরণকারী</strong><small>যাঁরা আপনাকে ফলো করছেন কেবল তাঁরাই</small></span>
                </label>
                <label class="perm-opt">
                  <input type="radio" name="allow_messages_from" value="none" <%= profileUser.allow_messages_from === 'none' ? 'checked' : '' %>>
                  <span><strong>সম্পূর্ণ বন্ধ</strong><small>কেউ নতুন প্রাইভেট-বার্তা পাঠাতে পারবে না</small></span>
                </label>
              </div>
            </div>
            <div class="field-row">
              <div class="label-block"><strong>বুকমার্ক-তালিকা পাবলিক</strong><span>আপনার সংরক্ষিত লেখার তালিকা অন্যরা দেখতে পাবে
                — <a href="/profile/<%= profileUser.username %>/bookmarks" target="_blank" rel="noopener">পাবলিক ভিউ দেখুন <i class="fas fa-external-link-alt" style="font-size:.7em"></i></a></span></div>
              <label class="toggle-switch"><input type="checkbox" name="bookmarks_public" value="1" <%= profileUser.bookmarks_public ? 'checked' : '' %>><span class="toggle-slider"></span></label>
            </div>
            <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
          </form>
        </div>
      </section>

      <!-- ১১. ব্লক তালিকা -->
      <section class="st142-pane" data-pane="blocking" aria-label="ব্লক তালিকা">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>ব্লক তালিকা</h2><p>ব্লক করা সদস্যরা আপনাকে বার্তা দিতে বা আপনার কনটেন্ট শেয়ার করতে পারবে না।</p></div>
        </div>
        <div class="st142-card">
          <% if (!blockedUsers.length) { %>
            <p class="hint" style="margin:0;"><i class="fas fa-circle-info"></i> কাউকে ব্লক করা নেই — যেকোনো প্রোফাইল-পেজের বাটন থেকে কাউকে ব্লক করা যায়।</p>
          <% } else { %>
            <div class="blk-list">
              <% blockedUsers.forEach(function (b) { %>
                <div class="blk-row">
                  <img class="blk-avatar" src="<%= b.avatar_url || '/avatar/' + b.id %>" onerror="this.onerror=null;this.src='/avatar/0'" alt="">
                  <span class="blk-meta">
                    <strong><%= b.full_name %></strong>
                    <small>@<%= b.username %><% if (b.designation) { %> · <%= b.designation %><% } %></small>
                  </span>
                  <a href="/profile/<%= encodeURIComponent(b.username) %>" class="btn btn-ghost btn-sm"><i class="fas fa-user"></i> প্রোফাইল</a>
                  <form method="POST" action="/settings/unblock" class="blk-form">
                    <input type="hidden" name="user_id" value="<%= b.id %>">
                    <button type="submit" class="btn btn-ghost btn-sm blk-unblock"><i class="fas fa-unlock"></i> ব্লক সরান</button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ১২. সংযুক্ত অ্যাকাউন্ট -->
      <section class="st142-pane" data-pane="connected" aria-label="সংযুক্ত অ্যাকাউন্ট">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>সংযুক্ত অ্যাকাউন্ট</h2><p>সোশ্যাল প্রোফাইল যুক্ত করুন — সংযুক্ত লিংকগুলো আপনার প্রোফাইল-পেজে আইকন হিসেবে দেখা যাবে।</p></div>
        </div>
        <div class="st142-card">
          <div class="connected-list">
            <%
              const providers60 = [
                { key: 'fb',       ico: 'fab fa-facebook-f',    brand: '#1877f2', name: 'Facebook',    desc: 'প্রোফাইল বা পেজের লিংক',        val: profileUser.social_fb },
                { key: 'twitter',  ico: 'fab fa-x-twitter',     brand: '#111',     name: 'Twitter / X', desc: 'এক্স-প্রোফাইলের লিংক',           val: profileUser.social_twitter },
                { key: 'linkedin', ico: 'fab fa-linkedin-in',   brand: '#0a66c2',  name: 'LinkedIn',    desc: 'প্রফেশনাল প্রোফাইলের লিংক',     val: profileUser.social_linkedin },
                { key: 'telegram', ico: 'fab fa-telegram-plane', brand: '#229ed9',  name: 'Telegram',    desc: 'চ্যানেল বা ইউজারনেমের লিংক',    val: profileUser.social_telegram },
                { key: 'website',  ico: 'fas fa-globe',         brand: '#059669',  name: 'ওয়েবসাইট',    desc: 'নিজের ব্লগ বা পোর্টফোলিও',       val: profileUser.social_website },
              ];
            %>
            <% providers60.forEach(function (p) { const on = p.val && /^https?:\/\//i.test(p.val); %>
            <div class="ca-row <%= on ? 'is-on' : '' %>" data-provider="<%= p.key %>">
              <span class="ca-ico" style="--ca:<%= p.brand %>"><i class="<%= p.ico %>"></i></span>
              <span class="ca-meta">
                <strong><%= p.name %></strong>
                <small><%= p.desc %></small>
              </span>
              <% if (on) { %>
                <a class="ca-link" href="<%= p.val %>" target="_blank" rel="noopener" title="<%= p.val %>"><i class="fas fa-external-link-alt"></i> খুলুন</a>
              <% } %>
              <span class="ca-state <%= on ? 'on' : 'off' %>"><i class="fas <%= on ? 'fa-check-circle' : 'fa-circle' %>"></i> <%= on ? 'সংযুক্ত' : 'সংযুক্ত নয়' %></span>
              <% if (on) { %>
                <form method="POST" action="/settings/social" class="ca-inline-form" data-confirm="সংযোগ বিচ্ছিন্ন করবেন?">
                  <input type="hidden" name="provider" value="<%= p.key %>">
                  <input type="hidden" name="value" value="">
                  <button type="submit" class="btn btn-ghost btn-sm ca-btn ca-unlink"><i class="fas fa-unlink"></i> বিচ্ছিন্ন</button>
                </form>
              <% } %>
              <button type="button" class="btn btn-primary btn-sm ca-btn ca-edit"><i class="fas <%= on ? 'fa-pen' : 'fa-plus' %>"></i> <%= on ? 'পরিবর্তন' : 'সংযুক্ত করুন' %></button>
              <form method="POST" action="/settings/social" class="ca-editor" hidden>
                <input type="hidden" name="provider" value="<%= p.key %>">
                <div class="ca-editor-field">
                  <i class="<%= p.ico %>" style="color:<%= p.brand %>"></i>
                  <input class="input" type="text" inputmode="url" name="value" value="<%= on ? p.val : '' %>" placeholder="https://… বা t.me/ইউজারনেম" autocomplete="off" spellcheck="false" required>
                </div>
                <div class="ca-editor-actions">
                  <button type="button" class="btn btn-ghost btn-sm ca-cancel"><i class="fas fa-times"></i> বাতিল</button>
                  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-check"></i> সংরক্ষণ</button>
                </div>
              </form>
            </div>
            <% }) %>
          </div>
          <div class="hint" style="margin-top:12px"><i class="fas fa-shield-alt"></i> শুধু http/https লিংক গ্রহণযোগ্য, সংযোগ যেকোনো সময় বিচ্ছিন্ন করা যায়।</div>
        </div>
      </section>

      <!-- ১৩. আপনার কার্যক্রম -->
      <section class="st142-pane" data-pane="activity" aria-label="আপনার কার্যক্রম">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>আপনার কার্যক্রম</h2><p>আপনার লেখা, মন্তব্য, প্রতিক্রিয়া ও সংরক্ষণের একনজরে হিসেব — বিস্তারিত পেজে পূর্ণ তালিকা।</p></div>
        </div>
        <div class="st142-stats">
          <div class="st142-stat"><b><%= bn142(actStats.posts) %></b><small>প্রকাশিত লেখা</small></div>
          <div class="st142-stat"><b><%= bn142(actStats.comments) %></b><small>মন্তব্য</small></div>
          <div class="st142-stat"><b><%= bn142(actStats.reactions) %></b><small>প্রতিক্রিয়া</small></div>
          <div class="st142-stat"><b><%= bn142(actStats.bookmarks) %></b><small>সংরক্ষিত লেখা</small></div>
        </div>
        <div class="st142-card">
          <div class="st142-rows">
            <a class="st142-row is-ext" href="/activities">
              <span class="st142-ico"><i class="fas fa-list-check"></i></span>
              <span class="st142-rmeta"><b>অ্যাক্টিভিটি লগ</b><small>সাংগঠনিক ও ব্যক্তিগত কার্যক্রমের পূর্ণ তালিকা</small></span>
              <i class="fas fa-arrow-up-right-from-square st142-rchev"></i>
            </a>
            <a class="st142-row is-ext" href="/me">
              <span class="st142-ico"><i class="fas fa-feather"></i></span>
              <span class="st142-rmeta"><b>আমার লেখা ও প্রতিক্রিয়া</b><small>নিজের পোস্ট, মন্তব্য ও প্রতিক্রিয়ার টাইমলাইন (ট্যাব-বদল করুন)</small></span>
              <i class="fas fa-arrow-up-right-from-square st142-rchev"></i>
            </a>
            <a class="st142-row is-ext" href="/bookmarks">
              <span class="st142-ico"><i class="fas fa-bookmark"></i></span>
              <span class="st142-rmeta"><b>সংরক্ষিত লেখা</b><small>পরে পড়ার জন্য জমানো লেখার তালিকা</small></span>
              <span class="st142-rcount"><%= bn142(actStats.bookmarks) %>টি</span>
              <i class="fas fa-arrow-up-right-from-square st142-rchev"></i>
            </a>
            <a class="st142-row is-ext" href="/settings/export" download>
              <span class="st142-ico"><i class="fas fa-cloud-arrow-down"></i></span>
              <span class="st142-rmeta"><b>ডেটা ব্যাকআপ (JSON)</b><small>আপনার প্রকাশিত লেখা, মন্তব্য, বুকমার্ক ও বার্তা — এক ক্লিকে নিরাপদ ব্যাকআপ</small></span>
              <i class="fas fa-download st142-rchev"></i>
            </a>
          </div>
        </div>
      </section>

      <!-- ১৪. সাহিত্যিক আচরণবিধি -->
      <section class="st142-pane" data-pane="standards" aria-label="সাহিত্যিক আচরণবিধি">
        <div class="st142-phead">
          <button type="button" class="st142-moback" aria-label="সব সেটিংসে ফিরুন"><i class="fas fa-arrow-left"></i></button>
          <div><h2>সাহিত্যিক আচরণবিধি</h2><p>সুস্থ জ্ঞানচর্চা ও সৃজনশীলতা বজায় রাখার মূল নীতি — প্রত্যেক সদস্যের পালনীয়।</p></div>
        </div>
        <div class="st142-card">
          <div class="st142-policy">
            <div class="st142-policy-item">
              <i class="fas fa-feather-pointed"></i>
              <div><b>১. মৌলিকতার নিশ্চয়তা</b><p>ফোরামে প্রকাশিত যেকোনো সাহিত্যকর্ম, প্রবন্ধ বা কবিতা লেখকের নিজস্ব সৃষ্টি হতে হবে। অন্যের লেখা হুবহু কপি করা সম্পূর্ণ নিষিদ্ধ — উদ্ধৃতি হলে সুস্পষ্ট উৎস উল্লেখ বাধ্যতামূলক।</p></div>
            </div>
            <div class="st142-policy-item">
              <i class="fas fa-hand-holding-heart"></i>
              <div><b>২. শ্রদ্ধা ও শালীনতা</b><p>গঠনমূলক সমালোচনা স্বাগত, তবে যেকোনো লেখক বা সদস্যের প্রতি ব্যক্তিগত আক্রমণ, কটূক্তি বা গোঁড়ামি-প্রচার করা হলে অ্যাকাউন্ট তাৎক্ষণিক স্থগিত করা হবে।</p></div>
            </div>
            <div class="st142-policy-item">
              <i class="fas fa-building-columns"></i>
              <div><b>৩. বিশ্ববিদ্যালয় ও সামাজিক সম্প্রীতি</b><p>চট্টগ্রাম বিশ্ববিদ্যালয়ের মর্যাদা ক্ষুণ্ণ করে বা সামাজিক সম্প্রীতি বিনষ্ট করে এমন কোনো কনটেন্ট প্রচার করা যাবে না।</p></div>
            </div>
            <div class="st142-policy-item is-red">
              <i class="fas fa-copyright"></i>
              <div><b>৪. কপিরাইট ও স্বত্ব</b><p>প্রকাশিত লেখার সম্পূর্ণ স্বত্ব মূল লেখকের — ফোরাম-বাইরে কোনো লেখা পুনঃপ্রকাশের আগে লেখকের অনুমতি নিতে হবে। স্বত্ব-লঙ্ঘনের অভিযোগ <a href="/complaints">অভিযোগ-পেজে</a> জানান।</p></div>
            </div>
          </div>
          <div class="st142-rows" style="margin-top:12px;">
            <a class="st142-row is-ext" href="/constitution">
              <span class="st142-ico"><i class="fas fa-scroll"></i></span>
              <span class="st142-rmeta"><b>ফোরাম-সংবিধান</b><small>গঠনতন্ত্র, পদাধিকার ও সিদ্ধান্ত-প্রক্রিয়ার পূর্ণ দলিল</small></span>
              <i class="fas fa-arrow-up-right-from-square st142-rchev"></i>
            </a>
          </div>
        </div>
      </section>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
  /* ── সেশন ১৪২: মাস্টার-ডিটেইল নেভিগেশন ইঞ্জিন (দুই-স্তর হ্যাশ-রাউটিং) ── */
  (function () {
    var shell = document.getElementById('stShell');
    var navEl = document.getElementById('stNav');
    var items = Array.prototype.slice.call(document.querySelectorAll('.st142-item'));
    var panes = Array.prototype.slice.call(document.querySelectorAll('.st142-pane'));
    var curSec = 'profile', curSub = null;
    /* পুরনো হ্যাশ → নতুন সেকশন (রিডাইরেক্ট-সামঞ্জস্য) */
    var MAP142 = { account: 'password', privacy: 'audience' };

    function normSec(h) { return MAP142[h] || h; }

    function activate(sec, sub, push) {
      var pane = null;
      for (var i = 0; i < panes.length; i++) { if (panes[i].getAttribute('data-pane') === sec) { pane = panes[i]; break; } }
      if (!pane) return false;
      curSec = sec; curSub = sub || null;
      items.forEach(function (l) { l.classList.toggle('on', l.getAttribute('data-sec') === sec); });
      panes.forEach(function (p) { p.classList.toggle('on', p === pane); });
      var details = pane.querySelectorAll('.st142-detail');
      Array.prototype.forEach.call(details, function (d) { d.classList.toggle('on', d.getAttribute('data-detail') === curSub); });
      var rowsView = pane.querySelector('.st142-submenu');
      if (rowsView) rowsView.style.display = curSub ? 'none' : '';
      if (window.innerWidth <= 960) shell.classList.add('show-pane');
      if (push !== false && history.replaceState) history.replaceState(null, '', curSub ? '#' + sec + '/' + curSub : '#' + sec);
      return true;
    }

    function closePane() {
      shell.classList.remove('show-pane');
      if (history.replaceState) history.replaceState(null, '', '#' + curSec);
    }

    /* বাঁয়ের মেনু-ক্লিক */
    items.forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        activate(link.getAttribute('data-sec'), null);
      });
    });

    /* সাব-মেনু রো → ডিটেইল */
    document.addEventListener('click', function (e) {
      var row = e.target.closest('.st142-row[data-goto]');
      if (row) {
        var pane = row.closest('.st142-pane');
        if (pane) activate(pane.getAttribute('data-pane'), row.getAttribute('data-goto'));
        return;
      }
      var back = e.target.closest('.st142-backbtn');
      if (back) { activate(curSec, null); return; }
      var moback = e.target.closest('.st142-moback');
      if (moback) {
        var p = moback.closest('.st142-pane');
        if (p && curSub) activate(curSec, null);
        else closePane();
      }
    });

    /* হ্যাশ-পার্স: #sec বা #sec/sub */
    function fromHash() {
      var h = location.hash.slice(1);
      if (!h) return;
      var parts = h.split('/');
      var sec = normSec(parts[0]);
      if (!activate(sec, parts[1] || null, false)) return;
    }
    window.addEventListener('hashchange', fromHash);

    /* প্রাথমিক-অবস্থা: ?sec/secerr → নিরাপত্তা-প্যানে (সেশন ৫৮-চুক্তি); নইলে হ্যাশ */
    var q = new URLSearchParams(location.search);
    if (q.has('sec') || q.has('secerr')) {
      var sub = q.get('sec') === 'backup' ? null : 'sec-status';
      if (!activate('security', sub, false)) activate('profile', null, false);
    } else if (location.hash) {
      fromHash();
    }
    if (window.innerWidth > 960) shell.classList.remove('show-pane');
    window.addEventListener('resize', function () { if (window.innerWidth > 960) shell.classList.remove('show-pane'); });

    /* সার্চ — লেবেল+বর্ণনা মিলিয়ে আইটেম/গ্রুপ লুকানো */
    var search = document.getElementById('stSearch');
    var noResult = document.getElementById('stNoResult');
    if (search) {
      search.addEventListener('input', function () {
        var v = search.value.trim().toLowerCase();
        var any = false;
        items.forEach(function (it) {
          var kw = (it.getAttribute('data-kw') || '').toLowerCase() + ' ' + it.textContent.toLowerCase();
          var hit = !v || kw.indexOf(v) >= 0;
          it.hidden = !hit;
          if (hit) any = true;
          var grp = it.closest('[data-grp]');
          if (grp) grp.hidden = !grp.querySelector('.st142-item:not([hidden])');
        });
        navEl.classList.toggle('searching', !!v);
        if (noResult) noResult.classList.toggle('show', v && !any);
      });
      search.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        var first = navEl.querySelector('.st142-item:not([hidden])');
        if (first) { activate(first.getAttribute('data-sec'), null); search.value = ''; search.dispatchEvent(new Event('input')); }
      });
    }
  })();

  /* ── ব্যাকআপ-কোড কপি (সেশন ৫৮-চুক্তি) ── */
  (function () {
    var cp = document.getElementById('secCopyCodes');
    if (!cp) return;
    cp.addEventListener('click', function () {
      var codes = Array.from(document.querySelectorAll('.sec-code-chip')).map(function (c) { return c.textContent.trim(); }).join('\n');
      if (navigator.clipboard) {
        navigator.clipboard.writeText(codes).then(function () {
          cp.innerHTML = '<i class="fas fa-check"></i> কপি হয়েছে';
          setTimeout(function () { cp.innerHTML = '<i class="fas fa-copy"></i> সব কোড কপি করুন'; }, 1800);
        }).catch(function () {});
      }
    });
  })();

  /* ── সেশন ৬০: সংযুক্ত অ্যাকাউন্ট — সম্প্রসারণযোগ্য এডিটর + বিচ্ছিন্ন-নিশ্চিতকরণ ── */
  (function () {
    function closeEditors(exceptRow) {
      document.querySelectorAll('.ca-row').forEach(function (row) {
        if (row === exceptRow) return;
        var ed = row.querySelector('.ca-editor');
        if (ed && !ed.hidden) { ed.hidden = true; row.classList.remove('editing'); }
      });
    }
    document.addEventListener('click', function (e) {
      var editBtn = e.target.closest('.ca-edit');
      if (editBtn) {
        var row = editBtn.closest('.ca-row');
        var ed = row && row.querySelector('.ca-editor');
        if (ed) {
          var opening = ed.hidden;
          closeEditors(row);
          ed.hidden = !opening;
          row.classList.toggle('editing', opening);
          if (opening) {
            var inp = ed.querySelector('input[name="value"]');
            if (inp) setTimeout(function () { inp.focus(); inp.select && inp.select(); }, 60);
          }
        }
        return;
      }
      var cancelBtn = e.target.closest('.ca-cancel');
      if (cancelBtn) {
        var row2 = cancelBtn.closest('.ca-row');
        var ed2 = row2 && row2.querySelector('.ca-editor');
        if (ed2) { ed2.hidden = true; row2.classList.remove('editing'); }
      }
    });
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (f.classList && f.classList.contains('ca-inline-form')) {
        var msg = f.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) { e.preventDefault(); return; }
        var btn = f.querySelector('button[type="submit"]');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> বিচ্ছিন্ন হচ্ছে…'; }
      }
    }, true);
  })();

  /* ── সেশন ৮০: সেটিংস-ইন্টারঅ্যাকশন (ধারা-চিপ, প্রিভিউ, রিলটাইম, কনফার্ম, ডিলিট) ── */
  (function () {
    /* ১) সাহিত্য-ধারা চিপ-পিকার — সর্বোচ্চ ৫টি, হিডেন-ইনপুটে JSON */
    var wrap = document.getElementById('genreChips');
    var input = document.getElementById('genreInput');
    var count = document.getElementById('genreCount');
    if (wrap && input) {
      var read = function () { try { return JSON.parse(input.value) || []; } catch (e) { return []; } };
      var write = function (arr) { input.value = JSON.stringify(arr); if (count) count.textContent = arr.length + '/৫'; };
      wrap.addEventListener('click', function (e) {
        var chip = e.target.closest('.genre-chip');
        if (!chip) return;
        var g = chip.getAttribute('data-genre');
        var cur = read();
        if (cur.indexOf(g) >= 0) cur = cur.filter(function (x) { return x !== g; });
        else if (cur.length >= 5) { wrap.classList.add('shake'); setTimeout(function () { wrap.classList.remove('shake'); }, 400); return; }
        else cur.push(g);
        write(cur);
        chip.classList.toggle('selected', cur.indexOf(g) >= 0);
        chip.firstChild.nodeValue = (cur.indexOf(g) >= 0 ? '✓ ' : '+ ');
      });
    }

    /* ২) ডিসপ্লে-লাইভ প্রিভিউ */
    var dp = document.getElementById('dpPreview');
    if (dp) {
      var form = dp.closest('form');
      var fSel = form && form.querySelector('select[name="font_family"]');
      var sSel = form && form.querySelector('select[name="font_size"]');
      var lSel = form && form.querySelector('select[name="line_height"]');
      var tSel = form && form.querySelector('select[name="theme"]');
      var SIZES = { small: '14px', medium: '16.5px', large: '18.5px' };
      var LHS = { compact: '1.5', normal: '1.7', relaxed: '1.9' };
      var FFCLASS = { bn: 'font-bn', serif: 'font-serif', sans: 'font-sans', mixed: 'font-mixed', hand: 'font-hand', display: 'font-display', durnibar: 'font-durnibar', lipi: 'font-lipi' };
      function sync() {
        if (sSel) dp.style.fontSize = SIZES[sSel.value] || '16.5px';
        if (lSel) dp.style.lineHeight = LHS[lSel.value] || '1.7';
        if (fSel) { Object.keys(FFCLASS).forEach(function (k) { dp.classList.remove(FFCLASS[k]); }); dp.classList.add(FFCLASS[fSel.value] || 'font-bn'); }
        if (tSel) { dp.classList.toggle('is-sepia', tSel.value === 'sepia'); dp.classList.toggle('is-dark', tSel.value === 'dark'); }
      }
      [fSel, sSel, lSel, tSel].forEach(function (el) { if (el) el.addEventListener('change', sync); });
      sync();
    }

    /* ৩) সেশন-তালিকার সময় — বাংলা রিলেটিভ-টাইম */
    function relTime80(ts) {
      var d = Date.now() - Number(ts);
      if (d < 0) d = 0;
      var m = Math.floor(d / 60000);
      if (m < 1) return 'এই মুহূর্তে';
      if (m < 60) return m + ' মিনিট আগে';
      var h = Math.floor(m / 60);
      if (h < 24) return h + ' ঘণ্টা আগে';
      var dd = Math.floor(h / 24);
      if (dd < 30) return dd + ' দিন আগে';
      return new Date(Number(ts)).toLocaleDateString('bn-BD');
    }
    document.querySelectorAll('time[data-ts]').forEach(function (t) { t.textContent = relTime80(t.getAttribute('data-ts')); });

    /* ৪) সেশন-রিভোক/আনব্লক/রিভোক-অল কনফার্ম + বাটন-স্পিনার */
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (f && (f.classList.contains('sess-form') || f.classList.contains('blk-form') || (f.getAttribute && f.getAttribute('data-confirm') && !f.classList.contains('ca-inline-form')))) {
        var msg = f.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) { e.preventDefault(); return; }
        var btn = f.querySelector('button[type="submit"]');
        if (btn) { btn.disabled = true; btn.insertAdjacentHTML('afterbegin', '<i class="fas fa-spinner fa-spin" style="margin-right:5px"></i>'); }
      }
    }, true);

    /* ৫) স্থায়ী-ডিলিট — ভিজ্যুয়াল-ফর্ম → হিডেন-ফর্মে মান বসিয়ে সাবমিট */
    var pd = document.getElementById('permDeleteForm80');
    var pdb = document.querySelector('.dz-del-form button.btn-danger');
    if (pd && pdb) {
      var vPwd = document.querySelector('.dz-del-form input[name="current_password"]');
      var vDel = document.querySelector('.dz-del-form input.dz-del-confirm');
      pdb.addEventListener('click', function (ev) {
        ev.preventDefault();
        var pwd = vPwd && vPwd.value;
        var del = vDel && vDel.value.trim().toUpperCase();
        if (!pwd || del !== 'DELETE') {
          alert('অ্যাকাউন্ট মুছতে: পাসওয়ার্ড দিন এবং নিশ্চিত-ঘরে ঠিক DELETE লিখুন।');
          return;
        }
        if (!window.confirm('সত্যিই চিরতরে মুছে ফেলবেন? এটি ফেরানো যাবে না!')) return;
        var i1 = document.createElement('input'); i1.type = 'hidden'; i1.name = 'current_password'; i1.value = pwd;
        var i2 = document.createElement('input'); i2.type = 'hidden'; i2.name = 'confirm_delete'; i2.value = del;
        pd.appendChild(i1); pd.appendChild(i2);
        pd.submit();
      });
    }
  })();

  /* ── সেশন ৯৪: আনসেভড-ডেটা গার্ড (beforeunload + dirty-ট্র্যাকিং) ── */
  (function () {
    var dirty = false;
    function markDirty(e) {
      var t = e.target;
      if (t && t.closest && t.closest('.st142-pane') && !t.closest('.dz-del-form')) dirty = true;
    }
    document.addEventListener('input', markDirty, true);
    document.addEventListener('change', markDirty, true);
    document.addEventListener('submit', function () { dirty = false; }, true);
    document.addEventListener('click', function (e) {
      if (e.target && e.target.closest && e.target.closest('.dz-del-form')) dirty = false;
    }, true);
    window.addEventListener('beforeunload', function (e) {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = '';
      return '';
    });
  })();

  /* ── সেশন ১৪২: মিডিয়া ও কল ডায়াগনস্টিকস ইঞ্জিন (সম্পূর্ণ ক্লায়েন্ট-সাইড) ──
     পারমিশন-অবস্থা, ডিভাইস-তালিকা, মাইক-মিটার, ক্যামেরা-প্রিভিউ ও ICE (STUN/TURN)
     যাচাই — webrtc-call.js-এর একই ICE-কনফিগ ব্যবহার করে, কোনো রেকর্ড রাখা হয় না। */
  (function () {
    function stat(id, cls, txt) { var el = document.getElementById(id); if (el) { el.className = 'st142-dstat ' + cls; el.textContent = txt; } }
    function boxHtml(id, html) { var el = document.getElementById(id); if (el) el.innerHTML = html; }
    function esc(s) { return String(s || '').replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

    /* ১) ব্রাউজার-পারমিশন */
    function checkPerms() {
      stat('permStat142', 'run', 'চলছে…');
      var names = ['microphone', 'camera'];
      var hasPermApi = !!(navigator.permissions && navigator.permissions.query);
      Promise.all(names.map(function (n) {
        if (!hasPermApi) return Promise.resolve({ name: n, state: 'unsupported' });
        return navigator.permissions.query({ name: n }).then(function (r) { return { name: n, state: r.state }; }).catch(function () { return { name: n, state: 'unsupported' }; });
      })).then(function (res) {
        var BN = { granted: 'অনুমোদিত', denied: 'অবরুদ্ধ', prompt: 'প্রশ্ন-বাকি', unsupported: 'সমর্থিত নয়' };
        var ICO = { granted: 'fa-check', denied: 'fa-ban', prompt: 'fa-circle-question', unsupported: 'fa-circle-minus' };
        boxHtml('diagPerms142', res.map(function (r) {
          return '<li><i class="fas ' + (ICO[r.state] || 'fa-circle') + '"></i> ' + (r.name === 'microphone' ? 'মাইক্রোফোন' : 'ক্যামেরা') + ' — <b>' + (BN[r.state] || esc(r.state)) + '</b></li>';
        }).join(''));
        var denied = res.filter(function (r) { return r.state === 'denied'; }).length;
        var unsup = res.filter(function (r) { return r.state === 'unsupported'; }).length;
        if (denied === 2) stat('permStat142', 'bad', 'অবরুদ্ধ');
        else if (denied) stat('permStat142', 'warn', 'আংশিক');
        else if (unsup) stat('permStat142', 'warn', 'অজানা');
        else stat('permStat142', 'ok', 'ঠিক আছে');
      }).catch(function () { stat('permStat142', 'warn', 'অজানা'); });
    }
    var bp = document.getElementById('btnPerms142');
    if (bp) bp.addEventListener('click', checkPerms);

    /* ২) ডিভাইস-তালিকা */
    function listDevices() {
      stat('devStat142', 'run', 'স্ক্যান চলছে…');
      if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) {
        stat('devStat142', 'bad', 'অসমর্থিত');
        boxHtml('diagDevs142', '<li><i class="fas fa-triangle-exclamation"></i> এই ব্রাউজারে ডিভাইস-তালিকা পাওয়া যায় না</li>');
        return;
      }
      navigator.mediaDevices.enumerateDevices().then(function (ds) {
        var mics = ds.filter(function (d) { return d.kind === 'audioinput'; });
        var cams = ds.filter(function (d) { return d.kind === 'videoinput'; });
        var spks = ds.filter(function (d) { return d.kind === 'audiooutput'; });
        var rows = [];
        function pushRow(label, arr, icon) {
          rows.push('<li><i class="fas ' + icon + '"></i> ' + label + ': <b>' + arr.length + '</b>টি' + (arr.length ? ' — ' + esc(arr[0].label || 'নাম-গোপন (পরীক্ষা চালালে দেখা যাবে)') : '') + '</li>');
        }
        pushRow('মাইক্রোফোন', mics, 'fa-microphone');
        pushRow('ক্যামেরা', cams, 'fa-video');
        pushRow('স্পিকার', spks, 'fa-volume-high');
        boxHtml('diagDevs142', rows.join(''));
        stat('devStat142', cams.length ? 'ok' : (mics.length ? 'warn' : 'bad'), cams.length ? 'ঠিক আছে' : (mics.length ? 'ক্যামেরা নেই' : 'ডিভাইস নেই'));
      }).catch(function () {
        stat('devStat142', 'bad', 'ব্যর্থ');
        boxHtml('diagDevs142', '<li><i class="fas fa-triangle-exclamation"></i> ডিভাইস-তালিকা পড়া গেল না</li>');
      });
    }
    var bd = document.getElementById('btnDevs142');
    if (bd) bd.addEventListener('click', listDevices);

    /* ৩) মাইক-টেস্ট (লাইভ লেভেল-মিটার) */
    var micStream = null, micRaf = null, audioCtx = null;
    function stopMic() {
      if (micRaf) { cancelAnimationFrame(micRaf); micRaf = null; }
      if (micStream) { micStream.getTracks().forEach(function (t) { t.stop(); }); micStream = null; }
      if (audioCtx) { try { audioCtx.close(); } catch (_) {} audioCtx = null; }
      var m = document.getElementById('micMeter142'); if (m) m.style.width = '0%';
      var s = document.getElementById('btnMicStart142'); if (s) s.hidden = false;
      var t = document.getElementById('btnMicStop142'); if (t) t.hidden = true;
      stat('micStat142', '', 'অপেক্ষমাণ');
    }
    function startMic() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return stat('micStat142', 'bad', 'অসমর্থিত');
      stat('micStat142', 'run', 'অনুমতির অপেক্ষায়…');
      navigator.mediaDevices.getUserMedia({ audio: true }).then(function (stream) {
        micStream = stream;
        try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch (_) { audioCtx = null; }
        var meter = document.getElementById('micMeter142');
        if (audioCtx) {
          var src = audioCtx.createMediaStreamSource(stream);
          var analyser = audioCtx.createAnalyser();
          analyser.fftSize = 512;
          src.connect(analyser);
          var buf = new Uint8Array(analyser.fftSize);
          (function loop() {
            if (!micStream) return;
            analyser.getByteTimeDomainData(buf);
            var sum = 0;
            for (var i = 0; i < buf.length; i++) { var v = (buf[i] - 128) / 128; sum += v * v; }
            var rms = Math.sqrt(sum / buf.length);
            if (meter) meter.style.width = Math.min(100, Math.round(rms * 260)) + '%';
            micRaf = requestAnimationFrame(loop);
          })();
        }
        stat('micStat142', 'ok', 'কণ্ঠ পাওয়া যাচ্ছে');
        var s = document.getElementById('btnMicStart142'); if (s) s.hidden = true;
        var t = document.getElementById('btnMicStop142'); if (t) t.hidden = false;
      }).catch(function (e) {
        stat('micStat142', e && e.name === 'NotAllowedError' ? 'bad' : 'warn', e && e.name === 'NotAllowedError' ? 'অনুমতি নেই' : 'ব্যর্থ');
      });
    }
    var ms = document.getElementById('btnMicStart142');
    var mx = document.getElementById('btnMicStop142');
    if (ms) ms.addEventListener('click', startMic);
    if (mx) mx.addEventListener('click', stopMic);

    /* ৪) ক্যামেরা-টেস্ট (লাইভ প্রিভিউ) */
    var camStream = null;
    function stopCam() {
      if (camStream) { camStream.getTracks().forEach(function (t) { t.stop(); }); camStream = null; }
      var v = document.getElementById('camVideo142'); if (v) { v.srcObject = null; v.classList.remove('live'); }
      var s = document.getElementById('btnCamStart142'); if (s) s.hidden = false;
      var t = document.getElementById('btnCamStop142'); if (t) t.hidden = true;
      stat('camStat142', '', 'অপেক্ষমাণ');
    }
    function startCam() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return stat('camStat142', 'bad', 'অসমর্থিত');
      stat('camStat142', 'run', 'অনুমতির অপেক্ষায়…');
      navigator.mediaDevices.getUserMedia({ video: { width: { ideal: 640 } } }).then(function (stream) {
        camStream = stream;
        var v = document.getElementById('camVideo142');
        if (v) { v.srcObject = stream; v.classList.add('live'); }
        stat('camStat142', 'ok', 'সক্রিয়');
        var s = document.getElementById('btnCamStart142'); if (s) s.hidden = true;
        var t = document.getElementById('btnCamStop142'); if (t) t.hidden = false;
      }).catch(function (e) {
        stat('camStat142', e && e.name === 'NotAllowedError' ? 'bad' : 'warn', e && e.name === 'NotAllowedError' ? 'অনুমতি নেই' : 'ক্যামেরা পাওয়া যায়নি');
      });
    }
    var cs = document.getElementById('btnCamStart142');
    var cx = document.getElementById('btnCamStop142');
    if (cs) cs.addEventListener('click', startCam);
    if (cx) cx.addEventListener('click', stopCam);

    /* ৫) নেটওয়ার্ক (STUN/TURN) — webrtc-call.js-চুক্তি: window.LekhokCallCtx-ওভাররাইড সম্মানিত */
    var ICE_DEFAULT = [
      { urls: 'stun:stun.l.google.com:19302' },
      { urls: 'stun:stun1.l.google.com:19302' },
      { urls: 'turn:openrelay.metered.ca:80', username: 'openrelay', credential: 'openrelay' },
      { urls: 'turn:openrelay.metered.ca:80?transport=tcp', username: 'openrelay', credential: 'openrelay' },
      { urls: 'turn:openrelay.metered.ca:443', username: 'openrelay', credential: 'openrelay' },
      { urls: 'turn:openrelay.metered.ca:443?transport=tcp', username: 'openrelay', credential: 'openrelay' }
    ];
    var netBusy = false;
    function netTest() {
      if (netBusy) return;
      if (typeof RTCPeerConnection === 'undefined') {
        stat('netStat142', 'bad', 'অসমর্থিত');
        boxHtml('netBox142', '<li><i class="fas fa-triangle-exclamation"></i> এই ব্রাউজারে WebRTC নেই</li>');
        return;
      }
      netBusy = true;
      stat('netStat142', 'run', 'সংযোগ নিচ্ছি…');
      boxHtml('netBox142', '<li><i class="fas fa-spinner fa-spin"></i> ICE-প্রার্থী সংগ্রহ চলছে (৯ সেকেন্ড পর্যন্ত)…</li>');
      var ice = ICE_DEFAULT;
      if (window.LekhokCallCtx && window.LekhokCallCtx.iceServers && window.LekhokCallCtx.iceServers.length) ice = window.LekhokCallCtx.iceServers;
      var pc = null, done = false, host = 0, srflx = 0, relay = 0, timer = null;
      function paint() {
        boxHtml('netBox142',
          '<li><i class="fas fa-house"></i> লোকাল (host): <b>' + host + '</b></li>' +
          '<li><i class="fas fa-globe"></i> পাবলিক (srflx): <b>' + srflx + '</b></li>' +
          '<li><i class="fas fa-tower-broadcast"></i> রিলে (TURN): <b>' + relay + '</b></li>');
      }
      function finish() {
        if (done) return;
        done = true; netBusy = false;
        if (timer) clearTimeout(timer);
        try { pc && pc.close(); } catch (_) {}
        paint();
        if (relay > 0) { stat('netStat142', 'ok', 'TURN সক্রিয়'); boxHtml('netBox142', '<li><i class="fas fa-circle-check"></i> রিলে-প্রার্থী পাওয়া গেছে — কঠিন NAT-এও কল হবে</li>' + document.getElementById('netBox142').innerHTML); }
        else if (srflx > 0) { stat('netStat142', 'ok', 'STUN ঠিক'); boxHtml('netBox142', '<li><i class="fas fa-circle-check"></i> পাবলিক-পথ আছে — সাধারণ নেটওয়ার্কে কল হবে</li>' + document.getElementById('netBox142').innerHTML); }
        else if (host > 0) { stat('netStat142', 'warn', 'NAT-সীমিত'); boxHtml('netBox142', '<li><i class="fas fa-triangle-exclamation"></i> শুধু লোকাল-পথ মিলেছে — ফায়ারওয়ালে কল ব্যর্থ হতে পারে</li>' + document.getElementById('netBox142').innerHTML); }
        else { stat('netStat142', 'bad', 'অবরুদ্ধ'); boxHtml('netBox142', '<li><i class="fas fa-ban"></i> কোনো ICE-প্রার্থী মেলেনি — অফলাইন বা WebRTC-অবরুদ্ধ</li>'); }
      }
      try { pc = new RTCPeerConnection({ iceServers: ice }); } catch (_) { finish(); return; }
      try { pc.createDataChannel('diag142'); } catch (_) {}
      pc.onicecandidate = function (e) {
        if (!e.candidate) { finish(); return; }
        var typ = (e.candidate.candidate.match(/typ ([a-z]+)/) || [])[1];
        if (typ === 'host') host++;
        else if (typ === 'srflx') srflx++;
        else if (typ === 'relay') relay++;
        paint();
      };
      pc.onicegatheringstatechange = function () { if (pc.iceGatheringState === 'complete') finish(); };
      pc.createOffer().then(function (o) { return pc.setLocalDescription(o); }).catch(function () { finish(); });
      timer = setTimeout(finish, 9000);
    }
    var bn = document.getElementById('btnNet142');
    if (bn) bn.addEventListener('click', netTest);

    /* প্যানে খুললেই পারমিশন+ডিভাইস স্বয়ংক্রিয় যাচাই */
    var pane = document.querySelector('.st142-pane[data-pane="media"]');
    if (pane) {
      var mo = new MutationObserver(function () {
        if (pane.classList.contains('on')) { checkPerms(); listDevices(); }
      });
      mo.observe(pane, { attributes: true, attributeFilter: ['class'] });
    }
  })();
</script>
<script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
