<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'সেটিংস | লেখক ফোরাম' }) %>

  <div class="container" style="padding: 30px 20px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <a href="/me" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> ফিডে ফিরুন</a>
      <h1 style="margin:0;font-size:24px;">সেটিংস</h1>
      <% if (ok) { %>
        <span class="badge save-ok"><i class="fas fa-check"></i> সংরক্ষিত</span>
      <% } else if (err) { %>
        <span class="badge save-err"><i class="fas fa-exclamation-triangle"></i>
          <%= err === 'password_mismatch' ? 'পাসওয়ার্ড মেলেনি' : err === 'password_short' ? 'পাসওয়ার্ড খুব ছোट' : err === 'password_wrong' ? 'বর্তমান পাসওয়ার্ড ভুল' : 'সমস্যা হয়েছে' %>
        </span>
      <% } %>
    </div>

    <div class="settings-shell">
      <aside class="settings-nav">
        <a href="#" data-section="profile" class="active"><i class="fas fa-user"></i> প্রোফাইল</a>
        <a href="#" data-section="privacy"><i class="fas fa-shield-alt"></i> গোপনীয়তা</a>
        <a href="#" data-section="notifications"><i class="fas fa-bell"></i> বিজ্ঞপ্তি</a>
        <a href="#" data-section="account"><i class="fas fa-key"></i> অ্যাকাউন্ট</a>
        <a href="#" data-section="security"><i class="fas fa-shield-halved"></i> নিরাপত্তা (2FA)</a>
        <a href="#" data-section="display"><i class="fas fa-palette"></i> প্রদর্শন</a>
        <a href="#" data-section="connected"><i class="fas fa-link"></i> সংযুক্ত অ্যাকাউন্ট</a>
      </aside>

      <main>
        <!-- Profile -->
        <section class="settings-section active" data-pane="profile">
          <div class="card">
            <h2><i class="fas fa-user"></i> প্রোফাইল</h2>
            <form method="POST" action="/settings/profile" enctype="multipart/form-data">
              <div class="field">
                <label>পুরো নাম</label>
                <input class="input" name="full_name" value="<%= profileUser.full_name %>" required>
              </div>
              <div class="field">
                <label>পরিচিতি (Bio)</label>
                <textarea class="textarea" name="bio" rows="3" placeholder="নিজের সম্পর্কে কিছু লিখুন…"><%= profileUser.bio || '' %></textarea>
                <div class="hint">সর্বোচ্চ ৩০০ অক্ষর</div>
              </div>
              <div class="field">
                <label>পদবি / Designation</label>
                <input class="input" name="designation" value="<%= profileUser.designation || '' %>" placeholder="যেমন: সাহিত্যিক, শিক্ষক…">
              </div>
              <div class="field">
                <label>ঠিকানা</label>
                <input class="input" name="address" value="<%= profileUser.address || '' %>">
              </div>
              <div class="field" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div>
                  <label>লিঙ্গ</label>
                  <select class="select" name="gender">
                    <option value="male"   <%= profileUser.gender === 'male'   ? 'selected' : '' %>>পুরুষ</option>
                    <option value="female" <%= profileUser.gender === 'female' ? 'selected' : '' %>>নারী</option>
                    <option value="other"  <%= profileUser.gender === 'other'  ? 'selected' : '' %>>অন্যান্য</option>
                  </select>
                </div>
                <div>
                  <label>জন্ম তারিখ</label>
                  <input class="input" type="date" name="birth_date" value="<%= profileUser.birth_date || '' %>">
                </div>
              </div>
              <h3 style="margin:20px 0 8px;font-size:15px;">সোশ্যাল লিংক</h3>
              <div class="field" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <input class="input" name="social_fb"      value="<%= profileUser.social_fb || '' %>"      placeholder="Facebook URL">
                <input class="input" name="social_twitter"  value="<%= profileUser.social_twitter || '' %>"  placeholder="Twitter URL">
                <input class="input" name="social_linkedin" value="<%= profileUser.social_linkedin || '' %>" placeholder="LinkedIn URL">
                <input class="input" name="social_website"  value="<%= profileUser.social_website || '' %>"  placeholder="ওয়েবসাইট URL">
              </div>
              <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
            </form>
          </div>
        </section>

        <!-- Privacy -->
        <section class="settings-section" data-pane="privacy">
          <div class="card">
            <h2><i class="fas fa-shield-alt"></i> গোপনীয়তা</h2>
            <form method="POST" action="/settings/privacy">
              <div class="field-row">
                <div class="label-block"><strong>ইমেইল দেখান</strong><span>অন্যরা আপনার ইমেইল দেখতে পারবে</span></div>
                <label class="toggle-switch"><input type="checkbox" name="show_email" value="1" <%= profileUser.show_email ? 'checked' : '' %>><span class="toggle-slider"></span></label>
              </div>
              <div class="field-row">
                <div class="label-block"><strong>ফোন নম্বর দেখান</strong><span>অন্যরা আপনার ফোন নম্বর দেখতে পারবে</span></div>
                <label class="toggle-switch"><input type="checkbox" name="show_phone" value="1" <%= profileUser.show_phone ? 'checked' : '' %>><span class="toggle-slider"></span></label>
              </div>
              <div class="field-row">
                <div class="label-block"><strong>জন্ম তারিখ দেখান</strong><span>অন্যরা আপনার জন্ম তারিখ দেখতে পারবে</span></div>
                <label class="toggle-switch"><input type="checkbox" name="show_birth" value="1" <%= profileUser.show_birth ? 'checked' : '' %>><span class="toggle-slider"></span></label>
              </div>
              <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
            </form>
          </div>
        </section>

        <!-- Notifications -->
        <section class="settings-section" data-pane="notifications">
          <div class="card">
            <h2><i class="fas fa-bell"></i> বিজ্ঞপ্তি</h2>
            <form method="POST" action="/settings/notifications">
              <div class="field-row">
                <div class="label-block"><strong>মেনশনে ইমেইল</strong><span>কেউ @উল্লেখ করলে ইমেইল পাঠান</span></div>
                <label class="toggle-switch"><input type="checkbox" name="email_mention" value="1" <%= notifyPrefs.email_mention ? 'checked' : '' %>><span class="toggle-slider"></span></label>
              </div>
              <div class="field-row">
                <div class="label-block"><strong>নতুন মন্তব্যে ইমেইল</strong><span>আপনার পোস্টে মন্তব্য হলে ইমেইল পাঠান</span></div>
                <label class="toggle-switch"><input type="checkbox" name="email_comment" value="1" <%= notifyPrefs.email_comment ? 'checked' : '' %>><span class="toggle-slider"></span></label>
              </div>
              <div class="field-row">
                <div class="label-block"><strong>প্রতিক্রিয়া পুশ</strong><span>❤️ বা 😂 পেলে পুশ নোটিফিকেশন</span></div>
                <label class="toggle-switch"><input type="checkbox" name="push_like" value="1" <%= notifyPrefs.push_like ? 'checked' : '' %>><span class="toggle-slider"></span></label>
              </div>
              <div class="field-row">
                <div class="label-block"><strong>দৈনিক ডাইজেস্ট</strong><span>প্রতিদিন সকালে আপনার ফিডের সারাংশ</span></div>
                <label class="toggle-switch"><input type="checkbox" name="daily_digest" value="1" <%= notifyPrefs.daily_digest ? 'checked' : '' %>><span class="toggle-slider"></span></label>
              </div>
              <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
            </form>
          </div>
        </section>

        <!-- Account -->
        <section class="settings-section" data-pane="account">
          <div class="card">
            <h2><i class="fas fa-key"></i> অ্যাকাউন্ট</h2>

            <h3 style="margin:0 0 12px;font-size:15px;">পাসওয়ার্ড পরিবর্তন</h3>
            <form method="POST" action="/settings/account/password">
              <div class="field"><label>বর্তমান পাসওয়ার্ড</label><input class="input" type="password" name="current_password" required></div>
              <div class="field"><label>নতুন পাসওয়ার্ড</label><input class="input" type="password" name="new_password" required minlength="6"></div>
              <div class="field"><label>পুনরায় নতুন পাসওয়ার্ড</label><input class="input" type="password" name="confirm_password" required minlength="6"></div>
              <button type="submit" class="btn btn-primary">পাসওয়ার্ড পরিবর্তন</button>
            </form>

            <hr style="margin:30px 0;border:none;border-top:1px solid var(--border)">

            <h3 style="margin:0 0 8px;font-size:15px;color:#dc2626;">বিপজ্জনক জোন</h3>
            <p style="color:var(--text-muted);font-size:14px;">এই কার্যগুলো ফিরিয়ে আনা যাবে না।</p>
            <form method="POST" action="/settings/account/deactivate" style="display:inline">
              <button type="submit" class="btn btn-danger"><i class="fas fa-pause"></i> অ্যাকাউন্ট নিষ্ক্রিয় করুন</button>
            </form>
          </div>
        </section>

        <!-- Security (2FA) — সেশন ৫৮ -->
        <section class="settings-section" data-pane="security">
          <div class="card">
            <h2><i class="fas fa-shield-halved"></i> নিরাপত্তা (2FA)</h2>

            <% if (secMsg === 'enrolled') { %><div class="badge save-ok"><i class="fas fa-check"></i> 2FA সক্রিয় হয়েছে। নিচের ব্যাকআপ কোডগুলো এখনই সংরক্ষণ করুন।</div><% } %>
            <% if (secMsg === 'disabled') { %><div class="badge save-ok"><i class="fas fa-check"></i> 2FA বন্ধ করা হয়েছে।</div><% } %>
            <% if (secMsg === 'backup') { %><div class="badge save-ok"><i class="fas fa-rotate"></i> নতুন ব্যাকআপ কোড তৈরি হয়েছে। পুরনো কোডগুলো বাতিল।</div><% } %>
            <% if (secErr === 'bad_code') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> কোড মিলছে না। অ্যাপে দেখানো বর্তমান ৬-অঙ্কের কোড দিন (৩০ সেকেন্ডে বদলায়)।</div><% } %>
            <% if (secErr === 'no_pending') { %><div class="badge save-err"><i class="fas fa-circle-info"></i> কোনো অপেক্ষমাণ সেটআপ নেই। "2FA চালু করুন" দিয়ে নতুন করে শুরু করুন।</div><% } %>
            <% if (secErr === 'password_wrong') { %><div class="badge save-err"><i class="fas fa-exclamation-triangle"></i> বর্তমান পাসওয়ার্ড ভুল।</div><% } %>
            <% if (secErr === 'no_2fa') { %><div class="badge save-err"><i class="fas fa-circle-info"></i> 2FA সক্রিয় নেই।</div><% } %>

            <% if (backupFlash && backupFlash.length) { %>
              <div class="sec-backup-box">
                <h3><i class="fas fa-key"></i> ব্যাকআপ কোড (একবারই দেখানো হয়)</h3>
                <p>ফোন হারিয়ে গেলে বা অ্যাপে ঢুকতে না পারলে লগইনের দ্বিতীয় ধাপে এই কোডগুলোর একটি ব্যবহার করুন। প্রতিটি কোড একবারই কাজ করে — নিরাপদ জায়গায় সংরক্ষণ করুন (লিখে রাখুন বা কপি করে রাখুন)।</p>
                <div class="sec-codes-grid"><% backupFlash.forEach(function (c) { %><div class="sec-code-chip"><%= c %></div><% }) %></div>
                <button type="button" class="btn btn-sm sec-copy-btn" id="secCopyCodes"><i class="fas fa-copy"></i> সব কোড কপি করুন</button>
              </div>
            <% } %>

            <% if (totpEnabled && !secPending) { %>
              <div class="sec-status on">
                <span class="sec-status-ico"><i class="fas fa-shield-halved"></i></span>
                <span class="sec-status-meta">
                  <strong>2FA সক্রিয় আছে</strong>
                  <small>লগইনে পাসওয়ার্ডের পরে অ্যাপের ৬-অঙ্কের কোড চাওয়া হয় — অ্যাকাউন্ট দ্বি-স্তরে সুরক্ষিত।</small>
                </span>
              </div>
              <hr style="margin:22px 0;border:none;border-top:1px solid var(--border);">
              <h3 style="margin:0 0 8px;font-size:15px;"><i class="fas fa-rotate"></i> নতুন ব্যাকআপ কোড</h3>
              <p style="color:var(--text-muted);font-size:13.5px;margin:0 0 10px;">পুরনো ব্যাকআপ কোড হারিয়ে গেলে বা শেষ হয়ে গেলে নতুন সেট তৈরি করুন (পুরনোগুলো বাতিল হয়ে যায়)।</p>
              <form method="POST" action="/settings/security/backup-regen" class="sec-inline-form">
                <div class="field"><label>বর্তমান পাসওয়ার্ড</label><input class="input" type="password" name="current_password" required autocomplete="current-password"></div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-rotate"></i> নতুন কোড তৈরি করুন</button>
              </form>
              <hr style="margin:22px 0;border:none;border-top:1px solid var(--border);">
              <h3 style="margin:0 0 8px;font-size:15px;color:#dc2626;"><i class="fas fa-unlock"></i> 2FA বন্ধ করুন</h3>
              <p style="color:var(--text-muted);font-size:13.5px;margin:0 0 10px;">এতে অ্যাকাউন্ট কম সুরক্ষিত হবে — লগইনে শুধু পাসওয়ার্ড লাগবে। নিশ্চিত হতে বর্তমান পাসওয়ার্ড দিতে হবে।</p>
              <form method="POST" action="/settings/security/disable" class="sec-inline-form" onsubmit="return confirm('2FA বন্ধ করবেন? অ্যাকাউন্ট কম সুরক্ষিত হবে।');">
                <div class="field"><label>বর্তমান পাসওয়ার্ড</label><input class="input" type="password" name="current_password" required autocomplete="current-password"></div>
                <button type="submit" class="btn btn-danger"><i class="fas fa-unlock"></i> 2FA বন্ধ করুন</button>
              </form>
            <% } else if (secPending) { %>
              <div class="sec-enroll">
                <p class="sec-step"><span class="sec-step-num">১</span> Google Authenticator / Authy / 1Password-এ "ম্যানুয়ালি কী দিন" (Setup key) বেছে নিয়ে নিচের সিক্রেট বসান।</p>
                <div class="sec-secret-box"><%= secPending %></div>
                <p class="sec-step"><span class="sec-step-num">২</span> এরপর অ্যাপে দেখানো <b>বর্তমান</b> ৬-অঙ্কের কোড নিচে দিন — মিললেই 2FA সক্রিয় হয়ে যাবে।</p>
                <form method="POST" action="/settings/security/confirm" class="sec-inline-form">
                  <div class="field"><label>৬-অঙ্কের কোড</label><input class="input" type="text" name="totp_code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus placeholder="যেমন: ৪৫৮২১৩"></div>
                  <button type="submit" class="btn btn-primary"><i class="fas fa-shield-halved"></i> সক্রিয় করুন</button>
                </form>
                <p class="hint" style="margin-top:10px;"><i class="fas fa-circle-info"></i> otpauth লিংক (কিউআর/ম্যানুয়াল): <span class="sec-otp"><%= secOtpauth %></span></p>
              </div>
            <% } else { %>
              <div class="sec-status">
                <span class="sec-status-ico"><i class="fas fa-shield"></i></span>
                <span class="sec-status-meta">
                  <strong>2FA সক্রিয় নয়</strong>
                  <small>দ্বি-স্তর যাচাইকরণ (TOTP) চালু করে আপনার আইডি আরও সুরক্ষিত করুন — Google Authenticator-সহ যেকোনো অথেনটিকেটর অ্যাপে বিনামূল্যে কাজ করে।</small>
                </span>
              </div>
              <form method="POST" action="/settings/security/enroll" style="margin-top:14px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-shield-halved"></i> 2FA চালু করুন</button>
              </form>
            <% } %>
          </div>
        </section>

        <!-- Display -->
        <section class="settings-section" data-pane="display">
          <div class="card">
            <h2><i class="fas fa-palette"></i> প্রদর্শন</h2>
            <form method="POST" action="/settings/display">
              <div class="field">
                <label>থিম</label>
                <select class="select" name="theme">
                  <option value="auto" <%= (displayPrefs.theme || 'auto') === 'auto' ? 'selected' : '' %>>অটো (সিস্টেম অনুসারে)</option>
                  <option value="light" <%= displayPrefs.theme === 'light' ? 'selected' : '' %>>হালকা</option>
                  <option value="dark" <%= displayPrefs.theme === 'dark' ? 'selected' : '' %>>গাঢ়</option>
                </select>
              </div>
              <div class="field">
                <label>ফন্ট স্টাইল</label>
                <select class="select" name="font_family">
                  <option value="bn"       <%= (displayPrefs.font_family || 'bn') === 'bn'       ? 'selected' : '' %>>হিন্দ সিলিগুড়ি (সহজ, পড়ার জন্য আদর্শ)</option>
                  <option value="serif"    <%= displayPrefs.font_family === 'serif'             ? 'selected' : '' %>>লিপি মল্লিকা (ক্লাসিক বাংলা সিরিফ)</option>
                  <option value="sans"     <%= displayPrefs.font_family === 'sans'             ? 'selected' : '' %>>সিস্টেম স্ট্যান্ডার্ড (আধুনিক)</option>
                  <option value="mixed"    <%= displayPrefs.font_family === 'mixed'             ? 'selected' : '' %>>মিশ্র (হিন্দ বডি + আখন্দ শীর্ষক)</option>
                  <option value="hand"     <%= displayPrefs.font_family === 'hand'             ? 'selected' : '' %>>বেনসেন (হাতে লেখা স্টাইল)</option>
                  <option value="display"  <%= displayPrefs.font_family === 'display'           ? 'selected' : '' %>>আখন্দ বাংলা (বোল্ড ডিসপ্লে)</option>
                  <option value="durnibar"<%= displayPrefs.font_family === 'durnibar'           ? 'selected' : '' %>>দুর্নিবার (সুন্দর বাংলা সিরিফ)</option>
                  <option value="lipi"    <%= displayPrefs.font_family === 'lipi'             ? 'selected' : '' %>>লিপি মল্লিকা (প্রিমিয়াম সিরিফ)</option>
                </select>
              </div>
              <div class="field">
                <label>ফন্ট সাইজ</label>
                <select class="select" name="font_size">
                  <option value="small"  <%= displayPrefs.font_size === 'small'  ? 'selected' : '' %>>ছোট</option>
                  <option value="medium" <%= (displayPrefs.font_size || 'medium') === 'medium' ? 'selected' : '' %>>মাঝারি</option>
                  <option value="large"  <%= displayPrefs.font_size === 'large'  ? 'selected' : '' %>>বড়</option>
                </select>
              </div>
              <div class="field">
                <label>ভাষা</label>
                <select class="select" name="language">
                  <option value="bn" <%= (displayPrefs.language || 'bn') === 'bn' ? 'selected' : '' %>>বাংলা</option>
                  <option value="en" <%= displayPrefs.language === 'en' ? 'selected' : '' %>>English</option>
                </select>
              </div>
              <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
            </form>
          </div>
        </section>

        <!-- Connected -->
        <section class="settings-section" data-pane="connected">
          <div class="card">
            <h2><i class="fas fa-link"></i> সংযুক্ত অ্যাকাউন্ট</h2>
            <p style="color:var(--text-muted);">আপনার সোশ্যাল অ্যাকাউন্ট সংযুক্ত করে দ্রুত লগইন ও ক্রস-পোস্টিং করুন।</p>
            <div class="connected-list ca-fb" style="margin-top:16px;">
              <div class="ca-row">
                <span class="ca-ico" style="--ca:#1877f2"><i class="fab fa-facebook-f"></i></span>
                <span class="ca-meta">
                  <strong>Facebook</strong>
                  <small>পোস্ট স্বয়ংক্রিয়ভাবে পেজে শেয়ার ও এক-ক্লিক লগইন</small>
                </span>
                <span class="ca-state off">সংযুক্ত নয়</span>
                <button class="btn btn-primary btn-sm ca-btn">সংযুক্ত করুন</button>
              </div>
              <div class="ca-row">
                <span class="ca-ico" style="--ca:#ea4335"><i class="fab fa-google"></i></span>
                <span class="ca-meta">
                  <strong>Google</strong>
                  <small>জিমেইল দিয়ে সাইন-ইন ও ক্যালেন্ডার রিমাইন্ডার</small>
                </span>
                <span class="ca-state off">সংযুক্ত নয়</span>
                <button class="btn btn-primary btn-sm ca-btn">সংযুক্ত করুন</button>
              </div>
              <div class="ca-row">
                <span class="ca-ico" style="--ca:#111"><i class="fab fa-x-twitter"></i></span>
                <span class="ca-meta">
                  <strong>Twitter / X</strong>
                  <small>লেখা প্রকাশমাত্র থ্রেড হিসেবে পোস্ট</small>
                </span>
                <span class="ca-state off">সংযুক্ত নয়</span>
                <button class="btn btn-primary btn-sm ca-btn">সংযুক্ত করুন</button>
              </div>
              <div class="ca-row">
                <span class="ca-ico" style="--ca:#229ed9"><i class="fab fa-telegram-plane"></i></span>
                <span class="ca-meta">
                  <strong>Telegram</strong>
                  <small>চ্যানেলে নোটিশ ও নতুন লেখার আপডেট</small>
                </span>
                <span class="ca-state off">সংযুক্ত নয়</span>
                <button class="btn btn-primary btn-sm ca-btn">সংযুক্ত করুন</button>
              </div>
            </div>
            <div class="hint" style="margin-top:12px"><i class="fas fa-shield-alt"></i> সংযোগের অনুমতি শুধু আপনার প্রোফাইলের পাবলিক তথ্যের মধ্যে সীমাবদ্ধ থাকে।</div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
    (function () {
      function activate(target) {
        document.querySelectorAll('.settings-nav a').forEach(l => l.classList.remove('active'));
        const link = document.querySelector('.settings-nav a[data-section="' + target + '"]');
        if (link) link.classList.add('active');
        document.querySelectorAll('.settings-section').forEach(s => s.classList.remove('active'));
        const pane = document.querySelector('[data-pane="' + target + '"]');
        if (pane) pane.classList.add('active');
      }
      document.querySelectorAll('.settings-nav a').forEach(link => {
        link.addEventListener('click', e => {
          e.preventDefault();
          activate(link.dataset.section);
          if (history.replaceState) history.replaceState(null, '', '#' + link.dataset.section);
        });
      });
      // সেশন ৫৮: #security হ্যাশ বা ?sec=/secerr= কোয়েরিতে নিরাপত্তা-ট্যাব স্বয়ংক্রিয়ভাবে খোলে
      var q = new URLSearchParams(location.search);
      var autoSec = (location.hash === '#security') || q.has('sec') || q.has('secerr');
      if (autoSec) activate('security');
      else if (location.hash && document.querySelector('[data-pane="' + location.hash.slice(1) + '"]')) activate(location.hash.slice(1));
      // ব্যাকআপ-কোড কপি বাটন
      var cp = document.getElementById('secCopyCodes');
      if (cp) cp.addEventListener('click', function () {
        var codes = Array.from(document.querySelectorAll('.sec-code-chip')).map(function (c) { return c.textContent.trim(); }).join('\n');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(codes).then(function () {
            cp.innerHTML = '<i class="fas fa-check"></i> কপি হয়েছে';
            setTimeout(function () { cp.innerHTML = '<i class="fas fa-copy"></i> সব কোড কপি করুন'; }, 1800);
          }).catch(function () {});
        }
      });
    })();
  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
