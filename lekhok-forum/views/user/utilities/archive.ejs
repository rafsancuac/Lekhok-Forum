<%# সেশন ১৫৬ — ঐতিহাসিক আর্কাইভ (DB-বছর-গ্রুপিং; ইউজার-স্পেক ইউটিলিটি) %>
<%- include('../../partials/header', { title: meta.title + ' | লেখক ফোরাম', extra_css: ['/assets/css/utilities.css'] }) %>
  <%
    var toBnD = function (s) { return String(s).replace(/\d/g, function (c) { return '০১২৩৪৫৬৭৮৯'[+c]; }); };
    var totalAll = yearGroups.reduce(function (a, g) { return a + g.total; }, 0);
  %>
  <div class="utl-wrap">
    <div class="utl-hero" style="--utl-t: <%= meta.tok %>">
      <span class="utl-hero-ico"><i class="fas <%= meta.icon %>" aria-hidden="true"></i></span>
      <div class="utl-hero-text">
        <span class="utl-crumb"><i class="fas fa-toolbox" aria-hidden="true"></i> <%= meta.crumbs %></span>
        <h1><%= meta.title %></h1>
        <p>
          <%= meta.desc %>
          <% if (oldest && newest) { %>
            — <%= toBnD(oldest.yr) %> থেকে <%= toBnD(newest.yr) %> অবধি <%= toBnD(totalAll) %>টি প্রকাশনা।
          <% } else { %>
            — এখনো আর্কাইভ-উপযোগী প্রকাশনা সংগৃহীত হয়নি।
          <% } %>
        </p>
      </div>
    </div>

    <% if (yearGroups.length === 0) { %>
      <div class="utl-card">
        <h2><i class="fas fa-box-open" aria-hidden="true"></i> আর্কাইভ শূন্য</h2>
        <p class="utl-sub">প্রথম প্রকাশিত লেখাটি ছাপা হলেই এই আর্কাইভ স্বয়ংক্রিয়ভাবে সাজানো শুরু হবে।</p>
        <a href="/articles" class="utl-btn"><i class="fas fa-pen-nib" aria-hidden="true"></i> সকল লেখা দেখুন</a>
      </div>
    <% } else { %>
      <div class="utl-card">
        <h2><i class="fas fa-layer-group" aria-hidden="true"></i> বছর-ভিত্তিক সংগ্রহ</h2>
        <p class="utl-sub">প্রতিটি বছরের মোট প্রকাশনা, লেখা/প্রশ্ন ভাগ ও পাঠ-পরিসংখ্যান + সেরা-পঠিত ৩টি লেখার ঝলক।</p>
        <div class="utl-year-grid">
          <% yearGroups.forEach(function (g) { %>
            <div class="utl-year">
              <div class="utl-year-val"><%= toBnD(g.yr) %></div>
              <div class="utl-year-cnt">
                <%= toBnD(g.total) %>টি প্রকাশনা · লেখা <%= toBnD(g.articles || 0) %> · প্রশ্ন <%= toBnD(g.questions || 0) %> · পাঠ <%= toBnD(g.views || 0) %>
              </div>
              <% var hl = highlights[g.yr] || []; %>
              <% if (hl.length) { %>
                <div class="utl-hl">
                  <% hl.forEach(function (h) { %>
                    <a href="/articles/<%= h.id %>"><i class="fas fa-bookmark" aria-hidden="true" style="font-size:9px;margin-right:4px"></i><%= h.title %></a>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="utl-card">
        <h2><i class="fas fa-hand-holding-heart" aria-hidden="true"></i> আর্কাইভে অবদান</h2>
        <p class="utl-sub">পুরোনো মুদ্রিত সংখ্যা, বিরল প্রকাশনা বা ডিজিটাল-কপি সংরক্ষণে সহায়তা করতে চাইলে স্টাফকে জানান।</p>
        <a href="/contact" class="utl-btn utl-btn--ghost"><i class="fas fa-envelope" aria-hidden="true"></i> যোগাযোগ করুন</a>
      </div>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
<%- include('../../partials/sandbox-preview') %>
</body>
</html>
