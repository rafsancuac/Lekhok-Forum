      let olderState = { hasOlder: olderWrap.dataset.has === '1', oldestId: parseInt(olderWrap.dataset.oldest, 10) || 0, busy: false };

      function pulse93(el) {
        if (!el) return;
        el.classList.add('msg-jump-hl');
        try { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch (_) { el.scrollIntoView({ block: 'center' }); }
        setTimeout(() => el.classList.remove('msg-jump-hl'), 3400);
      }
      function jumpToMsg(id) {
        const t = body.querySelector('.bubble[data-id="' + id + '"]');
        if (t) { pulse93(t); return true; }
        /* উইন্ডোর-বাইরে — around-উইন্ডো-রিলোড (সার্ভার কনটেক্সটসহ রেন্ডার করবে) */
        location.href = location.pathname + '?around=' + id + '&hl=' + id;
        return false;
      }
      window.lfMsgJump93 = jumpToMsg;

      async function loadOlder() {
        if (!olderState.hasOlder || olderState.busy || !convId) return;
        olderState.busy = true;
        if (olderBtn) olderBtn.hidden = true;
        if (olderSpin) olderSpin.hidden = false;
        try {
          const res = await fetch('/api/messages/older?conv_id=' + convId + '&before=' + olderState.oldestId);
          const d = await res.json();
          if (d.ok && d.html) {
            const st = body.scrollTop, sh = body.scrollHeight;
            body.insertAdjacentHTML('afterbegin', d.html);
            body.scrollTop = body.scrollHeight - sh + st; /* স্ক্রল-অ্যাংকর মানি (ব্যাচ-অ্যারাইভাল-নীতি) */
            olderState.hasOlder = !!d.hasOlder;
            if (d.oldestId) olderState.oldestId = d.oldestId;
            olderWrap.dataset.has = olderState.hasOlder ? '1' : '0';
            olderWrap.dataset.oldest = String(olderState.oldestId);
            if (window.lfMsgSearchRefresh) try { window.lfMsgSearchRefresh(); } catch (_) {}
          } else { olderState.hasOlder = false; }
        } catch (_) { /* নেটওয়ার্ক-ব্যর্থতায় বাটন ফেরত */ }
        if (olderSpin) olderSpin.hidden = true;
        if (olderState.hasOlder) { if (olderBtn) olderBtn.hidden = false; }
        else if (olderEnd) olderEnd.hidden = false;
        olderState.busy = false;
      }
      if (olderBtn) olderBtn.addEventListener('click', loadOlder);
      /* উপরে-স্ক্রলে অটো-লোড (সার্চ-সক্রিয় অবস্থায় নয় — ফিল্টার-ভাঙা এড়াতে) */
      body.addEventListener('scroll', function () {
        const si = document.getElementById('convInSearch');
        if (si && si.value.trim()) return;
        if (body.scrollTop < 90 && olderState.hasOlder && !olderState.busy) loadOlder();
      }, { passive: true });

      /* রিপ্লাই-কোট ক্লিকে মূল-বার্তায় জাম্প (FB/WhatsApp-প্যাটার্ন) */
      body.addEventListener('click', function (e) {
        const q = e.target.closest('.bubble-quote');
        if (!q) return;
