<%# সেশন ৭৫ — ফেসবুক মেসেঞ্জার-স্টাইল চ্যাট-ভিউ (৩-কলাম: লিস্ট + চ্যাট + ডিটেইলস) %>
<%- include('../partials/header', { title: (other.full_name) + ' | মেসেজ | লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css', '/assets/css/messenger.css', '/assets/css/calls.css'] }) %>

<%
  // ── ক্লাস্টার-হেল্পার: পরপর একই প্রেরকের বাবল গুচ্ছ বাঁধে (FB-আচরণ) ──
  function clusterInfo(list, idx) {
    var m = list[idx], p = list[idx - 1] || null, n = list[idx + 1] || null;
    var t = function (x) { return new Date(x.created_at).getTime(); };
    var samePrev = p && p.sender_id === m.sender_id && (t(m) - t(p) < 3 * 60 * 1000);
    var sameNext = n && n.sender_id === m.sender_id && (t(n) - t(m) < 3 * 60 * 1000);
    return { samePrev: !!samePrev, sameNext: !!sameNext };
  }
  function dateLabel(ds) {
    var d = new Date(ds); d.setHours(0, 0, 0, 0);
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var diff = Math.round((today - d) / 86400000);
    if (diff === 0) return 'আজ';
    if (diff === 1) return 'গতকাল';
    return d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  var _isImg = function (u) { return u && /\.(jpe?g|png|gif|webp|svg|bmp)$/i.test(u); };
  /* সেশন ৯২: ভয়েস/অডিও ফাইল শনাক্তকারী — voice-note বাবল-প্লেয়ারের ভিত্তি */
  var _isAud = function (u) { return u && /\.(webm|ogg|oga|m4a|mp3|wav|aac|opus)$/i.test(u); };
  /* সেশন ৯৩: ডিটেইলস-প্যানেল + সিন-মার্কার এখন রুট-লেভেলে পূর্ণ-ইতিহাস থেকে গণনা হয়
     (উইন্ডোিং চালু — প্রাথমিক রেন্ডার সর্বশেষ ৬০টি; ডিটেইলস-ট্যাব তবুও সম্পূর্ণ) */
  var _sharedImgs = chatShared.imgs;
  var _sharedDocs = chatShared.docs;
  var _sharedVn = chatShared.voice;
  var _sharedLinks = chatShared.links;
%>

  <div class="page-wrap page-wrap--messenger">
    <div class="messenger-shell has-details" id="messengerShell">

      <%# ── বাম: কথোপকথন-তালিকা ──────────────────────────────────────── %>
      <aside class="messenger-list" id="messengerList">
        <div class="messenger-list-head">
          <div class="msg-head-row">
            <h2><i class="fas fa-comment-dots"></i> চ্যাট</h2>
            <a href="/messages" class="fb-icon-btn" style="margin-left:auto" title="সব কথোপকথন"><i class="fas fa-arrow-left"></i></a>
          </div>
          <div class="msg-search-wrap" id="msgSearchWrap">
            <i class="fas fa-search msg-search-icon"></i>
            <input type="search" class="messenger-search msg-search-input" id="convSearch" placeholder="মেসেঞ্জারে খুঁজুন" autocomplete="off" />
            <button type="button" class="msg-search-clear" id="convSearchClear" hidden><i class="fas fa-times"></i></button>
          </div>
          <div class="msg-search-results" id="convSearchResults" hidden>
            <div class="msr-section" id="csrConversations" hidden>
              <div class="msr-section-head"><span><i class="fas fa-comments"></i> কথোপকথন</span><span class="msr-count" id="csrConvCount"></span></div>
              <div id="csrConvList"></div>
            </div>
            <div class="msr-section" id="csrUsers" hidden>
              <div class="msr-section-head"><span><i class="fas fa-user-plus"></i> নতুন কথোপকথন</span><span class="msr-count" id="csrUserCount"></span></div>
              <div id="csrUserList"></div>
            </div>
            <div class="msr-empty" id="csrEmpty" hidden><i class="fas fa-search"></i><p>কোনো ফলাফল নেই</p></div>
          </div>
        </div>
        <% if (!conversations.length) { %>
          <div class="empty-state-full">
            <i class="fas fa-comment-slash"></i>
            <p>এখনো কোনো কথোপকথন নেই।</p>
            <a href="/members" class="fb-icon-btn fb-icon-btn--accent" style="width:auto;padding:0 16px;height:34px;border-radius:99px;font-weight:700;font-size:13px">সদস্য খুঁজুন</a>
          </div>
        <% } %>
        <% conversations.forEach(c => { %>
          <a href="<%= c.conv_link || ('/messages/' + c.other_username) %>" class="conv-item <%= !isGroup && c.other_username === other.username ? 'active' : '' %> <%= isGroup && c.id === conv.id ? 'active' : '' %> <%= c.is_group_flag ? 'is-group' : '' %>" data-name="<%= c.other_name.toLowerCase() %>" data-id="<%= c.id %>">
            <div class="avatar avatar-md" style="position:relative">
              <% if (c.is_group_flag) { %>
              <span class="group-avatar"><i class="fas fa-users"></i></span>
              <% } else { %>
              <img loading="lazy" decoding="async" src="<%= c.other_avatar || ('/avatar/' + (c.user_a === user.id ? c.user_b : c.user_a)) %>" alt="<%= c.other_name %>" onerror="this.onerror=null;this.src='/avatar/<%= c.user_a === user.id ? c.user_b : c.user_a %>'" />
              <span class="online-dot" data-user-id="<%= c.user_a === user.id ? c.user_b : c.user_a %>" style="display:none"></span>
              <% } %>
            </div>
            <div class="conv-meta">
              <div class="conv-name"><%= c.other_name %></div>
              <div class="conv-snippet"><%= c.last_body ? c.last_body.replace(/<[^>]+>/g, '').slice(0, 42) : 'নতুন কথোপকথন' %></div>
            </div>
            <div class="conv-meta-right">
              <% if (c.unread_count > 0) { %><span class="conv-unread"><%= c.unread_count %></span><% } %>
              <span class="conv-mute-tag" hidden title="মিউট করা"><i class="fas fa-bell-slash"></i></span>
              <span class="conv-menu-btn" role="button" tabindex="0" aria-label="কথোপকথন-অপশন" data-conv-menu="<%= c.id %>"><i class="fas fa-ellipsis"></i></span>
            </div>
          </a>
        <% }); %>
      </aside>

      <%# ── মাঝ: মূল চ্যাট ─────────────────────────────────────────────── %>
      <section class="messenger-chat" id="messengerChat">
        <% if (typeof err !== 'undefined' && err) { %>
          <div class="chat-error"><i class="fas fa-exclamation-triangle"></i> <%= err %></div>
        <% } %>
        <%# সেশন ৮৬: গ্রুপ-সংযোজন রোল-নীতি নোটিশ (দৃশ্যমান — চ্যাটের একদম উপরে) %>
        <% if (typeof blocked !== 'undefined' && blocked) { %>
          <div style="background:#fef3c7;border-bottom:1px solid #fde68a;color:#92400e;font-size:13px;padding:9px 16px;display:flex;gap:9px;align-items:flex-start;">
            <i class="fas fa-shield-halved" style="margin-top:2px;"></i><span><%= blocked %> জন সদস্য যুক্ত করা যায়নি — রোল-নীতি (পাশাপাশি পদের মধ্যে সরাসরি সংযোগ বন্ধ)।</span>
          </div>
        <% } %>
        <header class="chat-header">
          <button class="back-btn" id="fbBackBtn" title="ফিরে যান">
            <i class="fas fa-chevron-left"></i>
          </button>
          <div class="avatar avatar-md" style="position:relative">
            <img loading="lazy" decoding="async" src="<%= other.avatar_url || ('/avatar/' + other.id) %>" alt="<%= other.full_name %>" onerror="this.onerror=null;this.src='/avatar/<%= other.id %>'" />
            <span class="online-dot" id="otherOnlineDot" data-user-id="<%= other.id %>" style="display:none"></span>
          </div>
          <div class="info">
            <h3><% if (isGroup) { %><i class="fas fa-users" style="color:var(--fb-blue);font-size:13px"></i> <%= other.full_name %><% } else { %><a href="/profile/<%= other.username %>"><%= other.full_name %></a><% } %></h3>
            <div class="status" id="otherStatus">
              <% if (isGroup) { %><i class="fas fa-users" style="font-size:9px"></i> <%= members.length %> সদস্য<% } else { %><i class="fas fa-circle" style="font-size:6px"></i> <span id="otherStatusText"><%= other.online_text || '@' + other.username %></span><% } %>
            </div>
          </div>
          <div class="conv-insearch">
            <i class="fas fa-search"></i>
            <input type="search" id="convInSearch" placeholder="মেসেজ খুঁজুন..." autocomplete="off" />
            <button type="button" class="cis-clear" id="cisClear" hidden title="খোঁজা বন্ধ (Esc)"><i class="fas fa-times"></i></button>
          </div>
          <%# সেশন ৮৯ (C2): ম্যাচ-কাউন্টার + ↑↓ নেভিগেশন — সার্চ-অ্যাকটিভ হলেই দৃশ্যমান %>
          <div class="cis-tools" id="cisTools" hidden>
            <span class="cis-counter" id="cisCounter">০/০</span>
            <button type="button" class="cis-nav" id="cisPrev" title="আগের ম্যাচ (Shift+Enter)"><i class="fas fa-chevron-up"></i></button>
            <button type="button" class="cis-nav" id="cisNext" title="পরের ম্যাচ (Enter)"><i class="fas fa-chevron-down"></i></button>
            <button type="button" class="cis-nav" id="cisServerBtn" title="পুরনো বার্তাসহ সব ম্যাচ (সার্ভার-সার্চ)"><i class="fas fa-list"></i></button>
          </div>
          <%# সেশন ৯৩: সার্ভার-সাইড সার্চ-ফলাফল ড্রপডাউন (রোডম্যাপ-১১ — উইন্ডোর-বাইরের পুরনো বার্তা) %>
          <div class="cis-server" id="cisServer" hidden>
            <div class="css-head"><span id="cisServerTitle">পুরনো বার্তায় ম্যাচ</span><button type="button" id="cisServerClose" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button></div>
            <div class="css-list" id="cisServerList"></div>
          </div>
          <div class="fb-chat-actions">
            <% if (!isGroup) { %>
            <button type="button" class="fb-icon-btn" title="অডিও কল" onclick="LekhokCall.start('audio')" aria-label="<%= other.full_name %>-কে অডিও কল দিন"><i class="fas fa-phone"></i></button>
            <button type="button" class="fb-icon-btn" title="ভিডিও কল" onclick="LekhokCall.start('video')" aria-label="<%= other.full_name %>-কে ভিডিও কল দিন"><i class="fas fa-video"></i></button>
            <% } %>
            <button type="button" class="fb-icon-btn" id="fbInfoBtn" title="তথ্য প্যানেল"><i class="fas fa-circle-info"></i></button>
          </div>
        </header>

        <%# ── সেশন ৭৬: থিম-স্ট্রিপ (চ্যাট-হেডারের নিচে রঙিন ৩px ব্যান্ড, FB-থিমের মতো) ── %>
        <div class="chat-theme-strip" aria-hidden="true"></div>

        <% if (isGroup) { %>
        <% var _gAdmin = conv.user_a === user.id; %>
        <div id="grpPanel" style="display:none;border-bottom:1px solid var(--fb-border);background:#fff;padding:10px 14px;">
          <% if (note === 'added') { %><div style="color:#31A24C;font-size:13px;margin-bottom:6px;"><i class="fas fa-check-circle"></i> সদস্য যোগ করা হয়েছে।</div><% } %>
          <% if (note === 'removed') { %><div style="color:#31A24C;font-size:13px;margin-bottom:6px;"><i class="fas fa-check-circle"></i> সদস্য বাদ দেওয়া হয়েছে।</div><% } %>
          <% if (err === 'perm') { %><div style="color:#e41e3f;font-size:13px;margin-bottom:6px;"><i class="fas fa-exclamation-circle"></i> শুধু গ্রুপ অ্যাডমিন সদস্য যোগ/বাদ করতে পারেন।</div><% } %>
          <% if (err === 'self') { %><div style="color:#e41e3f;font-size:13px;margin-bottom:6px;"><i class="fas fa-exclamation-circle"></i> নিজেকে বা অ্যাডমিনকে বাদ দেওয়া যাবে না।</div><% } %>
          <% if (err === 'owner') { %><div style="color:#e41e3f;font-size:13px;margin-bottom:6px;"><i class="fas fa-exclamation-circle"></i> গ্রুপ ক্রিয়েটর গ্রুপ ছাড়তে পারবেন না।</div><% } %>
          <div style="font-size:12px;font-weight:700;color:#65676B;margin-bottom:6px;">সদস্য তালিকা (<%= members.length %>)</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;">
            <% members.forEach(mm => { %>
              <span class="md-member"><img src="<%= mm.avatar_url || ('/avatar/' + mm.id) %>" style="width:20px;height:20px;border-radius:50%;object-fit:cover" alt="" /><%= mm.full_name %><% if (mm.id === conv.user_a) { %><i class="fas fa-crown" style="color:#d4a017;font-size:10px" title="গ্রুপ অ্যাডমিন"></i><% } %>
                <% if (_gAdmin && mm.id !== user.id && mm.id !== conv.user_a) { %>
                <form method="POST" action="/messages/g/<%= conv.id %>/members/<%= mm.id %>/remove" style="display:inline"><button type="submit" style="border:0;background:none;color:#e41e3f;cursor:pointer;padding:0;font-size:12px" title="বাদ দিন"><i class="fas fa-times"></i></button></form>
                <% } %>
              </span>
            <% }) %>
          </div>
          <% if (_gAdmin) { %>
          <form method="POST" action="/messages/g/<%= conv.id %>/members/add" style="display:flex;gap:6px;">
            <input type="text" name="members" placeholder="ইউজারনেম (কমা দিয়ে একাধিক)" required style="flex:1;padding:8px 14px;border:none;border-radius:99px;font-family:inherit;font-size:13px;background:#F0F2F5;" />
            <button type="submit" class="fb-icon-btn fb-icon-btn--accent" style="width:auto;padding:0 16px;font-weight:700;font-size:13px"><i class="fas fa-user-plus"></i> যোগ</button>
          </form>
          <% } else { %>
          <form method="POST" action="/messages/g/<%= conv.id %>/leave" style="display:inline">
            <button type="submit" class="md-link md-link--danger" style="margin:0;width:auto"><i class="fas fa-sign-out-alt"></i> গ্রুপ ছাড়ুন</button>
          </form>
          <% } %>
        </div>
        <% } %>

        <div class="chat-body" id="chatBody">
          <%# ── সেশন ৯৩: আগের-বার্তা লোডার (রোডম্যাপ-১১ উইন্ডোিং — FB/WhatsApp-প্যাটার্ন) ── %>
          <div class="older-wrap" id="olderWrap" data-has="<%= olderState.hasOlder ? 1 : 0 %>" data-oldest="<%= olderState.oldestId || 0 %>">
            <button type="button" class="older-btn" id="olderBtn" <%= olderState.hasOlder ? '' : 'hidden' %>>
              <i class="fas fa-arrow-up"></i> আগের বার্তা দেখুন
            </button>
            <span class="older-spinner" id="olderSpinner" hidden><i class="fas fa-circle-notch fa-spin"></i> লোড হচ্ছে…</span>
            <span class="older-end" id="olderEnd" <%= olderState.hasOlder ? 'hidden' : '' %>><i class="fas fa-flag"></i> চ্যাটের শুরু</span>
          </div>
          <%- include('../partials/chat-bubbles', { cbList: messages, cbPrev: null, cbNext: null, cbLastOwnReadId: (typeof lastOwnReadId !== 'undefined' && lastOwnReadId) || 0, clusterInfo, dateLabel, _isImg, _isAud }) %>
          <div class="typing-indicator" id="typingIndicator">
            <img class="ti-av" src="<%= isGroup ? '/avatar/0' : (other.avatar_url || ('/avatar/' + other.id)) %>" alt="" />
            <div class="ti-bubble">
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
              <span class="ti-label">লিখছেন…</span>
            </div>
          </div>
        </div>

        <%# ── সেশন ৭৮: কুইক-রিপ্লাই চিপস (বাংলা দ্রুত-উত্তর) ── %>
        <div class="qr-chips" id="qrChips" role="toolbar" aria-label="দ্রুত উত্তর">
          <% ['স্যালাম', 'জি বলুন', 'কেমন আছেন?', 'ঠিক আছে 👍', 'ধন্যবাদ 🙏', 'শীঘ্রই জানাচ্ছি', 'আপনার লেখা পড়েছি ✍️', 'শুভকামনা 🎉'].forEach(t => { %>
            <button type="button" class="qr-chip" data-qr="<%= t %>"><%= t %></button>
          <% }); %>
        </div>

        <%# ── সেশন ৭৮: ফাইল-প্রিভিউ — ইনপুটের উপরে, শুধু ফাইল থাকলেই দৃশ্যমান (থাম্বনেইল+সাইজ+টাইপ-আইকন) ── %>
        <div class="file-preview" id="filePreview" hidden>
          <i class="fas fa-paperclip" id="filePreviewIcon"></i>
          <img id="filePreviewThumb" class="fp-thumb" alt="" hidden />
          <div class="fp-meta">
            <div class="fp-name" id="filePreviewName"></div>
            <div class="fp-size" id="filePreviewSize"></div>
          </div>
          <button type="button" id="filePreviewRemove" aria-label="সরান" title="সরান">&times;</button>
        </div>

        <%# সেশন ৯৩: around-মোড (সার্চ-জাম্প) — সর্বশেষ বার্তায় ফেরার পিল %>
        <% if (typeof aroundMode !== 'undefined' && aroundMode) { %>
        <div class="jump-now-wrap"><a class="jump-now-btn" href="<%= isGroup ? ('/messages/g/' + conv.id) : ('/messages/' + other.username) %>"><i class="fas fa-arrow-down"></i> সর্বশেষ বার্তায় ফিরুন</a></div>
        <% } %>

        <form method="POST" class="chat-input-bar" enctype="multipart/form-data" id="chatForm">
          <%# সেশন ৭৬: রিপ্লাই/এডিট বার (ইনপুট-বারের উপরে FB-স্টাইল) %>
          <div class="reply-bar" id="replyBar" hidden>
            <span class="rb-ic"><i class="fas fa-reply"></i></span>
            <div class="rb-body"><span class="rb-name" id="replyBarName"></span><span class="rb-text" id="replyBarText"></span></div>
            <button type="button" class="rb-x" id="replyBarCancel" aria-label="উত্তর বাতিল"><i class="fas fa-times"></i></button>
          </div>
          <div class="reply-bar edit-bar" id="editBar" hidden>
            <span class="rb-ic"><i class="fas fa-pen"></i></span>
            <div class="rb-body"><span class="rb-name">মেসেজ সম্পাদনা</span><span class="rb-text" id="editBarText"></span></div>
            <button type="button" class="rb-x" id="editBarCancel" aria-label="সম্পাদনা বাতিল"><i class="fas fa-times"></i></button>
          </div>
          <input type="hidden" name="reply_to" id="replyToInput" value="" />
          <label for="fileInput" class="ci-icon" title="ছবি বা ফাইল যুক্ত করুন"><i class="fas fa-plus"></i></label>
          <input type="file" id="fileInput" name="attachment" style="display:none" />
          <%# সেশন ৯২: ভয়েস-নোট রেকর্ড বাটন (MediaRecorder — FB-মেসেঞ্জার আচরণ) %>
          <button type="button" class="ci-icon ci-mic" id="micBtn" title="ভয়েস মেসেজ রেকর্ড করুন" aria-label="ভয়েস মেসেজ রেকর্ড করুন"><i class="fas fa-microphone"></i></button>
          <div class="chat-input-wrap">
            <%# সেশন ৮০: input → auto-grow textarea — Shift+Enter এখন আসলেই নতুন লাইন (FB-আচরণ), পেস্ট-টার্গেট %>
            <textarea name="body" id="msgInput" rows="1" placeholder="Aa" autocomplete="off"></textarea>
            <%# সেশন ৯২: রেকর্ডিং-স্টেট UI (টেক্সটএরিয়ার জায়গায় — লাল পালস + টাইমার + বাতিল/পাঠান) %>
            <div class="voice-rec" id="voiceRec" hidden>
              <span class="vr-dot" aria-hidden="true"></span>
              <span class="vr-time" id="vrTime">০:০০</span>
              <span class="vr-wave" aria-hidden="true"><% for (var _vi = 0; _vi < 18; _vi++) { %><i></i><% } %></span>
              <button type="button" class="vr-cancel" id="vrCancel" title="বাতিল করুন" aria-label="রেকর্ডিং বাতিল"><i class="fas fa-trash"></i></button>
              <button type="button" class="vr-send" id="vrSend" title="পাঠান" aria-label="ভয়েস মেসেজ পাঠান"><i class="fas fa-paper-plane"></i></button>
            </div>
            <button type="button" class="emoji-trigger" id="emojiBtn" title="ইমোজি"><i class="far fa-smile"></i></button>
            <div class="emoji-picker" id="emojiPicker">
              <% ['😀','😃','😄','😁','😆','😂','🤣','😊','😇','🙂','😉','😍','🥰','😘','😋','😜','🤔','😎','👍','👎','👏','🙏','💪','❤️','🔥','✨','🎉','📝','📚','✍️'].forEach(em => { %>
                <button type="button" class="emoji-pick" onclick="insertEmoji('<%= em %>')"><%= em %></button>
              <% }); %>
            </div>
          </div>
          <button type="submit" class="btn btn-primary is-like" id="sendBtn" title="পাঠান"><span style="font-size:20px;line-height:1">👍</span></button>
        </form>

        <%# ── সেশন ৭৮: স্ক্রল-টু-বটম FAB (নতুন-মেসেজ ব্যাজসহ) ── %>
        <button type="button" class="jump-btn" id="jumpBtn" aria-label="সবচেয়ে নিচে যান" title="সবচেয়ে নিচে যান">
          <i class="fas fa-chevron-down"></i>
          <span class="jump-badge"></span>
        </button>

        <%# ── সেশন ৮০: ড্র্যাগ-অ্যান্ড-ড্রপ ওভারলে (ফাইল টেনে এনে ছাড়লে পুরো চ্যাটে নীল ড্যাশড জোন) ── %>
        <div class="drop-overlay" id="dropOverlay" aria-hidden="true">
          <div class="drop-inner">
            <i class="fas fa-cloud-arrow-up" aria-hidden="true"></i>
            <span>ছবি বা ফাইল এখানে ছেড়ে দিন</span>
          </div>
        </div>
      </section>

      <%# ── ডান: ডিটেইলস-প্যানেল (≥১০২৪px) ─────────────────────────────── %>
      <aside class="messenger-details" id="fbDetails">
        <div class="md-close"><button type="button" id="fbDetailsClose" title="বন্ধ করুন"><i class="fas fa-times"></i></button></div>
        <div class="md-profile">
          <div class="mdp-avwrap">
            <% if (isGroup) { %>
              <div class="mdp-av" style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#1877F2,#7c3aed);color:#fff;display:flex;align-items:center;justify-content:center;font-size:26px"><i class="fas fa-users"></i></div>
            <% } else { %>
              <img class="mdp-av" src="<%= other.avatar_url || ('/avatar/' + other.id) %>" onerror="this.src='/avatar/<%= other.id %>'" alt="<%= other.full_name %>" />
              <span class="mdp-dot" id="mdpDot" style="display:none"></span>
            <% } %>
          </div>
          <div class="mdp-name"><%= other.full_name %></div>
          <div class="mdp-sub"><% if (isGroup) { %><%= members.length %> সদস্য · গ্রুপ কথোপকথন<% } else { %>@<%= other.username %><% } %></div>
          <% if (!isGroup) { %>
            <a href="/profile/<%= other.username %>" class="mdp-btn mdp-btn--blue"><i class="fas fa-user"></i> প্রোফাইল দেখুন</a>
          <% } else { %>
            <button type="button" class="mdp-btn" onclick="var p=document.getElementById('grpPanel');p.style.display=(p.style.display==='none'||!p.style.display)?'block':'none';p.scrollIntoView({behavior:'smooth',block:'center'})"><i class="fas fa-users-cog"></i> সদস্য ব্যবস্থাপনা</button>
          <% } %>
        </div>
        <div class="md-section">
          <h4><i class="fas fa-palette"></i> চ্যাট থিম</h4>
          <div class="md-themes" id="mdThemes">
            <button type="button" class="md-theme" data-theme="default" title="ডিফল্ট"><span class="mdt-dot" style="background:#0084FF"></span>ডিফল্ট</button>
            <button type="button" class="md-theme" data-theme="mint" title="মিন্ট"><span class="mdt-dot" style="background:linear-gradient(135deg,#059669,#14b8a6)"></span>মিন্ট</button>
            <button type="button" class="md-theme" data-theme="rose" title="গোলাপি"><span class="mdt-dot" style="background:linear-gradient(135deg,#e11d48,#fb7185)"></span>গোলাপি</button>
            <button type="button" class="md-theme" data-theme="sunset" title="সূর্যাস্ত"><span class="mdt-dot" style="background:linear-gradient(135deg,#f59e0b,#ef4444)"></span>সূর্যাস্ত</button>
            <button type="button" class="md-theme" data-theme="violet" title="বেগুনি"><span class="mdt-dot" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)"></span>বেগুনি</button>
            <button type="button" class="md-theme" data-theme="forest" title="অরণ্য"><span class="mdt-dot" style="background:linear-gradient(135deg,#15803d,#22c55e)"></span>অরণ্য</button>
          </div>
          <div class="md-theme-note" id="mdThemeNote">নিজের ডিভাইসে প্রযোজ্য</div>
        </div>
        <%# ── সেশন ৮০: মেসেজ-সাউন্ড টগল (Web Audio — কোনো ফাইল লোড নেই) ── %>
