        if (id) { e.preventDefault(); jumpToMsg(id); }
      });

      /* ?hl= — around-রিলোডের পরে টার্গেট-বাবল পালস */
      const _hl93 = parseInt(new URLSearchParams(location.search).get('hl'), 10);
      if (_hl93) setTimeout(() => pulse93(body.querySelector('.bubble[data-id="' + _hl93 + '"]')), 260);

      /* সার্ভার-সাইড সার্চ-ড্রপডাউন */
      const sBtn = document.getElementById('cisServerBtn');
      const sPanel = document.getElementById('cisServer');
      const sList = document.getElementById('cisServerList');
      const sTitle = document.getElementById('cisServerTitle');
      const sClose = document.getElementById('cisServerClose');
      const sInput = document.getElementById('convInSearch');
      const esc93 = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      function sHide() { if (sPanel) sPanel.hidden = true; }
      window.lfMsgServerHide = sHide;
      async function serverSearch(q) {
        if (!sPanel || !q || q.length < 2 || !convId) { sHide(); return; }
        try {
          const r = await fetch('/api/messages/search?conv_id=' + convId + '&q=' + encodeURIComponent(q));
          const d = await r.json();
          if (!d.ok) return;
          const rs = d.results || [];
          sTitle.textContent = 'পুরনো বার্তায় ' + bn93(rs.length) + ' ম্যাচ';
          sList.innerHTML = rs.length ? rs.map((m) =>
            '<button type="button" class="css-row" data-jump="' + m.id + '">' +
            '<span class="css-av"><i class="fas fa-comment"></i></span>' +
            '<span class="css-body"><span class="css-name">' + esc93(m.sender) + '</span>' +
            '<span class="css-snip">' + esc93(m.snippet) + '</span></span>' +
