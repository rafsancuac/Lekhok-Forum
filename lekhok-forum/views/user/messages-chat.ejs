        <%# ── সেশন ৯২: শেয়ার্ড কনটেন্ট ট্যাব (মিডিয়া / ফাইল / লিংক — রোডম্যাপ আইটেম ১২) ── %>
        <div class="md-section md-shared">
          <h4><i class="fas fa-photo-film"></i> শেয়ার করা কনটেন্ট <button type="button" class="md-media-refresh" id="mdMediaRefresh" title="রিফ্রেশ করুন" aria-label="কনটেন্ট রিফ্রেশ করুন"><i class="fas fa-rotate-right"></i></button></h4>
          <div class="md-tabs" role="tablist" id="mdTabs" aria-label="শেয়ার করা কনটেন্ট">
            <button type="button" class="md-tab is-active" role="tab" aria-selected="true" data-mtab="media">মিডিয়া <span class="md-tab-count"><%= (_sharedImgs.length + _sharedVn.length) || '' %></span></button>
            <button type="button" class="md-tab" role="tab" aria-selected="false" data-mtab="files">ফাইল <span class="md-tab-count"><%= _sharedDocs.length || '' %></span></button>
            <button type="button" class="md-tab" role="tab" aria-selected="false" data-mtab="links">লিংক <span class="md-tab-count"><%= _sharedLinks.length || '' %></span></button>
            <%# সেশন ৯৪: কল-ইতিহাস ট্যাব (শুধু 1:1) — ট্যাব-ক্লিকে /api/calls/history থেকে লেজি-রেন্ডার %>
            <% if (!isGroup) { %>
            <button type="button" class="md-tab" role="tab" aria-selected="false" data-mtab="calls" id="mdCallsTab">কল <span class="md-tab-count" id="mdCallsCount"></span></button>
            <% } %>
          </div>
          <div class="md-tabpane" data-pane="media">
            <% if (_sharedImgs.length || _sharedVn.length) { %>
              <% if (_sharedImgs.length) { %>
                <div class="md-media">
                  <% _sharedImgs.forEach(im => { %>
                    <a href="<%= im.file_url %>" target="_blank" rel="noopener"><img loading="lazy" src="<%= im.file_url %>" alt="<%= im.file_name || 'ছবি' %>" /></a>
                  <% }); %>
                </div>
              <% } %>
              <% if (_sharedVn.length) { %>
                <div class="md-vn-list">
                  <% _sharedVn.forEach(function (vn) { %>
                    <div class="bubble-voice md-vn" data-src="<%= vn.file_url %>">
                      <button type="button" class="bv-play" aria-label="প্লে করুন"><i class="fas fa-play"></i></button>
                      <div class="bv-wave" aria-hidden="true"><% (function(){ var x = 11; for (var i = 0; i < 16; i++) { x = (x * 29 + 13) % 89; var h = 24 + (x % 72); %><span style="--h:<%= h %>%"></span><% } })(); %></div>
                      <span class="bv-time">০:০০</span>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            <% } else { %>
              <div class="md-media-empty">এই কথোপকথনে এখনো কোনো ছবি বা ভয়েস শেয়ার করা হয়নি।</div>
            <% } %>
          </div>
          <div class="md-tabpane" data-pane="files" hidden>
            <% if (_sharedDocs.length) { %>
              <div class="md-files">
                <% _sharedDocs.forEach(function (dcm) { %>
                  <a class="md-file" href="<%= dcm.file_url %>" download="<%= dcm.file_name || 'file' %>" target="_blank" rel="noopener">
                    <span class="mdf-ic"><i class="fas fa-file"></i></span>
                    <span class="mdf-body"><span class="mdf-name"><%= dcm.file_name || 'ফাইল' %></span><span class="mdf-host">সংযুক্তি</span></span>
                    <i class="fas fa-download mdf-dl"></i>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="md-media-empty">কোনো ফাইল শেয়ার করা হয়নি।</div>
            <% } %>
          </div>
          <div class="md-tabpane" data-pane="links" hidden>
            <% if (_sharedLinks.length) { %>
              <div class="md-links">
                <% _sharedLinks.forEach(function (lnk) { %>
                  <a class="md-linkrow" href="<%= lnk.url %>" target="_blank" rel="noopener nofollow">
                    <span class="mdl-ic"><i class="fas fa-link"></i></span>
                    <span class="mdl-body"><span class="mdl-host"><%= lnk.host %></span><span class="mdl-url"><%= lnk.url %></span></span>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="md-media-empty">কোনো লিংক শেয়ার করা হয়নি।</div>
            <% } %>
          </div>
          <%# সেশন ৯৪: কল-ইতিহাস pane — প্রথম সক্রিয়নে লেজি-ফেচ %>
          <div class="md-tabpane" data-pane="calls" hidden>
            <div id="mdCallsBody">
              <div class="md-media-empty">লোড হচ্ছে…</div>
            </div>
          </div>
        </div>
        <% if (isGroup) { %>
        <div class="md-section">
          <h4><i class="fas fa-user-group"></i> সদস্যবৃন্দ</h4>
          <div class="md-members">
            <% members.slice(0, 14).forEach(mm => { %>
              <span class="md-member"><img src="<%= mm.avatar_url || ('/avatar/' + mm.id) %>" style="width:20px;height:20px;border-radius:50%;object-fit:cover" alt="" /><%= mm.full_name %></span>
            <% }); %>
            <% if (members.length > 14) { %><span class="md-member">+<%= members.length - 14 %></span><% } %>
          </div>
        </div>
        <% } %>
        <div class="md-section">
          <h4><i class="fas fa-sliders"></i> কথোপকথন সেটিংস</h4>
          <%# সেশন ৭৬: মিউট/পিন টগল (প্রতি-সদস্য সেটিং, AJAX) %>
          <button type="button" class="md-link" id="muteToggle" data-muted="<%= (typeof myFlags !== 'undefined' && myFlags.muted) ? 1 : 0 %>">
            <i class="fas <%= (typeof myFlags !== 'undefined' && myFlags.muted) ? 'fa-bell-slash' : 'fa-bell' %>"></i> <span class="mt-label"><%= (typeof myFlags !== 'undefined' && myFlags.muted) ? 'আনমিউট করুন' : 'মিউট করুন' %></span>
          </button>
          <button type="button" class="md-link" id="pinToggle" data-pinned="<%= (typeof myFlags !== 'undefined' && myFlags.pinned) ? 1 : 0 %>">
            <i class="fas fa-thumbtack"></i> <span class="pn-label"><%= (typeof myFlags !== 'undefined' && myFlags.pinned) ? 'আনপিন করুন' : 'পিন করুন' %></span>
          </button>
        </div>
        <div class="md-section">
          <h4><i class="fas fa-shield-halved"></i> গোপনীয়তা ও সহায়তা</h4>
          <% if (!isGroup) { %>
            <button type="button" class="md-link md-link--danger" onclick="deleteConversation('<%= other.username %>')"><i class="fas fa-trash"></i> কথোপকথন মুছে ফেলুন</button>
          <% } else { %>
            <form method="POST" action="/messages/g/<%= conv.id %>/leave" style="margin:0">
              <button type="submit" class="md-link md-link--danger"><i class="fas fa-sign-out-alt"></i> গ্রুপ ছাড়ুন</button>
            </form>
          <% } %>
          <a href="/contact" class="md-link"><i class="fas fa-circle-question"></i> সহায়তা কেন্দ্র</a>
        </div>
      </aside>
    </div>
  </div>

  <%# ── সেশন ৭৬ (ক্রস-এজেন্ট মার্জ): সাইডবার-সারির ৩-ডট কনটেক্সট-মেনু (মিউট/আর্কাইভ) + ফরওয়ার্ড-মোডাল — দুটোই সংরক্ষিত ── %>
  <%# ── সেশন ৭৬: সাইডবার-সারির ৩-ডট কনটেক্সট-মেনু (মিউট/আর্কাইভ) ── %>
  <div class="conv-menu" id="convMenu" hidden role="menu" aria-label="কথোপকথন অপশন">
    <button type="button" role="menuitem" data-act="mute"><i class="fas fa-bell-slash"></i> <span>মিউট করুন</span></button>
    <button type="button" role="menuitem" data-act="unmute"><i class="fas fa-bell"></i> <span>আনমিউট করুন</span></button>
    <button type="button" role="menuitem" data-act="archive"><i class="fas fa-box-archive"></i> <span>আর্কাইভ করুন</span></button>
    <button type="button" role="menuitem" data-act="unarchive"><i class="fas fa-box-open"></i> <span>আর্কাইভ থেকে সরান</span></button>
  </div>

  <%# ── সেশন ৭৬: ফরওয়ার্ড-মোডাল (FB-স্টাইল — কথোপকথন বেছে কপি পাঠাও) ── %>
  <%# ── সেশন ৭৬: ফরওয়ার্ড-মোডাল (FB-স্টাইল — কথোপকথন বেছে কপি পাঠাও) ── %>
  <div class="fwd-overlay" id="fwdOverlay" hidden>
    <div class="fwd-modal" role="dialog" aria-modal="true" aria-label="মেসেজ ফরওয়ার্ড করুন">
      <div class="fwd-head">
        <h3><i class="fas fa-share"></i> মেসেজ ফরওয়ার্ড করুন</h3>
        <button type="button" id="fwdClose" class="fwd-x" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button>
      </div>
      <div class="fwd-search"><i class="fas fa-search"></i><input type="search" id="fwdSearch" placeholder="কথোপকথন খুঁজুন..." autocomplete="off" /></div>
      <div class="fwd-list" id="fwdList"></div>
      <div class="fwd-foot">
        <button type="button" class="fwd-cancel" id="fwdCancel">বাতিল</button>
      </div>
    </div>
    </div>
  </div>
  </div>

  <script>
    // ── হেল্পার ─────────────────────────────────────────────────────────
    const body = document.getElementById('chatBody');
    const convId = <%= conv ? conv.id : 0 %>;
    const myId = <%= user.id %>;
    const otherId = <%= other.id %>;
    const otherUsername = <%- jesc(other.username) %>;
    const otherAvatar = <%- jesc(other.avatar_url || ('/avatar/' + other.id)) %>;
    const sendUrl = <%- jesc(isGroup ? '/messages/g/' + conv.id : '/messages/' + other.username) %>;
    const isGroupChat = <%= isGroup ? 'true' : 'false' %>;
    let lastMsgId = <%= messages.length ? messages[messages.length - 1].id : 0 %>;
    let seenUpto = <%= (typeof lastOwnReadId !== 'undefined' && lastOwnReadId) ? lastOwnReadId : 0 %>;
    let typingTimeout = null;

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function highlight(text, q) {
      if (!q) return escapeHtml(text);
      const qLower = q.toLowerCase();
      const idx = text.toLowerCase().indexOf(qLower);
      if (idx === -1) return escapeHtml(text);
      return escapeHtml(text.substring(0, idx)) + '<mark>' + escapeHtml(text.substring(idx, idx + q.length)) + '</mark>' + escapeHtml(text.substring(idx + q.length));
    }

    // স্ক্রল নিচে + FB-টোস্ট
    if (body) body.scrollTop = body.scrollHeight;
    function fbToast(msg) {
      let t = document.querySelector('.fb-toast');
      if (!t) { t = document.createElement('div'); t.className = 'fb-toast'; document.body.appendChild(t); }
      t.textContent = msg;
      requestAnimationFrame(() => t.classList.add('show'));
      clearTimeout(t._hide);
      t._hide = setTimeout(() => t.classList.remove('show'), 2400);
    }

    // ── ডিটেইলস-প্যানেল টগল ────────────────────────────────────────────
    const fbShell = document.getElementById('messengerShell');
    const fbDetails = document.getElementById('fbDetails');
    const fbInfoBtn = document.getElementById('fbInfoBtn');
    if (fbInfoBtn && fbDetails && fbShell) {
      fbInfoBtn.addEventListener('click', () => {
        fbDetails.hidden = !fbDetails.hidden;
        fbShell.classList.toggle('has-details', !fbDetails.hidden);
      });
      const fbClose = document.getElementById('fbDetailsClose');
      if (fbClose) fbClose.addEventListener('click', () => {
        fbDetails.hidden = true;
        fbShell.classList.remove('has-details');
      });
      // <1024px-এ প্যানেল দেখানো বন্ধ — CSS-ও জোর করে লুকায়
      if (window.innerWidth < 1024) { fbDetails.hidden = true; fbShell.classList.remove('has-details'); }
    }

    // ── সেশন ৯২(b): শেয়ার্ড-কনটেন্ট লাইভ-রিফ্রেশ — ডিটেইলস খুললে/রিফ্রেশ-বাটনে
    // /api/messages/conv/:id/media থেকে ছবি/ভয়েস/ফাইল/লিংক পুনঃরেন্ডার
    // (সার্ভার-রেন্ডারড প্রাথমিক অবস্থার উপরে লাইভ-সিঙ্ক; ট্যাব-সুইচিং নিচের mdTabs-ব্লক) ──
    (function initSharedRefresh() {
      const CONV_ID = <%= conv.id %>;
      const section = document.querySelector('.md-shared');
      if (!section || !CONV_ID) return;

      const panes = {
        media: section.querySelector('.md-tabpane[data-pane="media"]'),
        files: section.querySelector('.md-tabpane[data-pane="files"]'),
        links: section.querySelector('.md-tabpane[data-pane="links"]')
      };
      const counts = {
        media: section.querySelector('.md-tab[data-mtab="media"] .md-tab-count'),
        files: section.querySelector('.md-tab[data-mtab="files"] .md-tab-count'),
        links: section.querySelector('.md-tab[data-mtab="links"] .md-tab-count')
      };
      const refreshBtn = document.getElementById('mdMediaRefresh');
      let inFlight = null;

      function esc(v) {
        return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function skeleton() {
        return '<div class="md-media md-skeleton"><span></span><span></span><span></span></div>';
      }
      /* ভয়েস-রো — সার্ভার-রেন্ডারড মার্কআপের হুবহু রেপ্লিকা (seeded-waveform সহ);
         প্লে-ব্যবস্থাপনা .bubble-voice ডেলিগেশনেই ঘটে (ডাইনামিক-নোড সাপোর্টেড) */
      function voiceRow(vn) {
        let x = 11, spans = '';
        for (let i = 0; i < 16; i++) { x = (x * 29 + 13) % 89; spans += '<span style="--h:' + (24 + (x % 72)) + '%"></span>'; }
        return '<div class="bubble-voice md-vn" data-src="' + esc(vn.url) + '">' +
          '<button type="button" class="bv-play" aria-label="প্লে করুন"><i class="fas fa-play"></i></button>' +
          '<div class="bv-wave" aria-hidden="true">' + spans + '</div>' +
          '<span class="bv-time">\u09E6:\u09E6\u09E6</span></div>';
      }
      function renderMedia(images, voice) {
        let h = '';
        if (images.length) {
          h += '<div class="md-media">' + images.map(function (im) {
            return '<a href="' + esc(im.url) + '" target="_blank" rel="noopener" title="' + esc(im.name) + '">' +
              '<img loading="lazy" src="' + esc(im.url) + '" alt="' + esc(im.name) + '" /></a>';
          }).join('') + '</div>';
        }
        if (voice.length) {
          h += '<div class="md-vn-list">' + voice.map(voiceRow).join('') + '</div>';
        }
        return h || '<div class="md-media-empty">এই কথোপকথনে এখনো কোনো ছবি বা ভয়েস শেয়ার করা হয়নি।</div>';
      }
      function renderFiles(files) {
        if (!files.length) return '<div class="md-media-empty">কোনো ফাইল শেয়ার করা হয়নি।</div>';
        return '<div class="md-files">' + files.map(function (dcm) {
          return '<a class="md-file" href="' + esc(dcm.url) + '" download="' + esc(dcm.name || 'file') + '" target="_blank" rel="noopener">' +
            '<span class="mdf-ic"><i class="fas fa-file"></i></span>' +
            '<span class="mdf-body"><span class="mdf-name">' + esc(dcm.name || 'ফাইল') + '</span><span class="mdf-host">সংযুক্তি</span></span>' +
            '<i class="fas fa-download mdf-dl"></i></a>';
        }).join('') + '</div>';
      }
      function renderLinks(links) {
        if (!links.length) return '<div class="md-media-empty">কোনো লিংক শেয়ার করা হয়নি।</div>';
        return '<div class="md-links">' + links.map(function (l) {
          return '<a class="md-linkrow" href="' + esc(l.url) + '" target="_blank" rel="noopener nofollow">' +
            '<span class="mdl-ic"><i class="fas fa-link"></i></span>' +
            '<span class="mdl-body"><span class="mdl-host">' + esc(l.host) + '</span><span class="mdl-url">' + esc(l.url) + '</span></span></a>';
        }).join('') + '</div>';
      }
      function paint(d) {
        const images = d.images || [], voice = d.voice || [], files = d.files || [], links = d.links || [];
        panes.media.innerHTML = renderMedia(images, voice);
        panes.files.innerHTML = renderFiles(files);
        panes.links.innerHTML = renderLinks(links);
        if (counts.media) counts.media.textContent = (images.length + voice.length) || '';
        if (counts.files) counts.files.textContent = files.length || '';
        if (counts.links) counts.links.textContent = links.length || '';
      }
      function fetchShared() {
        if (inFlight) inFlight.abort();
        const ctrl = ('AbortController' in window) ? new AbortController() : null;
        inFlight = ctrl;
        panes.media.innerHTML = skeleton();
        section.classList.add('is-loading');
        fetch('/api/messages/conv/' + CONV_ID + '/media', {
          headers: { 'Accept': 'application/json' },
          signal: ctrl ? ctrl.signal : undefined
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('http ' + r.status)); })
          .then(function (d) { if (d && d.ok) paint(d); })
          .catch(function () { /* ব্যর্থ হলে সার্ভার-রেন্ডারড অবস্থায়ই থাক */ })
          .finally(function () { section.classList.remove('is-loading'); inFlight = null; });
      }
      if (refreshBtn) refreshBtn.addEventListener('click', fetchShared);
      if (fbInfoBtn) fbInfoBtn.addEventListener('click', function () {
        if (!fbDetails.hidden) fetchShared();
      });
      if (!fbDetails.hidden) fetchShared();
    })();

    // মোবাইল: ব্যাক-বাটন → লিস্ট দেখাও
    document.getElementById('fbBackBtn')?.addEventListener('click', () => {
      document.getElementById('messengerList').classList.remove('hidden');
      document.getElementById('messengerChat').classList.add('hidden');
    });

    // ── সেশন ৭৬: সাইডবার-সারির মিউট/আর্কাইভ (localStorage-পেসিস্টেন্ট) ──
    const convPrefs = (() => { try { return JSON.parse(localStorage.getItem('lfConvPrefs') || '{}'); } catch (e) { return {}; } })();
    function savePrefs() { try { localStorage.setItem('lfConvPrefs', JSON.stringify(convPrefs)); } catch (e) {} }
    function prefOf(id) {
      const k = String(id);
      if (!convPrefs[k]) convPrefs[k] = { muted: false, archived: false };
      return convPrefs[k];
    }
    function applySidePrefs() {
      document.querySelectorAll('.messenger-list .conv-item').forEach(el => {
        const p = prefOf(el.dataset.id);
        el.classList.toggle('is-muted', !!p.muted);
        el.classList.toggle('is-archived', !!p.archived);
        const tag = el.querySelector('.conv-mute-tag');
        if (tag) tag.hidden = !p.muted;
        el.style.display = p.archived ? 'none' : '';
      });
    }
    const convMenu = document.getElementById('convMenu');
    let menuTarget = null;
    function openConvMenu(btn) {
      if (!convMenu) return;
      menuTarget = btn.closest('.conv-item');
      if (!menuTarget) return;
      const p = prefOf(menuTarget.dataset.id);
      convMenu.querySelector('[data-act="mute"]').style.display = p.muted ? 'none' : 'flex';
      convMenu.querySelector('[data-act="unmute"]').style.display = p.muted ? 'flex' : 'none';
      convMenu.querySelector('[data-act="archive"]').style.display = p.archived ? 'none' : 'flex';
      convMenu.querySelector('[data-act="unarchive"]').style.display = p.archived ? 'flex' : 'none';
      const r = btn.getBoundingClientRect();
      convMenu.hidden = false;
      const mw = convMenu.offsetWidth || 200;
      convMenu.style.left = Math.max(8, Math.min(r.left, window.innerWidth - mw - 8)) + 'px';
      convMenu.style.top = Math.min(r.bottom + 6, window.innerHeight - convMenu.offsetHeight - 8) + 'px';
    }
    function closeConvMenu() { if (convMenu) convMenu.hidden = true; menuTarget = null; }
    document.addEventListener('click', e => {
      const btn = e.target.closest('[data-conv-menu]');
      if (btn) {
        e.preventDefault(); e.stopPropagation();
        if (!convMenu.hidden && menuTarget && menuTarget.dataset.id === btn.dataset.convMenu) { closeConvMenu(); return; }
        openConvMenu(btn);
        return;
      }
      if (!e.target.closest('#convMenu')) closeConvMenu();
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeConvMenu();
      const btn = e.target.closest && e.target.closest('[data-conv-menu]');
      if (btn && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); e.stopPropagation(); openConvMenu(btn); }
    });
    if (convMenu) convMenu.addEventListener('click', e => {
      const act = e.target.closest('[data-act]');
      if (!act || !menuTarget) return;
      const p = prefOf(menuTarget.dataset.id);
      if (act.dataset.act === 'mute') p.muted = true;
      if (act.dataset.act === 'unmute') p.muted = false;
      if (act.dataset.act === 'archive') p.archived = true;
      if (act.dataset.act === 'unarchive') p.archived = false;
      savePrefs();
      applySidePrefs();
      closeConvMenu();
    });
    applySidePrefs();

    // ── সেশন ৭৬: চ্যাট-থিম (নিজের বাবল + সেন্ড-বাটন + থিম-স্ট্রিপ) ──
    const CHAT_THEMES = {
      default: { name: 'ডিফল্ট',   bubble: '#0084FF', grad: 'linear-gradient(90deg,#1877F2,#0084FF)' },
      mint:    { name: 'মিন্ট',     bubble: '#0d9488', grad: 'linear-gradient(90deg,#059669,#14b8a6)' },
      rose:    { name: 'গোলাপি',    bubble: '#e11d48', grad: 'linear-gradient(90deg,#e11d48,#fb7185)' },
      sunset:  { name: 'সূর্যাস্ত', bubble: '#ea580c', grad: 'linear-gradient(90deg,#f59e0b,#ef4444)' },
      violet:  { name: 'বেগুনি',    bubble: '#7c3aed', grad: 'linear-gradient(90deg,#7c3aed,#a78bfa)' },
      forest:  { name: 'অরণ্য',     bubble: '#16a34a', grad: 'linear-gradient(90deg,#15803d,#22c55e)' }
    };
    const themeStoreKey = 'lfChatTheme:' + (isGroupChat ? 'g' + convId : 'u:' + otherUsername);
    function applyChatTheme(key) {
      const t = CHAT_THEMES[key] || CHAT_THEMES.default;
      const shell = document.getElementById('messengerShell');
      if (shell) {
        shell.style.setProperty('--fb-msg', t.bubble);
        shell.style.setProperty('--lf-theme-grad', t.grad);
      }
      document.querySelectorAll('#mdThemes .md-theme').forEach(b => b.classList.toggle('active', b.dataset.theme === key));
      const note = document.getElementById('mdThemeNote');
      if (note) note.textContent = 'বর্তমান থিম: ' + t.name + ' — শুধু আপনার ডিভাইসে';
    }
    const mdThemes = document.getElementById('mdThemes');
    if (mdThemes) mdThemes.addEventListener('click', e => {
      const b = e.target.closest('.md-theme');
      if (!b) return;
      try { localStorage.setItem(themeStoreKey, b.dataset.theme); } catch (err) {}
      applyChatTheme(b.dataset.theme);
      fbToast('চ্যাট-থিম পরিবর্তন হয়েছে');
    });
    let savedTheme = 'default';
    try { savedTheme = localStorage.getItem(themeStoreKey) || 'default'; } catch (e) {}
    applyChatTheme(savedTheme);

    // ── সাইডবার-সার্চ (কথোপকথন + নতুন ইউজার) ───────────────────────────
    const convSearch = document.getElementById('convSearch');
    const convSearchClear = document.getElementById('convSearchClear');
    const convSearchResults = document.getElementById('convSearchResults');
    const csrConversations = document.getElementById('csrConversations');
    const csrUsers = document.getElementById('csrUsers');
    const csrEmpty = document.getElementById('csrEmpty');
    const csrConvList = document.getElementById('csrConvList');
    const csrUserList = document.getElementById('csrUserList');
    const csrConvCount = document.getElementById('csrConvCount');
    const csrUserCount = document.getElementById('csrUserCount');
    let searchTimerC = null, lastQueryC = '', kbIndexC = -1, kbRowsC = [];

    function filterConvs(q) {
      q = (q || '').toLowerCase().trim();
      document.querySelectorAll('.messenger-list .conv-item').forEach(el => {
        el.style.display = !q || el.dataset.name.indexOf(q) !== -1 ? 'flex' : 'none';
      });
    }

    function renderConvSearchResults(q) {
      const qLower = (q || '').toLowerCase().trim();
      const items = [...document.querySelectorAll('.messenger-list .conv-item')];
      const matched = qLower ? items.filter(el => el.dataset.name.indexOf(qLower) !== -1) : items;

      if (!matched.length) { csrConversations.hidden = true; return; }
      csrConvCount.textContent = matched.length;
      csrConvList.innerHTML = matched.map(el => {
        const origName = el.querySelector('.conv-name').textContent;
        const origSnippet = el.querySelector('.conv-snippet').textContent;
        const avatar = el.querySelector('img') ? el.querySelector('img').outerHTML : '';
        const unread = el.querySelector('.conv-unread');
        const unreadHtml = unread ? `<span class="conv-unread">${unread.textContent}</span>` : '';
        return `<a class="msr-row" href="${el.getAttribute('href')}">
          ${avatar.replace('class="', 'class="msr-avatar ')}
          <div class="msr-meta"><div class="msr-name">${highlight(origName, q)}</div><div class="msr-sub">${highlight(origSnippet, q)}</div></div>
          <div class="msr-right">${unreadHtml}</div>
        </a>`;
      }).join('');
      csrConversations.hidden = false;
    }

    async function renderUserSearchResults(q) {
      if (!q || q.length < 1) { csrUsers.hidden = true; return; }
      try {
        const r = await fetch('/api/users/search?q=' + encodeURIComponent(q));
        const data = await r.json();
        const users = data.users || [];
        if (!users.length) { csrUsers.hidden = true; return; }
        csrUserCount.textContent = users.length;
        csrUserList.innerHTML = users.map(u => {
          const avatar = u.avatar_url
            ? `<img loading="lazy" decoding="async" class="msr-avatar" src="${escapeHtml(u.avatar_url)}" onerror="this.onerror=null;this.outerHTML='<div class=\'msr-avatar\'>${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>'" />`
            : `<div class="msr-avatar">${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>`;
          const sub = [u.designation, '@' + u.username].filter(Boolean).join(' • ');
          return `<a class="msr-row" href="/messages/${encodeURIComponent(u.username)}">
            ${avatar}
            <div class="msr-meta"><div class="msr-name">${highlight(u.full_name || u.username, q)}</div><div class="msr-sub">${highlight(sub, q)}</div></div>
            <div class="msr-right"><i class="fas fa-chevron-right"></i></div>
          </a>`;
        }).join('');
        csrUsers.hidden = false;
      } catch {}
    }

    async function doConvSearch(q) {
      q = (q || '').trim();
      if (q === lastQueryC) return;
      lastQueryC = q;
      kbIndexC = -1;
      if (!q) {
        convSearchResults.hidden = true;
        convSearchClear.hidden = true;
        filterConvs('');
        return;
      }
      convSearchClear.hidden = false;
      filterConvs(q);
      renderConvSearchResults(q);
      await renderUserSearchResults(q);
      const hasC = !csrConversations.hidden, hasU = !csrUsers.hidden;
      csrEmpty.hidden = hasC || hasU;
      convSearchResults.hidden = false;
      kbRowsC = [...convSearchResults.querySelectorAll('.msr-row')];
    }

    convSearch.addEventListener('input', () => {
      if (searchTimerC) clearTimeout(searchTimerC);
      searchTimerC = setTimeout(() => doConvSearch(convSearch.value), 180);
    });
    convSearch.addEventListener('focus', () => {
      if (convSearch.value.trim()) convSearchResults.hidden = false;
    });
    convSearchClear.addEventListener('click', () => {
      convSearch.value = '';
      convSearch.dispatchEvent(new Event('input'));
      convSearch.focus();
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('.messenger-list-head')) convSearchResults.hidden = true;
    });
    convSearch.addEventListener('keydown', (e) => {
      if (convSearchResults.hidden || !kbRowsC.length) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); kbIndexC = Math.min(kbIndexC + 1, kbRowsC.length - 1); updateKbActiveC(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); kbIndexC = Math.max(kbIndexC - 1, 0); updateKbActiveC(); }
      else if (e.key === 'Enter') { e.preventDefault(); if (kbIndexC >= 0 && kbRowsC[kbIndexC]) kbRowsC[kbIndexC].click(); else if (kbRowsC.length === 1) kbRowsC[0].click(); }
      else if (e.key === 'Escape') { convSearch.value = ''; convSearch.dispatchEvent(new Event('input')); convSearch.blur(); }
    });
    function updateKbActiveC() {
      kbRowsC.forEach((r, i) => r.classList.toggle('kb-active', i === kbIndexC));
      if (kbIndexC >= 0 && kbRowsC[kbIndexC]) kbRowsC[kbIndexC].scrollIntoView({ block: 'nearest' });
    }

    // ── ইমোজি-পিকার ────────────────────────────────────────────────────
    function insertEmoji(em) {
      const input = document.getElementById('msgInput');
      input.value += em;
      input.focus();
      updateSendBtn();
      document.getElementById('emojiPicker').classList.remove('open');
    }

    // ── সেশন ৭৮: কুইক-রিপ্লাই চিপ ──────────────────────────────────────
    // চিপ-ক্লিক → ইনপুটে টেক্সট বসে + ফোকাস (সেন্ড ইউজারের হাতে — accidental
    // সেন্ড-রোধ); ইনপুট খালি হলে রিপ্লেস, লেখা থাকলে জোড়া+স্পেস।
    function quickReply(btn) {
      const t = btn.getAttribute('data-qr') || '';
      const cur = msgInput.value || '';
      msgInput.value = cur.trim() ? (cur.replace(/\s+$/, '') + ' ' + t) : t;
      updateSendBtn();
      msgInput.focus();
      btn.classList.add('qr-pop');
      setTimeout(() => btn.classList.remove('qr-pop'), 350);
    }
    document.getElementById('qrChips').addEventListener('click', e => {
      const chip = e.target.closest('.qr-chip');
      if (chip) quickReply(chip);
    });

    document.getElementById('emojiBtn').addEventListener('click', () => {
      document.getElementById('emojiPicker').classList.toggle('open');
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('.chat-input-wrap') && !e.target.closest('#emojiBtn')) {
        document.getElementById('emojiPicker').classList.remove('open');
      }
    });

    // ── FB ডাইনামিক অ্যাকশন-বাটন: খালি ইনপুটে 👍, টাইপ শুরুতে সেন্ড-প্লেন ──
    const chatForm = document.getElementById('chatForm');
    const sendBtn = document.getElementById('sendBtn');
    const msgInput = document.getElementById('msgInput');
    const fileInputEl = document.getElementById('fileInput');
    const filePreviewEl = document.getElementById('filePreview');

    function updateSendBtn() {
      const has = (msgInput.value || '').trim().length > 0;
      sendBtn.classList.toggle('is-like', !has);
      sendBtn.title = has ? 'পাঠান' : 'লাইক পাঠান';
      sendBtn.innerHTML = has ? '<i class="fas fa-location-arrow"></i>' : '<span style="font-size:20px;line-height:1">👍</span>';
    }

    // ── সেশন ৭৮: প্রতি-কথোপকথন ড্রাফট-সেভ (FB-আচরণ — অন্য চ্যাটে গিয়ে ফিরলেও লেখা বাঁচে) ──
    const draftKey = 'lfDraft:' + (isGroupChat ? 'g' + convId : 'u:' + otherUsername);
    function saveDraft() { try { localStorage.setItem(draftKey, msgInput.value); } catch (e) {} }
    function clearDraft() { try { localStorage.removeItem(draftKey); } catch (e) {} }
    try { const _draft = localStorage.getItem(draftKey); if (_draft) msgInput.value = _draft; } catch (e) {}
    if (msgInput.value) { autogrowInput(); updateSendBtn(); } /* সেশন ৮০: রিস্টোর-করা মাল্টি-লাইন ড্রাফটেও উচ্চতা ঠিক */

    msgInput.addEventListener('input', () => {
      updateSendBtn();
      autogrowInput();
      if (msgInput.value.trim()) saveDraft(); else clearDraft();
    });
    updateSendBtn();

    // ── সেশন ৮০: অটো-গ্রো টেক্সটএরিয়া (FB-কম্পোজার — লেখা বাড়লে ইনপুট লম্বা হয়, Shift+Enter নতুন লাইন) ──
    function autogrowInput() {
      msgInput.style.height = 'auto';
      msgInput.style.height = Math.min(msgInput.scrollHeight, 120) + 'px';
      msgInput.style.overflowY = msgInput.scrollHeight > 120 ? 'auto' : 'hidden';
    }
    function resetInputHeight() {
      msgInput.style.height = '';
      msgInput.style.overflowY = 'hidden';
    }

    // ── সেশন ৮০: মেসেঞ্জার সাউন্ড এফেক্ট (Web Audio API — কোনো অডিও-ফাইল লোড হয় না) ──
    // সেন্ড = হালকা পপ (D5→A5), রিসিভ = নরম ডিং (E5→B4); localStorage lfMsgSound-এ পেসিস্টেন্ট।
    const SoundFX = (() => {
      let ctx = null;
      let enabled = (() => { try { return localStorage.getItem('lfMsgSound') !== '0'; } catch (e) { return true; } })();
      function ac() {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        if (!ctx) ctx = new AC();
        if (ctx.state === 'suspended') { ctx.resume().catch(() => {}); }
        return ctx;
      }
      function blip(f1, f2, dur, vol, type) {
        if (!enabled) return;
        const c = ac(); if (!c) return;
        try {
          const o = c.createOscillator(), g = c.createGain();
          o.type = type || 'sine';
          o.frequency.setValueAtTime(f1, c.currentTime);
          o.frequency.exponentialRampToValueAtTime(f2, c.currentTime + dur);
          g.gain.setValueAtTime(vol, c.currentTime);
          g.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + dur);
          o.connect(g); g.connect(c.destination);
          o.start(); o.stop(c.currentTime + dur);
        } catch (e) {}
      }
      return {
        send() { blip(587.33, 880, 0.09, 0.12, 'sine'); },
        receive() { blip(659.25, 493.88, 0.16, 0.10, 'triangle'); },
        toggle(v) { enabled = !!v; try { localStorage.setItem('lfMsgSound', v ? '1' : '0'); } catch (e) {} },
        isOn() { return enabled; }
      };
    })();
    const soundToggle = document.getElementById('soundToggle');
    if (soundToggle) {
      soundToggle.checked = SoundFX.isOn();
      soundToggle.addEventListener('change', () => {
        SoundFX.toggle(soundToggle.checked);
        if (soundToggle.checked) SoundFX.send(); /* চালু-কনফার্মেশন পপ */
        fbToast(soundToggle.checked ? '🔔 মেসেজ সাউন্ড চালু' : '🔕 মেসেজ সাউন্ড বন্ধ');
      });
    }

    // ── সেশন ৮০: ক্লিপবোর্ড-পেস্ট (Ctrl+V — স্ক্রিনশট/ছবি/ফাইল সরাসরি অ্যাটাচমেন্টে) ──
    msgInput.addEventListener('paste', (e) => {
      const items = e.clipboardData && e.clipboardData.items;
      if (!items) return;
      const pasted = [];
      for (let i = 0; i < items.length; i++) {
        if (items[i].kind === 'file') {
          const f = items[i].getAsFile();
          if (f) pasted.push(f);
        }
      }
      if (!pasted.length) return;
      e.preventDefault();
      const dt = new DataTransfer();
      [...fileInputEl.files].forEach(f => dt.items.add(f));   /* আগে থেকে নির্বাচিত থাকলে ধরে রাখি */
      pasted.forEach(f => dt.items.add(f));
      fileInputEl.files = dt.files;
      fileInputEl.dispatchEvent(new Event('change'));
      fbToast('📎 ক্লিপবোর্ড থেকে ফাইল যোগ হয়েছে');
      msgInput.focus();
    });

    // ── সেশন ৮০: ফুল-উইন্ডো ড্র্যাগ-অ্যান্ড-ড্রপ জোন ──
    const dropOverlay = document.getElementById('dropOverlay');
    let dragDepth = 0;
    function hasFiles(e) { return e.dataTransfer && [...(e.dataTransfer.types || [])].indexOf('Files') !== -1; }
    window.addEventListener('dragenter', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      dragDepth++;
      if (dropOverlay) dropOverlay.classList.add('show');
    });
    window.addEventListener('dragover', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      if (dropOverlay) dropOverlay.classList.add('show');
    });
    window.addEventListener('dragleave', (e) => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0 && dropOverlay && (!e.relatedTarget || e.relatedTarget === document.documentElement)) dropOverlay.classList.remove('show');
    });
    window.addEventListener('drop', (e) => {
      dragDepth = 0;
      if (dropOverlay) dropOverlay.classList.remove('show');
      if (!hasFiles(e) || !e.dataTransfer.files.length) return;
      e.preventDefault();
      const dt = new DataTransfer();
      [...fileInputEl.files].forEach(f => dt.items.add(f));
      [...e.dataTransfer.files].forEach(f => dt.items.add(f));
      fileInputEl.files = dt.files;
      fileInputEl.dispatchEvent(new Event('change'));
      fbToast('📎 ফাইল যোগ হয়েছে — পাঠাতে সেন্ড চাপুন');
    });
    window.addEventListener('dragend', () => { dragDepth = 0; if (dropOverlay) dropOverlay.classList.remove('show'); });

    // ── সেশন ৭৮: স্ক্রল-টু-বটম FAB + নতুন-মেসেজ ব্যাজ + স্মার্ট-অটোস্ক্রল ──
    const jumpBtn = document.getElementById('jumpBtn');
    const jumpBadge = jumpBtn ? jumpBtn.querySelector('.jump-badge') : null;
    let newMsgCount = 0;
    function isNearBottom() { return body.scrollHeight - body.scrollTop - body.clientHeight < 160; }
    function updateJumpBtn() {
      if (!jumpBtn) return;
      jumpBtn.classList.toggle('show', body.scrollHeight - body.scrollTop - body.clientHeight > 320);
    }
    function clearJumpBadge() {
      newMsgCount = 0;
      if (jumpBadge) { jumpBadge.textContent = ''; jumpBadge.classList.remove('show'); }
    }
    body.addEventListener('scroll', () => { updateJumpBtn(); if (isNearBottom()) clearJumpBadge(); }, { passive: true });
    if (jumpBtn) jumpBtn.addEventListener('click', () => {
      body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
      clearJumpBadge();
    });
    updateJumpBtn();

    // ── সেশন ৭৮: ছবি-লাইটবক্স (চ্যাট-ছবি + শেয়ার্ড-মিডিয়া গ্রিড — নতুন ট্যাবের বদলে) ──
    let lbEl = null;
    function openLightbox(src, caption) {
      if (!lbEl) {
        lbEl = document.createElement('div');
        lbEl.className = 'lf-lightbox';
        lbEl.setAttribute('role', 'dialog');
        lbEl.setAttribute('aria-modal', 'true');
        lbEl.innerHTML = '<button type="button" class="lb-close" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button><img alt="" /><div class="lb-caption"></div>';
        lbEl.addEventListener('click', e => { if (e.target === lbEl || e.target.closest('.lb-close')) closeLightbox(); });
        document.body.appendChild(lbEl);
      }
      const img = lbEl.querySelector('img');
      img.src = src; img.alt = caption || 'ছবি';
      const cap = lbEl.querySelector('.lb-caption');
      cap.textContent = caption || '';
      cap.style.display = caption ? '' : 'none';
      lbEl.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() { if (lbEl) lbEl.classList.remove('open'); document.body.style.overflow = ''; }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
    body.addEventListener('click', e => {
      const img = e.target.closest('.bubble-image');
      if (img) { e.preventDefault(); openLightbox(img.currentSrc || img.src, img.alt); }
    });
    document.getElementById('fbDetails')?.addEventListener('click', e => {
      const img = e.target.closest('.md-media img');
      if (img) { e.preventDefault(); openLightbox(img.currentSrc || img.src, img.alt); }
    });

    // ── মেসেজ-রেন্ডারিং ─────────────────────────────────────────────────
    function appendMessage(msg, forceScrollFlag) {
      // ── সেশন ১০৫: ক্যানোনিকাল single-source রেন্ডারিং ──────────────────────
      // নতুন/আসা মেসেজ JS-স্ট্রিং-দিয়ে আর বানানো হয় না — সার্ভারের
      // MessengerBubble-পাইপলাইন (/api/messages/render → chat-fragment →
      // shared/messenger/MessengerBubble.ejs) থেকেই HTML এসে বসে। চ্যাট-উইন্ডো,
      // older-ব্যাচ ও ভবিষ্যৎ ইনবক্স-প্রিভিউ — সব এখন একই মার্কআপ (গার্ড-রুল)।
      const idStr = String(msg.id);
      const isTmp = idStr.indexOf('tmp-') === 0;
      if (!isTmp && document.querySelector('.bubble[data-id="' + idStr + '"]')) return;
      if (isTmp) {
        // জিরো-ল্যাগ optimistic — ন্যূনতম বাবল; আসল-আইডি এলেই ক্যানোনিকাল
        // রেন্ডার এটিকে পূর্ণ অ্যাকশন-রেলসহ বাবলে প্রতিস্থাপন করে।
        const nearBottom = isNearBottom();
        const div = document.createElement('div');
        div.className = 'bubble me optimistic-tmp first-of-cluster last-of-cluster';
        div.dataset.id = idStr;
        div.dataset.own = '1';
        let html = '<div class="b-content">';
        if (msg.reply_to_id) html += '<div class="bubble-quote"><span class="bq-name">' + escapeHtml(msg.reply_sender_name || 'মেসেজ') + '</span><span class="bq-text">' + escapeHtml(String(msg.reply_body || '').slice(0, 120)) + '</span></div>';
        html += '<div class="bubble-text"></div>';
        if (msg.file_url) {
          if (/\.(jpe?g|png|gif|webp|svg|bmp)$/i.test(msg.file_url)) html += '<a href="' + msg.file_url + '" target="_blank" rel="noopener"><img src="' + msg.file_url + '" alt="" class="bubble-image" /></a>';
          else html += '<a href="' + msg.file_url + '" class="bubble-file"><i class="fas fa-paperclip"></i> ' + escapeHtml(msg.file_name || 'ফাইল') + '</a>';
        }
        html += '</div><div class="bubble-meta"><span class="bubble-time"></span><span class="bubble-seen"><i class="fas fa-check" title="পৌঁছেছে"></i></span></div>';
        div.innerHTML = html;
        div.querySelector('.bubble-text').textContent = msg.body || '';
        div.querySelector('.bubble-time').textContent = new Date(msg.created_at || Date.now()).toLocaleString('bn-BD', { hour: '2-digit', minute: '2-digit' });
        const ti = document.getElementById('typingIndicator');
        body.insertBefore(div, ti);
        if (forceScrollFlag === true || nearBottom) {
          body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
          clearJumpBadge();
        }
        return;
      }
      // আসল-আইডি (echo বা অন্যের বার্তা) — মিলে-যাওয়া tmp সরিয়ে ক্যানোনিকাল রেন্ডার
      if (msg.is_me) {
        const tmps = Array.prototype.slice.call(document.querySelectorAll('.bubble.optimistic-tmp'));
        const match = tmps.reverse().find(b => ((b.querySelector('.bubble-text') || {}).textContent || '') === (msg.body || ''));
        if (match) match.remove();
      }
      _lastMsg105 = Math.max(_lastMsg105, Number(msg.id) || 0);
      queueCanonicalRender(forceScrollFlag);
    }

    var _lastMsg105 = 0;
    (function () {
      document.querySelectorAll('.bubble[data-id]').forEach(function (b) {
        var n = parseInt(b.getAttribute('data-id'), 10);
        if (!isNaN(n) && n > _lastMsg105) _lastMsg105 = n;
      });
    })();
    var _renderTimer105 = null;
    var _forceScroll105 = false;
    var _pendingTmp105 = null;
    function queueCanonicalRender(forceScrollFlag) {
      if (forceScrollFlag === true) _forceScroll105 = true;
      clearTimeout(_renderTimer105);
      _renderTimer105 = setTimeout(function () {
        fetch('/api/messages/render?conv_id=' + convId + '&after_id=' + _lastMsg105)
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d || !d.ok || !d.html) { _forceScroll105 = false; return; }
            const nearBottom = isNearBottom();
            const ti = document.getElementById('typingIndicator');
            if (ti) ti.insertAdjacentHTML('beforebegin', d.html);
            else body.insertAdjacentHTML('beforeend', d.html);
            _lastMsg105 = Math.max(_lastMsg105, Number(d.lastId) || 0);
            // প্রতিস্থাপন-নিশ্চয়তা: টেক্সট-মিল টmp বাবল সরাও
            const fresh = Array.prototype.slice.call(body.querySelectorAll('.bubble:not(.optimistic-tmp) .bubble-text'));
            document.querySelectorAll('.bubble.optimistic-tmp').forEach(function (t) {
              const tt = (t.querySelector('.bubble-text') || {}).textContent || '';
              if (tt && fresh.some(function (f) { return f.textContent === tt; })) t.remove();
            });
            if (_pendingTmp105 && document.body.contains(_pendingTmp105)) {
              const tt2 = (_pendingTmp105.querySelector('.bubble-text') || {}).textContent || '';
              if (!tt2 || fresh.some(function (f) { return f.textContent === tt2; })) _pendingTmp105.remove();
              _pendingTmp105 = null;
            }
            if (_forceScroll105 || nearBottom) {
              body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
              clearJumpBadge();
              newMsgCount = 0;
            } else if (fresh.length) {
              newMsgCount++;
              if (jumpBadge) { jumpBadge.textContent = newMsgCount > 9 ? '৯+' : String(newMsgCount); jumpBadge.classList.add('show'); }
            }
            _forceScroll105 = false;
          })
          .catch(function () { _forceScroll105 = false; /* পরবর্তী poll-এ আবার */ });
      }, 220);
    }

    // সিন-রসিট: শেষ-পঠিত নিজের বাবলে অপর পক্ষের মাইক্রো-অ্যাভাটার (FB-স্টাইল)
    function updateSeenAvatar() {
      document.querySelectorAll('.bubble.me .bubble-seen').forEach(s => {
        if (!s.querySelector('img')) return;
        s.innerHTML = '<i class="fas fa-check-double" title="পড়া হয়েছে"></i>';
      });
      let last = null;
      document.querySelectorAll('.bubble.me').forEach(b => {
        const id = parseInt(b.dataset.id);
        if (!isNaN(id) && id > 0 && id <= seenUpto) last = b;
      });
      if (last) {
        const s = last.querySelector('.bubble-seen');
        if (s) s.innerHTML = '<img src="' + escapeHtml(otherAvatar) + '" alt="পড়া হয়েছে" title="পড়া হয়েছে">';
      }
    }
    function markSeen(id) {
      const b = document.querySelector('.bubble[data-id="' + id + '"] .bubble-seen');
      if (b) b.innerHTML = '<i class="fas fa-check-double" title="পড়া হয়েছে"></i>';
    }

    // ── টাইপিং-সিগন্যাল ────────────────────────────────────────────────
    msgInput.addEventListener('input', () => {
      if (!convId || isGroupChat) return;
      if (typingTimeout) clearTimeout(typingTimeout);
      fetch('/api/messages/typing', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conv_id: convId }) });
      typingTimeout = setTimeout(() => {}, 6000);
    });

    function markConvSeen() {
      if (!convId) return;
      fetch('/api/messages/seen-all', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conv_id: convId }) });
    }

    // ── পোলিং (সেশন ৭৬: অ্যাডাপটিভ — ফোকাসড উইন্ডোতে ২.৫সে, লুকানো হলে ১০সে) ──
    async function poll() {
      if (!convId) return;
      try {
        const res = await fetch('/api/messages/poll?conv_id=' + convId + '&since=' + lastMsgId);
        const data = await res.json();

        if (data.messages && data.messages.length) {
          /* সেশন ৭৮: ব্যাচ-অ্যারাইভালে প্রথম মেসেজের আগের অবস্থান মানি — নইলে
             smooth-scroll-রেসে মাঝের মেসেজগুলো ভুলভাবে 'স্ক্রল-আপ' ধরে FAB-ব্যাজ বাড়ায় */
          const wasNearBottom78 = isNearBottom();
          let gotOthers = false; /* সেশন ৮০: রিসিভ-ডিং ব্যাচে একবারই */
          data.messages.forEach(m => { lastMsgId = Math.max(lastMsgId, m.id); appendMessage(m, wasNearBottom78); if (!m.is_me) gotOthers = true; });
          if (gotOthers) SoundFX.receive();
          markConvSeen();
          if (window.lfMsgSearchRefresh) try { window.lfMsgSearchRefresh(); } catch (_) {} /* সেশন ৮৯: নতুন বাবলেও সার্চ-হাইলাইট সিঙ্ক */
        }

        // সেশন ৭৬: লাইভ-এডিট প্রোপাগেশন — পুরনো বাবলের নতুন এডিট ক্লায়েন্টে বসাও
        if (data.edits && data.edits.length) {
          data.edits.forEach(ed => {
            const b = body.querySelector('.bubble[data-id="' + ed.id + '"]');
            if (!b) return;
            const t = b.querySelector('.bubble-text');
            if (t && ed.body) t.textContent = ed.body;
            if (!b.querySelector('.bubble-edited')) {
              const bt = b.querySelector('.bubble-text');
              if (bt) bt.insertAdjacentHTML('afterend', '<span class="bubble-edited">সম্পাদিত</span>');
            }
          });
        }

        if (typeof data.seen_upto === 'number' && data.seen_upto > seenUpto) {
          seenUpto = data.seen_upto;
          updateSeenAvatar();
        }

        const ti = document.getElementById('typingIndicator');
        if (ti) ti.classList.toggle('show', !!data.typing);

        if (!isGroupChat) {
          const dot = document.getElementById('otherOnlineDot');
          const mdpDot = document.getElementById('mdpDot');
          const statusText = document.getElementById('otherStatusText');
          if (dot) dot.style.display = data.online ? 'block' : 'none';
          if (mdpDot) mdpDot.style.display = data.online ? 'block' : 'none';
          if (statusText) {
            statusText.textContent = data.online ? 'এখনই অনলাইন' : '@' + otherUsername;
            statusText.className = data.online ? 'st-online' : '';
          }
        }

        // সাইডবার অনলাইন-ডট
        const userIds = [...document.querySelectorAll('.messenger-list .online-dot')].map(d => d.dataset.userId).filter(Boolean);
        await Promise.all([...new Set(userIds)].map(async uid => {
          try {
            const r = await fetch('/api/messages/online?user_id=' + uid);
            const d = await r.json();
            document.querySelectorAll('.messenger-list .online-dot[data-user-id="' + uid + '"]').forEach(dot => {
              dot.style.display = d.online ? 'block' : 'none';
            });
          } catch {}
        }));
      } catch (e) { /* silent */ }
    }
    let pollTimer = null;
    function isTabActive() { return document.visibilityState === 'visible' && document.hasFocus(); }
    function schedulePoll() {
      clearTimeout(pollTimer);
      pollTimer = setTimeout(async () => { await poll(); schedulePoll(); }, isTabActive() ? 2500 : 10000);
    }
    function kickPollNow() {
      clearTimeout(pollTimer);
      pollTimer = setTimeout(async () => { await poll(); schedulePoll(); }, 400);
    }
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') kickPollNow(); else schedulePoll(); });
    window.addEventListener('focus', kickPollNow);
    window.addEventListener('blur', schedulePoll);
    schedulePoll();
    setTimeout(poll, 800);
    /* সেশন ৯৯ (রোডম্যাপ-০১): SSE পুশ-হুক — live.js 'message'-ইভেন্টে এই কথোপকথন
       খোলা থাকলে তাৎক্ষণিক kick (লেটেন্সি ২.৫সে-পোল → ~০; পোলিং ফলব্যাক অক্ষত) */
    window.lfMsgSSEKick = kickPollNow;
    window.lfMsgConvId = convId || null;

    // ── কথোপকথনের ভেতরে মেসেজ-সার্চ (সেশন ৮২ বেসিক-ফিল্টার → সেশন ৮৯ C2-আপগ্রেড:
    //    <mark> হাইলাইট + ম্যাচ-কাউন্টার + Enter/Shift+Enter ↑↓ নেভিগেশন + Esc-ক্লিয়ার) ──
    (function () {
      const cis = document.getElementById('convInSearch');
      if (!cis) return;
      const tools = document.getElementById('cisTools');
      const counter = document.getElementById('cisCounter');
      const clearBtn = document.getElementById('cisClear');
      const BN89 = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      const bn89 = (n) => String(n).replace(/[0-9]/g, (d) => BN89[d]);
      let matches = [], idx = -1, query = '';

      function unwrapAll(root) {
        root.querySelectorAll('mark.msg-hl').forEach((m) => {
          const p = m.parentNode;
          p.replaceChild(document.createTextNode(m.textContent), m);
          p.normalize();
        });
      }
      function highlight(root, q) {
        const rx = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode: function (n) {
            if (!n.nodeValue || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
            const p = n.parentElement;
            if (!p || p.closest('mark, .bubble-edited, button, .bubble-time, .bubble-reacts')) return NodeFilter.FILTER_REJECT;
            rx.lastIndex = 0;
            return rx.test(n.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
          }
        });
        const hits = [];
        while (walker.nextNode()) hits.push(walker.currentNode);
        hits.forEach((node) => {
          const frag = document.createDocumentFragment();
          let last = 0; const text = node.nodeValue;
          rx.lastIndex = 0; let m;
          while ((m = rx.exec(text))) {
            if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
            const mark = document.createElement('mark');
            mark.className = 'msg-hl';
            mark.textContent = m[0];
            frag.appendChild(mark);
            last = m.index + m[0].length;
          }
          if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
          node.parentNode.replaceChild(frag, node);
        });
      }
      function scrollToMatch(i) {
        if (!matches.length) return;
        idx = ((i % matches.length) + matches.length) % matches.length;
        matches.forEach((el, j) => el.classList.toggle('msg-hl-active', j === idx));
        const el = matches[idx];
        if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
        if (counter) counter.textContent = bn89(idx + 1) + '/' + bn89(matches.length);
      }
      function apply() {
        matches.forEach((el) => el.classList.remove('msg-hl-active'));
        unwrapAll(body);
        matches = []; idx = -1; query = cis.value.trim();
        const bubbles = body.querySelectorAll('.bubble');
        if (!query) {
          bubbles.forEach((b) => { b.style.display = ''; });
          if (tools) tools.hidden = true;
          if (clearBtn) clearBtn.hidden = true;
          return;
        }
        highlight(body, query);
        matches = Array.from(body.querySelectorAll('mark.msg-hl'));
        const okBubbles = new Set(matches.map((m) => m.closest('.bubble')));
        bubbles.forEach((b) => { b.style.display = okBubbles.has(b) ? '' : 'none'; });
        if (clearBtn) clearBtn.hidden = false;
        if (tools) tools.hidden = false; /* সেশন ৯৩: ০-ম্যাচেও দৃশ্যমান — সার্ভার-সার্চ বাটন দরকার */
        if (matches.length) scrollToMatch(0);
        else if (counter) counter.textContent = '০/০';
        /* সেশন ৯৩: ক্লায়েন্ট-ম্যাচ ০ হলে সার্ভার-সার্চ অটো-ট্রিগার (উইন্ডোর-বাইরের পুরনো বার্তা) */
        if (window.lfMsgServerSearch) {
          if (!matches.length && query.length >= 2) window.lfMsgServerSearch(query);
          else if (matches.length && window.lfMsgServerHide) window.lfMsgServerHide();
        }
      }
      let t89 = null;
      cis.addEventListener('input', function () { clearTimeout(t89); t89 = setTimeout(apply, 160); });
      cis.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); scrollToMatch(idx + (e.shiftKey ? -1 : 1)); }
        if (e.key === 'Escape') { cis.value = ''; apply(); cis.blur(); }
      });
      const nextBtn = document.getElementById('cisNext');
      const prevBtn = document.getElementById('cisPrev');
      if (nextBtn) nextBtn.addEventListener('click', function () { scrollToMatch(idx + 1); });
      if (prevBtn) prevBtn.addEventListener('click', function () { scrollToMatch(idx - 1); });
      if (clearBtn) clearBtn.addEventListener('click', function () { cis.value = ''; apply(); cis.focus(); });
      /* poll-নতুন বাবল এলে সার্চ-স্টেট রিফ্রেশ (poll() থেকে কল হয়) */
      window.lfMsgSearchRefresh = function () { if (query) apply(); };
    })();

    // ── সেশন ৯৩ (রোডম্যাপ-১১): আগের-বার্তা লোডার + জাম্প-হাইলাইট + সার্ভার-সার্চ + রিপ্লাই-জাম্প ──
    (function () {
