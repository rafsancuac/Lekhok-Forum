        const menu = rb.parentElement.querySelector('.bubble-react-menu');
        document.querySelectorAll('.bubble-react-menu:not([hidden])').forEach(m => { if (m !== menu) m.hidden = true; });
        if (menu) {
          menu.hidden = !menu.hidden;
          /* সেশন ৭৮: চ্যাটের একদম উপরের মেসেজে ক্যাপসুল ক্লিপ হলে নিচে-ফ্লিপ */
          if (!menu.hidden) {
            menu.classList.remove('flip-below');
            const mr = menu.getBoundingClientRect();
            const br = body.getBoundingClientRect();
            if (mr.top < br.top + 10) menu.classList.add('flip-below');
          }
