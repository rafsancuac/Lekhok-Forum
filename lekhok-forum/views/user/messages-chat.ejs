    // ── ফাইল-প্রিভিউ (সেশন ৭৮: থাম্বনেইল + সাইজ + টাইপ-আইকন) ──
    const fileInput = document.getElementById('fileInput');
    const filePreview = document.getElementById('filePreview');
    const fpThumb = document.getElementById('filePreviewThumb');
    const fpIcon = document.getElementById('filePreviewIcon');
    let fpThumbUrl = null;

    function humanSize(n) {
      if (!n && n !== 0) return '';
      if (n < 1024) return n + ' বাইট';
      if (n < 1048576) return (n / 1024).toFixed(1) + ' কিলোবাইট';
      if (n < 1073741824) return (n / 1048576).toFixed(1) + ' মেগাবাইট';
      return (n / 1073741824).toFixed(1) + ' গিগাবাইট';
    }
    function resetFilePreviewUI() {
      if (fpThumbUrl) { URL.revokeObjectURL(fpThumbUrl); fpThumbUrl = null; }
      if (fpThumb) { fpThumb.removeAttribute('src'); fpThumb.hidden = true; }
      if (fpIcon) { fpIcon.className = 'fas fa-paperclip'; fpIcon.hidden = false; }
    }
    fileInput?.addEventListener('change', () => {
      const f = fileInput.files && fileInput.files[0];
      if (!f) { filePreview.hidden = true; resetFilePreviewUI(); return; }
      document.getElementById('filePreviewName').textContent = f.name;
      document.getElementById('filePreviewSize').textContent = humanSize(f.size);
      const ext = (f.name.split('.').pop() || '').toLowerCase();
      if (fpIcon) {
        if (/^(jpe?g|png|gif|webp|bmp|svg|avif)$/.test(ext) || /^image\//.test(f.type)) fpIcon.className = 'fas fa-file-image';
        else if (ext === 'pdf') fpIcon.className = 'fas fa-file-pdf';
        else if (/^(zip|rar|7z|gz|tar)$/.test(ext)) fpIcon.className = 'fas fa-file-zipper';
        else if (/^(mp3|wav|ogg|m4a|aac)$/.test(ext) || /^audio\//.test(f.type)) fpIcon.className = 'fas fa-file-audio';
        else if (/^(mp4|mkv|mov|avi|webm)$/.test(ext) || /^video\//.test(f.type)) fpIcon.className = 'fas fa-file-video';
        else if (/^(docx?|txt|rtf|odt|md)$/.test(ext)) fpIcon.className = 'fas fa-file-lines';
        else if (/^(xlsx?|csv)$/.test(ext)) fpIcon.className = 'fas fa-file-excel';
        else fpIcon.className = 'fas fa-paperclip';
      }
      if (fpThumb) {
        if (/^image\//.test(f.type)) {
          if (fpThumbUrl) URL.revokeObjectURL(fpThumbUrl);
          fpThumbUrl = URL.createObjectURL(f);
          fpThumb.src = fpThumbUrl;
          fpThumb.hidden = false;
          if (fpIcon) fpIcon.hidden = true; /* থাম্বনেইল থাকলে আইকন লুকাই */
        } else {
          fpThumb.hidden = true;
          if (fpIcon) fpIcon.hidden = false;
        }
      }
      filePreview.hidden = false;
    });
    document.getElementById('filePreviewRemove')?.addEventListener('click', () => {
      fileInput.value = '';
      filePreview.hidden = true;
      resetFilePreviewUI();
    });


    /* ══════════ সেশন ৯২: ভয়েস-নোট ইঞ্জিন (রোডম্যাপ আইটেম ১০) ══════════
       MediaRecorder রেকর্ড → রেকর্ডিং-স্টেট UI → বাতিল/পাঠান → অ্যাটাচমেন্ট-এন্ডপয়েন্টে
       আপলোড (একই POST sendUrl — attachment ফিল্ড) → optimistic ওয়েভফর্ম-বাবল।
       প্লেয়ার: পেজে ১টি শেয়ার্ড Audio — .bv-play ডেলিগেশন, বার-প্রগ্রেস, বাংলা-টাইম। */

    const bnDg = (n) => String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; });
    const bnTime = (t) => { t = Math.max(0, Math.floor(t)); return bnDg(Math.floor(t / 60)) + ':' + bnDg(String(t % 60).padStart(2, '0')); };

    // ── ভয়েস-প্লেয়ার (ডেলিগেশন — পোলে-আসা বাবলেও স্বয়ংক্রিয়) ──
    (function voicePlayer() {
      let audio = null, cur = null;
      function resetUI(p, backToDur) {
        p.classList.remove('is-playing');
        const ic = p.querySelector('.bv-play i');
        if (ic) ic.className = 'fas fa-play';
        p.querySelectorAll('.bv-wave span.played').forEach(function (s) { s.classList.remove('played'); });
        if (backToDur && p.dataset.duration) {
          const tm = p.querySelector('.bv-time');
          if (tm) tm.textContent = bnTime(parseInt(p.dataset.duration, 10));
        }
      }
      document.addEventListener('click', function (e) {
        const btn = e.target.closest('.bv-play');
        if (!btn) return;
        const player = btn.closest('.bubble-voice');
        if (!player || !player.dataset.src) return;
        if (!audio) {
          audio = new Audio();
          audio.preload = 'metadata';
          audio.addEventListener('timeupdate', function () {
            if (!cur) return;
            const d = audio.duration || parseFloat(cur.dataset.duration || '0') || 0;
            const pct = d ? Math.min(1, audio.currentTime / d) : 0;
            const bars = cur.querySelectorAll('.bv-wave span');
            const n = Math.floor(pct * bars.length);
            bars.forEach(function (s, i) { s.classList.toggle('played', i < n); });
            const tm = cur.querySelector('.bv-time');
            if (tm) tm.textContent = bnTime(audio.currentTime);
          });
          audio.addEventListener('ended', function () {
            if (cur) { resetUI(cur, true); cur = null; }
          });
        }
        if (cur === player && !audio.paused) { audio.pause(); resetUI(player, false); return; }
        if (cur !== player) {
          if (cur) resetUI(cur, true);
          cur = player;
          if (!audio.src || audio.src !== player.dataset.src) audio.src = player.dataset.src;
          audio.currentTime = 0;
        }
        const ic = btn.querySelector('i');
        audio.play().then(function () { if (ic) ic.className = 'fas fa-pause'; player.classList.add('is-playing'); }).catch(function () {});
        if (!player.dataset.duration) {
          audio.addEventListener('loadedmetadata', function once() {
            audio.removeEventListener('loadedmetadata', once);
            if (!cur || cur !== player) return;
            if (isFinite(audio.duration) && audio.duration > 0) {
              player.dataset.duration = String(Math.round(audio.duration));
              const tm = player.querySelector('.bv-time');
              if (tm) tm.textContent = bnTime(audio.duration);
            }
          });
        }
      });
    })();

    // ── ডিটেইলস-প্যানেল শেয়ার্ড-কনটেন্ট ট্যাব (মিডিয়া/ফাইল/লিংক) ──
    const mdTabs = document.getElementById('mdTabs');
    mdTabs?.addEventListener('click', function (e) {
      const t = e.target.closest('.md-tab');
      if (!t) return;
      mdTabs.querySelectorAll('.md-tab').forEach(function (x) {
        const on = x === t;
        x.classList.toggle('is-active', on);
        x.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      document.querySelectorAll('.md-tabpane').forEach(function (p) { p.hidden = p.dataset.pane !== t.dataset.mtab; });
    });

    // ── সেশন ৯৪: কল-ইতিহাস ট্যাব (লেজি-ফেচ + রেন্ডার — /api/calls/history) ──
    (function () {
      const callsTab = document.getElementById('mdCallsTab');
      if (!callsTab) return; /* গ্রুপ-চ্যাটে ট্যাব নেই */
      const body = document.getElementById('mdCallsBody');
      const count = document.getElementById('mdCallsCount');
      let loaded = false, loading = false;
      const BN94 = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      const bn94 = (n) => String(n).replace(/[0-9]/g, (d) => BN94[+d]);
      function dur94(s) {
        if (s == null) return '';
        const m = Math.floor(s / 60), ss = s % 60;
        return m > 0 ? (bn94(m) + ' মি ' + bn94(ss) + ' সে') : (bn94(ss) + ' সে');
      }
      function rel94(ts) {
        const t = new Date(String(ts).replace(' ', 'T') + 'Z').getTime();
        if (isNaN(t)) return '';
        const m = Math.floor((Date.now() - t) / 60000);
        if (m < 1) return 'এইমাত্র';
        if (m < 60) return bn94(m) + ' মিনিট আগে';
        const h = Math.floor(m / 60);
        if (h < 24) return bn94(h) + ' ঘণ্টা আগে';
        const d = Math.floor(h / 24);
        if (d === 1) return 'গতকাল';
        if (d < 7) return bn94(d) + ' দিন আগে';
        return new Date(t).toLocaleDateString('bn-BD');
      }
      const ST94 = { ended: 'সম্পন্ন', declined: 'প্রত্যাখ্যাত', cancelled: 'বাতিল', missed: 'মিসড' };
      function esc94(x) { return String(x || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
      function row94(c) {
        const missed = c.status === 'missed' || c.status === 'declined' || c.status === 'cancelled';
        const dirIc = c.direction === 'outgoing' ? 'fa-arrow-up-right' : 'fa-arrow-down-left';
        const st = ST94[c.status] || esc94(c.status);
        const subTxt = c.status === 'ended' && c.duration_s != null ? dur94(c.duration_s) : st;
        /* সেশন ৯৭: কলব্যাক-বাটন — রো-ক্লিকে একই পিয়ারকে অডিও-কল (আইডলে থাকলে) */
        const cbAttr = 'data-cb94="' + esc94(c.direction) + '" data-cbkind="' + esc94(c.kind) + '"';
        return '<div class="md-callrow' + (missed ? ' is-missed' : '') + '" ' + cbAttr + ' role="button" tabindex="0" title="কলব্যাক দিন">' +
          '<span class="mdc-ic"><i class="fas ' + (c.kind === 'video' ? 'fa-video' : 'fa-phone') + '"></i></span>' +
          '<span class="mdc-body"><span class="mdc-dir"><i class="fas ' + dirIc + '"></i> ' + (c.direction === 'outgoing' ? 'আউটগোয়িং' : 'ইনকামিং') + ' ' + (c.kind === 'video' ? 'ভিডিও' : 'অডিও') + ' কল</span>' +
          '<span class="mdc-sub">' + esc94(subTxt) + ' · ' + esc94(rel94(c.created_at)) + '</span></span>' +
          '<span class="mdc-right"><span class="mdc-st ' + (missed ? 'is-bad' : 'is-ok') + '">' + esc94(ST94[c.status] || c.status) + '</span>' +
          '<button type="button" class="mdc-cb" title="কলব্যাক দিন" aria-label="কলব্যাক দিন"><i class="fas fa-phone"></i></button></span>' +
          '</div>';
      }
      /* কলব্যাক: ডেলিগেটেড-ক্লিক (রো-রি-রেন্ডার-নিরাপদ) — কল-মডিউল আইডলে থাকলেই */
      body.addEventListener('click', function (e) {
        const row = e.target.closest('.md-callrow');
        if (!row || !window.LekhokCall || window.LekhokCall.state() !== 'idle') return;
        e.preventDefault();
        window.LekhokCall.start('audio');
      });
      body.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const row = e.target.closest('.md-callrow');
        if (!row || !window.LekhokCall || window.LekhokCall.state() !== 'idle') return;
        e.preventDefault();
        window.LekhokCall.start('audio');
      });
      async function loadCalls(force) {
        if ((loaded && !force) || loading || !convId) return;
        loading = true;
        try {
          const res = await fetch('/api/calls/history?conv_id=' + convId);
          const data = await res.json();
          if (data && data.ok) {
            const list = data.calls || [];
            if (count) count.textContent = list.length ? bn94(list.length) : '';
            body.innerHTML = list.length
              ? ('<div class="md-calls">' + list.map(row94).join('') + '</div>')
              : '<div class="md-media-empty">কোনো কল-ইতিহাস নেই।</div>';
            loaded = true;
          } else {
            body.innerHTML = '<div class="md-media-empty">কল-ইতিহাস লোড করা যায়নি।</div>';
          }
        } catch (_) {
          body.innerHTML = '<div class="md-media-empty">নেটওয়ার্ক সমস্যা — আবার চেষ্টা করুন।</div>';
        }
        loading = false;
      }
      mdTabs?.addEventListener('click', function (e) { if (e.target.closest('#mdCallsTab')) loadCalls(false); });
      document.getElementById('mdMediaRefresh')?.addEventListener('click', function () { loaded = false; if (callsTab.classList.contains('is-active')) loadCalls(true); });
    })();

    // ── রেকর্ডার ──
    const micBtn = document.getElementById('micBtn');
    const voiceRec = document.getElementById('voiceRec');
    const vrTime = document.getElementById('vrTime');
    const vrCancel = document.getElementById('vrCancel');
    const vrSend = document.getElementById('vrSend');
    let recState = null;

    function recUi(on) {
      if (voiceRec) voiceRec.hidden = !on;
      chatForm.classList.toggle('is-recording', on);
      if (micBtn) micBtn.hidden = on;
      msgInput.disabled = on;
    }
    function cleanupRec() {
      if (!recState) return;
      if (recState.timer) clearInterval(recState.timer);
      try { recState.stream.getTracks().forEach(function (t) { t.stop(); }); } catch (_) {}
      recState = null;
      recUi(false);
    }
    async function startRec() {
      if (recState) return;
      if (!navigator.mediaDevices || !window.MediaRecorder) { fbToast('এই ব্রাউজারে ভয়েস রেকর্ডিং সমর্থিত নয়'); return; }
      let stream;
      try { stream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
      catch (e) { fbToast('মাইক্রোফোনের অনুমতি দিন 🎙️'); return; }
      let mime = '', ext = 'webm';
      const cands = [['audio/webm;codecs=opus', 'webm'], ['audio/webm', 'webm'], ['audio/mp4', 'm4a'], ['audio/ogg;codecs=opus', 'ogg'], ['audio/ogg', 'ogg']];
      for (var i = 0; i < cands.length; i++) {
        if (MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(cands[i][0])) { mime = cands[i][0]; ext = cands[i][1]; break; }
      }
      let rec;
      try { rec = (mime ? new MediaRecorder(stream, { mimeType: mime }) : new MediaRecorder(stream)); }
      catch (e) { try { rec = new MediaRecorder(stream); } catch (e2) { stream.getTracks().forEach(function (t) { t.stop(); }); fbToast('রেকর্ডার চালু করা যায়নি'); return; } }
      const chunks = [];
      rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
      recState = { rec: rec, stream: stream, chunks: chunks, ext: ext, t0: Date.now(), timer: null, stopped: false };
      rec.start(250);
      recUi(true);
      if (vrTime) vrTime.textContent = '০:০০';
      /* রেকর্ডিং-চলাকালেও টাইপিং-সিগন্যাল (FB-আচরণ — প্রাপক জানবেন কিছু আসছে) */
      try { if (convId && !isGroupChat) fetch('/api/messages/typing', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conv_id: convId }) }); } catch (_) {}
      recState.timer = setInterval(function () {
        if (!recState) return;
        const el = Math.floor((Date.now() - recState.t0) / 1000);
        if (vrTime) vrTime.textContent = bnTime(el);
        if (el >= 120) stopRec(true); /* ২-মিনিট সর্বোচ্চ */
      }, 250);
    }
    function stopRec(send) {
      if (!recState || recState.stopped) return;
      recState.stopped = true;
      const st = recState;
      const dur = Date.now() - st.t0;
      st.rec.onstop = function () {
        const blob = new Blob(st.chunks, { type: (st.rec.mimeType || 'audio/webm').split(';')[0] });
        cleanupRec();
        if (send) {
          if (!blob.size || dur < 600) { fbToast('রেকর্ডিং খুব ছোট — আবার চেষ্টা করুন'); return; }
          sendVoice(blob, st.ext);
        }
      };
      try { st.rec.stop(); } catch (e) { cleanupRec(); }
    }
    async function sendVoice(blob, ext) {
      const name = 'voice-' + Date.now() + '.' + ext;
      const optId = 'tmp-v' + Date.now();
      const objUrl = URL.createObjectURL(blob);
      const opt = { id: optId, body: '', file_url: objUrl, file_name: name, is_me: true, created_at: new Date().toISOString() };
      appendMessage(opt);
      if (typeof SoundFX !== 'undefined') { try { SoundFX.send(); } catch (_) {} }
      const fd = new FormData();
      fd.append('body', '');
      try { fd.append('attachment', new File([blob], name, { type: blob.type || 'audio/webm' })); }
      catch (e) { fd.append('attachment', blob, name); }
      try {
        const csrfM = document.querySelector('meta[name="csrf-token"]');
        const res = await fetch(sendUrl, { method: 'POST', body: fd, headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrfM ? csrfM.content : '' }, redirect: 'manual' });
        let d = null; try { d = await res.json(); } catch (_) {}
        if (res.type === 'opaqueredirect' || res.status === 0 || res.ok) {
          if (d && d.id) {
            const t = document.querySelector('.bubble[data-id="' + optId + '"]');
            if (t) t.dataset.id = String(d.id);
          }
          if (window.MSA) window.MSA.afterSent();
          setTimeout(poll, 500);
        } else {
          document.querySelector('.bubble[data-id="' + optId + '"]')?.remove();
          fbToast((d && d.error) || 'ভয়েস মেসেজ পাঠানো যায়নি');
        }
      } catch (e) {
        document.querySelector('.bubble[data-id="' + optId + '"]')?.remove();
        fbToast('নেটওয়ার্ক সমস্যা — ভয়েস মেসেজ পাঠানো যায়নি');
      }
    }
    micBtn?.addEventListener('click', startRec);
    vrSend?.addEventListener('click', function () { stopRec(true); });
    vrCancel?.addEventListener('click', function () { stopRec(false); });
    window.addEventListener('beforeunload', cleanupRec);

    // ── সেশন ৯৩: একক ✕-আনসেন্ড-বাটন বাদ — আনসেন্ড এখন ⋮-মেনুতে (messenger-actions.js) ──

  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/messenger-actions.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <%# সেশন ৯৩: WebRTC কল — bootstrap-কনটেক্সট (me/peer/conv); মডিউল নিজে এখন
      header.ejs থেকে গ্লোবালি লোড হয় (সেশন ৯৪) — এখানে ctx-সমৃদ্ধকরণই যথেষ্ট %>
  <script>
    window.LekhokCallCtx = {
      me: <%- parseInt(user.id, 10) %>,
      meName: <%- jesc(user.full_name || user.username) %>,
      meAvatar: <%- jesc(user.avatar_url || ('/avatar/' + user.id)) %>,
      convId: <%= conv ? conv.id : 0 %>,
      convUsername: <%- jesc(other.username) %>,
      isGroup: <%= isGroup ? 'true' : 'false' %>,
      peer: <% if (isGroup) { %>null<% } else { %>{ id: <%- parseInt(other.id, 10) %>, name: <%- jesc(other.full_name) %>, username: <%- jesc(other.username) %>, avatar: <%- jesc(other.avatar_url || ('/avatar/' + other.id)) %> }<% } %>
    };
  </script>
  <%# (webrtc-call.js — header.ejs-এ গ্লোবালি লোড হয়, সেশন ৯৪) %>
  <script>
    // পুরো কথোপকথন মুছুন (AJAX)
    async function deleteConversation(username) {
      if (!confirm('নিশ্চিত? পুরো কথোপকথনটি মুছে যাবে।')) return;
      try {
        const res = await fetch('/messages/' + encodeURIComponent(username) + '/delete', {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (res.ok) {
          window.location.href = '/messages';
        } else {
          alert('মুছতে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
        }
      } catch (e) {
        alert('নেটওয়ার্ক সমস্যা।');
      }
    }
  </script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
