<%# সেশন ৭৫ — ফেসবুক মেসেঞ্জার-স্টাইল চ্যাট-ভিউ (৩-কলাম: লিস্ট + চ্যাট + ডিটেইলস) %>
<%- include('../partials/header', { title: (other.full_name) + ' | মেসেজ | লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css', '/assets/css/messenger.css'] }) %>

<%
  // ── ক্লাস্টার-হেল্পার: পরপর একই প্রেরকের বাবল গুচ্ছ বাঁধে (FB-আচরণ) ──
  function clusterInfo(list, idx) {
    var m = list[idx], p = list[idx - 1] || null, n = list[idx + 1] || null;
    var t = function (x) { return new Date(x.created_at).getTime(); };
    var samePrev = p && p.sender_id === m.sender_id && (t(m) - t(p) < 3 * 60 * 1000);
    var sameNext = n && n.sender_id === m.sender_id && (t(n) - t(m) < 3 * 60 * 1000);
    return { samePrev: !!samePrev, sameNext: !!sameNext };
  }
  function dateLabel(ds) {
    var d = new Date(ds); d.setHours(0, 0, 0, 0);
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var diff = Math.round((today - d) / 86400000);
    if (diff === 0) return 'আজ';
    if (diff === 1) return 'গতকাল';
    return d.toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  var _isImg = function (u) { return u && /\.(jpe?g|png|gif|webp|svg|bmp)$/i.test(u); };
  var _sharedImgs = messages.filter(function (m) { return _isImg(m.file_url); }).slice(-9).reverse();
  var _lastOwnRead = null;
  messages.forEach(function (m) { if (m.sender_id === user.id && m.is_read) _lastOwnRead = m; });
%>

  <div class="page-wrap page-wrap--messenger">
    <div class="messenger-shell has-details" id="messengerShell">

      <%# ── বাম: কথোপকথন-তালিকা ──────────────────────────────────────── %>
      <aside class="messenger-list" id="messengerList">
        <div class="messenger-list-head">
          <div class="msg-head-row">
            <h2><i class="fas fa-comment-dots"></i> চ্যাট</h2>
            <a href="/messages" class="fb-icon-btn" style="margin-left:auto" title="সব কথোপকথন"><i class="fas fa-arrow-left"></i></a>
          </div>
          <div class="msg-search-wrap" id="msgSearchWrap">
            <i class="fas fa-search msg-search-icon"></i>
            <input type="search" class="messenger-search msg-search-input" id="convSearch" placeholder="মেসেঞ্জারে খুঁজুন" autocomplete="off" />
            <button type="button" class="msg-search-clear" id="convSearchClear" hidden><i class="fas fa-times"></i></button>
          </div>
          <div class="msg-search-results" id="convSearchResults" hidden>
            <div class="msr-section" id="csrConversations" hidden>
              <div class="msr-section-head"><span><i class="fas fa-comments"></i> কথোপকথন</span><span class="msr-count" id="csrConvCount"></span></div>
              <div id="csrConvList"></div>
            </div>
            <div class="msr-section" id="csrUsers" hidden>
              <div class="msr-section-head"><span><i class="fas fa-user-plus"></i> নতুন কথোপকথন</span><span class="msr-count" id="csrUserCount"></span></div>
              <div id="csrUserList"></div>
            </div>
            <div class="msr-empty" id="csrEmpty" hidden><i class="fas fa-search"></i><p>কোনো ফলাফল নেই</p></div>
          </div>
        </div>
        <% if (!conversations.length) { %>
          <div class="empty-state-full">
            <i class="fas fa-comment-slash"></i>
            <p>এখনো কোনো কথোপকথন নেই।</p>
            <a href="/members" class="fb-icon-btn fb-icon-btn--accent" style="width:auto;padding:0 16px;height:34px;border-radius:99px;font-weight:700;font-size:13px">সদস্য খুঁজুন</a>
          </div>
        <% } %>
        <% conversations.forEach(c => { %>
          <a href="<%= c.conv_link || ('/messages/' + c.other_username) %>" class="conv-item <%= !isGroup && c.other_username === other.username ? 'active' : '' %> <%= isGroup && c.id === conv.id ? 'active' : '' %> <%= c.is_group_flag ? 'is-group' : '' %>" data-name="<%= c.other_name.toLowerCase() %>" data-id="<%= c.id %>">
            <div class="avatar avatar-md" style="position:relative">
              <% if (c.is_group_flag) { %>
              <span class="group-avatar"><i class="fas fa-users"></i></span>
              <% } else { %>
              <img loading="lazy" decoding="async" src="<%= c.other_avatar || ('/avatar/' + (c.user_a === user.id ? c.user_b : c.user_a)) %>" alt="<%= c.other_name %>" onerror="this.onerror=null;this.src='/avatar/<%= c.user_a === user.id ? c.user_b : c.user_a %>'" />
              <span class="online-dot" data-user-id="<%= c.user_a === user.id ? c.user_b : c.user_a %>" style="display:none"></span>
              <% } %>
            </div>
            <div class="conv-meta">
              <div class="conv-name"><%= c.other_name %></div>
              <div class="conv-snippet"><%= c.last_body ? c.last_body.replace(/<[^>]+>/g, '').slice(0, 42) : 'নতুন কথোপকথন' %></div>
            </div>
            <div class="conv-meta-right">
              <% if (c.unread_count > 0) { %><span class="conv-unread"><%= c.unread_count %></span><% } %>
              <span class="conv-mute-tag" hidden title="মিউট করা"><i class="fas fa-bell-slash"></i></span>
              <span class="conv-menu-btn" role="button" tabindex="0" aria-label="কথোপকথন-অপশন" data-conv-menu="<%= c.id %>"><i class="fas fa-ellipsis"></i></span>
            </div>
          </a>
        <% }); %>
      </aside>

      <%# ── মাঝ: মূল চ্যাট ─────────────────────────────────────────────── %>
      <section class="messenger-chat" id="messengerChat">
        <% if (typeof err !== 'undefined' && err) { %>
          <div class="chat-error"><i class="fas fa-exclamation-triangle"></i> <%= err %></div>
        <% } %>
        <%# সেশন ৮৬: গ্রুপ-সংযোজন রোল-নীতি নোটিশ (দৃশ্যমান — চ্যাটের একদম উপরে) %>
        <% if (typeof blocked !== 'undefined' && blocked) { %>
          <div style="background:#fef3c7;border-bottom:1px solid #fde68a;color:#92400e;font-size:13px;padding:9px 16px;display:flex;gap:9px;align-items:flex-start;">
            <i class="fas fa-shield-halved" style="margin-top:2px;"></i><span><%= blocked %> জন সদস্য যুক্ত করা যায়নি — রোল-নীতি (পাশাপাশি পদের মধ্যে সরাসরি সংযোগ বন্ধ)।</span>
          </div>
        <% } %>
        <header class="chat-header">
          <button class="back-btn" id="fbBackBtn" title="ফিরে যান">
            <i class="fas fa-chevron-left"></i>
          </button>
          <div class="avatar avatar-md" style="position:relative">
            <img loading="lazy" decoding="async" src="<%= other.avatar_url || ('/avatar/' + other.id) %>" alt="<%= other.full_name %>" onerror="this.onerror=null;this.src='/avatar/<%= other.id %>'" />
            <span class="online-dot" id="otherOnlineDot" data-user-id="<%= other.id %>" style="display:none"></span>
          </div>
          <div class="info">
            <h3><% if (isGroup) { %><i class="fas fa-users" style="color:var(--fb-blue);font-size:13px"></i> <%= other.full_name %><% } else { %><a href="/profile/<%= other.username %>"><%= other.full_name %></a><% } %></h3>
            <div class="status" id="otherStatus">
              <% if (isGroup) { %><i class="fas fa-users" style="font-size:9px"></i> <%= members.length %> সদস্য<% } else { %><i class="fas fa-circle" style="font-size:6px"></i> <span id="otherStatusText"><%= other.online_text || '@' + other.username %></span><% } %>
            </div>
          </div>
          <div class="conv-insearch">
            <i class="fas fa-search"></i>
            <input type="search" id="convInSearch" placeholder="মেসেজ খুঁজুন..." autocomplete="off" />
            <button type="button" class="cis-clear" id="cisClear" hidden title="খোঁজা বন্ধ (Esc)"><i class="fas fa-times"></i></button>
          </div>
          <%# সেশন ৮৯ (C2): ম্যাচ-কাউন্টার + ↑↓ নেভিগেশন — সার্চ-অ্যাকটিভ হলেই দৃশ্যমান %>
          <div class="cis-tools" id="cisTools" hidden>
            <span class="cis-counter" id="cisCounter">০/০</span>
            <button type="button" class="cis-nav" id="cisPrev" title="আগের ম্যাচ (Shift+Enter)"><i class="fas fa-chevron-up"></i></button>
            <button type="button" class="cis-nav" id="cisNext" title="পরের ম্যাচ (Enter)"><i class="fas fa-chevron-down"></i></button>
          </div>
          <div class="fb-chat-actions">
            <% if (!isGroup) { %>
            <button type="button" class="fb-icon-btn" title="অডিও কল (শীঘ্রই)" onclick="fbToast('অডিও-কল ফিচারটি শীঘ্রই আসছে!')"><i class="fas fa-phone"></i></button>
            <button type="button" class="fb-icon-btn" title="ভিডিও কল (শীঘ্রই)" onclick="fbToast('ভিডিও-কল ফিচারটি শীঘ্রই আসছে!')"><i class="fas fa-video"></i></button>
            <% } %>
            <button type="button" class="fb-icon-btn" id="fbInfoBtn" title="তথ্য প্যানেল"><i class="fas fa-circle-info"></i></button>
          </div>
        </header>

        <%# ── সেশন ৭৬: থিম-স্ট্রিপ (চ্যাট-হেডারের নিচে রঙিন ৩px ব্যান্ড, FB-থিমের মতো) ── %>
        <div class="chat-theme-strip" aria-hidden="true"></div>

        <% if (isGroup) { %>
        <% var _gAdmin = conv.user_a === user.id; %>
        <div id="grpPanel" style="display:none;border-bottom:1px solid var(--fb-border);background:#fff;padding:10px 14px;">
          <% if (note === 'added') { %><div style="color:#31A24C;font-size:13px;margin-bottom:6px;"><i class="fas fa-check-circle"></i> সদস্য যোগ করা হয়েছে।</div><% } %>
          <% if (note === 'removed') { %><div style="color:#31A24C;font-size:13px;margin-bottom:6px;"><i class="fas fa-check-circle"></i> সদস্য বাদ দেওয়া হয়েছে।</div><% } %>
          <% if (err === 'perm') { %><div style="color:#e41e3f;font-size:13px;margin-bottom:6px;"><i class="fas fa-exclamation-circle"></i> শুধু গ্রুপ অ্যাডমিন সদস্য যোগ/বাদ করতে পারেন।</div><% } %>
          <% if (err === 'self') { %><div style="color:#e41e3f;font-size:13px;margin-bottom:6px;"><i class="fas fa-exclamation-circle"></i> নিজেকে বা অ্যাডমিনকে বাদ দেওয়া যাবে না।</div><% } %>
          <% if (err === 'owner') { %><div style="color:#e41e3f;font-size:13px;margin-bottom:6px;"><i class="fas fa-exclamation-circle"></i> গ্রুপ ক্রিয়েটর গ্রুপ ছাড়তে পারবেন না।</div><% } %>
          <div style="font-size:12px;font-weight:700;color:#65676B;margin-bottom:6px;">সদস্য তালিকা (<%= members.length %>)</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;">
            <% members.forEach(mm => { %>
              <span class="md-member"><img src="<%= mm.avatar_url || ('/avatar/' + mm.id) %>" style="width:20px;height:20px;border-radius:50%;object-fit:cover" alt="" /><%= mm.full_name %><% if (mm.id === conv.user_a) { %><i class="fas fa-crown" style="color:#d4a017;font-size:10px" title="গ্রুপ অ্যাডমিন"></i><% } %>
                <% if (_gAdmin && mm.id !== user.id && mm.id !== conv.user_a) { %>
                <form method="POST" action="/messages/g/<%= conv.id %>/members/<%= mm.id %>/remove" style="display:inline"><button type="submit" style="border:0;background:none;color:#e41e3f;cursor:pointer;padding:0;font-size:12px" title="বাদ দিন"><i class="fas fa-times"></i></button></form>
                <% } %>
              </span>
            <% }) %>
          </div>
          <% if (_gAdmin) { %>
          <form method="POST" action="/messages/g/<%= conv.id %>/members/add" style="display:flex;gap:6px;">
            <input type="text" name="members" placeholder="ইউজারনেম (কমা দিয়ে একাধিক)" required style="flex:1;padding:8px 14px;border:none;border-radius:99px;font-family:inherit;font-size:13px;background:#F0F2F5;" />
            <button type="submit" class="fb-icon-btn fb-icon-btn--accent" style="width:auto;padding:0 16px;font-weight:700;font-size:13px"><i class="fas fa-user-plus"></i> যোগ</button>
          </form>
          <% } else { %>
          <form method="POST" action="/messages/g/<%= conv.id %>/leave" style="display:inline">
            <button type="submit" class="md-link md-link--danger" style="margin:0;width:auto"><i class="fas fa-sign-out-alt"></i> গ্রুপ ছাড়ুন</button>
          </form>
          <% } %>
        </div>
        <% } %>

        <div class="chat-body" id="chatBody">
          <%
            var _prevDate = null;
          %>
          <% messages.forEach(function(m, idx) { %>
            <%
              var _cl = clusterInfo(messages, idx);
              var _mdate = new Date(m.created_at); _mdate.setHours(0,0,0,0);
              var _showDate = !_prevDate || _mdate.getTime() !== _prevDate.getTime();
              _prevDate = _mdate;
              var _sm = isGroup ? (members || []).find(x => x.id === m.sender_id) : null;
              var _cls = 'bubble ' + (m.sender_id === user.id ? 'me' : 'them');
              if (!_cl.samePrev) _cls += ' first-of-cluster';
              if (!_cl.sameNext) _cls += ' last-of-cluster';
              else if (_cl.samePrev) _cls += ' mid-cluster';
              var _rx = (typeof reactionMap !== 'undefined' && reactionMap[m.id]) || [];
            %>
            <% if (_showDate) { %><div class="date-sep"><span><%= dateLabel(m.created_at) %></span></div><% } %>
            <div class="<%= _cls %>" data-id="<%= m.id %>" data-own="<%= m.sender_id === user.id ? 1 : 0 %>">
              <% if (m.sender_id !== user.id && !_cl.sameNext) { %>
                <img class="b-av" loading="lazy" src="<%= isGroup ? ((_sm && _sm.avatar_url) || ('/avatar/' + m.sender_id)) : (other.avatar_url || ('/avatar/' + other.id)) %>" onerror="this.src='/avatar/<%= m.sender_id %>'" alt="" />
              <% } %>
              <div class="b-content">
                <% if (m.sender_id === user.id) { %>
                <button type="button" class="bubble-delete" data-msg-delete="<%= m.id %>" title="আনসেন্ড (মুছে ফেলুন)"><i class="fas fa-times"></i></button>
                <% } %>
                <button type="button" class="bubble-more" data-msg-more="<%= m.id %>" title="আরও অপশন" aria-haspopup="true"><i class="fas fa-ellipsis"></i></button>
                <% if (isGroup && m.sender_id !== user.id && !_cl.samePrev) { %>
                <div class="bubble-sender"><img src="<%= (_sm && _sm.avatar_url) || ('/avatar/' + m.sender_id) %>" onerror="this.src='/avatar/<%= m.sender_id %>'" alt=""><%= _sm ? _sm.full_name : 'সদস্য' %></div>
                <% } %>
                <% if (m.reply_to_id && (m.reply_body || m.reply_file_name)) { %>
                <%# সেশন ৭৬: রিপ্লাই-কোট (FB-স্টাইল রঙিন বার + প্রিভিউ) %>
                <div class="bubble-quote" data-quote-id="<%= m.reply_to_id %>">
                  <span class="bq-name"><%= m.reply_sender_name || 'মেসেজ' %></span>
                  <span class="bq-text"><%= (m.reply_body || ('📎 ' + (m.reply_file_name || 'ফাইল'))).slice(0, 120) %></span>
                </div>
                <% } %>
                <% if (m.body) { %><div class="bubble-text"><%= m.body %></div><% if (m.edited_at) { %><span class="bubble-edited" title="সম্পাদিত মেসেজ">সম্পাদিত</span><% } %><% } %>
                <% if (m.file_url) { %>
                  <% if (_isImg(m.file_url)) { %>
                    <a href="<%= m.file_url %>" target="_blank" rel="noopener"><img loading="lazy" decoding="async" src="<%= m.file_url %>" alt="<%= m.file_name || 'ছবি' %>" class="bubble-image" /></a>
                  <% } else { %>
                    <a href="<%= m.file_url %>" class="bubble-file" download="<%= m.file_name || 'file' %>">
                      <i class="fas fa-paperclip"></i> <%= m.file_name || 'ফাইল' %>
                    </a>
                  <% } %>
                <% } %>
                <% if (_rx.length) { %><div class="bubble-reacts"><% _rx.forEach(r => { %><span title="<%= r.c %>"><%= r.emoji %><% if (r.c > 1) { %> <%= r.c %><% } %></span><% }); %></div><% } %>
                <button type="button" class="bubble-react-btn" data-msg-react="<%= m.id %>" title="রিয়েক্ট করুন"><i class="far fa-smile"></i></button>
                <div class="bubble-react-menu" hidden><% ['👍','❤️','🤗','😂','😮','😢','😡'].forEach(e => { %><button type="button" data-emoji="<%= e %>"><%= e %></button><% }); %></div>
              </div>
              <div class="bubble-meta">
                <span class="bubble-time"><%= new Date(m.created_at).toLocaleString('bn-BD', { hour: '2-digit', minute: '2-digit' }) %></span>
                <% if (m.sender_id === user.id) { %>
                  <span class="bubble-seen" data-msg-id="<%= m.id %>">
                    <% if (_lastOwnRead && _lastOwnRead.id === m.id) { %>
                      <img src="<%= other.avatar_url || ('/avatar/' + other.id) %>" alt="পড়া হয়েছে" title="পড়া হয়েছে" />
                    <% } else if (m.is_read) { %>
                      <i class="fas fa-check-double" title="পড়া হয়েছে"></i>
                    <% } else { %>
                      <i class="fas fa-check" title="পৌঁছেছে"></i>
                    <% } %>
                  </span>
                <% } %>
              </div>
            </div>
          <% }); %>

          <%# ── টাইপিং-ইন্ডিকেটর (FB ৩-ডট) ── %>
          <div class="typing-indicator" id="typingIndicator">
            <img class="ti-av" src="<%= isGroup ? '/avatar/0' : (other.avatar_url || ('/avatar/' + other.id)) %>" alt="" />
            <div class="ti-bubble">
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
              <span class="typing-dot"></span>
              <span class="ti-label">লিখছেন…</span>
            </div>
          </div>
        </div>

        <%# ── সেশন ৭৮: কুইক-রিপ্লাই চিপস (বাংলা দ্রুত-উত্তর) ── %>
        <div class="qr-chips" id="qrChips" role="toolbar" aria-label="দ্রুত উত্তর">
          <% ['স্যালাম', 'জি বলুন', 'কেমন আছেন?', 'ঠিক আছে 👍', 'ধন্যবাদ 🙏', 'শীঘ্রই জানাচ্ছি', 'আপনার লেখা পড়েছি ✍️', 'শুভকামনা 🎉'].forEach(t => { %>
            <button type="button" class="qr-chip" data-qr="<%= t %>"><%= t %></button>
          <% }); %>
        </div>

        <%# ── সেশন ৭৮: ফাইল-প্রিভিউ — ইনপুটের উপরে, শুধু ফাইল থাকলেই দৃশ্যমান (থাম্বনেইল+সাইজ+টাইপ-আইকন) ── %>
        <div class="file-preview" id="filePreview" hidden>
          <i class="fas fa-paperclip" id="filePreviewIcon"></i>
          <img id="filePreviewThumb" class="fp-thumb" alt="" hidden />
          <div class="fp-meta">
            <div class="fp-name" id="filePreviewName"></div>
            <div class="fp-size" id="filePreviewSize"></div>
          </div>
          <button type="button" id="filePreviewRemove" aria-label="সরান" title="সরান">&times;</button>
        </div>

        <form method="POST" class="chat-input-bar" enctype="multipart/form-data" id="chatForm">
          <%# সেশন ৭৬: রিপ্লাই/এডিট বার (ইনপুট-বারের উপরে FB-স্টাইল) %>
          <div class="reply-bar" id="replyBar" hidden>
            <span class="rb-ic"><i class="fas fa-reply"></i></span>
            <div class="rb-body"><span class="rb-name" id="replyBarName"></span><span class="rb-text" id="replyBarText"></span></div>
            <button type="button" class="rb-x" id="replyBarCancel" aria-label="উত্তর বাতিল"><i class="fas fa-times"></i></button>
          </div>
          <div class="reply-bar edit-bar" id="editBar" hidden>
            <span class="rb-ic"><i class="fas fa-pen"></i></span>
            <div class="rb-body"><span class="rb-name">মেসেজ সম্পাদনা</span><span class="rb-text" id="editBarText"></span></div>
            <button type="button" class="rb-x" id="editBarCancel" aria-label="সম্পাদনা বাতিল"><i class="fas fa-times"></i></button>
          </div>
          <input type="hidden" name="reply_to" id="replyToInput" value="" />
          <label for="fileInput" class="ci-icon" title="ছবি বা ফাইল যুক্ত করুন"><i class="fas fa-plus"></i></label>
          <input type="file" id="fileInput" name="attachment" style="display:none" />
          <div class="chat-input-wrap">
            <%# সেশন ৮০: input → auto-grow textarea — Shift+Enter এখন আসলেই নতুন লাইন (FB-আচরণ), পেস্ট-টার্গেট %>
            <textarea name="body" id="msgInput" rows="1" placeholder="Aa" autocomplete="off"></textarea>
            <button type="button" class="emoji-trigger" id="emojiBtn" title="ইমোজি"><i class="far fa-smile"></i></button>
            <div class="emoji-picker" id="emojiPicker">
              <% ['😀','😃','😄','😁','😆','😂','🤣','😊','😇','🙂','😉','😍','🥰','😘','😋','😜','🤔','😎','👍','👎','👏','🙏','💪','❤️','🔥','✨','🎉','📝','📚','✍️'].forEach(em => { %>
                <button type="button" class="emoji-pick" onclick="insertEmoji('<%= em %>')"><%= em %></button>
              <% }); %>
            </div>
          </div>
          <button type="submit" class="btn btn-primary is-like" id="sendBtn" title="পাঠান"><span style="font-size:20px;line-height:1">👍</span></button>
        </form>

        <%# ── সেশন ৭৮: স্ক্রল-টু-বটম FAB (নতুন-মেসেজ ব্যাজসহ) ── %>
        <button type="button" class="jump-btn" id="jumpBtn" aria-label="সবচেয়ে নিচে যান" title="সবচেয়ে নিচে যান">
          <i class="fas fa-chevron-down"></i>
          <span class="jump-badge"></span>
        </button>

        <%# ── সেশন ৮০: ড্র্যাগ-অ্যান্ড-ড্রপ ওভারলে (ফাইল টেনে এনে ছাড়লে পুরো চ্যাটে নীল ড্যাশড জোন) ── %>
        <div class="drop-overlay" id="dropOverlay" aria-hidden="true">
          <div class="drop-inner">
            <i class="fas fa-cloud-arrow-up" aria-hidden="true"></i>
            <span>ছবি বা ফাইল এখানে ছেড়ে দিন</span>
          </div>
        </div>
      </section>

      <%# ── ডান: ডিটেইলস-প্যানেল (≥১০২৪px) ─────────────────────────────── %>
      <aside class="messenger-details" id="fbDetails">
        <div class="md-close"><button type="button" id="fbDetailsClose" title="বন্ধ করুন"><i class="fas fa-times"></i></button></div>
        <div class="md-profile">
          <div class="mdp-avwrap">
            <% if (isGroup) { %>
              <div class="mdp-av" style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#1877F2,#7c3aed);color:#fff;display:flex;align-items:center;justify-content:center;font-size:26px"><i class="fas fa-users"></i></div>
            <% } else { %>
              <img class="mdp-av" src="<%= other.avatar_url || ('/avatar/' + other.id) %>" onerror="this.src='/avatar/<%= other.id %>'" alt="<%= other.full_name %>" />
              <span class="mdp-dot" id="mdpDot" style="display:none"></span>
            <% } %>
          </div>
          <div class="mdp-name"><%= other.full_name %></div>
          <div class="mdp-sub"><% if (isGroup) { %><%= members.length %> সদস্য · গ্রুপ কথোপকথন<% } else { %>@<%= other.username %><% } %></div>
          <% if (!isGroup) { %>
            <a href="/profile/<%= other.username %>" class="mdp-btn mdp-btn--blue"><i class="fas fa-user"></i> প্রোফাইল দেখুন</a>
          <% } else { %>
            <button type="button" class="mdp-btn" onclick="var p=document.getElementById('grpPanel');p.style.display=(p.style.display==='none'||!p.style.display)?'block':'none';p.scrollIntoView({behavior:'smooth',block:'center'})"><i class="fas fa-users-cog"></i> সদস্য ব্যবস্থাপনা</button>
          <% } %>
        </div>
        <div class="md-section">
          <h4><i class="fas fa-palette"></i> চ্যাট থিম</h4>
          <div class="md-themes" id="mdThemes">
            <button type="button" class="md-theme" data-theme="default" title="ডিফল্ট"><span class="mdt-dot" style="background:#0084FF"></span>ডিফল্ট</button>
            <button type="button" class="md-theme" data-theme="mint" title="মিন্ট"><span class="mdt-dot" style="background:linear-gradient(135deg,#059669,#14b8a6)"></span>মিন্ট</button>
            <button type="button" class="md-theme" data-theme="rose" title="গোলাপি"><span class="mdt-dot" style="background:linear-gradient(135deg,#e11d48,#fb7185)"></span>গোলাপি</button>
            <button type="button" class="md-theme" data-theme="sunset" title="সূর্যাস্ত"><span class="mdt-dot" style="background:linear-gradient(135deg,#f59e0b,#ef4444)"></span>সূর্যাস্ত</button>
            <button type="button" class="md-theme" data-theme="violet" title="বেগুনি"><span class="mdt-dot" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)"></span>বেগুনি</button>
            <button type="button" class="md-theme" data-theme="forest" title="অরণ্য"><span class="mdt-dot" style="background:linear-gradient(135deg,#15803d,#22c55e)"></span>অরণ্য</button>
          </div>
          <div class="md-theme-note" id="mdThemeNote">নিজের ডিভাইসে প্রযোজ্য</div>
        </div>
        <%# ── সেশন ৮০: মেসেজ-সাউন্ড টগল (Web Audio — কোনো ফাইল লোড নেই) ── %>
        <div class="md-section">
          <h4><i class="fas fa-volume-high"></i> মেসেজ সাউন্ড</h4>
          <label class="md-switch-row" for="soundToggle">
            <span class="md-switch-label">পাঠানো/গ্রহণের শব্দ</span>
            <span class="md-switch">
              <input type="checkbox" id="soundToggle" role="switch" aria-label="মেসেজ সাউন্ড চালু বা বন্ধ" />
              <span class="md-switch-slider" aria-hidden="true"></span>
            </span>
          </label>
          <div class="md-theme-note">শুধু এই ডিভাইসে প্রযোজ্য</div>
        </div>
        <div class="md-section">
          <h4><i class="fas fa-images"></i> শেয়ার করা ছবি</h4>
          <% if (_sharedImgs.length) { %>
            <div class="md-media">
              <% _sharedImgs.forEach(im => { %>
                <a href="<%= im.file_url %>" target="_blank" rel="noopener"><img loading="lazy" src="<%= im.file_url %>" alt="<%= im.file_name || 'ছবি' %>" /></a>
              <% }); %>
            </div>
          <% } else { %>
            <div class="md-media-empty">এই কথোপকথনে এখনো কোনো ছবি শেয়ার করা হয়নি।</div>
          <% } %>
        </div>
        <% if (isGroup) { %>
        <div class="md-section">
          <h4><i class="fas fa-user-group"></i> সদস্যবৃন্দ</h4>
          <div class="md-members">
            <% members.slice(0, 14).forEach(mm => { %>
              <span class="md-member"><img src="<%= mm.avatar_url || ('/avatar/' + mm.id) %>" style="width:20px;height:20px;border-radius:50%;object-fit:cover" alt="" /><%= mm.full_name %></span>
            <% }); %>
            <% if (members.length > 14) { %><span class="md-member">+<%= members.length - 14 %></span><% } %>
          </div>
        </div>
        <% } %>
        <div class="md-section">
          <h4><i class="fas fa-sliders"></i> কথোপকথন সেটিংস</h4>
          <%# সেশন ৭৬: মিউট/পিন টগল (প্রতি-সদস্য সেটিং, AJAX) %>
          <button type="button" class="md-link" id="muteToggle" data-muted="<%= (typeof myFlags !== 'undefined' && myFlags.muted) ? 1 : 0 %>">
            <i class="fas <%= (typeof myFlags !== 'undefined' && myFlags.muted) ? 'fa-bell-slash' : 'fa-bell' %>"></i> <span class="mt-label"><%= (typeof myFlags !== 'undefined' && myFlags.muted) ? 'আনমিউট করুন' : 'মিউট করুন' %></span>
          </button>
          <button type="button" class="md-link" id="pinToggle" data-pinned="<%= (typeof myFlags !== 'undefined' && myFlags.pinned) ? 1 : 0 %>">
            <i class="fas fa-thumbtack"></i> <span class="pn-label"><%= (typeof myFlags !== 'undefined' && myFlags.pinned) ? 'আনপিন করুন' : 'পিন করুন' %></span>
          </button>
        </div>
        <div class="md-section">
          <h4><i class="fas fa-shield-halved"></i> গোপনীয়তা ও সহায়তা</h4>
          <% if (!isGroup) { %>
            <button type="button" class="md-link md-link--danger" onclick="deleteConversation('<%= other.username %>')"><i class="fas fa-trash"></i> কথোপকথন মুছে ফেলুন</button>
          <% } else { %>
            <form method="POST" action="/messages/g/<%= conv.id %>/leave" style="margin:0">
              <button type="submit" class="md-link md-link--danger"><i class="fas fa-sign-out-alt"></i> গ্রুপ ছাড়ুন</button>
            </form>
          <% } %>
          <a href="/contact" class="md-link"><i class="fas fa-circle-question"></i> সহায়তা কেন্দ্র</a>
        </div>
      </aside>
    </div>
  </div>

  <%# ── সেশন ৭৬ (ক্রস-এজেন্ট মার্জ): সাইডবার-সারির ৩-ডট কনটেক্সট-মেনু (মিউট/আর্কাইভ) + ফরওয়ার্ড-মোডাল — দুটোই সংরক্ষিত ── %>
  <%# ── সেশন ৭৬: সাইডবার-সারির ৩-ডট কনটেক্সট-মেনু (মিউট/আর্কাইভ) ── %>
  <div class="conv-menu" id="convMenu" hidden role="menu" aria-label="কথোপকথন অপশন">
    <button type="button" role="menuitem" data-act="mute"><i class="fas fa-bell-slash"></i> <span>মিউট করুন</span></button>
    <button type="button" role="menuitem" data-act="unmute"><i class="fas fa-bell"></i> <span>আনমিউট করুন</span></button>
    <button type="button" role="menuitem" data-act="archive"><i class="fas fa-box-archive"></i> <span>আর্কাইভ করুন</span></button>
    <button type="button" role="menuitem" data-act="unarchive"><i class="fas fa-box-open"></i> <span>আর্কাইভ থেকে সরান</span></button>
  </div>

  <%# ── সেশন ৭৬: ফরওয়ার্ড-মোডাল (FB-স্টাইল — কথোপকথন বেছে কপি পাঠাও) ── %>
  <%# ── সেশন ৭৬: ফরওয়ার্ড-মোডাল (FB-স্টাইল — কথোপকথন বেছে কপি পাঠাও) ── %>
  <div class="fwd-overlay" id="fwdOverlay" hidden>
    <div class="fwd-modal" role="dialog" aria-modal="true" aria-label="মেসেজ ফরওয়ার্ড করুন">
      <div class="fwd-head">
        <h3><i class="fas fa-share"></i> মেসেজ ফরওয়ার্ড করুন</h3>
        <button type="button" id="fwdClose" class="fwd-x" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button>
      </div>
      <div class="fwd-search"><i class="fas fa-search"></i><input type="search" id="fwdSearch" placeholder="কথোপকথন খুঁজুন..." autocomplete="off" /></div>
      <div class="fwd-list" id="fwdList"></div>
      <div class="fwd-foot">
        <button type="button" class="fwd-cancel" id="fwdCancel">বাতিল</button>
      </div>
    </div>
    </div>
  </div>
  </div>

  <script>
    // ── হেল্পার ─────────────────────────────────────────────────────────
    const body = document.getElementById('chatBody');
    const convId = <%= conv ? conv.id : 0 %>;
    const myId = <%= user.id %>;
    const otherId = <%= other.id %>;
    const otherUsername = <%- JSON.stringify(other.username) %>;
    const otherAvatar = <%- JSON.stringify(other.avatar_url || ('/avatar/' + other.id)) %>;
    const sendUrl = <%- JSON.stringify(isGroup ? '/messages/g/' + conv.id : '/messages/' + other.username) %>;
    const isGroupChat = <%= isGroup ? 'true' : 'false' %>;
    let lastMsgId = <%= messages.length ? messages[messages.length - 1].id : 0 %>;
    let seenUpto = <%= _lastOwnRead ? _lastOwnRead.id : 0 %>;
    let typingTimeout = null;

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function highlight(text, q) {
      if (!q) return escapeHtml(text);
      const qLower = q.toLowerCase();
      const idx = text.toLowerCase().indexOf(qLower);
      if (idx === -1) return escapeHtml(text);
      return escapeHtml(text.substring(0, idx)) + '<mark>' + escapeHtml(text.substring(idx, idx + q.length)) + '</mark>' + escapeHtml(text.substring(idx + q.length));
    }

    // স্ক্রল নিচে + FB-টোস্ট
    if (body) body.scrollTop = body.scrollHeight;
    function fbToast(msg) {
      let t = document.querySelector('.fb-toast');
      if (!t) { t = document.createElement('div'); t.className = 'fb-toast'; document.body.appendChild(t); }
      t.textContent = msg;
      requestAnimationFrame(() => t.classList.add('show'));
      clearTimeout(t._hide);
      t._hide = setTimeout(() => t.classList.remove('show'), 2400);
    }

    // ── ডিটেইলস-প্যানেল টগল ────────────────────────────────────────────
    const fbShell = document.getElementById('messengerShell');
    const fbDetails = document.getElementById('fbDetails');
    const fbInfoBtn = document.getElementById('fbInfoBtn');
    if (fbInfoBtn && fbDetails && fbShell) {
      fbInfoBtn.addEventListener('click', () => {
        fbDetails.hidden = !fbDetails.hidden;
        fbShell.classList.toggle('has-details', !fbDetails.hidden);
      });
      const fbClose = document.getElementById('fbDetailsClose');
      if (fbClose) fbClose.addEventListener('click', () => {
        fbDetails.hidden = true;
        fbShell.classList.remove('has-details');
      });
      // <1024px-এ প্যানেল দেখানো বন্ধ — CSS-ও জোর করে লুকায়
      if (window.innerWidth < 1024) { fbDetails.hidden = true; fbShell.classList.remove('has-details'); }
    }

    // মোবাইল: ব্যাক-বাটন → লিস্ট দেখাও
    document.getElementById('fbBackBtn')?.addEventListener('click', () => {
      document.getElementById('messengerList').classList.remove('hidden');
      document.getElementById('messengerChat').classList.add('hidden');
    });

    // ── সেশন ৭৬: সাইডবার-সারির মিউট/আর্কাইভ (localStorage-পেসিস্টেন্ট) ──
    const convPrefs = (() => { try { return JSON.parse(localStorage.getItem('lfConvPrefs') || '{}'); } catch (e) { return {}; } })();
    function savePrefs() { try { localStorage.setItem('lfConvPrefs', JSON.stringify(convPrefs)); } catch (e) {} }
    function prefOf(id) {
      const k = String(id);
      if (!convPrefs[k]) convPrefs[k] = { muted: false, archived: false };
      return convPrefs[k];
    }
    function applySidePrefs() {
      document.querySelectorAll('.messenger-list .conv-item').forEach(el => {
        const p = prefOf(el.dataset.id);
        el.classList.toggle('is-muted', !!p.muted);
        el.classList.toggle('is-archived', !!p.archived);
        const tag = el.querySelector('.conv-mute-tag');
        if (tag) tag.hidden = !p.muted;
        el.style.display = p.archived ? 'none' : '';
      });
    }
    const convMenu = document.getElementById('convMenu');
    let menuTarget = null;
    function openConvMenu(btn) {
      if (!convMenu) return;
      menuTarget = btn.closest('.conv-item');
      if (!menuTarget) return;
      const p = prefOf(menuTarget.dataset.id);
      convMenu.querySelector('[data-act="mute"]').style.display = p.muted ? 'none' : 'flex';
      convMenu.querySelector('[data-act="unmute"]').style.display = p.muted ? 'flex' : 'none';
      convMenu.querySelector('[data-act="archive"]').style.display = p.archived ? 'none' : 'flex';
      convMenu.querySelector('[data-act="unarchive"]').style.display = p.archived ? 'flex' : 'none';
      const r = btn.getBoundingClientRect();
      convMenu.hidden = false;
      const mw = convMenu.offsetWidth || 200;
      convMenu.style.left = Math.max(8, Math.min(r.left, window.innerWidth - mw - 8)) + 'px';
      convMenu.style.top = Math.min(r.bottom + 6, window.innerHeight - convMenu.offsetHeight - 8) + 'px';
    }
    function closeConvMenu() { if (convMenu) convMenu.hidden = true; menuTarget = null; }
    document.addEventListener('click', e => {
      const btn = e.target.closest('[data-conv-menu]');
      if (btn) {
        e.preventDefault(); e.stopPropagation();
        if (!convMenu.hidden && menuTarget && menuTarget.dataset.id === btn.dataset.convMenu) { closeConvMenu(); return; }
        openConvMenu(btn);
        return;
      }
      if (!e.target.closest('#convMenu')) closeConvMenu();
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeConvMenu();
      const btn = e.target.closest && e.target.closest('[data-conv-menu]');
      if (btn && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); e.stopPropagation(); openConvMenu(btn); }
    });
    if (convMenu) convMenu.addEventListener('click', e => {
      const act = e.target.closest('[data-act]');
      if (!act || !menuTarget) return;
      const p = prefOf(menuTarget.dataset.id);
      if (act.dataset.act === 'mute') p.muted = true;
      if (act.dataset.act === 'unmute') p.muted = false;
      if (act.dataset.act === 'archive') p.archived = true;
      if (act.dataset.act === 'unarchive') p.archived = false;
      savePrefs();
      applySidePrefs();
      closeConvMenu();
    });
    applySidePrefs();

    // ── সেশন ৭৬: চ্যাট-থিম (নিজের বাবল + সেন্ড-বাটন + থিম-স্ট্রিপ) ──
    const CHAT_THEMES = {
      default: { name: 'ডিফল্ট',   bubble: '#0084FF', grad: 'linear-gradient(90deg,#1877F2,#0084FF)' },
      mint:    { name: 'মিন্ট',     bubble: '#0d9488', grad: 'linear-gradient(90deg,#059669,#14b8a6)' },
      rose:    { name: 'গোলাপি',    bubble: '#e11d48', grad: 'linear-gradient(90deg,#e11d48,#fb7185)' },
      sunset:  { name: 'সূর্যাস্ত', bubble: '#ea580c', grad: 'linear-gradient(90deg,#f59e0b,#ef4444)' },
      violet:  { name: 'বেগুনি',    bubble: '#7c3aed', grad: 'linear-gradient(90deg,#7c3aed,#a78bfa)' },
      forest:  { name: 'অরণ্য',     bubble: '#16a34a', grad: 'linear-gradient(90deg,#15803d,#22c55e)' }
    };
    const themeStoreKey = 'lfChatTheme:' + (isGroupChat ? 'g' + convId : 'u:' + otherUsername);
    function applyChatTheme(key) {
      const t = CHAT_THEMES[key] || CHAT_THEMES.default;
      const shell = document.getElementById('messengerShell');
      if (shell) {
        shell.style.setProperty('--fb-msg', t.bubble);
        shell.style.setProperty('--lf-theme-grad', t.grad);
      }
      document.querySelectorAll('#mdThemes .md-theme').forEach(b => b.classList.toggle('active', b.dataset.theme === key));
      const note = document.getElementById('mdThemeNote');
      if (note) note.textContent = 'বর্তমান থিম: ' + t.name + ' — শুধু আপনার ডিভাইসে';
    }
    const mdThemes = document.getElementById('mdThemes');
    if (mdThemes) mdThemes.addEventListener('click', e => {
      const b = e.target.closest('.md-theme');
      if (!b) return;
      try { localStorage.setItem(themeStoreKey, b.dataset.theme); } catch (err) {}
      applyChatTheme(b.dataset.theme);
      fbToast('চ্যাট-থিম পরিবর্তন হয়েছে');
    });
    let savedTheme = 'default';
    try { savedTheme = localStorage.getItem(themeStoreKey) || 'default'; } catch (e) {}
    applyChatTheme(savedTheme);

    // ── সাইডবার-সার্চ (কথোপকথন + নতুন ইউজার) ───────────────────────────
    const convSearch = document.getElementById('convSearch');
    const convSearchClear = document.getElementById('convSearchClear');
    const convSearchResults = document.getElementById('convSearchResults');
    const csrConversations = document.getElementById('csrConversations');
    const csrUsers = document.getElementById('csrUsers');
    const csrEmpty = document.getElementById('csrEmpty');
    const csrConvList = document.getElementById('csrConvList');
    const csrUserList = document.getElementById('csrUserList');
    const csrConvCount = document.getElementById('csrConvCount');
    const csrUserCount = document.getElementById('csrUserCount');
    let searchTimerC = null, lastQueryC = '', kbIndexC = -1, kbRowsC = [];

    function filterConvs(q) {
      q = (q || '').toLowerCase().trim();
      document.querySelectorAll('.messenger-list .conv-item').forEach(el => {
        el.style.display = !q || el.dataset.name.indexOf(q) !== -1 ? 'flex' : 'none';
      });
    }

    function renderConvSearchResults(q) {
      const qLower = (q || '').toLowerCase().trim();
      const items = [...document.querySelectorAll('.messenger-list .conv-item')];
      const matched = qLower ? items.filter(el => el.dataset.name.indexOf(qLower) !== -1) : items;

      if (!matched.length) { csrConversations.hidden = true; return; }
      csrConvCount.textContent = matched.length;
      csrConvList.innerHTML = matched.map(el => {
        const origName = el.querySelector('.conv-name').textContent;
        const origSnippet = el.querySelector('.conv-snippet').textContent;
        const avatar = el.querySelector('img') ? el.querySelector('img').outerHTML : '';
        const unread = el.querySelector('.conv-unread');
        const unreadHtml = unread ? `<span class="conv-unread">${unread.textContent}</span>` : '';
        return `<a class="msr-row" href="${el.getAttribute('href')}">
          ${avatar.replace('class="', 'class="msr-avatar ')}
          <div class="msr-meta"><div class="msr-name">${highlight(origName, q)}</div><div class="msr-sub">${highlight(origSnippet, q)}</div></div>
          <div class="msr-right">${unreadHtml}</div>
        </a>`;
      }).join('');
      csrConversations.hidden = false;
    }

    async function renderUserSearchResults(q) {
      if (!q || q.length < 1) { csrUsers.hidden = true; return; }
      try {
        const r = await fetch('/api/users/search?q=' + encodeURIComponent(q));
        const data = await r.json();
        const users = data.users || [];
        if (!users.length) { csrUsers.hidden = true; return; }
        csrUserCount.textContent = users.length;
        csrUserList.innerHTML = users.map(u => {
          const avatar = u.avatar_url
            ? `<img loading="lazy" decoding="async" class="msr-avatar" src="${escapeHtml(u.avatar_url)}" onerror="this.onerror=null;this.outerHTML='<div class=\'msr-avatar\'>${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>'" />`
            : `<div class="msr-avatar">${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>`;
          const sub = [u.designation, '@' + u.username].filter(Boolean).join(' • ');
          return `<a class="msr-row" href="/messages/${encodeURIComponent(u.username)}">
            ${avatar}
            <div class="msr-meta"><div class="msr-name">${highlight(u.full_name || u.username, q)}</div><div class="msr-sub">${highlight(sub, q)}</div></div>
            <div class="msr-right"><i class="fas fa-chevron-right"></i></div>
          </a>`;
        }).join('');
        csrUsers.hidden = false;
      } catch {}
    }

    async function doConvSearch(q) {
      q = (q || '').trim();
      if (q === lastQueryC) return;
      lastQueryC = q;
      kbIndexC = -1;
      if (!q) {
        convSearchResults.hidden = true;
        convSearchClear.hidden = true;
        filterConvs('');
        return;
      }
      convSearchClear.hidden = false;
      filterConvs(q);
      renderConvSearchResults(q);
      await renderUserSearchResults(q);
      const hasC = !csrConversations.hidden, hasU = !csrUsers.hidden;
      csrEmpty.hidden = hasC || hasU;
      convSearchResults.hidden = false;
      kbRowsC = [...convSearchResults.querySelectorAll('.msr-row')];
    }

    convSearch.addEventListener('input', () => {
      if (searchTimerC) clearTimeout(searchTimerC);
      searchTimerC = setTimeout(() => doConvSearch(convSearch.value), 180);
    });
    convSearch.addEventListener('focus', () => {
      if (convSearch.value.trim()) convSearchResults.hidden = false;
    });
    convSearchClear.addEventListener('click', () => {
      convSearch.value = '';
      convSearch.dispatchEvent(new Event('input'));
      convSearch.focus();
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('.messenger-list-head')) convSearchResults.hidden = true;
    });
    convSearch.addEventListener('keydown', (e) => {
      if (convSearchResults.hidden || !kbRowsC.length) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); kbIndexC = Math.min(kbIndexC + 1, kbRowsC.length - 1); updateKbActiveC(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); kbIndexC = Math.max(kbIndexC - 1, 0); updateKbActiveC(); }
      else if (e.key === 'Enter') { e.preventDefault(); if (kbIndexC >= 0 && kbRowsC[kbIndexC]) kbRowsC[kbIndexC].click(); else if (kbRowsC.length === 1) kbRowsC[0].click(); }
      else if (e.key === 'Escape') { convSearch.value = ''; convSearch.dispatchEvent(new Event('input')); convSearch.blur(); }
    });
    function updateKbActiveC() {
      kbRowsC.forEach((r, i) => r.classList.toggle('kb-active', i === kbIndexC));
      if (kbIndexC >= 0 && kbRowsC[kbIndexC]) kbRowsC[kbIndexC].scrollIntoView({ block: 'nearest' });
    }

    // ── ইমোজি-পিকার ────────────────────────────────────────────────────
    function insertEmoji(em) {
      const input = document.getElementById('msgInput');
      input.value += em;
      input.focus();
      updateSendBtn();
      document.getElementById('emojiPicker').classList.remove('open');
    }

    // ── সেশন ৭৮: কুইক-রিপ্লাই চিপ ──────────────────────────────────────
    // চিপ-ক্লিক → ইনপুটে টেক্সট বসে + ফোকাস (সেন্ড ইউজারের হাতে — accidental
    // সেন্ড-রোধ); ইনপুট খালি হলে রিপ্লেস, লেখা থাকলে জোড়া+স্পেস।
    function quickReply(btn) {
      const t = btn.getAttribute('data-qr') || '';
      const cur = msgInput.value || '';
      msgInput.value = cur.trim() ? (cur.replace(/\s+$/, '') + ' ' + t) : t;
      updateSendBtn();
      msgInput.focus();
      btn.classList.add('qr-pop');
      setTimeout(() => btn.classList.remove('qr-pop'), 350);
    }
    document.getElementById('qrChips').addEventListener('click', e => {
      const chip = e.target.closest('.qr-chip');
      if (chip) quickReply(chip);
    });

    document.getElementById('emojiBtn').addEventListener('click', () => {
      document.getElementById('emojiPicker').classList.toggle('open');
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('.chat-input-wrap') && !e.target.closest('#emojiBtn')) {
        document.getElementById('emojiPicker').classList.remove('open');
      }
    });

    // ── FB ডাইনামিক অ্যাকশন-বাটন: খালি ইনপুটে 👍, টাইপ শুরুতে সেন্ড-প্লেন ──
    const chatForm = document.getElementById('chatForm');
    const sendBtn = document.getElementById('sendBtn');
    const msgInput = document.getElementById('msgInput');
    const fileInputEl = document.getElementById('fileInput');
    const filePreviewEl = document.getElementById('filePreview');

    function updateSendBtn() {
      const has = (msgInput.value || '').trim().length > 0;
      sendBtn.classList.toggle('is-like', !has);
      sendBtn.title = has ? 'পাঠান' : 'লাইক পাঠান';
      sendBtn.innerHTML = has ? '<i class="fas fa-location-arrow"></i>' : '<span style="font-size:20px;line-height:1">👍</span>';
    }

    // ── সেশন ৭৮: প্রতি-কথোপকথন ড্রাফট-সেভ (FB-আচরণ — অন্য চ্যাটে গিয়ে ফিরলেও লেখা বাঁচে) ──
    const draftKey = 'lfDraft:' + (isGroupChat ? 'g' + convId : 'u:' + otherUsername);
    function saveDraft() { try { localStorage.setItem(draftKey, msgInput.value); } catch (e) {} }
    function clearDraft() { try { localStorage.removeItem(draftKey); } catch (e) {} }
    try { const _draft = localStorage.getItem(draftKey); if (_draft) msgInput.value = _draft; } catch (e) {}
    if (msgInput.value) { autogrowInput(); updateSendBtn(); } /* সেশন ৮০: রিস্টোর-করা মাল্টি-লাইন ড্রাফটেও উচ্চতা ঠিক */

    msgInput.addEventListener('input', () => {
      updateSendBtn();
      autogrowInput();
      if (msgInput.value.trim()) saveDraft(); else clearDraft();
    });
    updateSendBtn();

    // ── সেশন ৮০: অটো-গ্রো টেক্সটএরিয়া (FB-কম্পোজার — লেখা বাড়লে ইনপুট লম্বা হয়, Shift+Enter নতুন লাইন) ──
    function autogrowInput() {
      msgInput.style.height = 'auto';
      msgInput.style.height = Math.min(msgInput.scrollHeight, 120) + 'px';
      msgInput.style.overflowY = msgInput.scrollHeight > 120 ? 'auto' : 'hidden';
    }
    function resetInputHeight() {
      msgInput.style.height = '';
      msgInput.style.overflowY = 'hidden';
    }

    // ── সেশন ৮০: মেসেঞ্জার সাউন্ড এফেক্ট (Web Audio API — কোনো অডিও-ফাইল লোড হয় না) ──
    // সেন্ড = হালকা পপ (D5→A5), রিসিভ = নরম ডিং (E5→B4); localStorage lfMsgSound-এ পেসিস্টেন্ট।
    const SoundFX = (() => {
      let ctx = null;
      let enabled = (() => { try { return localStorage.getItem('lfMsgSound') !== '0'; } catch (e) { return true; } })();
      function ac() {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        if (!ctx) ctx = new AC();
        if (ctx.state === 'suspended') { ctx.resume().catch(() => {}); }
        return ctx;
      }
      function blip(f1, f2, dur, vol, type) {
        if (!enabled) return;
        const c = ac(); if (!c) return;
        try {
          const o = c.createOscillator(), g = c.createGain();
          o.type = type || 'sine';
          o.frequency.setValueAtTime(f1, c.currentTime);
          o.frequency.exponentialRampToValueAtTime(f2, c.currentTime + dur);
          g.gain.setValueAtTime(vol, c.currentTime);
          g.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + dur);
          o.connect(g); g.connect(c.destination);
          o.start(); o.stop(c.currentTime + dur);
        } catch (e) {}
      }
      return {
        send() { blip(587.33, 880, 0.09, 0.12, 'sine'); },
        receive() { blip(659.25, 493.88, 0.16, 0.10, 'triangle'); },
        toggle(v) { enabled = !!v; try { localStorage.setItem('lfMsgSound', v ? '1' : '0'); } catch (e) {} },
        isOn() { return enabled; }
      };
    })();
    const soundToggle = document.getElementById('soundToggle');
    if (soundToggle) {
      soundToggle.checked = SoundFX.isOn();
      soundToggle.addEventListener('change', () => {
        SoundFX.toggle(soundToggle.checked);
        if (soundToggle.checked) SoundFX.send(); /* চালু-কনফার্মেশন পপ */
        fbToast(soundToggle.checked ? '🔔 মেসেজ সাউন্ড চালু' : '🔕 মেসেজ সাউন্ড বন্ধ');
      });
    }

    // ── সেশন ৮০: ক্লিপবোর্ড-পেস্ট (Ctrl+V — স্ক্রিনশট/ছবি/ফাইল সরাসরি অ্যাটাচমেন্টে) ──
    msgInput.addEventListener('paste', (e) => {
      const items = e.clipboardData && e.clipboardData.items;
      if (!items) return;
      const pasted = [];
      for (let i = 0; i < items.length; i++) {
        if (items[i].kind === 'file') {
          const f = items[i].getAsFile();
          if (f) pasted.push(f);
        }
      }
      if (!pasted.length) return;
      e.preventDefault();
      const dt = new DataTransfer();
      [...fileInputEl.files].forEach(f => dt.items.add(f));   /* আগে থেকে নির্বাচিত থাকলে ধরে রাখি */
      pasted.forEach(f => dt.items.add(f));
      fileInputEl.files = dt.files;
      fileInputEl.dispatchEvent(new Event('change'));
      fbToast('📎 ক্লিপবোর্ড থেকে ফাইল যোগ হয়েছে');
      msgInput.focus();
    });

    // ── সেশন ৮০: ফুল-উইন্ডো ড্র্যাগ-অ্যান্ড-ড্রপ জোন ──
    const dropOverlay = document.getElementById('dropOverlay');
    let dragDepth = 0;
    function hasFiles(e) { return e.dataTransfer && [...(e.dataTransfer.types || [])].indexOf('Files') !== -1; }
    window.addEventListener('dragenter', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      dragDepth++;
      if (dropOverlay) dropOverlay.classList.add('show');
    });
    window.addEventListener('dragover', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      if (dropOverlay) dropOverlay.classList.add('show');
    });
    window.addEventListener('dragleave', (e) => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0 && dropOverlay && (!e.relatedTarget || e.relatedTarget === document.documentElement)) dropOverlay.classList.remove('show');
    });
    window.addEventListener('drop', (e) => {
      dragDepth = 0;
      if (dropOverlay) dropOverlay.classList.remove('show');
      if (!hasFiles(e) || !e.dataTransfer.files.length) return;
      e.preventDefault();
      const dt = new DataTransfer();
      [...fileInputEl.files].forEach(f => dt.items.add(f));
      [...e.dataTransfer.files].forEach(f => dt.items.add(f));
      fileInputEl.files = dt.files;
      fileInputEl.dispatchEvent(new Event('change'));
      fbToast('📎 ফাইল যোগ হয়েছে — পাঠাতে সেন্ড চাপুন');
    });
    window.addEventListener('dragend', () => { dragDepth = 0; if (dropOverlay) dropOverlay.classList.remove('show'); });

    // ── সেশন ৭৮: স্ক্রল-টু-বটম FAB + নতুন-মেসেজ ব্যাজ + স্মার্ট-অটোস্ক্রল ──
    const jumpBtn = document.getElementById('jumpBtn');
    const jumpBadge = jumpBtn ? jumpBtn.querySelector('.jump-badge') : null;
    let newMsgCount = 0;
    function isNearBottom() { return body.scrollHeight - body.scrollTop - body.clientHeight < 160; }
    function updateJumpBtn() {
      if (!jumpBtn) return;
      jumpBtn.classList.toggle('show', body.scrollHeight - body.scrollTop - body.clientHeight > 320);
    }
    function clearJumpBadge() {
      newMsgCount = 0;
      if (jumpBadge) { jumpBadge.textContent = ''; jumpBadge.classList.remove('show'); }
    }
    body.addEventListener('scroll', () => { updateJumpBtn(); if (isNearBottom()) clearJumpBadge(); }, { passive: true });
    if (jumpBtn) jumpBtn.addEventListener('click', () => {
      body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
      clearJumpBadge();
    });
    updateJumpBtn();

    // ── সেশন ৭৮: ছবি-লাইটবক্স (চ্যাট-ছবি + শেয়ার্ড-মিডিয়া গ্রিড — নতুন ট্যাবের বদলে) ──
    let lbEl = null;
    function openLightbox(src, caption) {
      if (!lbEl) {
        lbEl = document.createElement('div');
        lbEl.className = 'lf-lightbox';
        lbEl.setAttribute('role', 'dialog');
        lbEl.setAttribute('aria-modal', 'true');
        lbEl.innerHTML = '<button type="button" class="lb-close" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button><img alt="" /><div class="lb-caption"></div>';
        lbEl.addEventListener('click', e => { if (e.target === lbEl || e.target.closest('.lb-close')) closeLightbox(); });
        document.body.appendChild(lbEl);
      }
      const img = lbEl.querySelector('img');
      img.src = src; img.alt = caption || 'ছবি';
      const cap = lbEl.querySelector('.lb-caption');
      cap.textContent = caption || '';
      cap.style.display = caption ? '' : 'none';
      lbEl.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() { if (lbEl) lbEl.classList.remove('open'); document.body.style.overflow = ''; }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
    body.addEventListener('click', e => {
      const img = e.target.closest('.bubble-image');
      if (img) { e.preventDefault(); openLightbox(img.currentSrc || img.src, img.alt); }
    });
    document.getElementById('fbDetails')?.addEventListener('click', e => {
      const img = e.target.closest('.md-media img');
      if (img) { e.preventDefault(); openLightbox(img.currentSrc || img.src, img.alt); }
    });

    // ── মেসেজ-রেন্ডারিং ─────────────────────────────────────────────────
    function appendMessage(msg, forceScrollFlag) {
      if (document.querySelector('.bubble[data-id="' + msg.id + '"]')) return;
      // নিজের মেসেজ: optimistic tmp-বাবল থাকলে সেটাকেই আসল id দিই
      if (msg.is_me) {
        const tmps = Array.prototype.slice.call(document.querySelectorAll('.bubble[data-id^="tmp-"]'));
        const match = tmps.reverse().find(b => ((b.querySelector('.bubble-text') || {}).textContent || '') === (msg.body || ''));
        if (match) { match.dataset.id = String(msg.id); return; }
      }
      const nearBottom = isNearBottom();
      const div = document.createElement('div');
      div.className = 'bubble ' + (msg.is_me ? 'me' : 'them') + ' first-of-cluster last-of-cluster';
      div.dataset.id = msg.id;
      div.dataset.own = msg.is_me ? '1' : '0';
      let html = '';
      if (!msg.is_me) {
        const av = isGroupChat ? (msg.sender_avatar || ('/avatar/' + msg.sender_id)) : otherAvatar;
        html += '<img class="b-av" loading="lazy" src="' + escapeHtml(av) + '" onerror="this.src=\'/avatar/' + (msg.sender_id || 0) + '\'" alt="" />';
      }
      html += '<div class="b-content">';
      if (msg.is_me) html += '<button type="button" class="bubble-delete" data-msg-delete="' + msg.id + '" title="আনসেন্ড (মুছে ফেলুন)"><i class="fas fa-times"></i></button>';
      html += '<button type="button" class="bubble-more" data-msg-more="' + msg.id + '" title="আরও অপশন"><i class="fas fa-ellipsis"></i></button>';
      if (!msg.is_me && isGroupChat) {
        html += '<div class="bubble-sender">' + escapeHtml(msg.sender_name || 'সদস্য') + '</div>';
      }
      // সেশন ৭৬: রিপ্লাই-কোট + এডিটেড-লেবেল (নতুন-আসা মেসেজেও)
      if (msg.reply_to_id && (msg.reply_body || msg.reply_file_name)) {
        html += '<div class="bubble-quote" data-quote-id="' + msg.reply_to_id + '"><span class="bq-name">' + escapeHtml(msg.reply_sender_name || 'মেসেজ') + '</span><span class="bq-text">' + escapeHtml(String(msg.reply_body || ('📎 ' + (msg.reply_file_name || 'ফাইল'))).slice(0, 120)) + '</span></div>';
      }
      if (msg.body) html += '<div class="bubble-text"></div>';
      if (msg.file_url) {
        if (/\.(jpe?g|png|gif|webp|svg|bmp)$/i.test(msg.file_url)) html += '<a href="' + msg.file_url + '" target="_blank" rel="noopener"><img loading="lazy" decoding="async" src="' + msg.file_url + '" alt="" class="bubble-image" /></a>';
        else html += '<a href="' + msg.file_url + '" class="bubble-file" download><i class="fas fa-paperclip"></i> ' + escapeHtml(msg.file_name || 'ফাইল') + '</a>';
      }
      html += '<button type="button" class="bubble-react-btn" data-msg-react="' + msg.id + '" title="রিয়েক্ট করুন"><i class="far fa-smile"></i></button>';
      html += '<div class="bubble-react-menu" hidden>' + ['👍','❤️','🤗','😂','😮','😢','😡'].map(e => '<button type="button" data-emoji="' + e + '">' + e + '</button>').join('') + '</div>';
      html += '</div>';
      html += '<div class="bubble-meta"><span class="bubble-time"></span>';
      if (msg.is_me) html += '<span class="bubble-seen"><i class="fas fa-check" title="পৌঁছেছে"></i></span>';
      html += '</div>';
      div.innerHTML = html;
      if (msg.body) div.querySelector('.bubble-text').textContent = msg.body;
      if (msg.edited) { const bt = div.querySelector('.bubble-text'); if (bt) bt.insertAdjacentHTML('afterend', '<span class="bubble-edited">সম্পাদিত</span>'); }
      div.querySelector('.bubble-time').textContent = new Date(msg.created_at).toLocaleString('bn-BD', { hour: '2-digit', minute: '2-digit' });
      const ti = document.getElementById('typingIndicator');
      body.insertBefore(div, ti);
      // স্মার্ট-স্ক্রল (সেশন ৭৮): পুরোনো মেসেজ পড়তে উপরে থাকলে অবস্থান ঠিক থাকে,
      // FAB-ব্যাজে নতুন-গণনা দেখায়; নিজের মেসেজ বা নিচের-কাছে হলে অটো-স্ক্রল
      if (forceScrollFlag === true || nearBottom || msg.is_me) {
        body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
        clearJumpBadge();
      } else {
        newMsgCount++;
        if (jumpBadge) { jumpBadge.textContent = newMsgCount > 9 ? '৯+' : String(newMsgCount); jumpBadge.classList.add('show'); }
      }
    }

    // সিন-রসিট: শেষ-পঠিত নিজের বাবলে অপর পক্ষের মাইক্রো-অ্যাভাটার (FB-স্টাইল)
    function updateSeenAvatar() {
      document.querySelectorAll('.bubble.me .bubble-seen').forEach(s => {
        if (!s.querySelector('img')) return;
        s.innerHTML = '<i class="fas fa-check-double" title="পড়া হয়েছে"></i>';
      });
      let last = null;
      document.querySelectorAll('.bubble.me').forEach(b => {
        const id = parseInt(b.dataset.id);
        if (!isNaN(id) && id > 0 && id <= seenUpto) last = b;
      });
      if (last) {
        const s = last.querySelector('.bubble-seen');
        if (s) s.innerHTML = '<img src="' + escapeHtml(otherAvatar) + '" alt="পড়া হয়েছে" title="পড়া হয়েছে">';
      }
    }
    function markSeen(id) {
      const b = document.querySelector('.bubble[data-id="' + id + '"] .bubble-seen');
      if (b) b.innerHTML = '<i class="fas fa-check-double" title="পড়া হয়েছে"></i>';
    }

    // ── টাইপিং-সিগন্যাল ────────────────────────────────────────────────
    msgInput.addEventListener('input', () => {
      if (!convId || isGroupChat) return;
      if (typingTimeout) clearTimeout(typingTimeout);
      fetch('/api/messages/typing', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conv_id: convId }) });
      typingTimeout = setTimeout(() => {}, 6000);
    });

    function markConvSeen() {
      if (!convId) return;
      fetch('/api/messages/seen-all', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conv_id: convId }) });
    }

    // ── পোলিং (সেশন ৭৬: অ্যাডাপটিভ — ফোকাসড উইন্ডোতে ২.৫সে, লুকানো হলে ১০সে) ──
    async function poll() {
      if (!convId) return;
      try {
        const res = await fetch('/api/messages/poll?conv_id=' + convId + '&since=' + lastMsgId);
        const data = await res.json();

        if (data.messages && data.messages.length) {
          /* সেশন ৭৮: ব্যাচ-অ্যারাইভালে প্রথম মেসেজের আগের অবস্থান মানি — নইলে
             smooth-scroll-রেসে মাঝের মেসেজগুলো ভুলভাবে 'স্ক্রল-আপ' ধরে FAB-ব্যাজ বাড়ায় */
          const wasNearBottom78 = isNearBottom();
          let gotOthers = false; /* সেশন ৮০: রিসিভ-ডিং ব্যাচে একবারই */
          data.messages.forEach(m => { lastMsgId = Math.max(lastMsgId, m.id); appendMessage(m, wasNearBottom78); if (!m.is_me) gotOthers = true; });
          if (gotOthers) SoundFX.receive();
          markConvSeen();
          if (window.lfMsgSearchRefresh) try { window.lfMsgSearchRefresh(); } catch (_) {} /* সেশন ৮৯: নতুন বাবলেও সার্চ-হাইলাইট সিঙ্ক */
        }

        // সেশন ৭৬: লাইভ-এডিট প্রোপাগেশন — পুরনো বাবলের নতুন এডিট ক্লায়েন্টে বসাও
        if (data.edits && data.edits.length) {
          data.edits.forEach(ed => {
            const b = body.querySelector('.bubble[data-id="' + ed.id + '"]');
            if (!b) return;
            const t = b.querySelector('.bubble-text');
            if (t && ed.body) t.textContent = ed.body;
            if (!b.querySelector('.bubble-edited')) {
              const bt = b.querySelector('.bubble-text');
              if (bt) bt.insertAdjacentHTML('afterend', '<span class="bubble-edited">সম্পাদিত</span>');
            }
          });
        }

        if (typeof data.seen_upto === 'number' && data.seen_upto > seenUpto) {
          seenUpto = data.seen_upto;
          updateSeenAvatar();
        }

        const ti = document.getElementById('typingIndicator');
        if (ti) ti.classList.toggle('show', !!data.typing);

        if (!isGroupChat) {
          const dot = document.getElementById('otherOnlineDot');
          const mdpDot = document.getElementById('mdpDot');
          const statusText = document.getElementById('otherStatusText');
          if (dot) dot.style.display = data.online ? 'block' : 'none';
          if (mdpDot) mdpDot.style.display = data.online ? 'block' : 'none';
          if (statusText) {
            statusText.textContent = data.online ? 'এখনই অনলাইন' : '@' + otherUsername;
            statusText.className = data.online ? 'st-online' : '';
          }
        }

        // সাইডবার অনলাইন-ডট
        const userIds = [...document.querySelectorAll('.messenger-list .online-dot')].map(d => d.dataset.userId).filter(Boolean);
        await Promise.all([...new Set(userIds)].map(async uid => {
          try {
            const r = await fetch('/api/messages/online?user_id=' + uid);
            const d = await r.json();
            document.querySelectorAll('.messenger-list .online-dot[data-user-id="' + uid + '"]').forEach(dot => {
              dot.style.display = d.online ? 'block' : 'none';
            });
          } catch {}
        }));
      } catch (e) { /* silent */ }
    }
    let pollTimer = null;
    function isTabActive() { return document.visibilityState === 'visible' && document.hasFocus(); }
    function schedulePoll() {
      clearTimeout(pollTimer);
      pollTimer = setTimeout(async () => { await poll(); schedulePoll(); }, isTabActive() ? 2500 : 10000);
    }
    function kickPollNow() {
      clearTimeout(pollTimer);
      pollTimer = setTimeout(async () => { await poll(); schedulePoll(); }, 400);
    }
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') kickPollNow(); else schedulePoll(); });
    window.addEventListener('focus', kickPollNow);
    window.addEventListener('blur', schedulePoll);
    schedulePoll();
    setTimeout(poll, 800);

    // ── কথোপকথনের ভেতরে মেসেজ-সার্চ (সেশন ৮২ বেসিক-ফিল্টার → সেশন ৮৯ C2-আপগ্রেড:
    //    <mark> হাইলাইট + ম্যাচ-কাউন্টার + Enter/Shift+Enter ↑↓ নেভিগেশন + Esc-ক্লিয়ার) ──
    (function () {
      const cis = document.getElementById('convInSearch');
      if (!cis) return;
      const tools = document.getElementById('cisTools');
      const counter = document.getElementById('cisCounter');
      const clearBtn = document.getElementById('cisClear');
      const BN89 = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      const bn89 = (n) => String(n).replace(/[0-9]/g, (d) => BN89[d]);
      let matches = [], idx = -1, query = '';

      function unwrapAll(root) {
        root.querySelectorAll('mark.msg-hl').forEach((m) => {
          const p = m.parentNode;
          p.replaceChild(document.createTextNode(m.textContent), m);
          p.normalize();
        });
      }
      function highlight(root, q) {
        const rx = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode: function (n) {
            if (!n.nodeValue || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
            const p = n.parentElement;
            if (!p || p.closest('mark, .bubble-edited, button, .bubble-time, .bubble-reacts')) return NodeFilter.FILTER_REJECT;
            rx.lastIndex = 0;
            return rx.test(n.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
          }
        });
        const hits = [];
        while (walker.nextNode()) hits.push(walker.currentNode);
        hits.forEach((node) => {
          const frag = document.createDocumentFragment();
          let last = 0; const text = node.nodeValue;
          rx.lastIndex = 0; let m;
          while ((m = rx.exec(text))) {
            if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
            const mark = document.createElement('mark');
            mark.className = 'msg-hl';
            mark.textContent = m[0];
            frag.appendChild(mark);
            last = m.index + m[0].length;
          }
          if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
          node.parentNode.replaceChild(frag, node);
        });
      }
      function scrollToMatch(i) {
        if (!matches.length) return;
        idx = ((i % matches.length) + matches.length) % matches.length;
        matches.forEach((el, j) => el.classList.toggle('msg-hl-active', j === idx));
        const el = matches[idx];
        if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
        if (counter) counter.textContent = bn89(idx + 1) + '/' + bn89(matches.length);
      }
      function apply() {
        matches.forEach((el) => el.classList.remove('msg-hl-active'));
        unwrapAll(body);
        matches = []; idx = -1; query = cis.value.trim();
        const bubbles = body.querySelectorAll('.bubble');
        if (!query) {
          bubbles.forEach((b) => { b.style.display = ''; });
          if (tools) tools.hidden = true;
          if (clearBtn) clearBtn.hidden = true;
          return;
        }
        highlight(body, query);
        matches = Array.from(body.querySelectorAll('mark.msg-hl'));
        const okBubbles = new Set(matches.map((m) => m.closest('.bubble')));
        bubbles.forEach((b) => { b.style.display = okBubbles.has(b) ? '' : 'none'; });
        if (clearBtn) clearBtn.hidden = false;
        if (tools) tools.hidden = !matches.length;
        if (matches.length) scrollToMatch(0);
        else if (counter) counter.textContent = '০/০';
      }
      let t89 = null;
      cis.addEventListener('input', function () { clearTimeout(t89); t89 = setTimeout(apply, 160); });
      cis.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); scrollToMatch(idx + (e.shiftKey ? -1 : 1)); }
        if (e.key === 'Escape') { cis.value = ''; apply(); cis.blur(); }
      });
      const nextBtn = document.getElementById('cisNext');
      const prevBtn = document.getElementById('cisPrev');
      if (nextBtn) nextBtn.addEventListener('click', function () { scrollToMatch(idx + 1); });
      if (prevBtn) prevBtn.addEventListener('click', function () { scrollToMatch(idx - 1); });
      if (clearBtn) clearBtn.addEventListener('click', function () { cis.value = ''; apply(); cis.focus(); });
      /* poll-নতুন বাবল এলে সার্চ-স্টেট রিফ্রেশ (poll() থেকে কল হয়) */
      window.lfMsgSearchRefresh = function () { if (query) apply(); };
    })();

    // ── রিয়েকশন (হোভার-ক্যাপসুল) ───────────────────────────────────────
    function renderReacts(bubble, counts) {
      let box = bubble.querySelector('.bubble-reacts');
      if (!counts || !counts.length) { if (box) box.remove(); return; }
      if (!box) { box = document.createElement('div'); box.className = 'bubble-reacts'; (bubble.querySelector('.b-content') || bubble).appendChild(box); }
      box.innerHTML = counts.map(c => '<span title="' + c.c + '">' + c.emoji + (c.c > 1 ? ' ' + c.c : '') + '</span>').join('');
    }
    body.addEventListener('click', async function (e) {
      const rb = e.target.closest('[data-msg-react]');
      if (rb) {
        const menu = rb.parentElement.querySelector('.bubble-react-menu');
        document.querySelectorAll('.bubble-react-menu:not([hidden])').forEach(m => { if (m !== menu) m.hidden = true; });
        if (menu) {
          menu.hidden = !menu.hidden;
          /* সেশন ৭৮: চ্যাটের একদম উপরের মেসেজে ক্যাপসুল ক্লিপ হলে নিচে-ফ্লিপ */
          if (!menu.hidden) {
            menu.classList.remove('flip-below');
            const mr = menu.getBoundingClientRect();
            const br = body.getBoundingClientRect();
            if (mr.top < br.top + 10) menu.classList.add('flip-below');
          }
        }
        return;
      }
      const em = e.target.closest('.bubble-react-menu [data-emoji]');
      if (em) {
        const bubble = em.closest('.bubble');
        em.closest('.bubble-react-menu').hidden = true;
        try {
          const r = await fetch('/api/messages/react', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message_id: bubble.dataset.id, emoji: em.dataset.emoji }) });
          const d = await r.json();
          if (d.ok) renderReacts(bubble, d.counts);
        } catch (_) {}
      }
    });

    // ── সেশন ৮০: ডাবল-ক্লিক / ডাবল-ট্যাপ = ❤️ রিয়েক্ট (FB-আচরণ; আবার ডাবল-ক্লিকে টগল-অফ) ──
    body.addEventListener('dblclick', async function (e) {
      const bubble = e.target.closest('.bubble');
      if (!bubble) return;
      if (e.target.closest('button, a, .bubble-react-menu, .bubble-quote')) return; /* কন্ট্রোলে ডাবল-ক্লিক নয় */
      const msgId = bubble.dataset.id;
      if (!msgId || String(msgId).indexOf('tmp-') === 0) return;
      try {
        const r = await fetch('/api/messages/react', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message_id: msgId, emoji: '❤️' }) });
        const d = await r.json();
        if (d.ok) {
          renderReacts(bubble, d.counts);
          bubble.classList.remove('is-flash'); void bubble.offsetWidth; bubble.classList.add('is-flash');
        }
      } catch (_) {}
    });

    // ── ফর্ম: AJAX সেন্ড + optimistic ───────────────────────────────────
    let sending = false;
    chatForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (sending) return;
      let body_text = (msgInput.value || '').trim();
      const file = fileInputEl.files[0];
      // FB-আচরণ: খালি ইনপুটে বাটন = 👍 পাঠাও
      if (!body_text && !file) body_text = '👍';
      if (!body_text && !file) return;
      sending = true;
      sendBtn.disabled = true;
      sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      const fd = new FormData();
      fd.append('body', body_text);
      if (file) fd.append('attachment', file);

      if (body_text) {
        const optimistic = {
          id: 'tmp-' + Date.now(),
          body: body_text,
          file_url: file ? URL.createObjectURL(file) : null,
          file_name: file ? file.name : null,
          is_me: true,
          created_at: new Date().toISOString()
        };
        // সেশন ৭৬: রিপ্লাই করলে optimistic বাবলেই কোট দেখাও
        const curRep = (window.MSA && window.MSA.currentReply) ? window.MSA.currentReply() : null;
        if (curRep) { optimistic.reply_to_id = curRep.id; optimistic.reply_body = curRep.text; optimistic.reply_sender_name = curRep.name; }
        appendMessage(optimistic);
        SoundFX.send(); /* সেশন ৮০: সেন্ড-পপ (optimistic পাথেই — জিরো-ল্যাগ ফিডব্যাক) */
      }

      /* সেশন ৭৮-ফিক্স (ইউজার-অভিযোগ): সেন্ড চাপলেই ইনপুট সাথে সাথে খালি — আগে
         সার্ভার-উত্তরের অপেক্ষায় আগের টেক্স্ট চ্যাটবক্সে ঝুলে থাকত; ব্যর্থ হলে
         টেক্সট ইনপুটে ফিরে আসে যাতে হারিয়ে না যায়। */
      msgInput.value = '';
      fileInputEl.value = '';
      if (filePreviewEl) filePreviewEl.hidden = true;
      resetFilePreviewUI();
      resetInputHeight(); /* সেশন ৮০: টেক্সটএরিয়া উচ্চতা রিসেট */
      clearDraft();
      updateSendBtn();

      try {
        const csrfM42 = document.querySelector('meta[name="csrf-token"]');
        const res = await fetch(sendUrl, {
          method: 'POST', body: fd,
          headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrfM42 ? csrfM42.content : '' },
          redirect: 'manual'
        });
        let data = null;
        try { data = await res.json(); } catch (_) {}
        if (res.type === 'opaqueredirect' || res.status === 0 || res.ok) {
          if (data && data.id) {
            const tmp = Array.prototype.slice.call(document.querySelectorAll('.bubble[data-id^="tmp-"]')).pop();
            if (tmp) tmp.dataset.id = String(data.id);
          }
          if (window.MSA) window.MSA.afterSent();
          setTimeout(poll, 500);
        } else {
          const tmp = Array.prototype.slice.call(document.querySelectorAll('.bubble[data-id^="tmp-"]')).pop();
          if (tmp) tmp.remove();
          msgInput.value = body_text; /* ব্যর্থ মেসেজ ফিরিয়ে দিই */
          autogrowInput(); /* সেশন ৮০ */
          saveDraft();
          fbToast((data && data.error) || 'মেসেজ পাঠানো যায়নি — আবার চেষ্টা করুন');
        }
      } catch (err) {
        const tmp = Array.prototype.slice.call(document.querySelectorAll('.bubble[data-id^="tmp-"]')).pop();
        if (tmp) tmp.remove();
        msgInput.value = body_text;
        autogrowInput(); /* সেশন ৮০ */
        saveDraft();
        fbToast('নেটওয়ার্ক সমস্যা — আবার চেষ্টা করুন');
      } finally {
        sending = false;
        sendBtn.disabled = false;
        updateSendBtn();
        msgInput.focus();
      }
    });

    // Enter = সেন্ড, Shift+Enter = নতুন লাইন
    msgInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        chatForm.requestSubmit();
      }
    });

    // মোবাইল: চ্যাট খোলা থাকলে লিস্ট লুকাও
    if (window.innerWidth <= 768 && convId) {
      document.getElementById('messengerList').classList.add('hidden');
    }

    // ── ফাইল-প্রিভিউ (সেশন ৭৮: থাম্বনেইল + সাইজ + টাইপ-আইকন) ──
    const fileInput = document.getElementById('fileInput');
    const filePreview = document.getElementById('filePreview');
    const fpThumb = document.getElementById('filePreviewThumb');
    const fpIcon = document.getElementById('filePreviewIcon');
    let fpThumbUrl = null;

    function humanSize(n) {
      if (!n && n !== 0) return '';
      if (n < 1024) return n + ' বাইট';
      if (n < 1048576) return (n / 1024).toFixed(1) + ' কিলোবাইট';
      if (n < 1073741824) return (n / 1048576).toFixed(1) + ' মেগাবাইট';
      return (n / 1073741824).toFixed(1) + ' গিগাবাইট';
    }
    function resetFilePreviewUI() {
      if (fpThumbUrl) { URL.revokeObjectURL(fpThumbUrl); fpThumbUrl = null; }
      if (fpThumb) { fpThumb.removeAttribute('src'); fpThumb.hidden = true; }
      if (fpIcon) { fpIcon.className = 'fas fa-paperclip'; fpIcon.hidden = false; }
    }
    fileInput?.addEventListener('change', () => {
      const f = fileInput.files && fileInput.files[0];
      if (!f) { filePreview.hidden = true; resetFilePreviewUI(); return; }
      document.getElementById('filePreviewName').textContent = f.name;
      document.getElementById('filePreviewSize').textContent = humanSize(f.size);
      const ext = (f.name.split('.').pop() || '').toLowerCase();
      if (fpIcon) {
        if (/^(jpe?g|png|gif|webp|bmp|svg|avif)$/.test(ext) || /^image\//.test(f.type)) fpIcon.className = 'fas fa-file-image';
        else if (ext === 'pdf') fpIcon.className = 'fas fa-file-pdf';
        else if (/^(zip|rar|7z|gz|tar)$/.test(ext)) fpIcon.className = 'fas fa-file-zipper';
        else if (/^(mp3|wav|ogg|m4a|aac)$/.test(ext) || /^audio\//.test(f.type)) fpIcon.className = 'fas fa-file-audio';
        else if (/^(mp4|mkv|mov|avi|webm)$/.test(ext) || /^video\//.test(f.type)) fpIcon.className = 'fas fa-file-video';
        else if (/^(docx?|txt|rtf|odt|md)$/.test(ext)) fpIcon.className = 'fas fa-file-lines';
        else if (/^(xlsx?|csv)$/.test(ext)) fpIcon.className = 'fas fa-file-excel';
        else fpIcon.className = 'fas fa-paperclip';
      }
      if (fpThumb) {
        if (/^image\//.test(f.type)) {
          if (fpThumbUrl) URL.revokeObjectURL(fpThumbUrl);
          fpThumbUrl = URL.createObjectURL(f);
          fpThumb.src = fpThumbUrl;
          fpThumb.hidden = false;
          if (fpIcon) fpIcon.hidden = true; /* থাম্বনেইল থাকলে আইকন লুকাই */
        } else {
          fpThumb.hidden = true;
          if (fpIcon) fpIcon.hidden = false;
        }
      }
      filePreview.hidden = false;
    });
    document.getElementById('filePreviewRemove')?.addEventListener('click', () => {
      fileInput.value = '';
      filePreview.hidden = true;
      resetFilePreviewUI();
    });

    // ── নিজের একক মেসেজ মুছুন (সেশন ৭৬: ইউনিভার্সাল এন্ডপয়েন্ট — গ্রুপেও কাজ করে) ──
    body?.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-msg-delete]');
      if (!btn) return;
      const msgId = btn.dataset.msgDelete;
      try {
        const res = await fetch('/api/messages/' + msgId + '/delete', {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await res.json();
        if (data.ok) {
          const bubble = body.querySelector('.bubble[data-id="' + msgId + '"]');
          bubble?.remove();
        }
      } catch (_) {}
    });
  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/messenger-actions.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <script>
    // পুরো কথোপকথন মুছুন (AJAX)
    async function deleteConversation(username) {
      if (!confirm('নিশ্চিত? পুরো কথোপকথনটি মুছে যাবে।')) return;
      try {
        const res = await fetch('/messages/' + encodeURIComponent(username) + '/delete', {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (res.ok) {
          window.location.href = '/messages';
        } else {
          alert('মুছতে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
        }
      } catch (e) {
        alert('নেটওয়ার্ক সমস্যা।');
      }
    }
  </script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
