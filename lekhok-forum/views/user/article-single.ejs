<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: (post.title) + ' — লেখক ফোরাম', extra_css: ['/assets/css/article.css'] }) %>

  <div class="article-wrap">
    <article class="article-main card">
      <% if (post.cover_image) { %>
        <img src="<%= post.cover_image %>" alt="cover" class="article-cover">
      <% } %>
      <div class="article-header">
        <div class="article-tags">
          <% (post.tags || '').split(',').filter(t => t.trim()).forEach(tag => { %>
            <a href="/articles?tag=<%= encodeURIComponent(tag.trim()) %>" class="tag-chip">#<%= tag.trim() %></a>
          <% }); %>
        </div>
        <h1 class="article-title"><%= post.title %></h1>
        <div class="article-author-bar">
          <img src="<%= author.avatar_url || '/avatar/' + author.id %>" class="author-avatar">
          <div>
            <a href="/profile/<%= author.username %>" class="author-name"><%= author.full_name %></a>
            <div class="article-date"><i class="far fa-calendar"></i> <%= new Date(post.published_at).toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' }) %> &middot; <i class="far fa-eye"></i> <%= post.view_count || 0 %> পঠিত</div>
          </div>
        </div>
      </div>
      <div class="article-body">
        <%- post.body.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/_(.*?)_/g, '<em>$1</em>').replace(/@([a-zA-Z0-9_]+)/g, '<a class="mention" href="/profile/$1">@$1</a>').replace(/#([\u0980-\u09FFa-zA-Z0-9_]+)/g, '<a class="tag" href="/articles?tag=$1">#$1</a>') %>
      </div>
      <% try { const mentions = JSON.parse(post.mentions || '[]'); if (mentions.length) { %>
        <div class="mentions-row">
          <span class="mentions-label"><i class="fas fa-at"></i> ম্যানশন:</span>
          <% mentions.forEach(m => { %>
            <a href="/profile/<%= m.username %>" class="mention-chip">@<%= m.username %></a>
          <% }); %>
        </div>
      <% } } catch(e) {} %>

      <div class="article-footer">
        <%- include('../partials/actions-bar', {
          targetId: post.id,
          targetType: 'post',
          counts: reaction.counts,
          mine: reaction.mine,
          link: '/articles/' + post.id,
          bookmarked: userBookmarked
        }) %>
        <% if (user && user.id === post.author_id) { %>
          <div class="owner-actions">
            <a href="/articles/<%= post.id %>/edit" class="btn btn-ghost btn-sm"><i class="fas fa-pen"></i> সম্পাদনা</a>
            <form method="POST" action="/articles/<%= post.id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('মুছে ফেলতে চান?')">
              <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> মুছুন</button>
            </form>
          </div>
        <% } %>
      </div>

      <div class="comments-section">
        <h3><i class="far fa-comment"></i> মন্তব্য (<%= comments.reduce((a, c) => a + 1 + (c.replies || []).length, 0) %>)</h3>
        <% if (user) { %>
          <form method="POST" class="comment-form" id="commentForm">
            <img src="<%= user.avatar_url || '/avatar/' + user.id %>" class="comment-avatar">
            <div class="comment-input-wrap">
              <textarea name="body" placeholder="আপনার মন্তব্য লিখুন... (@ব্যবহারকারী নাম লিখে ম্যানশন করুন)" rows="3" required></textarea>
              <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane"></i> পাঠান</button>
            </div>
          </form>
        <% } else { %>
          <p class="login-to-comment"><a href="/login?next=/articles/<%= post.id %>">লগইন</a> করে সবার আগে মন্তব্য করুন</p>
        <% } %>

        <div class="comments-list">
          <% if (comments.length === 0 && user) { %>
            <div class="empty-state comments-empty"><i class="far fa-comment-dots"></i><p>প্রথম মন্তব্যকারী হোন</p></div>
          <% } %>
          <% comments.forEach(c => { %>
            <div class="comment-item" id="c<%= c.id %>">
              <img src="<%= c.avatar_url || '/avatar/' + c.author_id %>" class="comment-avatar">
              <div class="comment-bubble">
                <a href="/profile/<%= c.username %>" class="comment-author"><%= c.full_name %></a>
                <p class="comment-body"><%= c.body %></p>
                <div class="comment-meta">
                  <span><i class="far fa-clock"></i> <%= new Date(c.created_at).toLocaleDateString('bn-BD') %></span>
                  <span class="comment-react-mini"><%= (c.reaction && c.reaction.total) ? c.reaction.total + ' প্রতিক্রিয়া' : '' %></span>
                  <% if (user) { %><button class="reply-btn" data-id="<%= c.id %>" data-name="<%= c.username %>"><i class="far fa-comment"></i> উত্তর</button><% } %>
                </div>
                <div class="comment-reactions">
                  <% if (user) { %>
                    <%- include('../partials/actions-bar', {
                      targetId: c.id, targetType: 'comment',
                      counts: c.reaction.counts, mine: c.reaction.mine,
                      link: '/articles/' + post.id, showBookmark: false
                    }) %>
                  <% } %>
                </div>
                <% c.replies && c.replies.forEach(r => { %>
                  <div class="reply-item" id="c<%= r.id %>">
                    <img src="<%= r.avatar_url || '/avatar/' + r.author_id %>" class="comment-avatar small">
                    <div class="comment-bubble small">
                      <a href="/profile/<%= r.username %>" class="comment-author"><%= r.full_name %></a>
                      <p class="comment-body"><%= r.body %></p>
                      <div class="comment-meta">
                        <span><i class="far fa-clock"></i> <%= new Date(r.created_at).toLocaleDateString('bn-BD') %></span>
                      </div>
                    </div>
                  </div>
                <% }); %>
                <% if (user) { %>
                  <form class="reply-form" data-parent="<%= c.id %>" hidden>
                    <img src="<%= user.avatar_url || '/avatar/' + user.id %>" class="comment-avatar small">
                    <div class="comment-input-wrap">
                      <textarea name="body" rows="2" placeholder="<%= c.full_name %>-কে উত্তর দিন..." required></textarea>
                      <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane"></i></button>
                    </div>
                  </form>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </article>
  </div>

  <%- include('../partials/share-modal') %>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script>
    // Reply toggle
    document.querySelectorAll('.reply-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.comment-item');
        const form = item.querySelector('.reply-form');
        if (form) { form.hidden = !form.hidden; if (!form.hidden) form.querySelector('textarea').focus(); }
      });
    });
    // Reply submit (API)
    document.querySelectorAll('.reply-form').forEach(form => {
      form.addEventListener('submit', async e => {
        e.preventDefault();
        const body = form.querySelector('textarea').value.trim();
        if (!body) return;
        const res = await fetch('/api/comment', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ post_id: '<%= post.id %>', body, parent_id: form.dataset.parent })
        });
        if (res.ok) location.reload();
      });
    });
    // Top-level comment (API + optimistic reload)
    document.getElementById('commentForm')?.addEventListener('submit', async e => {
      e.preventDefault();
      const body = e.target.body.value;
      const res = await fetch('/api/comment', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ post_id: '<%= post.id %>', body })
      });
      if (res.ok) location.reload();
    });
  </script>
</body>
</html>
