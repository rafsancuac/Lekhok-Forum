<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', {
  title: (post.title) + ' | লেখক ফোরাম',
  extra_css: ['/assets/css/article.css'],
  metaDesc: (typeof metaDesc !== 'undefined') ? metaDesc : undefined,
  ogImage: (typeof ogImage !== 'undefined') ? ogImage : undefined,
  ogType: 'article',
  publishedTime: (typeof publishedTime !== 'undefined') ? publishedTime : undefined,
  authorName: (typeof authorName !== 'undefined') ? authorName : undefined
}) %>

<%# ── schema.org Article — Google rich results / better indexing ── %>
<script type="application/ld+json">
<%- jesc({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: String(post.title || '').slice(0, 110),
  description: (typeof metaDesc !== 'undefined' && metaDesc) ? metaDesc : undefined,
  image: (typeof ogImage !== 'undefined' && ogImage) ? [ogImage] : undefined,
  author: { '@type': 'Person', name: displayName(author), url: (typeof siteUrl !== 'undefined' && author.username) ? siteUrl + '/profile/' + author.username : undefined },
  datePublished: (typeof publishedTime !== 'undefined') ? publishedTime : undefined,
  publisher: { '@type': 'Organization', name: 'লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়' },
  mainEntityOfPage: (typeof siteUrl !== 'undefined') ? siteUrl + '/articles/' + post.id : undefined
}).replace(/</g, '\\u003c') %>
</script>

  <div class="article-wrap">
    <%# ── সেশন ৬৩: পড়ার-অভিজ্ঞতা — আগের অবস্থান থেকে শুরুর ব্যানার (JS localStorage থেকে বানায়) ── %>
    <div class="read-resume" id="readResume" hidden></div>
    <article class="article-main card <%= postHidden81 ? 'is-hidden-81' : '' %>" data-post-id="<%= post.id %>" data-read-min="<%= readingMinutes %>" id="articleCard">
      <%# ── সেশন ৮১: লুকানো-পোস্ট ব্যানার (শুধু মালিক+মডারেটর এই পেজ দেখে) ── %>
      <% if (postHidden81) { %>
        <div class="hid81-banner">
          <div class="hid81-icon"><i class="fas fa-low-vision"></i></div>
          <div class="hid81-txt">
            <strong>এই লেখাটি সাময়িকভাবে লুকানো আছে</strong>
            <span>এখন শুধু আপনি<%= canMod81 && !isOwner81 ? ' (মডারেটর)' : '' %> এবং মডারেটররা দেখতে পারছেন — সাধারণ পাঠক ও ফিডে দেখা যাবে না।</span>
          </div>
          <form method="POST" action="/posts/<%= post.id %>/unhide">
            <button type="submit" class="hid81-unhide"><i class="fas fa-eye"></i> পুনঃপ্রকাশ</button>
          </form>
        </div>
      <% } %>
      <% if (hiddenToast81) { %><div class="hid81-toast" data-autoshow>🔒 লেখাটি লুকানো হয়েছে — এখন থেকে শুধু আপনি দেখতে পাবেন।</div><% } %>
      <% if (unhiddenToast81) { %><div class="hid81-toast ok" data-autoshow>✅ লেখাটি আবার সবার জন্য প্রকাশিত হয়েছে।</div><% } %>
      <% if (post.shared_from && post.shared_original) { %>
        <div class="shared-banner">
          <i class="fas fa-retweet"></i>
          <span><a href="/profile/<%= author.username %>"><%= displayName(author) %></a> শেয়ার করেছেন,
            <a href="/articles/<%= post.shared_original.id %>"><%= post.shared_original.orig_author %>-এর মূল পোস্ট</a></span>
        </div>
      <% } %>
      <% if (post.images && post.images.length) { %>
        <%- include('../partials/post-gallery', { images: post.images, alt: post.title, height: '320px', group: 'artsingle-' + post.id }) %>
      <% } %>
      <div class="article-header">
        <div class="article-tags">
          <% (post.tags || '').split(',').filter(t => t.trim()).forEach(tag => { %>
            <a href="/articles?tag=<%= encodeURIComponent(tag.trim()) %>" class="tag-chip">#<%= tag.trim() %></a>
          <% }); %>
        </div>
        <h1 class="article-title"><%= post.title %></h1>
        <div class="article-author-row92">
          <div class="article-author-bar">
            <img src="<%= author.avatar_url || '/avatar/' + author.id %>" class="author-avatar" alt="">
            <div>
              <a href="/profile/<%= author.username %>" class="author-name"><%= displayName(author) %></a><% if (hasPenName(author)) { %><span class="pen-chip" title="আসল নাম: <%= author.full_name %>">কলমে: <%= author.full_name %></span><% } %>
              <div class="article-date"><i class="far fa-calendar"></i> <%= new Date(post.published_at).toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' }) %> &middot; <i class="far fa-eye"></i> <%= post.view_count || 0 %> পঠিত &middot; <i class="far fa-clock"></i> <span title="<%= wordCountBn %> শব্দ">≈ <%= readingMinutesBn %> মিনিট পড়া</span></div>
            </div>
          </div>
          <%# ── সেশন ৯৩: গ্লোবাল ৩-ডট মেনু — সম্পাদনা/লুকান/মুছুন/রিপোর্ট সব এখানে ── %>
          <%- include('../partials/post-menu', {
            postId: post.id,
            isOwner: !!(user && isOwner81),
            canMod: !!canMod81,
            isHidden: !!postHidden81,
            myReport: !!myOpenReport81,
            reportLabel: 'লেখা: ' + String(post.title || '').slice(0, 60)
          }) %>
        </div>
      </div>
      <%# ── সেশন ৬৫: অটো-সূচিপত্র — ৩+ হেডিং (##/###) থাকলে; স্ক্রলস্পাই-সহ (article-reading.js) ── %>
      <% if (toc && toc.length >= 3) { %>
      <nav class="article-toc" id="articleToc" aria-label="সূচিপত্র">
        <button type="button" class="toc-head" id="tocToggle" aria-expanded="true" aria-controls="tocList">
          <span class="toc-head-title"><i class="fas fa-list-ul"></i> সূচিপত্র</span>
          <span class="toc-head-meta"><%= (toc.length + '').replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[+d]) %>টি অংশ <i class="fas fa-chevron-down toc-chev"></i></span>
        </button>
        <ol class="toc-list" id="tocList">
          <% toc.forEach(s => { %>
            <li class="toc-l<%= s.level %>"><a href="#<%= s.id %>" data-toc-for="<%= s.id %>"><%= s.text %></a></li>
          <% }) %>
        </ol>
      </nav>
      <% } %>
      <div class="article-body">
        <%- bodyHtml %>
      </div>
      <% try { const mentions = JSON.parse(post.mentions || '[]'); if (mentions.length) { %>
        <div class="mentions-row">
          <span class="mentions-label"><i class="fas fa-at"></i> ম্যানশন:</span>
          <% mentions.forEach(m => { %>
            <a href="/profile/<%= m.username %>" class="mention-chip">@<%= m.username %></a>
          <% }); %>
        </div>
      <% } } catch(e) {} %>

      <div class="article-footer">
        <%- include('../partials/actions-bar', {
          targetId: post.id,
          targetType: 'post',
          counts: reaction.counts,
          mine: reaction.mine,
          link: '/articles/' + post.id,
          commentCount: post.comment_count || 0,
          shareCount: post.share_count || 0,
          bookmarked: userBookmarked
        }) %>
        <%# সেশন ৯৩: ছড়ানো owner-actions/modrow81-বাটন অপসারিত — সব অপশন
            উপরের ৩-ডট মেনুতে (post-menu.ejs); ডাবল-ফুটার-স্পেস মুছে কম্প্যাক্ট %>
      </div>

      <div class="comments-section">
        <h3 class="comments-h"><i class="far fa-comment"></i> মন্তব্য (<%= comments.reduce((a, c) => a + 1 + (c.replies || []).length, 0) %>)</h3>
        <%# সেশন ৯৩: কম্প্যাক্ট FB-স্টাইল কম্পোজার — কার্যকর টুলবার + @ম্যানশন
            (পুরনো cf-hint ড্যাশড-চিপ + 'প্রথম মন্তব্যকারী হোন' বিশাল-কার্ড অপসারিত) %>
        <% if (user) { %>
          <%- include('../partials/comment-composer', { user, postId: post.id }) %>
        <% } else { %>
          <p class="login-to-comment"><a href="/login?next=/articles/<%= post.id %>">লগইন</a> করে সবার আগে মন্তব্য করুন</p>
        <% } %>

        <div class="comments-list">
          <%
            // ── সেশন ১০৭: FB-প্যারিটি কমেন্ট-আইটেম — হোভার রিঅ্যাকশন-প্যালেট (fcr) +
            // বাবল-কোণে রিঅ্যাকশন-ব্যাজ + হোভার ৩-ডট-মেনু (সম্পাদনা/মুছে-ফেলা/রিপোর্ট) +
            // ইনলাইন-এডিটর (data-raw প্রি-ফিল)। ইঞ্জিন comment-tools.js (session104/107) —
            // ডেলিগেটেড, data-cid/author-id/data-raw-চুক্তিতে চলে। session100-এর hold-ইঞ্জিন
            // (actions-bar) কমেন্ট-স্তর থেকে সরানো হলো — ফিডের সাথে একই UX।
            var _rm107 = REACTION_META;
            var _bn107 = function (n) { return String(n).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; }); };
            var _topEmoji107 = function (counts) {
              var best = null, bc = -1;
              Object.keys(counts || {}).forEach(function (k) {
                if ((counts[k] || 0) > bc && _rm107[k]) { best = k; bc = counts[k] || 0; }
              });
              return best ? _rm107[best].emoji : '👍';
            };
          %>
          <% comments.forEach(c => { %>
            <div class="comment-item" id="c<%= c.id %>" data-cid="<%= c.id %>" data-author-id="<%= c.author_id %>">
              <img loading="lazy" decoding="async" src="<%= c.avatar_url || '/avatar/' + c.author_id %>" class="comment-avatar">
              <div class="comment-bubble">
                <a href="/profile/<%= c.username %>" class="comment-author"><%= displayName(c, c.full_name) %></a><% if (hasPenName(c)) { %><span class="pen-chip" title="আসল নাম: <%= c.full_name %>">কলমে</span><% } %>
                <div class="comment-body" data-raw="<%= c.body %>"><%- c.bodyHtml %></div>
                <% if (c.edited_at) { %><span class="fc-edited">সম্পাদিত</span><% } %>
                <% if (c.reaction && c.reaction.total > 0) { %>
                  <div class="fc-react-badge" title="প্রতিক্রিয়া"><span class="fcrb-emoji"><%= _topEmoji107(c.reaction.counts) %></span><span class="fcrb-count"><%= _bn107(c.reaction.total) %></span></div>
                <% } %>
                <div class="comment-meta fb-meta107">
                  <% if (user) { %>
                    <span class="fc-react-wrap">
                      <button type="button" class="fc-react-btn<%= c.reaction && c.reaction.mine ? ' active' : '' %>" data-mine="<%= (c.reaction && c.reaction.mine) || '' %>"><%= (c.reaction && c.reaction.mine && _rm107[c.reaction.mine]) ? _rm107[c.reaction.mine].label : 'লাইক' %></button>
                      <div class="fcr-palette" role="menu" aria-label="প্রতিক্রিয়া নির্বাচন" hidden>
                        <% Object.keys(_rm107).forEach(function (k) { %>
                          <button type="button" class="fcr-opt<%= (c.reaction && c.reaction.mine === k) ? ' selected' : '' %>" data-reaction="<%= k %>" title="<%= _rm107[k].label %>" aria-label="<%= _rm107[k].label %>"><%= _rm107[k].emoji %></button>
                        <% }); %>
                      </div>
                    </span>
                    <button type="button" class="reply-btn" data-id="<%= c.id %>" data-name="<%= c.username %>">উত্তর দিন</button>
                  <% } %>
                  <span class="cm-time107"><i class="far fa-clock"></i> <%= new Date(c.created_at).toLocaleDateString('bn-BD') %></span>
                  <% if (user) { %>
                    <span class="fc-menu-wrap">
                      <button type="button" class="fc-menu-btn" aria-haspopup="menu" aria-expanded="false" aria-label="মন্তব্য অপশন" title="মন্তব্য অপশন"><i class="fas fa-ellipsis-h"></i></button>
                      <div class="fc-menu" role="menu" hidden>
                        <% if (user && c.author_id === user.id) { %>
                          <button type="button" class="fc-menu-item" data-cact="edit" role="menuitem"><i class="fas fa-pen"></i> সম্পাদনা করুন</button>
                          <button type="button" class="fc-menu-item fc-menu-danger" data-cact="delete" role="menuitem"><i class="fas fa-trash"></i> মুছে ফেলুন</button>
                        <% } else { %>
                          <button type="button" class="fc-menu-item fc-menu-danger" data-cact="report" role="menuitem"><i class="far fa-flag"></i> রিপোর্ট করুন</button>
                        <% } %>
                      </div>
                    </span>
                  <% } %>
                </div>
                <% if (user) { %><div class="fc-edit-slot" hidden></div><% } %>
                <% c.replies && c.replies.forEach(r => { %>
                  <div class="reply-item" id="c<%= r.id %>" data-cid="<%= r.id %>" data-author-id="<%= r.author_id %>">
                    <img loading="lazy" decoding="async" src="<%= r.avatar_url || '/avatar/' + r.author_id %>" class="comment-avatar small">
                    <div class="comment-bubble small">
                      <a href="/profile/<%= r.username %>" class="comment-author"><%= displayName(r, r.full_name) %></a><% if (hasPenName(r)) { %><span class="pen-chip" title="আসল নাম: <%= r.full_name %>">কলমে</span><% } %>
                      <div class="comment-body" data-raw="<%= r.body %>"><%- r.bodyHtml %></div>
                      <% if (r.edited_at) { %><span class="fc-edited">সম্পাদিত</span><% } %>
                      <% if (r.reaction && r.reaction.total > 0) { %>
                        <div class="fc-react-badge" title="প্রতিক্রিয়া"><span class="fcrb-emoji"><%= _topEmoji107(r.reaction.counts) %></span><span class="fcrb-count"><%= _bn107(r.reaction.total) %></span></div>
                      <% } %>
                      <div class="comment-meta fb-meta107">
                        <% if (user) { %>
                          <span class="fc-react-wrap">
                            <button type="button" class="fc-react-btn<%= r.reaction && r.reaction.mine ? ' active' : '' %>" data-mine="<%= (r.reaction && r.reaction.mine) || '' %>"><%= (r.reaction && r.reaction.mine && _rm107[r.reaction.mine]) ? _rm107[r.reaction.mine].label : 'লাইক' %></button>
                            <div class="fcr-palette" role="menu" aria-label="প্রতিক্রিয়া নির্বাচন" hidden>
                              <% Object.keys(_rm107).forEach(function (k) { %>
                                <button type="button" class="fcr-opt<%= (r.reaction && r.reaction.mine === k) ? ' selected' : '' %>" data-reaction="<%= k %>" title="<%= _rm107[k].label %>" aria-label="<%= _rm107[k].label %>"><%= _rm107[k].emoji %></button>
                              <% }); %>
                            </div>
                          </span>
                        <% } %>
                        <span class="cm-time107"><i class="far fa-clock"></i> <%= new Date(r.created_at).toLocaleDateString('bn-BD') %></span>
                        <% if (user) { %>
                          <span class="fc-menu-wrap">
                            <button type="button" class="fc-menu-btn" aria-haspopup="menu" aria-expanded="false" aria-label="মন্তব্য অপশন" title="মন্তব্য অপশন"><i class="fas fa-ellipsis-h"></i></button>
                            <div class="fc-menu" role="menu" hidden>
                              <% if (user && r.author_id === user.id) { %>
                                <button type="button" class="fc-menu-item" data-cact="edit" role="menuitem"><i class="fas fa-pen"></i> সম্পাদনা করুন</button>
                                <button type="button" class="fc-menu-item fc-menu-danger" data-cact="delete" role="menuitem"><i class="fas fa-trash"></i> মুছে ফেলুন</button>
                              <% } else { %>
                                <button type="button" class="fc-menu-item fc-menu-danger" data-cact="report" role="menuitem"><i class="far fa-flag"></i> রিপোর্ট করুন</button>
                              <% } %>
                            </div>
                          </span>
                        <% } %>
                      </div>
                      <% if (user) { %><div class="fc-edit-slot" hidden></div><% } %>
                    </div>
                  </div>
                <% }); %>
                <% if (user) { %>
                  <%# সেশন ৯৩/৯৪: রিপ্লাই-কম্পোজার (কম্প্যাক্ট) — টুলবার+ম্যানশনসহ; placeholder-এ কলমী-নাম প্রাধান্য (৯৪) %>
                  <div class="reply-form cc-slot" hidden>
                    <%- include('../partials/comment-composer', { user, postId: post.id, parentId: c.id, compact: true, placeholder: displayName(c, c.full_name) + '-কে উত্তর দিন…' }) %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </article>

    <%# ── সেশন ৬৭: "আরও পড়ুন" — ট্যাগ/ক্যাটাগরি/লেখক-ভিত্তিক সম্পর্কিত লেখা (route-স্কোর্ড) ── %>
    <% if (typeof related !== 'undefined' && related && related.length) { %>
    <section class="related-articles" aria-label="আরও পড়ুন">
      <h3 class="ra-title"><i class="fas fa-book-open"></i> আরও পড়ুন <span class="ra-count"><%= (related.length + '').replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[+d]) %>টি সম্পর্কিত লেখা</span></h3>
      <div class="ra-grid">
        <% related.forEach(r => { %>
          <a href="/articles/<%= r.id %>" class="ra-card">
            <% if (r.cover_image) { %>
              <img src="<%= r.cover_image %>" alt="<%= r.title %> — প্রচ্ছদ" loading="lazy" decoding="async" class="ra-img" onerror="this.outerHTML='<div class=&quot;ra-img ra-img-empty&quot; aria-hidden=&quot;true&quot;><i class=&quot;fas fa-feather-alt&quot;></i></div>'">
            <% } else { %>
              <div class="ra-img ra-img-empty" aria-hidden="true"><i class="fas fa-feather-alt"></i></div>
            <% } %>
            <div class="ra-body">
              <% if (r.first_tag) { %><span class="ra-tag">#<%= r.first_tag %></span><% } %>
              <h4 class="ra-h"><%= r.title %></h4>
              <% if (r.excerpt) { %><p class="ra-ex"><%= r.excerpt %>…</p><% } %>
              <div class="ra-meta">
                <span class="ra-author"><i class="far fa-user"></i> <%= r.author_name %></span>
                <span><i class="far fa-comment"></i> <%= (r.comment_count + '').replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[+d]) %></span>
                <span><i class="far fa-eye"></i> <%= (r.view_count + '').replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[+d]) %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>
  </div>

  <%- include('../partials/share-modal') %>
  <%# ── সেশন ৬৩: পড়ার-অভিজ্ঞতা টুলবার (ফন্ট-সাইজ + অগ্রগতি + অবশিষ্ট সময়) ── %>
  <div class="read-tools" id="readTools" role="group" aria-label="পড়ার সহায়ক টুলস">
    <div class="rt-time" id="rtTime" hidden></div>
    <button type="button" class="rt-btn" id="rtPlus" aria-label="লেখা বড় করুন" title="লেখা বড়">A+</button>
    <button type="button" class="rt-btn" id="rtMinus" aria-label="লেখা ছোট করুন" title="লেখা ছোট">A−</button>
    <div class="rt-track" aria-hidden="true"><span class="rt-fill" id="rtFill"></span></div>
    <div class="rt-pct" id="rtPct">০%</div>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <script src="/assets/js/post-gallery.js?v=<%= AV %>"></script>
  <script src="/assets/js/article-reading.js?v=<%= AV %>"></script>
  <%# সেশন ৯৩: কম্পোজার-টুলবার + ম্যানশন + ৩-ডট-মেনু ইঞ্জিন (সাবমিট-সহ) %>
  <script src="/assets/js/comment-tools.js?v=<%= AV %>"></script>
  <script>
    // Reply toggle (সেশন ৯৩: কম্পোজার-স্লট-টগল; সাবমিট comment-tools.js সামলায়)
    document.querySelectorAll('.reply-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.comment-item');
        const form = item.querySelector('.reply-form');
        if (form) {
          form.hidden = !form.hidden;
          if (!form.hidden) {
            const ta = form.querySelector('.cc-input');
            if (ta) setTimeout(() => ta.focus(), 60);
          }
        }
      });
    });
  </script>
  <%# ── সেশন ৮১: রিপোর্ট-মোডাল + কনফার্ম/অটো-টোস্ট স্ক্রিপ্ট ── %>
  <%- include('../partials/report-modal') %>
  <script>
    (function () {
      // লুকানো-কনফার্ম (data-confirm81 ফর্মগুলোতে)
      document.querySelectorAll('form[data-confirm81]').forEach(function (f) {
        f.addEventListener('submit', function (e) {
          if (!window.confirm(f.getAttribute('data-confirm81'))) { e.preventDefault(); }
        });
      });
      // অটো-টোস্ট (?hidden=1 / ?unhidden=1)
      var t = document.querySelector('.hid81-toast[data-autoshow]');
      if (t) {
        requestAnimationFrame(function () { t.classList.add('show'); });
        setTimeout(function () { t.classList.remove('show'); }, 4200);
      }
    })();
  </script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
