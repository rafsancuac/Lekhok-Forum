<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= post.title %> — লেখক ফোরাম</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="stylesheet" href="/assets/css/fonts.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
  <link rel="stylesheet" href="/assets/css/article.css" />
</head>
<body>
  <%- include('../partials/header') %>

  <div class="article-wrap">
    <article class="article-main">
      <% if (post.cover_image) { %>
        <img src="<%= post.cover_image %>" alt="cover" class="article-cover">
      <% } %>
      <div class="article-header">
        <div class="article-tags">
          <% (post.tags || '').split(',').filter(t => t.trim()).forEach(tag => { %>
            <a href="/articles?tag=<%= encodeURIComponent(tag.trim()) %>" class="tag-chip">#<%= tag.trim() %></a>
          <% }); %>
        </div>
        <h1 class="article-title"><%= post.title %></h1>
        <div class="article-author-bar">
          <img src="<%= author.avatar_url || '/avatar/' + author.id %>" class="author-avatar">
          <div>
            <a href="/profile/<%= author.username %>" class="author-name"><%= author.full_name %></a>
            <div class="article-date">
              <i class="far fa-calendar"></i> <%= new Date(post.published_at).toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              &middot; <i class="far fa-eye"></i> <%= post.view_count || 0 %> পঠিত
            </div>
          </div>
        </div>
      </div>
      <div class="article-body">
        <%- post.body.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/_(.*?)_/g, '<em>$1</em>').replace(/@([a-zA-Z0-9_]+)/g, '<a class="mention" href="/profile/$1">@$1</a>').replace(/#([\u0980-\u09FFa-zA-Z0-9_]+)/g, '<a class="tag" href="/articles?tag=$1">#$1</a>') %>
      </div>
      <% try { const mentions = JSON.parse(post.mentions || '[]'); if (mentions.length) { %>
        <div class="mentions-row">
          <span class="mentions-label"><i class="fas fa-at"></i> ম্যানশন:</span>
          <% mentions.forEach(m => { %>
            <a href="/profile/<%= m.username %>" class="mention-chip">@<%= m.username %></a>
          <% }); %>
        </div>
      <% } } catch(e) {} %>

      <%# ── Reaction Bar ──────────────────────────────────────────────── %>
      <div class="reaction-bar" data-id="<%= post.id %>" data-type="post">
        <div class="reaction-btn-wrap">
          <button class="reaction-btn active" id="mainReactionBtn" title="প্রতিক্রিয়া দিন">
            <% if (userReaction) { %>
              <% const emojiMap = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢' }; %>
              <%= emojiMap[userReaction] || '👍' %>
            <% } else { %>
              <i class="far fa-thumbs-up"></i>
            <% } %>
            <span id="reactionCount"><%= post.like_count || 0 %></span>
          </button>
          <div class="reaction-picker" id="reactionPicker">
            <% [{e:'👍',t:'like'},{e:'❤️',t:'love'},{e:'😂',t:'haha'},{e:'😮',t:'wow'},{e:'😢',t:'sad'}].forEach(r => { %>
              <button class="reaction-opt" data-emoji="<%= r.e %>" data-type="<%= r.t %>" title="<%= r.t %>"><%= r.e %></button>
            <% }); %>
          </div>
        </div>
        <a href="#comments" class="feed-action"><i class="far fa-comment"></i> <%= comments.length %></a>
        <div class="share-wrap">
          <button class="feed-action share-trigger" id="shareTrigger"><i class="fas fa-share"></i> শেয়ার</button>
          <div class="share-menu" id="shareMenu">
            <button onclick="copyLink('<%= post.id %>')"><i class="fas fa-link"></i> লিংক কপি করুন</button>
            <a href="https://wa.me/?text=<%= encodeURIComponent(post.title + ' ' + (req ? req.protocol + '://' + req.get('host') + '/articles/' + post.id : '')) %>" target="_blank"><i class="fab fa-whatsapp"></i> WhatsApp</a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(req ? req.protocol + '://' + req.get('host') + '/articles/' + post.id : '') %>" target="_blank"><i class="fab fa-facebook"></i> Facebook</a>
            <button onclick="shareToUser('<%= post.id %>')"><i class="fas fa-user"></i> ইউজারকে পাঠান</button>
          </div>
        </div>
        <% if (user && user.id === post.author_id) { %>
          <a href="/articles/<%= post.id %>/edit" class="feed-action"><i class="fas fa-pen"></i></a>
          <form method="POST" action="/articles/<%= post.id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('মুছে ফেলতে চান?')">
            <button type="submit" class="feed-action danger"><i class="fas fa-trash"></i></button>
          </form>
        <% } %>
      </div>

      <%# ── Comments ─────────────────────────────────────────────────── %>
      <div class="comments-section" id="comments">
        <h3><i class="far fa-comment"></i> মন্তব্য (<%= comments.length %>)</h3>
        <% if (user) { %>
          <form method="POST" class="comment-form" id="commentForm">
            <img src="<%= user.avatar_url || '/avatar/' + user.id %>" class="comment-avatar">
            <div class="comment-input-wrap">
              <textarea name="body" placeholder="আপনার মন্তব্য লিখুন... (নতুন লাইনে @ব্যবহারকারী নাম লিখুন)" rows="3" required></textarea>
              <button type="submit"><i class="fas fa-paper-plane"></i> পাঠান</button>
            </div>
          </form>
        <% } else { %>
          <p class="login-to-comment"><a href="/login">লগইন</a> করে মন্তব্য করুন</p>
        <% } %>

        <div class="comments-list">
          <% if (!comments.length) { %>
            <div class="empty-state-full" style="padding:30px">
              <i class="far fa-comment-dots"></i>
              <p>প্রথম মন্তব্যকারী হোন!</p>
            </div>
          <% } %>
          <% comments.forEach(c => { %>
            <div class="comment-item" id="c<%= c.id %>">
              <img src="<%= c.avatar_url || '/avatar/' + c.author_id %>" class="comment-avatar">
              <div class="comment-bubble">
                <a href="/profile/<%= c.username %>" class="comment-author"><%= c.full_name %></a>
                <p class="comment-body"><%- c.body %></p>
                <div class="comment-meta">
                  <span><i class="far fa-clock"></i> <%= new Date(c.created_at).toLocaleDateString('bn-BD') %></span>
                  <button class="reply-btn" data-id="<%= c.id %>"><i class="far fa-comment"></i> উত্তর</button>
                  <button class="feed-action like-btn-sm comment-like" data-id="<%= c.id %>" data-type="comment">
                    <i class="far fa-thumbs-up"></i> <%= c.like_count || 0 %>
                  </button>
                </div>
                <div class="reply-form-wrap" id="replyForm<%= c.id %>" style="display:none">
                  <form class="reply-form" data-parent="<%= c.id %>">
                    <textarea placeholder="উত্তর লিখুন..." rows="2" required></textarea>
                    <button type="submit"><i class="fas fa-paper-plane"></i></button>
                  </form>
                </div>
                <% c.replies && c.replies.forEach(r => { %>
                  <div class="reply-item" id="c<%= r.id %>">
                    <img src="<%= r.avatar_url || '/avatar/' + r.author_id %>" class="comment-avatar" style="width:28px;height:28px">
                    <div class="comment-bubble small">
                      <a href="/profile/<%= r.username %>" class="comment-author"><%= r.full_name %></a>
                      <p class="comment-body"><%- r.body %></p>
                      <div class="comment-meta">
                        <span><i class="far fa-clock"></i> <%= new Date(r.created_at).toLocaleDateString('bn-BD') %></span>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </article>
  </div>

  <%# ── Share-to-user modal ─────────────────────────────────────────── %>
  <div id="shareModal" class="modal-backdrop" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h3>ইউজারকে পাঠান</h3>
        <button onclick="closeShareModal()"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body">
        <input type="text" id="shareUserSearch" placeholder="ইউজারনেম খুঁজুন..." class="input" autocomplete="off" />
        <div id="shareUserResults"></div>
        <input type="hidden" id="sharePostId" />
      </div>
    </div>
  </div>

  <script>
    // ── 5-emoji reactions ──────────────────────────────────────────────
    const mainBtn = document.getElementById('mainReactionBtn');
    const picker = document.getElementById('reactionPicker');
    const postId = document.querySelector('.reaction-bar').dataset.id;

    mainBtn.addEventListener('click', () => picker.classList.toggle('open'));
    picker.querySelectorAll('.reaction-opt').forEach(btn => {
      btn.addEventListener('click', async () => {
        const emoji = btn.dataset.emoji, type = btn.dataset.type;
        picker.classList.remove('open');
        const res = await fetch('/api/react', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_id: postId, target_type: 'post', reaction_type: type })
        });
        if (res.ok) {
          const data = await res.json();
          document.getElementById('reactionCount').textContent = data.total;
          mainBtn.innerHTML = emoji + ' <span id="reactionCount">' + data.total + '</span>';
        }
      });
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('.reaction-btn-wrap')) picker.classList.remove('open');
    });

    // ── Comment form ──────────────────────────────────────────────────
    document.getElementById('commentForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const body = this.body.value;
      const res = await fetch('/api/comment', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ post_id: postId, body })
      });
      if (res.ok) location.reload();
    });

    // ── Reply toggle + submit ─────────────────────────────────────────
    document.querySelectorAll('.reply-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        document.querySelectorAll('.reply-form-wrap').forEach(f => f.style.display = 'none');
        document.getElementById('replyForm' + id).style.display = 'block';
      });
    });
    document.querySelectorAll('.reply-form').forEach(f => {
      f.addEventListener('submit', async function(e) {
        e.preventDefault();
        const parentId = this.dataset.parent;
        const body = this.querySelector('textarea').value;
        const res = await fetch('/api/comment', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ post_id: postId, body, parent_id: parentId })
        });
        if (res.ok) location.reload();
      });
    });

    // ── Comment like ─────────────────────────────────────────────────
    document.querySelectorAll('.comment-like').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const res = await fetch('/api/react', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_id: id, target_type: 'comment', reaction_type: 'like' })
        });
        if (res.ok) {
          const data = await res.json();
          const icon = btn.querySelector('i');
          const span = btn.querySelector('span') || btn;
          if (data.user_reacted) { icon.className = 'fas fa-thumbs-up'; }
          else { icon.className = 'far fa-thumbs-up'; }
          btn.innerHTML = '<i class="' + icon.className + '"></i> ' + data.total;
        }
      });
    });

    // ── Share menu toggle ─────────────────────────────────────────────
    document.getElementById('shareTrigger').addEventListener('click', e => {
      e.stopPropagation();
      document.getElementById('shareMenu').classList.toggle('open');
    });
    document.addEventListener('click', () => document.getElementById('shareMenu').classList.remove('open'));

    function copyLink(id) {
      navigator.clipboard.writeText(location.origin + '/articles/' + id).then(() => showToast('লিংক কপি হয়েছে! ✓'));
      document.getElementById('shareMenu').classList.remove('open');
    }

    async function shareToUser(postId) {
      document.getElementById('shareMenu').classList.remove('open');
      document.getElementById('sharePostId').value = postId;
      document.getElementById('shareModal').style.display = 'flex';
      document.getElementById('shareUserSearch').focus();
    }

    function closeShareModal() {
      document.getElementById('shareModal').style.display = 'none';
    }

    // User search in share modal
    let shareSearchTimer;
    document.getElementById('shareUserSearch').addEventListener('input', function() {
      clearTimeout(shareSearchTimer);
      const q = this.value.trim();
      if (!q) { document.getElementById('shareUserResults').innerHTML = ''; return; }
      shareSearchTimer = setTimeout(async () => {
        const res = await fetch('/api/users/search?q=' + encodeURIComponent(q));
        if (res.ok) {
          const users = await res.json();
          document.getElementById('shareUserResults').innerHTML = users.map(u =>
            '<div class="share-user-result" onclick="sendToUser(\'' + u.username + '\',' + document.getElementById('sharePostId').value + ')">' +
            '<img src="' + (u.avatar_url || '/avatar/' + u.id) + '" style="width:36px;height:36px;border-radius:50%;object-fit:cover">' +
            '<div><strong>' + u.full_name + '</strong><br><small>@' + u.username + '</small></div></div>'
          ).join('');
        }
      }, 300);
    });

    async function sendToUser(username, postId) {
      closeShareModal();
      const res = await fetch('/api/share-to-user', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to_username: username, post_id: postId })
      });
      if (res.ok) {
        const data = await res.json();
        showToast('পোস্ট পাঠানো হয়েছে!');
        if (data.redirect) window.location.href = data.redirect;
      } else {
        showToast('সমস্যা হয়েছে, আবার চেষ্টা করুন');
      }
    }

    function showToast(msg) {
      const t = document.createElement('div');
      t.className = 'toast toast-success';
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }
  </script>
</body>
</html>
