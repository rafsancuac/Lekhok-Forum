<%# সেশন ৮৩: ইউজার তদারকি (মডারেটর — user_mgmt স্কোপ) %>
<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ইউজার তদারকি | মডারেটর প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body>
<%- include('../../admin/views/admin/partials/sidebar') %>
<div class="admin-main">
<div class="mod-wrap">
    <p><a href="/moderator"><i class="fas fa-arrow-right"></i> মডারেটর প্যানেলে ফিরুন</a></p>
    <h2><i class="fas fa-users-cog"></i> ইউজার তদারকি</h2>
    <p style="color:#65676b;font-size:.9rem;line-height:1.7;">
      হায়ারার্কি-নীতি: ইউজারের কাজ মডারেটর নিয়ন্ত্রণ ও তদারকি করতে পারেন — নিয়ম-ভঙ্গকারীকে
      <strong>নিষেধ</strong> করা ও <strong>ফেরত</strong> আনা এখানেই করুন। রোল-পরিবর্তন (মডারেটর/এডমিন নিয়োগ) এখানে সম্ভব নয় —
      সেটি কেবল এডমিন ও সুপার-এডমিনের এখতিয়ার।
    </p>

    <% if (typeof saved !== 'undefined' && saved) { %><div class="alert alert-success" style="background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;padding:10px 14px;border-radius:5px;margin:12px 0;"><i class="fas fa-check-circle"></i> সফলভাবে আপডেট হয়েছে।</div><% } %>
    <% if (typeof err !== 'undefined' && err === 'staff') { %><div class="alert alert-error" style="background:#fee2e2;border:1px solid #fecaca;color:#991b1b;padding:10px 14px;border-radius:5px;margin:12px 0;"><i class="fas fa-exclamation-triangle"></i> স্টাফ অ্যাকাউন্ট (মডারেটর/এডমিন) মডারেটর পরিবর্তন করতে পারবেন না — এটি ঊর্ধ্বতন-স্তরের কাজ।</div><% } else if (typeof err !== 'undefined' && err) { %><div class="alert alert-error" style="background:#fee2e2;border:1px solid #fecaca;color:#991b1b;padding:10px 14px;border-radius:5px;margin:12px 0;"><i class="fas fa-exclamation-circle"></i> অনুরোধ প্রক্রিয়া করা যায়নি।</div><% } %>

    <form method="GET" action="/moderator/users" style="display:flex;gap:8px;margin:14px 0;flex-wrap:wrap;">
      <input type="search" name="q" value="<%= q81 %>" placeholder="নাম বা ইউজারনেম খুঁজুন…" aria-label="ইউজার খুঁজুন"
             style="flex:1;min-width:200px;padding:10px 14px;border:1px solid #ccd0d5;border-radius:5px;font-family:inherit;">
      <button class="btn btn-primary"><i class="fas fa-search"></i> খুঁজুন</button>
      <% if (q81) { %><a class="btn btn-sm" href="/moderator/users" style="padding:10px 14px;display:inline-flex;align-items:center;"><i class="fas fa-times"></i> বাতিল</a><% } %>
    </form>

    <% if (!users.length) { %>
      <p style="color:#999;"><i class="fas fa-inbox"></i> কোনো ইউজার পাওয়া যায়নি।</p>
    <% } else { %>
    <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;background:#fff;border:1px solid #e4e6eb;border-radius:5px;overflow:hidden;">
      <thead>
        <tr style="background:#f0f2f5;text-align:left;font-size:.85rem;">
          <th style="padding:12px 14px;">ইউজার</th>
          <th style="padding:12px 14px;">রোল</th>
          <th style="padding:12px 14px;">স্ট্যাটাস</th>
          <th style="padding:12px 14px;">যোগদান</th>
          <th style="padding:12px 14px;">শেষ লগইন</th>
          <th style="padding:12px 14px;">কার্যক্রম</th>
        </tr>
      </thead>
      <tbody>
      <% users.forEach(u => { %>
        <tr style="border-top:1px solid #e4e6eb;">
          <td style="padding:10px 14px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <img src="<%= u.avatar_url || '/avatar/' + u.id %>" alt="" width="36" height="36" style="border-radius:50%;object-fit:cover;" loading="lazy">
              <div>
                <strong style="font-size:.92rem;"><%= u.full_name || u.username %></strong>
                <div style="font-size:.78rem;color:#65676b;">@<%= u.username %></div>
              </div>
            </div>
          </td>
          <td style="padding:10px 14px;">
            <% if (u.role === 'moderator') { %><span class="badge-soft role-moderator">মডারেটর</span>
            <% } else if (u.role === 'admin') { %><span class="badge-soft role-admin">এডমিন</span>
            <% } else { %><span class="badge-soft role-user">ইউজার</span><% } %>
          </td>
          <td style="padding:10px 14px;">
            <% if (u.status === 'banned') { %><span class="badge-soft status-banned">নিষিদ্ধ</span>
            <% } else if (u.status === 'pending') { %><span class="badge-soft status-pending">অপেক্ষমাণ</span>
            <% } else { %><span class="badge-soft" style="color:#047857;">সক্রিয়</span><% } %>
          </td>
          <td style="padding:10px 14px;font-size:.82rem;color:#65676b;"><%= (u.created_at || '').split(' ')[0] %></td>
          <td style="padding:10px 14px;font-size:.82rem;color:#65676b;"><%= u.last_login ? (u.last_login + '').split(' ')[0] : '—' %></td>
          <td style="padding:10px 14px;">
            <% if (u.role === 'user' && u.status !== 'pending') { %>
            <form method="POST" action="/moderator/users/<%= u.id %>/status" style="display:flex;gap:6px;align-items:center;">
              <% if (u.status === 'banned') { %>
                <input type="hidden" name="status" value="active">
                <button class="btn btn-sm" style="background:#ecfdf5;color:#047857;border:1px solid #a7f3d0;padding:6px 12px;"><i class="fas fa-undo"></i> ফেরত আনুন</button>
              <% } else { %>
                <input type="hidden" name="status" value="banned">
                <button class="btn btn-sm btn-danger" style="padding:6px 12px;"><i class="fas fa-ban"></i> নিষেধ করুন</button>
              <% } %>
            </form>
            <% } else if (u.role !== 'user') { %>
              <span style="font-size:.78rem;color:#8a8d93;"><i class="fas fa-lock"></i> ঊর্ধ্বতন-এখতিয়ার</span>
            <% } else { %>
              <span style="font-size:.78rem;color:#8a8d93;">অপেক্ষমাণ — এডমিন অনুমোদন করবেন</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <p style="font-size:.8rem;color:#8a8d93;margin-top:10px;">সর্বশেষ ২০০ জন দেখানো হচ্ছে। প্রতিটি নিষেধ/ফেরত অডিট-লগে রেকর্ড হয়।</p>
    <% } %>
</div>
</div>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
