<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: (post.title) + ' | প্রশ্নোত্তর | লেখক ফোরাম', extra_css: ['/assets/css/article.css'] }) %>

<%# ── সেশন ৭২ (GSC-ফিক্স): QAPage JSON-LD — Google-এ সমৃদ্ধ ফলাফল + কনটেন্ট-সিগন্যাল ── %>
<%
  var _qText72 = (s) => String(s || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  var _qaLd72 = {
    "@context": "https://schema.org",
    "@type": "QAPage",
    "mainEntity": {
      "@type": "Question",
      "name": post.title,
      "text": _qText72(post.body),
      "answerCount": (answers || []).length,
      "author": { "@type": "Person", "name": post.full_name },
      "datePublished": post.published_at || post.created_at || undefined,
      "acceptedAnswer": undefined,
      "suggestedAnswer": (answers || []).map(function (a) {
        return { "@type": "Answer", "text": _qText72(a.body), "datePublished": a.created_at || undefined, "author": { "@type": "Person", "name": a.full_name } };
      })
    }
  };
%>
<script type="application/ld+json"><%- JSON.stringify(_qaLd72) %></script>

  <div class="article-wrap qa-wrap">
    <article class="article-main card">
      <span class="feed-type-badge question"><i class="fas fa-question-circle"></i> প্রশ্ন</span>
      <div class="question-body">
        <h1 class="question-title"><%= post.title %></h1>
        <p class="question-detail"><%- post.body.replace(/\n/g, '<br>').replace(/@([a-zA-Z0-9_]+)/g, '<a class="mention" href="/profile/$1">@$1</a>') %></p>
        <% try { const qMentions = JSON.parse(post.mentions || '[]'); if (qMentions.length) { %>
          <div class="mentions-row">
            <span class="mentions-label"><i class="fas fa-at"></i> ম্যানশন:</span>
            <% qMentions.forEach(m => { %>
              <a href="/profile/<%= m.username %>" class="mention-chip">@<%= m.username %></a>
            <% }); %>
          </div>
        <% } } catch(e) {} %>
        <div class="question-meta">
          <img loading="lazy" decoding="async" src="<%= post.avatar_url || '/avatar/' + post.author_id %>" class="mini-avatar">
          <a href="/profile/<%= post.username %>" class="qa-author"><%= post.full_name %></a>
          <span>&middot;</span>
          <span><i class="far fa-clock"></i> <%= new Date(post.created_at).toLocaleDateString('bn-BD') %></span>
        </div>
        <% if (user && user.id === post.author_id) { %>
        <div class="qa-owner-controls" style="margin-top:8px; display:flex; gap:8px;">
          <a href="/qa/<%= post.id %>/edit" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> সম্পাদনা</a>
          <form method="POST" action="/qa/<%= post.id %>/delete"  style="display:inline;">
            <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> মুছুন</button>
          </form>
        </div>
        <% } %>
      </div>

      <div class="article-footer">
        <%- include('../partials/actions-bar', {
          targetId: post.id,
          targetType: 'post',
          counts: reaction.counts,
          mine: reaction.mine,
          link: '/qa/' + post.id,
          showBookmark: false
        }) %>
      </div>

      <div class="answers-section">
        <h2><i class="fas fa-reply-all"></i> উত্তরসমূহ (<%= answers.length %>)</h2>

        <% if (answers.length === 0) { %>
          <div class="empty-state answers-empty"><i class="fas fa-reply-all"></i><p>এখনো কোনো উত্তর নেই। প্রথম উত্তরদাতা হোন!</p></div>
        <% } %>

        <% answers.forEach((a, idx) => { %>
          <div class="answer-item card" id="answer-<%= a.id %>">
            <div class="answer-sidebar">
              <img loading="lazy" decoding="async" src="<%= a.avatar_url || '/avatar/' + a.author_id %>" class="answer-avatar">
              <% if (idx === 0 && a.like_count > 0) { %><span class="top-answer-chip"><i class="fas fa-arrow-up"></i> শীর্ষ উত্তর</span><% } %>
            </div>
            <div class="answer-body">
              <div class="answer-header">
                <a href="/profile/<%= a.username %>" class="answer-author"><%= a.full_name %></a>
                <span class="answer-date"><i class="far fa-clock"></i> <%= new Date(a.created_at).toLocaleDateString('bn-BD') %></span>
              </div>
              <div class="answer-text"><%- a.body.replace(/\n/g, '<br>') %></div>
              <% if (user) { %>
                <%- include('../partials/actions-bar', {
                  targetId: a.id, targetType: 'comment',
                  counts: a.reaction.counts, mine: a.reaction.mine,
                  link: '/qa/' + post.id, showBookmark: false, showShare: false
                }) %>
              <% } else { %>
                <div class="answer-actions"><span><i class="far fa-heart"></i> <%= a.like_count || 0 %></span></div>
              <% } %>
            </div>
          </div>
        <% }); %>

        <% if (user) { %>
          <div class="answer-form-wrap card" id="answerForm">
            <h3><i class="fas fa-pen-nib"></i> আপনার উত্তর দিন</h3>
            <form method="POST" action="/qa/<%= post.id %>/answer" class="answer-form">
              <textarea name="body" rows="5" placeholder="আপনার উত্তর লিখুন..." required></textarea>
              <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> উত্তর দিন</button>
            </form>
          </div>
        <% } else { %>
          <p class="login-to-comment"><a href="/login?next=/qa/<%= post.id %>">লগইন</a> করে উত্তর দিন</p>
        <% } %>
      </div>
    </article>

    <%# ── সেশন ৭২ (GSC-ফিক্স): সম্পর্কিত প্রশ্ন — অন্য qa-পেজে ইন্টারনাল লিংক ── %>
    <% if (typeof relatedQ !== 'undefined' && relatedQ && relatedQ.length) { %>
      <div class="card" style="margin-top:24px; padding:22px;">
        <h3 style="margin:0 0 14px; font-size:17px;"><i class="fas fa-layer-group" style="color:var(--accent,#059669)"></i> আরও প্রশ্ন</h3>
        <div class="notice-list">
          <% relatedQ.forEach(q => { %>
            <a href="/qa/<%= q.id %>" class="notice-row notice-row--compact">
              <span class="notice-row-icon cat-general"><i class="fas fa-question"></i></span>
              <span class="notice-row-main">
                <span class="notice-row-top"><span class="notice-row-title"><%= q.title %></span></span>
              </span>
              <span class="notice-row-meta">
                <span class="notice-row-date"><i class="far fa-user"></i><%= q.author_name %></span>
                <i class="fas fa-chevron-right notice-row-arrow"></i>
              </span>
            </a>
          <% }) %>
        </div>
        <div style="text-align:center; margin-top:14px;">
          <a href="/qa" class="link-more">সব প্রশ্ন দেখুন <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('../partials/share-modal') %>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
