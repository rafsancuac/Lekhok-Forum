<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'আজকের কুইজ | লেখক ফোরাম' }) %>
  <div class="page-wrap" style="max-width:700px">
    <div class="page-header">
      <h1><i class="fas fa-question-circle"></i> আজকের কুইজ</h1>
      <span class="today-date"><i class="far fa-calendar"></i> <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    </div>

    <%# ── সেশন ৬০: স্কোর-সামারি বার (localStorage-ভিত্তিক, লগইন-ছাড়াই);
        সেশন ৬২: লগইন-ইউজারের স্কোর সার্ভারে (DB) থাকে — ডিভাইস-বদলেও বহাল ── %>
    <div class="quiz-score-bar" id="quizScoreBar" data-today-id="<%= today ? today.id : '' %>" hidden>
      <div class="qs-stat"><i class="fas fa-bullseye"></i><span class="qs-label">আজকের স্কোর</span><strong id="qsToday">—</strong></div>
      <div class="qs-sep"></div>
      <div class="qs-stat"><i class="fas fa-trophy"></i><span class="qs-label">মোট সঠিক</span><strong id="qsTotal">—</strong></div>
      <div class="qs-sep"></div>
      <div class="qs-stat"><i class="fas fa-fire"></i><span class="qs-label">ধারাবাহিকতা</span><strong id="qsStreak">—</strong></div>
    </div>
    <% if (!user) { %>
      <p class="quiz-sync-hint"><i class="fas fa-cloud-arrow-up"></i> লগইন করলে আপনার স্কোর ও ধারাবাহিকতা সার্ভারে সংরক্ষিত হবে — যেকোনো ডিভাইস থেকে ফিরে পাবেন। <a href="/login?next=%2Fquiz">লগইন করুন</a></p>
    <% } %>

    <% if (today) { %>
      <div class="daily-card quiz-card<%= today.options ? ' has-options' : '' %>" data-quiz="<%= today.id %>">
        <div class="quiz-card-top">
          <span class="daily-card-badge"><i class="fas fa-question"></i> কুইজ</span>
          <span class="quiz-points"><i class="fas fa-star"></i> ১ পয়েন্ট</span>
        </div>
        <h2><%= today.title %></h2>

        <% if (today.options) { %>
          <%# ইন্টারঅ্যাক্টিভ: উত্তর সার্ভার-সাইড যাচাই (POST /quiz/check) ── %>
          <div class="quiz-options" role="group" aria-label="কুইজের অপশনগুলো">
            <% today.options.forEach(function(opt, i) { %>
              <button type="button" class="quiz-opt" data-i="<%= i %>">
                <span class="quiz-opt-key"><%= ['ক','খ','গ','ঘ','ঙ'][i] || (i + 1) %></span>
                <span class="quiz-opt-text"><%= opt %></span>
                <i class="fas fa-check quiz-opt-ic"></i>
              </button>
            <% }) %>
          </div>
          <div class="quiz-result" hidden></div>
        <% } else { %>
          <%# স্ট্যাটিক ফলব্যাক (options-হীন পুরনো পোস্ট) ── %>
          <p class="daily-body"><%= today.body %></p>
        <% } %>

        <% if (today.link_url) { %>
          <a href="<%= today.link_url %>" class="btn-primary-sm" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> উত্তর দিন</a>
        <% } %>
        <div class="daily-meta">প্রকাশ: <%= new Date(today.created_at).toLocaleDateString('bn-BD') %></div>
      </div>
    <% } else { %>
      <div class="empty-state-full">
        <i class="fas fa-question-circle"></i>
        <p>আজকের জন্য কোনো কুইজ নেই। মডারেটর তাড়াতাড়ি যোগ করবেন।</p>
      </div>
    <% } %>

    <%# ── পূর্বের কুইজ আর্কাইভ (সেশন ৫৯) — সেশন ৬০: আর্কাইভ-আইটেমও এখন ইন্টারঅ্যাক্টিভ ── %>
    <% if (archive && archive.length) { %>
      <section class="quiz-archive">
        <div class="section-head">
          <h2 class="section-title"><i class="fas fa-clock-rotate-left"></i> পূর্বের কুইজ</h2>
          <span class="quiz-archive-count"><%= archive.length %>টি</span>
        </div>
        <div class="quiz-archive-list">
          <% archive.forEach(function(q, i) { %>
            <details class="quiz-arch-item"<%= i === 0 && !today ? ' open' : '' %>>
              <summary>
                <span class="qa-date"><i class="far fa-calendar"></i> <%= new Date(q.scheduled_date || q.created_at).toLocaleDateString('bn-BD') %></span>
                <span class="qa-title"><%= q.title %></span>
                <i class="fas fa-chevron-down qa-chev"></i>
              </summary>
              <div class="qa-body">
                <% if (q.options) { %>
                  <div class="quiz-block quiz-mini" data-quiz="<%= q.id %>">
                    <div class="quiz-options" role="group" aria-label="কুইজের অপশনগুলো">
                      <% q.options.forEach(function(opt, j) { %>
                        <button type="button" class="quiz-opt" data-i="<%= j %>">
                          <span class="quiz-opt-key"><%= ['ক','খ','গ','ঘ','ঙ'][j] || (j + 1) %></span>
                          <span class="quiz-opt-text"><%= opt %></span>
                          <i class="fas fa-check quiz-opt-ic"></i>
                        </button>
                      <% }) %>
                    </div>
                    <div class="quiz-result" hidden></div>
                  </div>
                <% } else { %>
                  <p><%= q.body %></p>
                <% } %>
                <% if (q.link_url) { %>
                  <a href="<%= q.link_url %>" class="qa-link" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> বিস্তারিত দেখুন</a>
                <% } %>
              </div>
            </details>
          <% }) %>
        </div>
      </section>
    <% } %>
    <%# ── সেশন ৬৪: আমার কুইজ-ইতিহাস — লগইন-ইউজারের উত্তরের সময়রেখা ── %>
    <% if (user && myHistory && myHistory.length) { %>
      <% const bn64 = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]);
         const hc = myHistory.filter(h => h.correct).length;
         const acc = Math.round((hc / myHistory.length) * 100); %>
      <section class="quiz-history">
        <div class="section-head">
          <h2 class="section-title"><i class="fas fa-clock-rotate-left"></i> আমার কুইজ-ইতিহাস</h2>
          <span class="quiz-archive-count"><%= bn64(hc) %>/<%= bn64(myHistory.length) %> সঠিক · <%= bn64(acc) %>%</span>
        </div>
        <div class="qh-acc-bar" role="img" aria-label="নির্ভুলতা <%= bn64(acc) %> শতাংশ">
          <div class="qh-acc-fill" style="width:<%= acc %>%"></div>
        </div>
        <ol class="qh-list">
          <% myHistory.forEach(function(h) { %>
            <li class="qh-row<%= h.correct ? ' was-right' : ' was-wrong' %>">
              <span class="qh-status"><i class="fas <%= h.correct ? 'fa-circle-check' : 'fa-circle-xmark' %>"></i></span>
              <div class="qh-main">
                <span class="qh-title"><%= h.title %></span>
                <% if (h.chosen) { %>
                  <span class="qh-choice">আপনার উত্তর: <em><%= h.chosen %></em></span>
                <% } %>
              </div>
              <span class="qh-when" data-ts="<%= h.when %>" title="<%= h.when %>"><i class="far fa-clock"></i> <%= h.when %></span>
            </li>
          <% }) %>
        </ol>
      </section>
    <% } %>
    <%# ── সেশন ৬২: কুইজ লিডারবোর্ড — সার্ভার-স্কোরভিত্তিক টপ ১০ ── %>
    <% if (board && board.length) { %>
      <% const bn62 = (n) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]); %>
      <section class="quiz-board">
        <div class="section-head">
          <h2 class="section-title"><i class="fas fa-ranking-star"></i> কুইজ লিডারবোর্ড</h2>
          <span class="quiz-archive-count"><%= bn62(board.length) %> জন</span>
        </div>
        <ol class="quiz-board-list">
          <% board.forEach(function(p, i) { %>
            <li class="qb-row<%= user && user.id === p.id ? ' is-me' : '' %><%= i === 0 ? ' is-top' : '' %>">
              <span class="qb-rank"><i class="<%= i === 0 ? 'fas fa-crown' : 'fas fa-medal' %>"></i> <%= ['১ম','২য়','৩য়','৪র্থ','৫ম','৬ষ্ঠ','৭ম','৮ম','৯ম','১০ম'][i] || bn62(i + 1) %></span>
              <a class="qb-user" href="/profile/<%= encodeURIComponent(p.username) %>">
                <img src="/avatar/<%= p.id %>?v=2" alt="<%= p.full_name || p.username %>" loading="lazy" class="qb-avatar">
                <span class="qb-name"><%= p.full_name || p.username %><% if (user && user.id === p.id) { %><em class="qb-you">আপনি</em><% } %></span>
              </a>
              <span class="qb-stats">
                <span class="qb-correct"><i class="fas fa-circle-check"></i> <strong><%= bn62(p.correct_n) %></strong>/<%= bn62(p.answered) %></span>
                <span class="qb-streak<%= p.streak > 0 ? ' has-streak' : '' %>"><i class="fas fa-fire"></i> <%= bn62(p.streak) %></span>
              </span>
            </li>
          <% }) %>
        </ol>
        <p class="qb-note"><i class="fas fa-circle-info"></i> প্রথম উত্তরই চূড়ান্ত গণ্য হয় — এক প্রতিযোগী, এক সুযোগ।</p>
      </section>
    <% } %>

    <%# ── সেশন ৬২: সার্ভার-স্কোর (লগইন-ইউজার) — quiz.js মার্জ করে ── %>
    <% if (mine) { %>
      <script id="quizServerState" type="application/json"><%- JSON.stringify({ attempts: mine.map, stats: { answered: mine.answered, correct: mine.correct, streak: mine.streak } }) %></script>
    <% } %>
  </div>
  <script src="/assets/js/quiz.js?v=<%= AV %>"></script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
