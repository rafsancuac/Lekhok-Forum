<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'সাংগঠনিক কার্যক্রম — লেখক ফোরাম' }) %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-calendar-check"></i> সাংগঠনিক কার্যক্রম</h1>
    </div>

    <% if (items.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-calendar-check"></i><p>কোনো কার্যক্রম প্রকাশ করা হয়নি।</p></div>
    <% } else { %>
      <div class="articles-grid">
        <% items.forEach(a => { %>
          <div class="post-card">
            <% if (a.image_url) { %><img src="<%= a.image_url %>" alt="cover" class="post-cover"><% } %>
            <div class="post-card-body">
              <div class="post-meta-top"><span class="post-date"><i class="far fa-calendar"></i> <%= a.scheduled_date %></span></div>
              <a href="/activities#item-<%= a.id %>" class="post-title"><%= a.title %></a>
              <p class="post-excerpt"><%= a.body.substring(0, 200) %>...</p>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script src="/assets/js/main.js"></script>
</body>
</html>
