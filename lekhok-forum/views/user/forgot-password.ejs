<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
  <meta charset="UTF-8" />
  <title>পাসওয়ার্ড রিসেট | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css" />
  <link rel="stylesheet" href="/assets/css/member-accounts.css" />
</head>
<body>
  <div class="auth-card mc-wrap">
    <a href="/login" class="back-home"><i class="fas fa-arrow-left"></i> লগইনে ফিরে যান</a>
    <div class="auth-brand">
      <span class="auth-logo"><i class="fas fa-feather-alt"></i></span>
      <span class="auth-brand-name">লেখক ফোরাম</span>
    </div>
    <h1 class="auth-title">পাসওয়ার্ড রিসেট</h1>
    <% if (done) { %>
      <div class="mc-msg ok"><i class="fas fa-check-circle"></i> যদি এই তথ্যের একটি অ্যাকাউন্ট থেকে থাকে, তাহলে রিসেট লিংক পাঠানো হয়েছে। আপনার ইমেইল ইনবক্স (এবং স্প্যাম) দেখুন।</div>
      <p class="mc-foot"><a href="/login">লগইন পেজে ফিরে যান</a></p>
    <% } else { %>
      <p class="auth-sub">নিবন্ধিত ইমেইল বা ব্যবহারকারী নাম (অথবা মেম্বার আইডি) দিন — সেখানে রিসেট লিংক যাবে।</p>
      <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
      <form method="POST">
        <div class="form-group">
          <label>ইমেইল / ব্যবহারকারী নাম / মেম্বার আইডি</label>
          <input type="text" name="identifier" required autofocus>
        </div>
        <button type="submit" class="btn-primary"><i class="fas fa-paper-plane"></i> রিসেট লিংক পাঠান</button>
      </form>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
