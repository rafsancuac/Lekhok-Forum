<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>মাসিক সেরা লেখক | মডারেটর প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body>
<%- include('../../admin/views/admin/partials/sidebar') %>
<div class="admin-main">
<div class="mod-wrap">
    <p><a href="/moderator"><i class="fas fa-arrow-right"></i> মডারেটর প্যানেলে ফিরুন</a></p>
    <h2><i class="fas fa-star star-badge"></i> মাসিক সেরা লেখক নির্বাচন করুন</h2>
    <p style="color:#666;">যে লেখাগুলো "সেরা লেখক" হিসেবে চিহ্নিত থাকবে সেগুলো <code>/best-writer</code> পেইজে দেখা যাবে এবং লেখককে নোটিফিকেশন যাবে।</p>
    <% articles.forEach(a => { %>
      <div class="mod-item">
        <div>
          <strong><%= a.title %></strong>
          <div style="color:#999; font-size:0.85rem;"><%= a.full_name %> (@<%= a.username %>)</div>
        </div>
        <form method="POST" action="/moderator/best-writer/<%= a.id %>/toggle">
          <button class="btn <%= a.featured ? 'btn-danger' : 'btn-primary' %> btn-sm" type="submit">
            <%= a.featured ? 'বাদ দিন' : 'সেরা লেখক করুন' %>
          </button>
        </form>
      </div>
    <% }) %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
