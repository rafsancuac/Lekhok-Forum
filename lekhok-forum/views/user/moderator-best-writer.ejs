<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>মাসিক সেরা লেখক — মডারেটর প্যানেল</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="stylesheet" href="/assets/css/fonts.css" />
  <link rel="stylesheet" href="/assets/css/dashboard.css" />
  <style>
    .mod-wrap { max-width: 760px; margin: 20px auto; padding: 0 16px; }
    .mod-item { background:#fff; border-radius:10px; padding:14px 16px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; }
    .star-badge { color:#059669; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <div class="mod-wrap">
    <p><a href="/moderator"><i class="fas fa-arrow-right"></i> মডারেটর প্যানেলে ফিরুন</a></p>
    <h2><i class="fas fa-star star-badge"></i> মাসিক সেরা লেখক নির্বাচন করুন</h2>
    <p style="color:#666;">যে লেখাগুলো "সেরা লেখক" হিসেবে চিহ্নিত থাকবে সেগুলো <code>/best-writer</code> পেইজে দেখা যাবে এবং লেখককে নোটিফিকেশন যাবে।</p>
    <% articles.forEach(a => { %>
      <div class="mod-item">
        <div>
          <strong><%= a.title %></strong>
          <div style="color:#999; font-size:0.85rem;">— <%= a.full_name %> (@<%= a.username %>)</div>
        </div>
        <form method="POST" action="/moderator/best-writer/<%= a.id %>/toggle">
          <button class="btn <%= a.featured ? 'btn-danger' : 'btn-primary' %> btn-sm" type="submit">
            <%= a.featured ? 'বাদ দিন' : 'সেরা লেখক করুন' %>
          </button>
        </form>
      </div>
    <% }) %>
  </div>
</body>
</html>
