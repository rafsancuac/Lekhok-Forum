<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

  <meta charset="UTF-8" />
  <title>লগইন ও প্রোফাইল খুঁজুন | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css" />
  <link rel="stylesheet" href="/assets/css/member-accounts.css" />
</head>
<body class="auth-split">
  <div class="as-shell">

    <!-- ── বাম ব্র্যান্ড-প্যানেল ── -->
    <aside class="as-brand">
      <div class="as-brand-top">
        <span class="as-logo"><i class="fas fa-feather-alt"></i></span>
        <span class="as-brand-name">লেখক ফোরাম</span>
      </div>
      <div class="as-brand-mid">
        <p class="as-eyebrow">চট্টগ্রাম বিশ্ববিদ্যালয়</p>
        <h2 class="as-tagline">বাংলাদেশ তরুণ কলাম লেখক ফোরাম</h2>
        <p class="as-intro">শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটানোই আমাদের প্রত্যয়।</p>
      </div>
      <div class="as-brand-bottom">© ২০২৬ লেখক ফোরাম। সর্বস্বত্ব সংরক্ষিত।</div>
    </aside>

    <!-- ── ডান ফর্ম-প্যানেল ── -->
    <main class="as-form-panel">
      <div class="as-form-card">
        <a href="/" class="back-home"><i class="fas fa-arrow-left"></i> হোম</a>

        <h1 class="as-title">স্বাগতম</h1>
        <p class="as-sub">আপনার অ্যাকাউন্টে লগইন করুন</p>

        <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

        <div class="as-tabs" role="tablist" aria-label="লগইন বা আইডি খুঁজুন">
          <button type="button" class="as-tab is-active" data-tab="login" role="tab" aria-selected="true" aria-controls="tabpanel-login">লগইন</button>
          <button type="button" class="as-tab" data-tab="find" role="tab" aria-selected="false" aria-controls="tabpanel-find">আইডি খুঁজুন</button>
        </div>

        <!-- ── ট্যাব ১: স্ট্যান্ডার্ড লগইন ── -->
        <section class="as-tabpanel is-active" id="tabpanel-login" role="tabpanel">
          <form method="POST" class="as-loading-form" data-submit-label='<i class="fas fa-sign-in-alt"></i> লগ ইন'>
            <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
            <div class="ff">
              <input type="text" id="loginUser" name="username" required autofocus autocomplete="username" placeholder=" " aria-label="মেম্বার আইডি, ইমেইল বা ব্যবহারকারী নাম">
              <label for="loginUser">মেম্বার আইডি, ইমেইল বা ব্যবহারকারী নাম</label>
            </div>
            <div class="ff has-toggle">
              <input type="password" id="loginPass" name="password" required autocomplete="current-password" placeholder=" " aria-label="পাসওয়ার্ড">
              <label for="loginPass">পাসওয়ার্ড</label>
              <button type="button" class="pw-toggle" aria-label="পাসওয়ার্ড দেখান"><i class="far fa-eye"></i></button>
            </div>
            <div class="ff">
              <input type="text" id="loginTotp" name="totp_code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder=" " aria-label="2FA কোড, সক্রিয় থাকলে">
              <label for="loginTotp">2FA কোড (সক্রিয় থাকলে)</label>
            </div>
            <p class="mc-forgot">পাসওয়ার্ড ভুলে গেছেন? <a href="/forgot-password">রিসেট করুন</a></p>
            <button type="submit" class="btn-primary"><i class="fas fa-sign-in-alt"></i> লগ ইন</button>
          </form>
          <p class="as-foot">অ্যাকাউন্ট নেই? <a href="/register">রেজিস্ট্রেশন করুন</a></p>
        </section>

        <!-- ── ট্যাব ২: প্রোফাইল খুঁজুন / ক্লেইম ── -->
        <section class="as-tabpanel" id="tabpanel-find" role="tabpanel">
          <div class="mc-section">
            <h2 class="mc-section-title"><i class="fas fa-search"></i> আপনার আইডি খুঁজুন</h2>
            <p class="mc-hint">আগে থেকে আপনার একটা প্রোফাইল থাকতে পারে। নাম ও মেম্বার আইডি দিয়ে খুঁজুন।</p>
            <div class="ff">
              <input type="text" id="mcName" placeholder=" " aria-label="নাম">
              <label for="mcName">নাম</label>
            </div>
            <div class="ff">
              <input type="text" id="mcId" placeholder=" " style="text-transform:uppercase;" aria-label="মেম্বার আইডি">
              <label for="mcId">মেম্বার আইডি</label>
            </div>
            <button type="button" id="mcFindBtn" class="btn-secondary"><i class="fas fa-magnifying-glass"></i> আপনার আইডি খুঁজুন</button>
            <div id="mcResult" class="mc-result" role="status" aria-live="polite"></div>
            <p class="mc-foot">প্রি-ক্রিয়েটেড আইডি নেই? <a href="/register">নতুন করে প্রোফাইল তৈরী করুন</a></p>
          </div>
        </section>

      </div>
    </main>
  </div>

  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/auth.js?v=<%= AV %>"></script>
  <script>
  (function () {
    var btn = document.getElementById('mcFindBtn');
    if (!btn) return;
    var result = document.getElementById('mcResult');
    function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
    function busy(b){ btn.disabled = b; btn.innerHTML = b ? '<i class="fas fa-spinner fa-spin"></i> খুঁজছি...' : '<i class="fas fa-magnifying-glass"></i> আপনার আইডি খুঁজুন'; }
    btn.addEventListener('click', function () {
      var name = document.getElementById('mcName').value.trim();
      var mid = document.getElementById('mcId').value.trim();
      if (!mid) { result.innerHTML = '<div class="mc-msg err"><i class="fas fa-exclamation-circle"></i> মেম্বার আইডি দিন</div>'; return; }
      busy(true);
      fetch('/api/member-accounts/find', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify({ name: name, memberId: mid }) })
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (!d || d.ok === false) throw new Error((d && d.error) || 'খুঁজতে সমস্যা হয়েছে');
          if (!d.found) {
            result.innerHTML = '<div class="mc-msg warn"><i class="fas fa-circle-info"></i> ' + esc(d.error || 'এই মেম্বার আইডির জন্য কোনো প্রি-ক্রিয়েটেড প্রোফাইল পাওয়া যায়নি।') + '</div>' +
              '<p class="mc-foot">প্রি-ক্রিয়েটেড প্রোফাইল নেই? <a href="/register">নতুন করে প্রোফাইল তৈরী করুন</a></p>';
            return;
          }
          if (d.nameMatches === false) {
            result.innerHTML = '<div class="mc-msg warn"><i class="fas fa-user-slash"></i> ' + esc(d.error || 'নাম মিলছে না') + '</div>';
            return;
          }
          var m = d.member;
          var html = '<div class="mc-found">' +
            '<div class="mc-found-title"><i class="fas fa-id-card"></i> আমরা একটা প্রোফাইল খুঁজে পেয়েছি যেটা আপনার হতে পারে।</div>' +
            '<div class="mc-card">' +
              (m.photo ? '<img class="mc-avatar" src="'+esc(m.photo)+'" alt="">' : '<span class="mc-avatar mc-avatar-empty"><i class="fas fa-user"></i></span>') +
              '<div class="mc-meta">' +
                '<div class="mc-name">'+esc(m.name)+'</div>' +
                '<div class="mc-id">মেম্বার আইডি: '+esc(m.memberId)+'</div>' +
                (d.categoryLabel ? '<div class="mc-line">'+esc(d.categoryLabel)+'</div>' : '') +
                (m.position ? '<div class="mc-line">'+esc(m.position)+'</div>' : '') +
                (m.department ? '<div class="mc-line">'+esc(m.department)+'</div>' : '') +
                (m.session ? '<div class="mc-line">কার্যবর্ষ: '+esc(m.session)+'</div>' : '') +
              '</div>' +
            '</div>';
          if (d.status === 'claimed' || d.alreadyClaimed) {
            html += '<div class="mc-msg warn"><i class="fas fa-lock"></i> এই প্রোফাইলটি ইতিমধ্যে সক্রিয় করা হয়েছে। অনুগ্রহ করে লগইন করুন অথবা পাসওয়ার্ড রিসেট ব্যবহার করুন।</div>';
          } else if (d.status === 'pending') {
            html += '<div class="mc-msg warn"><i class="fas fa-hourglass-half"></i> এই প্রোফাইলের জন্য একটি আবেদন পর্যালোচনায় আছে।</div>';
          } else {
            html += '<div class="mc-question">এটা কি আপনার প্রোফাইল?</div>' +
              '<a class="btn-primary mc-btn" href="/claim?memberId='+encodeURIComponent(m.memberId)+'&name='+encodeURIComponent(m.name)+'"><i class="fas fa-check"></i> হ্যাঁ, এটা আমি। আইডি ক্লেইম করুন</a>';
          }
          html += '</div>';
          result.innerHTML = html;
        })
        .catch(function(e){ result.innerHTML = '<div class="mc-msg err"><i class="fas fa-exclamation-triangle"></i> ' + esc(e.message || 'নেটওয়ার্ক সমস্যা') + '</div>'; })
        .finally(function(){ busy(false); });
    });
  })();
  </script>
</body>
</html>
