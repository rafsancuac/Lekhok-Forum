<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

  <meta charset="UTF-8" />
  <title>লগইন | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css" />
</head>
<body>
  <div class="auth-card">
    <a href="/" class="back-home"><i class="fas fa-arrow-left"></i> হোম</a>
    <div class="auth-brand">
      <span class="auth-logo"><i class="fas fa-feather-alt"></i></span>
      <span class="auth-brand-name">লেখক ফোরাম</span>
    </div>
    <h1 class="auth-title">স্বাগতম</h1>
    <p class="auth-sub">আপনার অ্যাকাউন্টে লগইন করুন</p>
    <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
    <form method="POST">
      <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
      <div class="form-group">
        <label>ব্যবহারকারী নাম বা ইমেইল</label>
        <input type="text" name="username" required autofocus>
      </div>
      <div class="form-group">
        <label>পাসওয়ার্ড</label>
        <input type="password" name="password" required>
      </div>
      <button type="submit" class="btn-primary"><i class="fas fa-sign-in-alt"></i> লগইন</button>
    </form>
    <p class="auth-foot">অ্যাকাউন্ট নেই? <a href="/register">রেজিস্ট্রেশন করুন</a></p>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
