<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

  <meta charset="UTF-8" />
  <title>রেজিস্ট্রেশন | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/premium.css?v=<%= AV %>" />
</head>
<body class="auth-split" data-auth="0">
  <div class="as-shell">

    <!-- ── বাম ব্র্যান্ড-প্যানেল ── -->
    <aside class="as-brand">
      <div class="as-brand-top">
        <span class="as-logo"><i class="fas fa-feather-alt"></i></span>
        <span class="as-brand-name">লেখক ফোরাম</span>
      </div>
      <div class="as-brand-mid">
        <p class="as-eyebrow">চট্টগ্রাম বিশ্ববিদ্যালয়</p>
        <h2 class="as-tagline">লেখক ফোরাম</h2>
        <p class="as-intro">শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটানোই আমাদের প্রত্যয়।</p>
        <ul class="as-brand-points">
          <li><i class="fas fa-pen-nib"></i> নিজের লেখা প্রকাশ করুন</li>
          <li><i class="fas fa-users"></i> লেখক-পাঠক কমিউনিটিতে যুক্ত হোন</li>
          <li><i class="fas fa-award"></i> কার্যক্রম ও প্রতিযোগিতায় অংশ নিন</li>
        </ul>
      </div>
      <div class="as-brand-bottom">© ২০২৬ লেখক ফোরাম। সর্বস্বত্ব সংরক্ষিত।</div>
    </aside>

    <!-- ── ডান ফর্ম-প্যানেল ── -->
    <main class="as-form-panel">
      <div class="as-form-card wide">
        <a href="/" class="back-home"><i class="fas fa-arrow-left"></i> হোম</a>

        <h1 class="as-title">নতুন অ্যাকাউন্ট খুলুন</h1>
        <p class="as-sub">লিখুন, শেয়ার করুন, সংযুক্ত হোন</p>

        <div class="reg-required-hint">
          <i class="fas fa-circle-info"></i>
          শুধুমাত্র <b>*</b> চিহ্নিত ঘরগুলো পূরণ করা আবশ্যক; বাকিগুলো ঐচ্ছিক।
        </div>

        <% if (error) { %><div class="error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

        <form method="POST" enctype="multipart/form-data" action="/register<%= (typeof csrfToken !== 'undefined' && csrfToken) ? '?_csrf=' + csrfToken : '' %>" class="as-loading-form" data-submit-label='<i class="fas fa-user-plus"></i> রেজিস্ট্রেশন সম্পূর্ণ করুন' id="regForm">

          <!-- ═══ ১. অ্যাকাউন্ট তথ্য ═══ -->
          <h3 class="auth-section-title"><i class="fas fa-user-shield"></i> অ্যাকাউন্ট তথ্য</h3>
          <div class="form-row">
            <div class="ff">
              <input type="text" id="regUser" name="username" value="<%= form.username || '' %>" required placeholder=" " autocomplete="username" autocapitalize="none" spellcheck="false">
              <label for="regUser">ব্যবহারকারী নাম *</label>
            </div>
            <div class="ff has-toggle">
              <input type="password" id="regPass" name="password" required minlength="6" placeholder=" " autocomplete="new-password" data-strength="1">
              <label for="regPass">পাসওয়ার্ড *</label>
              <button type="button" class="pw-toggle" aria-label="পাসওয়ার্ড দেখান"><i class="far fa-eye"></i></button>
            </div>
          </div>
          <div class="pw-meter" id="pwMeter" aria-hidden="true">
            <div class="pw-meter-bar"><span></span></div>
            <div class="pw-meter-txt" id="pwMeterTxt">কমপক্ষে ৬ অক্ষর</div>
          </div>
          <p class="field-hint"><i class="fas fa-lightbulb"></i> ইউজারনেম ছোট হাতের ইংরেজি অক্ষর/সংখ্যা, স্পেস ছাড়া।</p>

          <!-- ═══ ২. ব্যক্তিগত তথ্য ═══ -->
          <h3 class="auth-section-title"><i class="fas fa-id-card"></i> ব্যক্তিগত তথ্য</h3>
          <div class="ff">
            <input type="text" id="regName" name="full_name" value="<%= form.full_name || '' %>" required placeholder=" " autocomplete="name">
            <label for="regName">পূর্ণ নাম *</label>
          </div>
          <div class="form-row">
            <div class="ff">
              <input type="email" id="regEmail" name="email" value="<%= form.email || '' %>" placeholder=" " autocomplete="email">
              <label for="regEmail">ইমেইল</label>
            </div>
            <div class="ff">
              <input type="tel" id="regPhone" name="phone" value="<%= form.phone || '' %>" placeholder=" " autocomplete="tel">
              <label for="regPhone">মোবাইল</label>
            </div>
          </div>
          <div class="form-row">
            <div class="ff-static">
              <label for="regGender">লিঙ্গ</label>
              <select id="regGender" name="gender">
                <option value="male">পুরুষ</option>
                <option value="female">নারী</option>
                <option value="other">অন্যান্য</option>
              </select>
            </div>
            <div class="ff-static">
              <label for="regBirth">জন্ম তারিখ</label>
              <input type="date" id="regBirth" name="birth_date" value="<%= form.birth_date || '' %>">
            </div>
          </div>
          <div class="ff-static file-field">
            <label for="regAvatar">প্রোফাইল ছবি (ঐচ্ছিক)</label>
            <label class="file-drop" for="regAvatar">
              <i class="fas fa-cloud-arrow-up"></i>
              <span id="regAvatarTxt">ছবি বাছাই করুন বা এখানে ক্লিক করুন (না দিলে লিঙ্গ অনুযায়ী ডেমো ছবি বসবে)</span>
            </label>
            <input type="file" id="regAvatar" name="avatar" accept="image/*">
          </div>

          <!-- ═══ ৩. প্রাতিষ্ঠানিক তথ্য ═══ -->
          <h3 class="auth-section-title"><i class="fas fa-building-columns"></i> প্রাতিষ্ঠানিক তথ্য <span class="opt-tag">ঐচ্ছিক</span></h3>
          <div class="ff">
            <input type="text" id="regDesig" name="designation" value="<%= form.designation || '' %>" placeholder=" " >
            <label for="regDesig">পদবি / সংক্ষিপ্ত পরিচয়</label>
          </div>
          <div class="form-row">
            <div class="ff">
              <input type="text" id="regDept" name="department" value="<%= form.department || '' %>" placeholder=" ">
              <label for="regDept">ডিপার্টমেন্ট / প্রতিষ্ঠান</label>
            </div>
            <div class="ff">
              <input type="text" id="regSession" name="session" value="<%= form.session || '' %>" placeholder=" ">
              <label for="regSession">কার্যবর্ষ / সেশন</label>
            </div>
          </div>
          <div class="ff">
            <input type="text" id="regAddr" name="address" value="<%= form.address || '' %>" placeholder=" " autocomplete="street-address">
            <label for="regAddr">ঠিকানা</label>
          </div>
          <div class="ff-static">
            <label for="regBio">সংক্ষিপ্ত বায়ো</label>
            <textarea id="regBio" name="bio" rows="3" maxlength="500"><%= form.bio || '' %></textarea>
            <div class="char-counter" id="bioCounter">০ / ৫০০</div>
          </div>

          <!-- ═══ ৪. সোশ্যাল মিডিয়া (কলাপ্সিবল) ═══ -->
          <details class="social-details">
            <summary><i class="fas fa-share-nodes"></i> সোশ্যাল মিডিয়া লিংক <span class="opt-tag">ঐচ্ছিক</span><i class="fas fa-chevron-down chev"></i></summary>
            <div class="social-details-body">
              <div class="form-row">
                <div class="ff">
                  <input type="url" id="regFb" name="social_fb" value="<%= form.social_fb || '' %>" placeholder=" " autocapitalize="none">
                  <label for="regFb"><i class="fab fa-facebook"></i> Facebook</label>
                </div>
                <div class="ff">
                  <input type="url" id="regTw" name="social_twitter" value="<%= form.social_twitter || '' %>" placeholder=" " autocapitalize="none">
                  <label for="regTw"><i class="fab fa-twitter"></i> Twitter / X</label>
                </div>
              </div>
              <div class="form-row">
                <div class="ff">
                  <input type="url" id="regLi" name="social_linkedin" value="<%= form.social_linkedin || '' %>" placeholder=" " autocapitalize="none">
                  <label for="regLi"><i class="fab fa-linkedin"></i> LinkedIn</label>
                </div>
                <div class="ff">
                  <input type="url" id="regWeb" name="social_website" value="<%= form.social_website || '' %>" placeholder=" " autocapitalize="none">
                  <label for="regWeb"><i class="fas fa-globe"></i> ওয়েবসাইট</label>
                </div>
              </div>
            </div>
          </details>

          <button type="submit" class="btn-primary"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন সম্পূর্ণ করুন</button>
        </form>
        <p class="as-foot">ইতিমধ্যে অ্যাকাউন্ট আছে? <a href="/login">লগইন করুন</a></p>
      </div>
    </main>
  </div>

  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/auth.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
