<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>বিজ্ঞপ্তি — মডারেটর প্যানেল</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="stylesheet" href="/assets/css/fonts.css" />
  <link rel="stylesheet" href="/assets/css/dashboard.css" />
  <style>
    .mod-wrap { max-width: 760px; margin: 20px auto; padding: 0 16px; }
    .mod-form { background:#fff; border-radius:12px; padding:22px; margin-bottom:20px; }
    .mod-form input, .mod-form textarea, .mod-form select { width:100%; padding:10px 12px; border:1px solid #ddd; border-radius:8px; margin-bottom:12px; font-family:inherit; }
    .mod-item { background:#fff; border-radius:10px; padding:14px 16px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <div class="mod-wrap">
    <p><a href="/moderator"><i class="fas fa-arrow-right"></i> মডারেটর প্যানেলে ফিরুন</a></p>
    <h2><i class="fas fa-bullhorn"></i> বিজ্ঞপ্তি পোস্ট করুন</h2>
    <% if (typeof posted !== 'undefined') { %><p style="color:#166534;">✓ সফলভাবে পোস্ট হয়েছে এবং সব ইউজারকে নোটিফিকেশন পাঠানো হয়েছে।</p><% } %>
    <form method="POST" action="/moderator/notices" class="mod-form">
      <label>শিরোনাম</label>
      <input type="text" name="title" required>
      <label>বিস্তারিত</label>
      <textarea name="content" rows="4"></textarea>
      <label>ক্যাটাগরি</label>
      <select name="category">
        <option value="notice">সাধারণ বিজ্ঞপ্তি</option>
        <option value="urgent">জরুরি</option>
        <option value="event">ইভেন্ট সংক্রান্ত</option>
      </select>
      <label>তারিখ</label>
      <input type="date" name="date">
      <button class="btn btn-primary" type="submit">পোস্ট করুন</button>
    </form>
    <h3>সাম্প্রতিক বিজ্ঞপ্তি</h3>
    <% notices.forEach(n => { %>
      <div class="mod-item">
        <div><strong><%= n.title %></strong><div style="color:#999; font-size:0.85rem;"><%= n.date %></div></div>
        <form method="POST" action="/moderator/notices/<%= n.id %>?_method=DELETE" onsubmit="return confirm('মুছে ফেলতে চান?')">
          <button class="btn btn-danger btn-sm" type="submit">মুছুন</button>
        </form>
      </div>
    <% }) %>
  </div>
  <script src="/assets/js/main.js"></script>
</body>
</html>
