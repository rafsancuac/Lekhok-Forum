<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'ব্যক্তিগত ফিড | লেখক ফোরাম' }) %>

  <div class="me-wrap">
    <header class="me-header">
      <div class="me-header-inner">
        <img loading="lazy" decoding="async" src="<%= user.avatar_url || '/avatar/' + user.id %>" class="avatar-xl" onerror="this.onerror=null;this.src='/avatar/<%= user.id %>'" style="border-radius:50%">
        <div class="me-id">
          <h1><%= user.full_name %></h1>
          <p class="me-handle"><%= user.designation || 'লেখক ফোরাম সদস্য' %></p>
          <%# সেশন ১১৮ (ইউজার-স্পেক): বক্স-বিহীন ইন-লাইন মেটা-স্ট্রিপ — তথ্যের পুনরাবৃত্তি রোধে
              ৭-সাদা-বক্স (stats-grid) বিলোপের বদলে হেডারেই FB-ঘরানার কাউন্টার-লাইন %>
          <p class="me-meta118">
            <b><%= bn91(stats.posts) %></b>টি লেখা
            <span aria-hidden="true"> • </span><b><%= bn91(stats.followers) %></b> জন অনুসারী
            <span aria-hidden="true"> • </span><b><%= bn91(stats.reactions) %></b>টি প্রতিক্রিয়া
          </p>
          <% if (user.bio) { %><p class="me-bio"><%= user.bio %></p><% } %>
        </div>
        <div class="me-actions">
          <a href="/articles/new" class="btn btn-primary"><i class="fas fa-pen-nib"></i> নতুন লেখা</a>
          <a href="/profile/<%= user.username %>" class="btn btn-ghost"><i class="fas fa-user"></i> প্রোফাইল</a>
        </div>
      </div>
    </header>

    <%# ═══ সেশন ১১৮ (ইউজার-স্পেক): ৭টি আলাদা সাদা stat-tile বক্স সম্পূর্ণ বিলোপ —
        কাউন্টগুলো এখন নিচের FB-স্টাইল ট্যাব-বারের ব্যাজে ও হেডারের মেটা-স্ট্রিপে ═══ %>

    <%# ═══ সেশন ১১৮ (ইউজার-স্পেক): লেখা-স্ট্যাটিসটিক্স রিডিজাইন —
        ৪টি KPI-বক্স ও বিশাল ফাঁকা চার্ট-কন্টেইনার বিলোপ → একক স্লিম ইনসাইটস-স্ট্রিপ
        (হেডার-রো + ইন-লাইন ৪-সেল ডিভাইডার-স্ট্রিপ + কলাপ্সেবল স্লিম-বার-চার্ট) ═══ %>
    <div class="ws91-card" aria-label="পারফরম্যান্স ও প্রকাশনা ইনসাইটস">
      <div class="ws91-head">
        <h2><i class="fas fa-chart-column"></i> পারফরম্যান্স ও প্রকাশনা ইনসাইটস</h2>
        <span class="ws91-sub">বিগত ৬ মাসের সারাংশ</span>
        <button type="button" class="ws91-toggle" id="ws91Toggle" aria-expanded="true" aria-controls="ws91ChartBody">
          <span id="ws91ToggleTxt">চার্ট লুকান</span> <i class="fas fa-chevron-up" id="ws91ToggleIco"></i>
        </button>
      </div>

      <%# ইন-লাইন স্ট্যাটাস-স্ট্রিপ — আলাদা ৪টি বক্সের বদলে একক ডিভাইডার-রো %>
      <div class="ws118-strip">
        <div class="ws118-cell">
          <span>মোট পাঠ</span>
          <b><%= bn91(totals91.views) %> বার</b>
        </div>
        <div class="ws118-cell">
          <span>মোট প্রতিক্রিয়া</span>
          <b><%= bn91(totals91.likes) %>টি</b>
        </div>
        <div class="ws118-cell">
          <span>মন্তব্য প্রাপ্তি</span>
          <b><%= bn91(totals91.comments) %>টি</b>
        </div>
        <% if (bestPost91) { %>
          <a class="ws118-cell" href="/<%= bestPost91.type === 'question' ? 'qa' : 'articles' %>/<%= bestPost91.id %>" title="<%= bestPost91.title %>">
            <span>সেরা লেখা</span>
            <b><%= bestPost91.title.length > 30 ? bestPost91.title.slice(0, 30) + '…' : bestPost91.title %></b>
          </a>
        <% } else { %>
          <div class="ws118-cell">
            <span>সেরা লেখা</span>
            <b>—</b>
          </div>
        <% } %>
      </div>

      <%# স্লিম বার-চার্ট — পূর্ণাঙ্গ মাসের নাম, সর্বোচ্চ ৬৬px বার, শূন্য-মাসে ধূসর-স্টাব (SVG-বক্স নয়) %>
      <div class="ws91-chart-wrap" id="ws91ChartBody">
        <% if (monthly91.length) {
             const maxC118 = Math.max.apply(null, monthly91.map(m => m.count).concat([1]));
        %>
        <div class="ws118-chart" role="img" aria-label="মাসিক প্রকাশনা-গ্রাফ — বিগত ৬ মাস">
          <% monthly91.forEach(function (m118, i118) {
               const pct118 = m118.count > 0 ? Math.max(10, Math.round((m118.count / maxC118) * 100)) : 0;
          %>
            <div class="ws118-col" title="<%= m118.label %>: <%= bn91(m118.count) %>টি লেখা">
              <span class="ws118-num"><%= m118.count > 0 ? bn91(m118.count) : '' %></span>
              <div class="ws118-track">
                <div class="ws118-bar<%= m118.count > 0 ? '' : ' zero' %>"
                     style="height:<%= m118.count > 0 ? pct118 : 0 %>%;animation-delay:<%= i118 * 60 %>ms"></div>
              </div>
              <span class="ws118-month"><%= m118.label %></span>
            </div>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>

    <%# সেশন ১১৮ (ইউজার-স্পেক): FB-প্রোফাইল-ঘরানার সিঙ্গেল-লাইন ট্যাব-বার —
        সাদা stat-বক্সের কাউন্টগুলো এখন ট্যাবের ভেতরে পিল-ব্যাজে; অ্যাক্টিভ = সবুজ-আন্ডারলাইন %>
    <div class="personal-tabs" role="tablist" aria-label="আমার কনটেন্ট-ট্যাব">
      <button class="personal-tab active" data-tab="posts"><span>লেখা</span><span class="pt-count"><%= bn91(stats.posts) %></span></button>
      <button class="personal-tab" data-tab="drafts"><span>ড্রাফট</span><span class="pt-count"><%= bn91(stats.drafts) %></span></button>
      <button class="personal-tab" data-tab="comments"><span>মন্তব্য</span><span class="pt-count"><%= bn91(stats.comments) %></span></button>
      <button class="personal-tab" data-tab="reactions"><span>প্রতিক্রিয়া</span><span class="pt-count"><%= bn91(stats.reactions) %></span></button>
      <button class="personal-tab" data-tab="bookmarks"><span>সংরক্ষিত</span><span class="pt-count"><%= bn91(stats.bookmarks) %></span></button>
      <button class="personal-tab" data-tab="following"><span>অনুসরণ</span><span class="pt-count"><%= bn91(stats.following) %></span></button>
      <button class="personal-tab" data-tab="followers"><span>অনুসারী</span><span class="pt-count"><%= bn91(stats.followers) %></span></button>
      <button class="personal-tab" data-tab="activity"><span>অ্যাক্টিভিটি</span></button>
      <button class="personal-tab" data-tab="categories"><span>ক্যাটাগরি</span></button>
    </div>

    <!-- Tab: Posts -->
    <section class="me-tab" data-pane="posts">
      <% if (myPosts.length === 0) { %>
        <div class="empty">
          <div class="icon"><i class="fas fa-pen-nib"></i></div>
          <h3>এখনো কোনো লেখা নেই</h3>
          <p>আপনার প্রথম লেখাটি লিখুন।</p>
          <a href="/articles/new" class="btn btn-primary">নতুন লেখা শুরু করুন</a>
        </div>
      <% } %>
      <% myPosts.forEach(p => { %>
        <%# সেশন ১০৫: ক্যানোনিকাল FeedPostCard — /me-তেও ফিড/প্রোফাইলের সমান পোস্ট-কার্ড %>
        <%- include('../shared/post/FeedPostCard', { item: p, user: user, myBookmarkedIds: [], opts: { profileMode: true, showDrawer: true } }) %>
      <% }) %>
    </section>

    <!-- Tab: Comments -->
    <section class="me-tab" data-pane="comments" hidden>
      <% if (myComments.length === 0) { %>
        <div class="empty"><div class="icon"><i class="far fa-comment"></i></div><h3>কোনো মন্তব্য নেই</h3><p>অন্যের লেখায় মন্তব্য করুন।</p></div>
      <% } %>
      <% myComments.forEach(c => { %>
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge"><%= c.post_type === 'question' ? 'প্রশ্নে' : 'লেখায়' %></span>
              <span><i class="far fa-clock"></i> <%= new Date(c.created_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= c.post_type === 'question' ? '/qa/' + c.post_id : '/articles/' + c.post_id %>"><%= c.post_title %></a></h3>
            <p class="feed-card-excerpt"><%= mdPlain(c.body, 200) %></p>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Reactions -->
    <section class="me-tab" data-pane="reactions" hidden>
      <% if (myReactions.length === 0) { %>
        <div class="empty"><div class="icon"><i class="far fa-heart"></i></div><h3>কোনো প্রতিক্রিয়া নেই</h3><p>পোস্টে ❤️ বা 👍 দিয়ে শুরু করুন।</p></div>
      <% } %>
      <% myReactions.forEach(r => { %>
        <article class="feed-card">
          <% if (r.cover_image) { %><img loading="lazy" decoding="async" src="<%= r.cover_image %>" class="feed-card-cover" alt=""><% } %>
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge">
                <% const emo = { like: '👍', love: '❤️', care: '🤗', haha: '😂', wow: '😮', sad: '😢', angry: '😡' }; %>
                <%= emo[r.reaction_type] || '👍' %> <%= r.reaction_type %>
              </span>
              <span><i class="far fa-clock"></i> <%= new Date(r.created_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= r.post_type === 'question' ? '/qa/' + r.post_id : '/articles/' + r.post_id %>"><%= r.title %></a></h3>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Bookmarks -->
    <section class="me-tab" data-pane="bookmarks" hidden>
      <% if (myBookmarks.length === 0) { %>
        <div class="empty"><div class="icon"><i class="far fa-bookmark"></i></div><h3>কোনো সংরক্ষিত পোস্ট নেই</h3><p>পছন্দের লেখা 📌 করে রাখুন।</p></div>
      <% } %>
      <% myBookmarks.forEach(b => { %>
        <article class="feed-card">
          <% if (b.cover_image) { %><img loading="lazy" decoding="async" src="<%= b.cover_image %>" class="feed-card-cover" alt=""><% } %>
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge <%= b.type === 'question' ? 'badge-muted' : '' %>"><%= b.type === 'question' ? 'প্রশ্ন' : 'লেখা' %></span>
              <span><i class="far fa-clock"></i> <%= new Date(b.bookmarked_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= b.type === 'question' ? '/qa/' + b.id : '/articles/' + b.id %>"><%= b.title %></a></h3>
            <% if (b.display_excerpt) { %><p class="feed-card-excerpt"><%= b.display_excerpt %></p><% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Following -->
    <section class="me-tab" data-pane="following" hidden>
      <% if (following.length === 0) { %>
        <div class="empty"><div class="icon"><i class="fas fa-user-friends"></i></div><h3>কাউকে অনুসরণ করছেন না</h3><p>সদস্যদের অনুসরণ করুন, তাদের নতুন লেখা এখানে দেখুন।</p></div>
      <% } %>
      <div class="follow-grid">
        <% following.forEach(f => { %>
          <a href="/profile/<%= f.username %>" class="follow-card">
            <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="avatar-md" style="border-radius:50%" onerror="this.onerror=null;this.src='/avatar/<%= f.id %>'">
            <strong><%= f.full_name %></strong>
            <small><%= f.designation || 'সদস্য' %></small>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- Tab: Followers (সেশন ১১৮ — FB-ট্যাব-বারের 'অনুসারী' ব্যাজের পেন) -->
    <section class="me-tab" data-pane="followers" hidden>
      <% if (myFollowers.length === 0) { %>
        <div class="empty"><div class="icon"><i class="fas fa-users"></i></div><h3>এখনো কোনো অনুসারী নেই</h3><p>নিয়মিত লিখলে পাঠক আপনাকে অনুসরণ করবে।</p></div>
      <% } %>
      <div class="follow-grid">
        <% myFollowers.forEach(f => { %>
          <a href="/profile/<%= f.username %>" class="follow-card">
            <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="avatar-md" style="border-radius:50%" onerror="this.onerror=null;this.src='/avatar/<%= f.id %>'">
            <strong><%= f.full_name %></strong>
            <small><%= f.designation || 'সদস্য' %></small>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- Tab: Activity (chronological) -->
    <section class="me-tab" data-pane="activity" hidden>
      <% if (activity.length === 0) { %>
        <div class="empty"><div class="icon"><i class="fas fa-stream"></i></div><h3>কোনো অ্যাক্টিভিটি নেই</h3><p>লিখুন, মন্তব্য করুন, প্রতিক্রিয়া দিন, সব এখানে জমা হবে।</p></div>
      <% } %>
      <% const _emo = { like: '👍', love: '❤️', care: '🤗', haha: '😂', wow: '😮', sad: '😢', angry: '😡' }; %>
      <% activity.forEach(a => { %>
        <article class="feed-card activity-card">
          <span class="activity-icon <%= a.kind %>">
            <% if (a.kind === 'posted') { %><i class="fas fa-pen-nib"></i><% }
               else if (a.kind === 'commented') { %><i class="far fa-comment"></i><% }
               else if (a.kind === 'reacted') { %><span class="act-emoji"><%= _emo[a.reaction] || '👍' %></span><% }
               else { %><i class="fas fa-bookmark"></i><% } %>
          </span>
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge badge-muted">
                <% if (a.kind === 'posted') { %>পোস্ট করেছেন<% }
                   else if (a.kind === 'commented') { %>মন্তব্য করেছেন<% }
                   else if (a.kind === 'reacted') { %>প্রতিক্রিয়া দিয়েছেন<% }
                   else { %>সংরক্ষণ করেছেন<% } %>
              </span>
              <span><i class="far fa-clock"></i> <%= new Date(a.at).toLocaleString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= a.type === 'question' ? '/qa/' + a.id : '/articles/' + a.id %>"><%= a.title %></a></h3>
            <% if (a.body) { %><p class="feed-card-excerpt"><%= mdPlain(a.body, 140) %></p><% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Categories (my interests) -->
    <section class="me-tab" data-pane="categories" hidden>
      <div class="card interest-picker">
        <h3><i class="fas fa-tags"></i> আমার আগ্রহের বিষय</h3>
        <p class="side-text">বিষয় বাছলে কমিউনিটি ফিড আপনার পছন্দ অনুযায়ী সাজানো হবে।</p>
        <div class="tag-cloud" id="interestPool">
          <% tagPool.forEach(t => { %>
            <button type="button" class="tag-chip interest-opt <%= myInterests.includes(t.tag) ? 'selected' : '' %>" data-tag="<%= t.tag %>">#<%= t.tag %></button>
          <% }); %>
          <% if (tagPool.length === 0) { %><span class="side-text">এখনো কোনো ট্যাগ পুল নেই।</span><% } %>
        </div>
        <button type="button" class="btn btn-primary" id="saveInterests"><i class="fas fa-save"></i> সংরক্ষণ করুন</button>
      </div>
    </section>

    <!-- Tab: Drafts (সেশন ১১৮: ট্যাব-ব্যাজ সবসময় দেখায় — তাই পেনও সবসময় রেন্ডার) -->
    <section class="me-tab" data-pane="drafts" hidden>
      <% if (myDrafts.length === 0) { %>
        <div class="empty"><div class="icon"><i class="fas fa-file"></i></div><h3>কোনো খসড়া নেই</h3><p>অসমাপ্ত লেখা এখানে জমা থাকবে।</p></div>
      <% } %>
      <% myDrafts.forEach(d => { %>
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge badge-muted">ড্রাফট</span>
              <span><i class="far fa-clock"></i> <%= new Date(d.created_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><%= d.title || 'শিরোনামহীন ড্রাফট' %></h3>
          </div>
        </article>
      <% }) %>
    </section>
  </div>

  <%- include('../partials/footer') %>

  <script>
    document.querySelectorAll('.personal-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        document.querySelectorAll('.personal-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        document.querySelectorAll('.me-tab').forEach(p => p.hidden = p.dataset.pane !== target);
      });
    });
    // সেশন ১১৮: ইনসাইটস-চার্ট টগল — চার্ট লুকান/দেখুন (aria-expanded সিঙ্ক)
    (function () {
      const tgl = document.getElementById('ws91Toggle');
      if (!tgl) return;
      const body = document.getElementById('ws91ChartBody');
      const txt = document.getElementById('ws91ToggleTxt');
      const ico = document.getElementById('ws91ToggleIco');
      tgl.addEventListener('click', () => {
        const show = body.hidden;
        body.hidden = !show;
        tgl.setAttribute('aria-expanded', String(show));
        txt.textContent = show ? 'চার্ট লুকান' : 'চার্ট দেখুন';
        ico.className = show ? 'fas fa-chevron-up' : 'fas fa-chevron-down';
      });
    })();
    // Deep-link ?tab=x
    const urlTab = new URLSearchParams(location.search).get('tab');
    if (urlTab) document.querySelector('.personal-tab[data-tab="' + urlTab + '"]')?.click();
    // Interest picker
    document.querySelectorAll('.interest-opt').forEach(chip => {
      chip.addEventListener('click', () => chip.classList.toggle('selected'));
    });
    document.getElementById('saveInterests')?.addEventListener('click', async function () {
      const tags = [...document.querySelectorAll('.interest-opt.selected')].map(c => c.dataset.tag);
      const res = await fetch('/api/me/interests', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tags })
      });
      if (res.ok) { if (window.showToast) showToast('আগ্রহের বিষয় সংরক্ষিত হয়েছে', 'success'); setTimeout(() => location.reload(), 800); }
    });
  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <%# সেশন ১০৫: ক্যানোনিকাল কম্পোনেন্ট-ইঞ্জিন + রিঅ্যাক্টরস-মডাল %>
  <script src="/assets/js/comment-tools.js?v=<%= AV %>"></script>
  <%- include('../shared/post/ReactorsModal') %>
</body>
</html>
