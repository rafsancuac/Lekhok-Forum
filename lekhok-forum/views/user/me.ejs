<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'ব্যক্তিগত ফিড | লেখক ফোরাম' }) %>

  <div class="me-wrap">
    <header class="me-header">
      <div class="me-header-inner">
        <img loading="lazy" decoding="async" src="<%= user.avatar_url || '/avatar/' + user.id %>" class="avatar-xl" onerror="this.onerror=null;this.src='/avatar/<%= user.id %>'" style="border-radius:50%">
        <div class="me-id">
          <h1><%= user.full_name %><span class="me-role-chip"><%= user.designation || 'লেখক সদস্য' %></span></h1>
          <p class="me-handle me-stats-line"><i class="fas fa-user-friends" aria-hidden="true"></i> <%= bn91(stats.followers) %> জন অনুসারী · <%= bn91(stats.following) %> জনকে অনুসরণ করছেন</p>
          <% if (user.bio) { %><p class="me-bio"><%= user.bio %></p><% } %>
        </div>
        <div class="me-actions">
          <a href="/articles/new" class="btn btn-primary"><i class="fas fa-pen-nib"></i> নতুন লেখা</a>
          <a href="/profile/<%= user.username %>" class="btn btn-ghost"><i class="fas fa-user"></i> প্রোফাইল</a>
        </div>
      </div>
    </header>

    <%# ═══ সেশন ১০৯: স্ট্যাট-টাইল-গ্রিড বিলুপ্ত — সংখ্যাগুলো নিচের ট্যাব-ব্যাজেই।
         লেখা-স্ট্যাটিসটিক্স — কমপ্যাক্ট KPI-চিপ + ৮০px স্লিম-বার-চার্ট (টগলযোগ্য) ═══ %>
    <div class="ws91-card" aria-label="লেখা-স্ট্যাটিসটিক্স">
      <div class="ws91-head">
        <h2><i class="fas fa-chart-column"></i> পারফরম্যান্স সারাংশ</h2>
        <span class="ws91-sub">প্রকাশিত লেখার পারফরম্যান্স · শেষ ৬ মাস</span>
        <button type="button" class="ws91-toggle" id="ws91Toggle" aria-expanded="true" aria-controls="ws91Chart">লুকান <i class="fas fa-chevron-up" aria-hidden="true"></i></button>
      </div>
      <div class="ws91-kpis">
        <div class="ws91-kpi">
          <span class="ws91-kpi-ico v"><i class="far fa-eye"></i></span>
          <div><b><%= bn91(totals91.views) %></b><span>মোট পাঠ</span></div>
        </div>
        <div class="ws91-kpi">
          <span class="ws91-kpi-ico l"><i class="fas fa-heart"></i></span>
          <div><b><%= bn91(totals91.likes) %></b><span>প্রতিক্রিয়া পেয়েছেন</span></div>
        </div>
        <div class="ws91-kpi">
          <span class="ws91-kpi-ico c"><i class="far fa-comments"></i></span>
          <div><b><%= bn91(totals91.comments) %></b><span>মন্তব্য পেয়েছেন</span></div>
        </div>
        <% if (bestPost91) { %>
          <a class="ws91-kpi ws91-best" href="/<%= bestPost91.type === 'question' ? 'qa' : 'articles' %>/<%= bestPost91.id %>" title="<%= bestPost91.title %>">
            <span class="ws91-kpi-ico b"><i class="fas fa-trophy"></i></span>
            <div><b><%= bn91(bestPost91.view_count || 0) %></b><span class="ws91-best-label">সেরা লেখা: <%= bestPost91.title.length > 34 ? bestPost91.title.slice(0, 34) + '…' : bestPost91.title %></span></div>
          </a>
        <% } %>
      </div>
      <% if (monthly91.length) { const maxC91 = Math.max.apply(null, monthly91.map(m => m.count).concat([1])); %>
      <%# সেশন ১০৯: SVG → HTML flex-বার — viewBox-স্ট্রেচে বিশাল-ফাঁকা-চার্ট গোটচা শেষ;
          ফিক্সড ৮৪px উচ্চতা, শূন্য-মাসে ৫px মিউটেড-স্টাব, ভ্যালু-লেবেল শুধু >০ হলে %>
      <div class="ws91-chart-wrap" id="ws91Chart">
        <div class="ws91-bars" role="img" aria-label="মাসিক প্রকাশনা-গ্রাফ">
          <% monthly91.forEach(function (m91, i91) {
               const pct91 = maxC91 > 0 ? Math.round((m91.count / maxC91) * 100) : 0;
          %>
            <div class="ws91-col" title="<%= m91.label %>: <%= bn91(m91.count) %>টি লেখা">
              <span class="ws91-val"><%= m91.count > 0 ? bn91(m91.count) : '' %></span>
              <div class="ws91-track"><div class="ws91-fill<%= m91.count > 0 ? ' has' : '' %>" style="height:<%= m91.count > 0 ? Math.max(pct91, 14) : 6 %>%"></div></div>
              <span class="ws91-mo"><%= m91.label %></span>
            </div>
          <% }); %>
        </div>
      </div>
      <% } %>
    </div>

    <%# সেশন ১০৯: একক সমন্বিত ট্যাব-বার — কাউন্ট ব্যাজে (ডুপ্লিকেট-গ্রিড নেই),
        ড্রাফট-ট্যাব সর্বদা দৃশ্যমান (০ হলেও), FB-প্যারিটি অর্ডার %>
    <div class="personal-tabs" role="tablist" aria-label="ব্যক্তিগত ফিড ট্যাব">
      <button class="personal-tab active" data-tab="posts" role="tab" aria-selected="true"><i class="fas fa-pen-nib"></i> আমার পোস্ট <span class="tb-badge"><%= bn91(stats.posts) %></span></button>
      <button class="personal-tab" data-tab="drafts" role="tab" aria-selected="false"><i class="fas fa-file"></i> ড্রাফট <span class="tb-badge"><%= bn91(stats.drafts) %></span></button>
      <button class="personal-tab" data-tab="bookmarks" role="tab" aria-selected="false"><i class="fas fa-bookmark"></i> সংরক্ষিত <span class="tb-badge"><%= bn91(stats.bookmarks) %></span></button>
      <button class="personal-tab" data-tab="comments" role="tab" aria-selected="false"><i class="fas fa-comment"></i> মন্তব্য <span class="tb-badge"><%= bn91(stats.comments) %></span></button>
      <button class="personal-tab" data-tab="reactions" role="tab" aria-selected="false"><i class="fas fa-heart"></i> প্রতিক্রিয়া <span class="tb-badge"><%= bn91(stats.reactions) %></span></button>
      <button class="personal-tab" data-tab="following" role="tab" aria-selected="false"><i class="fas fa-user-friends"></i> অনুসরণ <span class="tb-badge"><%= bn91(stats.following) %></span></button>
      <button class="personal-tab" data-tab="activity" role="tab" aria-selected="false"><i class="fas fa-stream"></i> অ্যাক্টিভিটি</button>
      <button class="personal-tab" data-tab="categories" role="tab" aria-selected="false"><i class="fas fa-tags"></i> ক্যাটাগরি</button>
    </div>

    <!-- Tab: Posts -->
    <section class="me-tab" data-pane="posts">
      <% if (myPosts.length === 0) { %>
        <div class="empty">
          <div class="icon"><i class="fas fa-pen-nib"></i></div>
          <h3>এখনো কোনো লেখা নেই</h3>
          <p>আপনার প্রথম লেখাটি লিখুন।</p>
          <a href="/articles/new" class="btn btn-primary">নতুন লেখা শুরু করুন</a>
        </div>
      <% } %>
      <% myPosts.forEach(p => { %>
        <article class="feed-card">
          <% if (p.cover_image) { %><img loading="lazy" decoding="async" src="<%= p.cover_image %>" class="feed-card-cover" alt=""> <% } %>
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge <%= p.type === 'question' ? 'badge-muted' : '' %>"><%= p.type === 'question' ? 'প্রশ্ন' : 'লেখা' %></span>
              <span><i class="far fa-clock"></i> <%= new Date(p.created_at).toLocaleDateString('bn-BD') %></span>
              <span><i class="far fa-eye"></i> <%= p.view_count || 0 %></span>
              <%# সেশন ১১০: আনুমানিক পড়ার-সময় %>
              <% const rm110 = Math.max(1, Math.round(String(p.body || '').replace(/<[^>]*>/g, ' ').replace(/[#*_>`~\[\]()!]/g, '').replace(/\s+/g, ' ').trim().length / 950) || 1); %>
              <span class="rt-chip" title="আনুমানিক পড়ার সময়"><i class="fas fa-book-open"></i> <%= String(rm110).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; }) %> মিনিট</span>
            </div>
            <h3 class="feed-card-title"><a href="<%= p.type === 'question' ? '/qa/' + p.id : '/articles/' + p.id %>"><%= p.title %></a></h3>
            <% if (p.excerpt) { %><p class="feed-card-excerpt"><%= mdPlain(p.excerpt, 200) %></p><% } %>
          </div>
          <div class="feed-card-actions">
            <span class="feed-action"><i class="far fa-heart"></i> <%= p.like_count || 0 %></span>
            <span class="feed-action"><i class="far fa-comment"></i> <%= p.comment_count || 0 %></span>
            <span class="feed-action-spacer"></span>
            <a class="feed-action" href="/articles/<%= p.id %>/edit"><i class="fas fa-edit"></i> সম্পাদনা</a>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Comments -->
    <section class="me-tab" data-pane="comments" hidden>
      <% if (myComments.length === 0) { %>
        <div class="empty"><div class="icon"><i class="far fa-comment"></i></div><h3>কোনো মন্তব্য নেই</h3><p>অন্যের লেখায় মন্তব্য করুন।</p></div>
      <% } %>
      <% myComments.forEach(c => { %>
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge"><%= c.post_type === 'question' ? 'প্রশ্নে' : 'লেখায়' %></span>
              <span><i class="far fa-clock"></i> <%= new Date(c.created_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= c.post_type === 'question' ? '/qa/' + c.post_id : '/articles/' + c.post_id %>"><%= c.post_title %></a></h3>
            <p class="feed-card-excerpt"><%= mdPlain(c.body, 200) %></p>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Reactions -->
    <section class="me-tab" data-pane="reactions" hidden>
      <% if (myReactions.length === 0) { %>
        <div class="empty"><div class="icon"><i class="far fa-heart"></i></div><h3>কোনো প্রতিক্রিয়া নেই</h3><p>পোস্টে ❤️ বা 👍 দিয়ে শুরু করুন।</p></div>
      <% } %>
      <% myReactions.forEach(r => { %>
        <article class="feed-card">
          <% if (r.cover_image) { %><img loading="lazy" decoding="async" src="<%= r.cover_image %>" class="feed-card-cover" alt=""><% } %>
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge">
                <% const emo = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢' }; %>
                <%= emo[r.reaction_type] || '👍' %> <%= r.reaction_type %>
              </span>
              <span><i class="far fa-clock"></i> <%= new Date(r.created_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= r.post_type === 'question' ? '/qa/' + r.post_id : '/articles/' + r.post_id %>"><%= r.title %></a></h3>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Bookmarks -->
    <section class="me-tab" data-pane="bookmarks" hidden>
      <% if (myBookmarks.length === 0) { %>
        <div class="empty"><div class="icon"><i class="far fa-bookmark"></i></div><h3>কোনো সংরক্ষিত পোস্ট নেই</h3><p>পছন্দের লেখা 📌 করে রাখুন।</p></div>
      <% } %>
      <% myBookmarks.forEach(b => { %>
        <article class="feed-card">
          <% if (b.cover_image) { %><img loading="lazy" decoding="async" src="<%= b.cover_image %>" class="feed-card-cover" alt=""><% } %>
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge <%= b.type === 'question' ? 'badge-muted' : '' %>"><%= b.type === 'question' ? 'প্রশ্ন' : 'লেখা' %></span>
              <span><i class="far fa-clock"></i> <%= new Date(b.bookmarked_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= b.type === 'question' ? '/qa/' + b.id : '/articles/' + b.id %>"><%= b.title %></a></h3>
            <% if (b.display_excerpt) { %><p class="feed-card-excerpt"><%= b.display_excerpt %></p><% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Following -->
    <section class="me-tab" data-pane="following" hidden>
      <% if (following.length === 0) { %>
        <div class="empty"><div class="icon"><i class="fas fa-user-friends"></i></div><h3>কাউকে অনুসরণ করছেন না</h3><p>সদস্যদের অনুসরণ করুন, তাদের নতুন লেখা এখানে দেখুন।</p></div>
      <% } %>
      <div class="follow-grid">
        <% following.forEach(f => { %>
          <a href="/profile/<%= f.username %>" class="follow-card">
            <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="avatar-md" style="border-radius:50%" onerror="this.onerror=null;this.src='/avatar/<%= f.id %>'">
            <strong><%= f.full_name %></strong>
            <small><%= f.designation || 'সদস্য' %></small>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- Tab: Activity (chronological) -->
    <section class="me-tab" data-pane="activity" hidden>
      <% if (activity.length === 0) { %>
        <div class="empty"><div class="icon"><i class="fas fa-stream"></i></div><h3>কোনো অ্যাক্টিভিটি নেই</h3><p>লিখুন, মন্তব্য করুন, প্রতিক্রিয়া দিন, সব এখানে জমা হবে।</p></div>
      <% } %>
      <% const _emo = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢' }; %>
      <% activity.forEach(a => { %>
        <article class="feed-card activity-card">
          <span class="activity-icon <%= a.kind %>">
            <% if (a.kind === 'posted') { %><i class="fas fa-pen-nib"></i><% }
               else if (a.kind === 'commented') { %><i class="far fa-comment"></i><% }
               else if (a.kind === 'reacted') { %><span class="act-emoji"><%= _emo[a.reaction] || '👍' %></span><% }
               else { %><i class="fas fa-bookmark"></i><% } %>
          </span>
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge badge-muted">
                <% if (a.kind === 'posted') { %>পোস্ট করেছেন<% }
                   else if (a.kind === 'commented') { %>মন্তব্য করেছেন<% }
                   else if (a.kind === 'reacted') { %>প্রতিক্রিয়া দিয়েছেন<% }
                   else { %>সংরক্ষণ করেছেন<% } %>
              </span>
              <span><i class="far fa-clock"></i> <%= new Date(a.at).toLocaleString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><a href="<%= a.type === 'question' ? '/qa/' + a.id : '/articles/' + a.id %>"><%= a.title %></a></h3>
            <% if (a.body) { %><p class="feed-card-excerpt"><%= mdPlain(a.body, 140) %></p><% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <!-- Tab: Categories (my interests) -->
    <section class="me-tab" data-pane="categories" hidden>
      <div class="card interest-picker">
        <h3><i class="fas fa-tags"></i> আমার আগ্রহের বিষय</h3>
        <p class="side-text">বিষয় বাছলে কমিউনিটি ফিড আপনার পছন্দ অনুযায়ী সাজানো হবে।</p>
        <div class="tag-cloud" id="interestPool">
          <% tagPool.forEach(t => { %>
            <button type="button" class="tag-chip interest-opt <%= myInterests.includes(t.tag) ? 'selected' : '' %>" data-tag="<%= t.tag %>">#<%= t.tag %></button>
          <% }); %>
          <% if (tagPool.length === 0) { %><span class="side-text">এখনো কোনো ট্যাগ পুল নেই।</span><% } %>
        </div>
        <button type="button" class="btn btn-primary" id="saveInterests"><i class="fas fa-save"></i> সংরক্ষণ করুন</button>
      </div>
    </section>

    <!-- Tab: Drafts (সর্বদা রেন্ডার — ০ হলে empty-state) -->
    <section class="me-tab" data-pane="drafts" hidden>
      <% if (myDrafts.length === 0) { %>
        <div class="empty"><div class="icon"><i class="fas fa-file"></i></div><h3>কোনো ড্রাফট নেই</h3><p>অসম্পূর্ণ লেখা ড্রাফট হিসেবে সংরক্ষণ করুন, পরে সম্পাদনা করে প্রকাশ করুন।</p></div>
      <% } %>
      <% myDrafts.forEach(d => { %>
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-meta">
              <span class="badge badge-muted">ড্রাফট</span>
              <span><i class="far fa-clock"></i> <%= new Date(d.created_at).toLocaleDateString('bn-BD') %></span>
            </div>
            <h3 class="feed-card-title"><%= d.title || 'শিরোনামহীন ড্রাফট' %></h3>
          </div>
        </article>
      <% }) %>
    </section>
  </div>

  <%- include('../partials/footer') %>

  <script>
    document.querySelectorAll('.personal-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        document.querySelectorAll('.personal-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        document.querySelectorAll('.me-tab').forEach(p => p.hidden = p.dataset.pane !== target);
      });
    });
    // Deep-link ?tab=x
    const urlTab = new URLSearchParams(location.search).get('tab');
    if (urlTab) document.querySelector('.personal-tab[data-tab="' + urlTab + '"]')?.click();
    // সেশন ১০৯: পারফরম্যান্স-চার্ট টগল
    const wsT = document.getElementById('ws91Toggle'), wsC = document.getElementById('ws91Chart');
    if (wsT && wsC) {
      wsT.addEventListener('click', () => {
        const willShow = wsC.hidden;
        wsC.hidden = !willShow;
        wsT.setAttribute('aria-expanded', String(willShow));
        wsT.innerHTML = willShow ? 'লুকান <i class="fas fa-chevron-up"></i>' : 'চার্ট <i class="fas fa-chevron-down"></i>';
      });
    }
    // Interest picker
    document.querySelectorAll('.interest-opt').forEach(chip => {
      chip.addEventListener('click', () => chip.classList.toggle('selected'));
    });
    document.getElementById('saveInterests')?.addEventListener('click', async function () {
      const tags = [...document.querySelectorAll('.interest-opt.selected')].map(c => c.dataset.tag);
      const res = await fetch('/api/me/interests', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tags })
      });
      if (res.ok) { if (window.showToast) showToast('আগ্রহের বিষয় সংরক্ষিত হয়েছে', 'success'); setTimeout(() => location.reload(), 800); }
    });
  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
