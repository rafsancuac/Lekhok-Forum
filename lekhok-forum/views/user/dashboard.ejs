<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix)
    সেশন ১০২ (রোডম্যাপ-০৭): +rich-editor.css +multi-image.css — কম্পোজার-মোডালের এডিটর/মাল্টি-ছবি-উইজেট %>
<%- include('../partials/header', { title: 'কমিউনিটি ফিড | লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css', '/assets/css/rich-editor.css', '/assets/css/multi-image.css'] }) %>

  <div class="dashboard-wrap two-col has-rail">
    <%# ── সেশন ১৪৭: ফিড লেফট-রেল (FB-প্যারিটি) — ফিডের স্থায়ী শর্টকাট-কলাম (≥1200px;
        নিচে লুকানো — হেডারের ৯-ডট ডিরেক্টরি-লঞ্চার + মোবাইল-সাইডবার কভার করে)।
        helpers/dir-launcher.js এক-রেজিস্ট্রি (app.locals.dirRail) — হেডার-প্যানেলের সাথে
        ড্রিফট-অসম্ভব; রেল-ক্রম/হাইলাইট ওই রেজিস্ট্রিতেই নিয়ন্ত্রিত। ── %>
    <aside class="feed-rail" aria-label="ফিড শর্টকাট">
      <% if (user) { %>
        <a href="/me" class="fr-me">
          <img loading="lazy" decoding="async" src="<%= user.avatar_url || '/avatar/' + user.id %>" alt="" class="fr-me-avatar" onerror="this.onerror=null;this.src='/assets/avatars/neutral.svg?v=3'">
          <span class="fr-me-name"><%= typeof displayName === 'function' ? displayName(user) : user.full_name %></span>
        </a>
        <div class="fr-sep" aria-hidden="true"></div>
      <% } %>
      <% (typeof dirRail !== 'undefined' ? dirRail : []).forEach(function (it) { %>
        <a href="<%= it.href %>" class="fr-item<%= it.railHighlight ? ' hl' : '' %>">
          <span class="fr-ico" style="--dlx-t: var(<%= it.tok %>)" aria-hidden="true"><i class="fas <%= it.icon %>"></i></span>
          <span class="fr-label"><%= it.label %></span>
        </a>
      <% }) %>
      <div class="fr-foot">লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়</div>
    </aside>
    <!-- Main Feed -->
    <main class="dash-main">
      <% if (user) { %>
      <div class="dash-composer card">
        <img loading="lazy" decoding="async" src="<%= user.avatar_url || '/avatar/' + user.id %>" class="composer-avatar">
        <%# সেশন ১০০ (রোডম্যাপ-০৭): FB-স্টাইল কম্পোজার-মোডাল — ক্লিকে মোডাল খোলে
            (নিচে #composerModal); 'লেখা' লিঙ্ক পূর্ণ-এডিটরেই যায় %>
        <button type="button" id="composerOpen" class="composer-input" aria-haspopup="dialog" aria-controls="composerModal">আপনার লেখা শুরু করুন...</button>
        <div class="composer-actions">
          <button type="button" class="composer-action js-composer-open"><i class="fas fa-pen-nib"></i> লেখা</button>
          <a href="/qa/new" class="composer-action q"><i class="fas fa-question"></i> প্রশ্ন</a>
        </div>
      </div>
      <% } else { %>
      <div class="dash-composer card visitor-cta">
        <div style="flex:1">
          <strong style="display:block;margin-bottom:4px"><i class="fas fa-sign-in-alt"></i> সোস্যাল ফিডে অংশ নিন</strong>
          <span style="font-size:13px;color:var(--text-soft)">লেখা শেয়ার, প্রশ্ন করা, মেসেজ ও অন্যান্য ইন্টারঅ্যাকশনের জন্য লগইন করুন বা রেজিস্ট্রেশন করুন।</span>
        </div>
        <a href="/login?next=/dashboard" class="btn btn-primary btn-sm"><i class="fas fa-sign-in-alt"></i> লগইন</a>
        <a href="/register" class="btn btn-ghost btn-sm">রেজিস্ট্রেশন</a>
      </div>
      <% } %>

      <!-- Filter chips -->
      <div class="filter-chips">
        <a href="/dashboard<%= sort === 'ranked' ? '?sort=ranked' : '' %>" class="filter-chip <%= filter === 'all' ? 'active' : '' %>"><i class="fas fa-layer-group"></i> সব</a>
        <a href="/dashboard?filter=article<%= sort === 'ranked' ? '&sort=ranked' : '' %>" class="filter-chip <%= filter === 'article' ? 'active' : '' %>"><i class="fas fa-pen-nib"></i> লেখা</a>
        <a href="/dashboard?filter=question<%= sort === 'ranked' ? '&sort=ranked' : '' %>" class="filter-chip <%= filter === 'question' ? 'active' : '' %>"><i class="fas fa-question-circle"></i> প্রশ্নোত্তর</a>
        <a href="/dashboard?filter=activity" class="filter-chip <%= filter === 'activity' ? 'active' : '' %>"><i class="fas fa-calendar-check"></i> কার্যক্রম</a>
        <% if (user) { %><a href="/dashboard?filter=following<%= sort === 'ranked' ? '&sort=ranked' : '' %>" class="filter-chip <%= filter === 'following' ? 'active' : '' %>"><i class="fas fa-user-friends"></i> অনুসরণ only</a><% } %>
      </div>

      <%# সেশন ১৪৪: 'নতুন পোস্ট' লাইভ-পিল (FB-প্যারিটি) — র‍্যাংকড-মোডে রেন্ডারই হয় না
          (র‍্যাংকিং স্কোর-ভিত্তিক — 'নতুন' ধারণা কেবল recent-ক্রমে সত্য)। anchor = টপ-আইটেমের
          keyset-টুপল; /api/feed/fresh একই buildFeedSql-কার্সর-মোডে ফ্রেশ-কাউন্ট দেয়।
          গোটচা-ফিক্স: অ্যাট্রিবিউট data-ff-* নামে — data-ts নাম দিলে main.js-এর
          LekhokRelTime [data-ts]-পেইন্টার এ-কনটেইনারের ভেতরটা মুছে রিলেটিভ-টাইম বসিয়ে
          দেয় (পিল-বাটন মুছে-যায়) — E2E-তে ধরা, চুক্তি-সংঘর্ষ-এড়ানো-রীতি। %>
      <% if (feed.length && sort !== 'ranked') { %>
        <div class="feed-fresh-wrap" id="feedFreshWrap" aria-live="polite"
             data-ff-ts="<%= feed[0].created_at %>" data-ff-type="<%= feed[0].item_type %>" data-ff-id="<%= feed[0].id %>" data-ff-filter="<%= filter %>">
          <button type="button" class="feed-fresh-pill" id="feedFreshBtn" hidden>
            <span class="ffp-dot" aria-hidden="true"></span>
            <span class="ffp-text" id="feedFreshText">নতুন পোস্ট</span>
          </button>
          <button type="button" class="feed-fresh-x" id="feedFreshX" hidden aria-label="নতুন পোস্টের সংকেত ১০ মিনিটের জন্য সরান" title="সরান"><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </div>
      <% } %>

      <%# সেশন ১০০ (রোডম্যাপ-০৮): সর্ট-টগল — সর্বশেষ|জনপ্রিয় (time-decay র‍্যাংকড-ফিড) %>
      <div class="feed-sort-bar" role="tablist" aria-label="ফিড সাজানোর ধরন">
        <a href="/dashboard<%= filter !== 'all' ? '?filter=' + filter : '' %>" class="feed-sort-btn <%= sort !== 'ranked' ? 'active' : '' %>" role="tab" aria-selected="<%= sort !== 'ranked' ? 'true' : 'false' %>"><i class="fas fa-clock"></i> সর্বশেষ</a>
        <span class="feed-sort-sep" aria-hidden="true"></span>
        <a href="/dashboard?<%= filter !== 'all' ? 'filter=' + filter + '&amp;' : '' %>sort=ranked" class="feed-sort-btn <%= sort === 'ranked' ? 'active' : '' %>" role="tab" aria-selected="<%= sort === 'ranked' ? 'true' : 'false' %>"><i class="fas fa-fire"></i> জনপ্রিয়</a>
        <% if (sort === 'ranked') { %><span class="feed-sort-hint"><i class="fas fa-bolt"></i> এনগেজমেন্ট × সময়-ক্ষয় র‍্যাংকিং</span><% } %>
      </div>

      <% if (feed.length === 0) { %>
        <div class="empty-state-full card">
          <i class="fas fa-newspaper"></i>
          <p><%= filter === 'following' ? 'আপনি যাদের অনুসরণ করেন তাদের কোনো পোস্ট নেই।' : 'এখনো কোনো ফিড আইটেম নেই।' %></p>
          <a href="/members" class="btn btn-primary btn-sm">সদস্যদের খুঁজুন</a>
        </div>
      <% } else { %>
        <%# সেশন ৮৯: ফিড-কার্ড-লুপ পার্টিয়ালে সরানো হয়েছে (partials/feed-cards.ejs) —
             /dashboard ও /dashboard/more (ইনফিনিট-স্ক্রল) দুই জায়গাতেই একই মার্কআপ %>
        <%- include('../partials/feed-cards', { feed, user, myBookmarkedIds, sort }) %>
      <% } %>
      <%# সেশন ৮৯ (B1): ইনফিনিট-স্ক্রল সেন্টিনেল — main.js-এর feed-more ইঞ্জিন এটি দেখে
          /dashboard/more কল করে; JS-বিহীন ব্রাউজারে ফলব্যাক 'আরও দেখুন' বাটন %>
      <div class="feed-more" id="feedMore" data-filter="<%= filter %>" data-sort="<%= sort || 'recent' %>" data-offset="<%= feed.length %>" data-has-more="1" hidden<%- cursor ? ' data-cursor-ts="' + cursor.ts + '" data-cursor-type="' + cursor.type + '" data-cursor-id="' + cursor.id + '"' : '' %>>
        <div class="feed-more-spinner" id="feedMoreSpinner" hidden><i class="fas fa-circle-notch fa-spin"></i> <span>আরও লেখা লোড হচ্ছে…</span></div>
        <button type="button" class="feed-more-btn" id="feedMoreBtn">আরও দেখুন <i class="fas fa-chevron-down"></i></button>
      </div>
    </main>

    <!-- Right Sidebar -->
    <aside class="dash-right">
      <%# সেশন ১১০: কমপ্যাক্ট 'আমার সারসংক্ষেপ' — ৪ চিপ (বড়-কার্ড নয়, ইউজারের কমপ্যাক্ট-এসথেটিক) %>
      <% if (user && myStats) { const bn110 = n => String(n).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; }); %>
      <div class="side-card card msx-card" aria-label="আমার সারসংক্ষেপ">
        <h4><i class="fas fa-user" style="color:var(--accent)"></i> আমার সারসংক্ষেপ</h4>
        <div class="msx-grid">
          <a href="/me?tab=posts" class="msx-chip" title="আমার পোস্ট"><b><%= bn110(myStats.posts) %></b><span>প্রকাশিত লেখা</span></a>
          <a href="/me" class="msx-chip" title="লেখা-স্ট্যাটিসটিক্স"><b><%= bn110(myStats.views) %></b><span>মোট পাঠ</span></a>
          <a href="/me?tab=reactions" class="msx-chip" title="প্রাপ্ত প্রতিক্রিয়া"><b><%= bn110(myStats.reactions) %></b><span>প্রতিক্রিয়া</span></a>
          <a href="/me?tab=comments" class="msx-chip" title="আমার মন্তব্য"><b><%= bn110(myStats.comments) %></b><span>মন্তব্য</span></a>
          <%# সেশন ১১২: খসড়া-চিপ — লেখকের অসমাপ্ত কাজ এক-ক্লিকে (/me?tab=drafts) %>
          <a href="/me?tab=drafts" class="msx-chip wide" title="আমার খসড়া"><b><%= bn110(myStats.drafts || 0) %></b><span>খসড়া (ড্রাফট)</span></a>
        </div>
        <a href="/me" class="side-link">বিস্তারিত অ্যানালিটিক্স →</a>
      </div>
      <% } %>
      <%# সেশন ১১২: 'পড়া চালিয়ে যান' মাউন্ট — continue-reading.js localStorage থেকে
          রেন্ডার করে; খালি তালিকায় কার্ড আঁকা হয় না (ফাঁকা-কার্ড নয়) %>
      <div id="crxMount" class="crx-mount" hidden></div>
      <div class="side-card card">
        <h4><i class="fas fa-birthday-cake"></i> আজকের জন্মদিন</h4>
        <% if (birthdays.length) { %>
          <% birthdays.forEach(b => { %>
            <a href="/profile/<%= b.username %>" class="side-user">
              <img loading="lazy" decoding="async" src="<%= b.avatar_url || '/avatar/' + b.id %>" class="side-avatar" alt="">
              <span><strong><%= b.full_name %></strong><small>🎉 আজ তাঁর জন্মদিন</small></span>
            </a>
          <% }); %>
        <% } else { %>
          <p class="side-text">আজ কারো জন্মদিন নেই।</p>
        <% } %>
        <a href="/birthdays" class="side-link">সব দেখুন →</a>
      </div>

      <div class="side-card card">
        <h4><i class="fas fa-user-plus"></i> পরিচিত হোন</h4>
        <% if (suggested.length) { %>
          <% suggested.forEach(s => { %>
            <div class="side-user">
              <a href="/profile/<%= s.username %>" class="side-user-main">
                <img loading="lazy" decoding="async" src="<%= s.avatar_url || '/avatar/' + s.id %>" class="side-avatar" alt="">
                <span><strong><%= s.full_name %></strong><small><%= s.follower_count %> অনুসরণকারী</small></span>
              </a>
              <button type="button" class="btn btn-ghost btn-sm follow-inline" data-user="<%= s.id %>"><i class="fas fa-plus"></i></button>
            </div>
          <% }); %>
        <% } else { %>
          <p class="side-text">এখন নতুন কাউকে সাজেস্ট করা যাচ্ছে না।</p>
        <% } %>
        <a href="/members" class="side-link">সদস্য তালিকা →</a>
      </div>

      <% if (myFollowing.length) { %>
      <div class="side-card card">
        <h4><i class="fas fa-user-friends"></i> আমি যাঁদের অনুসরণ করি</h4>
        <% myFollowing.forEach(f => { %>
          <a href="/profile/<%= f.username %>" class="side-user">
            <img loading="lazy" decoding="async" src="<%= f.avatar_url || '/avatar/' + f.id %>" class="side-avatar" alt="">
            <span><strong><%= f.full_name %></strong><small><%= f.designation || 'সদস্য' %></small></span>
          </a>
        <% }); %>
        <a href="/me?tab=following" class="side-link">সব দেখুন →</a>
      </div>
      <% } %>

      <div class="side-card card">
        <h4><i class="fas fa-fire"></i> ট্রেন্ডিং ট্যাগ</h4>
        <% if (trendingTags.length) { %>
          <div class="tag-cloud">
            <% trendingTags.forEach(t => { %>
              <a href="/articles?tag=<%= encodeURIComponent(t.tag) %>" class="tag-chip">#<%= t.tag %> <small><%= t.count %></small></a>
            <% }); %>
          </div>
        <% } else { %>
          <p class="side-text">এখনো কোনো ট্যাগ নেই।</p>
        <% } %>
      </div>

      <div class="side-card card">
        <h4><i class="fas fa-chart-line" style="color:var(--accent)"></i> ট্রেন্ডিং পোস্ট</h4>
        <% if (trendingPosts && trendingPosts.length) { %>
          <ul class="trending-list">
            <% trendingPosts.forEach((t, idx) => { %>
              <li class="trending-item">
                <span class="trend-rank"><%= idx + 1 %></span>
                <a href="/articles/<%= t.id %>" class="trend-link">
                  <span class="trend-title"><%= t.title.length > 42 ? t.title.substring(0, 42) + '…' : t.title %></span>
                  <span class="trend-meta">
                    <i class="fas fa-fire"></i> <%= t.engagement %> এনগেজমেন্ট
                    · <%= t.author_name %>
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="side-text">এখনো কোনো ট্রেন্ডিং পোস্ট নেই।</p>
        <% } %>
      </div>

      <div class="side-card card">
        <h4><i class="fas fa-trophy" style="color:#f59e0b"></i> লিডারবোর্ড</h4>
        <% if (leaderboard && leaderboard.length) { %>
          <ul class="leaderboard-list">
            <% leaderboard.forEach((u, idx) => { %>
              <li class="leaderboard-item">
                <span class="lb-rank <%= idx === 0 ? 'gold' : idx === 1 ? 'silver' : idx === 2 ? 'bronze' : '' %>">
                  <% if (idx === 0) { %>🥇<% } else if (idx === 1) { %>🥈<% } else if (idx === 2) { %>🥉<% } else { %><%= idx + 1 %><% } %>
                </span>
                <a href="/profile/<%= u.username %>" class="lb-name">
                  <% if (u.avatar_url) { %>
                    <img loading="lazy" decoding="async" src="<%= u.avatar_url %>" class="lb-avatar" onerror="this.onerror=null;this.src='/avatar/<%= u.id %>'">
                  <% } else { %>
                    <span class="lb-avatar lb-letter"><%= u.full_name.charAt(0).toUpperCase() %></span>
                  <% } %>
                  <span class="lb-info">
                    <span class="lb-fullname"><%= u.full_name %></span>
                    <span class="lb-score"><i class="fas fa-star"></i> <%= u.score %> পয়েন্ট</span>
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="side-text">লিডারবোর্ডের জন্য এখনো যথেষ্ট ডেটা নেই।</p>
        <% } %>
        <a href="/members" class="side-link">সকল সদস্য →</a>
      </div>
    </aside>
  </div>

  <%- include('../partials/share-modal') %>
  <%# ── সেশন ৯৩: ফিড-৩-ডট-মেনুর 'রিপোর্ট'-অপশনের জন্য মোডাল + কমেন্ট-ইঞ্জিন ── %>
  <%- include('../partials/report-modal') %>
  <%# সেশন ১০৫: রিঅ্যাক্টরস-মডাল — ক্যানোনিকাল PostFooterActions কাউন্টার-বারের ক্লিক-টার্গেট %>
  <%- include('../shared/post/ReactorsModal') %>


  <%# ── সেশন ১০০ (রোডম্যাপ-০৭ 🔴): FB-স্টাইল কম্পোজার-মোডাল — ড্র্যাগ-ড্রপ ছবি,
      খসড়া-অটোসেভ (localStorage), খসড়া-গার্ড, অটো-গ্রো টেক্সটএরিয়া, ক্যারেক্টার-কাউন্টার।
      সাবমিট: POST /articles/new (fetch-ফরওয়ার্ড → আর্টিকেল-পেজে নেভিগেশন) ── %>
  <% if (user) { %>
  <div class="cpm-backdrop" id="composerModal" hidden>
    <div class="cpm-dialog" role="dialog" aria-modal="true" aria-labelledby="cpmTitle">
      <form id="composerForm" action="/articles/new" method="post" enctype="multipart/form-data" novalidate>
        <div class="cpm-head">
          <h2 id="cpmTitle">নতুন লেখা তৈরি করুন</h2>
          <button type="button" class="cpm-close" id="composerClose" aria-label="বন্ধ করুন" title="বন্ধ করুন"><i class="fas fa-times"></i></button>
        </div>
        <div class="cpm-author">
          <img src="<%= user.avatar_url || '/avatar/' + user.id %>" alt="" class="cpm-avatar">
          <div class="cpm-author-meta">
            <strong><%= typeof displayName === 'function' ? displayName(user) : (user.pen_name || user.full_name) %></strong>
            <span class="cpm-audience"><i class="fas fa-globe"></i> পাবলিক</span>
          </div>
        </div>
        <input type="text" class="cpm-title" id="cpmTitleInput" name="title" maxlength="160" placeholder="শিরোনাম *" autocomplete="off">
        <%# সেশন ১০০: খসড়া-রিস্টোর-নোটিশ — আগের অসংরক্ষিত খসড়া ফিরে পেলে জানাই + বাতিল-অপশন %>
        <div class="cpm-restore" id="cpmRestoreNote" hidden>
          <i class="fas fa-history"></i>
          <span>আগের অসংরক্ষিত খসড়া ফিরিয়ে আনা হয়েছে</span>
          <button type="button" id="cpmDraftDiscard">বাতিল করুন</button>
        </div>
        <textarea class="cpm-body" id="cpmBody" name="body" rows="4" placeholder="আপনার লেখা শুরু করুন… @ম্যানশন #হ্যাশট্যাগ ব্যবহার করতে পারেন"></textarea>
        <input type="hidden" name="images" id="cpmImagesInput" value="[]">
        <div class="cpm-strip" id="cpmStrip" hidden></div>
        <div class="cpm-droptip" id="cpmDropTip" hidden><i class="fas fa-cloud-arrow-up"></i> ছবি ছেড়ে দিন — আপলোড শুরু হবে</div>
        <input type="file" id="cpmFile" accept="image/*" multiple hidden>
        <input class="cpm-tags" id="cpmTags" name="tags" placeholder="ট্যাগ (কমা দিয়ে আলাদা করুন — ঐচ্ছিক)">
        <div class="cpm-error" id="cpmError" hidden></div>
        <div class="cpm-foot">
          <div class="cpm-foot-left">
            <button type="button" class="cpm-tool" id="cpmAddImg" title="ছবি যোগ করুন" aria-label="ছবি যোগ করুন"><i class="fas fa-image"></i></button>
            <span class="cpm-charcount" id="cpmCharCount">০</span>
            <span class="cpm-draftnote" id="cpmDraftNote" hidden><i class="fas fa-cloud-arrow-down"></i> খসড়া সংরক্ষিত</span>
          </div>
          <button type="submit" class="cpm-post" id="cpmPostBtn" disabled>পোস্ট করুন <i class="fas fa-paper-plane"></i></button>
        </div>
      </form>
    </div>
  </div>
  <% } %>


  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <script src="/assets/js/post-gallery.js?v=<%= AV %>"></script>
  <script src="/assets/js/comment-tools.js?v=<%= AV %>"></script>
  <script src="/assets/js/continue-reading.js?v=<%= AV %>" defer></script>
  <% if (user) { %><script src="/assets/js/composer-modal.js?v=<%= AV %>"></script><% } %>
  <%# সেশন ১৪৪: 'নতুন পোস্ট' পিল-ইঞ্জিন — গার্ডেড IIFE (পেজ-নির্দিষ্ট; অন্য-কোডের সাথে নির্ভরশীলতা শূন্য)।
      পোল: প্রথম ৮সে, পরে ৬০সে; ট্যাব-লুকানো থাকলে স্কিপ + visibilitychange-এ ভিজিবল-কিক (১৫সে-থ্রটল)।
      ক্লিক = টপে-গিয়ে reload (scrollRestoration=manual — FB-প্যাটার্ন); × = ১০মিনিট-স্নুজ (in-memory)।
      ব্যর্থতায় নীরব-ডিগ্রেড — পোলিং-বন্ধ ছাড়া কিছুই ভাঙে না। %>
  <script>
    (function () {
      'use strict';
      var wrap = document.getElementById('feedFreshWrap');
      if (!wrap) return;
      var btn = document.getElementById('feedFreshBtn');
      var txt = document.getElementById('feedFreshText');
      var x = document.getElementById('feedFreshX');
      if (!btn || !txt || !x) return;
      var ts = String(wrap.getAttribute('data-ff-ts') || '');
      var type = String(wrap.getAttribute('data-ff-type') || '');
      var id = parseInt(wrap.getAttribute('data-ff-id'), 10) || 0;
      if (!ts || !type || !id) return; /* অসম্পূর্ণ anchor — ইঞ্জিন নীরবে বন্ধ */
      var filter = String(wrap.getAttribute('data-ff-filter') || 'all');
      var bn140 = function (s) { return String(s).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); };
      var snoozeUntil = 0;
      var lastRun = 0;
      var POLL_MS = 60000;
      var FIRST_MS = 8000;
      var busy = false;
      function freshUrl() {
        return '/api/feed/fresh?cursor=' + encodeURIComponent(ts) +
          '&cursorType=' + encodeURIComponent(type) +
          '&cursorId=' + encodeURIComponent(id) +
          '&filter=' + encodeURIComponent(filter);
      }
      function showPill(n, capped) {
        txt.textContent = bn140(n) + (capped ? '+' : '') + ' টি নতুন পোস্ট';
        btn.hidden = false;
        x.hidden = false;
        wrap.classList.add('on');
      }
      function hidePill() {
        btn.hidden = true;
        x.hidden = true;
        wrap.classList.remove('on');
      }
      function poll() {
        if (busy) return;
        if (document.hidden) return;
        if (Date.now() < snoozeUntil) return;
        busy = true;
        lastRun = Date.now();
        fetch(freshUrl(), { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            busy = false;
            if (!d || !d.ok) return;
            if (d.fresh > 0) showPill(d.fresh, !!d.capped);
            else hidePill();
          })
          .catch(function () { busy = false; });
      }
      btn.addEventListener('click', function () {
        try { history.scrollRestoration = 'manual'; } catch (_) {}
        window.scrollTo(0, 0);
        window.location.reload();
      });
      x.addEventListener('click', function () {
        snoozeUntil = Date.now() + 10 * 60 * 1000;
        hidePill();
      });
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden && Date.now() - lastRun > 15000) poll();
      });
      setTimeout(poll, FIRST_MS);
      setInterval(poll, POLL_MS);
    })();
  </script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
