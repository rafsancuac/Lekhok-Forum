<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix)
    সেশন ১০২ (রোডম্যাপ-০৭): +rich-editor.css +multi-image.css — কম্পোজার-মোডালের এডিটর/মাল্টি-ছবি-উইজেট
    সেশন ১৫৬: bodyClass lf-feed-lock156 — FB-ইনডিপেন্ডেন্ট ৩-কলাম স্ক্রল লক (≥1200px;
    dashboard.css session156-ব্লক) — মেনুবার স্থায়ী, বাম/মাঝ/ডান কলামের সম্পূর্ণ আলাদা স্ক্রল %>
<%- include('../partials/header', { title: 'কমিউনিটি ফিড | লেখক ফোরাম', bodyClass: 'lf-feed-lock156', extra_css: ['/assets/css/dashboard.css', '/assets/css/rich-editor.css', '/assets/css/multi-image.css'] }) %>

  <div class="dashboard-wrap two-col has-rail">
    <%# ── সেশন ১৪৭: ফিড লেফট-রেল (FB-প্যারিটি) — ফিডের স্থায়ী শর্টকাট-কলাম (≥1200px;
        নিচে লুকানো — হেডারের ৯-ডট ডিরেক্টরি-লঞ্চার + মোবাইল-সাইডবার কভার করে)।
        helpers/dir-launcher.js এক-রেজিস্ট্রি (app.locals.dirRail) — হেডার-প্যানেলের সাথে
        ড্রিফট-অসম্ভব; রেল-ক্রম/হাইলাইট ওই রেজিস্ট্রিতেই নিয়ন্ত্রিত। ── %>
    <%# সেশন ১৫৬: fb-scroll — হোভারে দৃশ্যমান স্ক্রলবার (style.css session156-ইউটিলিটি) %>
    <%# সেশন ১৫৭ (relabel: সমান্তরাল session156 আগে-ল্যান্ডেড, max+1-রীতি): পূর্ণাঙ্গ ডিরেক্টরি-রেল %>
    <%# সেশন ১৫৯ (ইউজার-স্পেক: TSX FeedLeftSidebar, session157-র ওপর ইউনিয়ন): ① সার্বক্ষণিক
        মেনু-সার্চ (fr-search159 — নিচের guarded IIFE; label+desc ফিল্টার, খালি-সেকশন-টাইটেল
        অটো-লুকায়, অমিলে 'কোনো মেনু মেলেনি') ② FB-কোর-শর্টকাট টপ-ব্লক — সংরক্ষিত লেখা
        (/bookmarks), স্মৃতি ও মেমোরিজ (/on-this-day), পাঠচক্র ও গ্রুপ (/messages),
        পত্রিকা ও পেজ (/press) + ফোরাম-সেকশনে 'মতামত ও ফিডব্যাক' (/complaints) —
        রেজিস্ট্রি core-সেকশন (sec.core = রেলে শিরোনাম-শূন্য) ③ প্রোফাইল-স্ট্রিপে
        'ব্যক্তিগত প্রোফাইল' সাবটাইটেল (fr-me-sub159) ④ আইডেন্টিফায়ার -159 — তাদের
        fr-sec-title157/fr-badge157/fr-item--rich157-পরিবারের সাথে collision-শূন্য %>
    <aside class="feed-rail fb-scroll" id="frRail159" aria-label="ফোরাম ডিরেক্টরি">
      <% if (user) { %>
        <a href="/me" class="fr-me">
          <img loading="lazy" decoding="async" src="<%= user.avatar_url || '/avatar/' + user.id %>" alt="" class="fr-me-avatar" onerror="this.onerror=null;this.src='/assets/avatars/neutral.svg?v=3'">
          <span class="fr-me-txt159">
            <span class="fr-me-name"><%= typeof displayName === 'function' ? displayName(user) : user.full_name %></span>
            <span class="fr-me-sub159">ব্যক্তিগত প্রোফাইল</span>
          </span>
        </a>
      <% } %>
      <%# সেশন ১৫৯: সার্বক্ষণিক কম্প্যাক্ট সার্চ-বার (FB-ইনপুট-প্যারিটি — ফোকাসে সাদা-পৃষ্ঠ) %>
      <div class="fr-search159">
        <i class="fas fa-search fr-search-ico159" aria-hidden="true"></i>
        <input type="search" id="frSearch159" class="fr-search-input159" placeholder="ফিচার বা মেনু খুঁজুন…" aria-label="ফিড মেনু খুঁজুন" autocomplete="off">
        <%# সেশন ২৪৯: 'r'-কী affordance (রেল-সার্চ) — '/' main.js-গ্লোবাল-সার্চে অধিকৃত,
            তাই দুই-স্তরের চুক্তি: '/' = গ্লোবাল, 'r' = রেল-মেনু; পিলটি ফোকাসে মিলিয়ে যায় %>
        <kbd class="fr-kbd249" aria-hidden="true">r</kbd>
      </div>
      <div class="fr-sep" aria-hidden="true"></div>
      <%# সেশন ১৫৭ (ইউজার-স্পেক, relabel): পূর্ণাঙ্গ ফোরাম ডিরেক্টরি — হেডার-লঞ্চারের সব আইটেম
          বাম-রেলে সেকশন-শিরোনামসহ স্থায়ী (প্রতিদিনের পড়া-লেখা সর্বদা চোখের সামনে)।
          প্রতিটি আইটেমে Title+Desc দুই-লাইন (FB LeftRail-প্যারিটি) + 'আজকের' ব্যাজ।
          রেজিস্ট্রি: helpers/dir-launcher.js (app.locals.dirSections) — হেডার/রেল এক-সোর্স।
          সেশন ১৫৯: sec.core → শিরোনাম-শূন্য কোর-ব্লক; data-fr-sec/data-fr-hay = সার্চ-চুক্তি। %>
      <% (typeof dirSections !== 'undefined' ? dirSections : []).forEach(function (sec, sIdx) { %>
        <% if (!sec.core) { %><p class="fr-sec-title157" data-fr-sec="<%= sec.key %>"><%= sec.title %></p><% } %>
        <% sec.items.forEach(function (it) { %>
          <a href="<%= it.href %>" class="fr-item fr-item--rich157<%= it.railHighlight ? ' hl' : '' %>" data-fr-sec="<%= sec.key %>" data-fr-hay="<%= it.label + ' ' + it.desc %>">
            <span class="fr-ico" style="--dlx-t: var(<%= it.tok %>)" aria-hidden="true"><i class="fas <%= it.icon %>"></i></span>
            <span class="fr-body157">
              <span class="fr-label-row157">
                <span class="fr-label"><%= it.label %></span>
                <% if (it.href === '/epaper') { %><span class="fr-badge157">আজকের</span><% } %>
              </span>
              <span class="fr-desc157"><%= it.desc %></span>
            </span>
          </a>
        <% }) %>
        <% if (sIdx < dirSections.length - 1) { %><div class="fr-sep" aria-hidden="true"></div><% } %>
      <% }) %>
      <div class="fr-empty159" id="frEmpty159" hidden><i class="fas fa-search" aria-hidden="true"></i><span>কোনো মেনু মেলেনি</span></div>
      <div class="fr-foot">লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয় © ২০২৬</div>
    </aside>
    <!-- Main Feed -->
    <main class="dash-main fb-scroll">
      <% if (user) { %>
        <%# সেশন ১৫৮: সর্বজনীন পোস্ট-ট্রিগার (session100/153-ট্রিগারের প্রতিস্থাপন — স্পেক:
            UniversalPostTrigger — ফিড/প্রোফাইল/QA-তে হুবহু একই কার্ড; ❓-বাটন এখন
            /qa/new-লিঙ্ক নয়, একই মোডাল প্রশ্ন-প্রি-সিলেক্টেড খোলে) %>
        <%- include('../shared/post/UniversalPostTrigger') %>
      <% } else { %>
      <div class="dash-composer card visitor-cta">
        <div style="flex:1">
          <strong style="display:block;margin-bottom:4px"><i class="fas fa-sign-in-alt"></i> সোস্যাল ফিডে অংশ নিন</strong>
          <span style="font-size:13px;color:var(--text-soft)">লেখা শেয়ার, প্রশ্ন করা, মেসেজ ও অন্যান্য ইন্টারঅ্যাকশনের জন্য লগইন করুন বা রেজিস্ট্রেশন করুন।</span>
        </div>
        <a href="/login?next=/dashboard" class="btn btn-primary btn-sm"><i class="fas fa-sign-in-alt"></i> লগইন</a>
        <a href="/register" class="btn btn-ghost btn-sm">রেজিস্ট্রেশন</a>
      </div>
      <% } %>

      <%# সেশন ১৬৩ (ইউজার-স্পেক FeedFilterBar.tsx-পোর্ট): একক-লাইন কম্প্যাক্ট ফিল্টার-বার —
          আলাদা ক্যাপসুল/পিল সর্ট-বার চিরতরে বাদ; 'সর্বশেষ' ও 'জনপ্রিয়' এখন ক্যাটাগরি-চিপগুলোর
          একই সারিতে, হুবহু একই ৮px-চারকোনা সাদা-বর্ডার ডিজাইনে (সক্রিয় = সবুজ accent)।
          ৭০০px-ফিডে ৭টি বাটন এক লাইনে আঁটতে প্যাডিং কম্প্যাক্ট (৬px×১০px) + সূক্ষ্ম ডিভাইডার;
          সরু-স্ক্রিনে no-scrollbar মসৃণ হরাইজন্টাল-স্ক্রোল। র‍্যাংকড-হিন্ট এখন জনপ্রিয়-বাটনের
          title-টুলটিপে + ফিড-কার্ডের session102 fd-rank-chip ব্যাখ্যা বহাল। %>
      <!-- Filter chips + sort toggle (একই লাইন) -->
      <div class="filter-chips">
        <a href="/dashboard<%= sort === 'ranked' ? '?sort=ranked' : '' %>" class="filter-chip <%= filter === 'all' ? 'active' : '' %>"><i class="fas fa-layer-group"></i> সব</a>
        <a href="/dashboard?filter=article<%= sort === 'ranked' ? '&sort=ranked' : '' %>" class="filter-chip <%= filter === 'article' ? 'active' : '' %>"><i class="fas fa-pen-nib"></i> লেখা</a>
        <a href="/dashboard?filter=question<%= sort === 'ranked' ? '&sort=ranked' : '' %>" class="filter-chip <%= filter === 'question' ? 'active' : '' %>"><i class="fas fa-question-circle"></i> প্রশ্নোত্তর</a>
        <a href="/dashboard?filter=activity" class="filter-chip <%= filter === 'activity' ? 'active' : '' %>"><i class="fas fa-calendar-check"></i> কার্যক্রম</a>
        <% if (user) { %><a href="/dashboard?filter=following<%= sort === 'ranked' ? '&sort=ranked' : '' %>" class="filter-chip <%= filter === 'following' ? 'active' : '' %>"><i class="fas fa-user-friends"></i> অনুসরণ only</a><% } %>
        <span class="fsort-sep163" aria-hidden="true"></span>
        <span class="fsort-grp163" role="tablist" aria-label="ফিড সাজানোর ধরন">
          <a href="/dashboard<%= filter !== 'all' ? '?filter=' + filter : '' %>" class="feed-sort-btn <%= sort !== 'ranked' ? 'active' : '' %>" role="tab" aria-selected="<%= sort !== 'ranked' ? 'true' : 'false' %>" title="সর্বশেষ প্রকাশের ক্রমে"><i class="fas fa-clock"></i> সর্বশেষ</a>
          <a href="/dashboard?<%= filter !== 'all' ? 'filter=' + filter + '&amp;' : '' %>sort=ranked" class="feed-sort-btn <%= sort === 'ranked' ? 'active' : '' %>" role="tab" aria-selected="<%= sort === 'ranked' ? 'true' : 'false' %>" title="এনগেজমেন্ট × সময়-ক্ষয় র‍্যাংকিং"><i class="fas fa-fire"></i> জনপ্রিয়</a>
        </span>
      </div>

      <%# সেশন ১৪৪: 'নতুন পোস্ট' লাইভ-পিল (FB-প্যারিটি) — র‍্যাংকড-মোডে রেন্ডারই হয় না
          (র‍্যাংকিং স্কোর-ভিত্তিক — 'নতুন' ধারণা কেবল recent-ক্রমে সত্য)। anchor = টপ-আইটেমের
          keyset-টুপল; /api/feed/fresh একই buildFeedSql-কার্সর-মোডে ফ্রেশ-কাউন্ট দেয়।
          গোটচা-ফিক্স: অ্যাট্রিবিউট data-ff-* নামে — data-ts নাম দিলে main.js-এর
          LekhokRelTime [data-ts]-পেইন্টার এ-কনটেইনারের ভেতরটা মুছে রিলেটিভ-টাইম বসিয়ে
          দেয় (পিল-বাটন মুছে-যায়) — E2E-তে ধরা, চুক্তি-সংঘর্ষ-এড়ানো-রীতি। %>
      <% if (feed.length && sort !== 'ranked') { %>
        <div class="feed-fresh-wrap" id="feedFreshWrap" aria-live="polite"
             data-ff-ts="<%= feed[0].created_at %>" data-ff-type="<%= feed[0].item_type %>" data-ff-id="<%= feed[0].id %>" data-ff-filter="<%= filter %>">
          <button type="button" class="feed-fresh-pill" id="feedFreshBtn" hidden>
            <span class="ffp-dot" aria-hidden="true"></span>
            <span class="ffp-text" id="feedFreshText">নতুন পোস্ট</span>
          </button>
          <button type="button" class="feed-fresh-x" id="feedFreshX" hidden aria-label="নতুন পোস্টের সংকেত ১০ মিনিটের জন্য সরান" title="সরান"><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </div>
      <% } %>

      <% if (feed.length === 0) { %>
        <div class="empty-state-full card">
          <i class="fas fa-newspaper"></i>
          <p><%= filter === 'following' ? 'আপনি যাদের অনুসরণ করেন তাদের কোনো পোস্ট নেই।' : 'এখনো কোনো ফিড আইটেম নেই।' %></p>
          <a href="/members" class="btn btn-primary btn-sm">সদস্যদের খুঁজুন</a>
        </div>
      <% } else { %>
        <%# সেশন ৮৯: ফিড-কার্ড-লুপ পার্টিয়ালে সরানো হয়েছে (partials/feed-cards.ejs) —
             /dashboard ও /dashboard/more (ইনফিনিট-স্ক্রল) দুই জায়গাতেই একই মার্কআপ %>
        <%- include('../partials/feed-cards', { feed, user, myBookmarkedIds, sort }) %>
      <% } %>
      <%# সেশন ৮৯ (B1): ইনফিনিট-স্ক্রল সেন্টিনেল — main.js-এর feed-more ইঞ্জিন এটি দেখে
          /dashboard/more কল করে; JS-বিহীন ব্রাউজারে ফলব্যাক 'আরও দেখুন' বাটন %>
      <div class="feed-more" id="feedMore" data-filter="<%= filter %>" data-sort="<%= sort || 'recent' %>" data-offset="<%= feed.length %>" data-has-more="1" hidden<%- cursor ? ' data-cursor-ts="' + cursor.ts + '" data-cursor-type="' + cursor.type + '" data-cursor-id="' + cursor.id + '"' : '' %>>
        <div class="feed-more-spinner" id="feedMoreSpinner" hidden><i class="fas fa-circle-notch fa-spin"></i> <span>আরও লেখা লোড হচ্ছে…</span></div>
        <button type="button" class="feed-more-btn" id="feedMoreBtn">আরও দেখুন <i class="fas fa-chevron-down"></i></button>
      </div>
    </main>

    <!-- Right Sidebar — সেশন ১৪৮ (ইউজার-স্পেক): প্রিমিয়াম FB-প্যারিটি রি-ডিজাইন
         ① ব্যক্তিগত 'আমার সারসংক্ষেপ' গ্লোবাল ফিড থেকে সম্পূর্ণ অপসারণ (কেবল /me-তে থাকবে)
         ② 'আজকের জন্মদিন' অটো-হাইড — শূন্য-অবস্থায় কার্ড-অস্তিত্বই নেই (FB-প্যারিটি)
         ③ ট্রেন্ডিং = কেবল মৌলিক সাহিত্যকর্ম (avatar_update-বাদ + শিরোনাম-ডিডুপ — routes/dashboard.js)
         ④ লিডারবোর্ডে ডাবল-ব্যাজ বিলোপ → স্লিম বাংলা র‍্যাঙ্ক + অ্যাভাটার-কোণে গোল্ড/সিলভার/ব্রোঞ্জ ডট + এমারেল্ড পয়েন্ট-ব্যাজ
         ⑤ সর্বোচ্চ ৮px রেডিয়াস (--radius-sm) + সর্বত্র বাংলা অঙ্ক (toBn — session150 single-source চুক্তি) -->
    <aside class="dash-right fb-scroll" aria-label="ফিড সাইডবার">
      <%# সেশন ১১২: 'পড়া চালিয়ে যান' মাউন্ট — continue-reading.js localStorage থেকে
          রেন্ডার করে; খালি তালিকায় কার্ড আঁকা হয় না (ফাঁকা-কার্ড নয়) %>
      <div id="crxMount" class="crx-mount" hidden></div>
      <%# ১. আজকের জন্মদিন — শূন্য-অবস্থায় কার্ড আঁকা হয় না ('আজ কারো জন্মদিন নেই' লেখা-কার্ড বিলোপ) %>
      <% if (birthdays.length) { %>
      <div class="side-card card">
