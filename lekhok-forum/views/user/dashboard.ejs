  <%# সেশন ১৫৮: composer-modal.js এখন UniversalComposerModal-পার্শিয়াল-ই লোড করে (ডাবল-ট্যাগ-প্রতিরোধ) %>
  <%# সেশন ১৪৪: 'নতুন পোস্ট' পিল-ইঞ্জিন — গার্ডেড IIFE (পেজ-নির্দিষ্ট; অন্য-কোডের সাথে নির্ভরশীলতা শূন্য)।
      পোল: প্রথম ৮সে, পরে ৬০সে; ট্যাব-লুকানো থাকলে স্কিপ + visibilitychange-এ ভিজিবল-কিক (১৫সে-থ্রটল)।
      ক্লিক = টপে-গিয়ে reload (scrollRestoration=manual — FB-প্যাটার্ন); × = ১০মিনিট-স্নুজ (in-memory)।
      ব্যর্থতায় নীরব-ডিগ্রেড — পোলিং-বন্ধ ছাড়া কিছুই ভাঙে না। %>
  <script>
    (function () {
      'use strict';
      var wrap = document.getElementById('feedFreshWrap');
      if (!wrap) return;
      var btn = document.getElementById('feedFreshBtn');
      var txt = document.getElementById('feedFreshText');
      var x = document.getElementById('feedFreshX');
      if (!btn || !txt || !x) return;
      var ts = String(wrap.getAttribute('data-ff-ts') || '');
      var type = String(wrap.getAttribute('data-ff-type') || '');
      var id = parseInt(wrap.getAttribute('data-ff-id'), 10) || 0;
      if (!ts || !type || !id) return; /* অসম্পূর্ণ anchor — ইঞ্জিন নীরবে বন্ধ */
      var filter = String(wrap.getAttribute('data-ff-filter') || 'all');
      var bn140 = function (s) { return String(s).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); };
      var snoozeUntil = 0;
      var lastRun = 0;
      var POLL_MS = 60000;
      var FIRST_MS = 8000;
      var busy = false;
      function freshUrl() {
        return '/api/feed/fresh?cursor=' + encodeURIComponent(ts) +
          '&cursorType=' + encodeURIComponent(type) +
          '&cursorId=' + encodeURIComponent(id) +
          '&filter=' + encodeURIComponent(filter);
      }
      function showPill(n, capped) {
        txt.textContent = bn140(n) + (capped ? '+' : '') + ' টি নতুন পোস্ট';
        btn.hidden = false;
        x.hidden = false;
        wrap.classList.add('on');
      }
      function hidePill() {
        btn.hidden = true;
        x.hidden = true;
        wrap.classList.remove('on');
      }
      function poll() {
        if (busy) return;
        if (document.hidden) return;
        if (Date.now() < snoozeUntil) return;
        busy = true;
        lastRun = Date.now();
        fetch(freshUrl(), { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            busy = false;
            if (!d || !d.ok) return;
            if (d.fresh > 0) showPill(d.fresh, !!d.capped);
            else hidePill();
          })
          .catch(function () { busy = false; });
      }
      btn.addEventListener('click', function () {
        try { history.scrollRestoration = 'manual'; } catch (_) {}
        window.scrollTo(0, 0);
        window.location.reload();
      });
      x.addEventListener('click', function () {
        snoozeUntil = Date.now() + 10 * 60 * 1000;
        hidePill();
      });
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden && Date.now() - lastRun > 15000) poll();
      });
      setTimeout(poll, FIRST_MS);
      setInterval(poll, POLL_MS);
    })();
  </script>
  <%# সেশন ১৫৯: রেল-মেনু-সার্চ ইঞ্জিন — guarded IIFE (পেজ-নির্দিষ্ট; অন্য-কোডের সাথে নির্ভরশীলতা শূন্য)।
      label+desc (data-fr-hay) ফিল্টার → fr-item hidden; সেকশনের সব-আইটেম লুকালে টাইটেলও লুকায়;
      ক্যোয়ারি-চলাকালীন fr-sep ঢাকে (fr-searching159); কিছুই না মিললে 'কোনো মেনু মেলেনি'। %>
  <script>
    (function () {
      'use strict';
      var rail = document.getElementById('frRail159');
      var input = document.getElementById('frSearch159');
      if (!rail || !input) return;
      var items = Array.prototype.slice.call(rail.querySelectorAll('.fr-item'));
      var titles = Array.prototype.slice.call(rail.querySelectorAll('.fr-sec-title157'));
      var empty = document.getElementById('frEmpty159');
      input.addEventListener('input', function () {
        var q = (input.value || '').trim().toLowerCase();
        rail.classList.toggle('fr-searching159', !!q);
        var any = false;
        items.forEach(function (el) {
          var hay = (el.getAttribute('data-fr-hay') || '').toLowerCase();
          var on = !q || hay.indexOf(q) !== -1;
          el.hidden = !on;
          if (on) any = true;
        });
        titles.forEach(function (t) {
          var sec = t.getAttribute('data-fr-sec');
          var vis = items.some(function (el) { return !el.hidden && el.getAttribute('data-fr-sec') === sec; });
          t.hidden = !vis;
        });
        if (empty) empty.hidden = any || !q;
      });
      /* সেশন ২৪৯: 'r'-কী → রেল-সার্চ-ফোকাস + Escape → ক্লিয়ার+ব্লার।
         '/'-গ্লোবাল-সার্চ main.js-এ অধিকৃত (globalSearchInput) — সংঘর্ষ-বর্জনে রেলের জন্য 'r'
         (dashboard-স্কোপড, বাকি কোথাও-অবাদ্ধ — grep-প্রমাণিত)। ফিল্ড-গার্ড:
         ইনপুট/টেক্সটেরিয়া/সিলেক্ট/কনটেন্টেডিটেবলে টাইপরত অবস্থায় 'r'-ব্রাঞ্চ অকার্যকর;
         modifier-যুক্ত চাপও বাদ। */
      function isTyping249(el) {
        if (!el) return false;
        var tag = (el.tagName || '').toLowerCase();
        return tag === 'input' || tag === 'textarea' || tag === 'select' || el.isContentEditable === true;
      }
      function focusSearch249() {
        input.focus();
        if (input.select) input.select();
      }
      function clearSearch249() {
        if (!input.value) { input.blur(); return; }
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.blur();
      }
      document.addEventListener('keydown', function (e) {
        if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
        if ((e.key === 'r' || e.key === 'R') && !isTyping249(e.target)) {
          e.preventDefault();
          focusSearch249();
        } else if (e.key === 'Escape' && e.target === input) {
          e.preventDefault();
          clearSearch249();
        }
      });
      /* QA-হুক (s249-সুইট-চুক্তি): __frQA159.focusSearch()/clearSearch()/input() */
      window.__frQA159 = { focusSearch: focusSearch249, clearSearch: clearSearch249, input: function () { return input; } };
    })();
  </script>
<script>
/* session312 (s312-land): ডিপ-লিঙ্ক অবতরণ — /dashboard#post-<id> → [data-s312-post]/
   [data-post-id] scrollIntoView + .s312-land-flash (sfs312-ট্যাপ-থ্রুর অবতরণ-অর্ধ)।
   হ্যাশ-বিহীন লোড = no-op (প্রধান-প্রবাহ অটুট); কার্ড-অনুপস্থিতে found:0-গ্রেসফুল
   (ফিড-ব্যক্তিগতকরণ/পৃষ্ঠাভেদে গন্তব্য-কার্ড না-ও-থাকতে পারে)। */
(function () {
  var q312 = { found: 0, id: '', err: '' };
  try {
    var m312 = /^#post-(\d+)$/.exec(String(window.location.hash || ''));
    if (m312) {
      var id312 = m312[1];
      q312.id = id312;
      var el312 = document.querySelector('[data-s312-post="' + id312 + '"]') ||
                  document.querySelector('[data-post-id="' + id312 + '"]');
      if (el312) {
        q312.found = 1;
        if (el312.scrollIntoView) el312.scrollIntoView({ block: 'center' });
        el312.classList.add('s312-land-flash');
        setTimeout(function () { el312.classList.remove('s312-land-flash'); }, 2400);
      }
    }
  } catch (e312) { q312.err = String((e312 && e312.message) || e312); }
  window.__s312LandQA = q312;
})();
</script>
