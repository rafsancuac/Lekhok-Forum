<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>কমিউনিটি ফিড — লেখক ফোরাম</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="stylesheet" href="/assets/css/fonts.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
  <link rel="stylesheet" href="/assets/css/dashboard.css" />
</head>
<body>
  <%- include('../partials/header') %>

  <div class="dashboard-wrap two-col">
    <!-- Main Feed -->
    <main class="dash-main">
      <div class="dash-composer card">
        <img src="<%= user.avatar_url || '/avatar/' + user.id %>" class="composer-avatar">
        <a href="/articles/new" class="composer-input">আপনার লেখা শুরু করুন...</a>
        <div class="composer-actions">
          <a href="/articles/new" class="composer-action"><i class="fas fa-pen-nib"></i> লেখা</a>
          <a href="/qa/new" class="composer-action q"><i class="fas fa-question"></i> প্রশ্ন</a>
        </div>
      </div>

      <!-- Filter chips -->
      <div class="filter-chips">
        <a href="/dashboard" class="filter-chip <%= filter === 'all' ? 'active' : '' %>"><i class="fas fa-layer-group"></i> সব</a>
        <a href="/dashboard?filter=article" class="filter-chip <%= filter === 'article' ? 'active' : '' %>"><i class="fas fa-pen-nib"></i> লেখা</a>
        <a href="/dashboard?filter=question" class="filter-chip <%= filter === 'question' ? 'active' : '' %>"><i class="fas fa-question-circle"></i> প্রশ্নোত্তর</a>
        <a href="/dashboard?filter=activity" class="filter-chip <%= filter === 'activity' ? 'active' : '' %>"><i class="fas fa-calendar-check"></i> কার্যক্রম</a>
        <a href="/dashboard?filter=following" class="filter-chip <%= filter === 'following' ? 'active' : '' %>"><i class="fas fa-user-friends"></i> অনুসরণ only</a>
      </div>

      <% if (filter === 'all' && myInterests.length === 0) { %>
        <div class="interest-hint card">
          <i class="fas fa-wand-magic-sparkles"></i>
          <div>
            <strong>আপনার পছন্দের বিষয় বেছে নিন</strong>
            <span>আগ্রহ নির্বাচন করলে ফিড আরও ব্যক্তিগত হবে।</span>
          </div>
          <a href="/me?tab=categories" class="btn btn-primary btn-sm">বিষয় বাছুন</a>
        </div>
      <% } %>

      <% if (feed.length === 0) { %>
        <div class="empty-state-full card">
          <i class="fas fa-newspaper"></i>
          <p><%= filter === 'following' ? 'আপনি যাদের অনুসরণ করেন তাদের কোনো পোস্ট নেই।' : 'এখনো কোনো ফিড আইটেম নেই।' %></p>
          <a href="/members" class="btn btn-primary btn-sm">সদস্যদের খুঁজুন</a>
        </div>
      <% } else { %>
        <% feed.forEach(item => { %>
          <article class="feed-card card">
            <div class="feed-card-head">
              <% if (item.username === 'moderator') { %>
                <img src="/assets/img/avatar-placeholder.svg" class="feed-avatar" alt="">
                <div>
                  <span class="feed-author">মডারেটর <span class="verified-badge"><i class="fas fa-check-circle"></i></span></span>
                  <div class="feed-time"><i class="far fa-clock"></i> <%= new Date(item.created_at).toLocaleString('bn-BD') %></div>
                </div>
              <% } else { %>
                <img src="<%= item.avatar_url || '/avatar/0' %>" class="feed-avatar" alt="" onerror="this.src='/assets/img/avatar-placeholder.svg'">
                <div>
                  <a href="/profile/<%= item.username %>" class="feed-author"><%= item.author_name %></a>
                  <% if (item.author_role === 'admin' || item.author_role === 'moderator') { %><span class="role-chip"><%= item.author_role === 'admin' ? 'অ্যাডমিন' : 'মডারেটর' %></span><% } %>
                  <div class="feed-time"><i class="far fa-clock"></i> <%= new Date(item.created_at).toLocaleString('bn-BD') %></div>
                </div>
              <% } %>
              <% if (item.item_type === 'activity') { %>
                <span class="feed-type-badge activity"><i class="fas fa-calendar-check"></i> কার্যক্রম</span>
              <% } else if (item.item_type === 'question') { %>
                <span class="feed-type-badge question"><i class="fas fa-question-circle"></i> প্রশ্ন</span>
              <% } else { %>
                <span class="feed-type-badge article"><i class="fas fa-pen-nib"></i> লেখা</span>
              <% } %>
            </div>
            <% if (item.cover_image) { %>
              <a href="<%= item.link %>"><img src="<%= item.cover_image %>" class="feed-image" alt=""></a>
            <% } %>
            <div class="feed-card-body">
              <h3 class="feed-title"><a href="<%= item.link %>"><%= item.title %></a></h3>
              <p class="feed-text"><%= (item.body || '').substring(0, 280) %><% if ((item.body || '').length > 280) { %>…<a href="<%= item.link %>"> আরও পড়ুন</a><% } %></p>
            </div>
            <%- include('../partials/actions-bar', {
              targetId: item.id,
              targetType: 'post',
              counts: item.reactionCounts,
              mine: item.myReaction,
              link: item.link,
              bookmarked: false
            }) %>
          </article>
        <% }); %>
      <% } %>
    </main>

    <!-- Right Sidebar -->
    <aside class="dash-right">
      <div class="side-card card">
        <h4><i class="fas fa-birthday-cake"></i> আজকের জন্মদিন</h4>
        <% if (birthdays.length) { %>
          <% birthdays.forEach(b => { %>
            <a href="/profile/<%= b.username %>" class="side-user">
              <img src="<%= b.avatar_url || '/avatar/' + b.id %>" class="side-avatar" alt="">
              <span><strong><%= b.full_name %></strong><small>🎉 আজ তাঁর জন্মদিন</small></span>
            </a>
          <% }); %>
        <% } else { %>
          <p class="side-text">আজ কারো জন্মদিন নেই।</p>
        <% } %>
        <a href="/birthdays" class="side-link">সব দেখুন →</a>
      </div>

      <div class="side-card card">
        <h4><i class="fas fa-user-plus"></i> পরিচিত হোন</h4>
        <% if (suggested.length) { %>
          <% suggested.forEach(s => { %>
            <div class="side-user">
              <a href="/profile/<%= s.username %>" class="side-user-main">
                <img src="<%= s.avatar_url || '/avatar/' + s.id %>" class="side-avatar" alt="">
                <span><strong><%= s.full_name %></strong><small><%= s.follower_count %> অনুসরণকারী</small></span>
              </a>
              <button type="button" class="btn btn-ghost btn-sm follow-inline" data-user="<%= s.id %>"><i class="fas fa-plus"></i></button>
            </div>
          <% }); %>
        <% } else { %>
          <p class="side-text">এখন নতুন কাউকে সাজেস্ট করা যাচ্ছে না।</p>
        <% } %>
        <a href="/members" class="side-link">সদস্য তালিকা →</a>
      </div>

      <% if (myFollowing.length) { %>
      <div class="side-card card">
        <h4><i class="fas fa-user-friends"></i> আমি যাঁদের অনুসরণ করি</h4>
        <% myFollowing.forEach(f => { %>
          <a href="/profile/<%= f.username %>" class="side-user">
            <img src="<%= f.avatar_url || '/avatar/' + f.id %>" class="side-avatar" alt="">
            <span><strong><%= f.full_name %></strong><small>@<%= f.username %></small></span>
          </a>
        <% }); %>
        <a href="/me?tab=following" class="side-link">সব দেখুন →</a>
      </div>
      <% } %>

      <div class="side-card card">
        <h4><i class="fas fa-fire"></i> ট্রেন্ডিং ট্যাগ</h4>
        <% if (trendingTags.length) { %>
          <div class="tag-cloud">
            <% trendingTags.forEach(t => { %>
              <a href="/articles?tag=<%= encodeURIComponent(t.tag) %>" class="tag-chip">#<%= t.tag %> <small><%= t.count %></small></a>
            <% }); %>
          </div>
        <% } else { %>
          <p class="side-text">এখনো কোনো ট্যাগ নেই।</p>
        <% } %>
      </div>
    </aside>
  </div>

  <%- include('../partials/share-modal') %>
  <script src="/assets/js/main.js"></script>
</body>
</html>
