<%# সেশন ৭৫ — ফেসবুক মেসেঞ্জার-স্টাইল লিস্ট-ভিউ (Chats) %>
<%- include('../partials/header', { title: 'মেসেজ | লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css', '/assets/css/messenger.css'] }) %>

  <div class="page-wrap page-wrap--messenger">
    <div class="messenger-shell" id="messengerShell">

      <aside class="messenger-list" id="messengerList">
        <div class="messenger-list-head">
          <div class="msg-head-row">
            <h2><i class="fas fa-comment-dots"></i> চ্যাট</h2>
            <span class="msg-count-badge" id="msgCountBadge"><%= conversations.length %></span>
            <div class="fb-head-actions">
              <button type="button" class="fb-icon-btn" id="grpToggle" title="নতুন গ্রুপ কথোপকথন"><i class="fas fa-users"></i></button>
              <a href="/members" class="fb-icon-btn fb-icon-btn--accent" title="নতুন কথোপকথন শুরু করুন"><i class="fas fa-pen-to-square"></i></a>
            </div>
          </div>

          <%# ── FB পিল-সার্চ ── %>
          <div class="msg-search-wrap" id="msgSearchWrap">
            <i class="fas fa-search msg-search-icon"></i>
            <input type="search" class="messenger-search msg-search-input" id="msgSearch" placeholder="মেসেঞ্জারে খুঁজুন" autocomplete="off" />
            <button type="button" class="msg-search-clear" id="msgSearchClear" hidden><i class="fas fa-times"></i></button>
            <kbd class="msg-search-kbd" id="msgSearchKbd">/</kbd>
          </div>

          <%# ── সার্চ-ড্রপডাউন (কথোপকথন + নতুন ইউজার) ── %>
          <div class="msg-search-results" id="msgSearchResults" hidden>
            <div class="msr-section" id="msrConversations" hidden>
              <div class="msr-section-head">
                <span><i class="fas fa-comments"></i> কথোপকথন</span>
                <span class="msr-count" id="msrConvCount"></span>
              </div>
              <div id="msrConvList"></div>
            </div>
            <div class="msr-section" id="msrUsers" hidden>
              <div class="msr-section-head">
                <span><i class="fas fa-user-plus"></i> নতুন কথোপকথন শুরু করুন</span>
                <span class="msr-count" id="msrUserCount"></span>
              </div>
              <div id="msrUserList"></div>
            </div>
            <div class="msr-empty" id="msrEmpty" hidden>
              <i class="fas fa-search"></i>
              <p>কোনো ফলাফল পাওয়া যায়নি</p>
            </div>
          </div>

          <%# ── ফিল্টার-চিপ ── %>
          <div class="msg-filter-row">
            <button type="button" class="filter-chip mf-all active" data-mfilter="all">সব</button>
            <button type="button" class="filter-chip mf-unread" data-mfilter="unread"><i class="fas fa-circle" style="font-size:7px"></i> আনরিড</button>
            <button type="button" class="filter-chip mf-groups" data-mfilter="groups"><i class="fas fa-users"></i> গ্রুপ</button>
          </div>

          <form method="POST" action="/messages/group/create" id="grpForm" class="grp-form" hidden>
            <div class="grp-form-head"><i class="fas fa-users"></i> নতুন গ্রুপ কথোপকথন</div>
            <input type="text" name="title" placeholder="গ্রুপের নাম (যেমন: কমিটি ২০২৬)" required maxlength="60" />
            <div class="grp-members">
              <% (typeof allUsers !== 'undefined' ? allUsers : []).forEach(u => { %>
                <label class="grp-member"><input type="checkbox" name="members" value="<%= u.username %>"> <img src="<%= u.avatar_url || '/avatar/0' %>" onerror="this.src='/avatar/0'" alt=""> <%= u.full_name %></label>
              <% }); %>
            </div>
            <button type="submit" class="fb-icon-btn fb-icon-btn--accent" style="width:auto;padding:0 16px;height:36px;border-radius:99px;font-weight:700;font-size:13px"><i class="fas fa-check"></i> গ্রুপ তৈরি করুন</button>
          </form>
        </div>

        <%# ── Active-now ট্রে (FB Stories-স্টাইল, /api/messages/online-users থেকে) ── %>
        <div class="fb-active-tray" id="fbActiveTray" hidden></div>

        <%# ── সাম্প্রতিক সার্চ ── %>
        <div class="msg-recent" id="msgRecent" hidden>
          <div class="msg-recent-head">
            <span><i class="fas fa-clock-rotate-left"></i> সাম্প্রতিক সার্চ</span>
            <button type="button" id="msgRecentClear" class="msg-recent-clear">মুছুন</button>
          </div>
          <div id="msgRecentList"></div>
        </div>

        <%# ── কথোপকথন-তালিকা ── %>
        <div id="convListDefault">
          <% if (conversations.length === 0) { %>
            <div class="empty-state-full">
              <i class="fas fa-comment-slash"></i>
              <p>কোনো কথোপকথন নেই।</p>
              <p style="font-size:13px;color:var(--fb-text2);margin-top:6px">উপরের সার্চে নাম লিখে নতুন কথোপকথন শুরু করুন।</p>
            </div>
          <% } else { %>
            <% conversations.forEach(c => { %>
              <a href="<%= c.conv_link || ('/messages/' + c.other_username) %>" class="conv-item <%= c.is_group_flag ? 'is-group' : '' %>" data-name="<%= c.other_name.toLowerCase() %>" data-username="<%= c.other_username || '' %>" data-id="<%= c.id %>" data-group="<%= c.is_group_flag ? 1 : 0 %>" data-unread="<%= c.unread_count > 0 ? 1 : 0 %>" data-last="<%= (c.last_body || '').replace(/<[^>]+>/g, '').toLowerCase() %>" data-lm="<%= c.last_message_at || '' %>">
                <div class="avatar avatar-md" style="position:relative">
                  <% if (c.is_group_flag) { %>
                  <span class="group-avatar"><i class="fas fa-users"></i></span>
                  <% } else { %>
                  <img loading="lazy" decoding="async" src="<%= c.other_avatar || ('/avatar/' + (c.user_a === user.id ? c.user_b : c.user_a)) %>" alt="<%= c.other_name %>" onerror="this.onerror=null;this.src='/avatar/<%= c.user_a === user.id ? c.user_b : c.user_a %>'" />
                  <span class="online-dot" data-user-id="<%= c.user_a === user.id ? c.user_b : c.user_a %>" style="display:none"></span>
                  <% } %>
                </div>
                <div class="conv-meta">
                  <div class="conv-name"><%= c.other_name %></div>
                  <div class="conv-snippet"><% if (c.is_group_flag) { %><i class="fas fa-users" style="font-size:10px"></i> <%= c.member_count %> সদস্য · <% } %><%= c.last_body ? c.last_body.replace(/<[^>]+>/g, '').slice(0, 42) : 'নতুন কথোপকথন' %></div>
                </div>
                <div class="conv-meta-right">
                  <span class="conv-reltime" data-reltime="<%= c.last_message_at || '' %>"></span>
                  <% if (c.unread_count > 0) { %><span class="conv-unread"><%= c.unread_count %></span><% } %>
                </div>
              </a>
            <% }); %>
          <% } %>
        </div>
      </aside>

      <%# ── ডেস্কটপ এম্পটি-স্টেট (FB: "Select a conversation") ── %>
      <main class="messenger-empty">
        <div class="me-icon"><i class="fas fa-comment-dots"></i></div>
        <h2>কোনো কথোপকথন নির্বাচিত হয়নি</h2>
        <p>বাম দিকের তালিকা থেকে একটি চ্যাট বেছে নিন, অথবা সার্চ করে লেখক ফোরামের সদস্যদের সাথে নতুন কথোপকথন শুরু করুন।</p>
      </main>
    </div>
  </div>

  <script>
    // ── বাংলা আপেক্ষিক সময় (FB: 5m, 2h, 1d) ───────────────────────────
    function bnRelTime(iso) {
      if (!iso) return '';
      const t = new Date(String(iso).includes('T') ? iso : String(iso).replace(' ', 'T') + 'Z').getTime();
      if (isNaN(t)) return '';
      const s = Math.floor((Date.now() - t) / 1000);
      const bn = n => String(n).replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[d]);
      if (s < 60) return 'এখন';
      if (s < 3600) return bn(Math.floor(s / 60)) + ' মি';
      if (s < 86400) return bn(Math.floor(s / 3600)) + ' ঘ';
      if (s < 604800) return bn(Math.floor(s / 86400)) + ' দি';
      return new Date(t).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short' });
    }
    document.querySelectorAll('[data-reltime]').forEach(el => { el.textContent = bnRelTime(el.dataset.reltime); });

    // ── Active-now ট্রে ────────────────────────────────────────────────
    const fbActiveTray = document.getElementById('fbActiveTray');
    async function pollActiveTray() {
      try {
        const r = await fetch('/api/messages/online-users');
        const d = await r.json();
        const users = d.users || [];
        if (!users.length) { fbActiveTray.hidden = true; return; }
        fbActiveTray.innerHTML =
          '<span class="fb-tray-title"><i class="fas fa-circle" style="font-size:6px;color:var(--fb-green)"></i> এখন অনলাইন</span>' +
          users.map(u =>
            '<a class="fb-active-chip" href="/messages/' + encodeURIComponent(u.username) + '" title="' + escapeHtml(u.name) + '">' +
              '<span class="fb-active-avwrap">' +
                '<img loading="lazy" src="' + escapeHtml(u.avatar) + '" onerror="this.onerror=null;this.src=\'/avatar/' + u.id + '\'" alt="' + escapeHtml(u.name) + '">' +
                '<span class="fb-active-dot"></span>' +
              '</span>' +
              '<span class="fb-active-name">' + escapeHtml(u.name.split(' ')[0]) + '</span>' +
            '</a>'
          ).join('');
        fbActiveTray.hidden = false;
      } catch {}
    }
    setTimeout(pollActiveTray, 1200);
    setInterval(pollActiveTray, 8000);

    // ── ইউনিফায়েড সার্চ ───────────────────────────────────────────────
    const msgSearch = document.getElementById('msgSearch');
    const msgSearchClear = document.getElementById('msgSearchClear');
    const msgSearchResults = document.getElementById('msgSearchResults');
    const msgSearchKbd = document.getElementById('msgSearchKbd');
    const msgRecent = document.getElementById('msgRecent');
    const msgRecentList = document.getElementById('msgRecentList');
    const msgRecentClearBtn = document.getElementById('msgRecentClear');
    const convListDefault = document.getElementById('convListDefault');
    const msrConversations = document.getElementById('msrConversations');
    const msrUsers = document.getElementById('msrUsers');
    const msrEmpty = document.getElementById('msrEmpty');
    const msrConvList = document.getElementById('msrConvList');
    const msrUserList = document.getElementById('msrUserList');
    const msrConvCount = document.getElementById('msrConvCount');
    const msrUserCount = document.getElementById('msrUserCount');

    let searchTimer = null;
    let lastQuery = '';
    let kbIndex = -1;
    let kbRows = [];

    function loadRecent() {
      try {
        const r = JSON.parse(localStorage.getItem('msgRecentSearches') || '[]');
        return Array.isArray(r) ? r.slice(0, 5) : [];
      } catch { return []; }
    }
    function saveRecent(q) {
      q = (q || '').trim();
      if (!q) return;
      let r = loadRecent().filter(x => x !== q);
      r.unshift(q);
      r = r.slice(0, 5);
      localStorage.setItem('msgRecentSearches', JSON.stringify(r));
    }
    function renderRecent() {
      const r = loadRecent();
      if (!r.length) { msgRecent.hidden = true; return; }
      msgRecentList.innerHTML = r.map(q =>
        `<a class="msg-recent-item" data-q="${escapeHtml(q)}"><i class="fas fa-clock-rotate-left"></i> ${escapeHtml(q)}<button class="mr-remove" data-q="${escapeHtml(q)}"><i class="fas fa-times"></i></button></a>`
      ).join('');
      msgRecent.hidden = false;
    }
    msgRecentList.addEventListener('click', (e) => {
      const remove = e.target.closest('.mr-remove');
      if (remove) {
        e.preventDefault(); e.stopPropagation();
        const q = remove.dataset.q;
        let r = loadRecent().filter(x => x !== q);
        localStorage.setItem('msgRecentSearches', JSON.stringify(r));
        renderRecent();
        return;
      }
      const item = e.target.closest('.msg-recent-item');
      if (item) {
        msgSearch.value = item.dataset.q;
        msgSearch.dispatchEvent(new Event('input'));
      }
    });
    msgRecentClearBtn.addEventListener('click', () => {
      localStorage.removeItem('msgRecentSearches');
      renderRecent();
    });

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function highlight(text, q) {
      if (!q) return escapeHtml(text);
      const safe = escapeHtml(text);
      const qLower = q.toLowerCase();
      const idx = text.toLowerCase().indexOf(qLower);
      if (idx === -1) return safe;
      return escapeHtml(text.substring(0, idx)) + '<mark>' + escapeHtml(text.substring(idx, idx + q.length)) + '</mark>' + escapeHtml(text.substring(idx + q.length));
    }

    function searchConversations(q) {
      const qLower = (q || '').toLowerCase().trim();
      const items = [...document.querySelectorAll('#convListDefault .conv-item')];
      if (!qLower) return items.map(el => ({ el, name: el.dataset.name, username: el.dataset.username, last: el.dataset.last }));
      return items
        .filter(el => el.dataset.name.indexOf(qLower) !== -1 || el.dataset.username.toLowerCase().indexOf(qLower) !== -1 || el.dataset.last.indexOf(qLower) !== -1)
        .map(el => ({ el, name: el.dataset.name, username: el.dataset.username, last: el.dataset.last }));
    }

    async function searchUsers(q) {
      try {
        const r = await fetch('/api/users/search?q=' + encodeURIComponent(q));
        const data = await r.json();
        return data.users || [];
      } catch { return []; }
    }

    function renderConversationResults(results, q) {
      if (!results.length) { msrConversations.hidden = true; return; }
      msrConvCount.textContent = results.length;
      msrConvList.innerHTML = results.map(({ el, name, username, last }) => {
        const displayName = name;
        const origName = el.querySelector('.conv-name').textContent;
        const origSnippet = el.querySelector('.conv-snippet').textContent;
        const avatar = el.querySelector('img') ? el.querySelector('img').outerHTML : '';
        const unread = el.querySelector('.conv-unread');
        const unreadHtml = unread ? `<span class="conv-unread">${unread.textContent}</span>` : '';
        return `<a class="msr-row" href="/messages/${encodeURIComponent(username)}">
          ${avatar.replace('class="', 'class="msr-avatar ').replace('alt="', 'data-keep="1" alt="')}
          <div class="msr-meta">
            <div class="msr-name">${highlight(origName, q)}</div>
            <div class="msr-sub">${highlight(origSnippet, q)}</div>
          </div>
          <div class="msr-right">${unreadHtml}</div>
        </a>`;
      }).join('');
      msrConversations.hidden = false;
    }

    async function renderUserResults(q) {
      if (!q || q.length < 1) { msrUsers.hidden = true; return; }
      const users = await searchUsers(q);
      if (!users.length) { msrUsers.hidden = true; return; }
      msrUserCount.textContent = users.length;
      msrUserList.innerHTML = users.map(u => {
        const avatar = u.avatar_url
          ? `<img loading="lazy" decoding="async" class="msr-avatar" src="${escapeHtml(u.avatar_url)}" onerror="this.onerror=null;this.outerHTML='<div class=\\'msr-avatar\\'>${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>'" />`
          : `<div class="msr-avatar">${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>`;
        const sub = [u.designation, '@' + u.username].filter(Boolean).join(' • ');
        return `<a class="msr-row" href="/messages/${encodeURIComponent(u.username)}">
          ${avatar}
          <div class="msr-meta">
            <div class="msr-name">${highlight(u.full_name || u.username, q)}</div>
            <div class="msr-sub">${highlight(sub, q)}</div>
          </div>
          <div class="msr-right"><i class="fas fa-chevron-right"></i></div>
        </a>`;
      }).join('');
      msrUsers.hidden = false;
    }

    async function doSearch(q) {
      q = (q || '').trim();
      if (q === lastQuery) return;
      lastQuery = q;
      kbIndex = -1;

      if (!q) {
        msgSearchResults.hidden = true;
        msgSearchClear.hidden = true;
        convListDefault.classList.remove('hidden');
        renderRecent();
        return;
      }

      msgSearchClear.hidden = false;
      convListDefault.classList.add('hidden');
      msgRecent.hidden = true;

      const convResults = searchConversations(q);
      renderConversationResults(convResults, q);
      await renderUserResults(q);

      const hasConvs = !msrConversations.hidden;
      const hasUsers = !msrUsers.hidden;
      msrEmpty.hidden = hasConvs || hasUsers;

      msgSearchResults.hidden = false;
      kbRows = [...msgSearchResults.querySelectorAll('.msr-row')];
    }

    msgSearch.addEventListener('input', () => {
      if (searchTimer) clearTimeout(searchTimer);
      const v = msgSearch.value;
      searchTimer = setTimeout(() => doSearch(v), 180);
    });

    msgSearch.addEventListener('focus', () => {
      if (msgSearch.value.trim()) {
        msgSearchResults.hidden = false;
      } else {
        renderRecent();
      }
    });

    msgSearchClear.addEventListener('click', () => {
      msgSearch.value = '';
      msgSearch.dispatchEvent(new Event('input'));
      msgSearch.focus();
    });

    document.addEventListener('click', e => {
      if (!e.target.closest('.messenger-list-head')) {
        msgSearchResults.hidden = true;
      }
    });

    msgSearch.addEventListener('keydown', (e) => {
      if (msgSearchResults.hidden || !kbRows.length) {
        if (e.key === 'Enter' && kbRows.length === 1) kbRows[0].click();
        return;
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        kbIndex = Math.min(kbIndex + 1, kbRows.length - 1);
        updateKbActive();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        kbIndex = Math.max(kbIndex - 1, 0);
        updateKbActive();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (kbIndex >= 0 && kbRows[kbIndex]) kbRows[kbIndex].click();
        else if (kbRows.length === 1) kbRows[0].click();
      } else if (e.key === 'Escape') {
        msgSearch.value = '';
        msgSearch.dispatchEvent(new Event('input'));
        msgSearch.blur();
      }
    });

    function updateKbActive() {
      kbRows.forEach((r, i) => r.classList.toggle('kb-active', i === kbIndex));
      if (kbIndex >= 0 && kbRows[kbIndex]) kbRows[kbIndex].scrollIntoView({ block: 'nearest' });
    }

    msgSearchResults.addEventListener('click', (e) => {
      const row = e.target.closest('.msr-row');
      if (row) saveRecent(msgSearch.value);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== msgSearch && !e.target.matches('input,textarea')) {
        e.preventDefault();
        msgSearch.focus();
      }
    });

    // ── পোলিং: আনরিড + অনলাইন-ডট ──────────────────────────────────────
    async function pollList() {
      try {
        const r1 = await fetch('/api/messages/unread');
        const data = await r1.json();
        document.querySelectorAll('#convListDefault .conv-item').forEach(el => {
          const id = parseInt(el.dataset.id);
          const conv = data.conversations.find(c => c.id === id);
          let meta = el.querySelector('.conv-meta-right');
          if (!meta) return;
          let badge = meta.querySelector('.conv-unread');
          if (conv && conv.unread > 0) {
            if (!badge) { badge = document.createElement('span'); badge.className = 'conv-unread'; meta.appendChild(badge); }
            badge.textContent = conv.unread;
            el.dataset.unread = '1';
          } else if (badge) { badge.remove(); el.dataset.unread = '0'; }
        });

        const userIds = [...document.querySelectorAll('.online-dot')].map(d => d.dataset.userId).filter(Boolean);
        const unique = [...new Set(userIds)];
        await Promise.all(unique.map(async uid => {
          try {
            const r = await fetch('/api/messages/online?user_id=' + uid);
            const d = await r.json();
            document.querySelectorAll('.online-dot[data-user-id="' + uid + '"]').forEach(dot => {
              dot.style.display = d.online ? 'block' : 'none';
            });
          } catch {}
        }));
      } catch {}
    }
    setInterval(pollList, 8000);
    setTimeout(pollList, 1500);

    renderRecent();
  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>

<script>
  (function () {
    var t = document.getElementById('grpToggle'), f = document.getElementById('grpForm');
    if (t && f) t.addEventListener('click', function () { f.hidden = !f.hidden; if (!f.hidden) f.querySelector('input[name=title]').focus(); });
    document.querySelectorAll('[data-mfilter]').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('[data-mfilter]').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        var k = b.dataset.mfilter;
        document.querySelectorAll('#convListDefault .conv-item').forEach(function (it) {
          var show = k === 'all' || (k === 'unread' && it.dataset.unread === '1') || (k === 'groups' && it.dataset.group === '1');
          it.style.display = show ? '' : 'none';
        });
      });
    });
  })();
</script>
