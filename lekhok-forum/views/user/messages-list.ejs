<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'মেসেজ — লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css'] }) %>

  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-comment-dots"></i> মেসেজ</h1>
      <p class="page-subtitle">সবার সাথে কথা বলুন, ফাইল শেয়ার করুন</p>
    </div>

    <div class="messenger-shell" style="max-width:520px;margin:0 auto;grid-template-columns:1fr">
      <aside class="messenger-list">
        <div class="messenger-list-head">
          <h2><i class="fas fa-inbox"></i> কথোপকথন</h2>
          <input type="search" class="messenger-search" placeholder="🔍 নাম খুঁজুন..." id="convSearch" oninput="filterConvs(this.value)" />

          <%# ── নতুন কথোপকথন শুরু: যেকোনো সদস্যকে নাম লিখে খুঁজুন ── %>
          <div class="new-conv-box">
            <input type="search" class="messenger-search" id="userSearch" placeholder="➕ নতুন মেসেজ — নাম বা ইউজারনেম লিখুন..." autocomplete="off" />
            <div class="user-search-results" id="userSearchResults" hidden></div>
          </div>
        </div>
        <%# নতুন কথোপকথন: ইউজার-সার্চ UI উপরে new-conv-box-এ (userSearch + userSearchResults) — একক কপি %>
        <% if (conversations.length === 0) { %>
          <div class="empty-state-full">
            <i class="fas fa-comment-slash"></i>
            <p>কোনো কথোপকথন নেই।</p>
            <a href="/members" class="btn btn-primary btn-sm">সদস্য খুঁজুন</a>
          </div>
        <% } else { %>
          <% conversations.forEach(c => { %>
            <a href="/messages/<%= c.other_username %>" class="conv-item" data-name="<%= c.other_name.toLowerCase() %>" data-id="<%= c.id %>">
              <div class="avatar avatar-md" style="position:relative">
                <% if (c.other_avatar) { %>
                  <img src="<%= c.other_avatar %>" alt="<%= c.other_name %>" />
                <% } else { %>
                  <%= c.other_name.charAt(0).toUpperCase() %>
                <% } %>
                <span class="online-dot" data-user-id="<%= c.user_a === user.id ? c.user_b : c.user_a %>" style="display:none"></span>
              </div>
              <div class="conv-meta">
                <div class="conv-name"><%= c.other_name %></div>
                <div class="conv-snippet"><%= c.last_body ? c.last_body.replace(/<[^>]+>/g, '').slice(0, 50) : 'নতুন কথোপকথন' %></div>
              </div>
              <div class="conv-meta-right">
                <% if (c.unread_count > 0) { %><span class="conv-unread"><%= c.unread_count %></span><% } %>
              </div>
            </a>
          <% }); %>
        <% } %>
      </aside>
    </div>
  </div>

  <style>
    .new-conv-box { position: relative; margin-top: 8px; }
    .user-search-results {
      position: absolute; left: 0; right: 0; top: 100%;
      background: var(--card, #fff); border: 1px solid var(--border, #e5e7eb);
      border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      max-height: 320px; overflow-y: auto; z-index: 50;
    }
    .user-search-results .usr-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; cursor: pointer; text-decoration: none; color: inherit;
      border-bottom: 1px solid var(--border, #f1f5f9);
    }
    .user-search-results .usr-row:last-child { border-bottom: 0; }
    .user-search-results .usr-row:hover { background: var(--accent-soft, rgba(5,150,105,0.08)); }
    .user-search-results .usr-avatar {
      width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex: 0 0 36px;
      background: var(--accent-soft, #e5e7eb); display:flex; align-items:center; justify-content:center;
      font-weight: 600; color: var(--accent, #059669);
    }
    .user-search-results .usr-meta { flex: 1; min-width: 0; }
    .user-search-results .usr-name { font-weight: 600; }
    .user-search-results .usr-sub { font-size: 12px; color: var(--text-muted, #64748b); }
    .user-search-results .empty { padding: 14px; color: var(--text-muted, #64748b); text-align: center; font-size: 14px; }
  </style>

  <script>
    function filterConvs(q) {
      q = (q || '').toLowerCase().trim();
      document.querySelectorAll('.conv-item').forEach(el => {
        el.style.display = !q || el.dataset.name.indexOf(q) !== -1 ? 'flex' : 'none';
      });
    }

    // ── User search (new conversation) ──────────────────────────────────
    const userSearch = document.getElementById('userSearch');
    const userResults = document.getElementById('userSearchResults');
    let searchTimer = null;
    let lastQuery = '';

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function renderResults(users) {
      if (!users || !users.length) {
        userResults.innerHTML = '<div class="empty">কোনো সদস্য পাওয়া যায়নি</div>';
        userResults.hidden = false;
        return;
      }
      const html = users.map(u => {
        const avatar = u.avatar_url
          ? `<img class="usr-avatar" src="${escapeHtml(u.avatar_url)}" onerror="this.onerror=null;this.outerHTML='<div class=\\'usr-avatar\\'>${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>'" />`
          : `<div class="usr-avatar">${escapeHtml((u.full_name||u.username||'?').charAt(0).toUpperCase())}</div>`;
        const sub = [u.designation, '@' + u.username].filter(Boolean).join(' • ');
        return `<a class="usr-row" href="/messages/${encodeURIComponent(u.username)}">${avatar}<div class="usr-meta"><div class="usr-name">${escapeHtml(u.full_name || u.username)}</div><div class="usr-sub">${escapeHtml(sub)}</div></div><i class="fas fa-chevron-right" style="color:var(--text-muted)"></i></a>`;
      }).join('');
      userResults.innerHTML = html;
      userResults.hidden = false;
    }

    async function doUserSearch(q) {
      q = (q || '').trim();
      if (q === lastQuery) return;
      lastQuery = q;
      if (q.length < 1) { userResults.hidden = true; userResults.innerHTML = ''; return; }
      try {
        const r = await fetch('/api/users/search?q=' + encodeURIComponent(q));
        const data = await r.json();
        renderResults(data.users || []);
      } catch (e) {
        userResults.innerHTML = '<div class="empty">অনুসন্ধান ব্যর্থ হয়েছে</div>';
        userResults.hidden = false;
      }
    }

    userSearch?.addEventListener('input', () => {
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => doUserSearch(userSearch.value), 200);
    });
    userSearch?.addEventListener('focus', () => {
      if (userSearch.value.trim().length >= 1 && userResults.innerHTML) userResults.hidden = false;
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('.new-conv-box')) userResults.hidden = true;
    });

    // 5s polling for unread counts + online dots
    async function pollList() {
      try {
        const r1 = await fetch('/api/messages/unread');
        const data = await r1.json();
        document.querySelectorAll('.conv-item').forEach(el => {
          const id = parseInt(el.dataset.id);
          const conv = data.conversations.find(c => c.id === id);
          let meta = el.querySelector('.conv-meta-right');
          if (!meta) return;
          let badge = meta.querySelector('.conv-unread');
          if (conv && conv.unread > 0) {
            if (!badge) { badge = document.createElement('span'); badge.className = 'conv-unread'; meta.appendChild(badge); }
            badge.textContent = conv.unread;
          } else if (badge) badge.remove();
        });

        // Check online status for each visible user
        const userIds = [...document.querySelectorAll('.online-dot')].map(d => d.dataset.userId).filter(Boolean);
        const unique = [...new Set(userIds)];
        await Promise.all(unique.map(async uid => {
          try {
            const r = await fetch('/api/messages/online?user_id=' + uid);
            const d = await r.json();
            document.querySelectorAll('.online-dot[data-user-id="' + uid + '"]').forEach(dot => {
              dot.style.display = d.online ? 'block' : 'none';
            });
          } catch (e) {}
        }));
      } catch (e) {}
    }
    setInterval(pollList, 8000);
    setTimeout(pollList, 1500);
  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
