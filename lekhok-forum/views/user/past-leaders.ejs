<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'সাবেক সভাপতি ও সাধারণ সম্পাদক — বাংলাদেশ তরুণ কলাম লেখক ফোরাম' }) %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-history"></i> সাবেক সভাপতি ও সাধারণ সম্পাদক</h1>
    </div>

    <% if ((presidents || []).length === 0 && (secretaries || []).length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-history"></i><p>কোনো তথ্য যোগ করা হয়নি।</p></div>
    <% } else { %>
      <% if ((presidents || []).length > 0) { %>
        <h2 style="color:var(--brand);margin-bottom:14px">সাবেক সভাপতি</h2>
        <div class="past-leaders-grid">
          <% presidents.forEach(l => { %>
            <% const displayName = l.user_full_name || l.name; %>
            <% const displayImg  = l.user_avatar_url || l.photo_url || '/assets/avatars/male.svg'; %>
            <% if (l.user_username) { %>
              <a href="/profile/<%= l.user_username %>" class="leader-card linked-member">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সভাপতি</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> — <%= l.term_end %><% } %></p>
                  <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল দেখুন</span>
                </div>
              </a>
            <% } else { %>
              <div class="leader-card">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সভাপতি</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> — <%= l.term_end %><% } %></p>
                </div>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } %>

      <% if ((secretaries || []).length > 0) { %>
        <h2 style="color:var(--brand);margin:30px 0 14px">সাবেক সাধারণ সম্পাদক</h2>
        <div class="past-leaders-grid">
          <% secretaries.forEach(l => { %>
            <% const displayName = l.user_full_name || l.name; %>
            <% const displayImg  = l.user_avatar_url || l.photo_url || '/assets/avatars/male.svg'; %>
            <% if (l.user_username) { %>
              <a href="/profile/<%= l.user_username %>" class="leader-card linked-member">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সাধারণ সম্পাদক</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> — <%= l.term_end %><% } %></p>
                  <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল দেখুন</span>
                </div>
              </a>
            <% } else { %>
              <div class="leader-card">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সাধারণ সম্পাদক</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> — <%= l.term_end %><% } %></p>
                </div>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } %>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
