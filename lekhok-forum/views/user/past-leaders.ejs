<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'সাবেক সভাপতি ও সাধারণ সম্পাদক | লেখক ফোরাম' }) %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-history"></i> সাবেক সভাপতি ও সাধারণ সম্পাদক</h1>
    </div>

    <%# সেশন ৪৯: শর্তসাপেক্ষ সোশ্যাল আইকন (ফেসবুক/লিংকডইন) + বাণী %>
    <% function leaderSocialRow(l) {
         const fb = l.social_fb, li = l.social_linkedin;
         if (!fb && !li) return '';
         let h = '<div class="leader-social">';
         if (fb) h += '<a href="' + fb + '" target="_blank" rel="noopener noreferrer" class="leader-soc-fb" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>';
         if (li) h += '<a href="' + li + '" target="_blank" rel="noopener noreferrer" class="leader-soc-in" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>';
         h += '</div>';
         return h;
       } %>

    <% if ((presidents || []).length === 0 && (secretaries || []).length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-history"></i><p>কোনো তথ্য যোগ করা হয়নি।</p></div>
    <% } else { %>
      <% if ((presidents || []).length > 0) { %>
        <h2 style="color:var(--brand);margin-bottom:14px">সাবেক সভাপতি</h2>
        <div class="past-leaders-grid">
          <% presidents.forEach(l => { %>
            <% const displayName = l.user_full_name || l.name; %>
            <% const displayImg  = l.user_avatar_url || l.photo_url || '/assets/avatars/male.svg'; %>
            <% const displayBani = (l.message && String(l.message).trim()) ? String(l.message) : (l.bio || ''); %>
            <% if (l.user_username) { %>
              <div class="leader-card linked-member" data-href="/profile/<%= l.user_username %>">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সভাপতি</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> থেকে <%= l.term_end %><% } %></p>
                  <% if (displayBani) { %><p class="leader-bani"><%= displayBani.substring(0, 120) %><%= displayBani.length > 120 ? '…' : '' %></p><% } %>
                  <%- leaderSocialRow(l) %>
                  <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল দেখুন</span>
                </div>
              </div>
            <% } else { %>
              <div class="leader-card">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সভাপতি</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> থেকে <%= l.term_end %><% } %></p>
                  <% if (displayBani) { %><p class="leader-bani"><%= displayBani.substring(0, 120) %><%= displayBani.length > 120 ? '…' : '' %></p><% } %>
                  <%- leaderSocialRow(l) %>
                </div>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } %>

      <% if ((secretaries || []).length > 0) { %>
        <h2 style="color:var(--brand);margin:30px 0 14px">সাবেক সাধারণ সম্পাদক</h2>
        <div class="past-leaders-grid">
          <% secretaries.forEach(l => { %>
            <% const displayName = l.user_full_name || l.name; %>
            <% const displayImg  = l.user_avatar_url || l.photo_url || '/assets/avatars/male.svg'; %>
            <% const displayBani = (l.message && String(l.message).trim()) ? String(l.message) : (l.bio || ''); %>
            <% if (l.user_username) { %>
              <div class="leader-card linked-member" data-href="/profile/<%= l.user_username %>">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সাধারণ সম্পাদক</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> থেকে <%= l.term_end %><% } %></p>
                  <% if (displayBani) { %><p class="leader-bani"><%= displayBani.substring(0, 120) %><%= displayBani.length > 120 ? '…' : '' %></p><% } %>
                  <%- leaderSocialRow(l) %>
                  <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল দেখুন</span>
                </div>
              </div>
            <% } else { %>
              <div class="leader-card">
                <img loading="lazy" decoding="async" src="<%= displayImg %>" class="leader-photo" alt="<%= displayName %>">
                <div class="leader-info">
                  <div class="leader-role">সাধারণ সম্পাদক</div>
                  <h3><%= displayName %></h3>
                  <p class="leader-term"><i class="far fa-calendar"></i> <%= l.term_start %><% if (l.term_end) { %> থেকে <%= l.term_end %><% } %></p>
                  <% if (displayBani) { %><p class="leader-bani"><%= displayBani.substring(0, 120) %><%= displayBani.length > 120 ? '…' : '' %></p><% } %>
                  <%- leaderSocialRow(l) %>
                </div>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } %>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
