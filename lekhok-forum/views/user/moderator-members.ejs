<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>কমিটি সদস্য ব্যবস্থাপনা | মডারেটর প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body>
<%- include('../../admin/views/admin/partials/sidebar') %>
<div class="admin-main">
<div class="mod-page">
  <div class="mod-hero">
    <div>
      <h1><i class="fas fa-users-cog"></i> কমিটি সদস্য ব্যবস্থাপনা</h1>
      <p>কার্যনির্বাহী কমিটি ও উপদেষ্টা পর্ষদের সদস্য, পদ ও কার্যবর্ষ যোগ / সম্পাদনা / মুছুন</p>
    </div>
    <a href="/moderator" class="mod-back-btn"><i class="fas fa-arrow-left"></i> প্যানেলে ফিরুন</a>
  </div>

  <% if (posted) { %><div class="mod-flash ok"><i class="fas fa-check-circle"></i> সফলভাবে সংরক্ষিত হয়েছে। সাইটে সাথে সাথে প্রযোজ্য।</div><% } %>
  <label style="font-size:.85rem;font-weight:600;color:#65676b;display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-left:10px;"><input type="checkbox" data-bulk-all style="width:16px;height:16px;"> সব সিলেক্ট</label>
  <form method="POST" action="/moderator/members/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড সদস্যদের মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
  </form>
  <% if (removed) { %><div class="mod-flash ok"><i class="fas fa-trash-alt"></i> সদস্য মুছে ফেলা হয়েছে।</div><% } %>
  <% if (error) { %><div class="mod-flash err"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

  <%# ── নতুন সদস্য যোগ ── %>
  <div class="mod-card">
    <h2><i class="fas fa-user-plus"></i> নতুন সদস্য যোগ করুন</h2>
    <p class="mod-hint">
      <strong>কার্যবর্ষ</strong> ঘরে যে বছরে সদস্য যুক্ত হয়েছেন সেটি লিখুন (যেমন <code>২০২৪-২৫</code>)।
      এটি পাবলিক পেজ ও প্রোফাইলে দেখা যাবে। ঐচ্ছিক <strong>ইউজারনেম</strong> দিলে সদস্যের সাইট অ্যাকাউন্টের সাথে যুক্ত হবে।
    </p>
    <form method="POST" action="/moderator/members">
      <div class="mem-grid">
        <div class="mem-field"><label>নাম *</label><input type="text" name="name" required maxlength="120" placeholder="সদস্যের পূর্ণ নাম" /></div>
        <div class="mem-field"><label>পদ (রোল)</label><input type="text" name="role" maxlength="120" placeholder="যেমন: সভাপতি / সাধারণ সম্পাদক (উপদেষ্টা → উপদেষ্টা পরিষদ ধরন)" /></div>
        <div class="mem-field"><label>শ্রেণি / বিভাগ</label><input type="text" name="designation" maxlength="160" placeholder="যেমন: সদস্য / ডেপার্টমেন্ট" /></div>
        <div class="mem-field"><label>কার্যবর্ষ</label><input type="text" name="term_year" maxlength="40" placeholder="যেমন: ২০২৪-২৫" /></div>
        <div class="mem-field"><label>ধরন</label>
          <select name="member_type">
            <option value="central">কার্যনির্বাহী কমিটি</option>
            <option value="advisory">উপদেষ্টা পর্ষদ</option>
          </select>
        </div>
        <div class="mem-field"><label>প্রদর্শন ক্রম</label><input type="number" name="sort_order" min="0" value="0" /></div>
        <div class="mem-field"><label>ছবি URL</label><input type="text" name="image_url" maxlength="400" placeholder="https://… (ঐচ্ছিক)" /></div>
        <div class="mem-field"><label>ফেসবুক লিংক</label><input type="text" name="social_fb" maxlength="300" placeholder="https://facebook.com/… (ঐচ্ছিক)" /></div>
        <div class="mem-field"><label>ইমেইল</label><input type="text" name="social_email" maxlength="160" placeholder="ঐচ্ছিক" /></div>
        <div class="mem-field"><label>ইউজারনেম (অ্যাকাউন্ট লিংক)</label><input type="text" name="username" maxlength="60" placeholder="সাইট অ্যাকাউন্ট থাকলে (ঐচ্ছিক)" /></div>
        <div class="mem-field" style="grid-column: 1 / -1;"><label>সংক্ষিপ্ত পরিচিতি</label><textarea name="bio" maxlength="1200" placeholder="ঐচ্ছিক, সদস্যের সংক্ষিপ্ত বর্ণনা"></textarea></div>
      </div>
      <div class="mem-actions">
        <button type="submit" class="mod-back-btn" style="background:#059669;border-color:#059669;"><i class="fas fa-plus"></i> সদস্য যোগ করুন</button>
      </div>
    </form>
  </div>

  <% const central = members.filter(m => m.member_type === 'central');
     const advisory = members.filter(m => m.member_type !== 'central'); %>

  <%# ── কার্যনির্বাহী কমিটি তালিকা ── %>
  <div class="mod-card">
    <h2><i class="fas fa-users-cog"></i> কার্যনির্বাহী কমিটি <span class="mem-section-count"><%= central.length %> জন</span></h2>
    <p class="mod-hint">যেকোনো সদস্যের নামে ক্লিক করে সম্পাদনা করুন। "কার্যবর্ষ" বদলালে সেই বছরের তালিকায় স্বয়ংক্রিয়ভাবে চলে যাবে।</p>
    <% if (!central.length) { %><p class="mod-hint"><i class="fas fa-info-circle"></i> এখনো কোনো সদস্য নেই।</p><% } %>
    <% central.forEach(m => { %>
      <details class="mem-row">
        <summary>
          <input type="checkbox" name="bulk_ids" value="<%= m.id %>" aria-label="সিলেক্ট" style="width:16px;height:16px;flex-shrink:0;margin-right:2px;">
          <i class="fas fa-chevron-right mem-chevron"></i>
          <img class="mem-thumb" src="<%= m.image_url || '/assets/img/avatar-placeholder.svg' %>" alt="" loading="lazy" decoding="async" onerror="this.src='/assets/img/avatar-placeholder.svg'" />
          <div>
            <div class="mem-name"><%= m.name %></div>
            <div class="mem-sub"><%= [m.role, m.term_year].filter(Boolean).join(' · ') || 'পদ নেই' %></div>
          </div>
          <span class="mem-chip"><%= m.term_year || 'কার্যবর্ষ নেই' %></span>
        </summary>
        <div style="padding:16px 14px;">
          <form method="POST" action="/moderator/members/<%= m.id %>">
            <div class="mem-grid">
              <div class="mem-field"><label>নাম *</label><input type="text" name="name" required maxlength="120" value="<%= m.name %>" /></div>
              <div class="mem-field"><label>পদ (রোল)</label><input type="text" name="role" maxlength="120" value="<%= m.role || '' %>" /></div>
              <div class="mem-field"><label>শ্রেণি / বিভাগ</label><input type="text" name="designation" maxlength="160" value="<%= m.designation || '' %>" /></div>
              <div class="mem-field"><label>কার্যবর্ষ</label><input type="text" name="term_year" maxlength="40" value="<%= m.term_year || '' %>" /></div>
              <div class="mem-field"><label>ধরন</label>
                <select name="member_type">
                  <option value="central" <%= m.member_type === 'central' ? 'selected' : '' %>>কার্যনির্বাহী কমিটি</option>
                  <option value="advisory" <%= m.member_type !== 'central' ? 'selected' : '' %>>উপদেষ্টা পর্ষদ</option>
                </select>
              </div>
              <div class="mem-field"><label>প্রদর্শন ক্রম</label><input type="number" name="sort_order" min="0" value="<%= m.sort_order || 0 %>" /></div>
              <div class="mem-field"><label>ছবি URL</label><input type="text" name="image_url" maxlength="400" value="<%= m.image_url || '' %>" /></div>
              <div class="mem-field"><label>ফেসবুক লিংক</label><input type="text" name="social_fb" maxlength="300" value="<%= m.social_fb || '' %>" /></div>
              <div class="mem-field"><label>ইমেইল</label><input type="text" name="social_email" maxlength="160" value="<%= m.social_email || '' %>" /></div>
              <div class="mem-field"><label>ইউজারনেম (অ্যাকাউন্ট লিংক)</label><input type="text" name="username" maxlength="60" value="<%= m.user_username || '' %>" placeholder="বদলাতে চাইলে নতুন ইউজারনেম" /></div>
              <div class="mem-field" style="grid-column: 1 / -1;"><label>সংক্ষিপ্ত পরিচিতি</label><textarea name="bio" maxlength="1200"><%= m.bio || '' %></textarea></div>
            </div>
            <div class="mem-actions">
              <button type="submit" class="mod-back-btn" style="background:#059669;border-color:#059669;"><i class="fas fa-save"></i> সংরক্ষণ করুন</button>
              <button type="submit" class="mem-del" formaction="/moderator/members/<%= m.id %>/delete" formnovalidate><i class="fas fa-trash-alt"></i> মুছে ফেলুন</button>
            </div>
          </form>
        </div>
      </details>
    <% }) %>
  </div>

  <%# ── উপদেষ্টা পর্ষদ তালিকা ── %>
  <div class="mod-card">
    <h2><i class="fas fa-user-tie"></i> উপদেষ্টা পর্ষদ <span class="mem-section-count"><%= advisory.length %> জন</span></h2>
    <p class="mod-hint">উপদেষ্টাদের তথ্য এখান থেকে সম্পাদনা করুন। /committee/advisory পেজে সাথে সাথে প্রযোজ্য হবে।</p>
    <% if (!advisory.length) { %><p class="mod-hint"><i class="fas fa-info-circle"></i> এখনো কোনো উপদেষ্টা নেই।</p><% } %>
    <% advisory.forEach(m => { %>
      <details class="mem-row">
        <summary>
          <input type="checkbox" name="bulk_ids" value="<%= m.id %>" aria-label="সিলেক্ট" style="width:16px;height:16px;flex-shrink:0;margin-right:2px;">
          <i class="fas fa-chevron-right mem-chevron"></i>
          <img class="mem-thumb" src="<%= m.image_url || '/assets/img/avatar-placeholder.svg' %>" alt="" loading="lazy" decoding="async" onerror="this.src='/assets/img/avatar-placeholder.svg'" />
          <div>
            <div class="mem-name"><%= m.name %></div>
            <div class="mem-sub"><%= [m.role, m.term_year].filter(Boolean).join(' · ') || 'পদ নেই' %></div>
          </div>
          <span class="mem-chip adv"><%= m.term_year || 'কার্যবর্ষ নেই' %></span>
        </summary>
        <div style="padding:16px 14px;">
          <form method="POST" action="/moderator/members/<%= m.id %>">
            <div class="mem-grid">
              <div class="mem-field"><label>নাম *</label><input type="text" name="name" required maxlength="120" value="<%= m.name %>" /></div>
              <div class="mem-field"><label>পদ (রোল)</label><input type="text" name="role" maxlength="120" value="<%= m.role || '' %>" /></div>
              <div class="mem-field"><label>শ্রেণি / বিভাগ</label><input type="text" name="designation" maxlength="160" value="<%= m.designation || '' %>" /></div>
              <div class="mem-field"><label>কার্যবর্ষ</label><input type="text" name="term_year" maxlength="40" value="<%= m.term_year || '' %>" /></div>
              <div class="mem-field"><label>ধরন</label>
                <select name="member_type">
                  <option value="central" <%= m.member_type === 'central' ? 'selected' : '' %>>কার্যনির্বাহী কমিটি</option>
                  <option value="advisory" <%= m.member_type !== 'central' ? 'selected' : '' %>>উপদেষ্টা পর্ষদ</option>
                </select>
              </div>
              <div class="mem-field"><label>প্রদর্শন ক্রম</label><input type="number" name="sort_order" min="0" value="<%= m.sort_order || 0 %>" /></div>
              <div class="mem-field"><label>ছবি URL</label><input type="text" name="image_url" maxlength="400" value="<%= m.image_url || '' %>" /></div>
              <div class="mem-field"><label>ফেসবুক লিংক</label><input type="text" name="social_fb" maxlength="300" value="<%= m.social_fb || '' %>" /></div>
              <div class="mem-field"><label>ইমেইল</label><input type="text" name="social_email" maxlength="160" value="<%= m.social_email || '' %>" /></div>
              <div class="mem-field"><label>ইউজারনেম (অ্যাকাউন্ট লিংক)</label><input type="text" name="username" maxlength="60" value="<%= m.user_username || '' %>" placeholder="বদলাতে চাইলে নতুন ইউজারনেম" /></div>
              <div class="mem-field" style="grid-column: 1 / -1;"><label>সংক্ষিপ্ত পরিচিতি</label><textarea name="bio" maxlength="1200"><%= m.bio || '' %></textarea></div>
            </div>
            <div class="mem-actions">
              <button type="submit" class="mod-back-btn" style="background:#059669;border-color:#059669;"><i class="fas fa-save"></i> সংরক্ষণ করুন</button>
              <button type="submit" class="mem-del" formaction="/moderator/members/<%= m.id %>/delete" formnovalidate><i class="fas fa-trash-alt"></i> মুছে ফেলুন</button>
            </div>
          </form>
        </div>
      </details>
    <% }) %>
  </div>
</div>
</div><!-- /admin-main -->
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
