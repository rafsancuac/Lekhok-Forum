<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <title>প্রোফাইল সম্পাদনা | বাংলাদেশ তরুণ কলাম লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/auth.css" />
</head>
<body>
  <div class="auth-card" style="max-width: 600px;">
    <a href="/profile/<%= user.username %>" class="back-home"><i class="fas fa-arrow-left"></i> প্রোফাইলে ফিরে যান</a>
    <h1>প্রোফাইল সম্পাদনা</h1>
    <p class="sub">@<%= user.username %></p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" enctype="multipart/form-data">
      <div class="form-group"><label>পূর্ণ নাম *</label><input type="text" name="full_name" value="<%= user.full_name %>" required></div>
      <div class="form-row">
        <div class="form-group"><label>ইমেইল</label><input type="email" name="email" value="<%= user.email || '' %>"></div>
        <div class="form-group"><label>মোবাইল</label><input type="tel" name="phone" value="<%= user.phone || '' %>"></div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>লিঙ্গ</label>
          <select name="gender">
            <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>পুরুষ</option>
            <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>নারী</option>
            <option value="other" <%= user.gender === 'other' ? 'selected' : '' %>>অন্যান্য</option>
          </select>
        </div>
        <div class="form-group"><label>জন্ম তারিখ</label><input type="date" name="birth_date" value="<%= user.birth_date || '' %>"></div>
      </div>
      <div class="form-group">
        <label>প্রোফাইল ছবি</label>
        <div style="display:flex; align-items:center; gap:12px;">
          <img loading="lazy" decoding="async" src="<%= user.avatar_url || '/avatar/' + user.id %>" alt="" style="width:48px;height:48px;border-radius:50%;object-fit:cover;">
          <input type="file" name="avatar" accept="image/*" style="flex:1;">
        </div>
      </div>
      <div class="form-group"><label>পদবি</label><input type="text" name="designation" value="<%= user.designation || '' %>"></div>
      <div class="form-group"><label>ঠিকানা</label><input type="text" name="address" value="<%= user.address || '' %>"></div>
      <div class="form-group"><label>বায়ো</label><textarea name="bio" rows="3"><%= user.bio || '' %></textarea></div>
      <h3 style="color:#0a1f44; margin: 16px 0 8px; font-size: 1rem;">সোশ্যাল মিডিয়া</h3>
      <div class="form-row">
        <div class="form-group"><label>Facebook</label><input type="url" name="social_fb" value="<%= user.social_fb || '' %>"></div>
        <div class="form-group"><label>Twitter / X</label><input type="url" name="social_twitter" value="<%= user.social_twitter || '' %>"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>LinkedIn</label><input type="url" name="social_linkedin" value="<%= user.social_linkedin || '' %>"></div>
        <div class="form-group"><label>ওয়েবসাইট</label><input type="url" name="social_website" value="<%= user.social_website || '' %>"></div>
      </div>
      <h3 style="color:#0a1f44; margin: 16px 0 8px; font-size: 1rem;">পাসওয়ার্ড পরিবর্তন</h3>
      <div class="form-group"><label>নতুন পাসওয়ার্ড (খালি রাখলে পরিবর্তন হবে না)</label><input type="password" name="new_password" minlength="6" autocomplete="new-password"></div>
      <div class="form-group"><label>পাসওয়ার্ড নিশ্চিত করুন</label><input type="password" name="confirm_password" autocomplete="new-password"></div>
      <h3 style="color:#0a1f44; margin: 16px 0 8px; font-size: 1rem;">প্রাইভেসি</h3>
      <div class="checkbox-group"><input type="checkbox" id="show_email" name="show_email" value="1" <%= user.show_email ? 'checked' : '' %>><label for="show_email">প্রোফাইলে ইমেইল দেখান</label></div>
      <div class="checkbox-group"><input type="checkbox" id="show_phone" name="show_phone" value="1" <%= user.show_phone ? 'checked' : '' %>><label for="show_phone">প্রোফাইলে ফোন নম্বর দেখান</label></div>
      <div class="checkbox-group"><input type="checkbox" id="show_birth" name="show_birth" value="1" <%= user.show_birth ? 'checked' : '' %>><label for="show_birth">জন্মদিন পাবলিক করুন (জন্মদিনের শুভেচ্ছা পেতে)</label></div>
      <button type="submit" class="btn-primary">সংরক্ষণ করুন</button>
    </form>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
