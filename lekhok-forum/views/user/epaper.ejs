  }
  if (elPsBtn) elPsBtn.addEventListener('click', function () { ep282Open ? ps282Close() : ps282OpenPanel(); });
  if (elPsSearch) elPsSearch.addEventListener('input', function () {
    ep282Q = elPsSearch.value;
    if (elPsClear) elPsClear.hidden = !ep282Q;
