<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>আজকের ই-পেপার — লেখক ফোরাম</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <div class="page-wrap" style="max-width:700px">
    <div class="page-header">
      <h1><i class="fas fa-newspaper"></i> আজকের ই-পেপার</h1>
      <span class="today-date"><i class="far fa-calendar"></i> <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    </div>

    <% if (today) { %>
      <div class="daily-card epaper-card">
        <div class="daily-card-badge epaper"><i class="fas fa-newspaper"></i> ই-পেপার</div>
        <h2><%= today.title %></h2>
        <p class="daily-body"><%= today.body %></p>
        <% if (today.link_url) { %>
          <a href="<%= today.link_url %>" class="btn-primary-sm" target="_blank">
            <i class="fas fa-external-link-alt"></i> ই-পেপার পড়ুন
          </a>
        <% } %>
        <% if (today.image_url) { %>
          <img src="<%= today.image_url %>" alt="epaper" style="max-width:100%;border-radius:8px;margin:12px 0">
        <% } %>
        <div class="daily-meta">প্রকাশ: <%= new Date(today.created_at).toLocaleDateString('bn-BD') %></div>
      </div>
    <% } else { %>
      <div class="empty-state-full">
        <i class="fas fa-newspaper"></i>
        <p>আজকের ই-পেপার এখনো যোগ করা হয়নি।</p>
      </div>
    <% } %>
  </div>
  <script src="/assets/js/main.js"></script>
</body>
</html>
