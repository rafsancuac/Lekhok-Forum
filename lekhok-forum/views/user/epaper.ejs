  });
  if (elPaperSel) elPaperSel.addEventListener('change', ps282SyncLabel);
  if (elPsWrap) elPsWrap.classList.add('ep282-armed');
  ps282SyncLabel();
  /* session282 QA-হুক (__ep282QA — সারফেস-নেমস্পেস-রীতি; কম্বো-প্রমাণ) */
  window.__ep282QA = {
    isOpen: function () { return ep282Open; },
    visible: function () { return ep282VisibleN; },
    query: function () { return ep282Q; },
    picked: function () { return ep282Picked; },
    active: function () { return ep282Active; },
    open: function () { ps282OpenPanel(); },
    close: function () { ps282Close(); },
    render: function () { ps282Render(); },
    pick: function (i) { var v = ps282Vis()[i]; if (v) ps282Pick(v.getAttribute('data-v')); },
    label: function () { return elPsLabel ? elPsLabel.textContent : ''; },
    options: function () { return elPaperSel ? elPaperSel.options.length : 0; }
  };
})();
</script>
