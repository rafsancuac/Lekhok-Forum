  });
  if (elPsSearch) elPsSearch.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowDown') { e.preventDefault(); ps282Activate(ep282Active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); ps282Activate(ep282Active - 1); }
    else if (e.key === 'Enter') {
