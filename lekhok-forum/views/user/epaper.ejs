  function warmOne(p) {
    if (alive.get(p.fid) || (reader && reader.fid === p.fid)) {
      warmState[p.fid] = 'done'; markWarm(p.id, 'done'); return Promise.resolve();
    }
    warmState[p.fid] = 'busy';
    markWarm(p.id, 'busy');
    var load = bytesCache[p.fid]
      ? Promise.resolve(bytesCache[p.fid])
      : loadPdfJs().then(function () {
          // ক্লিন-প্রক্সি (?v=4) — সার্ভার-ক্লিন-ক্যাশও উষ্ণ হয়, পরের-পাঠকও লাভবান
          return fetch('/api/epaper/file/' + encodeURIComponent(p.fid) + '?v=4').then(function (r) {
            if (!r.ok) throw new Error('warm-http-' + r.status);
            return r.arrayBuffer();
          });
        });
    return load.then(function (buf) {
      if (warmState[p.fid] !== 'busy') return;
      return window.pdfjsLib.getDocument({ data: new Uint8Array(buf.slice(0)) }).promise.then(function (doc) {
        // মাঝপথে-ইউজার-ক্লিকে openReader-নিজেই বানিয়ে নিতে পারে — ডুপ্লিকেট-doc-রোধ
        if (warmState[p.fid] !== 'busy' || alive.get(p.fid) || (reader && reader.fid === p.fid)) {
          try { doc.destroy(); } catch (e) {}
          if (alive.get(p.fid) || (reader && reader.fid === p.fid)) { warmState[p.fid] = 'done'; markWarm(p.id, 'done'); }
          return;
        }
        var pst = { fid: p.fid, abort: new AbortController(), doc: doc, io: null };
        buildPages(pst, p, { detach: true, preRender: LOWMEM ? 0 : 1 });
        warmState[p.fid] = 'done';
        if (bytesCache[p.fid]) delete bytesCache[p.fid]; // doc-নিজের-ডাটা-ধারণ করে — বাইট-ডুপ্লিকেট-মুক্ত
        markWarm(p.id, 'done');
        updateWarmBar();
      });
    });
  }
  // তালিকা-আইটেমে প্রস্তুত-চিপ লাইভ-প্যাচ (renderList-রিবিল্ট ছাড়া — স্ক্রল/ফোকাস-নিরাপদ)
  function markWarm(id, state) {
    var btn = elList.querySelector('.ep-item[data-id="' + id + '"]');
    if (!btn) return;
    var meta = btn.querySelector('.ep-item-meta');
    if (!meta) return;
    var chip = meta.querySelector('.ep-warmchip');
    var html = state === 'busy'
      ? '<i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>প্রস্তুত হচ্ছে'
      : '<i class="fas fa-bolt" aria-hidden="true"></i>প্রস্তুত';
    var cls = state === 'busy' ? 'ep-warmchip is-busy' : 'ep-warmchip';
    if (!chip) {
      chip = document.createElement('span');
      meta.appendChild(chip);
    }
    chip.className = cls;
    chip.innerHTML = html;
  }
  function unmarkWarm(id) {
    var btn = elList.querySelector('.ep-item[data-id="' + id + '"]');
    if (!btn) return;
    var chip = btn.querySelector('.ep-warmchip');
    if (chip) chip.remove();
  }
  // সাইড-প্যানেল ওয়ার্ম-স্ট্যাটাস বার — "সব সংখ্যা প্রস্তুত" অবধি অগ্রগতি
  function updateWarmBar() {
    var bar = document.getElementById('epWarmBar');
    if (!bar) return;
    var d = elDate.value;
    var rows = (byDate[d] || []).filter(function (p) { return p.fid; });
    if (rows.length <= 1) { bar.hidden = true; return; }
    var done = rows.filter(function (p) { return warmState[p.fid] === 'done' || alive.get(p.fid); }).length;
    var total = Math.min(rows.length, Math.max(warmCapNow(), done));
    var fill = document.getElementById('epWarmFill');
    var txt = document.getElementById('epWarmTxt');
    if (fill) fill.style.width = Math.round((done / total) * 100) + '%';
    if (done >= total) {
      bar.classList.add('is-done');
      if (txt) txt.textContent = 'সব সংখ্যা প্রস্তুত — যে-কোনোটায় তাৎক্ষণিক পড়ুন';
    } else {
      bar.classList.remove('is-done');
      if (txt) txt.textContent = 'বাকি পত্রিকাগুলোও আগে থেকেই প্রস্তুত হচ্ছে… ' + bnDigits(done) + ' / ' + bnDigits(total);
    }
    bar.hidden = false;
  }
  setTimeout(queueWarm, 3500); // প্রথম-পত্রিকার নিজস্ব-লোড শান্ত হওয়ার পর
  // প্রতি-২৫সে: নেটওয়ার্ক-এররে বাদ-পড়াগুলোর পুনঃচেষ্টা + প্রস্তুতি-নিশ্চিতকরণ (সস্তা-নো-ওপ)
  setInterval(function () { if (!warmRunning) queueWarm(); }, 25000);

  // ── ইভেন্ট ──
  elList.addEventListener('click', function (e) {
    var back = e.target.closest('[data-back]');
    if (back) { elDate.value = todayIso; renderList(); queueWarm(); return; }
    var it = e.target.closest('.ep-item');
    if (it) select(Number(it.getAttribute('data-id')));
  });
  // session179: সার্চ-ইনপুট (মাস-ড্রপডাউন/চিপসের বদলে) — টাইপ-সাথে-সাথে তালিকা ফিল্টার
  // session182: ক্লিয়ার-বাটন টগল
  if (elSearch) elSearch.addEventListener('input', function () {
    searchTerm = elSearch.value || '';
    if (elSearchClear) elSearchClear.hidden = !searchTerm;
    renderList();
  });
  if (elSearchClear) elSearchClear.addEventListener('click', function () {
    elSearch.value = '';
    searchTerm = '';
    elSearchClear.hidden = true;
    renderList();
    elSearch.focus();
  });
  // session182: দিন-পরিবর্তনে সেই-দিনের সব-পত্রিকার প্রস্তুতি-পুনরারম্ভ
  elDate.addEventListener('change', function () { renderList(); queueWarm(); });
  document.getElementById('epTodayBtn').addEventListener('click', function () {
    elDate.value = todayIso; renderList(); queueWarm();
  });
  elReader.addEventListener('click', function () { setMode('reader'); });
  elThumb.addEventListener('click', function () { setMode('thumb'); });
  // ── সেশন ১৭১: জুম-ইন/আউট/রিসেট + রোটেট + ফুলস্ক্রিন-ইভেন্ট (সব-মোডে প্রযোজ্য) ──
  document.getElementById('epZoomIn').addEventListener('click', function () { zoomStep(1); });
  document.getElementById('epZoomOut').addEventListener('click', function () { zoomStep(-1); });
  document.getElementById('epZoomReset').addEventListener('click', resetView);
  document.getElementById('epRotate').addEventListener('click', function () {
    rotation = (rotation + 90) % 360; applyStageTransform(); centerStage();
  });
  document.getElementById('epFs').addEventListener('click', toggleFs);
  ['fullscreenchange', 'webkitfullscreenchange'].forEach(function (ev) {
    document.addEventListener(ev, function () {
      var fs = !!(document.fullscreenElement || document.webkitFullscreenElement);
      if (elViewer) elViewer.classList.toggle('is-fs', fs);
      if (elFsIcon) elFsIcon.className = fs ? 'fas fa-compress' : 'fas fa-expand';
    });
  });
  // ── session183: টাচপ্যাড-পিঞ্চ / ctrl+wheel / মাউস-জেসচার জুম ──
  //  (ইউজার-স্পেক: "হেন্ড-গেসচার ব্যবহার করে টাচ প্যাড দিয়ে পেপার বড় ছোট করে মন মত পড়া")
  //  · Win/Linux Chrome-Edge-Firefox-এ টাচপ্যাড-পিঞ্চ = ctrlKey-সহ wheel-ইভেন্ট —
  //    preventDefault করে ব্রাউজার-পেজ-জুম আটকে নিজস্ব স্মুথ-জুম (magnitude-অনুপাতে)
  //  · macOS Safari = gesturestart/gesturechange (scale-অনুপাত)
  //  · মাউস = ctrl+wheel নচ; ডাবল-ক্লিকে ১০০%↔২০০% টগল
  //  · জুমের-সময় ভিউ-অ্যাংকর (setZoom) — পড়া-অংশ চোখের-সামনেই থাকে
  elStage.addEventListener('wheel', function (e) {
    if (!(e.ctrlKey || e.metaKey)) return;
    e.preventDefault();
    var mag = Math.min(26, Math.max(4, Math.abs(e.deltaY) * 0.14));
    setZoom(zoomLevel + (e.deltaY < 0 ? mag : -mag));
  }, { passive: false });
  var gestBase = 0;
  ['gesturestart', 'gesturechange', 'gestureend'].forEach(function (ev) {
    elStage.addEventListener(ev, function (e) {
      e.preventDefault();
      if (ev === 'gesturestart') gestBase = zoomLevel;
      else if (ev === 'gesturechange') setZoom(gestBase * (e.scale || 1));
    }, { passive: false });
  });
  elStage.addEventListener('dblclick', function (e) {
    if (e.target && e.target.closest && e.target.closest('.ep-frame')) return; // iframe-ফলব্যাকের নিজস্ব-ক্লিক অস্পৃশ্য
    setZoom(zoomLevel > 115 ? 100 : 200);
  });
  // ctrl/⌘ ধরলে স্টেজে zoom-কার্সার — জেসচার-আবিষ্কারযোগ্যতা
  function ctrlHover(on) { if (elStage) elStage.classList.toggle('is-ctrlhover', on); }
  document.addEventListener('keydown', function (e) { if (e.ctrlKey || e.metaKey) ctrlHover(true); });
  document.addEventListener('keyup', function (e) { if (!(e.ctrlKey || e.metaKey)) ctrlHover(false); });
  window.addEventListener('blur', function () { ctrlHover(false); });
  // কীবোর্ড-শর্টকাট: +/− জুম · r ঘোরান · f ফুলস্ক্রিন · 0 রিসেট (ইনপুট-ফোকাসে নিষ্ক্রিয়)
  document.addEventListener('keydown', function (e) {
    var t = e.target;
    if (t && /^(INPUT|SELECT|TEXTAREA)$/.test(t.tagName)) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === '+' || e.key === '=') { zoomStep(1); }
    else if (e.key === '-' || e.key === '_') { zoomStep(-1); }
    else if (e.key === 'r' || e.key === 'R') { rotation = (rotation + 90) % 360; applyStageTransform(); centerStage(); }
    else if (e.key === 'f' || e.key === 'F') { toggleFs(); }
    else if (e.key === '0') { resetView(); }
  });
  // আগের/পরের দিন — শুধু পত্রিকা-আছে-এমন দিনে লাফায়
  document.getElementById('epPrevDay').addEventListener('click', function () { stepDay(1); });
  document.getElementById('epNextDay').addEventListener('click', function () { stepDay(-1); });
  function stepDay(dir) {
    var cur = elDate.value;
    var idx = dates.indexOf(cur);
    if (idx < 0) { // বর্তমান-নির্বাচন তালিকায় নেই — দিক-অনুযায়ী নিকটতম
      idx = dir > 0 ? dates.findIndex(function (d) { return d < cur; }) : dates.findIndex(function (d) { return d <= cur; });
      if (idx < 0) idx = 0;
    }
    var nx = idx + dir;
    if (nx < 0 || nx >= dates.length) return;
    elDate.value = dates[nx];
    renderList();
    queueWarm();
  }

  // ── বুট: আজকের (বা সর্বশেষ সিঙ্কড) দিন + সেই-দিনের শীর্ষ-র‍্যাংকের পত্রিকা (session172) ──
  // session233-boot-hook: হোমের 'আজকের ই-পেপার' ব্যান্ডের deep-link /epaper?file=<id> —
  // সেই-পত্রিকার দিনে বুট করে সেটাকেই সরাসরি খুলে দেয়; id-অজানা/অনুপস্থিত হলে
  // ডিফল্ট-বুটে মসৃণ-ফলব্যাক (আজকের দিন, না-থাকলে সর্বশেষ সিঙ্কড দিন)।
  var bootFile = '';
  try { bootFile = new URLSearchParams(location.search).get('file') || ''; } catch (e) { bootFile = ''; }
  var bootPaper = bootFile ? papers.filter(function (p) { return String(p.id) === String(bootFile); })[0] : null;
  var bootDate = bootPaper
    ? String(bootPaper.date || '').slice(0, 10)
    : (dates.indexOf(todayIso) >= 0 ? todayIso : dates[0]);
  elDate.value = bootDate;
  var bootRows = (byDate[bootDate] || []).slice().sort(rankCmp);
  if (bootPaper) { select(bootPaper.id); }
  else if (bootRows.length) { select(bootRows[0].id); }
})();
</script>
<script src="/assets/js/main.js?v=<%= AV %>"></script>
<script src="/assets/js/premium.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
</body>
