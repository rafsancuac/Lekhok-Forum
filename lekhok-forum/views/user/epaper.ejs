  });
  if (elPsClear) elPsClear.addEventListener('click', function () {
    ep282Q = '';
    if (elPsSearch) { elPsSearch.value = ''; try { elPsSearch.focus(); } catch (e) {} }
    if (elPsClear) elPsClear.hidden = true;
    ps282Render();
  });
  if (elPsOpts) elPsOpts.addEventListener('click', function (e) {
    var b = e.target.closest('.ep-ps-opt'); if (!b) return;
    ps282Pick(b.getAttribute('data-v'));
  });
  document.addEventListener('click', function (e) {
    if (!ep282Open || !elPsWrap) return;
    if (elPsWrap.contains(e.target)) return;
