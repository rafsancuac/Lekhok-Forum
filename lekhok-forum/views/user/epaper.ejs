<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'আজকের ই-পেপার | লেখক ফোরাম' }) %>
  <div class="page-wrap" style="max-width:700px">
    <div class="page-header">
      <h1><i class="fas fa-newspaper"></i> আজকের ই-পেপার</h1>
      <span class="today-date"><i class="far fa-calendar"></i> <%= new Date().toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
    </div>

    <% if (today) { %>
      <div class="daily-card epaper-card">
        <div class="daily-card-badge epaper"><i class="fas fa-newspaper"></i> ই-পেপার</div>
        <h2><%= today.title %></h2>
        <p class="daily-body"><%= today.body %></p>
        <% if (today.link_url) { %>
          <a href="<%= today.link_url %>" class="btn-primary-sm" target="_blank" rel="noopener">
            <i class="fas fa-external-link-alt"></i> ই-পেপার পড়ুন
          </a>
        <% } %>
        <% if (today.images && today.images.length) { %>
          <div style="margin:12px 0;"><%- include('../partials/post-gallery', { images: today.images, alt: today.title, height: '300px', group: 'epaper-' + today.id }) %></div>
        <% } %>
        <div class="daily-meta">প্রকাশ: <%= new Date(today.created_at).toLocaleDateString('bn-BD') %></div>
      </div>
    <% } else { %>
      <div class="empty-state-full">
        <i class="fas fa-newspaper"></i>
        <p>আজকের ই-পেপার এখনো যোগ করা হয়নি।</p>
      </div>
    <% } %>

    <%# ── সেশন ৭৪: পূর্বের ই-পেপার আর্কাইভ — রুট এতদিন ৩০টি আইটেম এনে ব্যবহার করত না ── %>
    <% const epArch = (archive || []).filter(a => !today || a.id !== today.id); %>
    <% if (epArch.length) { %>
      <section class="daily-archive">
        <div class="section-head">
          <h2 class="section-title"><i class="fas fa-clock-rotate-left"></i> পূর্বের ই-পেপার</h2>
          <span class="daily-arch-count"><%= epArch.length %>টি সংখ্যা</span>
        </div>
        <div class="daily-arch-list">
          <% epArch.forEach(function(it, i) { %>
            <details class="daily-arch-item epaper-arch"<%= i === 0 && !today ? ' open' : '' %>>
              <summary>
                <span class="da-date"><i class="far fa-calendar"></i> <%= new Date(it.scheduled_date || it.created_at).toLocaleDateString('bn-BD') %></span>
                <span class="da-title"><%= it.title %></span>
                <i class="fas fa-chevron-down da-chev"></i>
              </summary>
              <div class="da-body">
                <% if (it.images && it.images.length) { %>
                  <div class="da-thumbs">
                    <% it.images.slice(0, 3).forEach(function(src) { %>
                      <img src="<%= src %>" alt="<%= it.title %>" loading="lazy" class="da-thumb" />
                    <% }) %>
                  </div>
                <% } %>
                <p class="da-text"><%= it.body %></p>
                <% if (it.link_url) { %>
                  <a href="<%= it.link_url %>" class="da-link" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> সেই সংখ্যাটি পড়ুন</a>
                <% } %>
              </div>
            </details>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
  <script src="/assets/js/post-gallery.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
