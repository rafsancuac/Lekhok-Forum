<%# ── টু-প্যানেল ই-পেপার আর্কাইভ (session170) ───────────────────────────────
    বাম: তারিখ/মাস-ফিল্টার + পত্রিকা-তালিকা (থাম্বনেইলসহ) │ ডান: ডিজিটাল-রিডার (session১৭৩-থেকে-ডিফল্ট)/প্রচ্ছদ
    ডাটা: epaper_files (বট-সিঙ্কড, আসল-নাম); খালি হলে legacy daily_content-ফলব্যাক ── %>
<%- include('../partials/header', { title: 'ই-পেপার আর্কাইভ | লেখক ফোরাম' }) %>
<%
  // ── সার্ভার-সাইড প্রস্তুতি ──
  const bnDay = function (iso) {
    try {
      const d = new Date(String(iso) + 'T00:00:00+06:00');
      return new Intl.DateTimeFormat('bn-BD', { timeZone: 'Asia/Dhaka', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d);
    } catch (e) { return String(iso || ''); }
  };
  const stripFooter = function (s) { return String(s || '').replace(/\s*[(（]\s*অটো-সংগ্রহ[^)）]*[)）]\s*/g, ' ').replace(/\s+/g, ' ').trim(); };
  // সেশন ১৭১: যেকোনো-গুগল-ড্রাইভ-লিংক-ফরম্যাট থেকে fileId এক্সট্র্যাক্টর
  // (/file/d/ID · /open?id=ID · uc?export=download&id=ID — বট/ম্যানুয়াল-উৎস সামলায়)
  const driveIdOf = function (url) {
    const s = String(url || '');
    const m = s.match(/drive\.google\.com\/file\/d\/([\w-]{10,})/) || s.match(/drive\.google\.com\/[^\s]*?[?&]id=([\w-]{10,})/);
    return m ? m[1] : null;
  };
  // সেশন ১৭১ (ইউজার-স্পেক): পত্রিকার নামে 'দৈনিক' প্রিফিক্স নিশ্চিতকারী ফরম্যাটার
  // (দিনকাল → দৈনিক দিনকাল; আগেথেকে-দৈনিক/দ্য/ডেইলি/সাপ্তাহিক/নিউ থাকলে অক্ষত)
  const fmtPaperTitle = function (name) {
    const t = String(name || '').trim();
    if (!t) return 'দৈনিক পত্রিকা';
    if (/^(দৈনিক|দ্য|ডেইলি|daily|the|সাপ্তাহিক|নিউ)/i.test(t)) return t;
    return 'দৈনিক ' + t;
  };
  // সেশন ১৭২ (ইউজার-স্পেক): জাতীয় প্রচারসংখ্যা ও পাঠকপ্রিয়তার র‍্যাংক-ম্যাপ (১–২৪) —
  // টেলিগ্রামে যে-ক্রমেই আপলোড হোক, বাম-প্যানেল প্রতিদিন এই ক্রমেই স্বয়ংক্রিয় সাজানো থাকে
  const PAPER_RANK = [
    'প্রথম আলো', 'ডেইলি স্টার', 'যুগান্তর', 'কালের কণ্ঠ', 'ইত্তেফাক', 'সমকাল',
    'আমার দেশ', 'নয়া দিগন্ত', 'কালবেলা', 'ইনকিলাব', 'বিজনেস স্ট্যান্ডার্ড', 'বণিক বার্তা',
    'দেশ রূপান্তর', 'আজকের পত্রিকা', 'যায়যায়দিন', 'দিনকাল', 'নিউ এজ', 'করতোয়া',
    'রূপালি বাংলাদেশ', 'বিজনেস বাংলাদেশ', 'জাতীয় অর্থনীতি', 'ডেইলি পোস্ট', 'টাইমস অব বাংলাদেশ', 'এদিন'
  ];
  // ইংরেজি-উৎস-নামের উপনাম (The Daily Star / New Age ইত্যাদি বট-ফরম্যাট)
  const PAPER_RANK_ALIAS = { 'daily star': 2, 'business standard': 11, 'new age': 17, 'daily post': 22, 'times of bangladesh': 23 };
  const rankOf = function (name) {
    const s = String(name || '');
    for (let i = 0; i < PAPER_RANK.length; i++) { if (s.indexOf(PAPER_RANK[i]) !== -1) return i + 1; }
    const low = s.toLowerCase();
    for (const k in PAPER_RANK_ALIAS) { if (low.indexOf(k) !== -1) return PAPER_RANK_ALIAS[k]; }
    return 999; // র‍্যাংক-তালিকাভুক্ত নয় — তালিকার সবার শেষে
  };
  // সেশন ১৭১ (ইউজার-স্পেক sanitizeDriveEmbedUrl): এমবেড-উপযোগী রিডার-লিংক —
  // ড্রাইভ-আইডি থাকলে /preview, নইলে পাবলিক-https-ডকুমেন্টে docs-viewer ফলব্যাক
  // (pdf.js-ব্যর্থতা/নন-ড্রাইভ-রোতে iframe-ফলব্যাক-রিডারে ব্যবহৃত)
  const embedOf = function (p) {
    const fid = p.fileId || driveIdOf(p.fileUrl);
    if (fid) return 'https://drive.google.com/file/d/' + fid + '/preview';
    const f = String(p.fileUrl || '').trim();
    if (/^https:\/\//i.test(f)) return 'https://docs.google.com/viewer?url=' + encodeURIComponent(f) + '&embedded=true';
    return null;
  };
  // ক্লায়েন্ট-পেলোড: প্রতিটি পত্রিকার থাম্বনেইল-চেইন + এমবেড-রিডার লিংক প্রি-কম্পিউট
  // থাম্বনেইল-চেইন: টেলিগ্রাম-প্রিভিউ-জেপিজি (নির্ভরযোগ্য) → ড্রাইভ-পিডিএফ-থাম্ব → ড্রাইভ-ক্লাসিক-এন্ডপয়েন্ট
  // সেশন ১৭২: ডুপ্লিকেট-বর্জন (একই পত্রিকা+তারিখ) + র‍্যাংক প্রি-কম্পিউট
  const seenPaper = {};
  const payload = [];
  (papers || []).forEach(function (p) {
    const fid = p.fileId || driveIdOf(p.fileUrl);
    const cands = [];
    if (p.thumbId) cands.push('/api/epaper/thumb/' + encodeURIComponent(p.thumbId)); // সেশন ১৭৫: পরিষ্কার-থাম্ব-প্রক্সি (ব্যানার-কভার) → ব্যর্থতায় সরাসরি-ড্রাইভ
    if (fid) cands.push('/api/epaper/thumb/' + encodeURIComponent(fid)); // thumbId-না-থাকলেও পিডিএফ-পাতা-১-থেকে পরিষ্কার-থাম্ব (প্রক্সি PDF→ইমেজ সামলায়)
    if (p.thumbId) cands.push('https://lh3.googleusercontent.com/d/' + p.thumbId + '=s800');
    if (fid) cands.push('https://lh3.googleusercontent.com/d/' + fid + '=s800');
    if (fid) cands.push('https://drive.google.com/thumbnail?id=' + fid + '&sz=w800');
    const name = fmtPaperTitle(p.paperName);
    const key = String(p.date).slice(0, 10) + '|' + name;
    if (seenPaper[key]) return; // ডুপ্লিকেট (একই পত্রিকা+দিন) বাদ
    seenPaper[key] = true;
    payload.push({
      id: p.id, date: p.date, name: name,
      dateBn: bnDay(p.date),
      thumbs: cands,
      embed: embedOf(p),
      view: fid ? ('https://drive.google.com/file/d/' + fid + '/view') : p.fileUrl,
      fid: fid,
      rank: rankOf(p.paperName)
    });
  });
  // সেশন ১৭২: হেডার-স্ট্যাট (মোট-সংখ্যা, মোট-দিন, শীর্ষ-পত্রিকা)
  const daySet = {};
  payload.forEach(function (p) { daySet[String(p.date).slice(0, 10)] = true; });
  const statDays = Object.keys(daySet).length;
  let topPaper = null;
  payload.forEach(function (p) { if (!topPaper || p.rank < topPaper.rank) topPaper = p; });
  const bnNum = function (n) { try { return Number(n).toLocaleString('bn-BD'); } catch (e) { return String(n); } };
  // মাস-তালিকা (ডেসকেন্ডিং, ইউনিক)
  const monthKeys = {};
  payload.forEach(function (p) { monthKeys[String(p.date).slice(0, 7)] = true; });
  const months = Object.keys(monthKeys).sort().reverse().map(function (ym) {
    const parts = ym.split('-');
    let label = ym;
    try { label = new Intl.DateTimeFormat('bn-BD', { month: 'long', year: 'numeric' }).format(new Date(Number(parts[0]), Number(parts[1]) - 1, 1)); } catch (e) {}
    return { ym: ym, label: label };
  });
  const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  const hasPayload = payload.length > 0;
%>

<div class="ep-wrap" id="epApp170"
     data-papers="<%- encodeURIComponent(JSON.stringify(payload)) %>"
     data-months="<%- encodeURIComponent(JSON.stringify(months)) %>"
     data-today="<%= todayIso %>">

  <%# ═══════════ হেডার-স্ট্রিপ ═══════════ %>
  <div class="ep-head-card">
    <div class="ep-head-l">
      <div class="ep-head-ico"><i class="fas fa-newspaper"></i></div>
      <div>
        <h1 class="ep-head-title">ই-পেপার আর্কাইভ</h1>
        <p class="ep-head-sub"><i class="far fa-calendar"></i> <span id="epTodayBn"><%= bnDay(todayIso) %></span> · দৈনিক পত্রিকার সংরক্ষিত সংস্করণ</p>
        <% if (hasPayload) { %>
        <div class="ep-head-stats">
          <span class="ep-hstat"><b><%= bnNum(payload.length) %></b> সংখ্যা</span>
          <span class="ep-hstat"><b><%= bnNum(statDays) %></b> দিন</span>
          <% if (topPaper && topPaper.rank < 999) { %>
            <span class="ep-hstat is-top"><i class="fas fa-trophy" aria-hidden="true"></i> শীর্ষে <b><%= topPaper.name %></b></span>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
    <div class="ep-head-r">
      <div class="ep-day-step">
        <button type="button" class="ep-step-btn" id="epPrevDay" title="আগের দিন" aria-label="আগের দিনের ই-পেপার"><i class="fas fa-chevron-right"></i></button>
        <input type="date" class="ep-date-input" id="epDateInput" value="<%= todayIso %>" aria-label="তারিখ নির্বাচন" />
        <button type="button" class="ep-step-btn" id="epNextDay" title="পরের দিন" aria-label="পরের দিনের ই-পেপার"><i class="fas fa-chevron-left"></i></button>
      </div>
      <button type="button" class="ep-btn-today" id="epTodayBtn"><i class="fas fa-rotate-left"></i> আজকের পত্রিকা</button>
    </div>
  </div>

  <% if (hasPayload) { %>
  <%# ═══════════ টু-প্যানেল ওয়ার্কস্পেস ═══════════ %>
  <div class="ep-grid">
    <%# ───────── ডান-কলামের-আগে মোবাইলে ভিউয়ার — order দিয়ে ডেস্কটপে বাম/ডান ───────── %>
    <section class="ep-viewer" aria-label="ই-পেপার ভিউয়ার">
      <div class="ep-viewer-bar">
        <div class="ep-viewer-name">
          <i class="fas fa-book-open"></i>
          <span class="ep-cur-rank" id="epCurRank" hidden></span>
          <span id="epCurName">—</span>
          <span class="ep-viewer-date" id="epCurDate"></span>
        </div>
        <div class="ep-viewer-actions">
          <%# ── সেশন ১৭৮: পাতা-জাম্প ড্রপডাউন (রিডার-লোডে পূরণ; স্ক্রলে বর্তমান-পাতা সিঙ্ক) ── %>
          <select class="ep-jump" id="epPageJump" hidden disabled aria-label="পাতায় যান"></select>
          <%# ── সেশন ১৭১: জুম-গ্রুপ (– % +) + রোটেট + ফুলস্ক্রিন (pdf.js/প্রচ্ছদ/iframe — সব-মোডে) ── %>
          <div class="ep-zoomgrp" role="group" aria-label="জুম নিয়ন্ত্রণ">
            <button type="button" class="ep-zbtn" id="epZoomOut" title="জুম আউট" aria-label="জুম আউট"><i class="fas fa-minus" aria-hidden="true"></i></button>
            <button type="button" class="ep-zpct" id="epZoomReset" title="জুম রিসেট" aria-label="জুম রিসেট">১০০%</button>
            <button type="button" class="ep-zbtn" id="epZoomIn" title="জুম ইন" aria-label="জুম ইন"><i class="fas fa-plus" aria-hidden="true"></i></button>
          </div>
          <button type="button" class="ep-ctlbtn" id="epRotate" title="পেজ ঘোরান (৯০°)" aria-label="পেজ ঘোরান"><i class="fas fa-rotate-right" aria-hidden="true"></i></button>
          <button type="button" class="ep-ctlbtn" id="epFs" title="ফুলস্ক্রিন রিডার" aria-label="ফুলস্ক্রিন রিডার"><i class="fas fa-expand" id="epFsIcon" aria-hidden="true"></i></button>
          <span class="ep-act-sep" aria-hidden="true"></span>
          <div class="ep-vt" role="tablist" aria-label="ভিউ মোড">
            <%# সেশন ১৭৩ (ইউজার-স্পেক): ডিফল্ট = ডিজিটাল রিডার (আগে প্রচ্ছদ) %>
            <button type="button" class="ep-vt-btn is-on" id="epModeReader" role="tab" aria-selected="true">ডিজিটাল রিডার</button>
            <button type="button" class="ep-vt-btn" id="epModeThumb" role="tab" aria-selected="false">প্রচ্ছদ</button>
          </div>
          <a class="ep-open-new" id="epOpenNew" href="#" target="_blank" rel="noopener" title="নতুন ট্যাবে পড়ুন"><i class="fas fa-up-right-from-square"></i><span> খুলুন</span></a>
        </div>
      </div>
      <div class="ep-stage" id="epStage">
        <div class="ep-stage-empty">
          <i class="fas fa-newspaper"></i>
          <p>বাঁ-দিকের তালিকা থেকে একটি পত্রিকা বেছে নিন</p>
        </div>
      </div>
    </section>

    <aside class="ep-side" aria-label="তারিখ ও পত্রিকা তালিকা">
      <%# ── ফিল্টার-বক্স ── %>
      <div class="ep-filter">
        <div class="ep-filter-top">
          <span class="ep-filter-title"><i class="fas fa-sliders"></i> তারিখ ভিত্তিক তালিকা</span>
          <span class="ep-count" id="epCount">০</span>
        </div>
        <div class="ep-filter-row">
          <label class="ep-flabel" for="epMonthSel">মাস</label>
          <select class="ep-month" id="epMonthSel">
            <option value="">সকল মাস</option>
            <% months.forEach(function (m) { %>
              <option value="<%= m.ym %>"><%= m.label %></option>
            <% }) %>
          </select>
        </div>
        <%# ── তারিখ-চিপস (দ্রুত-জাম্প; সাম্প্রতিক ১৪ দিন) ── %>
        <div class="ep-chips" id="epChips" role="listbox" aria-label="দিন নির্বাচন"></div>
      </div>
      <%# ── সেশন ১৭২: র‍্যাংকিং-নোট ── %>
      <div class="ep-list-note"><i class="fas fa-trophy" aria-hidden="true"></i><span>জাতীয় প্রচারসংখ্যা ও পাঠকপ্রিয়তার <b>স্বয়ংক্রিয় র‍্যাংকিং</b> — প্রতিদিন এই ক্রমেই তালিকা</span></div>
      <%# ── পত্রিকা-তালিকা ── %>
      <div class="ep-list" id="epList" role="listbox" aria-label="পত্রিকার তালিকা"></div>
    </aside>
  </div>
  <% } else { %>
  <%# ═══════════ খালি-আর্কাইভ: ফিচার্ড-ফলব্যাক + legacy ═══════════ %>
  <div class="ep-empty-lead">
    <i class="fas fa-satellite-dish"></i>
    <p>অটো-সংগ্রহ চালু আছে — চ্যানেলে আজকের পত্রিকা এলেই এখানে যুক্ত হবে।</p>
  </div>
  <% if (today) { %>
    <div class="daily-card epaper-card">
      <div class="daily-card-badge epaper"><i class="fas fa-newspaper"></i> ই-পেপার</div>
      <h2><%= today.title %></h2>
      <% if (today.body) { %><p class="daily-body"><%= stripFooter(today.body) %></p><% } %>
      <% if (today.link_url) { %>
        <a href="<%= today.link_url %>" class="btn-primary-sm" target="_blank" rel="noopener">
          <i class="fas fa-external-link-alt"></i> ই-পেপার পড়ুন
        </a>
      <% } %>
      <div class="daily-meta">প্রকাশ: <%= new Date(today.created_at).toLocaleDateString('bn-BD') %></div>
    </div>
  <% } %>
  <% const epArch = (archive || []).filter(function (a) { return !today || a.id !== today.id; }); %>
  <% if (epArch.length) { %>
    <section class="daily-archive">
      <div class="section-head">
        <h2 class="section-title"><i class="fas fa-clock-rotate-left"></i> পূর্বের ই-পেপার</h2>
        <span class="daily-arch-count"><%= epArch.length %>টি সংখ্যা</span>
      </div>
      <div class="daily-arch-list">
        <% epArch.forEach(function (it, i) { %>
          <details class="daily-arch-item epaper-arch"<%= i === 0 && !today ? ' open' : '' %>>
            <summary>
              <span class="da-date"><i class="far fa-calendar"></i> <%= new Date(it.scheduled_date || it.created_at).toLocaleDateString('bn-BD') %></span>
              <span class="da-title"><%= it.title %></span>
              <i class="fas fa-chevron-down da-chev"></i>
            </summary>
            <div class="da-body">
              <p class="da-text"><%= stripFooter(it.body) %></p>
              <% if (it.link_url) { %>
                <a href="<%= it.link_url %>" class="da-link" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> সেই সংখ্যাটি পড়ুন</a>
              <% } %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>
  <% } %>
  <% } %>
</div>

<script>
(function () {
  'use strict';
  var root = document.getElementById('epApp170');
  if (!root) return;
  var bnDigits = function (n) { return String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; }); };
  var papers = JSON.parse(decodeURIComponent(root.getAttribute('data-papers') || '[]'));
  var todayIso = root.getAttribute('data-today') || '';
  var elDate = document.getElementById('epDateInput');
  var elMonth = document.getElementById('epMonthSel');
  var elList = document.getElementById('epList');
  var elChips = document.getElementById('epChips');
  var elCount = document.getElementById('epCount');
  var elStage = document.getElementById('epStage');
  var elName = document.getElementById('epCurName');
  var elCurDate = document.getElementById('epCurDate');
  var elOpen = document.getElementById('epOpenNew');
  var elReader = document.getElementById('epModeReader');
  var elThumb = document.getElementById('epModeThumb');
  var elCurRank = document.getElementById('epCurRank'); // সেশন ১৭২: ভিউয়ার-বার র‍্যাংক-চিপ
  var mode = 'reader'; // সেশন ১৭৩ (ইউজার-স্পেক): ডিফল্ট = ডিজিটাল রিডার — পেজ-লোডেই ফুল-পিডিএফ ওপেন (আগে ছিল 'thumb')
  var activeId = null;
  if (!papers.length || !elList) return;

  // ── সেশন ১৭১: জুম/রোটেট/ফুলস্ক্রিন-স্টেট + স্টেজ-ট্রান্সফর্ম (সব-মোডে: pdf.js/প্রচ্ছদ/iframe) ──
  var zoomLevel = 100, rotation = 0;
  var elViewer = document.querySelector('.ep-viewer');
  var elFsIcon = document.getElementById('epFsIcon');
  function applyStageTransform() {
    var inner = elStage.firstElementChild;
    if (inner) {
      inner.style.transform = 'scale(' + (zoomLevel / 100) + ') rotate(' + rotation + 'deg)';
      inner.style.transformOrigin = (rotation % 360 !== 0) ? 'center center' : 'top center';
    }
    var lbl = document.getElementById('epZoomReset');
    if (lbl) lbl.textContent = bnDigits(zoomLevel) + '%';
  }
  function resetView() { zoomLevel = 100; rotation = 0; applyStageTransform(); }
  function armLoadTimeout() {
    if (armLoadTimeout._t) clearTimeout(armLoadTimeout._t);
    armLoadTimeout._t = setTimeout(function () {
      var l = elStage.querySelector('.ep-frame-load');
      if (l) l.classList.add('is-hidden');
    }, 12000);
  }
  function centerStage() {
    elStage.scrollTop = (elStage.scrollHeight - elStage.clientHeight) / 2;
    elStage.scrollLeft = (elStage.scrollWidth - elStage.clientWidth) / 2;
  }
  function toggleFs() {
    if (!elViewer) return;
    var fsEl = document.fullscreenElement || document.webkitFullscreenElement;
    if (!fsEl) {
      var req = elViewer.requestFullscreen || elViewer.webkitRequestFullscreen;
      if (req) req.call(elViewer);
    } else {
      var ex = document.exitFullscreen || document.webkitExitFullscreen;
      if (ex) ex.call(document);
    }
  }
  // সেশন ১৭১: iframe-ফলব্যাক-রিডার — pdf.js-ব্যর্থতা/নন-ড্রাইভ-রোতে ড্রাইভ-/preview
  // বা docs-viewer এমবেড (frame-src CSP-অনুমোদিত); স্ক্রল-পড়া ড্রাইভ/viewer-নিজস্ব
  function renderStageIframe(p) {
    stowActiveScroll();
    cancelReader();
    if (!p.embed) {
      elStage.innerHTML = '<div class="ep-stage-empty"><i class="fas fa-newspaper"></i><p>রিডার পাওয়া যায়নি — “খুলুন” বাটনে ক্লিক করুন</p></div>';
      return;
    }
    elStage.innerHTML =
      '<div class="ep-stage-inner">' +
        '<div class="ep-frame-load"><span class="ep-spinner" aria-hidden="true"></span><p>পিডিএফ লোড হচ্ছে…</p></div>' +
        '<iframe class="ep-frame" src="' + p.embed + '" title="' + p.name.replace(/"/g, '&quot;') + '" allow="autoplay; fullscreen" allowfullscreen' +
          ' onload="var l=this.parentNode.querySelector(\'.ep-frame-load\');if(l)l.classList.add(\'is-hidden\');"></iframe>' +
      '</div>';
    applyStageTransform();
    armLoadTimeout();
  }

  // তারিখ-সাজানো (ডেস্কেন্ডিং) + প্রতি-তারিখের-তালিকা
  var dates = [];
  var byDate = {};
  papers.forEach(function (p) {
    var d = String(p.date || '').slice(0, 10);
    if (!byDate[d]) { byDate[d] = []; dates.push(d); }
    byDate[d].push(p);
  });
  dates.sort();
  dates.reverse();

  function bnShort(iso) {
    var p = iso.split('-');
    var md = { '01': 'জানুয়ারি', '02': 'ফেব্রুয়ারি', '03': 'মার্চ', '04': 'এপ্রিল', '05': 'মে', '06': 'জুন', '07': 'জুলাই', '08': 'আগস্ট', '09': 'সেপ্টেম্বর', '10': 'অক্টোবর', '11': 'নভেম্বর', '12': 'ডিসেম্বর' };
    return bnDigits(parseInt(p[2], 10)) + ' ' + (md[p[1]] || p[1]);
  }

  // ── তারিখ-চিপস: সাম্প্রতিক ১৪ দিন (যেদিনে-পত্রিকা-আছে) ──
  function renderChips() {
    var frag = '';
    dates.slice(0, 14).forEach(function (d) {
      var n = byDate[d].length;
      frag += '<button type="button" role="option" aria-selected="' + (d === elDate.value) + '" class="ep-chip' + (d === elDate.value ? ' is-on' : '') + '" data-d="' + d + '">' +
        '<i class="far fa-calendar"></i> ' + bnShort(d) +
        (n > 1 ? ' <b class="ep-chip-n">' + bnDigits(n) + '</b>' : '') + '</button>';
    });
    elChips.innerHTML = frag;
  }

  function filtered() {
    var d = elDate.value;
    var m = elMonth.value;
    var rows = papers.filter(function (p) {
      var pd = String(p.date || '').slice(0, 10);
      if (m && pd.indexOf(m) !== 0) return false;
      if (d && pd !== d) return false;
      return true;
    });
    // সেশন ১৭২: পাঠকপ্রিয়তা-র‍্যাংক অনুযায়ী স্বয়ংক্রিয় ক্রমবিন্যাস (১→২৪; বহির্ভূত সবার শেষে, নাম-ক্রমে)
    rows.sort(rankCmp);
    return rows;
  }
  function rankCmp(a, b) {
    var ra = a.rank || 999, rb = b.rank || 999;
    if (ra !== rb) return ra - rb;
    return String(a.name).localeCompare(String(b.name), 'bn');
  }

  function thumbHtml(p) {
    // ফলব্যাক-চেইন: কোনো-এক-URL ব্যর্থ হলে পরেরটা; সব ব্যর্থ হলে ব্র্যান্ডেড প্লেসহোল্ডার
    if (p.thumbs && p.thumbs.length) {
      var chain = p.thumbs.map(function (u) { return u.replace(/'/g, '%27'); });
      return '<img class="ep-thumb-img" loading="lazy" alt="' + p.name.replace(/"/g, '&quot;') + '" src="' + chain[0] + '"' +
        ' data-chain="' + chain.slice(1).join('|') + '"' +
        ' onerror="var c=(this.dataset.chain||\'\').split(\'|\').filter(Boolean);if(c.length){this.dataset.chain=c.slice(1).join(\'|\');this.src=c[0];}else{this.style.display=\'none\';this.parentNode.classList.add(\'ep-thumb-dead\');}" />';
    }
    return '<i class="fas fa-newspaper"></i>';
  }

  function renderList() {
    var rows = filtered();
    elCount.textContent = bnDigits(rows.length) + ' টি';
    if (!rows.length) {
      elList.innerHTML = '<div class="ep-list-empty"><i class="far fa-folder-open"></i>' +
        '<p>এই তারিখে কোনো সংরক্ষিত ই-পেপার পাওয়া যায়নি</p>' +
        '<button type="button" class="ep-empty-back" data-back="1">আজকের সংখ্যায় ফিরুন</button></div>';
      return;
    }
    var frag = '';
    rows.forEach(function (p) {
      var on = p.id === activeId;
      var rk = p.rank && p.rank < 999 ? p.rank : 0;
      frag += '<button type="button" role="option" aria-selected="' + on + '" class="ep-item' + (on ? ' is-on' : '') + '" data-id="' + p.id + '">' +
        // সেশন ১৭২: র‍্যাংক-ব্যাজ (#১, #২… — শীর্ষ-৩ ব্র্যান্ড-সবুজ; বহির্ভূত '–')
        '<span class="ep-rank' + (rk && rk <= 3 ? ' is-top' : '') + '" title="' + (rk ? 'পাঠকপ্রিয়তার ক্রমে ' + bnDigits(rk) + ' নম্বর' : 'র‍্যাংক-তালিকাভুক্ত নয়') + '">' + (rk ? '#' + bnDigits(rk) : '–') + '</span>' +
        '<span class="ep-thumb">' + thumbHtml(p) + '</span>' +
        '<span class="ep-item-meta"><b class="ep-item-name">' + p.name + '</b>' +
        '<span class="ep-item-sub"><i class="far fa-calendar"></i> ' + p.dateBn + '</span></span>' +
        (on ? '<span class="ep-dot" aria-hidden="true"></span>' : '') +
        '</button>';
    });
    elList.innerHTML = frag;
    renderChips();
    // ফিল্টারে প্রথমটি অটো-সিলেক্ট — ভিউয়ার কখনো-ফাঁকা-লাগে না
    if (!rows.some(function (p) { return p.id === activeId; })) select(rows[0].id);
  }

  function select(id) {
    activeId = id;
    var p = papers.filter(function (x) { return x.id === id; })[0];
    if (!p) return;
    elName.textContent = p.name;
    // সেশন ১৭২: ভিউয়ার-বারে সক্রিয় পত্রিকার র‍্যাংক-চিপ
    if (elCurRank) {
      if (p.rank && p.rank < 999) { elCurRank.hidden = false; elCurRank.textContent = '#' + bnDigits(p.rank); }
      else { elCurRank.hidden = true; elCurRank.textContent = ''; }
    }
    elCurDate.textContent = '· ' + p.dateBn;
    elOpen.href = p.view || '#';
    elOpen.style.display = p.view ? '' : 'none';
    resetView();
    renderStage(p);
    renderList();
  }

  /* ── ডিজিটাল-রিডার ইঞ্জিন (session170): pdf.js ক্লায়েন্ট-সাইড — থার্ড-পার্টি-কুকি-সমস্যা বাইপাস ──
     ড্রাইভের usercontent-এন্ডপয়েন্ট ACAO:* দেয় → ব্রাউজারে ফেচ + প্রগ্রেস-বার + পাতা-ধরে-স্ক্রল */
  var PDFJS_BASE = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/';
  var bytesCache = {}; // fid → ArrayBuffer (শেষ-৩টি রাখা হয়)
  var reader = null;   // সক্রিয়-রিডার-স্টেট { fid, abort, doc, io }
  // ── session178: keep-alive মাল্টি-রিডার — একবার-খোলা পত্রিকার পাতা/doc মেমরিতে থেকে যায়;
  //    পেপার-সুইচ = তাৎক্ষণিক পুনঃদর্শন (শূন্য-নেটওয়ার্ক), LRU-৪ ছাড়ালে সবচেয়ে-পুরনোটি মুক্ত হয়
  var ALIVE_MAX = 4;
  var alive = new Map(); // fid → {wrap, doc, io, st, numPages, shownAt}
  function aliveTouch(fid) { var a = alive.get(fid); if (a) a.shownAt = Date.now(); return a; }
  function aliveEvictIfNeeded() {
    while (alive.size > ALIVE_MAX) {
      var oldFid = null, oldT = Infinity;
      alive.forEach(function (a, fid) { if (a.shownAt < oldT) { oldT = a.shownAt; oldFid = fid; } });
      if (!oldFid) break;
      var a = alive.get(oldFid);
      alive.delete(oldFid);
      try { if (a.st && a.st.abort) a.st.abort.abort(); } catch (e) {}
      try { if (a.io) a.io.disconnect(); } catch (e) {}
      try { if (a.doc) a.doc.destroy(); } catch (e) {}
      delete bytesCache[oldFid];
    }
  }

  function loadPdfJs() {
    if (window.pdfjsLib) return Promise.resolve();
    return new Promise(function (res, rej) {
      var s = document.createElement('script');
      s.src = PDFJS_BASE + 'pdf.min.js';
      s.onload = function () {
        var lib = window.pdfjsLib;
        if (!lib) { rej(new Error('pdfjs-missing')); return; }
        // ক্রস-অরিজিন Worker ব্রাউজার-ব্লকড — worker-স্ক্রিপ্ট ফেচ করে blob-URL দিয়ে বাইপাস
        fetch(PDFJS_BASE + 'pdf.worker.min.js').then(function (r) { return r.text(); }).then(function (txt) {
          try { lib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([txt], { type: 'application/javascript' })); } catch (e) {}
          res();
        }).catch(function () {
          try { lib.GlobalWorkerOptions.workerSrc = PDFJS_BASE + 'pdf.worker.min.js'; } catch (e) {}
          res();
        });
      };
      s.onerror = function () { rej(new Error('pdfjs-load-fail')); };
      document.head.appendChild(s);
    });
  }

  function fetchPdfProgress(url, aborter, onProg) {
    return fetch(url, { signal: aborter.signal }).then(function (res) {
      if (!res.ok) throw new Error('drive-http-' + res.status);
      var total = Number(res.headers.get('content-length') || 0);
      if (!res.body || !window.ReadableStream) return res.arrayBuffer();
      var rd = res.body.getReader(), chunks = [], got = 0;
      var pull = function () {
        return rd.read().then(function (r) {
          if (r.done) {
            var parts = chunks.map(function (c) { return c.slice(); });
            var out = new Uint8Array(got), off = 0;
            parts.forEach(function (c) { out.set(new Uint8Array(c), off); off += c.length; });
            onProg(got, got);
            return out.buffer;
          }
          chunks.push(r.value); got += r.value.length;
          onProg(got, total);
          return pull();
        });
      };
      return pull();
    });
  }

  function cancelReader() {
    if (!reader) return;
    try { if (reader.abort) reader.abort.abort(); } catch (e) {}
    try { if (reader.io) reader.io.disconnect(); } catch (e) {}
    try { if (reader.doc) reader.doc.destroy(); } catch (e) {}
    if (reader.fid) alive.delete(reader.fid);
    reader = null;
  }
  // session178: শুধু-বিচ্ছিন্ন — চলমান-ফেচ থামায় কিন্তু জীবিত-রিডার (doc/io/canvas) অক্ষত রাখে
  // (নতুন-পেপারে সুইচ করলে আগেরটি মেমরিতে থেকে যায় — ফেরার-পথ শূন্য-নেটওয়ার্ক)
  function detachReader() {
    if (!reader) return;
    try { if (reader.abort) reader.abort.abort(); } catch (e) {}
    reader = null;
  }
  // session178: ডিট্যাচের-আগে জীবিত-র‍্যাপের স্ক্রল-অবস্থান সংরক্ষণ — DOM-থেকে-সরালে Chrome scrollTop-০ করে দেয়,
  // তাই ফেরার-সময় পুনঃস্থাপনের-জন্য আগেই মেমরিতে রাখতে হয়
  function stowActiveScroll() {
    if (!reader || !reader.fid) return;
    var a = alive.get(reader.fid);
    if (!a || !a.wrap || a.wrap.ownerDocument === null || !a.wrap.parentNode) return;
    a.scroll = { t: a.wrap.scrollTop, l: a.wrap.scrollLeft };
  }

  function fmtMb(b) { return (b / 1048576).toFixed(1) + ' MB'; }

  // session178: প্রক্সি-ফেচ ×২-রিট্রাই — ট্রানজিয়েন্ট 502/504 (কোল্ড-ইনস্ট্যান্স/CPU-প্রতিযোগিতা) পুনঃচেষ্টায়
  // প্রায়ই-সফল; দুই-বার ব্যর্থ হলেই iframe-ফলব্যাক (ব্যানারসহ ড্রাইভ-প্রিভিউ — শেষ-অবলম্বন)
  function fetchPdfWithRetry(url, aborter, onProg) {
    return fetchPdfProgress(url, aborter, onProg).catch(function (e1) {
      if (e1 && e1.name === 'AbortError') throw e1;
      return new Promise(function (res, rej) {
        setTimeout(function () {
          fetchPdfProgress(url, aborter, onProg).then(res, rej);
        }, 1800);
      }).catch(function (e2) { throw (e2 && e2.name === 'AbortError') ? e2 : e1; });
    });
  }

  // session178: পাতা-জাম্প ড্রপডাউন — doc-লোডে পূরণ, স্ক্রলে বর্তমান-পাতা সিঙ্ক
  // লক্ষ্য: আসল-স্ক্রলার .ep-pages (elStage নয় — ওটার scrollTop সর্বদা ০)
  function armPageJump(st, numPages) {
    var sel = document.getElementById('epPageJump');
    if (!sel) return;
    sel.hidden = false;
    sel.disabled = false;
    if (sel._pages !== numPages) {
      var frag = '';
      for (var n = 1; n <= numPages; n++) frag += '<option value="' + n + '">পাতা ' + bnDigits(n) + ' / ' + bnDigits(numPages) + '</option>';
      sel.innerHTML = frag;
      sel._pages = numPages;
    }
    sel.onchange = function () {
      var n = parseInt(sel.value, 10) || 1;
      var h = elStage.querySelector('.ep-page-holder[data-n="' + n + '"]');
      if (h) { h.scrollIntoView({ behavior: 'smooth', block: 'start' }); sel.blur(); }
    };
    st.jumpSync = function () {
      if (!elStage.querySelector) return;
      var stageTop = elStage.getBoundingClientRect().top;
      var best = 1, bestD = Infinity;
      elStage.querySelectorAll('.ep-page-holder').forEach(function (h) {
        var d = Math.abs(h.getBoundingClientRect().top - stageTop);
        if (d < bestD) { bestD = d; best = Number(h.getAttribute('data-n')) || 1; }
      });
      if (String(sel.value) !== String(best)) sel.value = String(best);
    };
    if (!st._jumpBound) {
      st._jumpBound = true;
      var tick = false;
      var scroller = elStage.querySelector('.ep-pages') || elStage;
      scroller.addEventListener('scroll', function () {
        if (tick) return;
        tick = true;
        requestAnimationFrame(function () { tick = false; if (reader && reader.jumpSync) reader.jumpSync(); });
      }, { passive: true });
    }
    st.jumpSync(); // রি-অ্যাটাচেও বর্তমান-পাতা সঠিক (আগে বাধ্যতামূলক '১' হয়ে যেত)
  }
  function resetPageJump() {
    var sel = document.getElementById('epPageJump');
    if (!sel) return;
    sel.hidden = true; sel.disabled = true; sel.innerHTML = ''; sel._pages = 0;
  }

  function openReader(p) {
    // session178: keep-alive হিট — একবার-খোলা পত্রিকা শূন্য-নেটওয়ার্কে তাৎক্ষণিক ফেরে
    var cachedAlive = alive.get(p.fid);
    if (cachedAlive && mode === 'reader') {
      aliveTouch(p.fid);
      if (reader && reader !== cachedAlive.st) {
        try { if (reader.abort) reader.abort.abort(); } catch (e) {} // চলমান-ফেচ-থামান, doc/-io জীবিত রাখুন
      }
      stowActiveScroll(); // reader-এখনো-পুরোনো — আগের-পত্রিকার স্ক্রল সংরক্ষণ
      reader = cachedAlive.st;
      var w = cachedAlive.wrap;
      var sc = cachedAlive.scroll || { t: 0, l: 0 }; // সংরক্ষিত-অবস্থান (ডিট্যাচে scrollTop-রিসেট হয়)
      elStage.innerHTML = '';
      elStage.appendChild(w);
      w.scrollTop = sc.t; w.scrollLeft = sc.l;
      applyStageTransform();
      armPageJump(cachedAlive.st, cachedAlive.numPages);
      return;
    }
    stowActiveScroll(); // আগে-সংরক্ষণ (detach-এ reader=null হয়) — নতুন-লোড/iframe-পথ দুটোতেই আগের-স্ক্রল মনে থাকে
    detachReader(); // আগের-জীবিত-রিডার মেমরিতে থাকে (cancelReader নয় — সে ধ্বংস করত)
    resetPageJump();
    if (!p.fid) { renderStageIframe(p); return; }
    var st = { fid: p.fid, abort: new AbortController(), doc: null, io: null };
    reader = st;
    elStage.innerHTML = '<div class="ep-reader-load"><i class="fas fa-spinner fa-spin"></i>' +
      '<p>পত্রিকা লোড হচ্ছে…</p><div class="ep-prog"><i style="width:6%"></i></div>' +
      '<span class="ep-prog-txt">প্রস্তুত হচ্ছে</span>' +
      '<a class="ep-load-fallback" href="' + p.view + '" target="_blank" rel="noopener">সরাসরি খুলুন ↗</a></div>';
    var progBar = elStage.querySelector('.ep-prog i');
    var progTxt = elStage.querySelector('.ep-prog-txt');
    var onProg = function (got, total) {
      if (progTxt) progTxt.textContent = fmtMb(got) + (total ? ' / ' + fmtMb(total) : '') + ' ডাউনলোড হয়েছে';
      if (progBar) progBar.style.width = total ? Math.min(Math.max((got / total) * 100, 4), 100) + '%' : '100%';
    };
    var bytesP;
    if (bytesCache[p.fid]) {
      bytesP = Promise.resolve(bytesCache[p.fid]);
    } else if (!p.fid) {
      // নন-ড্রাইভ রো — সরাসরি iframe-ফলব্যাক (session171-আচরণ)
      bytesP = Promise.reject(new Error('no-drive-id'));
    } else {
      // সেশন ১৭৫: ক্লিন-প্রক্সি — পুরোনো-পিডিএফেও সাইট-পাশে প্রমো-লেয়ার সরে (helpers/pdf-cleaner)
      // সেশন ১৭৮: ×২-রিট্রাই — ট্রানজিয়েন্ট 502/504-এ iframe-ফলব্যাকে (ব্যানার) না-গিয়ে পুনঃচেষ্টা
      bytesP = loadPdfJs().then(function () {
        return fetchPdfWithRetry('/api/epaper/file/' + encodeURIComponent(p.fid), st.abort, onProg);
      });
    }
    bytesP.then(function (buf) {
      if (reader !== st) return;
      bytesCache[p.fid] = buf;
      var keys = Object.keys(bytesCache);
      if (keys.length > 3) delete bytesCache[keys[0]];
      return window.pdfjsLib.getDocument({ data: new Uint8Array(buf.slice(0)) }).promise.then(function (doc) {
        if (reader !== st) { try { doc.destroy(); } catch (e) {} return; }
        st.doc = doc;
        if (progTxt) progTxt.textContent = 'পাতা প্রস্তুত হচ্ছে…';
        if (progBar) progBar.style.width = '100%';
        // সেশন ১৭৫-ফিক্স: pdf.js v3-তে `doc.metadata` প্রোপার্টি-নেই (getMetadata()-মেথড) —
        // পুরোনো `doc.metadata.then`-গার্ড রিয়েল-পিডিএফেই ক্র্যাশ করে iframe-ফলব্যাকে ফেলত → প্রমো-ব্যানার দেখাত
      }).then(function () { if (reader === st) buildPages(st, p); });
    }).catch(function (e) {
      if (reader !== st || (e && e.name === 'AbortError')) return;
      console.warn('ep-reader fallback:', e);
      renderStageIframe(p); // সেশন ১৭১: স্পিনার+ট্রান্সফর্ম-র‍্যাপারসহ iframe-ফলব্যাক (CSP-অনুমোদিত)
    });
  }

  function buildPages(st, p) {
    var doc = st.doc;
    var wrap = document.createElement('div');
    wrap.className = 'ep-pages';
    var holders = [];
    for (var n = 1; n <= doc.numPages; n++) {
      var h = document.createElement('div');
      h.className = 'ep-page-holder';
      h.setAttribute('data-n', n);
      var lbl = document.createElement('span');
      lbl.className = 'ep-page-num';
      lbl.textContent = bnDigits(n) + ' / ' + bnDigits(doc.numPages);
      h.appendChild(lbl);
      wrap.appendChild(h);
      holders.push(h);
    }
    elStage.innerHTML = '';
    elStage.appendChild(wrap);
    var rendering = {};
    var renderPage = function (n, holder) {
      if (rendering[n] || reader !== st) return;
      rendering[n] = true;
      doc.getPage(n).then(function (page) {
        if (reader !== st) return;
        var base = page.getViewport({ scale: 1 });
        var targetW = Math.max(wrap.clientWidth - 28, 320);
        var scale = Math.min(targetW / base.width, 2);
        var vp = page.getViewport({ scale: scale });
        var canvas = document.createElement('canvas');
        canvas.width = Math.floor(vp.width); canvas.height = Math.floor(vp.height);
        holder.insertBefore(canvas, holder.firstChild);
        return page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise.then(function () {
          holder.classList.add('is-done');
        });
      }).catch(function () { rendering[n] = false; });
    };
    st.io = new IntersectionObserver(function (ents) {
      ents.forEach(function (en) {
        if (en.isIntersecting) renderPage(Number(en.target.getAttribute('data-n')), en.target);
      });
    }, { root: wrap, rootMargin: '600px 0px' }); // root = .ep-pages (আসল-স্ক্রলার; elStage-rootে গভীর-স্ক্রলে রেন্ডার-ট্রিগার বন্ধ হয়ে যেত)
    holders.forEach(function (h) { st.io.observe(h); });
    // session178: জীবিত-রিডার-রেজিস্ট্রি — পরের-সুইচে শূন্য-নেটওয়ার্কে ফেরা
    alive.set(st.fid, { wrap: wrap, doc: doc, io: st.io, st: st, numPages: doc.numPages, shownAt: Date.now() });
    aliveEvictIfNeeded();
    armPageJump(st, doc.numPages);
  }

  function renderStage(p) {
    if (mode !== 'reader') { // session178: প্রচ্ছদ-মোডে সক্রিয়-ফেচ-থামান (doc জীবিত থাকে — রিডারে ফেরা তাৎক্ষণিক)
      if (reader) { try { if (reader.abort) reader.abort.abort(); } catch (e) {} }
      stowActiveScroll(); // রিডারের-স্ক্রল মনে রাখুন — ফেরত-এলে সেখানেই
      resetPageJump();
    }
    if (mode === 'reader') { openReader(p); return; }
    if (p.thumbs && p.thumbs.length) {
      var chain = p.thumbs.map(function (u) { return u.replace(/'/g, '%27'); });
      elStage.innerHTML = '<div class="ep-cover-wrap"><img class="ep-cover" src="' + chain[0] + '" alt="' + p.name.replace(/"/g, '&quot;') + '"' +
        ' data-chain="' + chain.slice(1).join('|') + '"' +
        ' onerror="var c=(this.dataset.chain||\'\').split(\'|\').filter(Boolean);if(c.length){this.dataset.chain=c.slice(1).join(\'|\');this.src=c[0];}else{this.parentNode.innerHTML=\'<div class=ep-stage-empty><i class=fas.fa-newspaper></i><p>প্রচ্ছদ পাওয়া যায়নি</p></div>\';}" /></div>';
    } else {
      elStage.innerHTML = '<div class="ep-stage-empty"><i class="fas fa-newspaper"></i><p>প্রচ্ছদ পাওয়া যায়নি</p></div>';
    }
  }

  function setMode(m) {
    mode = m;
    elReader.classList.toggle('is-on', m === 'reader');
    elThumb.classList.toggle('is-on', m === 'thumb');
    elReader.setAttribute('aria-selected', m === 'reader');
    elThumb.setAttribute('aria-selected', m === 'thumb');
    var p = papers.filter(function (x) { return x.id === activeId; })[0];
    if (p) renderStage(p);
  }

  window.addEventListener('beforeunload', cancelReader);

  // ── session178: আইডল-প্রিফেচ — সক্রিয়-দিনের পরবর্তী শীর্ষ-র‍্যাংকের ২টি পত্রিকা ব্যাকগ্রাউন্ডে
  //    বাইট-ক্যাশে (সার্ভার-ক্লিন-ক্যাশ ও HTTP-ক্যাশ উষ্ণ হয়); ডাটা-সেভার/2G/লুকানো-ট্যাবে স্বয়ং-বন্ধ
  var prefetched = {}, prefetchDate = null, prefetchBusy = false;
  function prefetchPapers() {
    if (document.hidden || prefetchBusy) return;
    var d = elDate.value;
    if (prefetchDate !== d) { prefetchDate = d; prefetched = {}; }
    var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection || {};
    if (conn.saveData || /^(slow-)?2g$/i.test(conn.effectiveType || '')) return;
    var rows = (byDate[d] || []).slice().sort(rankCmp).filter(function (p) { return p.fid; });
    var queue = [];
    for (var i = 0; i < rows.length && queue.length < 2; i++) {
      var p = rows[i];
      if (!prefetched[p.fid] && !alive.get(p.fid)) queue.push(p);
    }
    if (!queue.length) return;
    prefetchBusy = true;
    var k = 0;
    var next = function () {
      if (k >= queue.length || document.hidden) { prefetchBusy = false; return; }
      var pp = queue[k++];
      prefetched[pp.fid] = true;
      fetch('/api/epaper/file/' + encodeURIComponent(pp.fid)).then(function (r) {
        return r.ok ? r.arrayBuffer() : null;
      }).then(function (b) {
        if (b && b.byteLength > 1024) {
          bytesCache[pp.fid] = b;
          var keys = Object.keys(bytesCache);
          if (keys.length > 3) delete bytesCache[keys[0]];
        }
        setTimeout(next, 1200);
      }).catch(function () { setTimeout(next, 1200); });
    };
    next();
  }
  setTimeout(prefetchPapers, 5000);
  setInterval(prefetchPapers, 12000);

  // ── ইভেন্ট ──
  elList.addEventListener('click', function (e) {
    var back = e.target.closest('[data-back]');
    if (back) { elDate.value = todayIso; elMonth.value = ''; renderList(); return; }
    var it = e.target.closest('.ep-item');
    if (it) select(Number(it.getAttribute('data-id')));
  });
  elChips.addEventListener('click', function (e) {
    var ch = e.target.closest('.ep-chip');
    if (!ch) return;
    elDate.value = ch.getAttribute('data-d');
    renderList();
  });
  elDate.addEventListener('change', renderList);
  elMonth.addEventListener('change', renderList);
  document.getElementById('epTodayBtn').addEventListener('click', function () {
    elDate.value = todayIso; elMonth.value = ''; renderList();
  });
  elReader.addEventListener('click', function () { setMode('reader'); });
  elThumb.addEventListener('click', function () { setMode('thumb'); });
  // ── সেশন ১৭১: জুম-ইন/আউট/রিসেট + রোটেট + ফুলস্ক্রিন-ইভেন্ট (সব-মোডে প্রযোজ্য) ──
  document.getElementById('epZoomIn').addEventListener('click', function () {
    zoomLevel = Math.min(zoomLevel + 20, 200); applyStageTransform();
  });
  document.getElementById('epZoomOut').addEventListener('click', function () {
    zoomLevel = Math.max(zoomLevel - 20, 70); applyStageTransform();
  });
  document.getElementById('epZoomReset').addEventListener('click', resetView);
  document.getElementById('epRotate').addEventListener('click', function () {
    rotation = (rotation + 90) % 360; applyStageTransform(); centerStage();
  });
  document.getElementById('epFs').addEventListener('click', toggleFs);
  ['fullscreenchange', 'webkitfullscreenchange'].forEach(function (ev) {
    document.addEventListener(ev, function () {
      var fs = !!(document.fullscreenElement || document.webkitFullscreenElement);
      if (elViewer) elViewer.classList.toggle('is-fs', fs);
      if (elFsIcon) elFsIcon.className = fs ? 'fas fa-compress' : 'fas fa-expand';
    });
  });
  // কীবোর্ড-শর্টকাট: +/− জুম · r ঘোরান · f ফুলস্ক্রিন · 0 রিসেট (ইনপুট-ফোকাসে নিষ্ক্রিয়)
  document.addEventListener('keydown', function (e) {
    var t = e.target;
    if (t && /^(INPUT|SELECT|TEXTAREA)$/.test(t.tagName)) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === '+' || e.key === '=') { zoomLevel = Math.min(zoomLevel + 20, 200); applyStageTransform(); }
    else if (e.key === '-' || e.key === '_') { zoomLevel = Math.max(zoomLevel - 20, 70); applyStageTransform(); }
    else if (e.key === 'r' || e.key === 'R') { rotation = (rotation + 90) % 360; applyStageTransform(); centerStage(); }
    else if (e.key === 'f' || e.key === 'F') { toggleFs(); }
    else if (e.key === '0') { resetView(); }
  });
  // আগের/পরের দিন — শুধু পত্রিকা-আছে-এমন দিনে লাফায়
  document.getElementById('epPrevDay').addEventListener('click', function () { stepDay(1); });
  document.getElementById('epNextDay').addEventListener('click', function () { stepDay(-1); });
  function stepDay(dir) {
    var cur = elDate.value;
    var idx = dates.indexOf(cur);
    if (idx < 0) { // বর্তমান-নির্বাচন তালিকায় নেই — দিক-অনুযায়ী নিকটতম
      idx = dir > 0 ? dates.findIndex(function (d) { return d < cur; }) : dates.findIndex(function (d) { return d <= cur; });
      if (idx < 0) idx = 0;
    }
    var nx = idx + dir;
    if (nx < 0 || nx >= dates.length) return;
    elDate.value = dates[nx];
    renderList();
  }

  // ── বুট: আজকের (বা সর্বশেষ সিঙ্কড) দিন + সেই-দিনের শীর্ষ-র‍্যাংকের পত্রিকা (session172) ──
  var bootDate = dates.indexOf(todayIso) >= 0 ? todayIso : dates[0];
  elDate.value = bootDate;
  var bootRows = byDate[bootDate].slice().sort(rankCmp);
  select(bootRows[0].id);
})();
</script>
<script src="/assets/js/main.js?v=<%= AV %>"></script>
<script src="/assets/js/premium.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
