<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'মডারেটর প্যানেল — বাংলাদেশ তরুণ কলাম লেখক ফোরাম', extra_css: ['/assets/css/dashboard.css'] }) %>
<style>
    .mod-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; padding: 20px; }
    .mod-tile { background:#fff; border-radius:12px; padding:20px; text-align:center; box-shadow:0 4px 6px -1px rgba(0,0,0,0.05); transition:.2s; }
    .mod-tile:hover { transform:translateY(-3px); box-shadow:0 10px 15px -3px rgba(0,0,0,0.1); }
    .mod-tile i { font-size:28px; color:#059669; margin-bottom:10px; display:block; }
    .mod-tile.locked { opacity:0.4; filter:grayscale(1); }
  </style>
  <div class="dashboard-wrap">
    <main class="dash-main" style="flex:1;">
      <div style="background:#fff; border-radius:12px; padding:20px; margin-bottom:16px;">
        <h2 style="margin:0;"><i class="fas fa-user-shield"></i> মডারেটর প্যানেল</h2>
        <p style="color:#666; margin:6px 0 0;">আপনি যে সেকশনগুলোর জন্য অনুমোদিত, শুধু সেগুলোই এখানে সক্রিয় থাকবে।</p>
      </div>
      <div class="mod-grid">
        <% const links = {
          quiz: '/moderator/daily/quiz', this_day: '/moderator/daily/this_day',
          activity: '/moderator/daily/activity', epaper: '/moderator/daily/epaper',
          notice: '/moderator/notices', event: '/moderator/events',
          best_writer: '/moderator/best-writer', complaints: '/moderator/complaints'
        }; %>
        <% scopes.forEach(s => {
          const aliased = scopeAliases[s.key];
          const isDaily = dailyContentScopes.includes(s.key);
          const allowed = myScopes.includes(s.key) || (aliased && myScopes.includes(aliased)) || (isDaily && myScopes.includes('daily'));
        %>
          <% if (allowed) { %>
            <a href="<%= links[s.key] %>" class="mod-tile">
              <i class="fas fa-check-circle"></i>
              <strong><%= s.label %></strong>
            </a>
          <% } else { %>
            <div class="mod-tile locked" title="এই সেকশনের অনুমতি আপনার নেই">
              <i class="fas fa-lock"></i>
              <strong><%= s.label %></strong>
            </div>
          <% } %>
        <% }) %>
      </div>
      <% if (myScopes.length === 0) { %>
        <div style="background:#fff; border-radius:12px; padding:20px; text-align:center; color:#999;">
          এখনো আপনাকে কোনো সেকশনের অনুমতি দেওয়া হয়নি। এডমিনের সাথে যোগাযোগ করুন।
        </div>
      <% } %>
    </main>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
