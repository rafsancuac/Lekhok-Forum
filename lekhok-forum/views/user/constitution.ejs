<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>গঠনতন্ত্র — লেখক ফোরাম</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/feed.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <div class="page-wrap" style="max-width:800px">
    <div class="page-header">
      <h1><i class="fas fa-scroll"></i> গঠনতন্ত্র</h1>
    </div>
    <% if (sections.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-scroll"></i><p>গঠনতন্ত্র এখনো যোগ করা হয়নি।</p></div>
    <% } else { %>
      <div class="constitution-sections">
        <% sections.forEach(s => { %>
          <div class="constitution-item" id="section-<%= s.id %>">
            <h2><i class="fas fa-gavel"></i> <%= s.section_title %></h2>
            <div class="constitution-content"><%- s.content.replace(/\n/g, '<br>') %></div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
