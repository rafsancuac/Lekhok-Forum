<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'বিজ্ঞপ্তিসমূহ | লেখক ফোরাম' }) %>
  <div class="page-wrap" style="max-width:700px">
    <div class="notif-page-header">
      <h1 style="font-size:1.5rem;color:var(--brand);margin:0;">
        <i class="fas fa-bell" style="color:var(--accent);margin-right:8px;"></i>বিজ্ঞপ্তিসমূহ
        <% const unreadCount = items.filter(n => !n.is_read).length; %>
        <% if (unreadCount > 0) { %>
          <span class="notif-count-chip"><%= unreadCount %> টি নতুন</span>
        <% } %>
      </h1>
      <% if (unreadCount > 0) { %>
        <a href="/notifications/mark-all-read" class="mark-all-read"><i class="fas fa-check-double"></i> সব পঠিত করুন</a>
      <% } %>
    </div>

    <% if (items.length === 0) { %>
      <div class="notif-empty"><i class="fas fa-bell-slash"></i><p>এখনও কোনো বিজ্ঞপ্তি আসেনি।</p><small style="color:var(--text-muted);">নতুন কার্যকলাপ এখানে দেখা যাবে।</small></div>
    <% } else { %>
      <div class="notif-page-list">
        <% items.forEach(n => { %>
          <% const iconClass = n.type === 'birthday' ? 'icon-birthday' : (n.type === 'like' ? 'icon-like' : (n.type === 'comment' ? 'icon-comment' : (n.type === 'follow' ? 'icon-follow' : (n.type === 'call' ? 'icon-call' : 'icon-system')))); %>
          <% const _ico = n.type === 'birthday' ? 'fa-birthday-cake' : (n.type === 'like' ? 'fa-heart' : (n.type === 'comment' ? 'fa-comment' : (n.type === 'follow' ? 'fa-user-plus' : (n.type === 'call' ? 'fa-phone-slash' : 'fa-bell')))); %>
          <a href="<%= n.link || '#' %>" class="notif-page-item <%= n.is_read ? '' : 'unread' %>" onclick="markRead('<%= n.id %>')">
            <%# সেশন ১০৮: actor-avatar — হেডার-ড্রপডাউন (সেশন ১০২) ও একই শেপ; actor না থাকলে টাইপ-আইকন %>
            <% if (n.actor_id) { %>
              <div class="notif-page-icon <%= iconClass %> has-avatar"><img class="notif-avatar" src="<%= n.actor_avatar || ('/avatar/' + n.actor_id) %>" alt="" loading="lazy" onerror="this.parentNode.classList.remove('has-avatar');this.remove()"><i class="fas <%= _ico %>"></i></div>
            <% } else { %>
            <div class="notif-page-icon <%= iconClass %>">
              <i class="fas <%= _ico %>"></i>
            </div>
            <% } %>
            <div class="notif-page-body">
              <div class="notif-page-title"><%= n.title %><% if (n.type === 'call') { %> <span class="notif-missed notif-missed--page"><i class="fas fa-phone-slash"></i> মিসড কল</span><% } %></div>
              <div class="notif-page-text"><%= n.body %></div>
              <div class="notif-page-time"><i class="far fa-clock"></i> <%= new Date(n.created_at).toLocaleDateString('bn-BD') %></div>
            </div>
            <%# সেশন ১১৪: FB-প্যারিটি সরান-বাটন (হোভারে দৃশ্যমান; নিজের-সারি-ইনভ্যারিয়েন্ট API) %>
            <button type="button" class="notif-dismiss" data-dismiss="<%= n.id %>" aria-label="বিজ্ঞপ্তিটি সরান" title="সরান"><i class="fas fa-xmark" aria-hidden="true"></i></button>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script>
    async function markRead(id) {
      await fetch('/api/notifications/read/' + id, { method: 'POST' });
    }
    /* ── সেশন ১১৪: বিজ্ঞপ্তি-সরান (FB-প্যারিটি) — অ্যানিমেটেড-রিমুভ + কাউন্ট-সিঙ্ক;
         শেষ-আইটেম সরলে সার্ভার-সত্যে (empty-state) রিলোড ── */
    (function () {
      var list = document.querySelector('.notif-page-list');
      if (!list) return;
      list.addEventListener('click', function (e) {
        var btn = e.target.closest('.notif-dismiss');
        if (!btn) return;
        e.preventDefault(); e.stopPropagation();
        var row = btn.closest('.notif-page-item');
        if (!row || row.dataset.dismissBusy) return;
        row.dataset.dismissBusy = '1';
        fetch('/api/notifications/' + btn.dataset.dismiss + '/dismiss', { method: 'POST' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (!j || !j.ok) { row.removeAttribute('data-dismiss-busy'); return; }
            row.style.height = row.offsetHeight + 'px';
            requestAnimationFrame(function () {
              row.classList.add('removing');
              row.style.height = '0px';
            });
            setTimeout(function () {
              var wasUnread = row.classList.contains('unread');
              row.remove();
              var rest = list.querySelectorAll('.notif-page-item').length;
              var chip = document.querySelector('.notif-count-chip');
              if (chip && wasUnread) {
                /* চিপ-টেক্সট বাংলা-সংখ্যায় ("২ টি নতুন") — parseInt-নিরাপদ রূপান্তর */
                var bnDigits = '০১২৩৪৫৬৭৮৯';
                var cur = parseInt(chip.textContent.trim().replace(/[০-৯]/g, function (d) { return bnDigits.indexOf(d); }), 10) || 0;
                var left = Math.max(0, cur - 1);
                if (left > 0) chip.textContent = String(left).replace(/[0-9]/g, function (d) { return bnDigits[+d]; }) + ' টি নতুন';
                else chip.remove();
              }
              if (!rest) location.reload();
            }, 260);
          })
          .catch(function () { row.removeAttribute('data-dismiss-busy'); });
      });
    })();
  </script>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
  <script src="/assets/js/premium.js?v=<%= AV %>"></script>
</body>
</html>
