<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'বিজ্ঞপ্তিসমূহ — লেখক ফোরাম' }) %>
  <div class="page-wrap" style="max-width:700px">
    <div class="page-header">
      <h1><i class="fas fa-bell"></i> বিজ্ঞপ্তিসমূহ</h1>
      <% if (items.some(n => !n.is_read)) { %>
        <a href="/notifications/mark-all-read" class="mark-all-read">সব পঠিত করুন</a>
      <% } %>
    </div>

    <% if (items.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-bell"></i><p>কোনো বিজ্ঞপ্তি নেই।</p></div>
    <% } else { %>
      <div class="notif-page-list">
        <% items.forEach(n => { %>
          <a href="<%= n.link || '#' %>" class="notif-page-item <%= n.is_read ? '' : 'unread' %>" onclick="markRead('<%= n.id %>')">
            <div class="notif-page-icon">
              <% if (n.type === 'birthday') { %><i class="fas fa-birthday-cake"></i>
              <% } else if (n.type === 'like') { %><i class="fas fa-heart"></i>
              <% } else if (n.type === 'comment') { %><i class="fas fa-comment"></i>
              <% } else if (n.type === 'follow') { %><i class="fas fa-user-plus"></i>
              <% } else { %><i class="fas fa-bell"></i><% } %>
            </div>
            <div class="notif-page-body">
              <div class="notif-page-title"><%= n.title %></div>
              <div class="notif-page-text"><%= n.body %></div>
              <div class="notif-page-time"><i class="far fa-clock"></i> <%= new Date(n.created_at).toLocaleDateString('bn-BD') %></div>
            </div>
            <% if (!n.is_read) { %><div class="unread-dot"></div><% } %>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script>
    async function markRead(id) {
      await fetch('/api/notifications/read/' + id, { method: 'POST' });
    }
  </script>
  <script src="/assets/js/main.js"></script>
</body>
</html>
