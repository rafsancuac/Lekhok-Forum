<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%# সেশন ১১৭: টাইপ→গ্রুপ-ম্যাপ + বাংলা-সংখ্যা — ফিল্টার-চিপ এখান থেকেই গণনা হয় %>
<%# সেশন ১১৮-ইউনিয়ন: ① message-গ্রুপে 'call' (missed-call 'অন্যান্য'-তে নয় — বার্তা-ও-কল
    চিপে; missed-call-ব্যাজ-মার্কআপ ইতিমধ্যে-ই comment-পরিবারের পাশে) ② follow নিজস্ব-চিপ
    (আগে 'অন্যান্য'-এ হারাত) ③ রুট-লেয়ারের ?type= ডিপ-লিংকে চিপ-প্রি-অ্যাকটিভেট (নিচে স্ক্রিপ্ট) %>
<%
  const bn117 = (n) => String(n).replace(/[0-9]/g, d => '০১২৩৪৫৬৭৮৯'[+d]);
  const G117 = [
    { key: 'mention',  label: 'ম্যানশন',         icon: 'fa-at',       types: ['mention'] },
    { key: 'reply',    label: 'উত্তর ও মন্তব্য', icon: 'fa-comments', types: ['reply', 'comment'] },
    { key: 'reaction', label: 'প্রতিক্রিয়া',      icon: 'fa-heart',    types: ['like', 'reaction'] },
    { key: 'message',  label: 'বার্তা ও কল',    icon: 'fa-envelope', types: ['message', 'call'] },
    { key: 'follow',   label: 'অনুসরণ',         icon: 'fa-user-plus', types: ['follow'] },
    /* 'other' = বাকি-সব (moderation/complaint/birthday/system/...) */
    { key: 'other',    label: 'অন্যান্য',         icon: 'fa-bell',     types: [] }
  ];
  const gKeyOf117 = (t) => (G117.find(g => g.types.indexOf(t) !== -1) || G117[G117.length - 1]).key;
  const gCount117 = {};
  items.forEach(n => { const k = gKeyOf117(n.type); gCount117[k] = (gCount117[k] || 0) + 1; });
%>
<%- include('../partials/header', { title: 'বিজ্ঞপ্তিসমূহ | লেখক ফোরাম' }) %>
  <div class="page-wrap" style="max-width:700px">
    <div class="notif-page-header">
      <h1 style="font-size:1.5rem;color:var(--brand);margin:0;">
        <i class="fas fa-bell" style="color:var(--accent);margin-right:8px;"></i>বিজ্ঞপ্তিসমূহ
        <% const unreadCount = items.filter(n => !n.is_read).length; %>
        <% if (unreadCount > 0) { %>
          <span class="notif-count-chip"><%= bn117(unreadCount) %> টি নতুন</span>
        <% } %>
      </h1>
      <% if (unreadCount > 0) { %>
        <a href="/notifications/mark-all-read" class="mark-all-read"><i class="fas fa-check-double"></i> সব পঠিত করুন</a>
      <% } %>
    </div>

    <%# ── সেশন ১১৯: টাইপ-ভিত্তিক ফিল্টার-ট্যাব (session113-সুপারিশ ⑤) —
        গ্রুপ-ম্যাপিং সার্ভার-সাইডে (route-অস্পৃশ্য); কাউন্ট-ব্যাজ বাংলা-ডিজিট;
        client-side ফিল্টার (৫০-আইটেম-পেজে তাত্ক্ষণিক) + dismiss-সিঙ্ক MutationObserver ── %>
    <% const bn119 = v => String(v).replace(/[0-9]/g, d => '০১২৩৪৫৬৭৮৯'[+d]); %>
    <% const G119 = { comment: ['comment', 'reply'], reaction: ['like', 'reaction'], mention: ['mention'], follow: ['follow'] }; %>
    <% const groupOf119 = t => G119.comment.indexOf(t) > -1 ? 'comment' : (G119.reaction.indexOf(t) > -1 ? 'reaction' : (G119.mention.indexOf(t) > -1 ? 'mention' : (G119.follow.indexOf(t) > -1 ? 'follow' : 'system'))); %>
    <% const g119 = { all: items.length, comment: 0, reaction: 0, mention: 0, follow: 0, system: 0 }; %>
    <% items.forEach(n => { g119[groupOf119(n.type)]++; }); %>
    <%# ── সেশন ১১৯: বাংলা আপেক্ষিক-সময় (cron-r4-আর্টিকেল-ফিড-প্যারিটি) —
        এইমাত্র → মিনিট → ঘণ্টা → দিন; ৭-দিন-পরে পূর্ণ-তারিখ-ফলব্যাক; title-এ পূর্ণ-তারিখ ── %>
    <% const rel119 = d => { const s = (Date.now() - new Date(d).getTime()) / 1000;
      if (!(s >= 0)) return new Date(d).toLocaleDateString('bn-BD');
      if (s < 60) return 'এইমাত্র';
      if (s < 3600) return bn119(Math.floor(s / 60)) + ' মিনিট আগে';
      if (s < 86400) return bn119(Math.floor(s / 3600)) + ' ঘণ্টা আগে';
      if (s < 7 * 86400) return bn119(Math.floor(s / 86400)) + ' দিন আগে';
      return new Date(d).toLocaleDateString('bn-BD'); }; %>

    <% if (items.length === 0) { %>
      <div class="notif-empty"><i class="fas fa-bell-slash"></i><p>এখনও কোনো বিজ্ঞপ্তি আসেনি।</p><small style="color:var(--text-muted);">নতুন কার্যকলাপ এখানে দেখা যাবে।</small></div>
    <% } else { %>
      <%# সেশন ১১৭: ফিল্টার-ট্যাব — 'সব' + গণনা-সহ গ্রুপ-চিপ (শূন্য-গ্রুপ আঁকা হয় না) %>
      <div class="notif-filter-bar" role="group" aria-label="বিজ্ঞপ্তি ফিল্টার">
        <button type="button" class="nft-chip is-active" data-nft="all" aria-pressed="true">সব <b><%= bn117(items.length) %></b></button>
        <% G117.forEach(g => { const c = gCount117[g.key] || 0; if (!c) return; %>
          <button type="button" class="nft-chip" data-nft="<%= g.key %>" aria-pressed="false"><i class="fas <%= g.icon %>" aria-hidden="true"></i><%= g.label %> <b><%= bn117(c) %></b></button>
        <% }) %>
      </div>
      <%# ফিল্টার-শূন্য-অবস্থা (JS টগল করে) %>
      <div id="notifFilterEmpty" class="notif-filter-empty" hidden>
        <i class="fas fa-inbox" aria-hidden="true"></i><span>এই ধরনের কোনো বিজ্ঞপ্তি নেই।</span>
      </div>
      <div class="notif-page-list">
        <% items.forEach(n => { %>
          <%# সেশন ১১৬: reaction/reply/mention টাইপ-আইকন — হেডার-ড্রপডাউনের _ico-ম্যাপের
              সাথে প্যারিটি (আগে শুধু icon-system + fa-bell-এ পড়ত; reaction = like-পরিবার,
              reply/mention = comment-পরিবার — feed.css-এর .icon-* প্যালেট পুনঃব্যবহার) %>
          <% const iconClass = n.type === 'birthday' ? 'icon-birthday' : (n.type === 'like' || n.type === 'reaction' ? 'icon-like' : (n.type === 'comment' || n.type === 'reply' || n.type === 'mention' ? 'icon-comment' : (n.type === 'follow' ? 'icon-follow' : (n.type === 'call' ? 'icon-call' : 'icon-system')))); %>
          <% const _ico = n.type === 'birthday' ? 'fa-birthday-cake' : (n.type === 'like' || n.type === 'reaction' ? 'fa-heart' : (n.type === 'comment' ? 'fa-comment' : (n.type === 'reply' ? 'fa-reply' : (n.type === 'mention' ? 'fa-at' : (n.type === 'follow' ? 'fa-user-plus' : (n.type === 'call' ? 'fa-phone-slash' : 'fa-bell')))))); %>
          <%# সেশন ১২৩: data-n = restore-পেলোড JSON (id/type/title/body/link/read/ts) —
              ডিসমিস-টোস্টের 'বাতিল করুন' এই ফিল্ড দিয়েই POST /api/notifications/restore
              করে (EJS-escape JSON.stringify — quote-নিরাপদ); হেডার-ড্রপডাউন ও
              live.js paintList-এর সাথে অভিন্ন চুক্তি %>
          <a href="<%= n.link || '#' %>" class="notif-page-item <%= n.is_read ? '' : 'unread' %>" data-type="<%= n.type %>" data-g117="<%= gKeyOf117(n.type) %>" onclick="markRead('<%= n.id %>')" data-n="<%= JSON.stringify({ i: n.id, t: n.type, ti: n.title || '', b: n.body || '', l: n.link || '', r: n.is_read ? 1 : 0, ts: n.created_at || '' }) %>">
            <%# সেশন ১০৮: actor-avatar — হেডার-ড্রপডাউন (সেশন ১০২) ও একই শেপ; actor না থাকলে টাইপ-আইকন %>
            <% if (n.actor_id) { %>
              <div class="notif-page-icon <%= iconClass %> has-avatar"><img class="notif-avatar" src="<%= n.actor_avatar || ('/avatar/' + n.actor_id) %>" alt="" loading="lazy" onerror="this.parentNode.classList.remove('has-avatar');this.remove()"><i class="fas <%= _ico %>"></i></div>
            <% } else { %>
            <div class="notif-page-icon <%= iconClass %>">
              <i class="fas <%= _ico %>"></i>
            </div>
            <% } %>
            <div class="notif-page-body">
              <div class="notif-page-title"><%= n.title %><% if (n.type === 'call') { %> <span class="notif-missed notif-missed--page"><i class="fas fa-phone-slash"></i> মিসড কল</span><% } %></div>
              <div class="notif-page-text"><%= n.body %></div>
              <div class="notif-page-time"><i class="far fa-clock"></i> <span title="<%= new Date(n.created_at).toLocaleString('bn-BD') %>"><%= rel119(n.created_at) %></span></div>
            </div>
            <%# সেশন ১১৪: FB-প্যারিটি সরান-বাটন (হোভারে দৃশ্যমান; নিজের-সারি-ইনভ্যারিয়েন্ট API) %>
            <button type="button" class="notif-dismiss" data-dismiss="<%= n.id %>" aria-label="বিজ্ঞপ্তিটি সরান" title="সরান"><i class="fas fa-xmark" aria-hidden="true"></i></button>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script>
    async function markRead(id) {
      await fetch('/api/notifications/read/' + id, { method: 'POST' });
    }
    /* ── সেশন ১১৪: বিজ্ঞপ্তি-সরান (FB-প্যারিটি) — অ্যানিমেটেড-রিমুভ + কাউন্ট-সিঙ্ক;
         শেষ-আইটেম সরলে সার্ভার-সত্যে (empty-state) রিলোড
       ── সেশন ১২৩: ডিসমিস-আন্ডু — data-n ক্যাপচার → lfUndoShow টোস্টে 'বাতিল করুন';
         undo = POST /api/notifications/restore + একই-রো DOM-এ ফিরিয়ে-অ্যানিমেট +
         unread-হলে চিপ/ব্যাজ +১; শেষ-আইটেম-রিলোড টোস্ট-সময় পর্যন্ত স্থগিত (undo-লে বাতিল) ── */
    (function () {
      var list = document.querySelector('.notif-page-list');
      if (!list) return;
      function bnDigitsOf(n) {
        var d = '০১২৩৪৫৬৭৮৯';
        return String(n).replace(/[0-9]/g, function (x) { return d[+x]; });
      }
      function bumpChip(delta) {
        var chip = document.querySelector('.notif-count-chip');
        if (chip) {
          var cur = parseInt(chip.textContent.trim().replace(/[০-৯]/g, function (d) { return '০১২৩৪৫৬৭৮৯'.indexOf(d); }), 10) || 0;
          var left = Math.max(0, cur + delta);
          if (left > 0) chip.textContent = bnDigitsOf(left) + ' টি নতুন';
          else chip.remove();
        }
        /* হেডার-ব্যাজ সার্ভার-সত্য (session121-চুক্তি) */
        fetch('/api/notifications/count', { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            var b = document.getElementById('notifBadge');
            if (b && d && typeof d.unread === 'number') b.textContent = d.unread > 0 ? bnDigitsOf(d.unread) : '';
          })
          .catch(function () {});
      }
      list.addEventListener('click', function (e) {
        var btn = e.target.closest('.notif-dismiss');
        if (!btn) return;
        e.preventDefault(); e.stopPropagation();
        var row = btn.closest('.notif-page-item');
        if (!row || row.dataset.dismissBusy) return;
        row.dataset.dismissBusy = '1';
        /* সেশন ১২৩: restore-পেলোড ক্যাপচার (fetch-এর আগেই — রো-ডেটা এখানেই সত্য) */
        var payload = null;
        try { payload = JSON.parse(row.getAttribute('data-n') || 'null'); } catch (_) {}
        var wasUnread = row.classList.contains('unread');
        fetch('/api/notifications/' + btn.dataset.dismiss + '/dismiss', { method: 'POST' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (!j || !j.ok) { row.removeAttribute('data-dismiss-busy'); return; }
            row.style.height = row.offsetHeight + 'px';
            requestAnimationFrame(function () {
              row.classList.add('removing');
              row.style.height = '0px';
            });
            var undoDone = false;
            var pendingReload = null; /* সেশন ১২৩: শেষ-আইটেম-রিলোড টোস্ট-আয়ু পর্যন্ত স্থগিত */
            setTimeout(function () {
              var rest = 0;
              if (!undoDone) {
                /* undo-হলে রো-অপসারণ করা হয় না — undo-ফাংশন নিজেই রো ফেরায় */
                row.remove();
                rest = list.querySelectorAll('.notif-page-item').length;
                if (wasUnread) bumpChip(-1);
                if (window.nftRecount117) window.nftRecount117();
                if (!rest) {
                  /* তালিকা-খালি → সার্ভার-সত্যে রিলোড, তবে undo-সুযোগ (৭সে) পর্যন্ত অপেক্ষা —
                     undo হলে pendingReload-নিষ্ক্রিয় (undoDone-গার্ড) */
                  pendingReload = setTimeout(function () { if (!undoDone) location.reload(); }, 7000);
                }
              }
            }, 260);
            if (payload && window.lfUndoShow) {
              var nextRef = row.nextSibling;
              window.lfUndoShow({
                message: 'বিজ্ঞপ্তি সরানো হয়েছে',
                ms: 7000,
                onUndo: function (after) {
                  undoDone = true;
                  fetch('/api/notifications/restore', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(payload)
                  }).then(function (r) { return r.json(); }).then(function (j2) {
                    if (j2 && j2.ok) {
                      row.classList.remove('removing');
                      row.style.height = '';
                      row.removeAttribute('data-dismiss-busy');
                      if (row.parentNode) row.parentNode.removeChild(row);
                      if (nextRef && nextRef.parentNode === list) list.insertBefore(row, nextRef);
                      else list.insertBefore(row, list.firstChild);
                      requestAnimationFrame(function () { row.classList.add('restoring'); setTimeout(function () { row.classList.remove('restoring'); }, 350); });
                      if (payload.r) { /* ছিল-অপঠিত → চিপ/ব্যাজ +১ */ bumpChip(1); }
                      if (window.nftRecount117) window.nftRecount117();
                    } else {
                      if (window.showToast) showToast('বাতিল করা যায়নি', 'error');
                    }
                    after();
                  }).catch(function () {
                    if (window.showToast) showToast('বাতিল করা যায়নি', 'error');
                    after();
                  });
                }
              });
            }
          })
          .catch(function () { row.removeAttribute('data-dismiss-busy'); });
      });
    })();
    /* ── সেশন ১১৭: ফিল্টার-ট্যাব — চিপ-ক্লিকে DOM-ফিল্টার (শূন্য-API);
         সরানোর পরে nftRecount117() চিপ-কাউন্ট-সিঙ্ক + সক্রিয়-চিপ-শূন্যে 'সব'-ফেরত ── */
    (function () {
      var bar = document.querySelector('.notif-filter-bar');
      var list = document.querySelector('.notif-page-list');
      if (!bar || !list) return;
      var emptyRow = document.getElementById('notifFilterEmpty');
      var emptyText = emptyRow ? emptyRow.querySelector('span') : null;
      var bnDigits = '০১২৩৪৫৬৭৮৯';
      function bn(n) { return String(n).replace(/[0-9]/g, function (d) { return bnDigits[+d]; }); }
      function applyFilter(key) {
        var vis = 0;
        list.querySelectorAll('.notif-page-item').forEach(function (it) {
          var show = key === 'all' || it.getAttribute('data-g117') === key;
          it.hidden = !show;
          if (show) vis++;
        });
        if (emptyRow) {
          emptyRow.hidden = vis > 0;
          if (emptyText && !vis) {
            var chip = bar.querySelector('.nft-chip[data-nft="' + key + '"]');
            var label = chip ? (chip.textContent || '').replace(/[০-৯]/g, '').trim() : '';
            emptyText.textContent = '"' + label + '" ধরনের কোনো বিজ্ঞপ্তি নেই।';
          }
        }
      }
      bar.addEventListener('click', function (e) {
        var chip = e.target.closest('.nft-chip');
        if (!chip) return;
        bar.querySelectorAll('.nft-chip').forEach(function (c) {
          var on = c === chip;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        applyFilter(chip.getAttribute('data-nft'));
        /* সেশন ১২১: চিপ-অবস্থা URL-এ পার্সিস্ট (?type=; 'সব' = পরিষ্কার-URL) —
           রিলোড/শেয়ার-লিংকে ফিল্টার টিকে থাকে; replaceState = ইতিহাস-পলিউশন-শূন্য */
        setUrl121(chip.getAttribute('data-nft'));
      });
      /* সেশন ১২১: URL-সিঙ্ক হেল্পার — pathname+search+hash সংরক্ষণ (ভবিষ্যতে ?page= এলেও নিরাপদ) */
      function setUrl121(key) {
        try {
          var u = new URL(location.href);
          if (key && key !== 'all') u.searchParams.set('type', key);
          else u.searchParams.delete('type');
          history.replaceState(null, '', u.pathname + (u.search || '') + (u.hash || ''));
        } catch (eU121) {}
      }
      /* সেশন ১২১: init — ?type= পড়ে মিলে-যাওয়া চিপ সক্রিয় করা (অ-বিদ্যমান/অবৈধ মান = নিরীহ-নো-অপ;
         synthetic .click() bar-ডেলিগেশনেই পড়ে — ডুপ্লিকেট-লজিক শূন্য) */
      try {
        var q121 = new URLSearchParams(location.search).get('type');
        if (q121 && q121 !== 'all') {
          var qc121 = bar.querySelector('.nft-chip[data-nft="' + q121 + '"]');
          if (qc121 && !qc121.classList.contains('is-active')) qc121.click();
        }
      } catch (eQ121) {}
      /* সরানোর পরে কাউন্ট-সিঙ্ক — সক্রিয়-চিপ শূন্য হলে 'সব'-এ ফেরত */
      window.nftRecount117 = function () {
        bar.querySelectorAll('.nft-chip').forEach(function (c) {
          var k = c.getAttribute('data-nft');
          var n = k === 'all'
            ? list.querySelectorAll('.notif-page-item').length
            : list.querySelectorAll('.notif-page-item[data-g117="' + k + '"]').length;
          var bEl = c.querySelector('b');
          if (bEl) bEl.textContent = bn(n);
          if (!n && k !== 'all') c.remove();
        });
        var act = bar.querySelector('.nft-chip.is-active');
        if (!act) {
          var all = bar.querySelector('.nft-chip[data-nft="all"]');
          if (all) { all.classList.add('is-active'); all.setAttribute('aria-pressed', 'true'); }
          applyFilter('all');
          setUrl121('all'); /* সেশন ১২১: 'সব'-ফেরত = URL-ও পরিষ্কার */
        } else {
          applyFilter(act.getAttribute('data-nft'));
        }
      };
    })();
    <%# সেশন ১২১-ইউনিয়ন-নোট: ?type=-init অ্যাকটিভেট-স্ক্রিপ্ট এখন উপরের session121-ব্লকেই
        (setUrl121 + synthetic-click — ক্যানোনিকল, bar-ডেলিগেশনে ফুল-পাইপলাইন চলে);
        আমার সমান্তরাল-কপি প্রত্যাহৃত (ডুপ্লিকেট-শূন্য)। সার্ভার-সাইড প্রি-ফিল্টার
        (daily.js NF_FAMILIES) অক্ষত — noscript-এ ?type= তখনও সার্ভারেই ফিল্টার হয়। %>
  </script>
