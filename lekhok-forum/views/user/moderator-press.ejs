<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>পত্রিকা কাটিং ব্যবস্থাপনা | মডারেটর প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body>
<%- include('../../admin/views/admin/partials/sidebar') %>
<div class="admin-main">
<div class="mod-page">
  <div class="mod-hero">
    <div>
      <h1><i class="fas fa-newspaper"></i> পত্রিকা কাটিং ব্যবস্থাপনা</h1>
      <p>পত্রিকায় ফোরামকে নিয়ে প্রকাশিত নিউজের ছবি যোগ / সম্পাদনা / মুছুন</p>
    </div>
    <a href="/moderator" class="mod-back-btn"><i class="fas fa-arrow-left"></i> প্যানেলে ফিরুন</a>
  </div>

  <% if (posted === 'dup') { %><div class="mod-flash ok"><i class="fas fa-clone"></i> এই কাটিংটি আগেই সংরক্ষিত ছিল (ডুপ্লিকেট রিকোয়েস্ট উপেক্ষিত) — নতুন ডুপ্লিকেট তৈরি হয়নি।</div><% } else if (posted) { %><div class="mod-flash ok"><i class="fas fa-check-circle"></i> সফলভাবে সংরক্ষিত হয়েছে। পরিচিতি পেজ ও /press পেজে সাথে সাথে প্রযোজ্য।</div><% } %>
  <% if (removed) { %><div class="mod-flash ok"><i class="fas fa-trash-alt"></i> কাটিংটি মুছে ফেলা হয়েছে।</div><% } %>
  <% if (error) { %><div class="mod-flash err"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

  <%# ── নতুন কাটিং যোগ ── %>
  <div class="mod-card">
    <h2><i class="fas fa-plus"></i> নতুন কাটিং যোগ করুন</h2>
    <p class="mod-hint">
      ছবি আপলোড করলে স্বয়ংক্রিয়ভাবে অপটিমাইজ হয়ে সংরক্ষিত হবে (WebP)। চাইলে ছবির সরাসরি <strong>URL</strong>-ও দিতে পারেন।
      যোগ করা ছবি <strong>/about</strong> পেজে সর্বোচ্চ ৪টি এবং <a href="/press" target="_blank" style="color:#059669;"><strong>/press</strong> পেজে</a> সবগুলো দেখা যাবে।
    </p>
    <form method="POST" action="/moderator/press" enctype="multipart/form-data">
      <div class="clip-grid">
        <div class="clip-field"><label>শিরোনাম</label><input type="text" name="title" maxlength="200" placeholder="যেমন: দৈনিক আজাদে ফোরামের সেমিনার নিয়ে খবর" /></div>
        <div class="clip-field"><label>পত্রিকার নাম</label><input type="text" name="paper_name" maxlength="120" placeholder="যেমন: দৈনিক আজাদ / প্রথম আলো" /></div>
        <div class="clip-field"><label>প্রকাশের তারিখ</label><input type="text" name="published_date" maxlength="40" placeholder="যেমন: জানুয়ারি ২০২৬" /></div>
        <div class="clip-field"><label>প্রদর্শন ক্রম</label><input type="number" name="sort_order" min="0" value="0" /></div>
        <div class="clip-field"><label>ছবি আপলোড</label><input type="file" name="image" accept="image/*" /></div>
        <div class="clip-field"><label>অথবা ছবির URL</label><input type="text" name="image_url" maxlength="600" placeholder="https://… (আপলোড না দিলে)" /></div>
        <div class="clip-field" style="grid-column:1/-1;"><label>একাধিক ছবি (টেনে সাজান)</label><%- include('../../admin/views/admin/partials/multi-image', { images: [] }) %></div>
        <div class="clip-field"><label>প্রদর্শন অবস্থা</label>
          <select name="is_active">
            <option value="1">দৃশ্যমান</option>
            <option value="0">লুকানো</option>
          </select>
        </div>
      </div>
      <div class="clip-actions">
        <button type="submit" class="mod-back-btn" style="background:#059669;border-color:#059669;"><i class="fas fa-plus"></i> কাটিং যোগ করুন</button>
      </div>
    </form>
  </div>

  <%# ── কাটিং তালিকা ── %>
  <div class="mod-card">
    <h2><i class="fas fa-images"></i> সব কাটিং <span class="clip-count"><%= clips.length %> টি</span><label style="font-size:.85rem;font-weight:600;color:#65676b;display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-left:10px;"><input type="checkbox" data-bulk-all style="width:16px;height:16px;"> সব সিলেক্ট</label></h2>
  <form method="POST" action="/moderator/press/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড কাটিংগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
    <button type="submit" name="mode" value="publish" formaction="/moderator/press/bulk-toggle" class="btn btn-sm" data-bulk-msg="সিলেক্টেড কাটিংগুলো প্রকাশ করবে?"><i class="fas fa-eye"></i> প্রকাশ</button>
    <button type="submit" name="mode" value="hide" formaction="/moderator/press/bulk-toggle" class="btn btn-sm" data-bulk-msg="সিলেক্টেড কাটিংগুলো লুকাবে?"><i class="fas fa-eye-slash"></i> লুকান</button>
  </form>

    <p class="mod-hint">যেকোনো কাটিংয়ের নামে ক্লিক করে সম্পাদনা করুন। "লুকানো" করলে পাবলিক পেজে দেখা যাবে না, তবে তথ্য থেকে যাবে।</p>
    <% if (!clips.length) { %><p class="mod-hint"><i class="fas fa-info-circle"></i> এখনো কোনো কাটিং যোগ করা হয়নি।</p><% } %>
    <% clips.forEach(c => { %>
      <details class="clip-row">
        <summary>
          <input type="checkbox" name="bulk_ids" value="<%= c.id %>" aria-label="সিলেক্ট" style="width:16px;height:16px;flex-shrink:0;margin-right:2px;">
          <i class="fas fa-chevron-right clip-chevron"></i>
          <img class="clip-thumb" src="<%= c.image_url %>" alt="" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'" />
          <div>
            <div class="clip-name"><%= c.title || 'শিরোনাম নেই' %></div>
            <div class="clip-sub"><%= [c.paper_name, c.published_date].filter(Boolean).join(' · ') || 'বিবরণ নেই' %></div>
          </div>
          <span class="clip-chip <%= c.is_active ? '' : 'off' %>"><%= c.is_active ? 'দৃশ্যমান' : 'লুকানো' %></span>
          <button type="button" class="clip-edit-btn" title="সম্পাদনা ও সংরক্ষণ ফর্ম খুলুন" onclick="var d=this.closest('details'); d.open=true; d.scrollIntoView({behavior:'smooth', block:'center'});"><i class="fas fa-pen"></i> সম্পাদনা / সংরক্ষণ</button>
        </summary>
        <div style="padding:16px 14px;">
          <%# ── টাস্ক ১৩ খ: সেকশন-ভিত্তিক সম্পাদনা (প্রতি সেকশন আলাদা সেভ) ── %>
          <div class="sf-section" data-save-url="/moderator/press/<%= c.id %>/section">
            <div class="sf-head">
              <h3>মূল তথ্য <span class="sf-count">৫</span></h3>
              <div class="sf-actions">
                <span class="sf-status" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-sm sf-edit"><i class="fas fa-pen"></i> সম্পাদনা</button>
                <button type="button" class="btn btn-sm btn-primary sf-save" hidden><i class="fas fa-check"></i> সেভ</button>
                <button type="button" class="btn btn-sm sf-cancel" hidden><i class="fas fa-times"></i> বাতিল</button>
              </div>
            </div>
            <div class="clip-grid">
              <div class="clip-field"><label>শিরোনাম</label><input type="text" name="title" maxlength="200" value="<%= c.title || '' %>" readonly /></div>
              <div class="clip-field"><label>পত্রিকার নাম</label><input type="text" name="paper_name" maxlength="120" value="<%= c.paper_name || '' %>" readonly /></div>
              <div class="clip-field"><label>প্রকাশের তারিখ</label><input type="text" name="published_date" maxlength="40" value="<%= c.published_date || '' %>" readonly /></div>
              <div class="clip-field"><label>প্রদর্শন ক্রম</label><input type="number" name="sort_order" min="0" value="<%= c.sort_order || 0 %>" readonly /></div>
              <div class="clip-field"><label>প্রদর্শন অবস্থা</label>
                <select name="is_active" disabled>
                  <option value="1" <%= c.is_active ? 'selected' : '' %>>দৃশ্যমান</option>
                  <option value="0" <%= c.is_active ? '' : 'selected' %>>লুকানো</option>
                </select>
              </div>
            </div>
          </div>

          <div class="sf-section" data-save-url="/moderator/press/<%= c.id %>/section">
            <div class="sf-head">
              <h3>ছবি <span class="sf-count"><%= (c._images || []).length %></span></h3>
              <div class="sf-actions">
                <span class="sf-status" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-sm sf-edit"><i class="fas fa-pen"></i> সম্পাদনা</button>
                <button type="button" class="btn btn-sm btn-primary sf-save" hidden><i class="fas fa-check"></i> সেভ</button>
                <button type="button" class="btn btn-sm sf-cancel" hidden><i class="fas fa-times"></i> বাতিল</button>
              </div>
            </div>
            <div class="clip-field"><label>কভার ছবির URL</label><input type="text" name="image_url" maxlength="600" value="<%= c.image_url %>" readonly /></div>
            <div class="clip-field" style="margin-top:10px;"><label>একাধিক ছবি (টেনে সাজান)</label><%- include('../../admin/views/admin/partials/multi-image', { images: c._images || [] }) %></div>
          </div>

          <div class="clip-actions">
            <form method="POST" action="/moderator/press/<%= c.id %>/delete">
              <button type="submit" class="clip-del"><i class="fas fa-trash-alt"></i> মুছে ফেলুন</button>
            </form>
          </div>
        </div>
      </details>
    <% }) %>
  </div>
</div>
</div><!-- /admin-main -->
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
<%- include('../partials/sandbox-preview') %>
</body>
</html>
