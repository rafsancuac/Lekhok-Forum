<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'উপদেষ্টা পর্ষদ — লেখক ফোরাম' }) %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-user-shield"></i> উপদেষ্টা পর্ষদ</h1>
      <p class="header-sub">লেখক ফোরামের সম্মানিত উপদেষ্টামণ্ডলী</p>
    </div>
    <% if (advisory.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-user-shield"></i><p>কোনো উপদেষ্টা যোগ করা হয়নি।</p></div>
    <% } else { %>
      <div class="members-grid">
        <% advisory.forEach(a => { %>
          <div class="member-card advisor">
            <img src="<%= a.avatar_url || '/avatar/' + a.id %>" class="member-avatar advisor-avatar">
            <h3 class="member-name"><%= a.full_name %></h3>
            <p class="member-handle">@<%= a.username %></p>
            <% if (a.designation) { %><p class="member-desig"><i class="fas fa-award"></i> উপদেষ্টা</p><% } %>
            <% if (a.bio) { %><p class="member-bio"><%= a.bio.substring(0, 80) %>...</p><% } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
