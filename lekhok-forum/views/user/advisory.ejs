<%# পেজ-নির্দিষ্ট টাইটেল/CSS — header.ejs একমাত্র ডকুমেন্ট-ওপেনার (HTML nesting fix) %>
<%- include('../partials/header', { title: 'উপদেষ্টা পর্ষদ — বাংলাদেশ তরুণ কলাম লেখক ফোরাম' }) %>
  <div class="page-wrap">
    <div class="page-header">
      <h1><i class="fas fa-user-shield"></i> উপদেষ্টা পর্ষদ</h1>
      <p class="header-sub">বাংলাদেশ তরুণ কলাম লেখক ফোরামের সম্মানিত উপদেষ্টামণ্ডলী</p>
    </div>
    <% if (advisory.length === 0) { %>
      <div class="empty-state-full"><i class="fas fa-user-shield"></i><p>কোনো উপদেষ্টা যোগ করা হয়নি।</p></div>
    <% } else { %>
      <div class="members-grid">
        <% advisory.forEach(a => { %>
          <% const displayName = a.user_full_name || a.name; %>
          <% const displayImg  = a.user_avatar_url || a.image_url || ('/avatar/' + (a.user_id || a.id)); %>
          <% if (a.user_username) { %>
            <a href="/profile/<%= a.user_username %>" class="member-card advisor linked-member">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" class="member-avatar advisor-avatar" alt="<%= displayName %>">
              <h3 class="member-name"><%= displayName %></h3>
              <p class="member-handle">@<%= a.user_username %></p>
              <% if (a.user_designation) { %>
                <p class="member-desig"><i class="fas fa-award"></i> <%= a.user_designation %></p>
              <% } else if (a.role) { %>
                <p class="member-desig"><i class="fas fa-award"></i> <%= a.role %></p>
              <% } %>
              <% if (a.bio) { %><p class="member-bio"><%= a.bio.substring(0, 80) %>...</p><% } %>
              <span class="profile-link-badge"><i class="fas fa-external-link-alt"></i> প্রোফাইল দেখুন</span>
            </a>
          <% } else { %>
            <div class="member-card advisor">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" class="member-avatar advisor-avatar" alt="<%= displayName %>">
              <h3 class="member-name"><%= displayName %></h3>
              <p class="member-handle"><%= a.role %></p>
              <% if (a.bio) { %><p class="member-bio"><%= a.bio.substring(0, 80) %>...</p><% } %>
            </div>
          <% } %>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script src="/assets/js/main.js?v=<%= AV %>"></script>
</body>
</html>
