<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('committee_header_eyebrow') %></span>
    <h1><%= C('committee_header_title') %></h1>
    <p><%= C('committee_header_sub') %></p>
  </div>
</header>

<style>
/* ── কার্যবর্ষ নির্বাচন বার: ইনট্রো সেন্টারে, ড্রপডাউন একদম ডানে ── */
.term-bar { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 14px; }
.term-intro { margin: 0; text-align: center; }
.term-select-wrap { justify-self: end; display: inline-flex; align-items: center; gap: 8px; }
.term-select-label { font-size: 0.85rem; font-weight: 700; color: var(--text-muted, #64748b); white-space: nowrap; }
#termSelect {
  appearance: none; -webkit-appearance: none;
  padding: 9px 36px 9px 14px; border-radius: 8px;
  border: 1.5px solid var(--border, #e2e8f0); background-color: #fff; color: var(--text, #334155);
  font-family: inherit; font-size: 0.92rem; font-weight: 700; cursor: pointer;
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E");
  background-repeat: no-repeat; background-position: right 12px center; background-size: 12px;
}
#termSelect:focus { outline: none; border-color: var(--accent, #059669); box-shadow: 0 0 0 3px rgba(5,150,105,.12); }

/* ── কার্ড: পুরোটাই ক্লিকেবল, আলাদা কোনো "ক্লিক করুন" লেখা নেই ────────── */
.leader-card { position: relative; overflow: hidden; }
.leader-card img { transition: transform .35s ease; }
.leader-card:hover img { transform: scale(1.06); }
.leader-card.linked-member::after {
  content: '\f061'; /* fa-arrow-right */
  font-family: 'Font Awesome 6 Free'; font-weight: 900;
  position: absolute; top: 12px; right: 12px;
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--accent, #059669); color: #fff; font-size: 0.72rem;
  opacity: 0; transform: translate(6px, -6px);
  transition: opacity .2s, transform .2s;
}
.leader-card.linked-member:hover::after { opacity: 1; transform: translate(0, 0); }
.member-term-tag {
  position: absolute; top: 12px; left: 12px; z-index: 1;
  padding: 3px 10px; border-radius: 999px;
  background: rgba(10,31,68,.82); color: #fff;
  font-size: 0.68rem; font-weight: 700; letter-spacing: .02em;
  backdrop-filter: blur(3px);
}

/* খালি কার্যবর্ষের অবস্থা */
.term-empty {
  text-align: center; padding: 54px 24px;
  background: var(--bg-soft, #f8fafc);
  border: 1.5px dashed var(--border, #cbd5e1); border-radius: 16px;
}
.term-empty i { font-size: 2rem; color: var(--accent, #059669); margin-bottom: 12px; }
.term-empty h3 { margin: 0 0 6px; color: var(--brand, #0a1f44); font-size: 1.15rem; }
.term-empty p { margin: 0; color: var(--text-muted, #64748b); font-size: .93rem; }

@media (max-width: 576px) {
  .term-select-wrap { gap: 6px; }
  #termSelect { padding: 8px 32px 8px 12px; font-size: 0.88rem; }
}
</style>

<% const bnNum = (n) => String(n).replace(/[0-9]/g, (d) => '০১২৩৪৫৬৭৮৯'[d]); %>

<!-- কার্যবর্ষ ফিল্টার -->
    <div class="term-bar">
      <p class="term-intro">
          <% if (selectedYear) { %><strong><%= selectedYear %></strong> কার্যবর্ষের পূর্ণাঙ্গ কার্যনির্বাহী কমিটি<% if (termNote) { %> (<%= termNote %>)<% } %>.<% } else { %>বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চবি শাখা।<% } %>
          <% if (countByYear[selectedYear]) { %>মোট সদস্য <strong><%= bnNum(countByYear[selectedYear]) %></strong> জন।<% } %>
      </p>
      <div class="term-select-wrap">
        <label class="term-select-label" for="termSelect"><i class="far fa-calendar"></i> <%= C('committee_term_label') %></label>
        <select id="termSelect" aria-label="কার্যবর্ষ নির্বাচন" onchange="if (this.value) window.location.href = '/committee?year=' + encodeURIComponent(this.value);">
          <% years.forEach(y => { %>
            <option value="<%= y %>" <%= y === selectedYear ? 'selected' : '' %>><%= y %><%= countByYear[y] ? ' (সদস্য ' + bnNum(countByYear[y]) + ' জন)' : '' %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <% if (central && central.length) { %>
      <div class="leaders-grid" style="margin-top:26px">
        <% central.forEach(m => { %>
          <% const displayName = m.user_full_name || m.name; %>
          <% const displayImg  = m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg'; %>
          <% if (m.user_username) { %>
            <a href="/profile/<%= m.user_username %>" class="leader-card has-image clickable-card linked-member">
              <span class="member-term-tag"><%= selectedYear %></span>
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= m.role %></p>
                <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
              </div>
            </a>
          <% } else { %>
            <div class="leader-card has-image clickable-card"
                 onclick="openMemberModal('<%= m.id %>')"
                 data-member="<%= m.id %>"
                 data-name="<%= m.name.replace(/'/g, '&#39;') %>"
                 data-role="<%= m.role.replace(/'/g, '&#39;') %>"
                 data-designation="<%= (m.designation || '').replace(/'/g, '&#39;') %>"
                 data-bio="<%= (m.bio || '').replace(/'/g, '&#39;').replace(/"/g, '&quot;') %>"
                 data-image="<%= m.image_url || '/assets/img/avatar-placeholder.svg' %>">
              <span class="member-term-tag"><%= selectedYear %></span>
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= m.role %></p>
                <% if (m.bio) { %><p class="leader-bio"><%= m.bio.substring(0, 90) %><%= m.bio.length > 90 ? '…' : '' %></p><% } %>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="term-empty" style="margin-top:26px">
        <i class="far fa-folder-open"></i>
        <h3><%= selectedYear || 'এই' %> কার্যবর্ষের কমিটির তথ্য এখনো সংরক্ষিত হয়নি</h3>
        <p>অফিসিয়াল তালিকা পাওয়ামাত্র এখানে যুক্ত করা হবে, ইনশাআল্লাহ।</p>
      </div>
    <% } %>
  </div>
</section>


<!-- উপদেষ্টা পরিষদ এখন আলাদা পেজে: /committee/advisory -->
<!-- বিস্তারিত মডাল -->
<div class="modal-overlay" id="memberModal" onclick="if(event.target===this) closeMemberModal()">
  <div class="modal-dialog">
    <div class="modal-head">
      <button class="modal-close" onclick="closeMemberModal()" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-member-inner" id="modalBody"></div>
  </div>
</div>

<script>
function openMemberModal(id) {
  const card = document.querySelector('[data-member="' + id + '"]');
  if (!card) return;
  const data = {
    name: card.dataset.name,
    role: card.dataset.role,
    designation: card.dataset.designation,
    bio: card.dataset.bio,
    image: card.dataset.image
  };
  const body = document.getElementById('modalBody');
  body.innerHTML = '<img loading="lazy" decoding="async" src="' + data.image + '" alt="' + data.name + '">'
    + '<h3 class="mm-name">' + data.name + '</h3>'
    + '<p class="mm-role">' + data.role + '</p>'
    + (data.designation ? '<p class="mm-desig">' + data.designation + '</p>' : '')
    + (data.bio ? '<p class="mm-bio">' + data.bio + '</p>' : '<p class="mm-bio" style="text-align:center;color:var(--text-muted)">বিস্তারিত বিবরণ শীঘ্রই যোগ করা হবে।</p>');
  document.getElementById('memberModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeMemberModal() {
  document.getElementById('memberModal').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMemberModal(); });
</script>
