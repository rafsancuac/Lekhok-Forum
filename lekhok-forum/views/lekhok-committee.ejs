<header class="page-header">
  <div class="container">
    <span class="eyebrow">নেতৃত্ব</span>
    <h1>সংগঠন কমিটি</h1>
    <p>লেখক ফোরাম — কেন্দ্রীয় ও বিশ্ববিদ্যালয় শাখা কমিটি</p>
  </div>
</header>

<!-- Central committee -->
<section class="section reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">কেন্দ্রীয় কমিটি</span>
        <h2 class="section-title">কেন্দ্রীয় <span class="accent">কার্যনির্বাহী কমিটি</span></h2>
        <span class="accent-divider"></span>
      </div>
    </div>
    <% if (central && central.length) { %>
      <div class="leaders-grid reveal-stagger">
        <% central.forEach(m => { %>
          <div class="leader-card has-image">
            <img src="<%= m.image_url || '/assets/img/avatar-placeholder.svg' %>" alt="<%= m.name %>" loading="lazy" />
            <div class="leader-body">
              <h3><%= m.name %></h3>
              <p class="role"><%= m.role %></p>
              <% if (m.bio) { %><p class="leader-bio"><%= m.bio %></p><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-users-cog"></i>
        <h3>এখনও কোনো কেন্দ্রীয় কমিটি সদস্য যোগ হয়নি</h3>
        <p>অ্যাডমিন প্যানেল থেকে কমিটি সদস্য যোগ করুন</p>
        <a href="/admin/members/new" class="btn btn-primary"><i class="fas fa-plus"></i> সদস্য যোগ করুন</a>
      </div>
    <% } %>
  </div>
</section>

<!-- Branch committee -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">বিশ্ববিদ্যালয় শাখা</span>
        <h2 class="section-title">বিশ্ববিদ্যালয় <span class="accent">শাখা কমিটি</span></h2>
        <span class="accent-divider"></span>
      </div>
    </div>
    <% if (branch && branch.length) { %>
      <div class="leaders-grid reveal-stagger">
        <% branch.forEach(m => { %>
          <div class="leader-card has-image">
            <img src="<%= m.image_url || '/assets/img/avatar-placeholder.svg' %>" alt="<%= m.name %>" loading="lazy" />
            <div class="leader-body">
              <h3><%= m.name %></h3>
              <p class="role"><%= m.role %></p>
              <% if (m.bio) { %><p class="leader-bio"><%= m.bio %></p><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-university"></i>
        <h3>আপনার বিশ্ববিদ্যালয় শাখার কমিটির তথ্য এখানে যুক্ত করুন</h3>
        <p>অ্যাডমিন প্যানেল থেকে সদস্য যোগ করুন</p>
        <a href="/admin/members/new" class="btn btn-primary"><i class="fas fa-plus"></i> সদস্য যোগ করুন</a>
      </div>
    <% } %>
  </div>
</section>
