<%
  // ── সেশন ৯৯ (cron-r2): জনপ্রিয়-ট্যাগ ক্লাউড — রুট থেকে আসা raw tag-rows পার্স+কাউন্ট+সর্ট (রুট-ফাইল স্পর্শ নয়)
  const tagRows99 = Array.isArray(popularTags) ? popularTags : [];
  const tagCount99 = {};
  tagRows99.forEach(r => {
    String(r.tags || '').split(',').forEach(t => {
      const name = t.trim();
      if (!name) return;
      tagCount99[name] = (tagCount99[name] || 0) + 1;
    });
  });
  const topTags99 = Object.entries(tagCount99)
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'bn'))
    .slice(0, 14)
    .map(([name, count]) => ({ name, count }));
  const bn99 = (n) => String(n).replace(/[0-9]/g, d => '০১২৩৪৫৬৭৮৯'[d]);
  // ট্যাগ-টগলে type-ফিল্টার (filter=) টিক থাকে; type-ট্যাবে ক্লিকে ট্যাগ রিসেট
  const keepFilter99 = filterType ? '&filter=' + encodeURIComponent(filterType) : '';
  const allUrl99 = '/articles' + (filterType ? '?filter=' + encodeURIComponent(filterType) : '');
%>
<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('articles_header_eyebrow') %></span>
    <h1><%= filterType === 'column' ? 'প্রকাশিত কলাম' : filterType === 'letter' ? 'প্রকাশিত চিঠি' : 'প্রকাশিত লেখা' %></h1>
    <p><%= C('articles_header_sub') %></p>
  </div>
</header>

<section class="section reveal">
  <div class="container">
    <!-- Filter tabs -->
    <div class="notice-tabs" style="margin-bottom:20px">
      <a href="/articles" class="<%= !filterType ? 'active' : '' %>"><i class="fas fa-layer-group"></i> সকল</a>
      <a href="/articles?filter=column" class="<%= filterType === 'column' ? 'active' : '' %>"><i class="fas fa-pen-nib"></i> প্রকাশিত কলাম</a>
      <a href="/articles?filter=letter" class="<%= filterType === 'letter' ? 'active' : '' %>"><i class="fas fa-envelope"></i> প্রকাশিত চিঠি</a>
    </div>

    <% if (topTags99.length) { %>
      <div class="tag-bar" role="navigation" aria-label="জনপ্রিয় বিষয় অনুযায়ী ফিল্টার">
        <span class="tag-bar-label"><i class="fas fa-hashtag" aria-hidden="true"></i> জনপ্রিয় বিষয়</span>
        <div class="tag-bar-chips">
          <a href="<%= allUrl99 %>" class="tag-pill<%= !tag ? ' active' : '' %>">সব</a>
          <% topTags99.forEach(t => { %>
            <a href="/articles?tag=<%= encodeURIComponent(t.name) %><%= keepFilter99 %>" class="tag-pill<%= tag === t.name ? ' active' : '' %>" aria-label="<%= t.name %> বিষয়ে <%= bn99(t.count) %>টি লেখা">
              <%= t.name %><span class="tag-count"><%= bn99(t.count) %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (tag) { %>
      <div class="tag-filter-note" role="status">
        <i class="fas fa-filter" aria-hidden="true"></i>
        <span><strong><%= tag %></strong> বিষয়ে <span class="tfn-count"><%= bn99(articles ? articles.length : 0) %></span>টি লেখা পাওয়া গেছে</span>
        <a href="<%= allUrl99 %>" class="tag-clear">ফিল্টার সরান <i class="fas fa-times" aria-hidden="true"></i></a>
      </div>
    <% } %>

    <% if (articles && articles.length) { %>
      <div class="articles-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:20px;">
        <% articles.forEach(post => { %>
          <div class="post-card card" style="padding:0; overflow:hidden;">
            <% if (post.images && post.images.length) { %>
              <%- include('partials/post-gallery', { images: post.images, alt: post.title, height: '180px', group: 'art-' + post.id }) %>
            <% } %>
            <div style="padding:16px 18px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <%# সেশন ৯৯: প্রথম-ট্যাগ এখন ক্লিকেবল ফিল্টার-লিঙ্ক (আগে নিষ্ক্রিয় span) %>
                <a class="card-tag" href="/articles?tag=<%= encodeURIComponent(post.tags ? post.tags.split(',')[0].trim() : 'সাধারণ') %><%= keepFilter99 %>">
                  <%= post.tags ? post.tags.split(',')[0].trim() : 'সাধারণ' %>
                </a>
                <span style="font-size:11px; color:var(--text-muted);">
                  <i class="far fa-clock"></i> <%= new Date(post.published_at).toLocaleDateString('bn-BD') %>
                </span>
              </div>
              <a href="/articles/<%= post.id %>" style="text-decoration:none; color:inherit;">
                <h3 style="margin:0 0 8px; font-size:16px; line-height:1.4;"><%= post.title %></h3>
              </a>
              <p style="font-size:13px; color:var(--text-soft); line-height:1.6; margin:0 0 10px;">
                <%# সেশন ৬৬: এক্সারপ্ট-ফলব্যাকে ## হেডিং-মার্কার যেত — স্ট্রিপ + হোয়াইটস্পেস-কোলাপ্স %>
                <%= mdPlain(post.excerpt || post.body || '', 120) %>
              </p>
              <div style="display:flex; justify-content:space-between; align-items:center; padding-top:8px; border-top:1px solid var(--border);">
                <a href="/profile/<%= post.author_username %>" style="display:flex; align-items:center; gap:6px; text-decoration:none; color:inherit;">
                  <img src="<%= post.author_avatar || '/avatar/' + post.author_id %>" alt="" style="width:24px; height:24px; border-radius:50%;" loading="lazy">
                  <span style="font-size:12px; font-weight:500;"><%= post.author_name %></span>
                </a>
                <div style="display:flex; gap:10px; font-size:12px; color:var(--text-muted); align-items:center;">
                  <span><i class="far fa-heart"></i> <%= post.like_count || 0 %></span>
                  <span><i class="far fa-comment"></i> <%= post.comment_count || 0 %></span>
                  <%# সেশন ৬৬: কার্ডে সংরক্ষণ-বাটন (main.js গ্লোবাল .bookmark-btn হ্যান্ডলার,
                      data-bookmark-id দিয়ে; সেভ-থাকলে প্রিফিল-অ্যাক্টিভ) %>
                  <button type="button" class="save-btn bookmark-btn<%= bookmarkedIds && bookmarkedIds.indexOf(post.id) !== -1 ? ' active' : '' %>"
                          data-bookmark-id="<%= post.id %>" aria-label="সংরক্ষণ" title="সংরক্ষণ">
                    <i class="<%= bookmarkedIds && bookmarkedIds.indexOf(post.id) !== -1 ? 'fas' : 'far' %> fa-bookmark"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-pen-nib"></i>
        <h3>এখনো কোনো লেখা প্রকাশিত হয়নি</h3>
        <p>নতুন লেখা এখানে দেখা যাবে</p>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/articles/new" class="btn btn-primary"><i class="fas fa-plus"></i> নতুন লেখা লিখুন</a>
        <% } else { %>
          <a href="/login" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> লগইন করে লিখুন</a>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
