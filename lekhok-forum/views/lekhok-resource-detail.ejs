<%#
  সেশন ১০৫: রিসোর্স-ডিটেইল পেজ (/resources/:id)
  ═══════════════════════════════════════════════════════════════════════════
  ?r=<id> ডিপ-লিংকের পূর্ণ-পেজ রূপ — টাইপ-টিন্টেড প্রিভিউ-হিরো + পূর্ণ-বিবরণ
  (markdown-lite) + ইনফো-স্ট্রিপ + সম্পর্কিত-রিসোর্স। স্কোপড ক্লাস rsxd-*
  (অন্য-পেজে প্রভাব শূন্য); সম্পর্কিত-গ্রিডে rsx-কার্ড-স্টাইলের মিনি-সাবসেট কপি।
%><% const BN = '০১২৩৪৫৬৭৮৯'; const bn = n => String(n).replace(/\d/g, d => BN[+d]); %><%
  const CAT_BN = { guide: 'গাইড', document: 'ডকুমেন্ট', report: 'প্রতিবেদন', form: 'ফর্ম', anthology: 'সংকলন', reference: 'রেফারেন্স', scholarship: 'ফেলোশিপ', 'writing-tips': 'লেখালেখির টিপস', general: 'সাধারণ', 'audio-lecture': 'অডিও লেকচার', 'video-class': 'ভিডিও ক্লাস', ebook: 'ই-বুক' };
  const catBn = (c) => CAT_BN[c] || c;
  const T = RES_TYPE_META.RES_TYPES[r.res_type] || RES_TYPE_META.RES_TYPES.link;
  const rUrl = r.link_url || r.file_url || '';
  const embed = (r.res_type === 'video') ? videoEmbedUrl(rUrl) : null;
  const isImg = r.res_type === 'image';
  const cover = isImg ? rUrl : (r.thumbnail_url || null);
  /* সেশন ১৩১: bnDate → helpers/bn-date (DB-নেম-লেস = UTC + Asia/Dhaka) —
     পুরনো new Date(d) হোস্ট-লোকাল পার্স ছিল (বাংলাদেশে ৬ঘ-ভুল/তারিখ-স্খলন);
     ভিউতে require-নেই — রুট (pages.js) রেন্ডার-লোকাল হিসেবে bnDate পাস করে, এখানে সরাসরি ব্যবহার। */
%>

<div class="rsxd-wrap">

  <%# ── ব্রেডক্রাম্ব-বার ── %>
  <nav class="rsxd-crumbs" aria-label="ব্রেডক্রাম্ব">
    <a href="/resources"><i class="fas fa-arrow-left"></i> সব রিসোর্স</a>
    <span class="rsxd-crumb-sep"><i class="fas fa-chevron-right"></i></span>
    <a href="/resources?category=<%= encodeURIComponent(r.category || 'general') %>"><i class="fas fa-folder"></i> <%= catBn(r.category) %></a>
    <span class="rsxd-crumb-sep"><i class="fas fa-chevron-right"></i></span>
    <span class="rsxd-crumb-here"><%= r.title %></span>
    <%# সেশন ১০৭: স্টাফ-অ্যাকশন — অ্যাডমিনে এডিট/মুছুন-শর্টকাট, মডারেটরে প্যানেল-লিংক।
        মুছুন = fetch-DELETE (X-CSRF-Token, ?_u= fresh-token-রিফ্রেশ — session103 চুক্তি)। %>
    <% if (isStaff && (staffRole === 'admin' || staffRole === 'superadmin')) { %>
      <span class="rsxd-staffacts">
        <a href="/admin/resources/<%= r.id %>/edit" class="rsxd-sact rsxd-sact-edit" title="অ্যাডমিন-প্যানেলে সম্পাদনা"><i class="fas fa-pen-to-square"></i> এডিট</a>
        <button type="button" class="rsxd-sact rsxd-sact-del" id="rsxdDel" title="ট্র্যাশে পাঠিয়ে মুছুন"><i class="fas fa-trash-can"></i> মুছুন</button>
      </span>
    <% } else if (isStaff && staffRole === 'moderator' && staffName && String(r.created_by || '') === String(staffName)) { %>
      <span class="rsxd-staffacts">
        <a href="/moderator/resources?edit=<%= r.id %>" class="rsxd-sact rsxd-sact-edit" title="আপনার আপলোড — মডারেটর-প্যানেলে সম্পাদনা"><i class="fas fa-pen-to-square"></i> এডিট</a>
        <a href="/moderator/resources" class="rsxd-manage" title="মডারেটর রিসোর্স-প্যানেল"><i class="fas fa-sliders"></i> ম্যানেজ</a>
      </span>
    <% } else if (isStaff) { %>
      <a href="/moderator/resources" class="rsxd-manage" title="মডারেটর রিসোর্স-প্যানেল"><i class="fas fa-sliders"></i> ম্যানেজ</a>
    <% } %>
  </nav>

  <%# ── হিরো: টাইপ-টিন্টেড প্রিভিউ + মেটা ── %>
  <article class="rsxd-hero" data-type="<%= r.res_type %>" style="--rt-color:<%= T.color %>;--rt-bg:<%= T.bg %>;--rt-border:<%= T.border %>;">
    <div class="rsxd-media rsxd-media-<%= r.res_type %>">
      <% if (r.res_type === 'video' && embed && rUrl) { %>
        <iframe src="<%= embed %>" title="<%= r.title %>" allow="encrypted-media; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
      <% } else if (r.res_type === 'video' && rUrl) { %>
        <video controls preload="metadata" src="<%= rUrl %>"></video>
      <% } else if (cover) { %>
        <img src="<%= cover %>" alt="<%= r.title %>" onerror="this.closest('.rsxd-media').classList.add('rsxd-media-fallback')">
        <% if (!isImg && rUrl) { %><a class="rsxd-cover-cta" href="<%= rUrl %>" target="_blank" rel="noopener" data-rsxd-open><i class="fas <%= T.icon %>"></i> ফাইল খুলুন</a><% } %>
      <% } else if (r.res_type === 'audio' && rUrl) { %>
        <div class="rsxd-audiohero">
          <div class="rsxd-audiohero-ic"><i class="fas fa-headphones"></i></div>
          <div class="rsxd-audiohero-wv" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
          <p class="rsxd-audiohero-t">অডিও লেকচার</p>
        </div>
      <% } else { %>
        <div class="rsxd-noimg">
          <i class="fas <%= T.icon %>"></i>
          <p>এই রিসোর্সের প্রিভিউ নেই</p>
          <% if (rUrl) { %><span>খুলতে/ডাউনলোডে নিচের বাটন</span><% } %>
        </div>
      <% } %>
      <% if (r.res_type === 'audio' && rUrl) { %>
        <div class="rsxd-audiobar"><audio controls preload="metadata" src="<%= rUrl %>"></audio></div>
      <% } %>
    </div>

    <div class="rsxd-body">
      <div class="rsxd-badges">
        <span class="rsx-badge" style="background:<%= T.bg %>;color:<%= T.color %>;border-color:<%= T.border %>;">
          <i class="fas <%= T.icon %>"></i> <%= T.label %>
        </span>
        <span class="rsxd-cat"><i class="fas fa-folder-open"></i> <%= catBn(r.category) %></span>
        <% if (seriesName) { %>
          <a class="rsxd-seribadge" href="/resources?series=<%= encodeURIComponent(seriesName) %>" title="সিরিজের সব পর্ব">
            <i class="fas fa-book-open"></i> <%= seriesName %><% if (seriesPos) { %> · পর্ব <%= bn(seriesPos) %>/<%= bn(seriesItems.length) %><% } %>
          </a>
        <% } %>
      </div>

      <h1 class="rsxd-title"><%= r.title %></h1>

      <div class="rsxd-byline">
        <% if (r.author) { %><span><i class="far fa-user"></i> <%= r.author %></span><% } %>
        <% if (r.created_at) { %><span><i class="far fa-calendar"></i> <%= bnDate(r.created_at) %></span><% } %>
      </div>

      <% if (r.content) { %><p class="rsxd-lead"><%= mdPlain(r.content, 190) %></p><% } %>

      <div class="rsxd-statsrow" aria-live="polite">
        <span class="rsxd-stat" title="পাঠ"><i class="far fa-eye"></i> <strong id="rsxdViews"><%= bn(r.views || 0) %></strong> পাঠ</span>
        <span class="rsxd-stat" title="ডাউনলোড/খোলা"><i class="fas fa-download"></i> <strong id="rsxDl"><%= bn(r.downloads || 0) %></strong> ডাউনলোড</span>
        <% if (r.file_size) { %><span class="rsxd-stat" title="ফাইল-আকার"><i class="far fa-save"></i> <%= r.file_size %></span><% } %>
        <% if (r.duration) { %><span class="rsxd-stat" title="সময়"><i class="fas fa-hourglass-half"></i> <%= r.duration %></span><% } %>
      </div>

      <div class="rsxd-actions">
        <% if (r.res_type === 'pdf' || r.res_type === 'doc' || r.res_type === 'link') { %>
          <% if (rUrl) { %>
            <a class="rsxd-act rsxd-act-main" href="<%= rUrl %>" target="_blank" rel="noopener" data-rsxd-dl id="rsxdAct">
              <i class="fas <%= r.res_type === 'link' ? 'fa-arrow-up-right-from-square' : 'fa-file-arrow-down' %>"></i>
              <%= r.res_type === 'link' ? 'লিংক খুলুন' : 'খুলুন / ডাউনলোড' %>
            </a>
          <% } %>
        <% } else if (r.res_type === 'audio') { %>
          <button type="button" class="rsxd-act rsxd-act-main" id="rsxdAct" data-rsxd-play>
            <i class="fas fa-circle-play"></i> শুনুন
          </button>
        <% } else if (r.res_type === 'video') { %>
          <% if (rUrl) { %><a class="rsxd-act rsxd-act-main" href="<%= rUrl %>" target="_blank" rel="noopener" data-rsxd-open id="rsxdAct"><i class="fas fa-arrow-up-right-from-square"></i> উৎস খুলুন</a><% } %>
        <% } else if (r.res_type === 'image') { %>
          <% if (rUrl) { %><a class="rsxd-act rsxd-act-main" href="<%= rUrl %>" target="_blank" rel="noopener" data-rsxd-open id="rsxdAct"><i class="fas fa-image"></i> পূর্ণ-আকারে দেখুন</a><% } %>
        <% } %>
        <button type="button" class="rsxd-act rsxd-act-ghost" id="rsxdCopy" title="লিংক কপি করুন">
          <i class="fas fa-link"></i> লিংক কপি
        </button>
      </div>

      <% if (r.tags) { %>
        <div class="rsxd-tags">
          <% String(r.tags).split(/[,،]/).map(s => s.trim()).filter(Boolean).forEach(tag => { %>
            <a class="rsxd-tag" href="/resources?q=<%= encodeURIComponent(tag) %>"><i class="fas fa-hashtag"></i> <%= tag %></a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </article>

  <%# ── সেশন ১০৭: সিরিজ-নেভিগেটর — আগের/পরের পর্ব + পর্ব-তালিকা (বর্তমান হাইলাইট) ── %>
  <% if (seriesName && seriesItems && seriesItems.length > 1) { %>
  <section class="rsxd-series rsxd-card" aria-label="সিরিজ নেভিগেশন">
    <div class="rsxd-serihead">
      <h2 class="rsxd-sechead"><i class="fas fa-layer-group"></i> সিরিজ: <%= seriesName %></h2>
      <span class="rsxd-seripos">পর্ব <%= bn(seriesPos) %> / <%= bn(seriesItems.length) %></span>
    </div>
    <% if (seriesPrev || seriesNext) { %>
    <div class="rsxd-serinav">
      <% if (seriesPrev) { %>
        <a class="rsxd-seristep" href="/resources/<%= seriesPrev.id %>">
          <i class="fas fa-chevron-left"></i>
          <span class="rsxd-seristep-txt"><em>আগের পর্ব</em><strong><%= seriesPrev.title %></strong></span>
        </a>
      <% } else { %><span class="rsxd-seristep rsxd-seristep-off"><i class="fas fa-ban"></i><span class="rsxd-seristep-txt"><em>এটিই প্রথম পর্ব</em></span></span><% } %>
      <% if (seriesNext) { %>
        <a class="rsxd-seristep rsxd-seristep-next" href="/resources/<%= seriesNext.id %>">
          <span class="rsxd-seristep-txt"><em>পরের পর্ব</em><strong><%= seriesNext.title %></strong></span>
          <i class="fas fa-chevron-right"></i>
        </a>
      <% } else { %><span class="rsxd-seristep rsxd-seristep-off rsxd-seristep-next"><i class="fas fa-flag-checkered"></i><span class="rsxd-seristep-txt"><em>সর্বশেষ পর্ব</em></span></span><% } %>
    </div>
    <% } %>
    <%# সেশন ১১৭: প্লেলিস্ট-হেড — সিরিজে অডিও-পর্ব থাকলে "সব শুনুন" + অডিও-গণনা
        (ইন-পেজ প্লেব্যাক: পর্ব-রো-র ▶-বাটন হিরো-অডিও/মিনি-প্লেয়ারে src-সোয়াপ করে —
        অটো-অ্যাডভান্স 'ended'-ইভেন্টে পরবর্তী অডিও-পর্ব; নেভিগেশন-ছাড়াই ধারাবাহিক শ্রবণ) %>
    <% if (seriesAudioCount > 0) { %>
    <div class="rsxd-plhead">
      <button type="button" class="rsxd-plall" id="rsxdPlayAll">
        <i class="fas fa-play"></i><span>সব শুনুন</span>
      </button>
      <span class="rsxd-plmeta"><i class="fas fa-headphones"></i> অডিও পর্ব <%= bn(seriesAudioCount) %><% if (seriesItems.length > seriesAudioCount) { %> · বাকি পর্ব লিংকে<% } %></span>
    </div>
    <%# সেশন ১১৮: রিজুম-চিপ — localStorage-এ শেষ-শোনা-অবস্থান (৩০-দিন-মধ্যে, শোনা-হয়ে-যাওয়া
        পর্ব বাদে) থাকলে JS দেখায়; ক্লিকে সেই-পর্বে সেই-সেকেন্ড থেকে প্লেব্যাক %>
    <button type="button" class="rsxd-plresume" id="rsxdResume" hidden>
      <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
      <span class="rsxd-plresume-txt">আগে শোনা হয়েছে: <strong class="rsxd-plresume-t"></strong> · <span class="rsxd-plresume-pos"></span></span>
      <span class="rsxd-plresume-go"><i class="fas fa-play"></i> সেখান থেকে</span>
    </button>
    <% } %>
    <ol class="rsxd-serilist" id="rsxdSeriList">
      <% seriesItems.forEach((x, i) => { %>
        <li class="rsxd-seriep-li<%= x.id === r.id ? ' here' : '' %>" data-epi="<%= i %>" data-id="<%= x.id %>"<% if (x.audioSrc) { %> data-audio="<%= x.audioSrc %>" data-title="<%= x.title %>"<% if (x.thumbnail_url) { %> data-art="<%= x.thumbnail_url %>"<% } %><% } %>>
          <% if (x.audioSrc) { %>
            <button type="button" class="rsxd-seriep-play" aria-label="ইন-পেজে শুনুন: <%= x.title %>" title="ইন-পেজে শুনুন">
              <i class="fas fa-play"></i>
            </button>
          <% } %>
          <a class="rsxd-seriep <%= x.id === r.id ? 'here' : '' %>" href="/resources/<%= x.id %>" <%= x.id === r.id ? 'aria-current="step"' : '' %>>
            <span class="rsxd-seriep-num"><%= bn(i + 1) %></span>
            <span class="rsxd-seriep-title"><%= x.title %></span>
            <% if (x.audioSrc) { %><span class="rsxd-seriep-eq" aria-hidden="true"><i></i><i></i><i></i></span><% } %>
            <% if (x.id === r.id) { %><span class="rsxd-seriep-now"><i class="fas fa-circle-play"></i> এই পর্ব</span><% } else { %><i class="fas fa-chevron-right rsxd-seriep-go"></i><% } %>
          </a>
        </li>
      <% }) %>
    </ol>
    <%# সেশন ১১৭: >১২-পর্ব তালিকা-কলাপ্স — বাটনটি JS-ই প্রথম দেখায় (hidden-সার্ভার-রেন্ডার);
        noscript-এ পূর্ণ-তালিকা-ই থাকে (গ্রেসফুল-ডিগ্রেডেশন)। li[hidden]-গার্ড CSS-এ বাধ্যতামূলক
        (display:flex hidden-ওভাররাইড-গোটচা — session104-রীতি)। %>
    <% if (seriesItems.length > 12) { %>
      <button type="button" class="rsxd-serimore" id="rsxdSeriMore" hidden>
        <i class="fas fa-chevron-down"></i> সব পর্ব দেখুন (<span class="rsxd-serimore-n"></span>)
      </button>
    <% } %>
  </section>
  <% } %>

  <%# ── পূর্ণ-বিবরণ (লিড-অংশের চেয়ে লম্বা হলেই দেখাই — ডুপ্লিকেট-এড়ানো) ── %>
  <% if ((r.content || r.description) && mdPlain(r.content || r.description).length > 190) { %>
  <section class="rsxd-desc rsxd-card">
    <h2 class="rsxd-sechead"><i class="fas fa-align-left"></i> বিস্তারিত বিবরণ</h2>
    <div class="rsxd-descbody"><%- descHtml %></div>
  </section>
  <% } %>

  <%# ── সম্পর্কিত রিসোর্স ── %>
  <% if (related && related.length) { %>
  <section class="rsxd-related">
    <div class="rsxd-relhead">
      <h2 class="rsxd-sechead"><i class="fas fa-layer-group"></i> সম্পর্কিত রিসোর্স</h2>
      <a href="/resources" class="rsxd-all">সব দেখুন <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="rsxd-relgrid">
      <% related.forEach(x => {
           const xt = RES_TYPE_META.RES_TYPES[x.res_type] || RES_TYPE_META.RES_TYPES.link;
           const xUrl = x.link_url || x.file_url || '';
           const xCover = (x.res_type === 'image') ? xUrl : (x.thumbnail_url || null);
      %>
        <a class="rsxd-relcard" href="/resources/<%= x.id %>">
          <span class="rsxd-relthumb rsxd-relthumb-<%= x.res_type %>" style="--rt-color:<%= xt.color %>;--rt-bg:<%= xt.bg %>;">
            <% if (xCover) { %><img src="<%= xCover %>" alt="<%= x.title %>" loading="lazy" onerror="this.remove()"><% } else { %><i class="fas <%= xt.icon %>"></i><% } %>
          </span>
          <span class="rsxd-relbody">
            <span class="rsxd-reltype" style="color:<%= xt.color %>;"><i class="fas <%= xt.icon %>"></i> <%= xt.short %></span>
            <span class="rsxd-reltitle"><%= x.title %></span>
            <span class="rsxd-relmeta"><i class="far fa-eye"></i> <%= bn(x.views || 0) %> · <i class="fas fa-download"></i> <%= bn(x.downloads || 0) %></span>
          </span>
          <i class="fas fa-chevron-right rsxd-relarrow"></i>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

</div>

<style>
/* ═══ সেশন ১০৫: রিসোর্স-ডিটেইল (rsxd-* স্কোপ) ═══ */
.rsxd-wrap { max-width: 1000px; margin: 0 auto; padding: 22px 20px 40px; }
.rsxd-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; font-size: .8rem; font-weight: 700; color: #64748b; margin-bottom: 16px; }
.rsxd-crumbs a { display: inline-flex; align-items: center; gap: 6px; color: #475569; padding: 5px 11px; border-radius: 9px; border: 1px solid var(--border, #e2e8f0); background: var(--bg-card, #fff); transition: all .15s ease; }
.rsxd-crumbs a:hover { color: var(--accent, #059669); border-color: var(--accent, #059669); background: #ecfdf5; transform: translateY(-1px); }
.rsxd-crumb-sep { font-size: .62rem; color: #cbd5e1; }
.rsxd-crumb-here { color: var(--text, #1e293b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
.rsxd-manage { margin-left: auto; color: var(--accent, #059669) !important; border-color: rgba(5,150,105,.35) !important; background: #ecfdf5 !important; }
/* সেশন ১০৭: স্টাফ-অ্যাকশন (এডিট/মুছুন) */
.rsxd-staffacts { margin-left: auto; display: inline-flex; align-items: center; gap: 7px; }
.rsxd-sact { display: inline-flex; align-items: center; gap: 6px; font-size: .76rem; font-weight: 800; font-family: inherit; padding: 5px 13px; border-radius: 9px; border: 1.5px solid var(--border, #e2e8f0); background: var(--bg-card, #fff); color: #475569; cursor: pointer; transition: all .15s ease; }
.rsxd-sact-edit:hover { color: var(--accent, #059669); border-color: var(--accent, #059669); background: #ecfdf5; transform: translateY(-1px); }
.rsxd-sact-del { color: #b91c1c; border-color: #fecaca; background: #fef2f2; }
.rsxd-sact-del:hover { background: #fee2e2; border-color: #fca5a5; transform: translateY(-1px); }
.rsxd-sact-del:disabled { opacity: .55; cursor: wait; transform: none; }
/* সিরিজ-ব্যাজ (ব্যাজ-রো-তে) */
.rsxd-seribadge { display: inline-flex; align-items: center; gap: 6px; font-size: .72rem; font-weight: 800; color: #065f46; background: linear-gradient(120deg, #ecfdf5, #f0fdf4); border: 1.5px solid rgba(5,150,105,.4); border-radius: 8px; padding: 4px 11px; transition: all .15s ease; }
.rsxd-seribadge i { font-size: .66rem; }
.rsxd-seribadge:hover { background: #d1fae5; transform: translateY(-1px); box-shadow: 0 4px 10px -4px rgba(5,150,105,.35); }
/* সিরিজ-নেভিগেটর কার্ড */
.rsxd-series { border-color: rgba(5,150,105,.28); background: linear-gradient(155deg, #f0fdf4 0%, var(--bg-card, #fff) 42%); }
.rsxd-serihead { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
.rsxd-seripos { font-size: .72rem; font-weight: 900; color: #fff; background: linear-gradient(135deg, var(--accent, #059669), var(--accent-dark, #047857)); border-radius: 999px; padding: 4px 13px; letter-spacing: .02em; box-shadow: 0 4px 12px -4px rgba(5,150,105,.5); }
.rsxd-serinav { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 4px 0 14px; }
.rsxd-seristep { display: flex; align-items: center; gap: 10px; padding: 10px 13px; border-radius: 12px; border: 1.5px solid var(--border, #e2e8f0); background: var(--bg-card, #fff); text-decoration: none; transition: all .16s ease; min-width: 0; }
.rsxd-seristep i { flex: none; font-size: .78rem; color: var(--accent, #059669); transition: transform .16s ease; }
.rsxd-seristep-next { text-align: right; }
.rsxd-seristep-next .rsxd-seristep-txt { margin-left: auto; }
.rsxd-seristep:hover { border-color: var(--accent, #059669); background: #ecfdf5; transform: translateY(-2px); box-shadow: 0 8px 18px -8px rgba(5,150,105,.35); }
.rsxd-seristep:hover i:first-child { transform: translateX(-2px); }
.rsxd-seristep-next:hover i { transform: translateX(2px); }
.rsxd-seristep-off { opacity: .6; cursor: default; border-style: dashed; background: var(--bg, #f8fafc); }
.rsxd-seristep-off:hover { transform: none; box-shadow: none; border-color: var(--border, #e2e8f0); background: var(--bg, #f8fafc); }
.rsxd-seristep-txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.rsxd-seristep-txt em { font-style: normal; font-size: .64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: #94a3b8; }
.rsxd-seristep-txt strong { font-size: .8rem; font-weight: 800; color: var(--text, #1e293b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rsxd-serilist { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; counter-reset: none; }
.rsxd-seriep { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 10px; border: 1px solid transparent; text-decoration: none; transition: all .14s ease; }
.rsxd-seriep:hover { background: var(--bg-card, #fff); border-color: var(--border, #e2e8f0); transform: translateX(3px); }
.rsxd-seriep-num { flex: none; width: 24px; height: 24px; display: grid; place-items: center; border-radius: 8px; background: rgba(5,150,105,.10); color: var(--accent, #059669); font-size: .68rem; font-weight: 900; }
.rsxd-seriep-title { font-size: .82rem; font-weight: 700; color: #334155; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rsxd-seriep-go { margin-left: auto; flex: none; font-size: .64rem; color: #cbd5e1; }
.rsxd-seriep.here { background: var(--bg-card, #fff); border-color: var(--accent, #059669); box-shadow: 0 4px 12px -6px rgba(5,150,105,.4); }
.rsxd-seriep.here .rsxd-seriep-num { background: linear-gradient(135deg, var(--accent, #059669), var(--accent-dark, #047857)); color: #fff; }
.rsxd-seriep.here .rsxd-seriep-title { color: var(--text, #1e293b); font-weight: 800; }
.rsxd-seriep-now { margin-left: auto; flex: none; display: inline-flex; align-items: center; gap: 5px; font-size: .66rem; font-weight: 900; color: var(--accent, #059669); }
@media (max-width: 640px) {
  .rsxd-serinav { grid-template-columns: 1fr; }
  .rsxd-seristep-next { text-align: left; }
  .rsxd-seristep-next .rsxd-seristep-txt { margin-left: 0; }
  .rsxd-staffacts { margin-left: 0; }
}

/* হিরো */
.rsxd-hero { display: grid; grid-template-columns: minmax(0, 460px) 1fr; gap: 26px; background: var(--bg-card, #fff); border: 1px solid var(--border, #e2e8f0); border-radius: 20px; padding: 22px; box-shadow: 0 10px 34px -18px rgba(2,6,23,.16); position: relative; overflow: hidden; }
.rsxd-hero::before { content: ''; position: absolute; top: -120px; right: -120px; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, var(--rt-bg, #ecfdf5) 0%, transparent 70%); opacity: .9; pointer-events: none; }

.rsxd-media { position: relative; border-radius: 14px; overflow: hidden; background: #f1f5f9; min-height: 240px; display: flex; flex-direction: column; border: 1px solid var(--border, #e2e8f0); }
.rsxd-media img { width: 100%; height: 100%; object-fit: cover; flex: 1; }
.rsxd-media iframe, .rsxd-media video { width: 100%; aspect-ratio: 16/9; border: 0; display: block; flex: 1; }
.rsxd-cover-cta { position: absolute; left: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 7px; background: rgba(2,6,23,.72); color: #fff !important; font-size: .78rem; font-weight: 700; padding: 8px 14px; border-radius: 999px; backdrop-filter: blur(4px); transition: all .15s ease; }
.rsxd-cover-cta:hover { background: var(--accent, #059669); transform: translateY(-2px); }
.rsxd-media-fallback img { display: none; }

/* অডিও-হিরো (কভার-শূন্য অডিও) */
.rsxd-audiohero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 28px 18px 14px; background: linear-gradient(150deg, var(--rt-bg, #fffbeb) 0%, #fff 78%); }
.rsxd-audiohero-ic { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; font-size: 1.7rem; color: var(--rt-color, #b45309); background: #fff; border: 1.5px solid var(--rt-border, #fde68a); box-shadow: 0 10px 24px -10px rgba(2,6,23,.18); }
.rsxd-audiohero-t { margin: 0; font-size: .78rem; font-weight: 800; color: var(--rt-color, #b45309); letter-spacing: .02em; }
.rsxd-audiohero-wv { display: flex; align-items: flex-end; gap: 3px; height: 34px; }
.rsxd-audiohero-wv span { width: 3.5px; border-radius: 2px; background: var(--rt-color, #b45309); opacity: .32; animation: rsxdWv 1.6s ease-in-out infinite; }
.rsxd-audiohero-wv span:nth-child(3n)   { height: 46%; animation-delay: .18s; }
.rsxd-audiohero-wv span:nth-child(3n+1) { height: 88%; animation-delay: .36s; }
.rsxd-audiohero-wv span:nth-child(3n+2) { height: 64%; animation-delay: .54s; }
@keyframes rsxdWv { 0%, 100% { transform: scaleY(.45); } 50% { transform: scaleY(1); } }
.rsxd-audiobar { padding: 12px 14px; background: #fff; border-top: 1px dashed var(--rt-border, #e2e8f0); }
.rsxd-audiobar audio { width: 100%; height: 40px; border-radius: 9px; }

/* প্রিভিউ-শূন্য প্লেসহোল্ডার */
.rsxd-noimg { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 30px 16px; background: linear-gradient(150deg, var(--rt-bg, #ecfdf5) 0%, #fff 80%); }
.rsxd-noimg i { font-size: 2.4rem; color: var(--rt-color, #059669); opacity: .55; }
.rsxd-noimg p { margin: 0; font-weight: 800; font-size: .92rem; color: var(--text, #1e293b); }
.rsxd-noimg span { font-size: .76rem; color: #64748b; }

/* বডি */
.rsxd-body { position: relative; display: flex; flex-direction: column; gap: 13px; min-width: 0; }
.rsxd-badges { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
.rsx-badge { display: inline-flex; align-items: center; gap: 6px; border: 1px solid; border-radius: 8px; padding: 3px 10px; font-size: .72rem; font-weight: 700; white-space: nowrap; }
.rsxd-cat { display: inline-flex; align-items: center; gap: 6px; font-size: .72rem; font-weight: 700; color: #475569; background: var(--bg, #f8fafc); border: 1px solid var(--border, #e2e8f0); padding: 4px 10px; border-radius: 8px; }
.rsxd-title { margin: 0; font-size: 1.5rem; line-height: 1.4; font-weight: 900; color: var(--text, #1e293b); }
.rsxd-byline { display: flex; flex-wrap: wrap; gap: 14px; font-size: .78rem; font-weight: 600; color: #64748b; }
.rsxd-byline span { display: inline-flex; align-items: center; gap: 6px; }
.rsxd-lead { margin: 0; font-size: .92rem; line-height: 1.8; color: #475569; }

.rsxd-statsrow { display: flex; flex-wrap: wrap; gap: 8px; }
.rsxd-stat { display: inline-flex; align-items: center; gap: 6px; font-size: .74rem; font-weight: 700; color: #64748b; background: var(--bg, #f8fafc); border: 1px solid var(--border, #e2e8f0); border-radius: 999px; padding: 5px 12px; }
.rsxd-stat strong { color: var(--accent, #059669); font-weight: 800; }
.rsxd-stat i { opacity: .7; }

.rsxd-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 2px; }
.rsxd-act { display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; border-radius: 12px; font-size: .88rem; font-weight: 800; cursor: pointer; border: 1.5px solid transparent; transition: all .16s ease; font-family: inherit; }
.rsxd-act-main { background: linear-gradient(135deg, var(--accent, #059669), var(--accent-dark, #047857)); color: #fff !important; box-shadow: 0 6px 16px -6px rgba(5,150,105,.5); }
.rsxd-act-main:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -6px rgba(5,150,105,.55); }
.rsxd-act-ghost { background: var(--bg-card, #fff); color: #475569; border-color: var(--border, #e2e8f0); }
.rsxd-act-ghost:hover { color: var(--accent, #059669); border-color: var(--accent, #059669); background: #ecfdf5; transform: translateY(-2px); }
.rsxd-act-ghost.copied { color: var(--accent, #059669); border-color: var(--accent, #059669); background: #ecfdf5; }

.rsxd-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 2px; }
.rsxd-tag { display: inline-flex; align-items: center; gap: 4px; font-size: .72rem; font-weight: 700; color: #0369a1; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 999px; padding: 4px 11px; transition: all .15s ease; }
.rsxd-tag:hover { background: #e0f2fe; transform: translateY(-1px); }
.rsxd-tag i { font-size: .62rem; opacity: .7; }

/* কার্ড-সেকশন (বিবরণ) */
.rsxd-card { background: var(--bg-card, #fff); border: 1px solid var(--border, #e2e8f0); border-radius: 16px; padding: 22px 24px; margin-top: 20px; box-shadow: 0 6px 20px -14px rgba(2,6,23,.14); }
.rsxd-sechead { margin: 0 0 14px; font-size: 1.02rem; font-weight: 900; color: var(--text, #1e293b); display: flex; align-items: center; gap: 9px; }
.rsxd-sechead i { color: var(--accent, #059669); font-size: .9rem; }
.rsxd-descbody { font-size: .92rem; line-height: 1.9; color: #334155; overflow-wrap: break-word; }
.rsxd-descbody h1, .rsxd-descbody h2, .rsxd-descbody h3 { color: var(--text, #1e293b); margin: 18px 0 8px; line-height: 1.4; }
.rsxd-descbody h1 { font-size: 1.2rem; } .rsxd-descbody h2 { font-size: 1.08rem; } .rsxd-descbody h3 { font-size: .98rem; }
.rsxd-descbody ul, .rsxd-descbody ol { padding-left: 22px; list-style: disc; margin: 8px 0; }
.rsxd-descbody ol { list-style: decimal; }
.rsxd-descbody li { margin: 4px 0; }
.rsxd-descbody blockquote { margin: 10px 0; padding: 10px 16px; border-left: 3.5px solid var(--accent, #059669); background: #f8fafc; border-radius: 0 10px 10px 0; color: #475569; }
.rsxd-descbody code { background: #f1f5f9; border: 1px solid var(--border, #e2e8f0); border-radius: 6px; padding: 1px 7px; font-size: .82em; font-family: var(--font-mono, monospace); color: #b91c1c; }
.rsxd-descbody a { color: var(--accent, #059669); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.rsxd-descbody img { border-radius: 10px; margin: 10px 0; }
.rsxd-descbody hr { border: 0; border-top: 1px dashed var(--border, #e2e8f0); margin: 16px 0; }

/* সম্পর্কিত */
.rsxd-related { margin-top: 28px; }
.rsxd-relhead { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.rsxd-relhead .rsxd-sechead { margin: 0; }
.rsxd-all { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; font-weight: 800; color: var(--accent, #059669); padding: 6px 12px; border-radius: 9px; transition: all .15s ease; }
.rsxd-all:hover { background: #ecfdf5; gap: 9px; }
.rsxd-relgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 13px; }
.rsxd-relcard { display: flex; align-items: center; gap: 12px; background: var(--bg-card, #fff); border: 1px solid var(--border, #e2e8f0); border-radius: 14px; padding: 11px 13px; transition: all .16s ease; position: relative; }
.rsxd-relcard:hover { transform: translateY(-3px); border-color: var(--accent, #059669); box-shadow: 0 12px 26px -12px rgba(2,6,23,.16); }
.rsxd-relthumb { flex: none; width: 58px; height: 58px; border-radius: 10px; overflow: hidden; display: grid; place-items: center; background: var(--rt-bg, #f1f5f9); border: 1px solid var(--border, #e2e8f0); }
.rsxd-relthumb img { width: 100%; height: 100%; object-fit: cover; }
.rsxd-relthumb i { font-size: 1.25rem; color: var(--rt-color, #64748b); opacity: .8; }
.rsxd-relbody { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.rsxd-reltype { font-size: .66rem; font-weight: 800; display: inline-flex; align-items: center; gap: 4px; }
.rsxd-reltitle { font-size: .84rem; font-weight: 800; color: var(--text, #1e293b); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.rsxd-relmeta { font-size: .68rem; font-weight: 600; color: #94a3b8; display: inline-flex; gap: 8px; align-items: center; }
.rsxd-relarrow { margin-left: auto; flex: none; font-size: .72rem; color: #cbd5e1; transition: all .16s ease; }
.rsxd-relcard:hover .rsxd-relarrow { color: var(--accent, #059669); transform: translateX(3px); }

@media (max-width: 860px) {
  .rsxd-hero { grid-template-columns: 1fr; }
  .rsxd-title { font-size: 1.28rem; }
}
@media (max-width: 560px) {
  .rsxd-wrap { padding: 16px 14px 34px; }
  .rsxd-hero { padding: 14px; border-radius: 16px; }
  .rsxd-card { padding: 16px; }
  .rsxd-media { min-height: 190px; }
  .rsxd-act { flex: 1; justify-content: center; padding: 11px 12px; font-size: .82rem; }
  .rsxd-crumb-here { max-width: 130px; }
  .rsxd-manage { margin-left: 0; }
}
/* ═══ সেশন ১১৭: সিরিজ প্লেলিস্ট-প্যানেল — ইন-পেজ অডিও-পর্ব প্লেব্যাক + অটো-অ্যাডভান্স ═══ */
.rsxd-seriep-li { display: flex; align-items: center; gap: 7px; }
.rsxd-seriep-li[hidden] { display: none !important; }
.rsxd-seriep-li .rsxd-seriep { flex: 1; min-width: 0; }
.rsxd-seriep-li:hover .rsxd-seriep { background: var(--bg-card, #fff); border-color: var(--border, #e2e8f0); }
.rsxd-seriep-play { flex: none; width: 30px; height: 30px; border-radius: 9px; border: 1px solid var(--border, #e2e8f0); background: var(--bg-card, #fff); color: var(--accent, #059669); font-size: .66rem; cursor: pointer; display: grid; place-items: center; transition: all .14s ease; }
.rsxd-seriep-play:hover { background: var(--accent, #059669); border-color: var(--accent, #059669); color: #fff; transform: scale(1.07); }
.rsxd-seriep-play:focus-visible { outline: 2px solid var(--accent, #059669); outline-offset: 2px; }
.rsxd-seriep-eq { flex: none; display: none; align-items: flex-end; gap: 2px; height: 12px; margin-left: auto; }
.rsxd-seriep-eq i { width: 2.5px; height: 100%; border-radius: 1px; background: var(--accent, #059669); transform-origin: bottom; }
.rsxd-seriep-li.playing .rsxd-seriep { background: #ecfdf5; border-color: var(--accent, #059669); }
.rsxd-seriep-li.playing .rsxd-seriep-eq { display: inline-flex; }
.rsxd-seriep-li.playing .rsxd-seriep-eq i { animation: rsxdEq 1.1s ease-in-out infinite; }
.rsxd-seriep-li.playing .rsxd-seriep-eq i:nth-child(2) { animation-delay: .22s; }
.rsxd-seriep-li.playing .rsxd-seriep-eq i:nth-child(3) { animation-delay: .44s; }
.rsxd-seriep-li.playing .rsxd-seriep-go { display: none; }
.rsxd-seriep-li.playing .rsxd-seriep-play { background: var(--accent, #059669); border-color: var(--accent, #059669); color: #fff; }
@keyframes rsxdEq { 0%, 100% { transform: scaleY(.35); } 50% { transform: scaleY(1); } }

.rsxd-plhead { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; padding: 10px 12px; margin: 0 0 10px; border-radius: 12px; background: linear-gradient(135deg, #ecfdf5 0%, #f0fdfa 100%); border: 1px solid rgba(5,150,105,.18); }
.rsxd-plall { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border: 0; border-radius: 999px; background: linear-gradient(135deg, var(--accent, #059669), var(--accent-dark, #047857)); color: #fff; font-weight: 800; font-size: .78rem; cursor: pointer; box-shadow: 0 6px 16px -8px rgba(5,150,105,.55); transition: all .15s ease; }
.rsxd-plall:hover { transform: translateY(-1px); box-shadow: 0 10px 22px -8px rgba(5,150,105,.6); }
.rsxd-plall:focus-visible { outline: 2px solid var(--accent, #059669); outline-offset: 2px; }
.rsxd-plmeta { font-size: .72rem; font-weight: 700; color: var(--accent, #059669); display: inline-flex; align-items: center; gap: 6px; }

.rsxd-serimore { margin-top: 10px; width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 9px 12px; border-radius: 10px; border: 1px dashed var(--border, #e2e8f0); background: transparent; color: var(--accent, #059669); font-weight: 800; font-size: .78rem; font-family: inherit; cursor: pointer; transition: all .14s ease; }
.rsxd-serimore:hover { background: #ecfdf5; border-color: var(--accent, #059669); }
.rsxd-serimore:focus-visible { outline: 2px solid var(--accent, #059669); outline-offset: 2px; }
.rsxd-serimore[hidden] { display: none !important; }

/* মিনি-প্লেয়ার — নন-অডিও পর্বের পেজে প্লেলিস্ট চালু হলে (ডকড বটম-বার) */
.rsxd-mini { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(14px + env(safe-area-inset-bottom, 0px)); z-index: 9990; width: min(560px, calc(100vw - 24px)); display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 16px; background: rgba(255,255,255,.94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--border, #e2e8f0); box-shadow: 0 18px 44px -14px rgba(2,6,23,.4); animation: rsxdMiniIn .28s ease; }
@keyframes rsxdMiniIn { from { opacity: 0; transform: translate(-50%, 14px); } to { opacity: 1; transform: translate(-50%, 0); } }
.rsxd-mini audio { flex: 1; min-width: 0; height: 36px; border-radius: 8px; }
.rsxd-mini-info { display: flex; flex-direction: column; min-width: 0; max-width: 42%; gap: 1px; }
.rsxd-mini-t { font-size: .76rem; font-weight: 800; color: var(--text, #1e293b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rsxd-mini-s { font-size: .66rem; font-weight: 700; color: var(--accent, #059669); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rsxd-mini-close { flex: none; width: 30px; height: 30px; border-radius: 9px; border: 1px solid var(--border, #e2e8f0); background: #fff; color: #64748b; cursor: pointer; display: grid; place-items: center; transition: all .14s ease; }
.rsxd-mini-close:hover { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
.rsxd-mini-close:focus-visible { outline: 2px solid #dc2626; outline-offset: 2px; }
@media (max-width: 560px) {
  .rsxd-mini { flex-wrap: wrap; gap: 8px; padding: 10px 12px; }
  .rsxd-mini audio { flex-basis: 100%; order: 3; }
  .rsxd-mini-info { max-width: calc(100% - 46px); }
}

/* ═══ সেশন ১১৮: রিজুম-চিপ + শোনা-হয়েছে-মার্ক + পর্ব-প্রগ্রেস-বার + পালস ═══ */
.rsxd-plresume { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; margin-top: 8px; padding: 7px 12px; border: 1px dashed rgba(5,150,105,.45); background: linear-gradient(120deg, #ecfdf5, #f0fdf4); border-radius: 999px; color: #065f46; font-size: .74rem; font-weight: 700; cursor: pointer; transition: all .15s ease; }
.rsxd-plresume:hover { border-style: solid; background: linear-gradient(120deg, #d1fae5, #ecfdf5); transform: translateY(-1px); box-shadow: 0 6px 14px -6px rgba(5,150,105,.35); }
.rsxd-plresume:focus-visible { outline: 2px solid #059669; outline-offset: 2px; }
.rsxd-plresume-txt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rsxd-plresume-txt strong { font-weight: 800; color: #064e3b; }
.rsxd-plresume-go { flex: none; display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; background: linear-gradient(135deg, #059669, #10b981); color: #fff; font-size: .68rem; font-weight: 800; box-shadow: 0 2px 6px -2px rgba(5,150,105,.5); }
.rsxd-seriep-li { position: relative; }
.rsxd-seriep-li.done .rsxd-seriep-title { color: #64748b; }
.rsxd-seriep-li.done .rsxd-seriep-title::after { content: "\f058"; font-family: "Font Awesome 6 Free"; font-weight: 900; color: #059669; font-size: .78em; margin-left: 6px; }
.rsxd-seriep-li.done .rsxd-seriep-eq { display: none; }
.rsxd-seriep-li.done .rsxd-seriep-play i { color: #059669; }
.rsxd-epiprog { position: absolute; left: 44px; right: 10px; bottom: 2px; height: 3px; border-radius: 2px; background: rgba(5,150,105,.14); overflow: hidden; opacity: 0; transition: opacity .2s ease; pointer-events: none; }
.rsxd-epiprog i { display: block; height: 100%; width: 0%; border-radius: 2px; background: linear-gradient(90deg, #059669, #34d399); transition: width .25s linear; }
.rsxd-seriep-li.playing .rsxd-epiprog { opacity: 1; }
@keyframes rsxdPlPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(5,150,105,.45); } 50% { box-shadow: 0 0 0 9px rgba(5,150,105,0); } }
.rsxd-plall.pulse { animation: rsxdPlPulse 1.1s ease-out 5; }
@media (prefers-reduced-motion: reduce) {
  .rsxd-audiohero-wv span { animation: none; }
  .rsxd-seriep-eq i { animation: none !important; }
  .rsxd-mini { animation: none; }
  .rsxd-plall.pulse { animation: none; }
  .rsxd-epiprog i, .rsxd-plresume { transition: none; }
  .rsxd-act, .rsxd-relcard, .rsxd-crumbs a, .rsxd-cover-cta, .rsxd-relarrow, .rsxd-sact, .rsxd-seristep, .rsxd-seriep, .rsxd-seribadge, .rsxd-seriep-play, .rsxd-plall, .rsxd-serimore, .rsxd-plresume { transition: none; transform: none; }
}
@media print {
  .rsxd-series, .rsxd-staffacts, .rsxd-manage, .rsxd-mini { display: none !important; }
}
</style>

<script>
(function () {
  /* ═══ সেশন ১০৫: ডিটেইল-পেজ JS — ভিউ-স্ট্যাট + কপি + অ্যাকশন-কাউন্ট ═══ */
  var BN = '০১২৩৪৫৬৭৮৯';
  function bn(n) { return String(n).replace(/\d/g, function (d) { return BN[+d]; }); }
  /* sandbox-গেটওয়ে: পেজ-URL-এ XTransformPort থাকলে fetch/open-এও বহন (লাইভে নো-অপ) */
  var SBX = (/XTransformPort=/.test(location.search)) ? location.search.replace(/^\?/, '') : '';
  function sbx(u) {
    if (!SBX || !u || /^(https?:)?\/\//i.test(u)) return u;
    return u + (u.indexOf('?') > -1 ? '&' : '?') + SBX;
  }
  var ID = '<%= r.id %>';

  /* ভিউ-কাউন্ট (সার্ভারে ৩০সে-ডিডুপ) — স্ট্যাট-চিপ লাইভ-আপডেট */
  try {
    fetch(sbx('/api/resources/' + ID + '/stat'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind: 'view' })
    }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
      if (!j || !j.ok || j.deduped) return;
      var v = document.getElementById('rsxdViews');
      if (v && j.views != null) v.textContent = bn(j.views);
    }).catch(function () {});
  } catch (e) {}

  /* ডাউনলোড/খোলা-কাউন্ট — প্রধান-অ্যাকশন ক্লিকে (নেভিগেশন আটকাই না) */
  var act = document.getElementById('rsxdAct');
  if (act && act.hasAttribute('data-rsxd-dl')) {
    act.addEventListener('click', function () {
      try {
        fetch(sbx('/api/resources/' + ID + '/stat'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind: 'download' })
        }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
          if (!j || !j.ok) return;
          var d = document.getElementById('rsxDl');
          if (d && j.downloads != null) d.textContent = bn(j.downloads);
        }).catch(function () {});
      } catch (e) {}
    });
  }

  /* শুনুন-বাটন → অডিও-প্লেয়ারে স্ক্রল + প্লে */
  var playBtn = document.querySelector('[data-rsxd-play]');
  if (playBtn) {
    playBtn.addEventListener('click', function () {
      var a = document.querySelector('.rsxd-audiobar audio');
      if (a) { a.scrollIntoView({ behavior: 'smooth', block: 'center' }); a.play().catch(function () {}); }
    });
  }

  /* সেশন ১০৭: স্টাফ-মুছুন (fetch-DELETE) — ক্যাশেবল-পাবলিক-পেজে রেন্ডার-টোকেন
     এফেমেরাল হতে পারে (session103 চুক্তি) → ?_u= fresh-GET থেকে মেটা-টোকেন
     রিফ্রেশ, তারপর X-CSRF-Token হেডারসহ DELETE (method-override)। */
  var delBtn = document.getElementById('rsxdDel');
  if (delBtn) {
    delBtn.addEventListener('click', function () {
      if (!window.confirm('এই রিসোর্সটি ট্র্যাশে পাঠানো হবে — নিশ্চিত?')) return;
      delBtn.disabled = true;
      var done = function (ok) {
        delBtn.disabled = false;
        if (ok) {
          if (typeof window.showToast === 'function') window.showToast('রিসোর্সটি ট্র্যাশে পাঠানো হয়েছে ✓', 'success');
          setTimeout(function () { location.href = sbx('/resources'); }, 700);
        } else {
          if (typeof window.showToast === 'function') window.showToast('মুছতে ব্যর্থ — আবার চেষ্টা করুন', 'error');
        }
      };
      var freshGet = fetch(sbx(location.pathname + '?_u=' + Date.now()), { headers: { Accept: 'text/html' } })
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var m = html.match(/csrf-token" content="([^"]+)"/);
          return m ? m[1] : '';
        })
        .catch(function () { return ''; });
      freshGet.then(function (tok) {
        return fetch(sbx('/admin/resources/' + ID + '?_method=DELETE'), {
          method: 'POST',
          headers: { 'X-CSRF-Token': tok }
        }).then(function (r) { return r.ok; });
      }).then(done).catch(function () { done(false); });
    });
  }

  /* কপি-লিংক */
  var copyBtn = document.getElementById('rsxdCopy');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      var link = location.origin + sbx('/resources/' + ID);
      var done = function () {
        copyBtn.classList.add('copied');
        var ic = copyBtn.querySelector('i');
        if (ic) { ic.className = 'fas fa-check'; setTimeout(function () { ic.className = 'fas fa-link'; }, 1600); }
        setTimeout(function () { copyBtn.classList.remove('copied'); }, 1600);
        if (typeof window.showToast === 'function') window.showToast('লিংক কপি হয়েছে ✓', 'success');
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(link).then(done).catch(function () { fallbackCopy(link); done(); });
      } else { fallbackCopy(link); done(); }
      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        ta.remove();
      }
    });
  }
})();
</script>
<script>
/* ═══ সেশন ১১৭: সিরিজ প্লেলিস্ট-প্যানেল ═══════════════════════════════════════
   অডিও-পর্বে ইন-পেজ প্লেব্যাক: পর্ব-রো-র ▶-বাটন হিরো-অডিও (অডিও-পর্বের পেজে) বা
   ডকড মিনি-প্লেয়ারে (নন-অডিও পর্বের পেজে) src-সোয়াপ করে — নেভিগেশন-ছাড়াই চলে।
   'ended'-এ পরবর্তী অডিও-পর্বে অটো-অ্যাডভান্স (user-gesture-পূর্ব একই-এলিমেন্ট, তাই
   অটোপ্লে-নীতি-সুরক্ষিত) + MediaSession মেটাডেটা (OS-লেভেল টাইটেল/আর্টওয়ার্ক)।
   >১২-পর্ব তালিকা-কলাপ্স: প্রথম ১২ + বর্তমান পর্ব দৃশ্যমান, বাকিটা "সব পর্ব দেখুন"-এ।
   noscript-এ সব-কিছু প্রগ্রেসিভ-ডিগ্রেড: পূর্ণ-তালিকা + সাধারণ পর্ব-লিংক। ═══ */
(function () {
  'use strict';
  /* >১২-পর্ব তালিকা-কলাপ্স — অডিও-স্বাধীন (link/pdf-সিরিজেও চলে); প্রথম ১২ + বর্তমান
     (.here) দৃশ্যমান রাখা। noscript-এ কোনো-কিছু-লুকানো-হয়-না (পূর্ণ-তালিকা)। */
  var list0 = document.getElementById('rsxdSeriList');
  if (!list0) return;
  var lis0 = Array.prototype.slice.call(list0.querySelectorAll('.rsxd-seriep-li'));
  var more0 = document.getElementById('rsxdSeriMore');
  function bn(n) { return String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); }
  if (more0) {
    var LIMIT = 12, hiddenN = 0;
    lis0.forEach(function (li, i) {
      if (i >= LIMIT && !li.classList.contains('here')) { li.hidden = true; hiddenN++; }
    });
    if (hiddenN > 0) {
      var n = more0.querySelector('.rsxd-serimore-n');
      if (n) n.textContent = bn(hiddenN);
      more0.hidden = false;
      more0.addEventListener('click', function () {
        lis0.forEach(function (li) { li.hidden = false; });
        more0.hidden = true;
      });
    }
  }
})();
(function () {
  'use strict';
  var list = document.getElementById('rsxdSeriList');
  if (!list) return;
  var lis = Array.prototype.slice.call(list.querySelectorAll('.rsxd-seriep-li'));
  var audLis = lis.filter(function (li) { return li.hasAttribute('data-audio'); });
  if (!audLis.length) return;
  var audio = document.querySelector('.rsxd-audiobar audio');
  var mini = null, curIdx = -1, manualStop = false;
  var SERIES = '<%= seriesName %>';
  /* sandbox-গেটওয়ে: পেজ-URL-এ XTransformPort থাকলে মিডিয়া-src-এও বহন (লাইভে নো-অপ) */
  var SBX = (/XTransformPort=/.test(location.search)) ? location.search.replace(/^\?/, '') : '';

  function bn(n) { return String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); }

  /* ═══ সেশন ১১৮: রিজুম + শোনা-হয়েছে-মার্ক + প্রগ্রেস-বার (localStorage, প্রতি-সিরিজ) ═══
     কী: lekhok.rpl.<series> — {cur:{epi,t,title,ts}, done:{<resId>:ts}}; epi = lis-ইনডেক্স,
     done রিসোর্স-id-ভিত্তিক (ক্রম-বদলেও টিকে); ৩০-দিন-পুরনো অবস্থান বাদ। */
  var LSK = 'lekhok.rpl.' + encodeURIComponent(SERIES || 'x').replace(/%/g, '').slice(0, 48);
  var ST = null;
  try { ST = JSON.parse(localStorage.getItem(LSK) || 'null'); } catch (e) { ST = null; }
  if (!ST || typeof ST !== 'object') ST = {};
  if (!ST.done || typeof ST.done !== 'object') ST.done = {};
  function saveSt() { try { localStorage.setItem(LSK, JSON.stringify(ST)); } catch (e) {} }
  function idOf(li) { return li.getAttribute('data-id') || ('e' + lis.indexOf(li)); }
  function setProg(idx, pct) {
    /* idx = lis-ইনডেক্স — audLis-স্পেসে রূপান্তর বাধ্যতামূলক (অডিও-পর্ব প্রথম-এলিমেন্ট
       না-হলে k===idx কখনোই ম্যাচ করত না — E2E-তে ধরা: বার-সর্বদা ০%) */
    var li = lis[idx];
    var ai = li ? audLis.indexOf(li) : -1;
    for (var k = 0; k < audLis.length; k++) {
      var bar = audLis[k].querySelector('.rsxd-epiprog i');
      if (bar) bar.style.width = (k === ai) ? Math.max(0, Math.min(100, pct)) + '%' : '0%';
    }
  }
  audLis.forEach(function (li) {
    var p = document.createElement('span');
    p.className = 'rsxd-epiprog';
    p.setAttribute('aria-hidden', 'true');
    p.innerHTML = '<i></i>';
    li.appendChild(p);
  });
  (function applyDone() {
    lis.forEach(function (li) { if (ST.done[idOf(li)]) li.classList.add('done'); });
  })();
  function fmtT(s) {
    s = Math.max(0, Math.floor(s || 0));
    var m = Math.floor(s / 60), r = s % 60;
    return bn(m) + ':' + bn(r < 10 ? '0' + r : '' + r);
  }
  function plToast(msg) {
    try { if (typeof window.showToast === 'function') { window.showToast(msg, 'success'); return; } } catch (e) {}
    var t = document.createElement('div');
    t.className = 'toast success';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(function () { t.classList.add('show'); }, 10);
    setTimeout(function () { t.remove(); }, 2600);
  }
  var resumeBtn = document.getElementById('rsxdResume');
  (function showResume() {
    var c = ST.cur;
    if (!resumeBtn || !c || !lis[c.epi] || !lis[c.epi].hasAttribute('data-audio')) return;
    if (!(c.t > 3)) return;                              /* প্রায়-শুরু হলে অর্থহীন */
    if ((Date.now() - (c.ts || 0)) > 30 * 864e5) return;  /* ৩০-দিন-পুরনো */
    if (ST.done[idOf(lis[c.epi])]) return;                /* শেষ-হওয়া পর্বে রিজুম নয় */
    var rt = resumeBtn.querySelector('.rsxd-plresume-t');
    var rp = resumeBtn.querySelector('.rsxd-plresume-pos');
    if (rt) rt.textContent = c.title || 'পর্ব';
    if (rp) rp.textContent = fmtT(c.t);
    resumeBtn.hidden = false;
  })();
  if (resumeBtn) resumeBtn.addEventListener('click', function () {
    var c = ST.cur;
    if (!c) return;
    playIdx(c.epi, c.t);
  });

  function ensureAudio() {
    if (audio) return audio;
    mini = document.createElement('div');
    mini.className = 'rsxd-mini';
    mini.setAttribute('role', 'region');
    mini.setAttribute('aria-label', 'সিরিজ প্লেয়ার');
    mini.innerHTML = '<div class="rsxd-mini-info"><span class="rsxd-mini-t"></span><span class="rsxd-mini-s">' + SERIES + '</span></div>' +
      '<audio controls preload="metadata"></audio>' +
      '<button type="button" class="rsxd-mini-close" aria-label="প্লেয়ার বন্ধ করুন"><i class="fas fa-xmark"></i></button>';
    document.body.appendChild(mini);
    audio = mini.querySelector('audio');
    bindMedia(audio);
    mini.querySelector('.rsxd-mini-close').addEventListener('click', function () {
      manualStop = true;
      try { audio.pause(); } catch (e) {}
      setPlaying(-1); curIdx = -1;
      mini.remove(); mini = null; audio = null;
    });
    return audio;
  }

  function setPlaying(idx) {
    lis.forEach(function (li, i) {
      var on = (i === idx);
      li.classList.toggle('playing', on);
      var ic = li.querySelector('.rsxd-seriep-play i');
      if (ic) ic.className = on ? 'fas fa-pause' : 'fas fa-play';
      var btn = li.querySelector('.rsxd-seriep-play');
      if (btn) btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  function revealLi(li) {
    if (!li || !li.hidden) return;
    li.hidden = false;
    var more = document.getElementById('rsxdSeriMore');
    if (more) more.hidden = true;
  }

  function mediaMeta(li) {
    try {
      if (!('mediaSession' in navigator) || !window.MediaMetadata) return;
      var art = li.getAttribute('data-art');
      navigator.mediaSession.metadata = new window.MediaMetadata({
        title: li.getAttribute('data-title') || '',
        artist: 'লেখক ফোরাম',
        album: SERIES || 'রিসোর্স প্লেলিস্ট',
        artwork: art ? [{ src: art, sizes: '512x512', type: 'image/png' }] : []
      });
    } catch (e) {}
  }

  function playIdx(i, seekTo) {
    var li = lis[i];
    if (!li || !li.hasAttribute('data-audio')) return null;
    var a = ensureAudio();
    if (!a) return null;
    manualStop = false;
    revealLi(li);
    var src = li.getAttribute('data-audio') || '';
    if (SBX && !/^(https?:)?\/\//i.test(src)) src += (src.indexOf('?') > -1 ? '&' : '?') + SBX;
    if (!a.currentSrc || a.currentSrc.indexOf(src.split('?')[0]) === -1) {
      a.src = src;
      /* সেশন ১১৮: রিজুম-সিক — metadata-লোডের পরে currentTime (readyState-গার্ড) */
      if (seekTo > 0) {
        var seek = function () { try { a.currentTime = seekTo; } catch (e) {} };
        if (a.readyState >= 1) seek();
        else a.addEventListener('loadedmetadata', seek, { once: true });
      }
    } else if (seekTo > 0) { try { a.currentTime = seekTo; } catch (e) {} }
    if (mini) {
      mini.querySelector('.rsxd-mini-t').textContent = li.getAttribute('data-title') || '';
      var ms = mini.querySelector('.rsxd-mini-s');
      if (ms) ms.textContent = SERIES + ' · পর্ব ' + bn(audLis.indexOf(li) + 1) + '/' + bn(audLis.length);
    }
    curIdx = i;
    setPlaying(i);
    mediaMeta(li);
    var p = a.play();
    if (p && p.catch) p.catch(function () {});
    try { li.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); } catch (e) {}
    return p;
  }

  audLis.forEach(function (li) {
    var btn = li.querySelector('.rsxd-seriep-play');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var i = lis.indexOf(li);
      if (i === curIdx && audio && !audio.paused) { manualStop = false; audio.pause(); return; }
      playIdx(i);
    });
  });

  var all = document.getElementById('rsxdPlayAll');
  if (all) all.addEventListener('click', function () {
    var here = list.querySelector('.rsxd-seriep-li.here');
    var start = (here && here.hasAttribute('data-audio')) ? lis.indexOf(here) : lis.indexOf(audLis[0]);
    if (curIdx === start && audio && !audio.paused) { audio.pause(); return; }
    if (start > -1) playIdx(start);
  });

  /* native-controls-সিঙ্ক — hero/মিনি যে-টাই হোক, play/pause/ended এক-জায়গায় */
  function bindMedia(a) {
    if (!a || a.dataset.plBound) return;
    a.dataset.plBound = '1';
    a.addEventListener('play', function () {
      if (curIdx < 0) {
        var here = list.querySelector('.rsxd-seriep-li.here');
        curIdx = (here && here.hasAttribute('data-audio')) ? lis.indexOf(here) : -1;
      }
      if (curIdx > -1) setPlaying(curIdx);
    });
    a.addEventListener('pause', function () {
      /* মিডিয়া-স্পেক: শেষ-প্রান্তে pause ইভেন্ট ended-এর আগেই আসে (a.ended=true) —
         সে-ক্ষেত্রে curIdx-রিসেট করলে ended-হ্যান্ডলার ভুল-পর্বে (প্রথম অডিও-পর্বে)
         রিপ্লে/অ্যাডভান্স করত — a.ended গার্ড বাধ্যতামূলক (session117-E2E-তে ধরা) */
      if (manualStop || a.ended || !a.duration) { return; }
      /* সেশন ১১৮: reset-এর আগেই অবস্থান-সংরক্ষণ (নিচে curIdx = -1 হয়ে যায় —
         আলাদা-লিসেনারে দিলে অর্ডারে মিস হত) */
      var li = (curIdx > -1) ? lis[curIdx] : null;
      if (li) {
        ST.cur = { epi: curIdx, t: a.currentTime || 0, title: li.getAttribute('data-title') || '', ts: Date.now() };
        saveSt();
      }
      setPlaying(-1); curIdx = -1;
    });
    a.addEventListener('ended', function () {
      /* সেশন ১১৮: শোনা-হয়েছে-মার্ক + অবস্থা-ক্লিয়ার — advance-এর আগেই (playIdx বদলায়
         curIdx — পরে-মার্ক করলে পরের-পর্ব ভুল-ভাবে done হত) */
      if (curIdx > -1 && lis[curIdx]) {
        lis[curIdx].classList.add('done');
        ST.done[idOf(lis[curIdx])] = Date.now();
        ST.cur = { epi: curIdx, t: 0, title: lis[curIdx].getAttribute('data-title') || '', ts: Date.now() };
        saveSt();
      }
      var nxt = -1;
      for (var j = curIdx + 1; j < lis.length; j++) { if (lis[j].hasAttribute('data-audio')) { nxt = j; break; } }
      if (nxt > -1) { playIdx(nxt); } else { setPlaying(-1); curIdx = -1; }
    });
    /* সেশন ১১৮: প্রগ্রেস-বার (প্রতি-timeupdate) + অবস্থান-সংরক্ষণ (৩-সেকেন্ড-থ্রটল) */
    var lastSave = 0;
    a.addEventListener('timeupdate', function () {
      if (curIdx < 0) return;
      setProg(curIdx, a.duration ? (a.currentTime / a.duration) * 100 : 0);
      var now = Date.now();
      if (now - lastSave < 3000) return;
      lastSave = now;
      var li = lis[curIdx];
      if (!li) return;
      ST.cur = { epi: curIdx, t: a.currentTime || 0, title: li.getAttribute('data-title') || '', ts: now };
      saveSt();
    });
    /* ট্যাব-বিদায়েও সর্বশেষ-অবস্থান (মোবাইল-ব্যাকগ্রাউন্ড-সুইপ) */
    window.addEventListener('pagehide', function () {
      if (curIdx < 0 || a.ended || !(a.currentTime > 0)) return;
      var li = lis[curIdx];
      if (!li) return;
      ST.cur = { epi: curIdx, t: a.currentTime || 0, title: li.getAttribute('data-title') || '', ts: Date.now() };
      saveSt();
    });
  }

  /* ═══ সেশন ১১৮: ?play=1 / সিরিজ-পেজ-ইনটেন্ট → অটো-স্টার্ট ═══
     সিরিজ-পেজের "সিরিজ শুনুন" sessionStorage-ইনটেন্ট রেখে আসে (?play=1-সহ); এখানে
     রিজুম-অবস্থা থাকলে সেখান থেকে, নইলে প্রথম-অডিও-পর্ব থেকে। অটোপ্লে-নীতি-ব্লক হলে
     প্লে-অল-বাটনে পালস + টোস্ট (এক-ক্লিক-ফলব্যাক)। URL-থেকে play=1 মুছে ফেলা হয়। */
  (function autoStart() {
    var intent = false;
    try { if (sessionStorage.getItem('lekhok.rplIntent')) { intent = true; sessionStorage.removeItem('lekhok.rplIntent'); } } catch (e) {}
    var q = null;
    try { q = new URLSearchParams(location.search); } catch (e) {}
    if (q && q.get('play') === '1') {
      intent = true;
      try {
        q.delete('play');
        var qs = q.toString();
        history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
      } catch (e) {}
    }
    if (!intent) return;
    var target = -1, seekTo = 0;
    var c = ST.cur;
    if (c && lis[c.epi] && lis[c.epi].hasAttribute('data-audio') && (c.t > 3) && !ST.done[idOf(lis[c.epi])]) {
      target = c.epi; seekTo = c.t;
    } else if (audLis.length) { target = lis.indexOf(audLis[0]); }
    if (target < 0) return;
    var pr = playIdx(target, seekTo);
    if (pr && pr.catch) pr.catch(function () {
      var all = document.getElementById('rsxdPlayAll');
      if (all) all.classList.add('pulse');
      plToast('ব্রাউজার অটোপ্লে আটকেছে — "সব শুনুন" চাপুন');
    });
  })();
  bindMedia(audio);
})();
</script>
