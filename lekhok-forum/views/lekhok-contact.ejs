            <div class="ts-head-meta">
              <h3><%= ts.bus.title %></h3>
              <p><%= ts.bus.subtitle %></p>
            </div>
            <span class="ts-source"><i class="fas fa-check-circle"></i> <%= ts.bus.source %></span>
          </div>
          <div class="ts-panel-body">
            <div class="cx-bus-groups">
              <% ts.bus.groups.forEach(function (g) { %>
              <div class="ts-dir-wrap">
                <div class="ts-dir"><span class="ts-dir-badge"><i class="fas fa-bus"></i></span><span><%= g.title %></span></div>
                <table class="ts-table">
                  <thead><tr><% g.head.forEach(function (h) { %><th><%= h %></th><% }); %></tr></thead>
                  <tbody>
                    <% g.rows.forEach(function (row) { %>
                    <tr>
                      <td><span class="ts-period <%= row[0] === 'সকাল' ? 'ts-am' : (row[0] === 'সন্ধ্যা' ? 'ts-pm' : 'ts-night') %>"><%= row[0] %></span></td>
                      <td><%= row[1] %></td>
