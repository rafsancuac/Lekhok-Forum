      <div class="cx-prov-grid" id="cxProvGrid" data-collapsed="1">
        <% halls42.forEach(function (h, hi) {
             var ph = phoneOf102(h);
             var firstChar = String(h.title || '').trim().charAt(0) || 'হ';
             var mtint = _EGTINT102[hi % _EGTINT102.length];
        %>
        <div class="cx-prov-item" data-search="<%= String((h.title || '') + ' ' + (h.subtitle || '') + ' ' + (h.body || '')).replace(/"/g, '&quot;') %>">
          <span class="cx-prov-mono tint-<%= mtint %>" aria-hidden="true"><%= firstChar %></span>
          <span class="cx-prov-info">
            <strong><%= h.title %></strong>
            <span class="cx-prov-name"><%= h.subtitle || h.body %></span>
            <% if (h.body && h.subtitle) { %><span class="cx-prov-dept"><%= h.body %> বিভাগ</span><% } %>
          </span>
          <% if (ph) { %>
          <span class="cx-prov-actions">
            <button type="button" class="cx-prov-copy" data-num="<%= ph.pretty %>" title="নম্বর কপি করুন" aria-label="<%= h.title %> নম্বর কপি করুন"><i class="far fa-copy"></i></button>
            <a class="cx-prov-call" href="tel:<%= ph.tel %>"><i class="fas fa-phone-alt"></i> <%= ph.pretty %></a>
          </span>
          <% } %>
        </div>
        <% }); %>
      </div>
      <div class="cx-prov-empty" id="cxProvEmpty" hidden>
        <i class="fas fa-magnifying-glass"></i> কোনো হল মেলেনি — বানান বদলে আবার খুঁজুন।
      </div>
      <button type="button" class="cx-prov-toggle" id="cxProvToggle">সবগুলো দেখুন (<%= en2bn102(String(halls42.length)) %>টি)</button>
    </div>
    <% } %>

  </div>
</section>

</div>

<%# সেশন ১০৩: SEO — জরুরি-যোগাযোগ ContactPoint JSON-LD (নম্বরগুলো +880-নরমালাইজড) %>
<% if (typeof tr42 !== 'undefined' && tr42 && tr42.length) {
     var ld102 = tr42.map(function (c) {
       var ph = phoneOf102(c);
       if (!ph) return null;
       var intl = ph.tel.replace(/[^0-9]/g, '');
       if (intl.charAt(0) === '0') intl = '+88' + intl;
       return { '@type': 'ContactPoint', 'telephone': intl, 'contactType': String(c.title || ''), 'name': String(c.title || ''), 'areaServed': 'BD', 'availableLanguage': ['bn', 'en'] };
     }).filter(Boolean); %>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","name":"লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়","url":<%= JSON.stringify((typeof siteUrl !== 'undefined' ? siteUrl : '') + '/contact') %>,"contactPoint":<%= JSON.stringify(ld102) %>}
</script>
<% } %>

<%# সেশন ১০২: হল-প্রভোস্ট শো-অল/কম-টগল (প্রগ্রেসিভ-এনহ্যান্সমেন্ট — JS বন্ধ থাকলেও প্রথম ৬টি দেখা যায়) %>
<%# সেশন ১০৩: + সার্চ-ফিল্টার + কপি-টু-ক্লিপবোর্ড + 'আজ খোলা' ব্যাজ + ফর্ম-fetch-ইন্টারসেপ্ট — সব IIFE-গার্ডেড, একে-অপর-নির্ভরশীল নয় %>
<script>
(function () {
  var grid = document.getElementById('cxProvGrid');
  var btn = document.getElementById('cxProvToggle');
  if (!grid || !btn) return;
  var items = Array.prototype.slice.call(grid.children);
  var total = items.length;
  var bnN = function (n) { return String(n).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); };
  var label = function (collapsed, visible) {
    var n = bnN(visible == null ? total : visible);
    return collapsed ? 'সবগুলো দেখুন (' + n + 'টি)' : 'সংক্ষিপ্ত করুন';
  };

  /* ── সার্চ-ফিল্টার (হল/প্রভোস্ট/বিভাগ; কেস-অসংবেদী, জাবার-নিরপেক্ষ) ── */
  var search = document.getElementById('cxProvSearch');
  var clearB = document.getElementById('cxProvClear');
  var countEl = document.getElementById('cxProvCount');
  var emptyEl = document.getElementById('cxProvEmpty');
  var query = '';
  function applyFilter() {
    var visible = 0;
    items.forEach(function (it) {
      var hay = (it.getAttribute('data-search') || '').toLowerCase();
      var hit = !query || hay.indexOf(query) > -1;
      it.style.display = hit ? '' : 'none';
      if (hit) visible++;
    });
    if (countEl) countEl.textContent = bnN(visible) + 'টি হল';
    if (emptyEl) emptyEl.hidden = visible !== 0;
    if (clearB) clearB.hidden = !query;
    // সার্চ-চলাকালীন কলাপ্স-অর্থহীন — সব দেখাও
    if (query && grid.getAttribute('data-collapsed') === '1') {
      grid.setAttribute('data-collapsed', '0');
      btn.textContent = label(false, visible);
    } else if (!query) {
      var collapsed = grid.getAttribute('data-collapsed') === '1';
      btn.textContent = label(collapsed, visible);
    }
  }
  if (search) {
    search.addEventListener('input', function () {
      query = search.value.trim().toLowerCase();
      applyFilter();
    });
  }
  if (clearB) {
    clearB.addEventListener('click', function () {
      if (search) { search.value = ''; search.focus(); }
      query = '';
      applyFilter();
    });
  }

  /* ── কপি-টু-ক্লিপবোর্ড (কপি-হয়েছে-ফিডব্যাক) ── */
  grid.addEventListener('click', function (ev) {
    var b = ev.target.closest ? ev.target.closest('.cx-prov-copy') : null;
    if (!b) return;
    ev.preventDefault();
    var num = b.getAttribute('data-num') || '';
    var done = function () {
      b.classList.add('copied');
      var ic = b.querySelector('i');
      if (ic) { ic.className = 'fas fa-check'; }
      setTimeout(function () {
        b.classList.remove('copied');
        if (ic) ic.className = 'far fa-copy';
      }, 1400);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(num).then(done, done);
    } else {
      var ta = document.createElement('textarea');
      ta.value = num; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta); done();
    }
  });

  /* ── শো-অল/কম-টগল ── */
  if (total > 6) {
    btn.style.display = 'inline-flex';
    btn.textContent = label(true);
    btn.addEventListener('click', function () {
      var collapsed = grid.getAttribute('data-collapsed') === '1';
      grid.setAttribute('data-collapsed', collapsed ? '0' : '1');
      btn.textContent = label(!collapsed);
    });
  } else {
    btn.parentNode && btn.parentNode.removeChild(btn);
  }

  /* ── সেশন ১০৯: প্রিন্ট-ফ্লো — ক্লিকে সব-হল-প্রসারিত → window.print();
     Ctrl+P-তেও beforeprint-ইভেন্টে একই প্রসারণ (afterprint-এ ফেরত) ── */
  var expandForPrint = function () {
    grid.setAttribute('data-collapsed', '0');
    items.forEach(function (it) { it.style.display = ''; });
    if (emptyEl) emptyEl.hidden = true;
    if (btn) btn.textContent = label(false);
  };
  var printBtn = document.getElementById('cxProvPrint');
  if (printBtn) printBtn.addEventListener('click', function () { expandForPrint(); window.print(); });
  window.addEventListener('beforeprint', expandForPrint);
})();

/* ── 'আজ খোলা' লাইভ-ব্যাজ — সেশন-১০৯: টাইম-লেভেল আপগ্রেড ──
   আগে ছিল দিন-স্তর (আজ খোলা/আজ বন্ধ); এখন বাংলা সময়-পরিসর (যেমন
   'সকাল ১০টা – সন্ধ্যা ৬টা') পার্স করে স্টেট-চার: এখন খোলা (pulse) /
   এখন বন্ধ / আজ খোলা (অপার্সেবল সময়) / আজ বন্ধ। আজকের-রোতেও লাইভ-চিপ।
   ডিভাইস-সময় ব্যবহার হয় (ভিজিটরের টাইমজোন — প্রোডাকশনে বাংলাদেশ)। */
(function () {
  var badge = document.getElementById('cxTodayBadge');
  var txt = document.getElementById('cxTodayText');
  var rows = document.querySelectorAll('.cx-hour-row[data-days]');
  if (!badge || !txt || !rows.length) return;
  var names = ['রবি', 'সোম', 'মঙ্গল', 'বুধ', 'বৃহস্পতি', 'শুক্র', 'শনি'];
  var today = names[new Date().getDay()];
  var hit = null;
  Array.prototype.forEach.call(rows, function (r) {
    var d = r.getAttribute('data-days') || '';
    var found = d.indexOf(today) > -1;
    if (!found && d.indexOf('–') > -1) {
      var m = d.match(/(রবি|সোম|মঙ্গল|বুধ|বৃহস্পতি|শুক্র|শনি)বার/g) || [];
      if (m.length >= 2) {
        var a = names.indexOf(m[0].replace('বার', ''));
        var b = names.indexOf(m[1].replace('বার', ''));
        var t = names.indexOf(today);
        if (a > -1 && b > -1 && t > -1 && a <= t && t <= b) found = true;
      }
    }
    if (found && !hit) hit = r;
  });
  /* বাংলা সময়-স্ট্রিং → মিনিট (উদা: 'সকাল ১০টা'→600, 'সন্ধ্যা ৬টা'→1080,
     'বিকাল ৪টা'→960, 'রাত ৮টা'→1200, 'দুপুর ১২টা'→720, 'ভোর ৫টা'→300) */
  var bnToEn = function (s) { return String(s).replace(/[০-৯]/g, function (d) { return '০১২৩৪৫৬৭৮৯'.indexOf(d); }); };
  var periodToHour = function (p, h) {
    h = parseInt(h, 10);
    if (isNaN(h)) return -1;
    if (p === 'ভোর') return h;
    if (p === 'সকাল') return h <= 11 ? h : -1;
    if (p === 'দুপুর') return h === 12 ? 12 : (h < 12 ? 12 + h : h);
    if (p === 'বিকাল') return h < 12 ? 12 + h : h;
    if (p === 'সন্ধ্যা') return h < 12 ? 12 + h : h;
    if (p === 'রাত') return h === 12 ? 0 : (h < 6 ? h : 12 + h);
    return -1;
  };
  var parseRange = function (s) {
    if (!s) return null;
    var parts = String(s).split(/–|-|—/);
    if (parts.length < 2) return null;
    var val = function (t) {
      var mm = bnToEn(t).match(/(ভোর|সকাল|দুপুর|বিকাল|সন্ধ্যা|রাত)\s*(\d{1,2})/);
      if (!mm) {
        var pm = bnToEn(t).match(/(\d{1,2})\s*[:.]\s*(\d{2})/); /* ১০:৩০-ধাঁচ */
        if (pm) return parseInt(pm[1], 10) * 60 + parseInt(pm[2], 10);
        var ph = bnToEn(t).match(/\d{1,2}/);
        return ph ? parseInt(ph[0], 10) % 24 * 60 : -1;
      }
      var h = periodToHour(mm[1], mm[2]);
      return h > -1 ? h * 60 : -1;
    };
    var o = val(parts[0]), c = val(parts[1]);
    if (o < 0 || c < 0) return null;
    if (c <= o) c += 12 * 60; /* 'রাত ৮টা – রাত ১টা' → মধ্যরাত অতিক্রম */
    return { o: o, c: c };
  };
  var now = new Date();
  var nowMin = now.getHours() * 60 + now.getMinutes();
  if (hit) {
    var closed = hit.getAttribute('data-closed') === '1';
    var range = parseRange(hit.getAttribute('data-time'));
    badge.hidden = false;
    if (closed) {
      badge.classList.add('is-off');
      txt.textContent = 'আজ বন্ধ';
    } else if (range) {
      var openNow = nowMin >= range.o && nowMin < range.c;
      if (openNow) {
        badge.classList.add('is-live');
        txt.textContent = 'এখন খোলা';
      } else {
        badge.classList.add('is-idle');
        txt.textContent = 'এখন বন্ধ';
        badge.title = 'আজকের অফিস-সময়: ' + (hit.getAttribute('data-time') || '');
      }
    } else {
      badge.classList.add('is-on');
      txt.textContent = 'আজ খোলা';
    }
    hit.classList.add('is-today');
    /* আজকের-রোর স্টেট-চিপও লাইভ করা (অপার্সেবল হলে স্ট্যাটিক-ই থাকে) */
    if (!closed && range) {
      var st = hit.querySelector('.cx-hour-state');
      if (st) {
        var openNow2 = nowMin >= range.o && nowMin < range.c;
        st.textContent = openNow2 ? 'এখন খোলা' : 'এখন বন্ধ';
        st.classList.toggle('live', openNow2);
        st.classList.toggle('idle', !openNow2); /* সবুজ 'খোলা'-স্টাইলে 'বন্ধ' পাঠ বিভ্রান্তিকর — ধূসর-আইডল */
      }
    }
  }
})();

/* ── ফর্ম fetch-ইন্টারসেপ্ট (no-JS-এ প্লেইন POST → রুটে 303-রিডাইরেক্ট — উভয়-পথ কাজ করে) ── */
(function () {
  var f = document.getElementById('cxForm103');
  var note = document.getElementById('cxFormNote');
  if (!f || !note) return;
  f.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var name = f.elements.name ? f.elements.name.value.trim() : '';
    var msg = f.elements.message ? f.elements.message.value.trim() : '';
    var show = function (ok, m) {
      note.hidden = false;
      note.className = 'cx-form-note show ' + (ok ? 'ok' : 'bad');
      note.innerHTML = '<i class="fas ' + (ok ? 'fa-check-circle' : 'fa-exclamation-circle') + '"></i> ' + m;
    };
    if (!name || !msg) { show(false, 'নাম এবং বার্তা আবশ্যক'); return; }
    var btn = f.querySelector('button[type="submit"]');
    var setBusy = function (busy) {
      if (!btn) return;
      if (busy) { btn.disabled = true; btn.setAttribute('data-orig', btn.innerHTML); btn.innerHTML = 'পাঠানো হচ্ছে…'; }
      else { btn.disabled = false; btn.innerHTML = btn.getAttribute('data-orig') || btn.innerHTML; }
    };
    var buildBody = function (tok) {
      var b = new URLSearchParams(new FormData(f));
      if (tok) b.set('_csrf', tok); else if (!b.get('_csrf')) {
        var meta = document.querySelector('meta[name="csrf-token"]');
        b.set('_csrf', meta ? meta.content : '');
      }
      return b.toString();
    };
    /* সেশন ১০৩-গোটচা-হিল: /contact ক্যাশেবল-পাবলিক → রেন্ডার-টোকেন এফেমেরাল
       (সেশন/কুকি-তে নেই) → প্রথম POST 403-csrf দিতে পারে। রিকভারি: fresh
       ?_u= GET (ক্যাশ-বাইপাস → Set-Cookie + বৈধ-টোকেন) → রিট্রায়। */
    var post = function (tok) {
      return fetch(f.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
        body: buildBody(tok),
        credentials: 'same-origin'
      }).then(function (r) {
        return r.json().then(function (j) { return { ok: r.ok, j: j }; }, function () { return { ok: r.ok, j: {} }; });
      });
    };
    var refreshTok = function () {
      var u = document.createElement('a');
      u.href = location.href;
      var qs = u.search ? u.search.replace(/^\?/, '') : '';
      var params = new URLSearchParams(qs);
      params.set('_u', String(Date.now())); // ক্যাশ-বাইপাস + গেটওয়ে-কুয়েরি (XTransformPort) প্রিজার্ভ
      return fetch(u.pathname + '?' + params.toString(), { credentials: 'same-origin' })
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var m = html.match(/name="_csrf" value="([^"]+)"/);
          return m ? m[1] : '';
        });
    };
    setBusy(true);
    post(null).then(function (res) {
      var csrfFail = (res.j && res.j.error && String(res.j.error).indexOf('নিরাপত্তা') > -1) || res.status === 403;
      if (csrfFail) return refreshTok().then(function (tok) { return post(tok); });
      return res;
    }).then(function (res) {
      var ok = !!(res.ok && res.j && res.j.success);
      var m = (res.j && (res.j.message || res.j.error)) || (ok ? 'পাঠানো হয়েছে' : 'সমস্যা হয়েছে — আবার চেষ্টা করুন।');
      show(ok, m);
      if (ok) f.reset();
    }).catch(function () {
      show(false, 'নেটওয়ার্ক সমস্যা — ইন্টারনেট যাচাই করে আবার চেষ্টা করুন।');
    }).then(function () { setBusy(false); });
  });
})();

/* ── সেশন ১০৮: মাল্টি-পিন ম্যাপ — জায়গা-চিপে iframe q=/z= সোয়াপ (API-কী-বিহীন) ── */
(function () {
  var chips = document.querySelectorAll('.cx-chip108');
  var frame = document.getElementById('cxMapIframe108');
  var cap = document.getElementById('cxPinCaption108');
  var open = document.getElementById('cxMapOpen108');
  if (!chips.length || !frame) return;
  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      if (c.classList.contains('active')) return;
      chips.forEach(function (o) { o.classList.remove('active'); o.setAttribute('aria-pressed', 'false'); });
      c.classList.add('active');
      c.setAttribute('aria-pressed', 'true');
      var q = c.getAttribute('data-q') || '';
      var z = c.getAttribute('data-z') || '14';
      var label = c.textContent.trim().replace(/\s+/g, ' ');
      frame.src = 'https://maps.google.com/maps?q=' + encodeURIComponent(q) + '&t=&z=' + z + '&ie=UTF8&iwloc=&output=embed';
      frame.title = label + ' — গুগল ম্যাপ';
      if (cap) cap.innerHTML = '<i class="fas fa-map-pin" aria-hidden="true"></i> দেখানো হচ্ছে: <strong></strong>';
      if (cap) cap.querySelector('strong').textContent = label;
      if (open) open.href = 'https://maps.google.com/?q=' + encodeURIComponent(q);
    });
  });
})();

/* ── সেশন ১০৮: প্রভোস্ট-তালিকা প্রিন্ট-শিট + শেয়ার (নেটিভ → ক্লিপবোর্ড-ফলব্যাক) ── */
(function () {
  var grid = document.getElementById('cxProvGrid');
  if (!grid) return;
  var bnN = function (n) { return String(n).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); };

  /* DOM থেকে সারি-ডেটা (textContent-only → XSS-নিরাপদ) — শেয়ার-টেক্সটের উৎস */
  function rows108() {
    return Array.prototype.map.call(grid.children, function (it) {
      var t = it.querySelector('.cx-prov-info strong');
      var nm = it.querySelector('.cx-prov-name');
      var call = it.querySelector('.cx-prov-call');
      return {
        hall: t ? t.textContent.trim() : '',
        provost: nm ? nm.textContent.trim() : '',
        phone: call ? call.textContent.trim() : ''
      };
    });
  }

  var sb = document.getElementById('cxProvShare108');
  if (sb) {
    sb.addEventListener('click', function () {
      var rows = rows108();
      var text = 'চট্টগ্রাম বিশ্ববিদ্যালয় — আবাসিক হল প্রভোস্ট তালিকা\n\n' + rows.map(function (r) {
        return '• ' + r.hall + (r.provost ? ' — ' + r.provost : '') + (r.phone ? ' · ' + r.phone : '');
      }).join('\n') + '\n\nবিস্তারিত: ' + location.href;
      var done = function () {
        sb.classList.add('done');
        var ic = sb.querySelector('i');
        var old = ic ? ic.className : '';
        if (ic) ic.className = 'fas fa-check';
        setTimeout(function () { sb.classList.remove('done'); if (ic && old) ic.className = old; }, 1600);
      };
      if (navigator.share) {
        navigator.share({ title: 'চট্টগ্রাম বিশ্ববিদ্যালয় — হল প্রভোস্ট তালিকা', text: text }).then(function () { done(); }).catch(function () {});
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta); done();
      }
    });
  }
})();
</script>
