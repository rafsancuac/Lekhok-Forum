<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('contact_header_eyebrow') %></span>
    <h1><%= C('contact_header_t1') %> <span style="color:var(--accent);"><%= C('contact_header_accent') %></span></h1>
    <p><%= C('contact_header_sub') %></p>
  </div>
</header>

<!-- Two-column: contact info + form -->
<section class="section reveal">
  <div class="container">
    <div class="section-split">
      <div>
        <span class="eyebrow"><%= C('contact_info_eyebrow') %></span>
        <h2 class="section-title"><%= C('contact_info_t1') %> <span class="accent"><%= C('contact_info_accent') %></span></h2>
        <span class="accent-divider"></span>
        <p><%= C('contact_info_text') %></p>
        <ul class="contact-list">
          <li><i class="fas fa-map-marker-alt"></i><div><strong><%= C('contact_office_label') %></strong><span><%= (typeof getSetting === 'function' && getSetting('contact_address')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'office', 'চট্টগ্রাম বিশ্ববিদ্যালয় ক্যাম্পাস, হাটহাজারী, চট্টগ্রাম') : 'চট্টগ্রাম বিশ্ববিদ্যালয় ক্যাম্পাস, হাটহাজারী, চট্টগ্রাম') %></span></div></li>
          <li><i class="fas fa-envelope"></i><div><strong>ইমেইল</strong><span><%= (typeof getSetting === 'function' && getSetting('contact_email')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'email', 'info@lekhokforum.org') : 'info@lekhokforum.org') %></span></div></li>
          <li><i class="fas fa-phone-alt"></i><div><strong>মোবাইল</strong><span><%= (typeof getSetting === 'function' && getSetting('contact_phone')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'phone', '০১********* (বিকাশ/নগদ)') : '০১********* (বিকাশ/নগদ)') %></span></div></li>
          <li><i class="fab fa-facebook-f"></i><div><strong><%= C('contact_fb_label') %></strong><span><%= C('contact_fb_text') %></span></div></li>
          <li><i class="fab fa-telegram-plane"></i><div><strong><%= C('contact_tg_label') %></strong><span><%= C('contact_tg_text') %></span></div></li>
        </ul>
      </div>
      <form class="contact-form card" method="POST" action="/api/contact">
        <h3 style="margin-top:0;"><i class="fas fa-paper-plane" style="color:var(--accent);"></i> <%= C('contact_form_title') %></h3>
        <p style="color:var(--text-muted); margin-bottom:18px;"><%= C('contact_form_text') %></p>
        <div class="form-row">
          <input type="text" name="name" placeholder="আপনার নাম *" required>
          <input type="email" name="email" placeholder="ইমেইল *" required>
        </div>
        <input type="text" name="subject" placeholder="বিষয়">
        <textarea name="message" placeholder="আপনার বার্তা লিখুন... *" rows="6" required></textarea>
        <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-paper-plane"></i> <%= C('contact_form_btn') %></button>
        <% if (success) { %>
          <p style="margin-top:14px;color:#15803d;background:#dcfce7;padding:10px 14px;border-radius:8px;">
            <i class="fas fa-check-circle"></i> <%= success %>
          </p>
        <% } %>
      </form>
    </div>
  </div>
</section>

<!-- Map placeholder + Office hours -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-split">
      <div>
        <span class="eyebrow"><%= C('contact_loc_eyebrow') %></span>
        <h2 class="section-title"><%= C('contact_loc_t1') %> <span class="accent"><%= C('contact_loc_accent') %></span></h2>
        <span class="accent-divider"></span>
        <p><%= C('contact_loc_text') %></p>
        <ul class="bullet-list">
          <li><%= C('contact_hours1') %></li>
          <li><%= C('contact_hours2') %></li>
          <li><%= C('contact_hours3') %></li>
          <li><%= C('contact_hours4') %></li>
        </ul>
      </div>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3683.4477074837404!2d91.786556315342!3d22.46095798524007!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30ad7e8b5f5e5b5b%3A0x5f5e5b5b5f5e5b5b!2z4Ka34KeN4Kaf4KeB4Kas4Ka_4Kao4KeN4Kaf!5e0!3m2!1sbn!2sbd!4v1620000000000!5m2!1sbn!2sbd"
          width="100%" height="350" style="border:0; border-radius:12px; box-shadow:0 4px 16px rgba(15,23,42,0.1);"
          allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="চট্টগ্রাম বিশ্ববিদ্যালয় অবস্থান"></iframe>
        <p style="text-align:center; margin-top:8px; font-size:13px; color:var(--text-muted);">
          <i class="fas fa-map-marker-alt"></i> চট্টগ্রাম বিশ্ববিদ্যালয়, হাটহাজারী, চট্টগ্রাম
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Emergency hotline -->
<section class="section reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><%= C('contact_campus_eyebrow') %></span>
      <h2 class="section-title"><%= C('contact_campus_t1') %> <span class="accent"><%= C('contact_campus_accent') %></span></h2>
      <span class="accent-divider center"></span>
      <p class="lead"><%= C('contact_campus_lead') %></p>
    </div>

    <!-- Campus social / digital channels -->
    <div class="campus-channel-grid reveal-stagger">
      <a class="campus-channel-card" href="https://www.facebook.com/groups/370139074195390" target="_blank" rel="noopener">
        <span class="ch-icon"><i class="fas fa-users"></i></span>
        <span class="ch-title">আমাদের গ্রুপ</span>
        <span class="ch-desc">ফেসবুক গ্রুপে যোগ দিন</span>
      </a>
      <a class="campus-channel-card" href="https://www.facebook.com/btclf.cu2020" target="_blank" rel="noopener">
        <span class="ch-icon"><i class="fab fa-facebook-f"></i></span>
        <span class="ch-title">আমাদের পেইজ</span>
        <span class="ch-desc">ফেসবুক পেইজ ফলো করুন</span>
      </a>
      <a class="campus-channel-card" href="mailto:info@lekhokforum.org">
        <span class="ch-icon"><i class="fas fa-envelope"></i></span>
        <span class="ch-title">ইমেইল</span>
        <span class="ch-desc">info@lekhokforum.org</span>
      </a>
      <div class="campus-channel-card" title="সদস্য নিবন্ধনের জন্য অনুমোদিত নম্বর, বিস্তারিত জানতে যোগাযোগ করুন">
        <span class="ch-icon"><i class="fas fa-phone-alt"></i></span>
        <span class="ch-title">মোবাইল</span>
        <span class="ch-desc">০১********* (বিকাশ/নগদ)</span>
      </div>
    </div>

    <!-- University resources -->
    <div class="campus-resource-section">
      <h3 class="crs-title"><i class="fas fa-university"></i> <%= C('contact_crs_uni') %></h3>
      <div class="campus-grid reveal-stagger">
        <a class="campus-card" href="https://www.facebook.com/ictcu" target="_blank" rel="noopener">
          <span class="cc-icon"><i class="fab fa-facebook"></i></span>
          <div>
            <strong>বিশ্ববিদ্যালয়ের ফেসবুক পেইজ</strong>
            <span>ICT, CU</span>
          </div>
        </a>
        <a class="campus-card" href="https://cu.ac.bd/" target="_blank" rel="noopener">
          <span class="cc-icon"><i class="fas fa-globe"></i></span>
          <div>
            <strong>বিশ্ববিদ্যালয়ের ওয়েবসাইট</strong>
            <span>cu.ac.bd</span>
          </div>
        </a>
        <a class="campus-card" href="https://www.facebook.com/groups/153918041812990" target="_blank" rel="noopener">
          <span class="cc-icon"><i class="fas fa-users"></i></span>
          <div>
            <strong>চট্টগ্রাম বিশ্ববিদ্যালয় পরিবার</strong>
            <span>CU Family Group</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Transport & important contacts -->
    <div class="campus-resource-section">
      <h3 class="crs-title"><i class="fas fa-bus-alt"></i> <%= C('contact_crs_transport') %></h3>
      <div class="campus-grid reveal-stagger">
        <div class="campus-card static">
          <span class="cc-icon"><i class="fas fa-shuttle-van"></i></span>
          <div>
            <strong>শাটল ট্রেন স্কেজিউল</strong>
            <span>চবি ক্যাম্পাস ⇄ শহর (সকাল ও বিকেল)</span>
          </div>
        </div>
        <div class="campus-card static">
          <span class="cc-icon"><i class="fas fa-bus"></i></span>
          <div>
            <strong>বিশ্ববিদ্যালয় বাস সার্ভিস</strong>
            <span>ক্যাম্পাস থেকে শহরগামী রুট</span>
          </div>
        </div>
        <div class="campus-card static">
          <span class="cc-icon"><i class="fas fa-train"></i></span>
          <div>
            <strong>নাজিরহাট ট্রেন স্কেজিউল</strong>
            <span>চবি স্টেশন (ঢাকা/চট্টগ্রাম রুট)</span>
          </div>
        </div>
        <div class="campus-card static">
          <span class="cc-icon"><i class="fas fa-user-shield"></i></span>
          <div>
            <strong>প্রক্টর অফিস</strong>
            <span>প্রক্টর নম্বর ও জরুরি যোগাযোগ</span>
          </div>
        </div>
        <div class="campus-card static">
          <span class="cc-icon"><i class="fas fa-briefcase"></i></span>
          <div>
            <strong>গুরুত্বপূর্ণ অফিস ও ব্যক্তি</strong>
            <span>রেজিস্ট্রার, কোষাধ্যক্ষ, বিভাগীয় প্রধানগণ</span>
          </div>
        </div>
        <div class="campus-card static">
          <span class="cc-icon"><i class="fas fa-first-aid"></i></span>
          <div>
            <strong>বিশ্ববিদ্যালয় মেডিকেল</strong>
            <span>চিকিৎসা সেবা ও অ্যাম্বুলেন্স</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
