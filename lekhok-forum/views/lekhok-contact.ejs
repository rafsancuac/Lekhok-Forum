    </div>

    <!-- ৩ঘ. জরুরি ও গুরুত্বপূর্ণ যোগাযোগ — ক্লিক-টু-কল গ্রিড (সেশন ১০২) -->
    <div class="cx-sub-block">
      <div class="cx-sec-head is-emergency">
        <span class="cx-sec-ico"><i class="fas fa-phone-volume"></i></span>
        <div>
          <h3 class="cx-sec-title">জরুরি ও গুরুত্বপূর্ণ যোগাযোগ</h3>
          <p class="cx-sec-sub">যেকোনো প্রয়োজনে নম্বরে সরাসরি ট্যাপ করে কল করুন</p>
        </div>
      </div>
      <div class="cx-egr-grid reveal-stagger">
        <% (typeof tr42 !== 'undefined' ? tr42 : []).forEach(function (c, ci) {
             var ph = phoneOf102(c);
             var tint = _EGTINT102[ci % _EGTINT102.length];
        %>
        <div class="cx-egr-card" data-tint="<%= tint %>">
          <span class="cx-egr-ico"><i class="<%= c.icon || 'fas fa-phone' %>"></i></span>
          <span class="cx-egr-meta">
            <strong><%= c.title %></strong>
            <% if (c.subtitle && !isNum102(c.subtitle)) { %><span class="cx-egr-sub"><%= c.subtitle %></span><% } %>
            <span class="cx-egr-desc"><%= c.body %></span>
            <% if (ph) { %><span class="cx-egr-num"><i class="fas fa-phone-alt"></i> <%= ph.pretty %></span><% } %>
          </span>
          <% if (ph) { %>
          <a class="cx-egr-call" href="tel:<%= ph.tel %>" title="<%= c.title %> — সরাসরি কল করুন" aria-label="<%= c.title %> কল করুন">
            <i class="fas fa-phone-alt"></i>
          </a>
          <% } %>
        </div>
        <% }); %>
      </div>
    </div>

    <!-- ৩ঙ. আবাসিক হল প্রভোস্ট তালিকা (সেশন ১০২ — DB/contact_halls খালি হলে রেজিস্ট্রি-ডিফল্ট; ১০৩: সার্চ+কপি+মোনোগ্রাম; ১০৯: id=প্রিন্ট-টার্গেট) -->
    <% if (typeof halls42 !== 'undefined' && halls42 && halls42.length) { %>
    <div class="cx-sub-block" id="cxProvBlock">
      <div class="cx-sec-head">
        <span class="cx-sec-ico"><i class="fas fa-hotel"></i></span>
        <div>
          <h3 class="cx-sec-title">আবাসিক হলসমূহের প্রভোস্ট তালিকা</h3>
          <p class="cx-sec-sub">চট্টগ্রাম বিশ্ববিদ্যালয়ের সব হলের প্রশাসনিক যোগাযোগ</p>
        </div>
      </div>

      <div class="cx-prov-tools">
        <div class="cx-prov-search">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input type="search" id="cxProvSearch" placeholder="হল, প্রভোস্ট বা বিভাগ লিখে খুঁজুন…" aria-label="হল প্রভোস্ট খুঁজুন" autocomplete="off">
          <button type="button" class="cx-prov-clear" id="cxProvClear" aria-label="সার্চ মুছুন" hidden><i class="fas fa-times"></i></button>
        </div>
        <span class="cx-prov-actions-108">
          <span class="cx-prov-count" id="cxProvCount"><%= en2bn102(String(halls42.length)) %>টি হল</span>
          <% /* সেশন ১০৯: প্রিন্ট-বাটন (ক্যানোনিকাল — beforeprint-প্রসারণ + cx-print-keep; JS-ব্যর্থতায়ও সব-হল) */ %>
          <button type="button" class="cx-prov-print" id="cxProvPrint" title="প্রভোস্ট তালিকা প্রিন্ট করুন"><i class="fas fa-print" aria-hidden="true"></i> প্রিন্ট করুন</button>
          <% /* সেশন ১০৮-খ: শেয়ার (নেটিভ-শেয়ার → ক্লিপবোর্ড-ফলব্যাক) — অনন্য */ %>
          <button type="button" class="cx-prov-tool108" id="cxProvShare108" title="তালিকা শেয়ার করুন" aria-label="প্রভোস্ট তালিকা শেয়ার করুন"><i class="fas fa-share-nodes" aria-hidden="true"></i> শেয়ার</button>
        </span>
