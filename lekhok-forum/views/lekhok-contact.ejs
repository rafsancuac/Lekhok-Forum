<%
  // ── সেশন ১০২: যোগাযোগ-পেজ রিডিজাইন হেল্পার (ভিউ-লোকাল, অন্য পেজে প্রভাব শূন্য) ──
  var _BN102 = '০১২৩৪৫৬৭৮৯';
  function bn2en102(s) { return String(s || '').replace(/[০-৯]/g, function (d) { return String(_BN102.indexOf(d)); }); }
  function en2bn102(s) { return String(s || '').replace(/[0-9]/g, function (d) { return _BN102[+d]; }); }
  // আইটেম থেকে কলযোগ্য নম্বর → { tel: '880...', pretty: '০১৭১৪-৪৬৫৭৯৩' } বা null
  function phoneOf102(c) {
    var raw = String((c && c.extra) || '').trim();
    if (raw.toLowerCase().indexOf('tel:') === 0) raw = raw.slice(4);
    var ok = /^[0-9+()\-\s]+$/.test(raw) && raw.replace(/[^0-9]/g, '').length >= 6;
    if (!ok) {
      var m = String((c && (c.subtitle || c.body)) || '').match(/\+?88[ ()-]*[০-৯0-9][০-৯0-9 ()-]{7,}/);
      if (!m) return null;
      raw = m[0];
    }
    var digits = bn2en102(raw).replace(/[^0-9+]/g, '');
    if (digits.replace(/[^0-9]/g, '').length < 6) return null;
    // প্রদর্শন-নম্বর: subtitle কেবল তখনই যখন এটি আসলে নম্বর (≥৬ ডিজিট); নাহলে raw → বাংলা ডিজিট (সেশন ১০২-প্যাচ)
    var sub = String((c && c.subtitle) || '').trim();
    var pretty = (sub.replace(/[^0-9০-৯]/g, '').length >= 6) ? sub : en2bn102(raw.trim());
    return { tel: digits.charAt(0) === '+' ? digits : digits, pretty: pretty };
  }
  // subtitle-স্ট্রিং কি প্রদর্শনযোগ্য ফোন-নম্বর (ইমার্জেন্সি-কার্ডে ডুপ্লিকেট এড়াতে)
  function isNum102(s) { return String(s || '').replace(/[^0-9০-৯]/g, '').length >= 6; }
  // চ্যানেল-কার্ডের অ্যাকশন-লেবেল/টিন্ট আইকন-ক্লাস থেকে অনুমিত
  function chAction102(c) {
    var ic = String((c && c.icon) || '');
    if (ic.indexOf('youtube') > -1) return { t: 'সাবস্ক্রাইব করুন', tint: 'yt' };
    if (ic.indexOf('facebook') > -1) return { t: 'ফলো করুন', tint: 'fb' };
    if (ic.indexOf('telegram') > -1) return { t: 'জয়েন করুন', tint: 'tg' };
    if (ic.indexOf('users') > -1) return { t: 'গ্রুপে যোগ দিন', tint: 'grp' };
    if (ic.indexOf('envelope') > -1) return { t: 'ইমেইল পাঠান', tint: 'mail' };
    if (ic.indexOf('phone') > -1) return { t: 'কল করুন', tint: 'tel' };
    return { t: 'বিস্তারিত দেখুন', tint: 'gen' };
  }
  // ইমার্জেন্সি-গ্রিডের টিন্ট-প্যালেট (ইনডেক্স-ভিত্তিক, ডেটা-নিরপেক্ষ)
  var _EGTINT102 = ['red', 'amber', 'blue', 'purple', 'green', 'slate', 'red', 'amber', 'blue', 'purple', 'green', 'slate'];
%>

<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('contact_header_eyebrow') %></span>
    <h1><%= C('contact_header_t1') %> <span style="color:var(--accent);"><%= C('contact_header_accent') %></span></h1>
    <p><%= C('contact_header_sub') %></p>
  </div>
</header>

<div class="cx102">

<!-- ── সেকশন ১: যোগাযোগের তথ্য + ফর্ম ─────────────────────────────── -->
<section class="section reveal">
  <div class="container">
    <div class="section-split">
      <div>
        <span class="eyebrow"><%= C('contact_info_eyebrow') %></span>
        <h2 class="section-title"><%= C('contact_info_t1') %> <span class="accent"><%= C('contact_info_accent') %></span></h2>
        <span class="accent-divider"></span>
        <p><%= C('contact_info_text') %></p>
        <ul class="contact-list">
          <li><i class="fas fa-map-marker-alt"></i><div><strong><%= C('contact_office_label') %></strong><span><%= (typeof getSetting === 'function' && getSetting('contact_address')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'office', 'চট্টগ্রাম বিশ্ববিদ্যালয় ক্যাম্পাস, হাটহাজারী, চট্টগ্রাম') : 'চট্টগ্রাম বিশ্ববিদ্যালয় ক্যাম্পাস, হাটহাজারী, চট্টগ্রাম') %></span></div></li>
          <li><i class="fas fa-envelope"></i><div><strong>ইমেইল</strong><span><%= (typeof getSetting === 'function' && getSetting('contact_email')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'email', 'info@lekhokforum.org') : 'info@lekhokforum.org') %></span></div></li>
          <li><i class="fas fa-phone-alt"></i><div><strong>মোবাইল</strong><span><%= (typeof getSetting === 'function' && getSetting('contact_phone')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'phone', '০১********* (বিকাশ/নগদ)') : '০১********* (বিকাশ/নগদ)') %></span></div></li>
          <li><i class="fab fa-facebook-f"></i><div><strong><%= C('contact_fb_label') %></strong><span><%= C('contact_fb_text') %></span></div></li>
          <li><i class="fab fa-telegram-plane"></i><div><strong><%= C('contact_tg_label') %></strong><span><%= C('contact_tg_text') %></span></div></li>
        </ul>
      </div>
      <form class="contact-form card" id="cxForm103" method="POST" action="/api/contact">
        <%# সেশন ১০৩-ফিক্স: মূল-ফর্মে _csrf-ফিল্ডই ছিল না → সাবমিট সবসময় 303/?csrf=1-বাউন্স (কখনো সেভ হতো না) — টোকেন এখন ফর্মেই রেন্ডার %>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <h3 style="margin-top:0;"><i class="fas fa-paper-plane" style="color:var(--accent);"></i> <%= C('contact_form_title') %></h3>
        <p style="color:var(--text-muted); margin-bottom:18px;"><%= C('contact_form_text') %></p>
        <div class="form-row">
          <input type="text" name="name" placeholder="আপনার নাম *" required>
          <input type="email" name="email" placeholder="ইমেইল *" required>
        </div>
        <input type="text" name="subject" placeholder="বিষয়">
        <textarea name="message" placeholder="আপনার বার্তা লিখুন... *" rows="6" required></textarea>
        <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-paper-plane"></i> <%= C('contact_form_btn') %></button>
        <%# সেশন ১০৩: success/error স্ট্রিপ (no-JS ফলব্যাক: ?success=|error= রিডাইরেক্ট) + fetch-ইনলাইন-নোট %>
        <p id="cxFormNote" class="cx-form-note<%= success ? ' ok show' : (error ? ' bad show' : '') %>" role="status" aria-live="polite" <%= (success || error) ? '' : 'hidden' %>>
          <i class="fas <%= success ? 'fa-check-circle' : 'fa-exclamation-circle' %>"></i>
          <%= success || error || '' %>
        </p>
      </form>
    </div>
  </div>
</section>

<!-- ── সেকশন ২: কোথায় আমরা — সময়সূচি + লাইভ গুগল ম্যাপ (সেশন ১০২ ফিক্স) ── -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="cx-loc-grid">
      <div class="cx-loc-info">
        <span class="eyebrow"><%= C('contact_loc_eyebrow') %></span>
        <h2 class="section-title"><%= C('contact_loc_t1') %> <span class="accent"><%= C('contact_loc_accent') %></span> <span id="cxTodayBadge" class="cx-today-badge" hidden><span class="cx-tb-dot" aria-hidden="true"></span><span id="cxTodayText">আজ খোলা</span></span></h2>
        <span class="accent-divider"></span>
        <p class="cx-loc-text"><%= C('contact_loc_text') %></p>

        <div class="cx-hours">
          <% ['contact_hours1', 'contact_hours2', 'contact_hours3', 'contact_hours4'].forEach(function (hk, hi) {
               var ht = C(hk); if (!ht) return;
               var closed = /বন্ধ/.test(ht);
               var ci = ht.indexOf(':');
               var dayPart = ci > -1 ? ht.slice(0, ci) : ht;
               var timePart = ci > -1 ? ht.slice(ci + 1).trim() : '';
          %>
          <div class="cx-hour-row<%= closed ? ' is-closed' : '' %>" data-days="<%= dayPart %>" data-time="<%= timePart %>" data-closed="<%= closed ? '1' : '0' %>">
            <span class="cx-hour-dot" aria-hidden="true"></span>
            <span class="cx-hour-day"><%= dayPart %></span>
            <span class="cx-hour-time"><%= timePart %></span>
            <span class="cx-hour-state <%= closed ? 'off' : 'on' %>"><%= closed ? 'বন্ধ' : 'খোলা' %></span>
          </div>
          <% }); %>
        </div>

        <div class="cx-loc-addr">
          <i class="fas fa-map-marker-alt"></i>
          <span><%= (typeof getSetting === 'function' && getSetting('contact_address')) || 'চট্টগ্রাম বিশ্ববিদ্যালয়, হাটহাজারী, চট্টগ্রাম-৪৩৩১' %></span>
        </div>
      </div>

      <div class="cx-map-wrap">
        <%# সেশন ১০২ ফিক্স: ভাঙা pb-এমবেডের বদলে API-কী-বিহীন নির্ভরযোগ্য output=embed আইফ্রেম %>
        <%# সেশন ১০৮: মাল্টি-পিন — জায়গা-চিপ চাপলে আইফ্রেম q=/z= প্যারাম বদলায় (কোনো API-কী লাগে না) %>
        <div class="cx-map-chips108" role="tablist" aria-label="ম্যাপে দেখার জায়গা নির্বাচন">
          <button type="button" class="cx-chip108 active" data-q="University of Chittagong, Hathazari, Chittagong, Bangladesh" data-z="14" aria-pressed="true"><i class="fas fa-university" aria-hidden="true"></i> মূল ক্যাম্পাস</button>
          <button type="button" class="cx-chip108" data-q="Chittagong University Railway Station" data-z="15" aria-pressed="false"><i class="fas fa-train" aria-hidden="true"></i> বিশ্ববিদ্যালয় রেলস্টেশন</button>
          <button type="button" class="cx-chip108" data-q="Nazarhat Bus Stand, Hathazari, Chittagong" data-z="15" aria-pressed="false"><i class="fas fa-bus" aria-hidden="true"></i> নাজিরহাট</button>
          <button type="button" class="cx-chip108" data-q="Chittagong University Gate, Hathazari Road" data-z="15" aria-pressed="false"><i class="fas fa-door-open" aria-hidden="true"></i> গেট নং-১</button>
        </div>
        <p class="cx-pin-caption108" id="cxPinCaption108" aria-live="polite"><i class="fas fa-map-pin" aria-hidden="true"></i> দেখানো হচ্ছে: <strong>মূল ক্যাম্পাস</strong></p>
        <iframe
          id="cxMapIframe108"
          src="https://maps.google.com/maps?q=University%20of%20Chittagong%2C%20Hathazari%2C%20Chittagong%2C%20Bangladesh&t=&z=14&ie=UTF8&iwloc=&output=embed"
          width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="চট্টগ্রাম বিশ্ববিদ্যালয় অবস্থান — গুগল ম্যাপ"></iframe>
        <a class="cx-map-open" id="cxMapOpen108" href="https://maps.google.com/?q=University+of+Chittagong" target="_blank" rel="noopener">
          <i class="fas fa-external-link-alt"></i> ম্যাপে খুলুন
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ── সেকশন ৩: ক্যাম্পাস তথ্য (cx-print-keep = প্রিন্টে কেবল এই সেকশন — ১০৯) ── -->
<section class="section reveal cx-print-keep">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><%= C('contact_campus_eyebrow') %></span>
      <h2 class="section-title"><%= C('contact_campus_t1') %> <span class="accent"><%= C('contact_campus_accent') %></span></h2>
      <span class="accent-divider center"></span>
      <p class="lead"><%= C('contact_campus_lead') %></p>
    </div>

    <!-- ৩ক. ক্যাম্পাস চ্যানেল — প্রফেশনাল অ্যাকশন-কার্ড (সেশন ১০২) -->
    <div class="cx-ch-grid reveal-stagger">
      <% (typeof ch42 !== 'undefined' ? ch42 : []).forEach(function (c) {
           var act = chAction102(c);
           var hasLink = !!c.extra;
      %>
      <% if (hasLink) { %><a class="cx-ch-card tint-<%= act.tint %>" href="<%= c.extra %>" <%= String(c.extra).indexOf('http') === 0 ? 'target="_blank" rel="noopener"' : '' %>><% } else { %><div class="cx-ch-card tint-<%= act.tint %> is-static"><% } %>
        <span class="cx-ch-top">
          <span class="cx-ch-ico"><% if (c.image) { %><img loading="lazy" decoding="async" src="<%= c.image %>" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:14px;"><% } else { %><i class="<%= c.icon || 'fas fa-phone' %>"></i><% } %></span>
          <span class="cx-ch-head">
            <span class="cx-ch-title"><%= c.title %></span>
            <span class="cx-ch-desc"><%= c.body %></span>
          </span>
        </span>
        <span class="cx-ch-btn"><%= hasLink ? act.t : 'শীঘ্রই আসছে' %> <i class="fas fa-arrow-right"></i></span>
      <% if (hasLink) { %></a><% } else { %></div><% } %>
      <% }); %>
    </div>

    <!-- ৩খ. বিশ্ববিদ্যালয় সম্পর্কিত তথ্য -->
    <div class="cx-sub-block">
      <div class="cx-sec-head">
        <span class="cx-sec-ico"><i class="fas fa-university"></i></span>
        <div>
          <h3 class="cx-sec-title"><%= C('contact_crs_uni') %></h3>
          <p class="cx-sec-sub">অফিসিয়াল ওয়েবসাইট, পেইজ ও কমিউনিটি গ্রুপসমূহ</p>
        </div>
      </div>
      <div class="cx-uni-grid reveal-stagger">
        <% (typeof uni42 !== 'undefined' ? uni42 : []).forEach(function (c) { %>
        <% if (c.extra) { %><a class="cx-uni-card" href="<%= c.extra %>" target="_blank" rel="noopener"><% } else { %><div class="cx-uni-card is-static"><% } %>
          <span class="cx-uni-ico"><% if (c.image) { %><img loading="lazy" decoding="async" src="<%= c.image %>" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:12px;"><% } else { %><i class="<%= c.icon || 'fas fa-globe' %>"></i><% } %></span>
          <span class="cx-uni-meta">
            <strong><%= c.title %></strong>
            <span><%= c.body %></span>
          </span>
          <span class="cx-uni-go"><i class="fas fa-arrow-right"></i></span>
        <% if (c.extra) { %></a><% } else { %></div><% } %>
        <% }); %>
      </div>
    </div>

    <!-- ৩গ. যাতায়াত ও সময়সূচি -->
    <div class="cx-sub-block">
      <div class="cx-sec-head">
        <span class="cx-sec-ico"><i class="fas fa-bus-alt"></i></span>
        <div>
          <h3 class="cx-sec-title"><%= C('contact_crs_transport') %></h3>
          <p class="cx-sec-sub">শাটল ট্রেন, ফ্রি শাটল বাস ও শহর–ক্যাম্পাস যাতায়াতের হালনাগাদ সময়সূচি</p>
        </div>
      </div>

      <% if (typeof ts !== 'undefined' && ts) { %>
      <div class="ts-board reveal">

        <!-- ১. শাটল ট্রেন -->
        <div class="ts-panel">
          <div class="ts-panel-head">
            <span class="ts-ico"><i class="fas <%= ts.shuttle.icon %>"></i></span>
            <div class="ts-head-meta">
              <h3><%= ts.shuttle.title %></h3>
              <p><%= ts.shuttle.subtitle %></p>
            </div>
            <span class="ts-source"><i class="fas fa-check-circle"></i> <%= ts.shuttle.source %></span>
          </div>
          <div class="ts-panel-body">
            <div class="ts-tabs">
              <% ts.shuttle.tabs.forEach(function (tab, ti) { %>
              <input type="radio" name="ts-shuttle" id="ts-shuttle-<%= ti %>" <%= ti === 0 ? 'checked' : '' %>>
              <% }); %>
              <div class="ts-tabbar" role="tablist">
                <% ts.shuttle.tabs.forEach(function (tab, ti) { %>
                <label for="ts-shuttle-<%= ti %>" role="tab"><%= tab.label %></label>
                <% }); %>
              </div>
              <% ts.shuttle.tabs.forEach(function (tab, ti) { %>
              <div class="ts-pane ts-pane-<%= ti %>">
                <% tab.directions.forEach(function (dir) { %>
                <div class="ts-dir-wrap">
                  <div class="ts-dir">
                    <span class="ts-dir-badge"><i class="fas <%= dir.icon %>"></i></span>
                    <span><%= dir.title %></span>
                  </div>
                  <table class="ts-table">
                    <thead><tr><% dir.head.forEach(function (h) { %><th><%= h %></th><% }); %></tr></thead>
                    <tbody>
                      <% dir.rows.forEach(function (row) { %>
                      <tr><% row.forEach(function (cell) { %><td><%= cell %></td><% }); %></tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
                <% }); %>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- ২ ও ৩: ফ্রি শাটল বাস + নাজিরহাট ট্রেন (সেশন ১০২) -->
        <div class="ts-grid2">

          <% if (ts.freeShuttle) { %>
          <div class="ts-panel cx-fs-panel">
            <div class="ts-panel-head">
              <span class="ts-ico"><i class="fas <%= ts.freeShuttle.icon || 'fa-bus-simple' %>"></i></span>
              <div class="ts-head-meta">
                <h3><%= ts.freeShuttle.title %></h3>
                <p><%= ts.freeShuttle.subtitle %></p>
              </div>
              <span class="ts-source cx-fs-free"><i class="fas fa-check-circle"></i> <%= ts.freeShuttle.badge || 'ফ্রি' %></span>
            </div>
            <div class="ts-panel-body">
              <div class="cx-fs-cols">
                <div class="cx-fs-col cx-fs-col-gate">
                  <span class="cx-fs-colhead"><i class="fas fa-location-dot"></i> <%= ts.freeShuttle.head[0] %></span>
                  <div class="cx-fs-chips">
                    <% ts.freeShuttle.rows.forEach(function (r) { %><span class="cx-fs-chip"><%= r[0] %></span><% }); %>
                  </div>
                </div>
                <div class="cx-fs-col cx-fs-col-zero">
                  <span class="cx-fs-colhead"><i class="fas fa-location-crosshairs"></i> <%= ts.freeShuttle.head[1] %></span>
                  <div class="cx-fs-chips">
                    <% ts.freeShuttle.rows.forEach(function (r) { %><span class="cx-fs-chip"><%= r[1] %></span><% }); %>
                  </div>
                </div>
              </div>
              <% if (ts.freeShuttle.contact) { %>
              <p class="cx-fs-contact">
                <i class="fas fa-headset"></i>
                <span>যোগাযোগ: <a href="tel:<%= bn2en102(ts.freeShuttle.contact) %>"><strong><%= ts.freeShuttle.contact %></strong></a> (<%= ts.freeShuttle.contactLabel || '' %>)</span>
              </p>
              <% } %>
            </div>
          </div>
          <% } %>

          <div class="ts-panel">
            <div class="ts-panel-head">
              <span class="ts-ico"><i class="fas <%= ts.train.icon %>"></i></span>
              <div class="ts-head-meta">
                <h3><%= ts.train.title %></h3>
                <p><%= ts.train.subtitle %></p>
              </div>
              <span class="ts-source"><i class="fas fa-check-circle"></i> <%= ts.train.source %></span>
            </div>
            <div class="ts-panel-body">
