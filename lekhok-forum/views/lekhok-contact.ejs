<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('contact_header_eyebrow') %></span>
    <h1><%= C('contact_header_t1') %> <span style="color:var(--accent);"><%= C('contact_header_accent') %></span></h1>
    <p><%= C('contact_header_sub') %></p>
  </div>
</header>

<!-- Two-column: contact info + form -->
<section class="section reveal">
  <div class="container">
    <div class="section-split">
      <div>
        <span class="eyebrow"><%= C('contact_info_eyebrow') %></span>
        <h2 class="section-title"><%= C('contact_info_t1') %> <span class="accent"><%= C('contact_info_accent') %></span></h2>
        <span class="accent-divider"></span>
        <p><%= C('contact_info_text') %></p>
        <ul class="contact-list">
          <li><i class="fas fa-map-marker-alt"></i><div><strong><%= C('contact_office_label') %></strong><span><%= (typeof getSetting === 'function' && getSetting('contact_address')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'office', 'চট্টগ্রাম বিশ্ববিদ্যালয় ক্যাম্পাস, হাটহাজারী, চট্টগ্রাম') : 'চট্টগ্রাম বিশ্ববিদ্যালয় ক্যাম্পাস, হাটহাজারী, চট্টগ্রাম') %></span></div></li>
          <li><i class="fas fa-envelope"></i><div><strong>ইমেইল</strong><span><%= (typeof getSetting === 'function' && getSetting('contact_email')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'email', 'info@lekhokforum.org') : 'info@lekhokforum.org') %></span></div></li>
          <li><i class="fas fa-phone-alt"></i><div><strong>মোবাইল</strong><span><%= (typeof getSetting === 'function' && getSetting('contact_phone')) || (typeof getContent === 'function' ? getContent('contact', 'info', 'phone', '০১********* (বিকাশ/নগদ)') : '০১********* (বিকাশ/নগদ)') %></span></div></li>
          <li><i class="fab fa-facebook-f"></i><div><strong><%= C('contact_fb_label') %></strong><span><%= C('contact_fb_text') %></span></div></li>
          <li><i class="fab fa-telegram-plane"></i><div><strong><%= C('contact_tg_label') %></strong><span><%= C('contact_tg_text') %></span></div></li>
        </ul>
      </div>
      <form class="contact-form card" method="POST" action="/api/contact">
        <h3 style="margin-top:0;"><i class="fas fa-paper-plane" style="color:var(--accent);"></i> <%= C('contact_form_title') %></h3>
        <p style="color:var(--text-muted); margin-bottom:18px;"><%= C('contact_form_text') %></p>
        <div class="form-row">
          <input type="text" name="name" placeholder="আপনার নাম *" required>
          <input type="email" name="email" placeholder="ইমেইল *" required>
        </div>
        <input type="text" name="subject" placeholder="বিষয়">
        <textarea name="message" placeholder="আপনার বার্তা লিখুন... *" rows="6" required></textarea>
        <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-paper-plane"></i> <%= C('contact_form_btn') %></button>
        <% if (success) { %>
          <p style="margin-top:14px;color:#A7F3D0;background:rgba(16,185,129,.14);border:1px solid rgba(52,211,153,.35);padding:10px 14px;border-radius:5px;">
            <i class="fas fa-check-circle"></i> <%= success %>
          </p>
        <% } %>
      </form>
    </div>
  </div>
</section>

<!-- Map placeholder + Office hours -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-split">
      <div>
        <span class="eyebrow"><%= C('contact_loc_eyebrow') %></span>
        <h2 class="section-title"><%= C('contact_loc_t1') %> <span class="accent"><%= C('contact_loc_accent') %></span></h2>
        <span class="accent-divider"></span>
        <p><%= C('contact_loc_text') %></p>
        <ul class="bullet-list">
          <li><%= C('contact_hours1') %></li>
          <li><%= C('contact_hours2') %></li>
          <li><%= C('contact_hours3') %></li>
          <li><%= C('contact_hours4') %></li>
        </ul>
      </div>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3683.4477074837404!2d91.786556315342!3d22.46095798524007!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30ad7e8b5f5e5b5b%3A0x5f5e5b5b5f5e5b5b!2z4Ka34KeN4Kaf4KeB4Kas4Ka_4Kao4KeN4Kaf!5e0!3m2!1sbn!2sbd!4v1620000000000!5m2!1sbn!2sbd"
          width="100%" height="350" style="border:0; border-radius:5px; box-shadow:0 4px 16px rgba(15,23,42,0.1);"
          allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="চট্টগ্রাম বিশ্ববিদ্যালয় অবস্থান"></iframe>
        <p style="text-align:center; margin-top:8px; font-size:13px; color:var(--text-muted);">
          <i class="fas fa-map-marker-alt"></i> চট্টগ্রাম বিশ্ববিদ্যালয়, হাটহাজারী, চট্টগ্রাম
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Emergency hotline -->
<section class="section reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><%= C('contact_campus_eyebrow') %></span>
      <h2 class="section-title"><%= C('contact_campus_t1') %> <span class="accent"><%= C('contact_campus_accent') %></span></h2>
      <span class="accent-divider center"></span>
      <p class="lead"><%= C('contact_campus_lead') %></p>
    </div>

    <!-- Campus social / digital channels -->
    <div class="campus-channel-grid reveal-stagger">
      <% (typeof ch42 !== 'undefined' ? ch42 : []).forEach(c => { %>
      <% if (c.extra) { %><a class="campus-channel-card" href="<%= c.extra %>" <%= c.extra.startsWith('http') ? 'target="_blank" rel="noopener"' : '' %>>
      <% } else { %><div class="campus-channel-card"><% } %>
        <span class="ch-icon"><% if (c.image) { %><img loading="lazy" decoding="async" src="<%= c.image %>" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:5px;"><% } else { %><i class="<%= c.icon || 'fas fa-phone' %>"></i><% } %></span>
        <span class="ch-title"><%= c.title %></span>
        <span class="ch-desc"><%= c.body %></span>
      <% if (c.extra) { %></a><% } else { %></div><% } %>
      <% }); %>
    </div>
    </div>

    <!-- University resources -->
    <div class="campus-resource-section">
      <div class="section-head center" style="margin:40px 0 0;">
        <h2 class="section-title" style="font-size:1.45rem;"><i class="fas fa-university" style="color:var(--accent);"></i> <%= C('contact_crs_uni') %></h2>
        <span class="accent-divider center"></span>
      </div>
      <div class="campus-grid reveal-stagger">
        <% (typeof uni42 !== 'undefined' ? uni42 : []).forEach(c => { %>
        <% if (c.extra) { %><a class="campus-card" href="<%= c.extra %>" target="_blank" rel="noopener">
        <% } else { %><div class="campus-card static"><% } %>
          <span class="cc-icon"><% if (c.image) { %><img loading="lazy" decoding="async" src="<%= c.image %>" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:5px;"><% } else { %><i class="<%= c.icon || 'fas fa-globe' %>"></i><% } %></span>
          <div>
            <strong><%= c.title %></strong>
            <span><%= c.body %></span>
          </div>
        <% if (c.extra) { %></a><% } else { %></div><% } %>
        <% }); %>
      </div>
    </div>

    <!-- Transport & important numbers -->
    <div class="campus-resource-section">
      <div class="section-head center" style="margin:40px 0 0;">
        <h2 class="section-title" style="font-size:1.45rem;"><i class="fas fa-bus-alt" style="color:var(--accent);"></i> <%= C('contact_crs_transport') %></h2>
        <span class="accent-divider center"></span>
      </div>

      <% if (typeof ts !== 'undefined' && ts) { %>
      <div class="ts-board reveal">

        <!-- ১. শাটল ট্রেন -->
        <div class="ts-panel">
          <div class="ts-panel-head">
            <span class="ts-ico"><i class="fas <%= ts.shuttle.icon %>"></i></span>
            <div class="ts-head-meta">
              <h3><%= ts.shuttle.title %></h3>
              <p><%= ts.shuttle.subtitle %></p>
            </div>
            <span class="ts-source"><i class="fas fa-check-circle"></i> <%= ts.shuttle.source %></span>
          </div>
          <div class="ts-panel-body">
            <div class="ts-tabs">
              <% ts.shuttle.tabs.forEach((tab, ti) => { %>
              <input type="radio" name="ts-shuttle" id="ts-shuttle-<%= ti %>" <%= ti === 0 ? 'checked' : '' %>>
              <% }); %>
              <div class="ts-tabbar" role="tablist">
                <% ts.shuttle.tabs.forEach((tab, ti) => { %>
                <label for="ts-shuttle-<%= ti %>" role="tab"><%= tab.label %></label>
                <% }); %>
              </div>
              <% ts.shuttle.tabs.forEach((tab, ti) => { %>
              <div class="ts-pane ts-pane-<%= ti %>">
                <% tab.directions.forEach(dir => { %>
                <div class="ts-dir-wrap">
                  <div class="ts-dir">
                    <span class="ts-dir-badge"><i class="fas <%= dir.icon %>"></i></span>
                    <span><%= dir.title %></span>
                  </div>
                  <table class="ts-table">
                    <thead><tr><% dir.head.forEach(h => { %><th><%= h %></th><% }); %></tr></thead>
                    <tbody>
                      <% dir.rows.forEach(row => { %>
                      <tr><% row.forEach(cell => { %><td><%= cell %></td><% }); %></tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
                <% }); %>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- ২ ও ৩: বাস + নাজিরহাট ট্রেন -->
        <div class="ts-grid2">
          <div class="ts-panel">
            <div class="ts-panel-head">
              <span class="ts-ico"><i class="fas <%= ts.bus.icon %>"></i></span>
              <div class="ts-head-meta">
                <h3><%= ts.bus.title %></h3>
                <p><%= ts.bus.subtitle %></p>
              </div>
              <span class="ts-source"><i class="fas fa-check-circle"></i> <%= ts.bus.source %></span>
            </div>
            <div class="ts-panel-body">
              <% ts.bus.groups.forEach(g => { %>
              <div class="ts-dir-wrap">
                <div class="ts-dir"><span class="ts-dir-badge"><i class="fas fa-bus"></i></span><span><%= g.title %></span></div>
                <table class="ts-table">
                  <thead><tr><% g.head.forEach(h => { %><th><%= h %></th><% }); %></tr></thead>
                  <tbody>
                    <% g.rows.forEach(row => { %>
                    <tr>
                      <td><span class="ts-period <%= row[0] === 'সকাল' ? 'ts-am' : (row[0] === 'সন্ধ্যা' ? 'ts-pm' : 'ts-night') %>"><%= row[0] %></span></td>
                      <td><%= row[1] %></td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% }); %>
            </div>
          </div>

          <div class="ts-panel">
            <div class="ts-panel-head">
              <span class="ts-ico"><i class="fas <%= ts.train.icon %>"></i></span>
              <div class="ts-head-meta">
                <h3><%= ts.train.title %></h3>
                <p><%= ts.train.subtitle %></p>
              </div>
              <span class="ts-source"><i class="fas fa-check-circle"></i> <%= ts.train.source %></span>
            </div>
            <div class="ts-panel-body">
              <table class="ts-table ts-table-route">
                <thead><tr><% ts.train.head.forEach(h => { %><th><%= h %></th><% }); %></tr></thead>
                <tbody>
                  <% ts.train.rows.forEach(row => { %>
                  <tr><% row.forEach(cell => { %><td><%= cell %></td><% }); %></tr>
                  <% }); %>
                </tbody>
              </table>
              <p class="ts-note"><i class="fas fa-info-circle"></i> সময়সূচি মাঝেমধ্যে পরিবর্তিত হতে পারে — যাত্রার আগে নিশ্চিত হয়ে নিন।</p>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- গুরুত্বপূর্ণ নম্বর (দ্রুত যোগাযোগ) -->
      <div class="ts-cards-head"><i class="fas fa-phone-alt"></i><span>জরুরি ও গুরুত্বপূর্ণ যোগাযোগ</span></div>
      <div class="campus-grid reveal-stagger">
        <% (typeof tr42 !== 'undefined' ? tr42 : []).forEach(c => { %>
        <% if (c.extra) { %><a class="campus-card" href="<%= c.extra %>" target="_blank" rel="noopener">
        <% } else { %><div class="campus-card static"><% } %>
          <span class="cc-icon"><% if (c.image) { %><img loading="lazy" decoding="async" src="<%= c.image %>" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:5px;"><% } else { %><i class="<%= c.icon || 'fas fa-bus' %>"></i><% } %></span>
          <div>
            <strong><%= c.title %></strong>
            <span><%= c.body %></span>
          </div>
        <% if (c.extra) { %></a><% } else { %></div><% } %>
        <% }); %>
      </div>
    </div>
  </div>
</section>
