<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('resources_header_eyebrow') %></span>
    <h1><%= C('resources_header_t1') %> <span style="color:var(--accent);"><%= C('resources_header_accent') %></span></h1>
    <p><%= C('resources_header_sub') %></p>
  </div>
</header>

<%# সেশন ৩৫: রিসোর্স সাব-পেজ নেভিগেশন — 'গুরুত্বপূর্ণ ফাইল ও রিসোর্স' ও 'পত্রিকার ইমেইল' %>
<div class="res-subnav-wrap">
  <div class="container">
    <nav class="res-subnav" aria-label="রিসোর্স সাব-পেজ">
      <a href="/resources" class="active" aria-current="page"><i class="fas fa-folder-open"></i> গুরুত্বপূর্ণ ফাইল ও রিসোর্স</a>
      <a href="/resources/emails"><i class="fas fa-envelope"></i> পত্রিকার ইমেইল</a>
    </nav>
  </div>
</div>

<section class="section reveal">
  <div class="container">
    <div class="notice-tabs">
      <a href="?category=all"          class="<%= activeCategory === 'all' ? 'active' : '' %>"><i class="fas fa-layer-group"></i> সকল</a>
      <% if (categories && categories.length) { %>
        <% categories.forEach(c => { %>
          <% if (c.category) { %>
            <a href="?category=<%= c.category %>" class="<%= activeCategory === c.category ? 'active' : '' %>">
              <i class="fas fa-folder"></i> <%= c.category === 'scholarship' ? 'ফেলোশিপ' : c.category === 'writing-tips' ? 'লেখালেখির টিপস' : c.category %>
            </a>
          <% } %>
        <% }) %>
      <% } %>
    </div>

    <% if (resources && resources.length) { %>
      <div class="resource-grid reveal-stagger">
        <% resources.forEach(r => {
             var iconClass = 'fas fa-file-alt';
             var fileType = (r.file_type || '').toLowerCase();
             if (fileType === 'pdf') iconClass = 'fas fa-file-pdf';
             else if (fileType === 'doc' || fileType === 'docx') iconClass = 'fas fa-file-word';
             else if (fileType === 'image' || fileType === 'jpg' || fileType === 'png') iconClass = 'fas fa-file-image';
             else if (r.category === 'scholarship') iconClass = 'fas fa-graduation-cap';
             else if (r.category === 'writing-tips') iconClass = 'fas fa-pen-fancy';
        %>
          <div class="resource-card has-image">
            <div class="res-icon-wrap" style="position:relative;">
              <span class="res-badge"><%= r.category === 'scholarship' ? 'ফেলোশিপ' : r.category === 'writing-tips' ? 'টিপস' : (r.file_type || 'FILE') %></span>
              <i class="<%= iconClass %>"></i>
            </div>
            <div class="res-body">
              <h3><%= r.title %></h3>
              <% if (r.content) { %><p><%= r.content.length > 110 ? r.content.substring(0, 110) + '…' : r.content %></p><% } %>
              <% if (r.author) { %><p class="res-meta"><i class="far fa-user"></i> <%= r.author %></p><% } %>
              <% if (r.tags) { %><p class="res-meta"><i class="fas fa-tags"></i> <%= r.tags %></p><% } %>
              <% const resLink = r.link_url || r.file_url; %>
              <% if (resLink) { %>
              <a href="<%= resLink %>" class="btn btn-primary" target="_blank" rel="noopener">
                <i class="fas fa-external-link-alt"></i> দেখুন
              </a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-book-open"></i>
        <h3>এই ক্যাটাগরিতে কোনো রিসোর্স নেই</h3>
        <p>নতুন রিসোর্স এখানে যোগ করা হবে</p>
        <a href="/admin/resources/new" class="btn btn-primary"><i class="fas fa-plus"></i> রিসোর্স যোগ করুন</a>
      </div>
    <% } %>
  </div>
</section>
<%# সেশন ৩৫: নিচের বড় 'পত্রিকার ইমেইল তালিকা' বাটন-সেকশন সরানো হয়েছে —
    পত্রিকার ইমেইল এখন উপরের সাব-পেজ ট্যাব থেকেই যাওয়া যায় %>