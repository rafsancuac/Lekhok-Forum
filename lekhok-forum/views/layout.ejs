<%- include('partials/sandbox-preview') %>
<%# ── সেশন ১৩০ (রোডম্যাপ-① পূর্ণরূপ): পাবলিক-পেজ গ্লোবাল কল-রিংগার ──────────
    lekhok-*.ejs পাবলিক-পেজগুলো header-partial ব্যবহার করে না (দ্বি-হেডার-স্থাপত্য),
    তাই সেশন-৯৪-এর মেম্বার-পেজ রিংগার (header.ejs) এখানে পৌঁছায়নি — লগড-ইন ইউজার
    হোম/সম্পর্কিত/নোটিশ পড়া-অবস্থায় কল মিস হতো। এখন একই চুক্তি (LekhokCallCtx +
    webrtc-call.js) layout.ejs-এও। ডাবল-ইনক্লুড নিরাপদ (webrtc-call.js-এর নিজস্ব
    window.LekhokCall গার্ড); convId সবসময় ০ — পোল-লুপ নিজেই লেজি-পাঠ করে।
    মেম্বার-পেজ (header.ejs) থেকে আসা লোডের সাথে সংঘর্ষ নেই — ভিন্ন লেআউট-পরিবার। %>
<% if (typeof user !== 'undefined' && user) { %>
<script>
  window.LekhokCallCtx = {
    me: <%- parseInt(user.id, 10) %>,
    meName: <%- jesc(user.full_name || user.username) %>,
    meAvatar: <%- jesc(user.avatar_url || ('/avatar/' + user.id)) %>,
    convId: 0,
    convUsername: null,
    isGroup: false,
    peer: null
  };
  <% /* সেশন ৯৭-চুক্তি: env-configurable TURN (header.ejs-এর মিরর) —
        LEKHOK_TURN_URLS/USERNAME/CREDENTIAL দিলে সেটিই ব্যবহার হয়। */
     var _turnUrls130 = String(process.env.LEKHOK_TURN_URLS || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean); %>
  <% if (_turnUrls130.length) { %>
  window.LekhokCallCtx.iceServers = [
    { urls: 'stun:stun.l.google.com:19302' },
    { urls: 'stun:stun1.l.google.com:19302' },
    { urls: <%- JSON.stringify(_turnUrls130) %>, username: <%- jesc(process.env.LEKHOK_TURN_USERNAME || '') %>, credential: <%- jesc(process.env.LEKHOK_TURN_CREDENTIAL || '') %> }
  ];
  <% } %>
</script>
<script src="/assets/js/webrtc-call.js?v=<%= AV %><%= XTPQ %>"></script>
<% } %>
