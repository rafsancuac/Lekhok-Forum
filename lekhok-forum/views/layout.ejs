<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | লেখক ফোরাম</title>
  <meta name="description" content="লেখক ফোরামের অফিশিয়াল ওয়েবসাইট। দেশের প্রগতিশীল চিন্তাধারা ও সৃজনশীলতার এক অনন্য প্ল্যাটফর্ম।" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230a1f44'/><text x='50' y='72' font-size='70' text-anchor='middle' fill='%23059669' font-family='serif' font-weight='bold'>ল</text></svg>" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="stylesheet" href="/assets/css/fonts.css" />
</head>
<body class="<%= currentPath === '/' ? 'home-page' : '' %>">
  <!-- Scroll progress bar -->
  <div class="scroll-progress" id="scrollProgress"></div>

  <!-- Topbar (public) -->
  <div class="btclf-topbar topbar" id="mainHeader">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <div class="logo-wrap">
          <span class="logo-mark">ল</span>
          <span class="logo-text"><strong>লেখক ফোরাম</strong><small>সুপ্ত প্রতিভা বিকশিত হোক</small></span>
        </div>
      </a>
      <nav class="topbar-tabs">
        <a href="/" class="topbar-tab <%= currentPath === '/' ? 'active' : '' %>"><i class="fas fa-home"></i> হোম</a>
        <a href="/about" class="topbar-tab <%= currentPath === '/about' ? 'active' : '' %>"><i class="fas fa-info-circle"></i> পরিচিতি</a>
        <a href="/committee" class="topbar-tab <%= currentPath === '/committee' ? 'active' : '' %>"><i class="fas fa-users-cog"></i> কমিটি</a>
        <a href="/events" class="topbar-tab <%= currentPath === '/events' ? 'active' : '' %>"><i class="fas fa-calendar-check"></i> কার্যক্রম</a>
        <a href="/gallery" class="topbar-tab <%= currentPath === '/gallery' ? 'active' : '' %>"><i class="fas fa-images"></i> গ্যালারি</a>
        <a href="/contact" class="topbar-tab <%= currentPath === '/contact' ? 'active' : '' %>"><i class="fas fa-envelope"></i> যোগাযোগ</a>
      </nav>
      <div class="topbar-right">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="topbar-nav a btn-ghost"><i class="fas fa-sign-in-alt"></i> ফিডে যান</a>
        <% } else { %>
          <a href="/login" class="topbar-nav a">লগইন</a>
          <a href="/register" class="topbar-nav a btn-ghost">রেজিস্ট্রেশন</a>
        <% } %>
        <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
      </div>
    </div>
  </div>

  <!-- Mobile sidebar (public) -->
  <div class="mobile-overlay" id="mobileOverlay" onclick="closeMenu()"></div>
  <aside class="mobile-sidebar" id="mobileSidebar">
    <button class="close-btn" id="closeSidebar"><i class="fas fa-times"></i></button>
    <a href="/">হোম</a>
    <a href="/about">পরিচিতি</a>
    <a href="/committee">কমিটি</a>
    <a href="/gallery">গ্যালারি</a>
    <a href="/contact">যোগাযোগ</a>
    <a href="/articles">সকল লেখা</a>
    <a href="/qa">প্রশ্নোত্তর</a>
    <a href="/events">ইভেন্ট</a>
    <a href="/notices">বিজ্ঞপ্তি</a>
    <a href="/resources">রিসোর্স</a>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="mobile-cta primary"><i class="fas fa-globe-asia"></i> ফিডে যান</a>
    <% } else { %>
      <a href="/login" class="mobile-cta"><i class="fas fa-sign-in-alt"></i> লগইন</a>
      <a href="/register" class="mobile-cta primary"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন</a>
    <% } %>
  </aside>

  <!-- Page content -->
  <main class="page-main">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="btclf-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="logo-wrap">
          <span class="logo-mark">ল</span>
          <span class="logo-text"><strong>লেখক ফোরাম</strong></span>
        </div>
        <p>লেখক ফোরামের অফিশিয়াল ওয়েবসাইট। দেশের প্রগতিশীল চিন্তাধারা ও সৃজনশীলতার এক অনন্য প্ল্যাটফর্ম।</p>
        <div class="f-socials">
          <a href="<%= getSetting ? (getSetting('facebook_url') || '#') : '#' %>" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="<%= getSetting ? (getSetting('telegram_url') || '#') : '#' %>" aria-label="Telegram"><i class="fab fa-telegram-plane"></i></a>
          <a href="<%= getSetting ? (getSetting('youtube_url') || '#') : '#' %>" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        </div>
      </div>
      <div>
        <h4 class="f-widget-title">প্রয়োজনীয় লিংক</h4>
        <ul class="f-links">
          <li><a href="/about"><i class="fas fa-circle"></i> আমাদের সম্পর্কে</a></li>
          <li><a href="/committee"><i class="fas fa-circle"></i> কমিটি সদস্য</a></li>
          <li><a href="/notices"><i class="fas fa-circle"></i> বিজ্ঞপ্তি</a></li>
          <li><a href="/events"><i class="fas fa-circle"></i> ইভেন্ট</a></li>
          <li><a href="/gallery"><i class="fas fa-circle"></i> গ্যালারি</a></li>
          <li><a href="/resources"><i class="fas fa-circle"></i> রিসোর্স</a></li>
        </ul>
      </div>
      <div>
        <h4 class="f-widget-title">যোগাযোগ</h4>
        <ul class="f-contact">
          <li><i class="fas fa-map-marker-alt"></i> <span>আপনার ক্যাম্পাস ঠিকানা</span></li>
          <li><i class="fas fa-envelope"></i> <span>info@lekhokforum.org</span></li>
          <li><i class="fas fa-phone-alt"></i> <span>০১XXXXXXXXX</span></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container"><p>© ২০২৬ লেখক ফোরাম</p></div>
    </div>
  </footer>

  <script src="/assets/js/main.js"></script>

  <!-- Back-to-top button -->
  <button class="back-to-top" id="backToTop" aria-label="উপরে ফিরে যান">
    <i class="fas fa-arrow-up"></i>
  </button>
</body>
</html>
