<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | লেখক ফোরাম</title>
  <meta name="description" content="লেখক ফোরামের অফিশিয়াল ওয়েবসাইট। দেশের প্রগতিশীল চিন্তাধারা ও সৃজনশীলতার এক অনন্য প্ল্যাটফর্ম।" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230a1f44'/><text x='50' y='72' font-size='70' text-anchor='middle' fill='%23C5A059' font-family='serif' font-weight='bold'>ল</text></svg>" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/maateen/font-solaimanlipi@master/src/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>
  <!-- Topbar -->
  <div class="btclf-topbar">
    <div class="container topbar-inner">
      <a href="/" class="logo-wrap">
        <span class="logo-mark">ল</span>
        <span class="logo-text"><strong>লেখক ফোরাম</strong><small>সুপ্ত প্রতিভা বিকশিত হোক লেখনীর ধারায়</small></span>
      </a>
      <nav class="topbar-nav">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">হোম</a>
        <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">পরিচিতি</a>
        <a href="/committee" class="<%= currentPath === '/committee' ? 'active' : '' %>">কমিটি</a>
        <a href="/events" class="<%= currentPath === '/events' ? 'active' : '' %>">ইভেন্ট</a>
        <a href="/notices" class="<%= currentPath === '/notices' ? 'active' : '' %>">বিজ্ঞপ্তি</a>
        <a href="/gallery" class="<%= currentPath === '/gallery' ? 'active' : '' %>">গ্যালারি</a>
        <a href="/resources" class="<%= currentPath === '/resources' ? 'active' : '' %>">রিসোর্স</a>
        <a href="/team" class="<%= currentPath === '/team' ? 'active' : '' %>">টিম</a>
        <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">যোগাযোগ</a>
      </nav>
      <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
    </div>
  </div>

  <!-- Mobile sidebar -->
  <div class="mobile-sidebar" id="mobileSidebar">
    <button class="close-btn" id="closeSidebar"><i class="fas fa-times"></i></button>
    <a href="/">হোম</a>
    <a href="/about">পরিচিতি</a>
    <a href="/committee">কমিটি</a>
    <a href="/events">ইভেন্ট</a>
    <a href="/notices">বিজ্ঞপ্তি</a>
    <a href="/gallery">গ্যালারি</a>
    <a href="/resources">রিসোর্স</a>
    <a href="/team">টিম</a>
    <a href="/contact">যোগাযোগ</a>
  </div>
  <div class="mobile-overlay" id="mobileOverlay"></div>

  <!-- Page content -->
  <main>
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="btclf-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="logo-wrap">
          <span class="logo-mark">ল</span>
          <span class="logo-text"><strong>লেখক ফোরাম</strong></span>
        </div>
        <p>লেখক ফোরামের অফিশিয়াল ওয়েবসাইট। দেশের প্রগতিশীল চিন্তাধারা ও সৃজনশীলতার এক অনন্য প্ল্যাটফর্ম।</p>
        <div class="f-socials">
          <a href="<%= getSetting ? (getSetting('facebook_url') || '#') : '#' %>" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="<%= getSetting ? (getSetting('telegram_url') || '#') : '#' %>" aria-label="Telegram"><i class="fab fa-telegram-plane"></i></a>
          <a href="<%= getSetting ? (getSetting('youtube_url') || '#') : '#' %>" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        </div>
      </div>
      <div>
        <h4 class="f-widget-title">প্রয়োজনীয় লিংক</h4>
        <ul class="f-links">
          <li><a href="/about"><i class="fas fa-circle"></i> আমাদের সম্পর্কে</a></li>
          <li><a href="/committee"><i class="fas fa-circle"></i> কমিটি সদস্য</a></li>
          <li><a href="/events"><i class="fas fa-circle"></i> ইভেন্ট</a></li>
          <li><a href="/gallery"><i class="fas fa-circle"></i> গ্যালারি</a></li>
          <li><a href="/resources"><i class="fas fa-circle"></i> রিসোর্স</a></li>
        </ul>
      </div>
      <div>
        <h4 class="f-widget-title">যোগাযোগ</h4>
        <ul class="f-contact">
          <li><i class="fas fa-map-marker-alt"></i> <span>আপনার ক্যাম্পাস ঠিকানা</span></li>
          <li><i class="fas fa-envelope"></i> <span>info@lekhokforum.org</span></li>
          <li><i class="fas fa-phone-alt"></i> <span>০১XXXXXXXXX</span></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container"><p>© ২০২৬ লেখক ফোরাম</p></div>
    </div>
  </footer>

  <script src="/assets/js/main.js"></script>
</body>
</html>
