<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="MwDt57-lqUDC5XAeiiYy0BH11xb5mPRzcyp7A4aibCg" />
  <%
    // ── SEO locals (guarded — every var optional) ──────────────────────────
    var BRAND_FULL = 'বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়';
    var seoTitle = (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : BRAND_FULL);
    var seoDesc = (typeof metaDesc !== 'undefined' && metaDesc)
      ? metaDesc
      : BRAND_FULL + ', একটি শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। মূলমন্ত্র: তারুণ্যের শাণিত কলমে আলোকিত ধরনী।';
    var seoType = (typeof ogType !== 'undefined' && ogType) ? ogType : 'website';
    var seoImg = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : null;
    var seoPub = (typeof publishedTime !== 'undefined') ? publishedTime : null;
    var seoAuth = (typeof authorName !== 'undefined') ? authorName : null;
    var seoUrl = (typeof siteUrl !== 'undefined' ? siteUrl : '') + ((typeof canonicalPath !== 'undefined' && canonicalPath) ? canonicalPath : (typeof currentPath !== 'undefined' ? currentPath : '/'));
  %>
  <title><%= pageTitle %> | বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়</title>
  <meta name="description" content="<%= seoDesc %>" />
  <link rel="canonical" href="<%= seoUrl %>" />
  <meta property="og:site_name" content="<%= BRAND_FULL %>" />
  <meta property="og:type" content="<%= seoType %>" />
  <meta property="og:title" content="<%= seoTitle %>" />
  <meta property="og:description" content="<%= seoDesc %>" />
  <meta property="og:url" content="<%= seoUrl %>" />
  <meta property="og:locale" content="bn_BD" />
  <% if (seoImg) { %>
  <meta property="og:image" content="<%= seoImg %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="<%= seoImg %>" />
  <% } else { %>
  <meta name="twitter:card" content="summary" />
  <% } %>
  <meta name="twitter:title" content="<%= seoTitle %>" />
  <meta name="twitter:description" content="<%= seoDesc %>" />
  <% if (seoType === 'article') { %>
    <% if (seoPub) { %><meta property="article:published_time" content="<%= seoPub %>" /><% } %>
    <% if (seoAuth) { %><meta property="article:author" content="<%= seoAuth %>" /><% } %>
  <% } %>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230a1f44'/><text x='50' y='72' font-size='70' text-anchor='middle' fill='%23059669' font-family='serif' font-weight='bold'>ল</text></svg>" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/feed.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/dashboard.css?v=<%= AV %>" />
</head>
<body class="<%= currentPath === '/' ? 'home-page' : '' %>">
  <!-- Scroll progress bar -->
  <div class="scroll-progress" id="scrollProgress"></div>

  <!-- Topbar (public) -->
  <div class="btclf-topbar topbar" id="mainHeader">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <div class="logo-wrap">
          <span class="logo-text logo-text-v2"><strong>বাংলাদেশ তরুণ কলাম লেখক ফোরাম</strong><strong class="brand-line2">চট্টগ্রাম বিশ্ববিদ্যালয়</strong></span>
        </div>
      </a>
      <nav class="topbar-tabs">
        <% navConfig.forEach(item => { const _navActive = navItemActive(item, currentPath); %>
          <% if (item.children && item.children.length) { %>
            <div class="topbar-dropdown">
              <a href="<%= item.href %>" class="topbar-tab <%= _navActive ? 'active' : '' %>"><i class="fas <%= item.icon || 'fa-angle-down' %>"></i> <%= item.label %> <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
              <div class="topbar-dropdown-menu">
                <% item.children.forEach(c => { %>
                  <a href="<%= c.href %>"><i class="fas <%= c.icon || 'fa-circle' %>"></i> <%= c.label %></a>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <a href="<%= item.href %>" class="topbar-tab <%= _navActive ? 'active' : '' %>"><i class="fas <%= item.icon || 'fa-link' %>"></i> <%= item.label %></a>
          <% } %>
        <% }) %>
      </nav>
      <!-- Global search -->
      <div class="global-search-wrap" id="globalSearchWrap">
        <button class="global-search-btn" onclick="toggleGlobalSearch()" aria-label="সার্চ" title="সার্চ (/)">
          <i class="fas fa-search"></i>
        </button>
        <div class="global-search-dropdown" id="globalSearchDropdown" hidden>
          <div class="gs-input-wrap">
            <i class="fas fa-search"></i>
            <input type="search" id="globalSearchInput" placeholder="লেখা, প্রশ্ন, সদস্য খুঁজুন..." autocomplete="off" />
            <kbd class="gs-kbd">Esc</kbd>
          </div>
          <div class="gs-results" id="globalSearchResults">
            <div class="gs-hint">সার্চ করতে টাইপ করুন...</div>
          </div>
        </div>
      </div>

      <div class="topbar-right">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="topbar-nav a btn-ghost"><i class="fas fa-sign-in-alt"></i> ফিডে যান</a>
        <% } else { %>
          <a href="/login" class="topbar-nav a nav-login"><i class="fas fa-sign-in-alt"></i> লগইন</a>
          <a href="/register" class="topbar-nav a nav-register"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন</a>
        <% } %>
        <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
      </div>
    </div>
  </div>

  <!-- Mobile sidebar (public) -->
  <div class="mobile-overlay" id="mobileOverlay" onclick="closeMenu()"></div>
  <aside class="mobile-sidebar" id="mobileSidebar">
    <button class="close-btn" id="closeSidebar"><i class="fas fa-times"></i></button>
    <% navConfig.forEach(item => { %>
      <a href="<%= item.href %>"><i class="fas <%= item.icon || 'fa-link' %>"></i> <%= item.label %></a>
      <% (item.children || []).forEach(c => { %>
        <a href="<%= c.href %>" style="padding-left:34px;font-size:14px;"><i class="fas <%= c.icon || 'fa-angle-right' %>"></i> <%= c.label %></a>
      <% }) %>
    <% }) %>
    <a href="/dashboard"><i class="fas fa-stream"></i> ইউজার ফিড</a>
    <a href="/qa"><i class="fas fa-question-circle"></i> প্রশ্নোত্তর</a>
    <a href="/events"><i class="fas fa-calendar-alt"></i> ইভেন্ট</a>
    <a href="/notices"><i class="fas fa-bullhorn"></i> বিজ্ঞপ্তি</a>
    <a href="/activities"><i class="fas fa-calendar-check"></i> কার্যক্রম</a>
    <a href="/epaper"><i class="fas fa-newspaper"></i> আজকের ই-পেপার</a>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="mobile-cta primary"><i class="fas fa-globe-asia"></i> ফিডে যান</a>
    <% } else { %>
      <a href="/login" class="mobile-cta"><i class="fas fa-sign-in-alt"></i> লগইন</a>
      <a href="/register" class="mobile-cta primary"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন</a>
    <% } %>
  </aside>

  <!-- Page content -->
  <main class="page-main">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="btclf-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <h2 style="font-size:17px; font-weight:700; color:#fff; margin:0 0 6px;">বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়</h2>
        <p>বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয় শাখা, একটি শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। মূলমন্ত্র: তারুণ্যের শাণিত কলমে আলোকিত ধরনী।</p>
        <div class="f-socials">
          <a href="<%= getSetting ? (getSetting('facebook_url') || '#') : '#' %>" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="<%= getSetting ? (getSetting('telegram_url') || '#') : '#' %>" aria-label="Telegram"><i class="fab fa-telegram-plane"></i></a>
          <a href="<%= getSetting ? (getSetting('youtube_url') || '#') : '#' %>" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        </div>
      </div>
      <div>
        <h4 class="f-widget-title">প্রয়োজনীয় লিংক</h4>
        <ul class="f-links">
          <li><a href="/about"><i class="fas fa-circle"></i> আমাদের সম্পর্কে</a></li>
          <li><a href="/committee"><i class="fas fa-circle"></i> কমিটি সদস্য</a></li>
          <li><a href="/notices"><i class="fas fa-circle"></i> বিজ্ঞপ্তি</a></li>
          <li><a href="/events"><i class="fas fa-circle"></i> ইভেন্ট</a></li>
          <li><a href="/gallery"><i class="fas fa-circle"></i> গ্যালারি</a></li>
          <li><a href="/resources"><i class="fas fa-circle"></i> রিসোর্স</a></li>
        </ul>
      </div>
      <div>
        <h4 class="f-widget-title">যোগাযোগ</h4>
        <ul class="f-contact">
          <li><i class="fas fa-map-marker-alt"></i> <span>চট্টগ্রাম বিশ্ববিদ্যালয়, চট্টগ্রাম</span></li>
          <li><i class="fas fa-envelope"></i> <span>info@lekhokforum.org</span></li>
          <li><i class="fas fa-phone-alt"></i> <span>০১********* (বিকাশ/নগদ)</span></li>
        </ul>
      </div>
      <div class="f-newsletter">
        <h4 class="f-widget-title">নিউজলেটার</h4>
        <p class="f-newsletter-desc">নতুন লেখা প্রকাশের খবর সরাসরি ইমেইলে পেতে সাবস্ক্রাইব করুন।</p>
        <form class="newsletter-form" id="newsletterForm" action="/api/newsletter/subscribe" method="post">
          <input type="email" name="email" id="newsletterEmail" placeholder="আপনার ইমেইল" required>
          <button type="submit">সাবস্ক্রাইব</button>
        </form>
        <p class="f-newsletter-msg" id="newsletterMsg" role="status" aria-live="polite"></p>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>© ২০২৬ বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়</p>
        <p class="footer-credit">ডিজাইন ও উন্নয়নে: <a href="https://rafsandaily.blogspot.com/p/blog-page_5.html" target="_blank" rel="noopener" title="প্রতিষ্ঠাতা ও সাধারণ সম্পাদক, বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়">মোঃ রাফছান</a></p>
      </div>
    </div>
  </footer>

  <script src="/assets/js/main.js?v=<%= AV %>"></script>

  <!-- Back-to-top button -->
  <button class="back-to-top" id="backToTop" aria-label="উপরে ফিরে যান">
    <i class="fas fa-arrow-up"></i>
  </button>

<%# Global-search JS সরানো হয়েছে main.js-এ (session33): ডুপ্লিকেট রোধে এখানে আর inline কপি নেই। %>
</body>
</html>
