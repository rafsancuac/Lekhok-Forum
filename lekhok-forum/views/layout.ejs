<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়</title>
  <meta name="description" content="বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয় — একটি শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। মূলমন্ত্র: তারুণ্যের শাণিত কলমে আলোকিত ধরনী।" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230a1f44'/><text x='50' y='72' font-size='70' text-anchor='middle' fill='%23059669' font-family='serif' font-weight='bold'>ল</text></svg>" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/feed.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/dashboard.css?v=<%= AV %>" />
</head>
<body class="<%= currentPath === '/' ? 'home-page' : '' %>">
  <!-- Scroll progress bar -->
  <div class="scroll-progress" id="scrollProgress"></div>

  <!-- Topbar (public) -->
  <div class="btclf-topbar topbar" id="mainHeader">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <div class="logo-wrap">
          <span class="logo-text logo-text-v2"><strong>বাংলাদেশ তরুণ কলাম লেখক ফোরাম</strong><strong class="brand-line2">চট্টগ্রাম বিশ্ববিদ্যালয়</strong></span>
        </div>
      </a>
      <nav class="topbar-tabs">
        <a href="/" class="topbar-tab <%= currentPath === '/' ? 'active' : '' %>"><i class="fas fa-home"></i> হোম</a>
        <div class="topbar-dropdown">
          <a href="/about" class="topbar-tab <%= currentPath === '/about' || currentPath === '/constitution' ? 'active' : '' %>"><i class="fas fa-info-circle"></i> পরিচিতি <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
          <div class="topbar-dropdown-menu">
            <a href="/about"><i class="fas fa-info-circle"></i> সংগঠন পরিচিতি</a>
            <a href="/about#activities"><i class="fas fa-tasks"></i> আমাদের কার্যাক্রম</a>
            <a href="/about#magazine"><i class="fas fa-book"></i> পত্রিকায় পাতায় লেখক ফোরাম</a>
            <a href="/constitution"><i class="fas fa-scroll"></i> গঠনতন্ত্র</a>
            <a href="/about#soldier"><i class="fas fa-fighter-jet"></i> কলম সৈনিক হতে চান?</a>
            <a href="/about#conditions"><i class="fas fa-clipboard-list"></i> সদস্য হওয়ার শর্তাবলি</a>
          </div>
        </div>
        <div class="topbar-dropdown">
          <a href="/committee" class="topbar-tab <%= currentPath === '/committee' || currentPath === '/members' || currentPath === '/committee/past' ? 'active' : '' %>"><i class="fas fa-users-cog"></i> কার্যনির্বাহী পরিষদ <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
          <div class="topbar-dropdown-menu">
            <a href="/committee#advisory"><i class="fas fa-user-tie"></i> উপদেষ্টাদের তালিকা</a>
            <a href="/committee"><i class="fas fa-users-cog"></i> রানিং কমিটি</a>
            <a href="/members"><i class="fas fa-users"></i> সদস্য পরিচিতি</a>
          </div>
        </div>
        <div class="topbar-dropdown">
          <a href="/articles" class="topbar-tab <%= currentPath === '/articles' ? 'active' : '' %>"><i class="fas fa-pen-nib"></i> প্রকাশিত লেখা <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
          <div class="topbar-dropdown-menu">
            <a href="/articles?filter=column"><i class="fas fa-pen-nib"></i> প্রকাশিত কলাম</a>
            <a href="/articles?filter=letter"><i class="fas fa-envelope"></i> প্রকাশিত চিঠি</a>
          </div>
        </div>
        <a href="/gallery" class="topbar-tab <%= currentPath === '/gallery' ? 'active' : '' %>"><i class="fas fa-images"></i> গ্যালারি</a>
        <a href="/resources" class="topbar-tab <%= currentPath === '/resources' ? 'active' : '' %>"><i class="fas fa-folder-open"></i> রিসোর্স</a>
        <a href="/contact" class="topbar-tab <%= currentPath === '/contact' ? 'active' : '' %>"><i class="fas fa-envelope"></i> যোগাযোগ</a>
      </nav>
      <div class="topbar-right">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="topbar-nav a btn-ghost"><i class="fas fa-sign-in-alt"></i> ফিডে যান</a>
        <% } else { %>
          <a href="/login" class="topbar-nav a nav-login"><i class="fas fa-sign-in-alt"></i> লগইন</a>
          <a href="/register" class="topbar-nav a nav-register"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন</a>
        <% } %>
        <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
      </div>
    </div>
  </div>

  <!-- Mobile sidebar (public) -->
  <div class="mobile-overlay" id="mobileOverlay" onclick="closeMenu()"></div>
  <aside class="mobile-sidebar" id="mobileSidebar">
    <button class="close-btn" id="closeSidebar"><i class="fas fa-times"></i></button>
    <a href="/"><i class="fas fa-home"></i> হোম</a>
    <a href="/about"><i class="fas fa-info-circle"></i> সংগঠন পরিচিতি</a>
    <a href="/constitution"><i class="fas fa-scroll"></i> গঠনতন্ত্র</a>
    <a href="/committee"><i class="fas fa-users-cog"></i> রানিং কমিটি</a>
    <a href="/committee#advisory"><i class="fas fa-user-tie"></i> উপদেষ্টাদের তালিকা</a>
    <a href="/members"><i class="fas fa-users"></i> সদস্য পরিচিতি</a>
    <a href="/articles"><i class="fas fa-pen-nib"></i> প্রকাশিত লেখা</a>
    <a href="/gallery"><i class="fas fa-images"></i> গ্যালারি</a>
    <a href="/resources"><i class="fas fa-folder-open"></i> রিসোর্স</a>
    <a href="/contact"><i class="fas fa-envelope"></i> যোগাযোগ</a>
    <a href="/dashboard"><i class="fas fa-stream"></i> ইউজার ফিড</a>
    <a href="/qa"><i class="fas fa-question-circle"></i> প্রশ্নোত্তর</a>
    <a href="/events"><i class="fas fa-calendar-alt"></i> ইভেন্ট</a>
    <a href="/notices"><i class="fas fa-bullhorn"></i> বিজ্ঞপ্তি</a>
    <a href="/activities"><i class="fas fa-calendar-check"></i> কার্যক্রম</a>
    <a href="/epaper"><i class="fas fa-newspaper"></i> আজকের ই-পেপার</a>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="mobile-cta primary"><i class="fas fa-globe-asia"></i> ফিডে যান</a>
    <% } else { %>
      <a href="/login" class="mobile-cta"><i class="fas fa-sign-in-alt"></i> লগইন</a>
      <a href="/register" class="mobile-cta primary"><i class="fas fa-user-plus"></i> রেজিস্ট্রেশন</a>
    <% } %>
  </aside>

  <!-- Page content -->
  <main class="page-main">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="btclf-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="logo-wrap">
          <span class="logo-text logo-text-v2"><strong>বাংলাদেশ তরুণ কলাম লেখক ফোরাম</strong><strong class="brand-line2">চট্টগ্রাম বিশ্ববিদ্যালয়</strong></span>
        </div>
        <p>বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয় শাখা — একটি শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। মূলমন্ত্র: তারুণ্যের শাণিত কলমে আলোকিত ধরনী।</p>
        <div class="f-socials">
          <a href="<%= getSetting ? (getSetting('facebook_url') || '#') : '#' %>" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="<%= getSetting ? (getSetting('telegram_url') || '#') : '#' %>" aria-label="Telegram"><i class="fab fa-telegram-plane"></i></a>
          <a href="<%= getSetting ? (getSetting('youtube_url') || '#') : '#' %>" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        </div>
      </div>
      <div>
        <h4 class="f-widget-title">প্রয়োজনীয় লিংক</h4>
        <ul class="f-links">
          <li><a href="/about"><i class="fas fa-circle"></i> আমাদের সম্পর্কে</a></li>
          <li><a href="/committee"><i class="fas fa-circle"></i> কমিটি সদস্য</a></li>
          <li><a href="/notices"><i class="fas fa-circle"></i> বিজ্ঞপ্তি</a></li>
          <li><a href="/events"><i class="fas fa-circle"></i> ইভেন্ট</a></li>
          <li><a href="/gallery"><i class="fas fa-circle"></i> গ্যালারি</a></li>
          <li><a href="/resources"><i class="fas fa-circle"></i> রিসোর্স</a></li>
        </ul>
      </div>
      <div>
        <h4 class="f-widget-title">যোগাযোগ</h4>
        <ul class="f-contact">
          <li><i class="fas fa-map-marker-alt"></i> <span>চট্টগ্রাম বিশ্ববিদ্যালয়, চট্টগ্রাম</span></li>
          <li><i class="fas fa-envelope"></i> <span>info@lekhokforum.org</span></li>
          <li><i class="fas fa-phone-alt"></i> <span>০১৭৯১১৮৭১৬৪ (বিকাশ/নগদ - পার্সোনাল)</span></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container"><p>© ২০২৬ বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়</p></div>
    </div>
  </footer>

  <script src="/assets/js/main.js?v=<%= AV %>"></script>

  <!-- Back-to-top button -->
  <button class="back-to-top" id="backToTop" aria-label="উপরে ফিরে যান">
    <i class="fas fa-arrow-up"></i>
  </button>
</body>
</html>
