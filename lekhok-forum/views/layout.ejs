<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="MwDt57-lqUDC5XAeiiYy0BH11xb5mPRzcyp7A4aibCg" />
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
  <%
    // ── SEO locals (guarded — every var optional) ──────────────────────────
    var BRAND_FULL = 'লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়';
    // সেশন ৪৯: পেজের SEO meta title/description (server.js-এ path→page ম্যাপিং)
    var _pageSeoTitle = (typeof locals.seoTitle !== 'undefined' && locals.seoTitle) ? locals.seoTitle : '';
    var _pageSeoDesc  = (typeof locals.seoDesc  !== 'undefined' && locals.seoDesc)  ? locals.seoDesc  : '';
    // সেশন ৪৯: পেজের meta title থাকলে (exact path ম্যাচ) সেটিই <title>/og:title;
    // নাহলে pageTitle (ডিটেইল/সার্চ পেজ) বা ব্র্যান্ড ফলব্যাক।
    var seoTitle = _pageSeoTitle || (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : BRAND_FULL);
    var seoDesc = (typeof metaDesc !== 'undefined' && metaDesc)
      ? metaDesc
      : (_pageSeoDesc || BRAND_FULL + ', একটি শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। মূলমন্ত্র: তারুণ্যের শাণিত কলমে আলোকিত ধরনী।');
    var seoType = (typeof ogType !== 'undefined' && ogType) ? ogType : 'website';
    // সেশন ৭২ (GSC-ফিক্স): ডিফল্ট OG-ইমেজ — আগে ইমেজহীন শেয়ার-কার্ড যেত
    var seoImg = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : ((typeof siteUrl !== 'undefined' ? siteUrl : '') + '/assets/img/og-default.png');
    var seoPub = (typeof publishedTime !== 'undefined') ? publishedTime : null;
    var seoAuth = (typeof authorName !== 'undefined') ? authorName : null;
    var seoUrl = (typeof siteUrl !== 'undefined' ? siteUrl : '') + ((typeof canonicalPath !== 'undefined' && canonicalPath) ? canonicalPath : (typeof currentPath !== 'undefined' ? currentPath : '/'));
  %>
  <title><%= _pageSeoTitle ? _pageSeoTitle : (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' | ' + BRAND_FULL : BRAND_FULL) %></title>
  <meta name="description" content="<%= seoDesc %>" />
  <link rel="canonical" href="<%= seoUrl %>" />
  <meta property="og:site_name" content="<%= BRAND_FULL %>" />
  <meta property="og:type" content="<%= seoType %>" />
  <meta property="og:title" content="<%= seoTitle %>" />
  <meta property="og:description" content="<%= seoDesc %>" />
  <meta property="og:url" content="<%= seoUrl %>" />
  <meta property="og:locale" content="bn_BD" />
  <% if (seoImg) { %>
  <meta property="og:image" content="<%= seoImg %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="<%= seoImg %>" />
  <% } else { %>
  <meta name="twitter:card" content="summary" />
  <% } %>
  <meta name="twitter:title" content="<%= seoTitle %>" />
  <meta name="twitter:description" content="<%= seoDesc %>" />
  <% if (seoType === 'article') { %>
    <% if (seoPub) { %><meta property="article:published_time" content="<%= seoPub %>" /><% } %>
    <% if (seoAuth) { %><meta property="article:author" content="<%= seoAuth %>" /><% } %>
  <% } %>
  <%# সেশন ৭২ (GSC-ফিক্স): সাইট-ওয়াইড JSON-LD — Organization + WebSite/SearchAction %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%= siteUrl %>/#organization",
        "name": "<%= siteName %>",
        "url": "<%= siteUrl %>/",
        "logo": "<%= siteUrl %>/assets/img/og-default.png",
        "description": "<%= seoDesc %>"
      },
      {
        "@type": "WebSite",
        "@id": "<%= siteUrl %>/#website",
        "url": "<%= siteUrl %>/",
        "name": "<%= siteName %>",
        "inLanguage": "bn",
        "publisher": { "@id": "<%= siteUrl %>/#organization" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "<%= siteUrl %>/search?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>
  <link rel="alternate" type="application/rss+xml" title="লেখক ফোরাম — সাম্প্রতিক লেখা" href="/rss.xml" />
  <%# সেশন ৮৭: favicon.ico (আসল ফাইল — ব্রাউজার/ক্রলারের ডিফল্ট রিকোয়েস্ট আগে 404 খেত) + PWA ম্যানিফেস্ট + থিম-কালার %>
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/assets/img/icon-192.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#065F46" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230a1f44'/><text x='50' y='72' font-size='70' text-anchor='middle' fill='%23059669' font-family='serif' font-weight='bold'>ল</text></svg>" />
  <%# সেশন ৭২: preconnect ডোমেইন-ফিক্স — আসল CSS-উৎস cdnjs (আগে ভুলে jsdelivr ছিল) %>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css?v=<%= AV %><%= XTPQ %>" />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %><%= XTPQ %>" />
  <link rel="stylesheet" href="/assets/css/feed.css?v=<%= AV %><%= XTPQ %>" />
  <link rel="stylesheet" href="/assets/css/dashboard.css?v=<%= AV %><%= XTPQ %>" />
  <%# সেশন ৫৮: প্রিমিয়াম-রেস্পন্সিভ-অ্যানিমেটেড পলিশ-লেয়ার (additive) -%>
  <link rel="stylesheet" href="/assets/css/premium.css?v=<%= AV %><%= XTPQ %>" />
  <%# সেশন ১৩০ (রোডম্যাপ-① পূর্ণরূপ): পাবলিক-পেজ কল-রিংগার — লগড-ইন ইউজার পাবলিক
      পেজে (হোম/আর্টিকেলস/নোটিশ/ইভেন্ট/চিত্রশালা/রিসোর্স/সম্পর্কিত) থাকলেও আসন্ন-কল
      মোডাল দেখবেন। কল-UI-র স্টাইল calls.css — শুধু লগড-ইনে লোড (গেস্ট-ওজন-শূন্য)। %>
  <% if (typeof user !== 'undefined' && user) { %>
  <link rel="stylesheet" href="/assets/css/calls.css?v=<%= AV %><%= XTPQ %>" />
  <% } %>
  <%# সেশন ৯৭: চিত্রশালা (/gallery) — গ্যালারি-এক্সক্লুসিভ স্টাইল (হিরো/মেসনারি/অ্যালবাম/লাইটবক্স) %>
  <% if (currentPath === '/gallery') { %>
  <link rel="stylesheet" href="/assets/css/gallery.css?v=<%= AV %><%= XTPQ %>" />
  <% } %>
  <%# ── সেশন ১০৫: গ্লোবাল ডিজাইন-সিস্টেম (Single Source of Truth) — পাবলিক-লেআউট টুইন।
      tokens.css সর্বশেষ লোড (ক্যাসকেদ-গ্যারান্টি); ক্রম বদলানো নিষিদ্ধ (guard)। %>
  <link rel="stylesheet" href="/assets/css/shared.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" />
  <%# সেশন ১৪৭: বাংলা-সংখ্যা চুক্তি — ক্লায়েন্ট-মিরর (single-source helpers/bn-number.js)।
      সব স্ক্রিপ্টের আগে ডেফাইন — main.js-রিঅ্যাকশন-ইঞ্জিন (.rs-count) ও comment-tools.js
      (bnNum) এর উপর ডেলিগেট করে; ফিড/প্রোফাইল/একক-পোস্ট সব সারফেসে কাউন্টার বাংলায় লক।
      নেটওয়ার্ক-কস্ট-শূন্য ইনলাইন-কপি (bn-date-র ৩-কপি-চুক্তির রীতি)। %>
  <script>
  window.toBnNumber = function (num) {
    if (num === undefined || num === null || num === '') return '০';
    var s = String(num);
    if (s.trim() === '' || s.trim() === 'NaN') return '০';
    return s.replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; });
  };
  </script>
  <%# সেশন ৯০ (রোডম্যাপ-আইটেম ২০): PWA সার্ভিস-ওয়ার্কার — অফলাইন-শেল রেজিস্ট্রেশন।
      স্যান্ডবক্স-গেটওয়ে-সচেতন: পেজ-URL-এ XTransformPort থাকলে sw.js-ও সেই-কুয়েরি নিয়ে
      রেজিস্টার হয় যাতে গেটওয়ে সঠিক-পোর্টে ফরওয়ার্ড করে। ব্যর্থতা নীরব (SW-নন-সাপোর্ট/iframe)। %>
  <script>
  (function () {
    if (!('serviceWorker' in navigator)) return;
    try {
      var m = /(?:[?&])XTransformPort=(\d+)/.exec(location.search);
      var swUrl = '/sw.js' + (m ? '?XTransformPort=' + m[1] : '');
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function () { navigator.serviceWorker.register(swUrl).catch(function () {}); }, { timeout: 4000 });
      } else {
        setTimeout(function () { navigator.serviceWorker.register(swUrl).catch(function () {}); }, 2500);
      }
    } catch (e) { /* নীরব */ }
  })();
  </script>
  <%# সেশন ১০৭: স্যান্ডবক্স-প্রিভিউ লিংক-পোর্ট-সংরক্ষণ — গেটওয়েতে (XTransformPort-কুয়েরিসহ)
      খোলা পেজের সব অভ্যন্তরীণ <a href>-ক্লিকে পোর্ট-প্যারাম অটো-যোগ (ক্যাপচার-ফেজ)।
      এতে query-only হ্রেফ (?category=…, ?series=…) ও পাথ-হ্রেফ (/notices) প্রিভিউতে
      Next.js-ডিফল্ট-পোর্টে না গিয়ে সঠিক অ্যাপেই থাকে। লাইভ/প্রোডাকশনে পেজ-URL-এ
      XTransformPort নেই → সম্পূর্ণ নো-অপ। বাহ্যিক/#/mailto/tel/javascript স্পর্শ-ই হয় না। %>
  <script>
  (function () {
    var m = /(?:[?&])XTransformPort=(\d+)/.exec(location.search);
    if (!m) return;
    var qp = 'XTransformPort=' + m[1];
    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (!href || href.indexOf('XTransformPort=') !== -1) return;
      if (!/^\/(?!\/)/.test(href) && href.charAt(0) !== '?') return; // শুধু সেইম-অ্যাপ পাথ/কোয়েরি
      a.setAttribute('href', href + (href.indexOf('?') > -1 ? '&' : '?') + qp);
    }, true);
  })();
  </script>

  <%# সেশন ১১৬: গেটওয়ে-সচেতন fetch-প্যাচ — প্রিভিউতে পেজ ?XTransformPort=3030 দিয়ে
      খুললেও JS-এর fetch('/api/…') কলে প্যারাম থাকে না → গেটওয়ে ডিফল্ট-অ্যাপে ফেলে
      404-HTML দেয় → JSON-পার্স-ব্যর্থ (বাল্ক-ইমপোর্ট/ডিলিট-সহ সব fetch-API আক্রান্ত ছিল)।
      window.fetch একবারই মোড়া হয়: relative-path URL-এ প্যারাম জুড়ে দেয়; অ্যাবসোলিউট/
      ক্রস-অরিজিন/প্যারাম-যুক্ত URL অক্ষত। প্রোডাকশনে (প্যারাম নেই) নো-অপ। %>
  <script>
  (function () {
    var m = /(?:[?&])XTransformPort=(\d+)/.exec(location.search);
    if (!m || window.__xtpFetchPatched) return;
    window.__xtpFetchPatched = true;
    var qp = 'XTransformPort=' + m[1];
    var _fetch = window.fetch ? window.fetch.bind(window) : null;
    if (!_fetch) return;
    window.fetch = function (input, init) {
      try {
        var url = (input && typeof input === 'object' && input.url) ? input.url : String(input || '');
        if (url.charAt(0) === '/' && url.indexOf('XTransformPort=') === -1) {
          input = url + (url.indexOf('?') > -1 ? '&' : '?') + qp;
        }
      } catch (e) {}
      return _fetch(input, init);
    };
  })();
  </script>
  <%# সেশন ১১৬: স্যান্ডবক্স-সাবরিসোর্স img-এরর-রিট্রাই — কোল্ড-স্টার্টে (SW-নিবন্ধনের
      আগে) ডাইনামিক কনটেন্ট-ইমেজ (/uploads/…, /avatar/…) পোর্ট-প্যারাম-বিহীন হয়ে
      404 খায় (গেটওয়ে ডিফল্ট-অ্যাপে যায়)। ক্যাপচার-ফেজ error-ডেলিগেশনে একবার
      প্যারাম-সহ src দিয়ে রিট্রাই। প্রোডাকশনে (পেজে XTransformPort নেই) নো-অপ। %>
  <script>
  (function () {
    var m = /(?:[?&])XTransformPort=(\d+)/.exec(location.search);
    if (!m) return;
    var qp = 'XTransformPort=' + m[1];
    document.addEventListener('error', function (e) {
      var t = e.target;
      if (!t || t.tagName !== 'IMG' || t.dataset.xtpRetry) return;
      var src = t.getAttribute('src') || '';
      if (!src || src.indexOf('//') > -1 || src.indexOf('XTransformPort=') > -1) return;
      if (!/^\/(?!\/)/.test(src)) return; // শুধু same-origin পাথ
      t.dataset.xtpRetry = '1';
      t.setAttribute('src', src + (src.indexOf('?') > -1 ? '&' : '?') + qp);
    }, true);
  })();
  </script>
</head>
<body class="<%= currentPath === '/' ? 'home-page' : '' %>" data-auth="<%= (typeof user !== 'undefined' && user) ? '1' : '0' %>"<% if (typeof user !== 'undefined' && user) { %> data-uid="<%= user.id %>" data-avatar="<%= user.avatar_url || ('/avatar/' + user.id) %>" data-name="<%= (user.pen_name || user.full_name || '').replace(/"/g, '&quot;') %>" data-uname="<%= user.username %>"<% } %>>
  <%# সেশন ৭২: ক্যাশড-অ্যানোনিমাস পেজে লগড-ইন ইউজার ধরলে ?_u= রিফ্রেশ (ক্যাশ-বাইপাস) — বিস্তারিত auth-sync.js-এ %>
  <script src="/assets/js/auth-sync.js?v=<%= AV %><%= XTPQ %>"></script>
  <%# সেশন ৬৭: data-auth — পাবলিক-লেআউটেও main.js-এর লগইন-গার্ড নির্ভরযোগ্য (আগে .topbar-tabs a[href="/settings"] শুধু মেম্বার-হেডারে ছিল → /articles-এর সেভ-বাটনে লগইন-ইউজারও /login→/dashboard-এ বাউন্স করত) -%>
  <!-- Scroll progress bar -->
  <div class="scroll-progress" id="scrollProgress"></div>

  <%# সেশন ৭৭: রক্ষণাবেক্ষণ-মোডে স্টাফ-সতর্কবার্তা (দর্শকরা দেখছেন না) %>
  <% if (typeof maintenanceOn !== 'undefined' && maintenanceOn &&
        ((typeof adminUser !== 'undefined' && adminUser) ||
         (typeof user !== 'undefined' && user && /admin|moderator/.test(user.role || '')))) { %>
    <div class="maintenance-banner" role="alert">
      <i class="fas fa-triangle-exclamation"></i>
      <span>রক্ষণাবেক্ষণ-মোড চালু — সাধারণ দর্শকরা সাইটটি এখন দেখতে পাচ্ছেন না।</span>
      <% if (typeof adminUser !== 'undefined' && adminUser) { %>
        <a href="/admin/super">সুপার-এডমিন প্যানেলে বন্ধ করুন</a>
      <% } %>
    </div>
  <% } %>

  <!-- Topbar (public) -->
  <div class="btclf-topbar topbar" id="mainHeader">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <div class="logo-wrap">
          <span class="logo-text logo-text-v2"><strong>লেখক ফোরাম</strong><strong class="brand-line2">চট্টগ্রাম বিশ্ববিদ্যালয়</strong></span>
        </div>
      </a>
      <nav class="topbar-tabs">
        <% navConfig.forEach(item => { const _navActive = navItemActive(item, currentPath); %>
          <% if (item.children && item.children.length) { %>
            <div class="topbar-dropdown">
              <a href="<%= item.href %>" class="topbar-tab <%= _navActive ? 'active' : '' %>"><i class="fas <%= item.icon || 'fa-angle-down' %>"></i> <%= item.label %> <i class="fas fa-chevron-down" style="font-size:10px"></i></a>
              <div class="topbar-dropdown-menu">
                <% item.children.forEach(c => { %>
                  <a href="<%= c.href %>"><i class="fas <%= c.icon || 'fa-circle' %>"></i> <%= c.label %></a>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <a href="<%= item.href %>" class="topbar-tab <%= _navActive ? 'active' : '' %>"><i class="fas <%= item.icon || 'fa-link' %>"></i> <%= item.label %></a>
          <% } %>
        <% }) %>
      </nav>
      <!-- Global search -->
      <div class="global-search-wrap" id="globalSearchWrap">
        <button class="global-search-btn" onclick="toggleGlobalSearch()" aria-label="সার্চ" title="সার্চ (/)">
          <i class="fas fa-search"></i>
        </button>
        <div class="global-search-dropdown" id="globalSearchDropdown" hidden>
          <div class="gs-input-wrap">
            <i class="fas fa-search"></i>
