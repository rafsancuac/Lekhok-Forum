<%# ═══════════════════════════════════════════════════════════════════════
    লেখক ফোরাম — চিত্রশালা (সেশন ৯৭ পূর্ণ-রিরাইট)
    ─────────────────────────────────────────────────────────────────────
    • প্রিমিয়াম হিরো: ব্যাজ + শিরোনাম + স্ট্যাট-চিপ + ডুয়াল-ভিউ টগল
    • ডুয়াল ভিউ: মেসনারি "ছবিসমূহ" ↔ ফেসবুক-ধাঁচে "অ্যালবাম"
    • ক্যাটাগরি পিল-ফিল্টার (আইকন + কাউন্ট) + লাইভ সার্চ
    • মেসনারি কার্ড: হোভারে জুম + গ্রেডিয়েন্ট-ওভারলে (ক্যাটাগরি/শিরোনাম/
      তারিখ/ফটোগ্রাফার-ক্রেডিট) — event_date না থাকলে created_at বাংলা-ফরম্যাট
    • লাইটবক্স: কীবোর্ড (Esc/←/→) + টাচ-সোয়াইপ + জুম-টগল + ডাউনলোড +
      শেয়ার + মেটাডেটা-বার — বিস্তারিত public/assets/js/gallery.js
    • সেশন-৯৪-অডিট অনুসারী: পুরনো album-photo hidden-সিলেক্টর করাপশন এখানে
      রিরাইটের মাধ্যমে নির্মূল (album-extra-গুলো এখন hidden অ্যাট্রিবিউটে চলে)
    ═══════════════════════════════════════════════════════════════════ %>
<%
  const albumKeys = Object.keys(albums);
  const catIcons = {
    general: 'fas fa-layer-group',
    event: 'fas fa-calendar-alt', events: 'fas fa-calendar-alt',
    seminar: 'fas fa-microphone-alt', seminars: 'fas fa-microphone-alt',
    workshop: 'fas fa-chalkboard-teacher', workshops: 'fas fa-chalkboard-teacher',
    meeting: 'fas fa-users', meetings: 'fas fa-users',
    award: 'fas fa-trophy', awards: 'fas fa-trophy',
    press: 'far fa-newspaper', media: 'far fa-newspaper',
    cultural: 'fas fa-music', sports: 'fas fa-running',
    achievement: 'fas fa-medal', achievements: 'fas fa-medal',
    others: 'fas fa-folder'
  };
  // স্টাফ-সনাক্ত (সেশন-৯৭): সোশ্যাল-ইউজার (user.role) + অ্যাডমিন-প্যানেল সেশন (adminUser) দুটোই;
  // সেশন-৮৩ পোর্টাল-বিভাজনে স্টাফরা adminUser-সেশনে লগইন করেন (layout-মেইনটেন্যান্স-ব্যানার-প্যাটার্ন)
  const isStaff = (typeof adminUser !== 'undefined' && adminUser && /admin|moderator/i.test(adminUser.role || ''))
              || (typeof user !== 'undefined' && user && /admin|moderator/i.test(user.role || ''));
  const bn = (n) => String(n).replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[+d]);
%>

<!-- ══ ১. প্রিমিয়াম গ্যালারি হিরো ══ -->
<header class="gal-hero" id="galHero">
  <div class="gal-hero__glow gal-hero__glow--1" aria-hidden="true"></div>
  <div class="gal-hero__glow gal-hero__glow--2" aria-hidden="true"></div>
  <div class="container gal-hero__inner">
    <span class="gal-hero__badge"><i class="fas fa-images" aria-hidden="true"></i> ছবির মহাফেজখানা</span>
    <h1 class="gal-hero__title">
      <%= C('gallery_header_t1') %> <span class="gal-hero__accent"><%= C('gallery_header_accent') %></span>
    </h1>
    <p class="gal-hero__sub"><%= C('gallery_header_sub') %></p>

    <div class="gal-hero__stats" role="list">
      <span class="gal-stat" role="listitem"><i class="fas fa-image" aria-hidden="true"></i> <strong><%= bn(items.length) %></strong> ছবি</span>
      <span class="gal-stat" role="listitem"><i class="fas fa-folder-open" aria-hidden="true"></i> <strong><%= bn(albumKeys.length) %></strong> অ্যালবাম</span>
      <% if (recent.length) { %>
        <span class="gal-stat" role="listitem"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i> সর্বশেষ: <%= recent[0].displayDate || '' %></span>
      <% } %>
    </div>

    <div class="gal-hero__controls">
      <%# ডুয়াল-ভিউ টগল — সেশন ৯৭ (ছবিসমূহ ↔ অ্যালবাম) %>
      <div class="gal-viewtoggle" role="tablist" aria-label="গ্যালারি ভিউ মোড">
        <button type="button" class="gal-viewtoggle__btn is-active" id="viewPhotosBtn" role="tab" aria-selected="true" aria-controls="galPhotosView" data-view="photos">
          <i class="fas fa-table-cells-large" aria-hidden="true"></i> ছবিসমূহ
        </button>
        <button type="button" class="gal-viewtoggle__btn" id="viewAlbumsBtn" role="tab" aria-selected="false" aria-controls="galAlbumsView" data-view="albums">
          <i class="fas fa-folder-closed" aria-hidden="true"></i> অ্যালবাম
        </button>
      </div>
      <% if (isStaff) { %>
        <a href="/admin/gallery/new" class="gal-uploadbtn" title="এডমিন প্যানেলে নতুন ছবি যোগ করুন">
          <i class="fas fa-plus" aria-hidden="true"></i> নতুন ছবি আপলোড
        </a>
      <% } %>
    </div>
  </div>
</header>

<section class="section gal-section">
  <div class="container">

    <%# ── সাম্প্রতিক সংযোজন-স্ট্রিপ (সেশন ৭৬ থেকে সংরক্ষিত, নতুন স্টাইলিং) ── %>
    <% if (typeof recent !== 'undefined' && recent.length > 3) { %>
      <div class="gal-recent reveal">
        <div class="gal-recent__head">
          <h3><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> সাম্প্রতিক সংযোজন</h3>
          <span class="gal-recent__hint">সর্বশেষ যোগ হওয়া <%= bn(recent.length) %>টি ছবি</span>
        </div>
        <div class="gal-recent__strip" role="list">
          <% recent.forEach(g => { %>
            <a href="<%= g.image_url %>" class="gal-recent__photo" role="listitem"
               data-lightbox
               data-title="<%= g.caption || g.catLabel %>"
               data-caption="<%= g.caption || '' %>"
               data-catlabel="<%= g.catLabel %>"
               data-date="<%= g.displayDate || '' %>"
               data-photographer="<%= g.photographer || '' %>">
              <img loading="lazy" decoding="async" src="<%= g.image_url %>" alt="<%= g.caption || 'গ্যালারির ছবি' %>" />
              <% if (g.caption) { %>
                <span class="gal-recent__cap"><%= g.caption.length > 28 ? g.caption.slice(0, 28) + '…' : g.caption %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

    <% if (albumKeys.length) { %>

      <%# ── ২. ক্যাটাগরি পিল-ফিল্টার + লাইভ সার্চ ── %>
      <nav class="gal-filterbar reveal" aria-label="গ্যালারি ক্যাটাগরি ফিল্টার">
        <div class="gal-pills" id="galPills">
          <button type="button" class="gal-pill is-active" data-cat="all">
            <i class="fas fa-border-all" aria-hidden="true"></i> সব ছবি
            <span class="gal-pill__count"><%= bn(items.length) %></span>
          </button>
          <% albumKeys.forEach(cat => { %>
            <button type="button" class="gal-pill" data-cat="<%= cat %>">
              <i class="<%= catIcons[cat] || 'fas fa-folder' %>" aria-hidden="true"></i>
              <%= categoryLabels[cat] || cat %>
              <span class="gal-pill__count"><%= bn(albums[cat].length) %></span>
            </button>
          <% }) %>
        </div>
        <div class="gal-search">
          <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" id="galSearch" placeholder="ছবি, ক্যাপশন বা ফটোগ্রাফার খুঁজুন…" aria-label="গ্যালারিতে খুঁজুন" />
          <button type="button" class="gal-search__clear" id="galSearchClear" aria-label="সার্চ মুছুন" hidden><i class="fas fa-xmark"></i></button>
        </div>
      </nav>

      <%# ── ৩. মেসনারি ছবি-ভিউ (ডিফল্ট) ── %>
      <div id="galPhotosView" class="gal-photosview" role="tabpanel" aria-label="সব ছবি">
        <div class="gal-masonry" id="galMasonry">
          <% items.forEach(g => { %>
            <figure class="gal-card" data-cat="<%= g.category || 'general' %>"
                    data-search="<%= ((g.title || '') + ' ' + (g.caption || '') + ' ' + (g.catLabel || '') + ' ' + (g.photographer || '')).toLowerCase().replace(/"/g, '&quot;') %>">
              <a href="<%= g.image_url %>" class="gal-card__link"
                 data-lightbox
                 data-title="<%= g.caption || g.catLabel %>"
                 data-caption="<%= g.caption || '' %>"
                 data-catlabel="<%= g.catLabel %>"
                 data-date="<%= g.displayDate || '' %>"
                 data-photographer="<%= g.photographer || '' %>"
                 aria-label="<%= g.caption || g.catLabel %> — বড় করে দেখুন">
                <img loading="lazy" decoding="async" src="<%= g.image_url %>" alt="<%= g.caption || g.catLabel || 'গ্যালারির ছবি' %>" />
                <span class="gal-card__quickview" aria-hidden="true"><i class="fas fa-magnifying-glass-plus"></i></span>
                <figcaption class="gal-card__overlay">
                  <span class="gal-card__cat"><%= g.catLabel %></span>
                  <% if (g.caption) { %><span class="gal-card__title"><%= g.caption.length > 64 ? g.caption.slice(0, 64) + '…' : g.caption %></span><% } %>
                  <span class="gal-card__meta">
                    <% if (g.displayDate) { %><span><i class="far fa-calendar" aria-hidden="true"></i> <%= g.displayDate %></span><% } %>
                    <% if (g.photographer) { %><span><i class="fas fa-camera-retro" aria-hidden="true"></i> <%= g.photographer %></span><% } %>
                  </span>
                </figcaption>
              </a>
            </figure>
          <% }); %>
        </div>
        <%# ফিল্টার/সার্চের ফাঁকা অবস্থা %>
        <div class="gal-empty" id="galEmpty" hidden>
          <i class="fas fa-camera-retro" aria-hidden="true"></i>
          <p class="gal-empty__title">এই বিভাগে কোনো ছবি পাওয়া যায়নি।</p>
          <p class="gal-empty__sub">অন্য ক্যাটাগরি বেছে নিন বা সার্চ-শব্দ বদলান।</p>
          <button type="button" class="gal-empty__reset" id="galReset"><i class="fas fa-rotate-left"></i> সব ছবি দেখুন</button>
        </div>
      </div>

      <%# ── ৪. অ্যালবাম ভিউ (ফেসবুক-ধাঁচে কালেকশন) ── %>
      <div id="galAlbumsView" class="gal-albumsview" role="tabpanel" aria-label="অ্যালবাম সমূহ" hidden>
        <div class="gal-albumgrid">
          <% albumKeys.forEach(cat => { const list = albums[cat]; const cover = list[0]; const previews = list.slice(1, 5); %>
            <article class="gal-album" data-cat="<%= cat %>">
              <button type="button" class="gal-album__open" data-goto-cat="<%= cat %>"
                      aria-label="<%= categoryLabels[cat] || cat %> অ্যালবামের ছবিগুলো দেখুন">
                <span class="gal-album__coverwrap">
                  <img loading="lazy" decoding="async" class="gal-album__cover" src="<%= cover.image_url %>" alt="<%= categoryLabels[cat] || cat %> অ্যালবামের প্রচ্ছদ" />
                  <span class="gal-album__stack" aria-hidden="true">
                    <% previews.forEach(p => { %><img loading="lazy" decoding="async" src="<%= p.image_url %>" alt="" /><% }) %>
                  </span>
                  <span class="gal-album__count"><%= bn(list.length) %> ছবি</span>
                  <span class="gal-album__peek" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                </span>
                <span class="gal-album__body">
                  <span class="gal-album__name"><i class="<%= catIcons[cat] || 'fas fa-folder' %>" aria-hidden="true"></i> <%= categoryLabels[cat] || cat %></span>
                  <span class="gal-album__meta">
                    <% if (cover.displayDate) { %><i class="far fa-calendar" aria-hidden="true"></i> <%= cover.displayDate %><% } %>
                    <span class="gal-album__dot">•</span> সর্বশেষ সংযোজন
                  </span>
                </span>
              </button>
            </article>
          <% }) %>
        </div>
      </div>

    <% } else { %>
      <%# কোনো ছবিই না থাকলে %>
      <div class="gal-empty gal-empty--page">
        <i class="fas fa-images" aria-hidden="true"></i>
        <p class="gal-empty__title">এখনো কোনো ছবি জমা হয়নি।</p>
        <p class="gal-empty__sub">আয়োজনের মুহূর্তগুলো শিগগিরই এখানে সাজানো হবে।</p>
      </div>
    <% } %>
  </div>
</section>

<!-- ══ ৫. ফুলস্ক্রিন লাইটবক্স (gallery.js নিয়ন্ত্রিত) ══ -->
<div class="gal-lb" id="lightbox" role="dialog" aria-modal="true" aria-label="ছবি ভিউয়ার" aria-hidden="true">
  <div class="gal-lb__top">
    <span class="gal-lb__counter" id="lbCounter">১ / ১</span>
    <div class="gal-lb__actions">
      <button type="button" class="gal-lb__act" id="lbZoom" title="জুম করুন (Z)" aria-label="জুম টগল"><i class="fas fa-magnifying-glass-plus"></i></button>
      <a class="gal-lb__act" id="lbDownload" href="#" download title="ছবি ডাউনলোড করুন" aria-label="ডাউনলোড"><i class="fas fa-download"></i></a>
      <button type="button" class="gal-lb__act" id="lbShare" title="শেয়ার করুন" aria-label="শেয়ার"><i class="fas fa-share-nodes"></i></button>
      <button type="button" class="gal-lb__act gal-lb__act--close" id="lightboxClose" title="বন্ধ করুন (Esc)" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
    </div>
  </div>

  <div class="gal-lb__stage">
    <button type="button" class="gal-lb__nav gal-lb__nav--prev" id="lbPrev" aria-label="আগের ছবি"><i class="fas fa-chevron-left"></i></button>
    <div class="gal-lb__framewrap">
      <div class="gal-lb__spinner" id="lbSpinner" aria-hidden="true"></div>
      <img id="lightboxImg" class="gal-lb__img" src="" alt="" draggable="false" />
    </div>
    <button type="button" class="gal-lb__nav gal-lb__nav--next" id="lbNext" aria-label="পরের ছবি"><i class="fas fa-chevron-right"></i></button>
  </div>

  <div class="gal-lb__infobar" id="popupMeta">
    <div class="gal-lb__info">
      <span class="gal-lb__cat" id="lbCat"></span>
      <span class="gal-lb__caption" id="lightboxCaption"></span>
      <span class="gal-lb__meta" id="lbMeta"></span>
    </div>
  </div>
</div>
