<!-- Gallery — Image Gallery with category filter -->
<header class="page-header">
  <div class="container">
    <span class="eyebrow"><i class="fas fa-images"></i> ছবির সংগ্রহ</span>
    <h1>ইমেজ <span style="color:var(--accent);">গ্যালারি</span></h1>
    <p class="header-sub">ইভেন্ট, সেমিনার, সাংস্কৃতিক কার্যক্রম — সব এক জায়গায়</p>
  </div>
</header>

<section class="section">
  <div class="container">
    <% const albumKeys = Object.keys(albums);
       const catIcons = {
         general: 'fas fa-layer-group',
         event: 'fas fa-calendar-alt', events: 'fas fa-calendar-alt',
         seminar: 'fas fa-microphone-alt', seminars: 'fas fa-microphone-alt',
         workshop: 'fas fa-chalkboard-teacher', workshops: 'fas fa-chalkboard-teacher',
         meeting: 'fas fa-users', meetings: 'fas fa-users',
         award: 'fas fa-trophy', awards: 'fas fa-trophy',
         press: 'far fa-newspaper', media: 'far fa-newspaper',
         cultural: 'fas fa-music', sports: 'fas fa-running',
         achievement: 'fas fa-medal', achievements: 'fas fa-medal',
         others: 'fas fa-folder'
       }; %>
    <% if (albumKeys.length) { %>

      <!-- Category filter — white bar, link-style items -->
      <nav class="gallery-tabs" id="galleryTabs" aria-label="গ্যালারি ক্যাটাগরি">
        <a href="#" class="gtab active" data-cat="all">
          <i class="fas fa-images"></i> সব ছবি
          <span class="gtab-count"><%= items.length %></span>
        </a>
        <% albumKeys.forEach(cat => { %>
          <a href="#" class="gtab" data-cat="<%= cat %>">
            <i class="<%= catIcons[cat] || 'fas fa-folder' %>"></i> <%= categoryLabels[cat] || cat %>
            <span class="gtab-count"><%= albums[cat].length %></span>
          </a>
        <% }) %>
      </nav>

      <% albumKeys.forEach(cat => { %>
        <% const items = albums[cat]; const count = items.length; %>
        <div class="gallery-album reveal" data-cat="<%= cat %>">
          <div class="album-header">
            <h2 class="album-title">
              <i class="<%= catIcons[cat] || 'fas fa-folder-open' %>"></i>
              <%= categoryLabels[cat] || cat %>
            </h2>
            <span class="album-count"><%= count %> <%= count === 1 ? 'ছবি' : 'ছবি' %></span>
          </div>

          <% if (count === 1) { %>
            <!-- Single photo: centered large view -->
            <div class="album-single">
              <a href="<%= items[0].image_url %>"
                 class="album-photo album-photo--single"
                 data-caption="<%= items[0].caption || '' %>"
                 data-lightbox="album-<%= cat %>">
                <img src="<%= items[0].image_url %>" alt="<%= items[0].caption || cat %>" loading="lazy" />
                <div class="album-photo-overlay"><i class="fas fa-search-plus"></i></div>
              </a>
              <% if (items[0].caption) { %>
                <p class="album-caption-text"><%= items[0].caption %></p>
              <% } %>
            </div>

          <% } else if (count <= 8) { %>
            <!-- Small album: uniform auto-fit grid (no empty cells) -->
            <div class="album-grid album-grid--small">
              <% items.forEach(g => { %>
                <a href="<%= g.image_url %>"
                   class="album-photo"
                   data-caption="<%= g.caption || '' %>"
                   data-lightbox="album-<%= cat %>">
                  <img src="<%= g.image_url %>" alt="<%= g.caption || cat %>" loading="lazy" />
                  <div class="album-photo-overlay"><i class="fas fa-search-plus"></i></div>
                </a>
              <% }) %>
            </div>

          <% } else { %>
            <!-- Featured album: first photo spans 2x2, dense packing -->
            <div class="album-grid album-grid--featured">
              <a href="<%= items[0].image_url %>"
                 class="album-photo album-photo--wide"
                 data-caption="<%= items[0].caption || '' %>"
                 data-lightbox="album-<%= cat %>">
                <img src="<%= items[0].image_url %>" alt="<%= items[0].caption || cat %>" loading="lazy" />
                <div class="album-photo-overlay"><i class="fas fa-search-plus"></i></div>
              </a>
              <% items.slice(1).forEach((g, i) => { %>
                <a href="<%= g.image_url %>"
                   class="album-photo<%= i >= 15 ? ' album-photo--extra' : '' %>"
                   <% if (i >= 15) { %>hidden<% } %>
                   data-caption="<%= g.caption || '' %>"
                   data-lightbox="album-<%= cat %>">
                  <img src="<%= g.image_url %>" alt="<%= g.caption || cat %>" loading="lazy" />
                  <div class="album-photo-overlay"><i class="fas fa-search-plus"></i></div>
                </a>
              <% }) %>
              <% if (count > 16) { %>
                <button type="button" class="album-more" title="সব ছবি দেখুন">
                  <span>+<%= count - 16 %></span>
                  <small>আরো দেখুন</small>
                </button>
              <% } %>
            </div>
          <% } %>

        </div>
      <% }) %>

    <% } else { %>
      <div class="empty-state">
        <i class="far fa-images"></i>
        <h3>এখনও কোনো ছবি যোগ হয়নি</h3>
        <p>অ্যাডমিন প্যানেল থেকে গ্যালারিতে ছবি আপলোড করুন</p>
        <a href="/admin/gallery" class="btn btn-primary"><i class="fas fa-plus"></i> ছবি যোগ করুন</a>
      </div>
    <% } %>
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="ছবি দেখুন">
  <button class="lightbox-close" id="lightboxClose" aria-label="বন্ধ করুন"><i class="fas fa-times"></i></button>
  <img id="lightboxImg" src="" alt="" />
  <div class="lightbox-caption" id="lightboxCaption"></div>
  <% if (albumKeys.length) { %>
  <div class="lightbox-nav">
    <button id="lbPrev" aria-label="আগের ছবি"><i class="fas fa-chevron-left"></i></button>
    <span id="lbCounter"></span>
    <button id="lbNext" aria-label="পরের ছবি"><i class="fas fa-chevron-right"></i></button>
  </div>
  <% } %>
</div>

<style>
/* ── Category filter bar (white, link-style) ── */
.gallery-tabs {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 0 26px;
  background: #fff;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: var(--radius, 10px);
  padding: 0 20px;
  margin-bottom: 30px;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
}
.gallery-tabs .gtab {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 14px 2px 12px;
  color: var(--text-muted, #64748b);
  text-decoration: none;
  font-size: 0.93rem;
  font-weight: 600;
  border-bottom: 2px solid transparent;
  transition: color 0.18s, border-color 0.18s;
}
.gallery-tabs .gtab i { font-size: 0.95em; opacity: 0.75; transition: opacity 0.18s; }
.gallery-tabs .gtab:hover { color: var(--accent, #059669); }
.gallery-tabs .gtab:hover i { opacity: 1; }
.gallery-tabs .gtab.active {
  color: var(--accent, #059669);
  border-bottom-color: var(--accent, #059669);
}
.gallery-tabs .gtab.active i { opacity: 1; }
.gallery-tabs .gtab-count {
  font-size: 0.76rem;
  font-weight: 700;
  color: #94a3b8;
  transition: color 0.18s;
}
.gallery-tabs .gtab:hover .gtab-count,
.gallery-tabs .gtab.active .gtab-count { color: inherit; }

@media (max-width: 640px) {
  .gallery-tabs {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0 14px;
    gap: 0 20px;
    scrollbar-width: none;
  }
  .gallery-tabs::-webkit-scrollbar { display: none; }
  .gallery-tabs .gtab { white-space: nowrap; padding: 12px 2px 10px; }
}

/* ── Album layout ── */
.gallery-album { margin-bottom: 40px; }
.gallery-album:last-child { margin-bottom: 0; }

.album-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
  border-bottom: 2px solid var(--border, #e2e8f0);
  padding-bottom: 10px;
}
.album-title {
  font-size: 1.1rem;
  color: var(--brand, #0a1f44);
  margin: 0;
  font-weight: 700;
}
.album-title i { color: var(--accent, #059669); margin-right: 8px; }
.album-count {
  background: rgba(5,150,105,0.1);
  color: var(--accent, #059669);
  padding: 3px 12px;
  border-radius: var(--radius-sm, 5px);
  font-size: 0.8rem;
  font-weight: 600;
}

/* Uniform grid — auto-fit collapses empty tracks, so few photos never leave holes */
.album-grid {
  display: grid;
  gap: 10px;
}
.album-grid--small {
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
}

/* Featured album: hero 2x2 + dense packing */
.album-grid--featured {
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  grid-auto-flow: dense;
}

/* Single photo: centered with capped max-width */
.album-single {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.album-photo--single {
  width: 100%;
  max-width: 360px;
  aspect-ratio: 4/3;
}

/* Shared photo styles */
.album-photo {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: var(--radius-sm, 5px);
  display: block;
  background: var(--bg, #f8fafc);
  max-height: 240px;
}
.album-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
}
.album-photo:hover img { transform: scale(1.05); }
.album-photo[hidden] { display: none; }

/* Featured wide: first photo spans 2x2 */
.album-photo--wide {
  grid-column: span 2;
  grid-row: span 2;
  aspect-ratio: auto;
  max-height: none;
}

.album-photo-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
  color: #fff;
  font-size: 1.3rem;
}
.album-photo:hover .album-photo-overlay { opacity: 1; }

.album-more {
  aspect-ratio: 1;
  max-height: 240px;
  background: var(--bg, #f8fafc);
  border: 2px dashed var(--border, #e2e8f0);
  border-radius: var(--radius-sm, 5px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted, #64748b);
  font-family: inherit;
  text-decoration: none;
  transition: all 0.2s;
  cursor: pointer;
}
.album-more:hover { border-color: var(--accent, #059669); color: var(--accent, #059669); }
.album-more span { font-size: 1.6rem; font-weight: 700; }
.album-more small { font-size: 0.78rem; }

.album-caption-text {
  color: var(--text-muted, #64748b);
  font-size: 0.85rem;
  text-align: center;
  max-width: 640px;
  margin: 0;
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .album-grid--featured { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 6px; }
  .album-photo--wide { grid-column: span 1; grid-row: span 1; aspect-ratio: 1; max-height: 180px; }
  .album-grid--small { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  .album-photo { max-height: 180px; }
}
@media (max-width: 480px) {
  .album-grid--featured { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 5px; }
  .album-grid--small { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); }
  .album-photo--single { max-width: 100%; max-height: 220px; }
  .album-photo { max-height: 150px; }
}
</style>

<script>
(function() {
  const lb = document.getElementById('lightbox');
  if (!lb) return;
  const lbImg = document.getElementById('lightboxImg');
  const lbCap = document.getElementById('lightboxCaption');
  const lbCounter = document.getElementById('lbCounter');
  const lbPrev = document.getElementById('lbPrev');
  const lbNext = document.getElementById('lbNext');

  let allPhotos = [];
  let currentIdx = 0;

  /* Category filter — link-style tabs, instant client-side switch */
  const tabs = document.querySelectorAll('#galleryTabs .gtab');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      tabs.forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      const cat = tab.dataset.cat;
      document.querySelectorAll('.gallery-album').forEach(function(sec) {
        sec.style.display = (cat === 'all' || sec.dataset.cat === cat) ? '' : 'none';
      });
    });
  });

  /* "আরো দেখুন" — reveal hidden extras in this album */
  document.querySelectorAll('.album-more').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const album = btn.closest('.gallery-album');
      if (album) album.querySelectorAll('.album-photo--extra').forEach(function(x) { x.hidden = false; });
      btn.remove();
    });
  });

  /* Lightbox — rebuilds photo list from currently visible photos only */
  function collectPhotos() {
    allPhotos = [];
    document.querySelectorAll('[data-lightbox]').forEach(function(a) {
      if (a.offsetParent === null) return; /* skip hidden (filtered-out album / unrevealed extras) */
      allPhotos.push({ src: a.href, caption: a.dataset.caption || '' });
    });
  }

  document.querySelectorAll('[data-lightbox]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      e.preventDefault();
      collectPhotos();
      const idx = allPhotos.findIndex(function(p) { return p.src === a.href; });
      currentIdx = idx >= 0 ? idx : 0;
      showPhoto(currentIdx);
      lb.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  });

  function showPhoto(idx) {
    const photo = allPhotos[idx];
    if (!photo) return;
    lbImg.src = photo.src;
    lbImg.alt = photo.caption;
    lbCap.textContent = photo.caption;
    if (lbCounter) lbCounter.textContent = (idx + 1) + ' / ' + allPhotos.length;
  }

  if (lbPrev) lbPrev.addEventListener('click', function() {
    currentIdx = (currentIdx - 1 + allPhotos.length) % allPhotos.length;
    showPhoto(currentIdx);
  });
  if (lbNext) lbNext.addEventListener('click', function() {
    currentIdx = (currentIdx + 1) % allPhotos.length;
    showPhoto(currentIdx);
  });

  document.getElementById('lightboxClose').addEventListener('click', closeLightbox);
  lb.addEventListener('click', function(e) { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', function(e) {
    if (!lb.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') { currentIdx = (currentIdx - 1 + allPhotos.length) % allPhotos.length; showPhoto(currentIdx); }
    if (e.key === 'ArrowRight') { currentIdx = (currentIdx + 1) % allPhotos.length; showPhoto(currentIdx); }
  });

  function closeLightbox() {
    lb.classList.remove('active');
    document.body.style.overflow = '';
    lbImg.src = '';
  }
})();
</script>
