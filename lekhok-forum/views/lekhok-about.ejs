<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('about_header_eyebrow') %></span>
    <h1><%= C('about_header_title') %></h1>
    <p><%= C('about_header_sub') %></p>
  </div>
</header>

<!-- Identity - heading left, goals right -->
<section class="section reveal" id="about">
  <div class="container">
    <div class="section-split" style="grid-template-columns:1fr 1fr;">
      <div class="split-left">
        <span class="eyebrow"><%= C('about_identity_eyebrow') %></span>
        <h2 class="section-title"><%= C('about_identity_t1') %> <span class="accent"><%= C('about_identity_accent') %></span></h2>
        <span class="accent-divider"></span>
        <p style="text-align:justify;">লেখক ফোরাম একটি শিক্ষামূলক, অলাভজনক এবং অরাজনৈতিক সংগঠন, যা তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটিয়ে দেশ ও জাতির সমৃদ্ধির লক্ষ্যে তাদেরকে যোগ্য ও সুনাগরিক হিসেবে গড়ে তোলে। চট্টগ্রাম বিশ্ববিদ্যালয়ে যারা পত্রিকায় লিখেন কিংবা লিখতে চান, তাদেরকে সঠিকভাবে লিখার পদ্ধতি, কালাকৌশল এবং সংশ্লিষ্ট বিষয়ে পরামর্শ দিতে লেখক ফোরাম, চবি শাখা দৃঢ়প্রত্যয়ী। সদস্যদের নিয়ে নিয়মিত কর্মশালা আয়োজন এবং লিখালিখির যাবতীয় সমস্যা সমাধানে অভিজ্ঞরা নিজ তত্ত্বাবধানে রেখে সদস্যদের দেখাশোনা করে থাকেন।</p>
        <div class="identity-chips">
          <div class="identity-chip">
            <span class="chip-label"><i class="fas fa-quote-left"></i> <%= C('about_motto_label') %></span>
            <span class="chip-text"><%= C('about_motto_text') %></span>
          </div>
          <div class="identity-chip">
            <span class="chip-label"><i class="fas fa-bullhorn"></i> <%= C('about_slogan_label') %></span>
            <span class="chip-text"><%= C('about_slogan_text') %></span>
          </div>
        </div>
        <a href="/committee" class="btn btn-primary" style="margin-top:18px;"><i class="fas fa-users-cog"></i> <%= C('about_committee_btn') %></a>
      </div>
      <div>
        <div class="card">
          <h3 style="margin-top:0;"><i class="fas fa-bullseye" style="color:var(--accent);"></i> লক্ষ্য ও উদ্দেশ্য</h3>
          <ul class="bullet-list goal-list">
            <li><strong>১.</strong> তরুণ সমাজকে লেখালেখিতে উদ্বুদ্ধ করে সৃষ্টিশীল গড়ে তুলতে সাহায্য করা।</li>
            <li><strong>২.</strong> মুক্তিযুদ্ধের আদর্শ লালন করে তরুণ সমাজকে দেশপ্রেমী নাগরিক হিসেবে গড়ে তোলা।</li>
            <li><strong>৩.</strong> সামাজিক, আর্থ-সামাজিক ও বৈশ্বিক সমস্যার গঠনমূলক সমালোচনা ও ইতিবাচক সমাধান লেখনীর মাধ্যমে তুলে ধরা এবং তরুণ লেখকদের একটি প্ল্যাটফর্মে একত্রিত করা।</li>
            <li><strong>৪.</strong> নিয়মিত পঠন অভ্যাস গড়ে তুলে তরুণ সমাজের মেধা ও মানসিক বিকাশ সাধন করা।</li>
            <li><strong>৫.</strong> তরুণদের সাংগঠনিক ও নেতৃত্ব গুণাবলি বিকাশে সহায়তা করা।</li>
            <li><strong>৬.</strong> দেশের স্বনামধন্য লেখকদের সাথে তরুণ লেখকদের সেতুবন্ধন তৈরি করা।</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Magazine / press clippings -->
<section class="section reveal" id="magazine">
  <div class="container">
    <div class="card" style="text-align:center; padding:32px;">
      <i class="fas fa-book" style="font-size:2.5rem; color:var(--accent); margin-bottom:12px;"></i>
      <h2 style="margin:0 0 8px;"><%= C('about_magazine_title') %></h2>
      <p style="max-width:1000px; margin:0 auto; color:var(--text-soft); line-height:1.85; text-align:justify; font-size:1.02rem;"><%= C('about_magazine_text') %></p>
    </div>
    <% if (pressClippings && pressClippings.length) { %>
      <%
        // সেশন ৪০: ডুয়াল-মার্কি স্লাইডার — উপরের সারি বাম→ডান, নিচের সারি ডান→বাম।
        // ৩টির কম থাকলে সাইকেল করে প্যাড করা হয় যাতে লুপ নিরবচ্ছিন্ন থাকে।
        const pad3 = (arr) => { const out = arr.slice(0, 3); let k = 0; while (out.length < 3 && arr.length) { out.push(arr[k % arr.length]); k++; } return out; };
        const rowA = pad3(pressClippings.slice(0, 3));
        const rowB = pad3(pressClippings.slice(3, 6).length ? pressClippings.slice(3, 6) : pressClippings.slice(1, 4));
        const slide = (c) => `
          <figure class="press-slide">
            <a href="${c.image_url}" target="_blank" rel="noopener" class="press-slide-img" tabindex="-1">
              <img src="${c.image_url}" alt="${String(c.title || 'পত্রিকায় আমাদের নিউজ').replace(/"/g, '&quot;')}" loading="lazy" decoding="async" onerror="this.onerror=null;this.style.opacity=.25;this.src='/assets/img/avatar-placeholder.svg'" />
            </a>
            ${(c.title || c.paper_name) ? `<figcaption>${c.title ? `<strong>${c.title}</strong>` : ''}${c.paper_name ? `<span><i class="far fa-newspaper"></i> ${c.paper_name}</span>` : ''}</figcaption>` : ''}
          </figure>`;
      %>
      <div class="press-mq" aria-label="পত্রিকার কাটিং — উপরের সারি (বাম থেকে ডানে)">
        <div class="press-track ltr"><%- rowA.concat(rowA).map(slide).join('') %></div>
      </div>
      <div class="press-mq" aria-label="পত্রিকার কাটিং — নিচের সারি (ডান থেকে বামে)">
        <div class="press-track rtl"><%- rowB.concat(rowB).map(slide).join('') %></div>
      </div>
      <div style="text-align:center; margin-top:22px;">
        <a href="/press" class="link-more">সব কাটিং দেখুন <i class="fas fa-arrow-right"></i></a>
      </div>
    <% } %>
  </div>
</section>

<!-- Activities - 8 items -->
<section class="section reveal" id="activities">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><%= C('about_act_eyebrow') %></span>
      <h2 class="section-title"><%= C('about_act_t1') %> <span class="accent"><%= C('about_act_accent') %></span></h2>
      <span class="accent-divider center"></span>
    </div>
    <div class="feature-grid reveal-stagger">
      <div class="feature"><i class="fas <%= C('about_act1_icon') %>"></i><h3><%= C('about_act1_title') %></h3><p><%= C('about_act1_text') %></p></div>
      <div class="feature"><i class="fas <%= C('about_act2_icon') %>"></i><h3><%= C('about_act2_title') %></h3><p><%= C('about_act2_text') %></p></div>
      <div class="feature"><i class="fas <%= C('about_act3_icon') %>"></i><h3><%= C('about_act3_title') %></h3><p><%= C('about_act3_text') %></p></div>
      <div class="feature"><i class="fas <%= C('about_act4_icon') %>"></i><h3><%= C('about_act4_title') %></h3><p><%= C('about_act4_text') %></p></div>
      <div class="feature"><i class="fas <%= C('about_act5_icon') %>"></i><h3><%= C('about_act5_title') %></h3><p><%= C('about_act5_text') %></p></div>
      <div class="feature"><i class="fas <%= C('about_act6_icon') %>"></i><h3><%= C('about_act6_title') %></h3><p><%= C('about_act6_text') %></p></div>
      <div class="feature"><i class="fas <%= C('about_act7_icon') %>"></i><h3><%= C('about_act7_title') %></h3><p><%= C('about_act7_text') %></p></div>
      <div class="feature"><i class="fas <%= C('about_act8_icon') %>"></i><h3><%= C('about_act8_title') %></h3><p><%= C('about_act8_text') %></p></div>
    </div>
  </div>
</section>

<!-- Membership drive CTA -->
<section class="cta-banner reveal" id="soldier">
  <% if (C('about_cta_bg')) { %><div class="cta-banner-img" style="background-image:url('<%= C('about_cta_bg') %>')"></div><% } %>
  <div class="container">
    <span class="eyebrow" style="background:rgba(5,150,105,0.18);border-color:rgba(5,150,105,0.32);"><%= C('about_cta_eyebrow') %></span>
    <h2><%= C('about_cta_t1') %> <span class="accent"><%= C('about_cta_accent') %></span> <%= C('about_cta_t2') %></h2>
    <span class="accent-divider center"></span>
    <p style="text-align:justify; line-height:1.9; max-width:1040px; margin:14px auto 0; font-size:1.02rem;"><%= C('about_cta_text') %></p>
    <div style="margin-top:26px;">
      <a href="/register" class="btn btn-primary" style="margin-right:10px;"><i class="fas fa-user-plus"></i> <%= C('about_cta_btn1') %></a>
      <a href="/contact" class="btn btn-outline"><i class="fas fa-envelope"></i> <%= C('about_cta_btn2') %></a>
    </div>
  </div>
</section>

<!-- Membership conditions - step cards -->
<section class="section reveal" id="conditions">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><%= C('about_cond_eyebrow') %></span>
      <h2 class="section-title"><%= C('about_cond_t1') %> <span class="accent"><%= C('about_cond_accent') %></span></h2>
      <span class="accent-divider center"></span>
    </div>
    <div class="join-steps">
      <% const bnNum = (n) => String(n).replace(/[0-9]/g, (d) => '০১২৩৪৫৬৭৮৯'[d]); %>
      <% condSteps.forEach((step, idx) => { %>
      <div class="join-step">
        <span class="step-num"><%= bnNum(idx + 1) %></span>
        <div>
          <h3><%= step.title %></h3>
          <p><%= step.body %></p>
          <% if (step.extra) { %>
          <p class="step-pay"><i class="fas fa-mobile-alt"></i> <strong><%= step.extra %></strong></p>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="section-head center" style="margin-top:40px;">
      <h2 class="section-title" style="font-size:1.55rem;"><i class="fas fa-scroll" style="color:var(--accent);"></i> <%= C('about_rules_title') %></h2>
      <span class="accent-divider center"></span>
    </div>
    <div class="card rules-card" style="margin-top:18px;">
      <ul class="bullet-list rules-list">
        <li><%= C('about_rule1') %></li>
        <li><%= C('about_rule2') %></li>
        <li><%= C('about_rule3') %></li>
        <li><%= C('about_rule4') %></li>
        <li><%= C('about_rule5') %></li>
        <li><%= C('about_rule6') %></li>
        <li><%= C('about_rule7') %></li>
        <li><%= C('about_rule8') %></li>
        <li><%= C('about_rule9') %></li>
        <li><%= C('about_rule10') %></li>
      </ul>
    </div>
    <div class="card notice-warning">
      <h3 style="margin-top:0;"><i class="fas fa-exclamation-triangle" style="color:#b45309;"></i> <%= C('about_warning_title') %></h3>
      <p style="margin-bottom:0;"><%= C('about_warning_text') %></p>
    </div>
  </div>
</section>

<style>
.identity-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 18px; }
.identity-chip { background: linear-gradient(135deg, #ecfdf5, #f0fdf4); border: 1px solid rgba(5,150,105,0.22); border-radius: 5px; padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; }
.identity-chip .chip-label { color: var(--accent, #059669); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; }
.identity-chip .chip-text { color: var(--brand, #0a1f44); font-size: 0.98rem; font-weight: 700; line-height: 1.55; }
.goal-list li { margin-bottom: 12px; line-height: 1.7; }
.goal-list li strong { color: var(--accent, #059669); margin-right: 4px; }
.cu-note { display: flex; gap: 18px; align-items: flex-start; }
.cu-note-icon { font-size: 1.9rem; color: var(--accent, #059669); margin-top: 4px; }
.join-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.join-step { background: #fff; border: 1px solid var(--border, #e2e8f0); border-radius: 5px; padding: 20px; display: flex; gap: 14px; box-shadow: 0 2px 10px rgba(10,31,68,0.04); }
.join-step .step-num { flex: 0 0 42px; width: 42px; height: 42px; border-radius: 50%; background: var(--brand, #0a1f44); color: #fff; font-weight: 700; font-size: 1.15rem; display: inline-flex; align-items: center; justify-content: center; }
.join-step h3 { margin: 4px 0 8px; font-size: 1.02rem; color: var(--brand, #0a1f44); }
.join-step p { margin: 0 0 6px; font-size: 0.92rem; color: var(--text-soft, #475569); line-height: 1.65; }
.join-step .step-pay { display: inline-block; background: #ecfdf5; border: 1px dashed rgba(5,150,105,0.4); color: #065f46; border-radius: 5px; padding: 8px 12px; font-size: 0.95rem; }
.notice-warning { border-left: 4px solid #f59e0b; background: #fffbeb; }
.notice-warning p { color: #78350f; }
/* ── সেশন ৪: ডুয়াল-মার্কি প্রেস-স্লাইডার ── */
.press-mq { overflow: hidden; position: relative; margin-top: 22px; padding: 6px 0;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
          mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
.press-track { display: flex; width: max-content; will-change: transform; }
.press-track.ltr { animation: mqLTR 42s linear infinite; }
.press-track.rtl { animation: mqRTL 42s linear infinite; }
.press-mq:hover .press-track { animation-play-state: paused; }
@keyframes mqLTR { from { transform: translateX(-50%); } to { transform: translateX(0); } }
@keyframes mqRTL { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.press-slide { flex: 0 0 auto; width: 380px; margin-right: 20px; background: #fff; border: 1px solid var(--border, #e2e8f0);
  border-radius: 5px; overflow: hidden; box-shadow: 0 3px 14px rgba(10,31,68,0.07); margin-top: 0; margin-bottom: 0;
  transition: transform .22s ease, box-shadow .22s ease; }
.press-slide:hover { transform: translateY(-5px); box-shadow: 0 14px 32px rgba(10,31,68,0.15); }
.press-slide-img { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #f1f5f9; }
.press-slide-img img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform .45s ease; }
.press-slide:hover .press-slide-img img { transform: scale(1.05); }
.press-slide figcaption { padding: 10px 14px 12px; display: flex; flex-direction: column; gap: 4px; }
.press-slide figcaption strong { font-size: .95rem; color: var(--brand, #0a1f44); line-height: 1.5; }
.press-slide figcaption span { font-size: .8rem; color: var(--text-muted, #64748b); display: inline-flex; align-items: center; gap: 6px; }
.rules-card { padding: 26px 30px; }
.rules-list li { font-size: 1.06rem; line-height: 1.9; margin-bottom: 14px; color: var(--text, #1e293b); }
.rules-list li:last-child { margin-bottom: 0; }
@media (max-width: 768px) { .press-slide { width: 290px; margin-right: 14px; } .rules-card { padding: 20px 18px; } }
@media (prefers-reduced-motion: reduce) { .press-track.ltr, .press-track.rtl { animation: none; } }
.press-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
.press-card { background: #fff; border: 1px solid var(--border, #e2e8f0); border-radius: 5px; overflow: hidden; box-shadow: 0 2px 10px rgba(10,31,68,0.05); transition: transform .18s ease, box-shadow .18s ease; display: flex; flex-direction: column; }
.press-card:hover { transform: translateY(-4px); box-shadow: 0 10px 26px rgba(10,31,68,0.12); }
.press-img-wrap { display: block; background: #f1f5f9; aspect-ratio: 4 / 3; overflow: hidden; }
.press-img-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
.press-body { padding: 12px 14px 14px; }
.press-title { margin: 0 0 6px; font-size: 0.95rem; line-height: 1.55; color: var(--brand, #0a1f44); }
.press-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.82rem; color: var(--text-muted, #64748b); }
.press-meta span { display: inline-flex; align-items: center; gap: 5px; }
@media (max-width: 768px) {
  .identity-chips { grid-template-columns: 1fr; }
  .join-steps { grid-template-columns: 1fr; }
  .cu-note { flex-direction: column; gap: 10px; }
}
</style>
