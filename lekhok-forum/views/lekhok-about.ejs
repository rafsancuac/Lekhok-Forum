<header class="page-header">
  <div class="container">
    <span class="eyebrow">আমাদের সম্পর্কে</span>
    <h1>পরিচিতি</h1>
    <p>বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়। পরিচিতি, মূলমন্ত্র, লক্ষ্য-উদ্দেশ্য ও কার্যাক্রম</p>
  </div>
</header>

<!-- Identity - heading left, goals right -->
<section class="section reveal" id="about">
  <div class="container">
    <div class="section-split" style="grid-template-columns:1fr 1fr;">
      <div class="split-left">
        <span class="eyebrow">আমাদের পরিচয়</span>
        <h2 class="section-title">বাংলাদেশ তরুণ কলাম লেখক ফোরাম, <span class="accent">চট্টগ্রাম বিশ্ববিদ্যালয়</span></h2>
        <span class="accent-divider"></span>
        <p style="text-align:justify;">বাংলাদেশ তরুণ কলাম লেখক ফোরাম একটি শিক্ষামূলক, অলাভজনক এবং অরাজনৈতিক সংগঠন, যা তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটিয়ে দেশ ও জাতির সমৃদ্ধির লক্ষ্যে তাদেরকে যোগ্য ও সুনাগরিক হিসেবে গড়ে তোলে। চট্টগ্রাম বিশ্ববিদ্যালয়ে যারা পত্রিকায় লিখেন কিংবা লিখতে চান, তাদেরকে সঠিকভাবে লিখার পদ্ধতি, কালাকৌশল এবং সংশ্লিষ্ট বিষয়ে পরামর্শ দিতে বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চবি শাখা দৃঢ়প্রত্যয়ী। সদস্যদের নিয়ে নিয়মিত কর্মশালা আয়োজন এবং লিখালিখির যাবতীয় সমস্যা সমাধানে অভিজ্ঞরা নিজ তত্ত্বাবধানে রেখে সদস্যদের দেখাশোনা করে থাকেন।</p>
        <div class="identity-chips">
          <div class="identity-chip">
            <span class="chip-label"><i class="fas fa-quote-left"></i> মূলমন্ত্র</span>
            <span class="chip-text">তারুণ্যের শাণিত কলমে আলোকিত ধরনী</span>
          </div>
          <div class="identity-chip">
            <span class="chip-label"><i class="fas fa-bullhorn"></i> স্লোগান</span>
            <span class="chip-text">সুপ্ত প্রতিভা বিকশিত হোক লেখনীর ধারায়।</span>
          </div>
        </div>
        <a href="/committee" class="btn btn-primary" style="margin-top:18px;"><i class="fas fa-users-cog"></i> কমিটি দেখুন</a>
      </div>
      <div>
        <div class="card">
          <h3 style="margin-top:0;"><i class="fas fa-bullseye" style="color:var(--accent);"></i> লক্ষ্য ও উদ্দেশ্য</h3>
          <ul class="bullet-list goal-list">
            <li><strong>১.</strong> তরুণ সমাজকে লেখালেখিতে উদ্বুদ্ধ করে সৃষ্টিশীল গড়ে তুলতে সাহায্য করা।</li>
            <li><strong>২.</strong> মুক্তিযুদ্ধের আদর্শ লালন করে তরুণ সমাজকে দেশপ্রেমী নাগরিক হিসেবে গড়ে তোলা।</li>
            <li><strong>৩.</strong> সামাজিক, আর্থ-সামাজিক ও বৈশ্বিক সমস্যার গঠনমূলক সমালোচনা ও ইতিবাচক সমাধান লেখনীর মাধ্যমে তুলে ধরা এবং তরুণ লেখকদের একটি প্ল্যাটফর্মে একত্রিত করা।</li>
            <li><strong>৪.</strong> নিয়মিত পঠন অভ্যাস গড়ে তুলে তরুণ সমাজের মেধা ও মানসিক বিকাশ সাধন করা।</li>
            <li><strong>৫.</strong> তরুণদের সাংগঠনিক ও নেতৃত্ব গুণাবলি বিকাশে সহায়তা করা।</li>
            <li><strong>৬.</strong> দেশের স্বনামধন্য লেখকদের সাথে তরুণ লেখকদের সেতুবন্ধন তৈরি করা।</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Magazine / press clippings -->
<section class="section reveal" id="magazine">
  <div class="container">
    <div class="card" style="text-align:center; padding:32px;">
      <i class="fas fa-book" style="font-size:2.5rem; color:var(--accent); margin-bottom:12px;"></i>
      <h2 style="margin:0 0 8px;">পত্রিকায় পাতায় লেখক ফোরাম</h2>
      <p style="max-width:600px; margin:0 auto; color:var(--text-soft); line-height:1.7;">লেখক ফোরামের পত্রিকা একটি নিয়মিত প্রকাশনা। সদস্যদের লেখা এখানে প্রকাশিত হয়। নতুন লেখকদের জন্য এটি একটি দুর্দান্ত সুযোগ, নিজের লেখা প্রকাশের মাধ্যমে পাঠকের সাথে সরাসরি যোগাযোগ গড়ে তোলার। পত্রিকায় লেখা প্রকাশের জন্য সদস্য হিসেবে নিবন্ধন করুন এবং নিয়মিত লেখা জমা দিন।</p>
    </div>
    <% if (pressClippings && pressClippings.length) { %>
      <div class="press-grid" style="margin-top:26px;">
        <% pressClippings.forEach(c => { %>
          <div class="press-card">
            <a href="<%= c.image_url %>" target="_blank" rel="noopener" class="press-img-wrap">
              <img src="<%= c.image_url %>" alt="<%= c.title || 'পত্রিকায় আমাদের নিউজ' %>" loading="lazy" decoding="async" onerror="this.closest('.press-card').style.display='none'" />
            </a>
            <div class="press-body">
              <% if (c.title) { %><h3 class="press-title"><%= c.title %></h3><% } %>
              <% if (c.paper_name || c.published_date) { %>
                <p class="press-meta">
                  <% if (c.paper_name) { %><span><i class="far fa-newspaper"></i> <%= c.paper_name %></span><% } %>
                  <% if (c.published_date) { %><span><i class="far fa-calendar"></i> <%= c.published_date %></span><% } %>
                </p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
      <div style="text-align:center; margin-top:22px;">
        <a href="/press" class="link-more">সব কাটিং দেখুন <i class="fas fa-arrow-right"></i></a>
      </div>
    <% } %>
  </div>
</section>

<!-- Activities - 8 items -->
<section class="section reveal" id="activities">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">আমাদের কার্যাক্রম</span>
      <h2 class="section-title">আমাদের <span class="accent">কার্যাক্রমসমূহ</span></h2>
      <span class="accent-divider center"></span>
    </div>
    <div class="feature-grid reveal-stagger">
      <div class="feature"><i class="fas fa-compass"></i><h3>পরামর্শ ও দিকনির্দেশনা</h3><p>নবীন লেখকদের পরামর্শ, দিকনির্দেশনা ও অনুপ্রেরণা প্রদান</p></div>
      <div class="feature"><i class="fas fa-edit"></i><h3>সম্পাদনা ও প্রকাশ</h3><p>নবীন লেখকদের লেখা সম্পাদনা ও পত্রিকায় প্রকাশের ব্যবস্থা</p></div>
      <div class="feature"><i class="fas fa-chalkboard-teacher"></i><h3>ওয়েবিনার ও কর্মশালা</h3><p>সদস্যদের নিয়ে নিয়মিত ওয়েবিনার, বিতর্ক, কুইজ, কর্মশালা ও পাঠচক্রের আয়োজন</p></div>
      <div class="feature"><i class="fas fa-coffee"></i><h3>সাপ্তাহিক আড্ডা ও মাসিক সভা</h3><p>নিয়মিত লেখালেখি বিষয়ক সাপ্তাহিক আড্ডা কিংবা মাসিক সভার আয়োজন</p></div>
      <div class="feature"><i class="fas fa-trophy"></i><h3>মাসিক সেরা লেখক পুরস্কার</h3><p>মাস শেষে মাসিক সেরা লেখকদের পুরস্কার প্রদান</p></div>
      <div class="feature"><i class="fas fa-handshake"></i><h3>সেতুবন্ধন</h3><p>দেশের স্বনামধন্য খ্যাতিমান লেখকদের সাথে তরুণ লেখকদের সেতুবন্ধন তৈরি</p></div>
      <div class="feature"><i class="fas fa-lightbulb"></i><h3>জনসচেতনতা</h3><p>লেখালেখির মাধ্যমে জনসচেতনতা বৃদ্ধিকরণ</p></div>
      <div class="feature"><i class="fas fa-medal"></i><h3>প্রতিযোগিতা</h3><p>বিশেষ দিবসসমূহে লেখালেখি বিষয়ক বিভিন্ন ধরনের প্রতিযোগিতার আয়োজন</p></div>
    </div>
  </div>
</section>

<!-- Membership drive CTA -->
<section class="cta-banner reveal" id="soldier">
  <div class="container">
    <span class="eyebrow" style="background:rgba(5,150,105,0.18);border-color:rgba(5,150,105,0.32);">সদস্য সংগ্রহ চলছে</span>
    <h2>আপনি কি একজন <span class="accent">কলম সৈনিক</span> হতে চান?</h2>
    <p style="text-align:justify; line-height:1.8; max-width:800px; margin:0 auto;">চট্টগ্রাম বিশ্ববিদ্যালয়ের লেখালেখিতে আগ্রহী তরুণ লেখকদের সুপ্ত প্রতিভা বিকশিত করার লক্ষ্যে বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয় শাখা নতুন বছরে সদস্য সংগ্রহ কার্যক্রম শুরু করেছে। তুলে ধরতে চান সমাজ-রাষ্ট্রের অসংগতি? তাহলে বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয় শাখা আপনাকেই খুঁজছে। আপনার লেখনির ধারাকে আরও শাণিত করতে একঝাঁক তরুণ লেখকের পতাকাতলে আপনাকে স্বাগতম। সংগঠনের পত্রিকায় নিয়মিত লেখার সুযোগ, অভিজ্ঞ লেখকদের পরামর্শ ও দিকনির্দেশনা, এবং লেখালেখির বিভিন্ন কর্মশালা ও সেমিনারে অংশগ্রহণের মাধ্যমে নিজের লেখনীকে আরও পরিণত করতে পারবেন। একইসাথে দেশের বিভিন্ন প্রান্তের তরুণ লেখকদের সাথে পরিচিত হওয়ার ও মতবিনিময়ের এক অনন্য সুযোগ এটি। আপনার চিন্তাকে শব্দের রূপ দিতে, আপনার লেখনীকে শাণিত করতে, এবং একটি সুস্থ সমাজ গঠনে নিজের অবদান রাখতে চাইলে, তাহলে আর দেরি কেন? এক্ষুনি শামিল হোন আমাদের অগ্রযাত্রায়।</p>
    <div style="margin-top:26px;">
      <a href="/register" class="btn btn-primary" style="margin-right:10px;"><i class="fas fa-user-plus"></i> নিবন্ধন করুন</a>
      <a href="/contact" class="btn btn-outline"><i class="fas fa-envelope"></i> যোগাযোগ করুন</a>
    </div>
  </div>
</section>

<!-- Membership conditions - step cards -->
<section class="section reveal" id="conditions">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">নিবন্ধন প্রক্রিয়া</span>
      <h2 class="section-title">সদস্য হওয়ার <span class="accent">শর্তাবলি</span></h2>
      <span class="accent-divider center"></span>
    </div>
    <div class="join-steps">
      <div class="join-step">
        <span class="step-num">১</span>
        <div>
          <h3>রেজিস্ট্রেশন ফি ও ফর্ম পূরণ</h3>
          <p>সদস্য পদের জন্য নিম্নোক্ত নাম্বারে <strong>২০০ টাকা</strong> পাঠিয়ে গুগল ফর্মটি পূরণ করে নিবন্ধন সম্পন্ন করবেন। টাকা পাঠানোর ক্ষেত্রে রেফারেন্সে <strong>অবশ্যই নিজের নাম</strong> লিখবেন।</p>
          <p class="step-pay"><i class="fas fa-mobile-alt"></i> <strong>০১*********</strong> (বিকাশ/নগদ)</p>
        </div>
      </div>
      <div class="join-step">
        <span class="step-num">২</span>
        <div>
          <h3>অনলাইন সাক্ষাৎকার</h3>
          <p>ফর্ম পূরণ করলে আপনাকে শাখার কার্যকরী কমিটি কর্তৃক মেইল এবং ফোন কলের মাধ্যমে অনলাইন সাক্ষাৎকারের জন্য আহ্বান করা হবে।</p>
        </div>
      </div>
      <div class="join-step">
        <span class="step-num">৩</span>
        <div>
          <h3>মেসেঞ্জার গ্রুপে যুক্ত হওয়া</h3>
          <p>অনলাইন সাক্ষাৎকার শেষে সদস্য হওয়ার শর্তাবলী পূরণপূর্বক আপনাকে শাখার প্রাথমিক মেসেঞ্জার গ্রুপে যুক্ত করা হবে এবং আপনাদের নিয়ে নিয়মিত লেখালেখি বিষয়ক কর্মশালা ও সেমিনার আয়োজন ও যেকোনো প্রয়োজনে দিকনির্দেশনা প্রদান করা হবে।</p>
        </div>
      </div>
      <div class="join-step">
        <span class="step-num">৪</span>
        <div>
          <h3>সদস্যপদ লাভ</h3>
          <p>পরবর্তীতে ৩ মাস পর্যন্ত আপনাদের লেখালেখি এবং সাংগঠনিক কার্যক্রম পর্যালোচনা করে লেখালেখির পাশাপাশি সাংগঠনিক কার্যক্রমে সক্রিয় প্রার্থীদের সদস্য পদ দেওয়া হবে।</p>
        </div>
      </div>
    </div>
    <div class="card" style="margin-top:22px;">
      <h3 style="margin-top:0;"><i class="fas fa-scroll" style="color:var(--accent);"></i> অবশ্যপালনীয় শর্ত</h3>
      <ul class="bullet-list">
