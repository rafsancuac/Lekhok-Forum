<!-- Hero — brand-style full animated -->
<section class="hero brand-hero">
  <div class="particles">
    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>
    <div class="particle p4"></div>
    <div class="particle p5"></div>
    <div class="particle p6"></div>
  </div>
  <div class="container hero-inner">
    <div>
      <div class="hero-eyebrow"><i class="fas fa-feather-alt"></i> বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়</div>
      <h1 class="hero-title">সুপ্ত প্রতিভা বিকশিত হোক<br/><span class="accent">লেখনীর ধারায়</span></h1>
      <p class="hero-sub">বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয়, একটি শিক্ষামূলক, অলাভজনক ও অরাজনৈতিক সংগঠন। তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটিয়ে দেশ ও জাতির সমৃদ্ধির লক্ষ্যে যোগ্য ও সুনাগরিক হিসেবে গড়ে তোলাই আমাদের প্রত্যয়।</p>
      <div class="hero-cta">
        <a href="/about" class="btn btn-primary"><i class="fas fa-book-open"></i> আরও জানুন</a>
        <a href="/register" class="btn btn-outline"><i class="fas fa-user-plus"></i> সদস্য হোন</a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="stat-card"><span class="stat-num" data-count="1200">০</span><span class="stat-label">সক্রিয় সদস্য</span></div>
      <div class="stat-card"><span class="stat-num" data-count="48">০</span><span class="stat-label">বিশ্ববিদ্যালয় শাখা</span></div>
      <div class="stat-card"><span class="stat-num" data-count="320">০</span><span class="stat-label">প্রকাশনা</span></div>
      <div class="stat-card"><span class="stat-num" data-count="85">০</span><span class="stat-label">ইভেন্ট</span></div>
    </div>
  </div>
</section>

<% if (hasToday) { %>
<!-- Today's daily content — auto-shows scheduled items for today -->
<section class="section section-alt today-content reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><i class="far fa-calendar-alt"></i> আজকের কন্টেন্ট</span>
      <h2 class="section-title">আজ <span class="accent">বিশেষ</span> কী আছে?</h2>
      <span class="accent-divider center"></span>
      <p class="lead">প্রতিদিনের জন্য নির্বাচিত কুইজ, এই দিনে ইতিহাস, ই-পেপার ও সেরা লেখক সব এক জায়গায়।</p>
    </div>
    <div class="today-grid reveal-stagger">
      <% if (todayByType.quiz) { %>
        <a href="<%= todayByType.quiz.link_url || '/quiz' %>" class="today-card today-quiz">
          <div class="today-icon"><i class="fas fa-question-circle"></i></div>
          <h3>আজকের কুইজ</h3>
          <p class="today-title"><%= todayByType.quiz.title %></p>
          <% if (todayByType.quiz.body) { %><p class="today-body"><%= todayByType.quiz.body.substring(0, 110) %><%= todayByType.quiz.body.length > 110 ? '…' : '' %></p><% } %>
          <span class="today-cta">কুইজে অংশ নিন <i class="fas fa-arrow-right"></i></span>
        </a>
      <% } %>
      <% if (todayByType.this_day) { %>
        <a href="/on-this-day" class="today-card today-thisday">
          <div class="today-icon"><i class="fas fa-history"></i></div>
          <h3>এই দিনে</h3>
          <p class="today-title"><%= todayByType.this_day.title %></p>
          <% if (todayByType.this_day.body) { %><p class="today-body"><%= todayByType.this_day.body.substring(0, 110) %><%= todayByType.this_day.body.length > 110 ? '…' : '' %></p><% } %>
          <span class="today-cta">বিস্তারিত পড়ুন <i class="fas fa-arrow-right"></i></span>
        </a>
      <% } %>
      <% if (todayByType.activity) { %>
        <div class="today-card today-activity">
          <div class="today-icon"><i class="fas fa-running"></i></div>
          <h3>আজকের কার্যক্রম</h3>
          <p class="today-title"><%= todayByType.activity.title %></p>
          <% if (todayByType.activity.body) { %><p class="today-body"><%= todayByType.activity.body.substring(0, 110) %><%= todayByType.activity.body.length > 110 ? '…' : '' %></p><% } %>
        </div>
      <% } %>
      <% if (todayByType.epaper) { %>
        <a href="<%= todayByType.epaper.link_url || todayByType.epaper.file_url || '/quiz' %>" target="_blank" rel="noopener" class="today-card today-epaper">
          <div class="today-icon"><i class="far fa-newspaper"></i></div>
          <h3>আজকের ই-পেপার</h3>
          <p class="today-title"><%= todayByType.epaper.title %></p>
          <% if (todayByType.epaper.body) { %><p class="today-body"><%= todayByType.epaper.body.substring(0, 110) %><%= todayByType.epaper.body.length > 110 ? '…' : '' %></p><% } %>
          <span class="today-cta">পড়ুন / ডাউনলোড <i class="fas fa-external-link-alt"></i></span>
        </a>
      <% } %>
      <% if (todayByType.best_writer) { %>
        <a href="<%= todayByType.best_writer.link_url || '/committee' %>" class="today-card today-best">
          <div class="today-icon"><i class="fas fa-crown"></i></div>
          <h3>সেরা লেখক</h3>
          <p class="today-title"><%= todayByType.best_writer.title %></p>
          <% if (todayByType.best_writer.body) { %><p class="today-body"><%= todayByType.best_writer.body.substring(0, 110) %><%= todayByType.best_writer.body.length > 110 ? '…' : '' %></p><% } %>
          <span class="today-cta">পরিচয় দেখুন <i class="fas fa-arrow-right"></i></span>
        </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<!-- Mission — section-alt with reveal -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">আমাদের পরিচয়</span>
      <h2 class="section-title">লক্ষ্য ও <span class="accent">উদ্দেশ্য</span></h2>
      <span class="accent-divider center"></span>
      <p class="lead">বাংলাদেশ তরুণ কলাম লেখক ফোরাম, চট্টগ্রাম বিশ্ববিদ্যালয় একটি শিক্ষামূলক, অলাভজনক এবং অরাজনৈতিক সংগঠন, যা তরুণ সমাজকে লিখালিখির জগতে নিয়ে এসে তাদের বুদ্ধিবৃত্তিক বিকাশ ঘটিয়ে দেশ ও জাতির সমৃদ্ধির লক্ষ্যে তাদেরকে যোগ্য ও সুনাগরিক হিসেবে গড়ে তোলে।</p>
    </div>
    <div class="feature-grid reveal-stagger">
      <div class="feature"><i class="fas fa-pen-fancy"></i><h3>সৃষ্টিশীল লেখক গড়ে তোলা</h3><p>তরুণ সমাজকে লেখালেখিতে উদ্বুদ্ধ করে সৃষ্টিশীল গড়ে তুলতে সাহায্য করা</p></div>
      <div class="feature"><i class="fas fa-flag"></i><h3>দেশপ্রেমিক নাগরিক গঠন</h3><p>মুক্তিযুদ্ধের আদর্শ লালন করে তরুণ সমাজকে দেশপ্রেমী নাগরিক হিসেবে গড়ে তোলা</p></div>
      <div class="feature"><i class="fas fa-balance-scale"></i><h3>গঠনমূলক সমালোচনা</h3><p>কুসংস্কার, অন্যায়, শোষণ ও দুর্নীতিসহ সামাজিক সমস্যার গঠনমূলক সমালোচনা ও ইতিবাচক সমাধান লেখনীর মাধ্যমে তুলে ধরা</p></div>
      <div class="feature"><i class="fas fa-users"></i><h3>প্ল্যাটফর্ম একত্রিতকরণ</h3><p>তরুণ লেখকদের একটি প্ল্যাটফর্মে একত্রিত করে নিয়মিত কর্মশালা, ওয়েবিনার ও পাঠচক্রের আয়োজন</p></div>
      <div class="feature"><i class="fas fa-book-reader"></i><h3>পঠন সংস্কৃতি বিকাশ</h3><p>তরুণ সমাজে নিয়মিত পড়ার অভ্যাস গড়ে তুলে মেধা ও মানসিক বিকাশ সাধন</p></div>
      <div class="feature"><i class="fas fa-lightbulb"></i><h3>বুদ্ধিবৃত্তিক বিকাশ</h3><p>চিন্তন, গবেষণা ও বিশ্লেষণী ক্ষমতার বিকাশ ঘটিয়ে যুক্তিবাদী সমাজ গঠন</p></div>
      <div class="feature"><i class="fas fa-hands-helping"></i><h3>সামাজিক দায়িত্ববোধ</h3><p>সমাজের প্রতি দায়িত্বশীল ও সংবেদনশীল নাগরিক হিসেবে গড়ে তোলা</p></div>
      <div class="feature"><i class="fas fa-graduation-cap"></i><h3>নেতৃত্ব গড়ে তোলা</h3><p>তরুণদের সাংগঠনিক ও নেতৃত্ব গুণাবলি বিকাশে সহায়তা করা</p></div>
    </div>
  </div>
</section>

<!-- Stats banner removed (moved to about page) -->

<!-- Leaders preview — restructured with current + founders + advisors -->
<section class="section reveal" id="leadership">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">নেতৃত্ব পরিষদ</span>
        <h2 class="section-title">যাঁরা <span class="accent">নেতৃত্ব</span> দিচ্ছেন</h2>
        <span class="accent-divider"></span>
      </div>
      <a href="/committee" class="link-more">সকল সদস্য দেখুন <i class="fas fa-arrow-right"></i></a>
    </div>

    <%# ── Sub-section 1: Founding leadership (2 cards) ── %>
    <% if (founders && founders.length) { %>
    <div class="leadership-sub">
      <h3 class="leadership-sub-title"><i class="fas fa-landmark"></i> প্রতিষ্ঠাতা সভাপতি ও সাধারণ সম্পাদক</h3>
      <div class="leaders-grid leaders-grid-lg">
        <% currentLeaders.forEach(m => { %>
          <% const displayName = m.user_full_name || m.name; %>
          <% const displayImg  = m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg'; %>
          <% const displayBio  = m.bio || ''; %>
          <% if (m.user_username) { %>
            <a href="/profile/<%= m.user_username %>" class="leader-card has-image linked-member leader-card-featured">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= m.role %></p>
                <% if (displayBio) { %><p class="leader-bani">"<%= displayBio.substring(0, 120) %><%= displayBio.length > 120 ? '…' : '' %>"</p><% } %>
              </div>
            </a>
          <% } else { %>
            <div class="leader-card has-image leader-card-featured">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= m.role %></p>
                <% if (displayBio) { %><p class="leader-bani">"<%= displayBio.substring(0, 120) %><%= displayBio.length > 120 ? '…' : '' %>"</p><% } %>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>
    <% } %>

    <%# ── Sub-section 2: Founding advisors ── %>
    <% if (foundingAdvisors && foundingAdvisors.length) { %>
    <div class="leadership-sub">
      <h3 class="leadership-sub-title"><i class="fas fa-user-tie"></i> প্রতিষ্ঠাকালীন উপদেষ্টা</h3>
      <div class="leaders-grid leaders-grid-lg">
        <% foundingAdvisors.forEach(m => { %>
          <% const displayName = m.user_full_name || m.name; %>
          <% const displayImg  = m.user_avatar_url || m.image_url || m.photo_url || '/assets/img/avatar-placeholder.svg'; %>
          <% const displayBio  = m.bio || ''; %>
          <% const displayRole = m.role === 'president' ? 'প্রতিষ্ঠাতা সভাপতি' : (m.role === 'general_secretary' ? 'প্রতিষ্ঠাতা সাধারণ সম্পাদক' : m.role); %>
          <% if (m.user_username) { %>
            <a href="/profile/<%= m.user_username %>" class="leader-card has-image linked-member leader-card-featured">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= displayRole %></p>
                <% if (displayBio) { %><p class="leader-bani">"<%= displayBio.substring(0, 120) %><%= displayBio.length > 120 ? '…' : '' %>"</p><% } %>
              </div>
            </a>
          <% } else { %>
            <div class="leader-card has-image leader-card-featured">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= displayRole %></p>
                <% if (displayBio) { %><p class="leader-bani">"<%= displayBio.substring(0, 120) %><%= displayBio.length > 120 ? '…' : '' %>"</p><% } %>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>
    <% } %>

    <%# ── Sub-section 3: Current leadership ── %>
    <% if (currentLeaders && currentLeaders.length) { %>
    <div class="leadership-sub">
      <h3 class="leadership-sub-title"><i class="fas fa-star"></i> বর্তমান সভাপতি ও সাধারণ সম্পাদক</h3>
      <div class="leaders-grid leaders-grid-lg">
        <% currentLeaders.forEach(m => { %>
          <% const displayName = m.user_full_name || m.name; %>
          <% const displayImg  = m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg'; %>
          <% const displayBio  = m.bio || ''; %>
          <% if (m.user_username) { %>
            <a href="/profile/<%= m.user_username %>" class="leader-card has-image linked-member leader-card-featured">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= m.role %></p>
                <% if (displayBio) { %><p class="leader-bani">"<%= displayBio.substring(0, 120) %><%= displayBio.length > 120 ? '…' : '' %>"</p><% } %>
              </div>
            </a>
          <% } else { %>
            <div class="leader-card has-image leader-card-featured">
              <img loading="lazy" decoding="async" src="<%= displayImg %>" alt="<%= displayName %>" loading="lazy" />
              <div class="leader-body">
                <h3><%= displayName %></h3>
                <p class="role"><%= m.role %></p>
                <% if (displayBio) { %><p class="leader-bani">"<%= displayBio.substring(0, 120) %><%= displayBio.length > 120 ? '…' : '' %>"</p><% } %>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>
    <% } %>


    <%# ── Q&A folding section ── %>
    <% if (recentQA && recentQA.length) { %>
    <div class="leadership-sub" style="margin-top:36px">
      <div class="leadership-sub-head">
        <h3 class="leadership-sub-title"><i class="fas fa-question-circle"></i> সাধারণ জিজ্ঞাসা</h3>
        <a href="/qa" class="link-more">সকল প্রশ্ন <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="qa-folding-list">
        <% recentQA.forEach((q) => { %>
          <details class="qa-fold-item">
            <summary class="qa-fold-summary">
              <span class="qa-fold-q"><i class="fas fa-chevron-right"></i> <%= q.title %></span>
              <span class="qa-fold-meta"><i class="far fa-user"></i> <%= q.author_name %> · <i class="far fa-clock"></i> <%= new Date(q.created_at).toLocaleDateString('bn-BD') %></span>
            </summary>
            <div class="qa-fold-body">
              <div class="qa-fold-question">
                <strong>প্রশ্ন:</strong>
                <p><%= (q.body || '').substring(0, 400) %><%= q.body && q.body.length > 400 ? '…' : '' %></p>
              </div>
              <% if (q.topAnswer) { %>
                <div class="qa-fold-answer">
                  <strong><i class="fas fa-comment-dots"></i> উত্তর:</strong>
                  <p><%= q.topAnswer.body.substring(0, 500) %><%= q.topAnswer.body.length > 500 ? '…' : '' %></p>
                  <span class="qa-fold-answerer"><i class="far fa-user"></i> <%= q.topAnswer.author_name %></span>
                </div>
              <% } else { %>
                <div class="qa-fold-no-answer"><i class="fas fa-info-circle"></i> এখনো কোনো উত্তর নেই। প্রথম উত্তর দিন!</div>
              <% } %>
              <a href="/qa/<%= q.id %>" class="qa-fold-link">সম্পূর্ণ আলোচনায় অংশ নিন <i class="fas fa-arrow-right"></i></a>
            </div>
          </details>
        <% }) %>
      </div>
    </div>
    <% } %>

    <%# ── User feed link (visitor-friendly) ── %>
    <div class="user-feed-cta">
      <div>
        <h3><i class="fas fa-stream"></i> ইউজার ফিড</h3>
        <p>সদস্যদের লেখা, প্রশ্নোত্তর ও আলোচনা দেখুন। লগইন ছাড়াই পড়তে পারবেন। অংশ নিতে রেজিস্ট্রেশন করুন।</p>
      </div>
      <a href="/dashboard" class="btn btn-primary btn-lg"><i class="fas fa-arrow-right"></i> ইউজার ফিডে যান</a>
    </div>
  </div>
</section>

<!-- Recent notices — professional card grid -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow"><i class="fas fa-bullhorn"></i> সাম্প্রতিক বিজ্ঞপ্তি</span>
        <h2 class="section-title">সর্বশেষ <span class="accent">আপডেট</span></h2>
        <span class="accent-divider"></span>
      </div>
      <a href="/notices" class="link-more">সকল বিজ্ঞপ্তি <i class="fas fa-arrow-right"></i></a>
    </div>
    <% if (recentNotices && recentNotices.length) { %>
      <div class="notice-list notice-list--home reveal-stagger">
        <% recentNotices.slice(0, 6).forEach(n => { %>
          <a href="/notices/<%= n.id %>" class="notice-row notice-row--compact">
            <span class="notice-row-icon cat-<%= n.category %>">
              <i class="fas fa-<%= n.category === 'press' ? 'bullhorn' : n.category === 'event' ? 'calendar-alt' : 'bell' %>"></i>
            </span>
            <span class="notice-row-main">
              <span class="notice-row-top">
                <span class="notice-row-title"><%= n.title %></span>
                <span class="notice-badge badge-<%= n.category %>"><%= n.category === 'press' ? 'প্রেস' : n.category === 'event' ? 'ইভেন্ট' : 'নোটিশ' %></span>
              </span>
            </span>
            <span class="notice-row-meta">
              <span class="notice-row-date"><i class="far fa-calendar"></i><%= n.date || '' %></span>
              <i class="fas fa-chevron-right notice-row-arrow"></i>
            </span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-bullhorn"></i>
        <h3>এখনও কোনো বিজ্ঞপ্তি প্রকাশিত হয়নি</h3>
        <p>নতুন বিজ্ঞপ্তি এখানে দেখা যাবে</p>
      </div>
    <% } %>
  </div>
</section>
