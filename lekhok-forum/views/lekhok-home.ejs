<%
  /* ═══ সেশন ১৯৩: হোমপেজ এখন অর্ডার-চালিত partials ═══
     সেকশন-ক্রম helpers/home-layout.js রেজিস্ট্রি + settings.home_section_order
     (অ্যাডমিন প্যানেল /admin/home-reorder থেকে সংরক্ষিত) অনুযায়ী routes/pages.js
     homeSections হিসেবে পাস করে। গেট: TODAY/QUIZ_CHALLENGE/ARTICLES-এর ডেটা
     না-থাকলে সেটি যে-অবস্থানেই থাকুক রেন্ডার হয় না।

     শেয়ার্ড হেল্পার (আগে lekhok-home.ejs-এর মাঝে ডিফাইন হত — এখন টপে একবার,
     locals-এ যুক্ত; EJS include আলাদা-ফাংশন-স্কোপ, তাই দুই নেতৃত্ব-partial
     leaderPair/leaderCard locals-থেকে পায় — সেকশন-অর্ডার যে-ই হোক নিরাপদ):

     সেশন ৫৭: প্রোফাইল-লিংক স্যানিটাইজার — শুধু http(s)/সাইট-রিলেটিভ পাথ গ্রহণ
     (javascript: ইত্যাদি ইনজেকশন রোধ)। */
  function lfSafeUrl(u) {
    if (!u) return '';
    const s = String(u).trim();
    if (/^https?:\/\//i.test(s) || s.startsWith('/')) return s;
    return '';
  }
  /* সেশন ৯১: HTML-অ্যাট্রিবিউট-এস্কেপ — leaderCard-এর টেমপ্লেট-লিটারালে
     ইউজার-কনটেন্ট (full_name/avatar_url/bio/সোশ্যাল-ইউআরএল) কাঁচা বসানো
     stored-XSS দেয়; সব ইন্টারপোলেশন esc() দিয়ে যায়। */
  function lfEsc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function leaderCard(m, roleLabel, yearLabel, statement) {
    const displayName = m.user_full_name || m.name;
    const displayImg  = m.user_avatar_url || m.image_url || m.photo_url || '/assets/img/avatar-placeholder.svg?v=2';
    // সেশন ৫৭: আইডির ইউয়ারএল (অ্যাডমিন-সেট profile_url) → প্রাধিকার;
    // না থাকলে লিংকড অ্যাকাউন্টের সাইট-প্রোফাইল।
    const profileHref = lfSafeUrl(m.profile_url) || (m.user_username ? '/profile/' + m.user_username : '');
    // সেশন ৪৯: বাণী প্রাধিকার — message (আলাদা বাণী ফিল্ড) → bio → slot statement
    const rawBio = (m.message && String(m.message).trim()) ? String(m.message)
                 : ((m.bio && String(m.bio).trim()) ? String(m.bio) : (statement || ''));
    const displayBio = rawBio.substring(0, 700);
    const fb    = lfSafeUrl(m.social_fb);
    const email = m.social_email;
    const hasSocial = !!(fb || email || m.social_twitter || m.social_linkedin || profileHref);
    const inner = `
      <img loading="lazy" decoding="async" src="${lfEsc(displayImg)}" alt="${lfEsc(displayName)}" class="leader-photo" />
      <div class="leader-body">
        <h3 class="leader-name">${lfEsc(displayName)}</h3>
        <p class="role leader-role">${lfEsc(roleLabel || m.role || '')}</p>
        ${yearLabel ? `<p class="leader-year">${lfEsc(yearLabel)}</p>` : ''}
        ${displayBio ? `<p class="leader-bani">${lfEsc(displayBio)}${rawBio.length > 700 ? '…' : ''}</p>` : ''}
        ${hasSocial ? `
        <div class="leader-social">
          ${profileHref ? `<a href="${lfEsc(profileHref)}" ${/^https?:\/\//i.test(profileHref) ? 'target="_blank" rel="noopener noreferrer"' : ''} class="leader-soc-id" aria-label="প্রোফাইল / আইডি"><i class="fas fa-id-card"></i></a>` : ''}
          ${fb ? `<a href="${lfEsc(fb)}" target="_blank" rel="noopener noreferrer" class="leader-soc-fb" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>` : ''}
          ${email ? `<a href="mailto:${lfEsc(email)}" aria-label="Email"><i class="fas fa-envelope"></i></a>` : ''}
          ${m.social_twitter ? `<a href="${lfEsc(lfSafeUrl(m.social_twitter))}" target="_blank" rel="noopener noreferrer" class="leader-soc-tw" aria-label="Twitter"><i class="fab fa-twitter"></i></a>` : ''}
          ${m.social_linkedin ? `<a href="${lfEsc(lfSafeUrl(m.social_linkedin))}" target="_blank" rel="noopener noreferrer" class="leader-soc-in" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>` : ''}
        </div>` : ''}
      </div>
    `;
    // সেশন ৩০ (আসল বাগফিক্স): কার্ড সবসময় <div> — আগে linked কার্ড
    // (user_username যাদের) পুরোটা <a href="/profile/...">-তে মোড়ানো হত,
    // অথচ ভেতরের সোশ্যাল রো-তেও <a> ছিল। <a>-র ভেতর <a> invalid HTML —
    // ব্রাউজার পার্সার বাইরের <a> আগেই বন্ধ করে দিয়ে কার্ডটাকে ৩টি বিচ্ছিন্ন
    // DOM টুকরোতে ফেলত, ফলে বর্তমান সভাপতি/সা.সম্পাদক কার্ড ভেঙে যেত।
    // এখন প্রোফাইল লিংক থাকে সোশ্যাল আইকনে + পুরো কার্ড ক্লিকযোগ্য
    // data-href + main.js-এর delegated হ্যান্ডলারে — nested anchor সম্ভবই নেই।
    // সেশন ৫৭: profileHref থাকলে কার্ডে data-href — main.js ক্লিকে নেভিগেট করে
    // (ভেতরের <a>-তে ক্লিক হলে সেটাই প্রাধিন্য পায়)।
    return `<div class="leader-card has-image leader-card-featured${profileHref ? ' is-linked' : ''}"${profileHref ? ` data-href="${lfEsc(profileHref)}"` : ''}>${inner}</div>`;
  }
  function leaderPair(members, roles, yearLabel, statements) {
    if (!members || !members.length) return '';
    return `
      <div class="leadership-cell">
        <div class="leaders-grid leaders-grid-pair">
          ${members.map((m, i) => leaderCard(m, roles[i], yearLabel, statements[i])).join('')}
        </div>
      </div>`;
  }
  // EJS-include আলাদা স্কোপ — with(locals) দিয়ে partial-এ দৃশ্যমান হয়:
  locals.lfSafeUrl = lfSafeUrl;
  locals.lfEsc = lfEsc;
  locals.leaderCard = leaderCard;
  locals.leaderPair = leaderPair;
  const homeSections193 = Array.isArray(homeSections) ? homeSections : [];
%>
<% for (const _sec193 of homeSections193) { %>
<% if (_sec193.key === 'TODAY' && !hasToday) { continue; } %>
<% if (_sec193.key === 'QUIZ_CHALLENGE' && !quizChallenge) { continue; } %>
<% if (_sec193.key === 'ARTICLES' && !(typeof recentArticles !== 'undefined' && recentArticles && recentArticles.length)) { continue; } %>
<%- include('partials/home/' + _sec193.partial); %>
<% } %>
