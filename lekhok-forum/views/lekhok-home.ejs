<!-- ═══ Section 1: Founding leaders ═══ -->
<section class="section reveal" id="leadership">
  <div class="container">
    <div class="section-head" style="flex-direction:column; align-items:center; text-align:center;">
      <div>
        <span class="eyebrow"><%= C('home_lead1_eyebrow') %></span>
        <h2 class="section-title"><%= C('home_lead1_t1') %> <span class="accent"><%= C('home_lead1_accent') %></span></h2>
        <span class="accent-divider center"></span>
      </div>
    </div>

    <%
      function leaderCard(m, roleLabel, yearLabel, statement) {
        const displayName = m.user_full_name || m.name;
        const displayImg  = m.user_avatar_url || m.image_url || m.photo_url || '/assets/img/avatar-placeholder.svg';
        const rawBio = (m.bio && String(m.bio).trim()) ? String(m.bio) : (statement || '');
        const displayBio = rawBio.substring(0, 700);
        const fb    = m.social_fb;
        const email = m.social_email;
        const hasSocial = !!(fb || email || m.social_twitter || m.social_linkedin);
        const inner = `
          <img loading="lazy" decoding="async" src="${displayImg}" alt="${displayName}" class="leader-photo" />
          <div class="leader-body">
            <h3 class="leader-name">${displayName}</h3>
            <p class="role leader-role">${roleLabel || m.role || ''}</p>
            ${yearLabel ? `<p class="leader-year">(${yearLabel})</p>` : ''}
            ${displayBio ? `<p class="leader-bani">${displayBio}${rawBio.length > 700 ? '…' : ''}</p>` : ''}
            ${hasSocial ? `
            <div class="leader-social">
              ${fb ? `<a href="${fb}" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook"></i></a>` : ''}
              ${email ? `<a href="mailto:${email}" aria-label="Email"><i class="fas fa-envelope"></i></a>` : ''}
              ${m.social_twitter ? `<a href="${m.social_twitter}" target="_blank" rel="noopener" aria-label="Twitter"><i class="fab fa-twitter"></i></a>` : ''}
              ${m.social_linkedin ? `<a href="${m.social_linkedin}" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>` : ''}
            </div>` : ''}
          </div>
        `;
        // সেশন ৩০ (আসল বাগফিক্স): কার্ড সবসময় <div> — আগে linked কার্ড
        // (user_username যাদের) পুরোটা <a href="/profile/...">-তে মোড়ানো হত,
        // অথচ ভেতরের সোশ্যাল রো-তেও <a> ছিল। <a>-র ভেতর <a> invalid HTML —
        // ব্রাউজার পার্সার বাইরের <a> আগেই বন্ধ করে দিয়ে কার্ডটাকে ৩টি বিচ্ছিন্ন
        // DOM টুকরোতে ফেলত, ফলে বর্তমান সভাপতি/সা.সম্পাদক কার্ড ভেঙে যেত।
        // এখন প্রোফাইল লিংক থাকে সোশ্যাল আইকনে + পুরো কার্ড ক্লিকযোগ্য
        // data-href + main.js-এর delegated হ্যান্ডলারে — nested anchor সম্ভবই নেই।
        return `<div class="leader-card has-image leader-card-featured">${inner}</div>`;
      }
      function leaderPair(members, roles, yearLabel, statements) {
        if (!members || !members.length) return '';
        return `
          <div class="leadership-cell">
            <div class="leaders-grid leaders-grid-pair">
              ${members.map((m, i) => leaderCard(m, roles[i], yearLabel, statements[i])).join('')}
            </div>
          </div>`;
      }
    %>

    <div class="leadership-matrix">
      <%- leaderPair(founders, [C('home_role_founder_president'), C('home_role_founder_gs')], C('home_year_founding'), [leaderStatements.founder_president, leaderStatements.founder_general_secretary]) %>
      <%- leaderPair(foundingAdvisors, [C('home_role_founding_advisor1'), C('home_role_founding_advisor2')], C('home_year_founding'), [leaderStatements.founding_advisor_1, leaderStatements.founding_advisor_2]) %>
    </div>
  </div>
</section>

