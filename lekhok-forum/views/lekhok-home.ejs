<!-- Hero -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-inner">
    <div class="hero-eyebrow">লেখক ফোরাম</div>
    <h1 class="hero-title">সুপ্ত প্রতিভা বিকশিত হোক<br/><span class="accent">লেখনীর ধারায়</span></h1>
    <p class="hero-sub">দেশের তরুণ লেখক, চিন্তাবিদ ও সৃজনশীল মানুষদের এক অনন্য প্ল্যাটফর্ম। আমরা একসাথে লিখছি ভবিষ্যৎ বাংলাদেশের গল্প।</p>
    <div class="hero-cta">
      <a href="/about" class="btn btn-primary">আরও জানুন</a>
      <a href="/contact" class="btn btn-ghost">যোগাযোগ করুন</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><span class="num" data-count="1200">০</span><span class="label">সক্রিয় সদস্য</span></div>
      <div class="stat"><span class="num" data-count="48">০</span><span class="label">বিশ্ববিদ্যালয় শাখা</span></div>
      <div class="stat"><span class="num" data-count="320">০</span><span class="label">প্রকাশনা</span></div>
      <div class="stat"><span class="num" data-count="85">০</span><span class="label">ইভেন্ট</span></div>
    </div>
  </div>
</section>

<!-- Mission -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">আমাদের <span class="accent">লক্ষ্য</span></h2>
      <p>লেখক ফোরাম একটি জাতীয় বুদ্ধিবৃত্তিক ও সৃজনশীল সংগঠন, যা তরুণ প্রজন্মকে লেখালেখি ও চিন্তার মাধ্যমে জাতীয় উন্নয়নের ধারায় সম্পৃক্ত করে।</p>
    </div>
    <div class="feature-grid">
      <div class="feature"><i class="fas fa-pen-fancy"></i><h3>লেখালেখি</h3><p>নিয়মিত কলাম, প্রবন্ধ ও বিশ্লেষণমূলক লেখা প্রকাশ</p></div>
      <div class="feature"><i class="fas fa-users"></i><h3>সেমিনার</h3><p>জাতীয় ও আন্তর্জাতিক বিষয়ে আলোচনা সভা</p></div>
      <div class="feature"><i class="fas fa-book"></i><h3>প্রকাশনা</h3><p>ম্যাগাজিন, ই-পেপার ও ই-বুক প্রকাশ</p></div>
      <div class="feature"><i class="fas fa-tint"></i><h3>ব্লাড ব্যাংক</h3><p>জরুরি রক্তদান সেবা ও স্বেচ্ছাসেবক</p></div>
    </div>
  </div>
</section>

<!-- Leaders preview -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">নেতৃত্ব <span class="accent">পরিষদ</span></h2>
      <a href="/committee" class="link-more">সকল সদস্য দেখুন <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="leader-grid">
      <% centralMembers.forEach(m => { %>
        <div class="leader-card">
          <img src="<%= m.image_url %>" alt="<%= m.name %>" loading="lazy" />
          <h3><%= m.name %></h3>
          <p class="leader-role"><%= m.role %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Recent notices -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">সাম্প্রতিক <span class="accent">বিজ্ঞপ্তি</span></h2>
      <a href="/notices" class="link-more">সকল বিজ্ঞপ্তি <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="notice-list">
      <% recentNotices.forEach(n => { %>
        <div class="notice-item">
          <span class="notice-badge badge-<%= n.category %>"><%= n.category === 'press' ? 'প্রেস' : n.category === 'event' ? 'ইভেন্ট' : 'নোটিশ' %></span>
          <div>
            <h3><%= n.title %></h3>
            <p class="notice-date"><i class="far fa-calendar"></i> <%= n.date || '' %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
