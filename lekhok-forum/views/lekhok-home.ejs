<!-- Hero — brand-style full animated -->
<section class="hero brand-hero">
  <% if (C('home_hero_banner')) { %><div class="hero-banner-img" style="background-image:url('<%= C('home_hero_banner') %>')"></div><% } %>
  <div class="particles">
    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>
    <div class="particle p4"></div>
    <div class="particle p5"></div>
    <div class="particle p6"></div>
  </div>
  <div class="container hero-inner">
    <div>
      <div class="hero-eyebrow"><i class="fas fa-feather-alt"></i> <%= C('home_hero_eyebrow') %></div>
      <h1 class="hero-title"><%= C('home_hero_title') %><br/><span class="accent"><%= C('home_hero_title_accent') %></span></h1>
      <p class="hero-sub"><%= C('home_hero_sub') %></p>
      <div class="hero-cta">
        <a href="/about" class="btn btn-primary"><i class="fas fa-book-open"></i> <%= C('home_hero_btn1') %></a>
        <a href="/register" class="btn btn-outline"><i class="fas fa-user-plus"></i> <%= C('home_hero_btn2') %></a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="stat-card"><span class="stat-num" data-count="<%= C('home_stat1_num') %>">০</span><span class="stat-label"><%= C('home_stat1_label') %></span></div>
      <div class="stat-card"><span class="stat-num" data-count="<%= C('home_stat2_num') %>">০</span><span class="stat-label"><%= C('home_stat2_label') %></span></div>
      <div class="stat-card"><span class="stat-num" data-count="<%= C('home_stat3_num') %>">০</span><span class="stat-label"><%= C('home_stat3_label') %></span></div>
      <div class="stat-card"><span class="stat-num" data-count="<%= C('home_stat4_num') %>">০</span><span class="stat-label"><%= C('home_stat4_label') %></span></div>
    </div>
  </div>

<%# সেশন ৩৫: হিরোর ডান পাশের স্লাইডিং উইজেট সরানো হয়েছে — এটি হিরোর লেখা ঢেকে দিত;
এখন 'ইউজার ফিড' শোকেস সেকশনে ইন্টিগ্রেট করা হয়েছে (নিচে feed-showcase) %>
</section>

<% if (hasToday) { %>
<!-- Today's daily content — auto-shows scheduled items for today -->
<section class="section section-alt today-content reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow"><i class="far fa-calendar-alt"></i> <%= C('home_today_eyebrow') %></span>
      <h2 class="section-title"><%= C('home_today_t1') %> <span class="accent"><%= C('home_today_accent') %></span> <%= C('home_today_t2') %></h2>
      <span class="accent-divider center"></span>
      <p class="lead"><%= C('home_today_lead') %></p>
    </div>
    <div class="today-grid reveal-stagger">
      <% if (todayByType.quiz) { %>
        <a href="<%= todayByType.quiz.link_url || '/quiz' %>" class="today-card today-quiz">
          <div class="today-icon"><i class="fas fa-question-circle"></i></div>
          <h3>আজকের কুইজ</h3>
          <p class="today-title"><%= todayByType.quiz.title %></p>
          <% if (todayByType.quiz.body) { %><p class="today-body"><%= todayByType.quiz.body.substring(0, 110) %><%= todayByType.quiz.body.length > 110 ? '…' : '' %></p><% } %>
          <span class="today-cta">কুইজে অংশ নিন <i class="fas fa-arrow-right"></i></span>
        </a>
      <% } %>
      <% if (todayByType.this_day) { %>
        <a href="/on-this-day" class="today-card today-thisday">
          <div class="today-icon"><i class="fas fa-history"></i></div>
          <h3>এই দিনে</h3>
          <p class="today-title"><%= todayByType.this_day.title %></p>
          <% if (todayByType.this_day.body) { %><p class="today-body"><%= todayByType.this_day.body.substring(0, 110) %><%= todayByType.this_day.body.length > 110 ? '…' : '' %></p><% } %>
          <span class="today-cta">বিস্তারিত পড়ুন <i class="fas fa-arrow-right"></i></span>
        </a>
      <% } %>
      <% if (todayByType.activity) { %>
        <div class="today-card today-activity">
          <div class="today-icon"><i class="fas fa-running"></i></div>
          <h3>আজকের কার্যক্রম</h3>
