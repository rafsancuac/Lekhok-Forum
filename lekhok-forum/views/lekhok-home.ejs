<%# ── সাধারণ জিজ্ঞাসা (সেশন ৩৫ ফিক্স: আগে এই ব্লকটা container/section-এর বাইরে ছিল —
      তাই দুই পাশে প্যাডিং ছাড়া একদম কিনারায় লেগে যেত। এখন পূর্ণ সেকশন-কাঠামোয়) ── %>
<%# ── সেশন ৪০: সাধারণ জিজ্ঞাসা — এলিগ্যান্ট +/− অ্যাকর্ডিয়ন (কারেটেড ১৫ প্রশ্ন; ইউজার-লিংক বাদ) ── %>
<section class="section qa-section reveal" id="qa">
  <div class="container">
    <div class="section-head center">
      <div>
        <span class="eyebrow"><i class="fas fa-comments"></i> <%= C('home_qa_eyebrow') %></span>
        <h2 class="section-title"><%= C('home_qa_title') %></h2>
        <span class="accent-divider center"></span>
      </div>
    </div>
    <%
      const FAQ40 = [
        ['পত্রিকায় লেখা পাঠাতে হলে প্রথমে কী করতে হয়?', 'প্রথমে পত্রিকার নীতিমালা (submission guidelines) দেখে নিতে হয় — কোন বিভাগে (মতামত/উপসম্পাদকীয়/ফিচার) লেখা পাঠানো হচ্ছে, শব্দসীমা কত, আর কোন ইমেইলে পাঠাতে হবে। বেশিরভাগ পত্রিকার ওয়েবসাইটে "যোগাযোগ" বা "লেখা পাঠান" নামে আলাদা পাতা থাকে।'],
        ['লেখার আদর্শ শব্দসংখ্যা কত হওয়া উচিত?', 'সাধারণত কলাম/মতামত বিভাগের জন্য ৬০০-৯০০ শব্দ, ফিচারের জন্য ৮০০-১২০০ শব্দ যথেষ্ট ধরা হয়। খুব দীর্ঘ লেখা সম্পাদক প্রথমেই বাদ দিতে পারেন, তাই সংক্ষিপ্ত ও গোছানো রাখাই ভালো।'],
        ['লেখা কীভাবে ফরম্যাট করে পাঠাতে হয়?', 'সাধারণত Word ফাইল (.docx) বা প্লেইন টেক্সটে, ইউনিকোড ফন্টে (অভ্র/বিজয় না, সরাসরি ইউনিকোড বাংলা), সাথে লেখকের নাম, পরিচয় (শিক্ষার্থী/পেশা), মোবাইল নম্বর ও ইমেইল যোগ করে পাঠানো উচিত।'],
        ['লেখা প্রকাশিত হতে কতদিন সময় লাগে?', 'এটা পত্রিকাভেদে ভিন্ন — কিছু পত্রিকা ৩-৭ দিনের মধ্যে জানায়, কিছু পত্রিকা কয়েক সপ্তাহ সময় নেয়। নির্দিষ্ট সময়ের মধ্যে উত্তর না পেলে ভদ্রভাবে ফলো-আপ ইমেইল করা যায়।'],
        ['লেখা প্রত্যাখ্যাত (reject) হলে কী করণীয়?', 'হতাশ না হয়ে লেখাটা আরেকবার পড়ে দেখা উচিত — বিষয়বস্তু কতটা টাইমলি (সাম্প্রতিক প্রাসঙ্গিক), যুক্তি কতটা সুসংগঠিত। প্রয়োজনে অন্য পত্রিকায় পাঠানো যায়, তবে ভাষা/অ্যাঙ্গেল একটু পরিমার্জন করে নেওয়া ভালো।'],
        ['একই লেখা একসাথে একাধিক পত্রিকায় পাঠানো যাবে কি?', 'না, এটা লেখালেখির জগতে অশোভন (unethical) ধরা হয় এবং কিছু পত্রিকা এ কারণে ভবিষ্যতে লেখা ছাপাতে অস্বীকৃতি জানাতে পারে। একটাতে পাঠিয়ে উত্তরের জন্য অপেক্ষা করাই নিয়ম।'],
        ['ছদ্মনামে (pen name) লেখা যায় কি?', 'হ্যাঁ, অনেক পত্রিকা ছদ্মনাম গ্রহণ করে, তবে প্রকৃত পরিচয় ও যোগাযোগের তথ্য সম্পাদকীয় বিভাগকে জানাতে হয় (যাচাইয়ের জন্য) — সেটা প্রকাশিত হয় না।'],
        ['লেখার জন্য সম্মানী (honorarium) দেওয়া হয় কি?', 'কিছু বড় জাতীয় পত্রিকা প্রকাশিত লেখার জন্য সামান্য সম্মানী দেয়, তবে অনেক পত্রিকা বিশেষ করে ছাত্র-লেখকদের জন্য দেয় না। এটা প্রতিটি পত্রিকার নিজস্ব নীতির উপর নির্ভর করে — প্রকাশের আগেই জিজ্ঞাসা করে নেওয়া ভালো।'],
        ['কলাম আর প্রবন্ধের মধ্যে পার্থক্য কী?', 'কলাম সাধারণত ব্যক্তিগত মতামত/দৃষ্টিভঙ্গি নিয়ে লেখা, তুলনামূলক সংক্ষিপ্ত ও কথোপকথনধর্মী। প্রবন্ধ (essay) বেশি বিশ্লেষণাত্মক, তথ্যভিত্তিক এবং কাঠামোবদ্ধ (ভূমিকা-মূলবক্তব্য-উপসংহার)।'],
        ['লেখার মৌলিকত্ব (originality) নিয়ে নিয়ম কী?', 'লেখা অবশ্যই স্বরচিত হতে হবে — অন্য কোথাও প্রকাশিত বা কপি-করা অংশ থাকলে তা উল্লেখ (উদ্ধৃতি/তথ্যসূত্র) দিয়ে দিতে হয়। plagiarism ধরা পড়লে লেখকের বিশ্বাসযোগ্যতা স্থায়ীভাবে ক্ষতিগ্রস্ত হতে পারে।'],
        ['তথ্য-উপাত্ত ব্যবহার করলে সূত্র উল্লেখ করতে হয় কি?', 'হ্যাঁ, পরিসংখ্যান, গবেষণার ফলাফল বা উদ্ধৃতি ব্যবহার করলে সূত্র (কোথা থেকে নেওয়া) স্পষ্টভাবে উল্লেখ করা উচিত — এটা লেখার নির্ভরযোগ্যতা বাড়ায় এবং সম্পাদকীয় বিভাগের আস্থা অর্জনে সাহায্য করে।'],
        ['অনলাইন পোর্টাল ও প্রিন্ট পত্রিকায় লেখা পাঠানোর পার্থক্য কী?', 'অনলাইন পোর্টালে সাধারণত দ্রুত সিদ্ধান্ত হয় এবং তুলনামূলক নমনীয় শব্দসীমা থাকে। প্রিন্ট পত্রিকায় জায়গা সীমিত থাকায় সম্পাদনার প্রক্রিয়া কড়াকড়ি ও সময়সাপেক্ষ হতে পারে।'],
        ['লেখার সাথে ছবি/ইলাস্ট্রেশন পাঠানো যায় কি?', 'অনেক পত্রিকা নিজস্ব গ্রাফিক্স/ছবি ব্যবহার করে, তবে প্রাসঙ্গিক (কপিরাইট-মুক্ত) ছবি পাঠানো গেলে তা গৃহীত হতে পারে। নিশ্চিত না হলে সম্পাদকীয় বিভাগকে জিজ্ঞেস করে নেওয়া ভালো।'],
        ['প্রথমবার লেখা পাঠাতে যাওয়া নতুন লেখকদের জন্য পরামর্শ কী?', 'ছোট, স্পষ্ট বিষয় নিয়ে শুরু করা ভালো — নিজের অভিজ্ঞতা বা আশেপাশের সমসাময়িক বিষয় নিয়ে লিখলে স্বাভাবিকতা বজায় থাকে। জমা দেওয়ার আগে অন্তত দুইবার নিজে পড়ে ও কাউকে দিয়ে যাচাই করিয়ে নেওয়া উচিত।'],
        ['আমাদের ফোরাম (লেখক ফোরাম) এক্ষেত্রে কীভাবে সাহায্য করতে পারে?', 'আমরা সদস্যদের লেখা পর্যালোচনা (review), বানান-ব্যাকরণ সংশোধন এবং পত্রিকার উপযোগী কাঠামোয় লেখা গোছাতে সাহায্য করি। এছাড়া নিয়মিত কর্মশালা ও পিয়ার-ফিডব্যাক সেশনের মাধ্যমে নতুন লেখকদের প্রথম প্রকাশনার পথ সহজ করার চেষ্টা করি।']
      ];
      const BN40 = '০১২৩৪৫৬৭৮৯';
      const bn40 = (n) => String(n).replace(/\d/g, d => BN40[+d]);
    %>
    <div class="faq-accordion">
      <% FAQ40.forEach((f, i) => { %>
        <details class="faq-item" <%= i === 0 ? 'open' : '' %>>
          <summary class="faq-summary">
            <span class="faq-q"><span class="faq-num"><%= bn40(i + 1) %></span><span><%= f[0] %></span></span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-a"><p><%= f[1] %></p></div>
        </details>
      <% }) %>
    </div>
    <div style="text-align:center; margin-top:22px;">
      <a href="/qa" class="link-more"><%= C('home_qa_more') %> <i class="fas fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<%# ── ইউজার ফিড শোকেস (সেশন ৩৫: হিরোর স্লাইডিং উইজেট এখানেই ইন্টিগ্রেট) ── %>
<section class="section feed-showcase-section reveal" id="user-feed">
  <div class="container">
    <div class="feed-showcase">
      <% if (C('home_feed_banner')) { %><div class="fs-banner-img" style="background-image:url('<%= C('home_feed_banner') %>')"></div><% } %>
      <div class="fs-decor fs-decor-1"></div>
      <div class="fs-decor fs-decor-2"></div>
      <div class="fs-grid">
        <div class="fs-info">
          <span class="fs-eyebrow"><i class="fas fa-stream"></i> <%= C('home_feed_eyebrow') %></span>
          <h2 class="fs-title"><%= C('home_feed_title') %></h2>
          <p class="fs-lead"><%= C('home_feed_desc') %></p>
          <ul class="fs-points">
            <li><i class="fas fa-check-circle"></i> <%= C('home_feed_point1') %></li>
            <li><i class="fas fa-check-circle"></i> <%= C('home_feed_point2') %></li>
            <li><i class="fas fa-check-circle"></i> <%= C('home_feed_point3') %></li>
          </ul>
          <div class="fs-cta">
            <a href="/dashboard" class="btn fs-btn-main"><i class="fas fa-arrow-right"></i> <%= C('home_feed_btn') %></a>
            <a href="/register" class="btn fs-btn-ghost"><i class="fas fa-user-plus"></i> <%= C('home_feed_btn2') %></a>
          </div>
        </div>
        <div class="fs-side">
          <div class="fs-side-label"><i class="fas fa-bolt"></i> <%= C('home_feed_widget_label') %></div>
          <div class="fs-carousel" id="feedCarousel" aria-roledescription="carousel" aria-label="ফোরামের সার-আকর্ষণ">
            <div class="fc-track" id="fcTrack">
              <a class="fc-slide" href="/quiz">
                <span class="fc-icon"><i class="fas fa-brain"></i></span>
                <span class="fc-body"><strong>আজকের কুইজ</strong><small>প্রতিদিন নতুন প্রশ্ন, মেধা যাচাই করুন</small></span>
                <i class="fas fa-arrow-right fc-go"></i>
              </a>
              <a class="fc-slide" href="/on-this-day">
                <span class="fc-icon"><i class="fas fa-calendar-day"></i></span>
                <span class="fc-body"><strong>এই দিনে ইতিহাসে</strong><small>আজকের দিনের তাৎপর্য জেনে নিন</small></span>
                <i class="fas fa-arrow-right fc-go"></i>
              </a>
              <a class="fc-slide" href="/epaper">
                <span class="fc-icon"><i class="fas fa-newspaper"></i></span>
                <span class="fc-body"><strong>আজকের ই-পেপার</strong><small>সাহিত্য ও মতামত পাতার নির্বাচন</small></span>
                <i class="fas fa-arrow-right fc-go"></i>
              </a>
              <a class="fc-slide" href="/best-writer">
                <span class="fc-icon"><i class="fas fa-crown"></i></span>
                <span class="fc-body"><strong>মাসিক সেরা লেখক</strong><small>এই মাসের শ্রেষ্ঠ লেখক কে, দেখুন</small></span>
                <i class="fas fa-arrow-right fc-go"></i>
              </a>
            </div>
            <div class="fc-dots" id="fcDots" role="tablist" aria-label="স্লাইড নির্বাচন"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Recent notices — professional card grid -->
<section class="section section-alt reveal">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow"><i class="fas fa-bullhorn"></i> <%= C('home_notices_eyebrow') %></span>
        <h2 class="section-title"><%= C('home_notices_t1') %> <span class="accent"><%= C('home_notices_accent') %></span></h2>
        <span class="accent-divider"></span>
      </div>
      <a href="/notices" class="link-more"><%= C('home_notices_more') %> <i class="fas fa-arrow-right"></i></a>
    </div>
    <% if (recentNotices && recentNotices.length) { %>
      <div class="notice-list notice-list--home reveal-stagger">
        <% recentNotices.slice(0, 6).forEach(n => { %>
          <a href="/notices/<%= n.id %>" class="notice-row notice-row--compact">
            <span class="notice-row-icon cat-<%= n.category %>">
              <i class="fas fa-<%= n.category === 'press' ? 'bullhorn' : n.category === 'event' ? 'calendar-alt' : 'bell' %>"></i>
            </span>
            <span class="notice-row-main">
              <span class="notice-row-top">
                <span class="notice-row-title"><%= n.title %></span>
                <span class="notice-badge badge-<%= n.category %>"><%= n.category === 'press' ? 'প্রেস' : n.category === 'event' ? 'ইভেন্ট' : 'নোটিশ' %></span>
              </span>
            </span>
            <span class="notice-row-meta">
              <span class="notice-row-date"><i class="far fa-calendar"></i><%= n.date || '' %></span>
              <i class="fas fa-chevron-right notice-row-arrow"></i>
            </span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-bullhorn"></i>
        <h3>এখনও কোনো বিজ্ঞপ্তি প্রকাশিত হয়নি</h3>
        <p>নতুন বিজ্ঞপ্তি এখানে দেখা যাবে</p>
      </div>
    <% } %>
  </div>
</section>
