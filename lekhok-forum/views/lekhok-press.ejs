<header class="page-header">
  <div class="container">
    <span class="eyebrow"><%= C('press_header_eyebrow') %></span>
    <h1><%= C('press_header_title') %></h1>
    <p><%= C('press_header_sub') %></p>
  </div>
</header>

<section class="section reveal">
  <div class="container">
    <% if (clippings && clippings.length) { %>
      <div class="press-grid">
        <% clippings.forEach(c => { %>
          <div class="press-card">
            <a href="<%= c.image_url %>" target="_blank" rel="noopener" class="press-img-wrap">
              <img src="<%= c.image_url %>" alt="<%= c.title || 'পত্রিকায় আমাদের নিউজ' %>" loading="lazy" decoding="async" onerror="this.closest('.press-card').style.display='none'" />
            </a>
            <div class="press-body">
              <% if (c.title) { %><h3 class="press-title"><%= c.title %></h3><% } %>
              <% if (c.paper_name || c.published_date) { %>
                <p class="press-meta">
                  <% if (c.paper_name) { %><span><i class="far fa-newspaper"></i> <%= c.paper_name %></span><% } %>
                  <% if (c.published_date) { %><span><i class="far fa-calendar"></i> <%= c.published_date %></span><% } %>
                </p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state" style="text-align:center; padding:60px 20px;">
        <i class="far fa-newspaper" style="font-size:3rem; color:var(--text-muted,#94a3b8);"></i>
        <h3 style="margin:16px 0 8px;">এখনো কোনো কাটিং যোগ করা হয়নি</h3>
        <p style="color:var(--text-muted,#64748b);">পত্রিকায় আমাদের নিয়ে প্রকাশিত সংবাদের ছবি শীঘ্রই এখানে যুক্ত হবে।</p>
        <a href="/about" class="btn btn-primary" style="margin-top:14px;"><i class="fas fa-arrow-right"></i> পরিচিতি পেজে ফিরুন</a>
      </div>
    <% } %>
  </div>
</section>

<style>
.press-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
.press-card { background: #fff; border: 1px solid var(--border, #e2e8f0); border-radius: 14px; overflow: hidden; box-shadow: 0 2px 10px rgba(10,31,68,0.05); transition: transform .18s ease, box-shadow .18s ease; display: flex; flex-direction: column; }
.press-card:hover { transform: translateY(-4px); box-shadow: 0 10px 26px rgba(10,31,68,0.12); }
.press-img-wrap { display: block; background: #f1f5f9; aspect-ratio: 4 / 3; overflow: hidden; }
.press-img-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
.press-body { padding: 14px 16px 16px; }
.press-title { margin: 0 0 8px; font-size: 1rem; line-height: 1.55; color: var(--brand, #0a1f44); }
.press-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.85rem; color: var(--text-muted, #64748b); }
.press-meta span { display: inline-flex; align-items: center; gap: 5px; }
</style>
