<%# ═══════════════════════════════════════════════════════════════════════════
  MessengerBubble.ejs — সর্বজনীন মেসেঞ্জার-বাবল-স্ট্রিম (সেশন ১০৫ — ডিজাইন-সিস্টেম)
  ───────────────────────────────────────────────────────────────────────────
  রুল-৪ (মেসেঞ্জারের সার্বজনীন অ্যাকশন-বার):
    · বাবলের ওপরে কোনো ক্রস (✕)/আনসেন্ড-বাটন নেই — আনসেন্ড ⋮-মেনুতে
    · বাবলের ঠিক বাইরে ৩টি অনুভূমিক আইকন: স্মাইলি (React) · বাঁকানো-তীর
      (Reply) · ভার্টিক্যাল ৩-ডট (⋮ — ভেতরে আনসেন্ড ও কপি)
  বাধ্যতামূলক ব্যবহার: চ্যাট-উইন্ডো, ইনবক্স-প্রিভিউ।
  ইঞ্জিন: messenger-actions.js (.bubble-actions চুক্তি)।
  সেশন ৯৩-থেকে উত্তরাধিকার (রোডম্যাপ-১১ উইন্ডোিং): প্যারেন্ট-স্কোপে user,
  isGroup, members, other, reactionMap, clusterInfo, dateLabel, _isImg, _isAud
  থাকতে হবে (EJS include স্কোপ-শেয়ার করে)।
  প্যারাম:
    cbList          — এই-ব্যাচের মেসেজ-রো (created_at ASC)
    cbPrev          — ব্যাচের ঠিক-আগের রেন্ডারড-মেসেজ (ক্লাস্টার/ডেট-সেপ ধারাবাহিকতা) | null
    cbNext          — ব্যাচের ঠিক-পরের রেন্ডারড-মেসেজ (পুরনো-বার্তা-ব্যাচের নিচের-সীমা) | null
    cbLastOwnReadId — সর্বশেষ নিজের-পড়া-মেসেজ id (সিন-অ্যাভাটার মার্কার) | 0
%>
<%
  var _cbAll = [];
  if (cbPrev) _cbAll.push(cbPrev);
  _cbAll = _cbAll.concat(cbList || []);
  if (cbNext) _cbAll.push(cbNext);
  var _cbOff = cbPrev ? 1 : 0;
  var _prevDate = cbPrev ? (function () { var d = new Date(cbPrev.created_at); d.setHours(0, 0, 0, 0); return d; })() : null;
%>
<% for (var _ci = _cbOff; _ci < _cbOff + (cbList || []).length; _ci++) { var m = _cbAll[_ci]; var idx = _ci; %>
  <%
    var _cl = clusterInfo(_cbAll, idx);
    var _mdate = new Date(m.created_at); _mdate.setHours(0,0,0,0);
    var _showDate = !_prevDate || _mdate.getTime() !== _prevDate.getTime();
    _prevDate = _mdate;
    var _sm = isGroup ? (members || []).find(x => x.id === m.sender_id) : null;
    var _cls = 'bubble ' + (m.sender_id === user.id ? 'me' : 'them');
    if (!_cl.samePrev) _cls += ' first-of-cluster';
    if (!_cl.sameNext) _cls += ' last-of-cluster';
    else if (_cl.samePrev) _cls += ' mid-cluster';
    var _rx = (typeof reactionMap !== 'undefined' && reactionMap[m.id]) || [];
  %>
  <% if (_showDate) { %><div class="date-sep"><span><%= dateLabel(m.created_at) %></span></div><% } %>
  <div class="<%= _cls %>" data-id="<%= m.id %>" data-own="<%= m.sender_id === user.id ? 1 : 0 %>">
    <% if (m.sender_id !== user.id && !_cl.sameNext) { %>
      <img class="b-av" loading="lazy" src="<%= isGroup ? ((_sm && _sm.avatar_url) || ('/avatar/' + m.sender_id)) : (other.avatar_url || ('/avatar/' + other.id)) %>" onerror="this.src='/avatar/<%= m.sender_id %>'" alt="" />
    <% } %>
    <div class="b-content">
      <%# সেশন ৯৩(b)-মার্জ: ✕-আনসেন্ড বাটন বাদ — ⋮-মেনুতেই আনসেন্ড (রেলে জায়গা বাঁচলো) %>
      <% if (isGroup && m.sender_id !== user.id && !_cl.samePrev) { %>
      <div class="bubble-sender"><img src="<%= (_sm && _sm.avatar_url) || ('/avatar/' + m.sender_id) %>" onerror="this.src='/avatar/<%= m.sender_id %>'" alt=""><%= _sm ? _sm.full_name : 'সদস্য' %></div>
      <% } %>
      <% if (m.reply_to_id && (m.reply_body || m.reply_file_name)) { %>
      <%# সেশন ৭৬: রিপ্লাই-কোট (FB-স্টাইল রঙিন বার + প্রিভিউ) — সেশন ৯৩: ক্লিকে মূল-বার্তায় জাম্প %>
      <div class="bubble-quote" data-quote-id="<%= m.reply_to_id %>" title="মূল বার্তায় যান">
        <span class="bq-name"><%= m.reply_sender_name || 'মেসেজ' %></span>
        <span class="bq-text"><%= (m.reply_body || ((m.reply_file_name || '').match(/\.(webm|ogg|oga|m4a|mp3|wav|aac|opus)$/i) ? '🎙️ ভয়েস মেসেজ' : ('📎 ' + (m.reply_file_name || 'ফাইল')))).slice(0, 120) %></span>
      </div>
      <% } %>
      <% if (m.body) { %><div class="bubble-text"><%= m.body %></div><% if (m.edited_at) { %><span class="bubble-edited" title="সম্পাদিত মেসেজ">সম্পাদিত</span><% } %><% } %>
      <% if (m.file_url) { %>
        <% if (_isImg(m.file_url)) { %>
          <a href="<%= m.file_url %>" target="_blank" rel="noopener"><img loading="lazy" decoding="async" src="<%= m.file_url %>" alt="<%= m.file_name || 'ছবি' %>" class="bubble-image" /></a>
        <% } else if (_isAud(m.file_url)) { %>
          <%# সেশন ৯২: ভয়েস-নোট প্লেয়ার (FB-স্টাইল ওয়েভফর্ম) — সেশন ১৫৮:
              DB-সংরক্ষিত duration এখানেই data-duration + বাংলা-টাইম হিসেবে রেন্ডার
              হয় — রিফ্রেশে আর কখনো ০:০০ আসবে না। duration=০ (লেগেসি-রো) হলে
              ক্লায়েন্টের voice-probe (messages-chat.ejs) Chromium Infinity-hack
              দিয়ে আসল সময় বের করে বসায়। %>
          <% var _vdu158 = parseInt(m.duration, 10) || 0;
             var _bn158 = '০১২৩৪৫৬৭৮৯';
             function _bvBn158(n) { return String(n).replace(/\d/g, function (d) { return _bn158[d]; }); }
             var _bvTime158 = _vdu158 > 0 ? (_bvBn158(Math.floor(_vdu158 / 60)) + ':' + _bvBn158(String(_vdu158 % 60).length < 2 ? '0' + (_vdu158 % 60) : String(_vdu158 % 60))) : '০:০০'; %>
          <div class="bubble-voice" data-src="<%= m.file_url %>" data-duration="<%= _vdu158 %>">
            <button type="button" class="bv-play" aria-label="প্লে করুন"><i class="fas fa-play"></i></button>
            <div class="bv-wave" aria-hidden="true"><% (function(){ var seed = String(m.id); var x = 7; for (var i = 0; i < 22; i++) { x = (x * 31 + 17) % 97; var h = 22 + (x % 78); %><span style="--h:<%= h %>%"></span><% } })(); %></div>
            <span class="bv-time"><%= _bvTime158 %></span>
          </div>
        <% } else { %>
          <a href="<%= m.file_url %>" class="bubble-file" download="<%= m.file_name || 'file' %>">
            <i class="fas fa-paperclip"></i> <%= m.file_name || 'ফাইল' %>
          </a>
        <% } %>
      <% } %>
      <% if (_rx.length) { %><div class="bubble-reacts"><% _rx.forEach(r => { %><span title="<%= r.c %>"><%= r.emoji %><% if (r.c > 1) { %> <%= r.c %><% } %></span><% }); %></div><% } %>
    </div>
    <%# ── সেশন ৯৩(b)-মার্জ: FB-স্টাইল সাইড-অ্যাকশন-রেল — বাবলের বাইরে পাশে;
         রিপ্লাই-বাটনসহ; হোভার/ফোকাসেই দৃশ্যমান; me-বাবলে বামে, them-এ ডানে ── %>
    <div class="bubble-actions">
      <button type="button" class="bubble-react-btn" data-msg-react="<%= m.id %>" title="রিয়েক্ট করুন" aria-label="রিয়েক্ট করুন"><i class="far fa-smile"></i></button>
      <button type="button" class="bubble-reply-btn" data-msg-reply="<%= m.id %>" title="উত্তর দিন" aria-label="উত্তর দিন"><i class="fas fa-reply"></i></button>
      <button type="button" class="bubble-more" data-msg-more="<%= m.id %>" title="আরও অপশন" aria-haspopup="true" aria-label="আরও অপশন"><i class="fas fa-ellipsis-vertical"></i></button>
      <div class="bubble-react-menu" hidden><% ['👍','❤️','🤗','😂','😮','😢','😡'].forEach(e => { %><button type="button" data-emoji="<%= e %>"><%= e %></button><% }); %></div>
    </div>
    <div class="bubble-meta">
      <span class="bubble-time"><%= new Date(m.created_at).toLocaleString('bn-BD', { hour: '2-digit', minute: '2-digit' }) %></span>
      <% if (m.sender_id === user.id) { %>
        <span class="bubble-seen" data-msg-id="<%= m.id %>">
          <% if (cbLastOwnReadId && cbLastOwnReadId === m.id) { %>
            <img src="<%= other.avatar_url || ('/avatar/' + other.id) %>" alt="পড়া হয়েছে" title="পড়া হয়েছে" />
          <% } else if (m.is_read) { %>
            <i class="fas fa-check-double" title="পড়া হয়েছে"></i>
          <% } else { %>
            <i class="fas fa-check" title="পৌঁছেছে"></i>
          <% } %>
        </span>
      <% } %>
    </div>
  </div>
<% } %>
