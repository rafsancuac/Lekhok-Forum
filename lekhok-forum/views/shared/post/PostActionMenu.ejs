<%#
  ═══════════════════════════════════════════════════════════════════════════
  PostActionMenu.ejs — সর্বজনীন পোস্ট ৩-ডট মেনু (সেশন ১০৫ — ডিজাইন-সিস্টেম)
  ───────────────────────────────────────────────────────────────────────────
  রুল-১: পোস্ট-কার্ডের ডানে ৩-ডট মেনু — কেবল এই কম্পোনেন্ট থেকে।
  প্রতিটি কমেন্টের হোভার ৩-ডটেও এই .pm-ইঞ্জিন (comment-tools.js) চলে।

  প্যারামিটার (post-menu.ejs-এর সুপারসেট — পুরনো কল-সাইট অক্ষত):
    postId, editUrl, deleteUrl, isOwner, canMod, isHidden, myReport,
    reportLabel, hideConfirm, menuClass
    pin         (ঐ) {enabled:true, pinned:bool} — প্রোফাইল-পিন টগল আইটেম
    extraItems  (ঐ) HTML-স্ট্রিং (ক্যানোনিকাল-বহির্ভূত আইটেম সাধারণত নিষিদ্ধ)
  ═══════════════════════════════════════════════════════════════════════════ %>
<%
  if (typeof isOwner === 'undefined') isOwner = false;
  if (typeof canMod === 'undefined') canMod = false;
  if (typeof isHidden === 'undefined') isHidden = false;
  if (typeof myReport === 'undefined') myReport = false;
  if (typeof editUrl === 'undefined') editUrl = '/articles/' + postId + '/edit';
  if (typeof deleteUrl === 'undefined') deleteUrl = '/articles/' + postId + '/delete';
  if (typeof reportLabel === 'undefined') reportLabel = 'লেখা #' + postId;
  var _pin = (typeof pin !== 'undefined' && pin && pin.enabled) ? pin : null;
  var _hideMsg = (typeof hideConfirm !== 'undefined' && hideConfirm) ? hideConfirm
    : 'এই লেখাটি লুকিয়ে রাখতে চান? যখন-ইচ্ছে আবার প্রকাশ করতে পারবেন।';
%>
<div class="pm-wrap<%= (typeof menuClass !== 'undefined' && menuClass) ? ' ' + menuClass : '' %>" data-pm-post="<%= postId %>">
  <button type="button" class="pm-btn" aria-haspopup="menu" aria-expanded="false" aria-label="পোস্ট অপশন" title="পোস্ট অপশন">
    <i class="fas fa-ellipsis-h"></i>
  </button>
  <div class="pm-menu" role="menu" hidden>
    <% if (_pin) { %>
      <button type="button" class="pm-item pf-pin-toggle" data-post="<%= postId %>" data-pinned="<%= _pin.pinned ? 1 : 0 %>"><i class="fas fa-thumbtack"></i> <%= _pin.pinned ? 'পিন সরান' : 'পিন করুন' %></button>
      <div class="pm-sep" role="separator"></div>
    <% } %>
    <% if (isOwner) { %>
      <a class="pm-item" role="menuitem" href="<%= editUrl %>"><i class="fas fa-pen"></i> সম্পাদনা করুন</a>
      <a class="pm-item" role="menuitem" href="<%= (typeof link !== 'undefined' && link) ? link : '/articles/' + postId %>"><i class="fas fa-eye"></i> দেখুন</a>
      <% if (isHidden) { %>
        <form method="POST" action="/posts/<%= postId %>/unhide"><button type="submit" class="pm-item" role="menuitem"><i class="fas fa-eye"></i> পুনঃপ্রকাশ</button></form>
      <% } else { %>
        <form method="POST" action="/posts/<%= postId %>/hide" data-confirm92="<%= _hideMsg %>"><button type="submit" class="pm-item" role="menuitem"><i class="fas fa-low-vision"></i> টাইমলাইন থেকে লুকান</button></form>
      <% } %>
      <div class="pm-sep" role="separator"></div>
      <form method="POST" action="<%= deleteUrl %>" data-confirm92="নিশ্চিত? এই পোস্টটি স্থায়ীভাবে মুছে যাবে — আর ফেরানো যাবে না।"><button type="submit" class="pm-item pm-danger" role="menuitem"><i class="fas fa-trash"></i> মুছে ফেলুন</button></form>
    <% } else { %>
      <% if (canMod) { %>
        <% if (isHidden) { %>
          <form method="POST" action="/posts/<%= postId %>/unhide"><button type="submit" class="pm-item" role="menuitem"><i class="fas fa-eye"></i> পুনঃপ্রকাশ</button></form>
        <% } else { %>
          <form method="POST" action="/posts/<%= postId %>/hide" data-confirm92="মডারেটর হিসেবে এই লেখাটি লুকাবেন? লেখক নোটিফিকেশন পাবেন।"><button type="submit" class="pm-item" role="menuitem"><i class="fas fa-low-vision"></i> লুকান (মডারেশন)</button></form>
        <% } %>
        <a class="pm-item" role="menuitem" href="/moderator/reports"><i class="fas fa-inbox"></i> রিপোর্ট-কিউ</a>
        <div class="pm-sep" role="separator"></div>
      <% } %>
      <% if (myReport) { %>
        <span class="pm-item pm-muted" role="menuitem" aria-disabled="true"><i class="fas fa-flag"></i> রিপোর্ট করা হয়েছে</span>
      <% } else { %>
        <button type="button" class="pm-item pm-danger" role="menuitem" data-report-type="post" data-report-id="<%= postId %>" data-report-label="<%= reportLabel %>"><i class="far fa-flag"></i> রিপোর্ট করুন</button>
      <% } %>
    <% } %>
  </div>
</div>
