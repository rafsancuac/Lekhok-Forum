<%#
  ═══════════════════════════════════════════════════════════════════════════
  PostFooterActions.ejs — সর্বজনীন পোস্ট/কমেন্ট ফুটার (সেশন ১০৫ — ডিজাইন-সিস্টেম)
  ───────────────────────────────────────────────────────────────────────────
  রুল-১/রুল-৪ বাস্তবায়ন: সব পোস্ট-কার্ডের নিচে এই ফুটারই থাকবে —
    · কাউন্টার-বার: বামে রিঅ্যাকশন-ফেসপাইল+ইমোজি+মোট (ক্লিকে রিঅ্যাক্টরস-মডাল),
      ডানে "২ 💬 ২০ ↪️" স্ট্যাট
    · অ্যাকশন-রো: লাইক (hold+slide পিকার) / কমেন্ট / শেয়ার / সেভ
    · শেয়ার-মেনুর ৩টি ফিক্সড অ্যাকশন: ① টাইমলাইনে শেয়ার করুন ② মেসেজে পাঠান
      ③ পোস্টের লিংক কপি করুন
    · রিঅ্যাক্টরস-মডাল প্রতি-পেজে-একবার ReactorsModal.ejs include করতে হবে
  ইঞ্জিন-চুক্তি: main.js রিঅ্যাকশন-ইঞ্জিন (.react-wrap/.reaction-summary) ও
  LekhokShare (.share-wrap/.share-menu) — ক্লাস-নাম অপরিবর্তিত রাখা বাধ্যতামূলক।

  প্যারামিটার (পুরনো actions-bar.ejs-এর সুপারসেট — সব পুরনো কল-সাইট অক্ষত):
    targetId, targetType ('post'|'comment'), counts, mine, link,
    bookmarked, showBookmark, showShare, commentCount, shareCount, viewCount,
    reactorFaces, inlineComments
    currentUser (ঐ) — include-স্কোপে 'user' থাকলে সেটাই ব্যবহার হয়
    rxUsers     (ঐ) রিঅ্যাক্টর-মোডাল ডেটা সার্ভার-সাইডে থাকলে (সাধারণত লেজি-ফেচ)
  ═══════════════════════════════════════════════════════════════════════════ %>
<%
  if (typeof showBookmark === 'undefined') showBookmark = true;
  if (typeof showShare === 'undefined') showShare = true;
  if (typeof bookmarked === 'undefined') bookmarked = false;
  if (typeof commentCount === 'undefined') commentCount = 0;
  if (typeof shareCount === 'undefined') shareCount = 0;
  if (typeof reactorFaces === 'undefined') reactorFaces = [];
  if (typeof inlineComments === 'undefined') inlineComments = false;
  var _me = (typeof currentUser !== 'undefined' && currentUser) ? currentUser
          : ((typeof user !== 'undefined') ? user : null);
  var _meta = { like: '👍', love: '❤️', care: '🤗', haha: '😂', wow: '😮', sad: '😢', angry: '😡' };
  var _labels = { like: 'লাইক', love: 'ভালোবাসা', care: 'কেয়ার', haha: 'হাহা', wow: 'বিস্ময়', sad: 'দুঃখ', angry: 'রাগ' };
  var _topEmojis = Object.entries(counts || {}).filter(function (e) { return e[1] > 0; }).sort(function (a, b) { return b[1] - a[1]; }).slice(0, 3).map(function (e) { return _meta[e[0]]; });
  var _total = Object.values(counts || {}).reduce(function (a, b) { return a + (b || 0); }, 0);
%>
<div class="actions-block">
  <div class="actions-bar">
    <% if (targetType === 'post') { %>
    <div class="actions-summary">
      <span class="as-left">
        <%# কাউন্টার-বার (বাম) — ক্লিকে রিঅ্যাক্টরস-মডাল (data-rx-open; comment-tools.js)।
            span[role=button] — main.js-ইঞ্জিনের display:contents-চুক্তি অক্ষুণ্ণ রাখতে। %>
        <span class="reaction-summary as-rx-trigger" role="button" tabindex="0" data-rx-open="post" data-rx-id="<%= targetId %>" aria-label="রিঅ্যাক্টরদের দেখুন">
          <span class="rs-faces"<% if (!reactorFaces.length) { %> hidden<% } %>><% reactorFaces.forEach(function (f) { %><img loading="lazy" decoding="async" class="rsf-av" src="<%= f.avatar_url || '/avatar/' + f.id %>" alt="" data-uid="<%= f.id %>" title="<%= (f.pen_name || f.full_name || '') %>" onerror="this.style.display='none'"><% }); %></span><span class="as-emojis rs-emojis"><% if (_total > 0) { _topEmojis.forEach(function (em) { %><span><%= em %></span><% }); } %></span><span class="as-count rs-count"><% if (_total > 0) { %><%= _total %><% } %></span>
        </span>
      </span>
      <span class="as-right">
        <% if (inlineComments) { %>
        <button type="button" class="as-stat as-stat-btn" title="মন্তব্য" data-toggle-comments="<%= targetId %>"><span><%= commentCount || 0 %></span><i class="far fa-comment"></i></button>
        <% } else { %>
        <a href="<%= link %>#comments" class="as-stat" title="মন্তব্য"><span><%= commentCount || 0 %></span><i class="far fa-comment"></i></a>
        <% } %>
        <%# সেশন ১০৫-মার্জ (session105-parallel): শেয়ার-কাউন্ট সর্বদা দৃশ্যমান (FB-রেফারেন্স: 20 ↪️) %>
        <span class="as-stat" title="শেয়ার"><span><%= shareCount || 0 %></span><i class="fas fa-share"></i></span>
        <% if (typeof viewCount !== 'undefined' && viewCount !== null && viewCount !== '') { %><span class="as-stat" title="পঠিত"><span><%= viewCount %></span><i class="far fa-eye"></i></span><% } %>
      </span>
    </div>
    <% } %>
    <div class="react-wrap" data-target-id="<%= targetId %>" data-target-type="<%= targetType %>">
      <div class="reaction-picker" role="menu" aria-label="প্রতিক্রিয়া নির্বাচন">
        <% Object.keys(_meta).forEach(function (k) { %>
          <button type="button" class="reaction-opt<%= mine === k ? ' selected' : '' %>" data-reaction="<%= k %>" title="<%= _labels[k] %>"><%= _meta[k] %></button>
        <% }); %>
      </div>
      <button type="button" class="reaction-btn main-react <%= mine ? 'active' : '' %>" data-mine="<%= mine || '' %>" aria-label="প্রতিক্রিয়া দিন">
        <span class="rb-emoji"><%= mine ? _meta[mine] : '👍' %></span>
        <span class="rb-label"><%= mine ? _labels[mine] : 'লাইক' %></span>
      </button>
    </div>

    <% if (inlineComments) { %>
    <button type="button" class="reaction-btn" data-toggle-comments="<%= targetId %>"><i class="far fa-comment"></i> মন্তব্য</button>
    <% } else { %>
    <a class="reaction-btn" href="<%= link %>#comments"><i class="far fa-comment"></i> মন্তব্য</a>
    <% } %>

    <% if (showShare) { %>
    <div class="share-wrap">
      <%# রুল-৪ + session105-parallel-মার্জ: FB-স্পেক — একটিই শেয়ার-বাটন, ক্লিকে ঠিক ৩টি
          ফিক্সড-অপশনসহ সাবটাইটেল-মেনু (smx-* স্টাইল style.css session105-ব্লক)।
          অন্য কিছু যোগ/বিয়োগ নিষিদ্ধ। main.js LekhokShare-হ্যান্ডলার অপরিবর্তিত। %>
      <button type="button" class="reaction-btn share-trigger" aria-haspopup="menu" title="শেয়ার অপশন">
        <i class="fas fa-share"></i> <span>শেয়ার</span>
      </button>
      <div class="share-menu share-menu--fb" role="menu" data-share-url="<%= typeof link !== 'undefined' ? link : '' %>" data-share-post="<%= targetType === 'post' ? targetId : '' %>">
        <% if (_me && targetType === 'post') { %>
        <button type="button" class="smx-item" data-share="timeline" role="menuitem">
          <span class="smx-ico"><i class="fas fa-retweet"></i></span>
          <span class="smx-txt"><strong>টাইমলাইনে শেয়ার করুন</strong><small>এখনই আপনার ফিডে প্রকাশ করুন</small></span>
        </button>
        <button type="button" class="smx-item" data-share="user" role="menuitem">
          <span class="smx-ico"><i class="far fa-paper-plane"></i></span>
          <span class="smx-txt"><strong>মেসেজে পাঠান</strong><small>বন্ধুদের ইনবক্সে ফরোয়ার্ড করুন</small></span>
        </button>
        <% } else if (targetType === 'post') { %>
        <a class="smx-item" href="/login" role="menuitem">
          <span class="smx-ico"><i class="fas fa-retweet"></i></span>
          <span class="smx-txt"><strong>টাইমলাইনে শেয়ার করুন</strong><small>শেয়ার করতে লগইন করুন</small></span>
        </a>
        <% } %>
        <button type="button" class="smx-item" data-share="copy" role="menuitem">
          <span class="smx-ico"><i class="fas fa-link"></i></span>
          <span class="smx-txt"><strong>পোস্টের লিংক কপি করুন</strong><small>সরাসরি শেয়ার করার জন্য</small></span>
        </button>
      </div>
    </div>
    <% } %>

    <% if (showBookmark && _me) { %>
    <button type="button" class="reaction-btn bookmark-btn <%= bookmarked ? 'active' : '' %>" data-bookmark-id="<%= targetId %>" aria-label="সংরক্ষণ">
      <i class="<%= bookmarked ? 'fas' : 'far' %> fa-bookmark"></i>
    </button>
    <% } %>
  </div>
</div>
