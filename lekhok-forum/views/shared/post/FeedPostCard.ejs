<%#
  ═══════════════════════════════════════════════════════════════════════════
  FeedPostCard.ejs — সর্বজনীন পোস্ট-কার্ড (সেশন ১০৫ — ডিজাইন-সিস্টেম কম্পোনেন্ট)
  ───────────────────────────────────────────────────────────────────────────
  রুল-১ (সার্বজনীন গঠন): উপরে বামে অ্যাভাটার+AuthorLabel, ডানে PostActionMenu;
  মাঝে কনটেন্ট+মিডিয়া-গ্রিড; নিচে PostFooterActions; ড্রয়ার বন্ধ থাকলে কেবল
  ১টি প্রিভিউ-কমেন্ট, খুললে প্রিভিউ-গায়েব → সম্পূর্ণ-থ্রেড।

  বাধ্যতামূলক ব্যবহার: /dashboard (ফিড), /profile/[id] (পিনড+টাইমলাইন),
  /me (আমার-লেখা ট্যাব), একক-পোস্টের ফিড-সমতুল্য ভিউ।

  প্যারামিটার:
    item            (必) পোস্ট-অবজেক্ট। সমর্থিত ক্ষেত্র:
                      id, item_type|type ('article'|'question'|'activity'|'repost'),
                      title, body, excerpt, cover_image, images[], link,
                      username, author_name|display_name|full_name, pen_name,
                      avatar_url, author_role, created_at|published_at,
                      comment_count, share_count, view_count,
                      reactionCounts, myReaction, reactorFaces,
                      commentPreviews (১টিই রেন্ডার হবে — রুল-১),
                      repost-*: repost_note, original{...}
    user            (ঐ) লগইন-ইউজার
    myBookmarkedIds (ঐ) বুকমার্ক-করা পোস্ট-আইডি-অ্যারে
    opts            (ঐ) { cardClass, pinnedLabel, showPin, showDrawer,
                          showPreview, repostUndo }
  ═══════════════════════════════════════════════════════════════════════════ %>
<%
  var _o = (typeof opts !== 'undefined' && opts) ? opts : {};
  var _user = (typeof user !== 'undefined') ? user : null;
  var _bmk = (typeof myBookmarkedIds !== 'undefined' && myBookmarkedIds) ? myBookmarkedIds : [];
  var _type = item.item_type || item.type || 'article';
  var _isRepost = _type === 'repost' && item.original;
  var _link = item.link || (_type === 'question' ? '/qa/' + item.id : '/articles/' + item.id);
  var _ts = item.published_at || item.created_at;
  var _cardClass = 'feed-card card' + (_o.cardClass ? ' ' + _o.cardClass : '') + (_isRepost ? ' repost-card' : '');
  var _canMod = !!(_user && /moderator|admin/.test(String(_user.role || '')));
  var _isOwner = !!(_user && item.username === _user.username);
  var _showDrawer = (typeof _o.showDrawer === 'undefined') ? true : !!_o.showDrawer;
  var _showPreview = (typeof _o.showPreview === 'undefined') ? true : !!_o.showPreview;
  var _bmkOn = _bmk.indexOf ? _bmk.indexOf(item.id) !== -1 : false;
%>
<% if (_isRepost) { %>
  <%# ── রিপোস্ট-কার্ড: শেয়ারকারীর হেডার + মূল-পোস্ট ভেতরে ── %>
  <article class="<%= _cardClass %>" data-repost-id="<%= item.id %>">
    <div class="feed-card-head">
      <%- include('../user/AuthorLabel', { u: item, timeIso: item.created_at }) %>
      <span class="feed-type-badge repost"><i class="fas fa-share"></i> শেয়ার</span>
      <% if (_user && item.username === _user.username && _o.repostUndo !== false) { %>
        <button type="button" class="btn-icon repost-undo" data-repost-id="<%= item.id %>" title="শেয়ার প্রত্যাহার"><i class="fas fa-times"></i></button>
      <% } %>
    </div>
    <% if (item.repost_note) { %><div class="repost-note"><%= item.repost_note %></div><% } %>
    <div class="repost-original card-inner">
      <% var _orig = item.original; %>
      <div class="feed-card-head">
        <%# সেশন ১৬৪: FB-নেস্টেড-বক্স — ভেতরের কার্ডে টাইপ-ব্যাজ নেই (শুধু লেখক+সময়);
            গৃহীত-উত্তর সিগন্যাল মেটা-সাবটাইটেলে; metaHtml:'' = বাইরের _meta164-লিক-প্রতিরোধ %>
        <% var _omi164 = [];
           if (_orig.type === 'question' && _orig.accepted_comment_id != null) { _omi164.push('<span class="lf-mi164 is-acc164" title="এই প্রশ্নের একটি উত্তর গৃহীত হয়েছে"><i class="fas fa-circle-check" aria-hidden="true"></i> গৃহীত উত্তর</span>'); } %>
        <%- include('../user/AuthorLabel', { u: _orig, timeIso: _orig.published_at || _orig.created_at, metaHtml: _omi164.join('') }) %>
        <%- include('./PostActionMenu', {
          postId: _orig.id,
          editUrl: (_orig.type === 'question' ? '/qa/' : '/articles/') + _orig.id + '/edit',
          deleteUrl: (_orig.type === 'question' ? '/qa/' : '/articles/') + _orig.id + '/delete',
          isOwner: !!(_user && _orig.username === _user.username),
          canMod: _canMod,
          reportLabel: 'লেখা: ' + String(_orig.title || '').slice(0, 60)
        }) %>
      </div>
      <% if (_orig.cover_image) { %>
        <a href="<%= _orig.link || (_orig.type === 'question' ? '/qa/' + _orig.id : '/articles/' + _orig.id) %>"><img loading="lazy" decoding="async" onload="this.classList.add('ld')" src="<%= _orig.cover_image %>" class="feed-image img-skel" alt=""></a>
      <% } %>
      <div class="feed-card-body">
        <h3 class="feed-title"><a href="<%= _orig.link || (_orig.type === 'question' ? '/qa/' + _orig.id : '/articles/' + _orig.id) %>"><%= _orig.title %></a></h3>
        <%# সেশন ১৪৩: mdFeed — খালি-URL ক্লিকযোগ্য (a.a-link) → og-ইঞ্জিন পোস্ট-বডিতেও কার্ড (RAW-আউটপুট — হেল্পার escape-first) %>
        <p class="feed-text"><%- mdFeed(_orig.body || '', 280) %><% if ((_orig.body || '').length > 280) { %> <a href="<%= _orig.link %>">আরও পড়ুন</a><% } %></p>
      </div>
      <%- include('./PostFooterActions', {
        targetId: _orig.id, targetType: 'post',
        counts: _orig.reactionCounts, mine: _orig.myReaction,
        link: _orig.link || (_orig.type === 'question' ? '/qa/' + _orig.id : '/articles/' + _orig.id),
        commentCount: _orig.comment_count || 0, shareCount: _orig.share_count || 0,
        bookmarked: _bmk.indexOf(_orig.id) !== -1,
        reactorFaces: _orig.reactorFaces || [], inlineComments: true
      }) %>
      <% if (_showDrawer) { %>
      <div class="fc-drawer" data-comments-for="<%= _orig.id %>" hidden>
        <div class="fc-list"></div>
        <% if (_user) { %><%- include('../comment/CommentComposer', { user: _user, postId: _orig.id }) %><% } %>
      </div>
      <% } %>
    </div>
  </article>
<% } else if (item.shared_from && item.shared_orig) { %>
  <%# ── সেশন ১৪৭: FB-নেস্টেড শেয়ার-কার্ড (ছবি-৬ আর্কিটেকচার) ──
      শেয়ারকারীর হেডার + (repost_note ক্যাপশন) + ভেতরে মূল-পোস্টের বর্ডারড
      মিনি-কার্ড + নিচে গ্লোবাল ফুটার (লাইক/কমেন্ট/শেয়ার টার্গেট = শেয়ার-কপি)।
      পুরনো ফুল-কপি রেন্ডার শুধু shared_orig-অনুপস্থিতির ফলব্যাকে (লিগেসি-ডিপ্লয়)। %>
  <% var _so147 = item.shared_orig; %>
  <article class="<%= _cardClass %> share-nested147" data-post-id="<%= item.id %>" data-shared-from="<%= item.shared_from %>">
    <div class="feed-card-head">
      <%- include('../user/AuthorLabel', { u: item, timeIso: item.created_at }) %>
      <span class="feed-type-badge repost"><i class="fas fa-share"></i> শেয়ার</span>
      <%- include('./PostActionMenu', {
        postId: item.id,
        editUrl: '/articles/' + item.id + '/edit',
        deleteUrl: '/articles/' + item.id + '/delete',
        isOwner: _isOwner,
        canMod: _canMod,
        reportLabel: 'শেয়ার: ' + String(_so147.title || '').slice(0, 60)
      }) %>
    </div>
    <%# শেয়ারকারীর নিজস্ব ক্যাপশন (মন্তব্য-সহ-শেয়ার — repost_note) %>
    <% if (item.repost_note) { %><p class="repost-note share-note147"><%= item.repost_note %></p><% } %>

    <%# ভেতরের আসল পোস্ট — FB-বর্ডারড নেস্টেড মিনি-কার্ড %>
    <div class="repost-original share-orig147">
      <div class="feed-card-head">
        <%# সেশন ১৬৪: FB-নেস্টেড-বক্স — ভেতরে শুধু লেখক+সময় (টাইপ-ব্যাজ বিলোপ); metaHtml:'' = লিক-প্রতিরোধ %>
        <%- include('../user/AuthorLabel', { u: _so147, timeIso: _so147.published_at || _so147.created_at, metaHtml: '' }) %>
      </div>
      <% if (_so147.cover_image) { %>
        <a href="/articles/<%= _so147.id %>"><img loading="lazy" decoding="async" onload="this.classList.add('ld')" src="<%= _so147.cover_image %>" class="feed-image img-skel" alt=""></a>
      <% } %>
      <div class="feed-card-body">
        <h3 class="feed-title"><a href="/articles/<%= _so147.id %>"><%= _so147.title %></a></h3>
        <p class="feed-text"><%- mdFeed(_so147.excerpt || _so147.body || '', 200) %></p>
      </div>
      <a class="share-orig-link147" href="/articles/<%= _so147.id %>">মূল পোস্ট দেখুন <i class="fas fa-angle-right" aria-hidden="true"></i></a>
    </div>

    <%# গ্লোবাল সেন্ট্রাল ফুটার — টার্গেট = শেয়ার-কপি (FB-স্ট্যান্ডার্ড) %>
    <%- include('./PostFooterActions', {
      targetId: item.id, targetType: 'post',
      counts: item.reactionCounts, mine: item.myReaction,
      link: '/articles/' + item.id,
      commentCount: item.comment_count || 0, shareCount: item.share_count || 0,
      bookmarked: _bmkOn,
      reactorFaces: item.reactorFaces || [], inlineComments: _showDrawer
    }) %>
    <% if (_showDrawer) { %>
    <div class="fc-drawer" data-comments-for="<%= item.id %>" hidden>
      <div class="fc-list"></div>
      <% if (_user) { %><%- include('../comment/CommentComposer', { user: _user, postId: item.id }) %><% } %>
    </div>
    <% } %>
  </article>
<% } else { %>
  <%# ── সাধারণ পোস্ট-কার্ড ── %>
  <article class="<%= _cardClass %>"<%= item.is_pinned ? ' data-pinned-post="' + item.id + '"' : '' %>>
    <% if (_o.pinnedLabel) { %><div class="pf-pinned-label"><i class="fas fa-thumbtack"></i> <%= _o.pinnedLabel %></div><% } %>
    <div class="feed-card-head">
      <%# সেশন ১৬৪ (ইউজার-স্পেক FB-কম্প্যাক্ট-কার্ড): হেডার সম্পূর্ণ ব্যাজ-শূন্য —
          feed-type-badge (কার্যক্রম/লেখা/প্রশ্ন) + ucs158-cat-chip (কলাম) + rt-chip (২ মিনিট) +
          fd-rank-chip + fb-aud-chip153 সব হেডার-বিলোপ; ডানপাশে শুধুই PostActionMenu (৩-ডট)।
          সব মেটা এখন লেখকের সময়-লাইনের সিবলিং lf-meta164-এ (FB-সাবটাইটেল:
          'তারিখ • 🌍 • কলাম • ২ মিনিট পড়া') — reltime textContent-বিলোপ-সুরক্ষায়
          data-ts-এর ভেতরে নয় (AuthorLabel metaHtml-চুক্তি দেখুন)।
          ⚠️ include-data-লিক: FeedPostCard-স্কোপের metaHtml নিচের প্রতিটি AuthorLabel
          include-এ স্পষ্টভাবে পাস/খালি-করা হয় (EJS parent-scope-merge)। %>
      <% var _cat164 = String(item.category || '').toLowerCase();
         var _catLbl164 = ({ essay:'প্রবন্ধ', story:'গল্প', short_story:'অনুগল্প', column:'কলাম', poem:'কবিতা',
                             letter:'চিঠি', review:'বই পর্যালোচনা', humor:'রম্যরচনা',
                             grammar:'ভাষা ও ব্যাকরণ', writing_style:'লেখার কৌশল', literature_history:'সাহিত্য ও ইতিহাস' })[_cat164]; %>
      <% var _mi164 = [];
         if (item.audience === 'ONLY_ME') { _mi164.push('<span class="lf-mi164" title="দৃশ্যমানতা: শুধুমাত্র আমি"><i class="fas fa-lock" aria-hidden="true"></i></span>'); }
         else if (item.audience === 'FRIENDS') { _mi164.push('<span class="lf-mi164" title="দৃশ্যমানতা: বন্ধুরা"><i class="fas fa-user-friends" aria-hidden="true"></i></span>'); }
         else { _mi164.push('<span class="lf-mi164" title="পাবলিক"><i class="fas fa-globe" aria-hidden="true"></i></span>'); }
         if (_catLbl164) { _mi164.push('<span class="lf-mi164">' + _catLbl164 + '</span>'); }
         if (item.read_mins) { _mi164.push('<span class="lf-mi164">' + toBn(item.read_mins) + ' মিনিট পড়া</span>'); }
         if (_type === 'question' && item.accepted_comment_id != null) { _mi164.push('<span class="lf-mi164 is-acc164" title="এই প্রশ্নের একটি উত্তর গৃহীত হয়েছে"><i class="fas fa-circle-check" aria-hidden="true"></i> গৃহীত উত্তর</span>'); }
         if (typeof sort !== 'undefined' && sort === 'ranked' && item.rank_badge === 'followed') { _mi164.push('<span class="lf-mi164" title="আপনি এই লেখককে অনুসরণ করেন — সামঞ্জস্য-বোনাস"><i class="fas fa-user-check" aria-hidden="true"></i> অনুসৃত লেখক</span>'); }
         else if (typeof sort !== 'undefined' && sort === 'ranked' && item.rank_badge === 'hot') { _mi164.push('<span class="lf-mi164" title="উচ্চ-এনগেজমেন্ট: রিঅ্যাকশন+মন্তব্য+শেয়ার ≥ ১০"><i class="fas fa-fire" aria-hidden="true"></i> আলোচিত</span>'); }
         else if (typeof sort !== 'undefined' && sort === 'ranked' && item.rank_badge === 'fresh') { _mi164.push('<span class="lf-mi164" title="গত ২৪ ঘণ্টায় প্রকাশিত"><i class="fas fa-bolt" aria-hidden="true"></i> নতুন</span>'); }
         if (item.shared_from) { _mi164.push('<span class="lf-mi164"><a href="/articles/' + String(item.shared_from).replace(/[^a-zA-Z0-9_-]/g, '') + '">শেয়ারকৃত পোস্ট</a></span>'); }
         var _meta164 = _mi164.join(''); %>
      <% if (item.username === 'moderator' && !item.avatar_url) { %>
        <span class="lf-author-label">
          <img loading="lazy" decoding="async" src="/assets/img/avatar-placeholder.svg" class="lf-author-avatar lf-av-md" alt="">
          <span class="lf-author-main"><span class="lf-author-name-row"><span class="lf-author-name">মডারেটর</span><span class="verified-badge"><i class="fas fa-check-circle"></i></span></span>
          <span class="lf-time-row164"><span class="lf-author-time" data-ts="<%= new Date(_ts).toISOString() %>"><i class="far fa-clock"></i> <%= new Date(_ts).toLocaleString('bn-BD') %></span><% if (_meta164) { %><span class="lf-meta164"><%- _meta164 %></span><% } %></span></span>
        </span>
      <% } else { %>
        <%- include('../user/AuthorLabel', { u: item, timeIso: _ts, timeText: (typeof bnRelTime !== 'undefined' && item.published_at && _o.profileMode) ? bnRelTime(item.published_at) : undefined, metaHtml: _meta164 }) %>
      <% } %>
      <%- include('./PostActionMenu', {
        postId: item.id,
        editUrl: (_type === 'question' ? '/qa/' : '/articles/') + item.id + '/edit',
        deleteUrl: (_type === 'question' ? '/qa/' : '/articles/') + item.id + '/delete',
        isOwner: !!(_isOwner && (_type === 'article' || _type === 'question')),
        canMod: _canMod,
        pin: (_o.showPin && _isOwner && (_type === 'article')) ? { enabled: true, pinned: !!item.is_pinned } : null,
        reportLabel: 'লেখা: ' + String(item.title || '').slice(0, 60)
      }) %>
    </div>
    <%# সেশন ১৫৩: FB-রিচ-কম্পোজার-পোস্ট — rich_content থাকলে FB-বডি (শিরোনাম-বিহীন
        ইনলাইন-কনটেন্ট + 'Aa' গ্রেডিয়েন্ট + ইন্টেলিজেন্ট-কোলাজ)। HTML লেখার-সময়েই
        সার্ভার-স্যানিটাইজড (helpers/rich-sanitize.js) — RAW আউটপুট নিরাপদ। %>
    <% if (item.rich_content) { %>
      <% if (item.feeling || item.location) { %>
        <div class="fb-context153">
          <% if (item.feeling) { %><span class="fb-context-chip153"><i class="far fa-smile" aria-hidden="true"></i> <%= item.feeling %></span><% } %>
          <% if (item.location) { %><span class="fb-context-chip153"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> <%= item.location %></span><% } %>
        </div>
      <% } %>
      <% if (item.background_color) { %>
        <%# গ্রেডিয়েন্ট-কী সার্ভার-হোয়াইটলিস্টেড (fbg1..fbg8) — তবু রেন্ডার-গার্ড দ্বিতীয়-স্তর %>
        <% var _bgKey = ['fbg1','fbg2','fbg3','fbg4','fbg5','fbg6','fbg7','fbg8'].indexOf(String(item.background_color)) !== -1 ? String(item.background_color) : null; %>
        <div class="<%= _bgKey ? 'fb-bg153 fb-bg153-' + _bgKey : '' %>">
          <div class="fb-rich153 fb-rich-center153"><%- item.rich_content %></div>
        </div>
      <% } else { %>
        <div class="fb-rich153"><%- item.rich_content %></div>
      <% } %>
      <%- include('../../partials/fb-media-collage', { media: item.media153, alt: item.title, link: _link, group: 'fb153-' + _type + '-' + item.id }) %>
    <% } else { %>
    <%# মিডিয়া: গ্যালারি-গ্রিড অগ্রাধিকার, নইলে প্রচ্ছদ (প্রোফাইল-মোড) %>
    <% if (item.images && item.images.length) { %>
      <%- include('../../partials/post-gallery', { images: item.images, alt: item.title, height: '260px', group: 'feed-' + _type + '-' + item.id }) %>
    <% } else if (item.cover_image && _o.profileMode) { %>
      <a href="<%= _link %>" class="pf-post-cover-link"><img loading="lazy" decoding="async" src="<%= item.cover_image %>" alt="<%= item.title %>" class="pf-post-cover"></a>
    <% } %>
    <div class="feed-card-body">
      <h3 class="feed-title"><a href="<%= _link %>"><%= item.title %></a></h3>
      <%# সেশন ১৪৩: mdFeed — খালি-URL ক্লিকযোগ্য (a.a-link) → og-ইঞ্জিন পোস্ট-বডিতেও কার্ড (RAW-আউটপুট — হেল্পার escape-first) %>
      <p class="feed-text"><%- mdFeed(item.excerpt || item.body || '', 280) %><% if (((item.body || '').length) > 280) { %> <a href="<%= _link %>">আরও পড়ুন</a><% } %></p>
    </div>
    <% } %>
    <%- include('./PostFooterActions', {
      targetId: item.id, targetType: 'post',
      counts: item.reactionCounts, mine: item.myReaction,
      link: _link,
      commentCount: item.comment_count || 0,
      shareCount: item.share_count || 0,
      viewCount: (typeof item.view_count !== 'undefined' && item.view_count !== null) ? item.view_count : undefined,
      bookmarked: _bmkOn,
      reactorFaces: item.reactorFaces || [],
      inlineComments: _showDrawer && _type !== 'activity'
    }) %>
    <%# ── রুল-১: ড্রয়ার বন্ধ থাকলে কেবল ১টি প্রিভিউ-কমেন্ট; খুললে প্রিভিউ-গায়েব ── %>
    <% if (_showPreview && _type !== 'activity' && item.commentPreviews && item.commentPreviews.length) { %>
      <div class="fc-preview">
        <% var _cp = item.commentPreviews[0]; %>
        <div class="fcp-row">
          <a href="/profile/<%= _cp.username %>" class="fcp-av-link" aria-hidden="true" tabindex="-1">
            <img loading="lazy" decoding="async" src="<%= _cp.avatar %>" class="fcp-avatar" alt="" onerror="this.src='/assets/img/avatar-placeholder.svg?v=2'">
          </a>
          <div class="fcp-main">
            <div class="fcp-bubble">
              <a href="/profile/<%= _cp.username %>" class="fcp-author"><%= _cp.authorName %></a>
              <span class="fcp-body"><%= _cp.body %></span>
            </div>
            <div class="fcp-actions">
              <button type="button" class="fcp-act" data-toggle-comments="<%= item.id %>">মন্তব্য করুন</button>
              <span class="fcp-act muted">সর্বশেষ</span>
            </div>
          </div>
        </div>
        <% if ((item.comment_count || 0) > 1) { %>
          <button type="button" class="fc-more" data-toggle-comments="<%= item.id %>">
            সব <%= toBn(item.comment_count) %> টি মন্তব্য দেখুন
          </button>
        <% } %>
      </div>
    <% } %>
    <% if (_showDrawer && _type !== 'activity') { %>
      <div class="fc-drawer" data-comments-for="<%= item.id %>" hidden>
        <div class="fc-list"></div>
        <% if (_user) { %><%- include('../comment/CommentComposer', { user: _user, postId: item.id }) %><% } %>
      </div>
    <% } %>
  </article>
<% } %>
