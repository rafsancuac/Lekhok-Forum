  /* সাবমিট → AJAX সেভ (সেশন ১৯৩) — sections.ejs-এর sec-ajax-প্যাটার্নের মিরর।
     সাধারণ form-POST প্রিভিউ-গেটওয়েতে XTransformPort হারায়, তাই fetch-ই চুক্তি। */
  var hrForm = document.getElementById('hrForm');
