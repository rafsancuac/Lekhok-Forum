      try { sessionStorage.removeItem(HR321_KEY); } catch (e323a) { q323h.err = String((e323a && e323a.message) || e323a); }
      ptr320 = ''; /* s320-পয়েন্টার-বিলোপ — স্টেল-পুনঃকপি-রোধ */
      tipRender318(tipBtn317 ? (tipBtn317.getAttribute('data-copy') || '') : ''); /* এক-উৎস-রিফ্রেশ */
      tipHide317(); /* বিলোপ-পরবর্তী বন্ধ — পুনঃহোভার/পুনঃফোকাসে সতেজ-শূন্য-টুলটিপ */
      q322c.cleared += 1; /* s322-QA-গণনা (উভয়-পথ-একই-গণনা — s322-suite-চুক্তি-অটুট) */
      showToast(true, 'কপি-ইতিহাস মুছে ফেলা হয়েছে');
    } catch (e323b) { q323h.err = String((e323b && e323b.message) || e323b); }
  };
