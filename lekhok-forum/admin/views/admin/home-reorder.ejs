    if (s317 < 60) return 'এইমাত্র';
    if (s317 < 3600) return bn317a(Math.floor(s317 / 60)) + ' মিনিট আগে';
    if (s317 < 86400) return bn317a(Math.floor(s317 / 3600)) + ' ঘণ্টা আগে';
    return bn317a(Math.floor(s317 / 86400)) + ' দিন আগে';
  };
  var lastFor317 = function (k317) {
    for (var i317 = 0; i317 < hist317.length; i317++) { if (hist317[i317].key === k317) return hist317[i317]; }
    return null;
  };
  var tipText317 = function (k317) {
    var h317 = lastFor317(k317);
    if (!h317) return 'এখনো কপি হয়নি';
    return 'সর্বশেষ কপি: ' + h317.key + (h317.n > 1 ? ' · ' + bn317a(h317.n) + ' বার' : '') + ' · ' + ago317(h317.at);
  };
  /* সেশন ৩১৮ (hr318): টুলটিপে সম্পূর্ণ-ইতিহাস-তালিকা (PLANS session317-নোটের প্রস্তাব-③)
     • দ্বি-স্তর: .hr318-sum (এক-লাইন-সারাংশ — hr317-পাঠ-চুক্তি অটুট) + .hr318-list
       (hist ×১২ সর্বশেষ-প্রথম — "key · n বার · সময়-আগে"; চলতি-কী-সারি is-cur)।
     • কখনো-কপি-হয়নিতে তালিকা-অনুপস্থিত (কেবল-সারাংশ); DOM-API-নির্মাণ
