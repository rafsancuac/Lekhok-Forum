  var copyAria316 = function (txt316) {
    var done316 = function () {
      window.__hrAria316QA.copied = txt316;
      if (window.__hrAria317Record) window.__hrAria317Record(txt316); /* s317: ইতিহাস-রেকর্ড */
      showToast(true, 'কী-জোড়া কপি হয়েছে: ' + txt316);
    };
    var fail316 = function () {
      window.__hrAria316QA.failed += 1;
