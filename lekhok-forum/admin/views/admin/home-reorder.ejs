  };
  /* সেশন ৩১৯ (hr319): সারি-ক্লিক-পুনঃকপি — তালিকা-সারি = সেই-কী-র পুনঃকপি-লক্ষ্য
     • copyAria316-পুনঃব্যবহার (clipboard+fallback+টোস্ট+রেকর্ড — এক-উৎস-সত্য, কোনো-কপি-পথ-ডুপ-নেই);
       রেকর্ড→tipRender318-রিফ্রেশে সারি-পুনঃনির্মাণ-হয় — ফ্ল্যাশ (hr319-hit) রিফ্রেশ-পরবর্তী
       পুনঃঅনুসন্ধানে প্রয়োগ (380ms-বিলম্ব — async-কপি-সম্পন্নতা-পোল; 700ms-স্বয়ংক্রিয়-মুছ)। */
  var flash319 = function (k319) {
