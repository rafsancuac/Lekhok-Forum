    };
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt316).then(done316, function () { fallbackCopy316(txt316) ? done316() : fail316(); });
      } else {
        fallbackCopy316(txt316) ? done316() : fail316();
      }
    } catch (e316) { fail316(); }
  };
  innerEl.addEventListener('click', function (e316c) {
    var b316 = e316c.target && e316c.target.closest ? e316c.target.closest('.hr-aria-copy') : null;
    if (!b316) return;
