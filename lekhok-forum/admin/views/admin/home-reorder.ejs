  /* সেশন ৩১৭ (hr317): সাম্প্রতিক-কপি-ইতিহাস টুলটিপ (PLANS session316-নোটের প্রস্তাব-③)
     • hr316-কপি-সফলতায় __hrAria317Record (guarded — done316-হুক) → per-key {at, n}-রেজিস্ট্রি
       (সর্বশেষ-প্রথম, ১২-এন্ট্রি-সীমা); কপি-বাটনে hover/focus-এ পোর্টাল-টুলটিপ:
       "সর্বশেষ কপি: <slug> · <x বার> · <সময়-আগে>" / কখনো-কপি-হয়নিতে "এখনো কপি হয়নি"।
     • body-পোর্টাল (chip-এর overflow:hidden-ক্লিপ-বহির্ভূত); ডেলিগেটেড mouseover/out +
       focusin/out (renderInner-পুনঃরেন্ডার-নিরাপদ) + Escape-বিলোপ; রেকর্ডে খোলা-টুলটিপ-রিফ্রেশ।
     • QA-হুক __hrAria317QA {hist(), tip(), text(), err}। */
  var hist317 = [];
  var tip317 = null;
  var tipBtn317 = null;
  var bn317a = function (n317) { return String(n317).replace(/[0-9]/g, function (d317) { return '০১২৩৪৫৬৭৮৯'.charAt(+d317); }); };
  var ago317 = function (ts317) {
