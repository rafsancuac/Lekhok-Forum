    document.body.appendChild(t);
    setTimeout(function () { t.style.transition = 'opacity .5s'; t.style.opacity = '0'; setTimeout(function () { t.remove(); }, 550); }, 3500);
  }

  /* সেশন ৩১৬ (hr316): aria-chip কপি-বাটন — clipboard API + execCommand-ফলব্যাক
     (নন-সিকিউর-কনটেক্সট/অনুমতি-অস্বীকৃতিতে); ডেলিগেটেড click (renderInner-পুনঃরেন্ডার-নিরাপদ) */
  var fallbackCopy316 = function (txt316) {
    try {
      var ta316 = document.createElement('textarea');
