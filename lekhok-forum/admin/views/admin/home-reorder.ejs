<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>হোমপেজ সাজান | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>">
  <style>
    /* সেশন ১৯৩: হোমপেজ লেআউট ও কনটেন্ট রি-অর্ডারিং প্যানেল — ইউজার-স্পেক
       (২-কলাম: বামে মূল-সেকশন ক্রম ৭col, ডানে নির্বাচিত-সেকশনের ভেতরের কার্ড ৫col) */
    .hr-wrap { max-width: 1180px; }
    .hr-head { background:#fff; border:1px solid #ced0d4; border-radius:10px; padding:16px 20px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px; margin-bottom:18px; box-shadow:0 1px 2px rgba(0,0,0,.04); }
    .hr-head h1 { margin:0; font-size:1.05rem; font-weight:800; color:#050505; display:flex; align-items:center; gap:10px; }
    .hr-head h1 .hr-emblem { width:34px; height:34px; border-radius:9px; background:linear-gradient(135deg,#10b981,#047857); color:#fff; display:flex; align-items:center; justify-content:center; font-size:.9rem; }
    .hr-head p { margin:3px 0 0; font-size:.78rem; color:#65676b; }
    .hr-save { background:linear-gradient(135deg,#10b981,#059669); color:#fff; border:none; border-radius:8px; padding:10px 20px; font-weight:800; font-size:.82rem; cursor:pointer; font-family:inherit; display:inline-flex; align-items:center; gap:8px; box-shadow:0 8px 20px -8px rgba(16,185,129,.7); transition:transform .15s, box-shadow .15s; }
    .hr-save:hover { transform:translateY(-1px); }
    .hr-save:disabled { opacity:.55; cursor:wait; }
    .hr-grid { display:grid; grid-template-columns:7fr 5fr; gap:18px; align-items:start; }
    @media (max-width: 980px) { .hr-grid { grid-template-columns:1fr; } }
    .hr-panel { background:#fff; border:1px solid #ced0d4; border-radius:10px; padding:14px; box-shadow:0 1px 2px rgba(0,0,0,.04); }
    .hr-panel-head { display:flex; align-items:center; justify-content:space-between; gap:10px; border-bottom:1px solid #e4e6eb; padding-bottom:10px; margin-bottom:12px; flex-wrap:wrap; }
    .hr-panel-head h2 { margin:0; font-size:.85rem; font-weight:800; color:#050505; }
    .hr-panel-head .hr-hint { font-size:.7rem; color:#65676b; }
    .hr-active-label { font-size:.72rem; font-weight:700; color:#047857; }
    .hr-sec-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 12px; border:1px solid #e4e6eb; border-radius:8px; margin-bottom:8px; cursor:pointer; transition:background .15s, border-color .15s; background:#fff; }
    .hr-sec-row:hover { background:#f2f4f7; }
    .hr-sec-row.active { background:#ecfdf5; border-color:#059669; }
    .hr-sec-row.off { opacity:.55; }
    .hr-sec-id { flex:0 0 auto; width:22px; height:22px; border-radius:50%; background:#f0f2f5; color:#65676b; font-size:.7rem; font-weight:800; display:flex; align-items:center; justify-content:center; }
    .hr-sec-row.active .hr-sec-id { background:#059669; color:#fff; }
    .hr-sec-meta { flex:1; min-width:0; }
    .hr-sec-meta h3 { margin:0; font-size:.78rem; font-weight:700; color:#050505; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hr-sec-meta span { font-size:.65rem; font-family:ui-monospace,monospace; color:#8a8d91; }
    .hr-sec-row.off .hr-sec-meta h3 { text-decoration:line-through; }
    .hr-btns { display:flex; gap:5px; flex:0 0 auto; }
    .hr-btn { width:27px; height:27px; border:1px solid #d1d5db; background:#f9fafb; border-radius:6px; font-size:.68rem; cursor:pointer; color:#374151; display:flex; align-items:center; justify-content:center; font-family:inherit; transition:background .12s; }
    .hr-btn:hover { background:#e5e7eb; }
    .hr-btn:disabled { opacity:.35; cursor:default; }
    .hr-eye { width:auto; padding:0 9px; gap:5px; font-size:.66rem; font-weight:700; }
    .hr-inner-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 11px; background:#fafbfb; border:1px solid #e4e6eb; border-radius:8px; margin-bottom:7px; }
    .hr-inner-row .hr-item-id { flex:0 0 auto; width:22px; height:22px; border-radius:50%; background:#d1fae5; color:#047857; font-size:.65rem; font-weight:800; display:flex; align-items:center; justify-content:center; }
    .hr-inner-meta { flex:1; min-width:0; }
    .hr-inner-meta h4 { margin:0; font-size:.76rem; font-weight:700; color:#050505; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hr-inner-meta p { margin:0; font-size:.68rem; color:#65676b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hr-subgroup { margin-bottom:14px; }
    .hr-subgroup-label { display:flex; align-items:center; gap:7px; font-size:.7rem; font-weight:800; color:#047857; margin-bottom:7px; letter-spacing:.02em; }
    .hr-empty { padding:34px 12px; text-align:center; color:#8a8d91; font-size:.78rem; }
    .hr-empty i { display:block; font-size:1.5rem; margin-bottom:8px; color:#cbd5e1; }
    .hr-toast { position:fixed; bottom:18px; left:50%; transform:translateX(-50%); z-index:200; background:#065f46; color:#fff; padding:11px 18px; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,.22); font-size:.82rem; display:flex; align-items:center; gap:9px; }
    .hr-toast-err { background:#991b1b; }
    .hr-note { margin-top:14px; font-size:.7rem; color:#8a8d91; background:#f9fafb; border:1px dashed #d1d5db; border-radius:8px; padding:10px 12px; line-height:1.6; }
    .hr-note b { color:#4b5563; }
    /* সেশন ৩১৫ (hr315): aria-জোড়া-সচেতন কী-তালিকা — অ্যাডমিন-শিক্ষা-কপি */
    .hr-aria-note { margin:0 0 9px; font-size:.68rem; color:#4b5563; background:#ecfdf5; border:1px solid #a7f3d0; border-left:3px solid #059669; border-radius:8px; padding:9px 11px; line-height:1.65; }
    .hr-aria-note b { color:#065f46; }
    .hr-aria-note code { font-family:ui-monospace,monospace; font-size:.62rem; background:#d1fae5; color:#065f46; border-radius:4px; padding:1px 5px; }
    .hr-aria-chip { display:inline-block; margin-top:4px; max-width:100%; font-family:ui-monospace,monospace; font-size:.62rem; color:#047857; background:#ecfdf5; border:1px solid #a7f3d0; border-radius:5px; padding:2px 7px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    /* সেশন ৩১৬ (hr316): aria-chip কপি-বাটন — এক-ক্লিকে জোড়া-স্লাগ ক্লিপবোর্ডে */
    .hr-aria-copy { margin-left:6px; border:1px solid #a7f3d0; background:#fff; color:#047857; border-radius:4px; font-size:.6rem; padding:2px 6px; cursor:pointer; vertical-align:middle; transition:background .12s, transform .12s; }
    .hr-aria-copy:hover { background:#d1fae5; }
    .hr-aria-copy:active { transform:scale(.94); }
    .hr-aria-copy.is-done { color:#059669; border-color:#059669; }
    /* সেশন ৩১৭ (hr317): সাম্প্রতিক-কপি-ইতিহাস টুলটিপ — body-পোর্টাল (chip-এর
       overflow:hidden-ক্লিপ-বহির্ভূত); কপি-বাটনের নিচে কেন্দ্র-স্থাপিত; hover/focus-গেট */
    .hr317-tip { position:absolute; z-index:9999; transform:translate(-50%, 4px); max-width:300px; font-size:.62rem; line-height:1.45; color:#065f46; background:#ffffff; border:1px solid #a7f3d0; border-radius:6px; padding:5px 9px; box-shadow:0 8px 22px -10px rgba(4,120,87,.45); opacity:0; visibility:hidden; pointer-events:none; transition:opacity .16s ease, transform .16s ease, visibility .16s; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hr317-tip.is-on { opacity:1; visibility:visible; transform:translate(-50%, 0); }
    /* সেশন ৩১৮ (hr318): টুলটিপ-সম্পূর্ণ-ইতিহাস-তালিকা — sum+list-দ্বি-স্তর (hr317-এক-লাইন-সারাংশ
       উপরে অটুট); DOM-API-নির্মিত (textContent — XSS-নিরাপদ); চলতি-কী-সারি is-cur-হাইলাইট;
       pointer-events:none-টুলটিপে কেবল-পাঠ্য-তালিকা (ইন্টারঅ্যাকশন-নেই); ১২-সারি-সীমায়
       max-height-ক্ল্যাম্প (hist-রেজিস্ট্রি-সীমা = ১২ — s317-অটুট)। */
    .hr318-sum { display:block; font-weight:700; }
    .hr318-list { display:block; margin-top:4px; padding-top:4px; border-top:1px dashed #a7f3d0; max-height:148px; overflow:hidden; }
    .hr318-row { display:flex; gap:6px; align-items:baseline; padding:1px 0; font-size:.58rem; }
    .hr318-row + .hr318-row { border-top:1px dotted rgba(6,95,70,.16); }
    .hr318-row .hr318-k { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:148px; font-weight:600; }
    .hr318-row .hr318-n { color:#047857; font-weight:700; white-space:nowrap; }
    .hr318-row .hr318-t { margin-left:auto; white-space:nowrap; color:rgba(6,95,70,.72); }
    .hr318-row.is-cur { background:rgba(4,120,87,.09); border-radius:3px; padding:1px 4px; margin:0 -4px; }
    /* সেশন ৩১৯ (hr319): তালিকায় সারি-ক্লিক-পুনঃকপি — pointer-events-none-গেট-পুনঃবিবেচনা:
       গেট-মূলনীতি অটুট — নিঃশর্ত-ইন্টারঅ্যাকশন-নয়, কেবল-তালিকাযুক্ত-টুলটিপেই (.hr319-live)
       pointer-events:auto; সারি-হোভার-টিন্ট + পুনঃকপি-ফ্ল্যাশ (hr319-hit — স্বয়ংক্রিয়-মুছ);
       is-cur-সহাবস্থান (is-cur-টিন্ট-অটুট; hover/hit-অগ্রাধিকার)। */
    .hr317-tip.hr319-live { pointer-events:auto; cursor:default; }
    .hr318-row[data-copy] { cursor:pointer; border-radius:3px; margin:0 -4px; padding-left:4px; padding-right:4px; transition:background .12s; }
    .hr317-tip.hr319-live .hr318-row[data-copy]:hover { background:rgba(4,120,87,.07); }
    .hr318-row.hr319-hit { background:rgba(5,150,105,.18) !important; }
    /* সেশন ৩২০ (hr320): ইতিহাস-কীবোর্ড-পয়েন্টার — ArrowDown/Up-নেভিগেটেড সারির চিহ্ন
       (is-cur-সহাবস্থান — চলতি-কী-টিন্ট .০৯-এর গাঢ় .১৩ + inset-বাম-বার); সারি-focus/
       role/tabindex-অনুপ্রবেশ-শূন্য — কেবল-ভিজ্যুয়াল-পয়েন্টার (kbd-পথ)। */
    .hr318-row.hr320-ptr { background:rgba(4,120,87,.13); box-shadow:inset 2px 0 0 rgba(5,150,105,.85); border-radius:3px; margin:0 -4px; padding-left:4px; padding-right:4px; }
    /* সেশন ৩২১ (hr321): স্থায়ীকৃত-ইতিহাস-সারি — restored-চিহ্ন (পুনঃলোডে-আসা-এন্ট্রি —
       সতেজ-কপিতে বিলোপ; সময়-ইটালিক + সামান্য-নিম্ন-অপাসিটি — সতেজ-সারির-সাথে-পার্থক্য) */
    .hr318-row.hr321-restored { opacity:.92; }
    .hr318-row.hr321-restored .hr318-t { font-style:italic; }
    /* সেশন ৩২২ (hr322): sum-দ্বি-ক্লিক-হিন্ট (তালিকাযুক্ত-টুলটিপেই — hr319-live-গেট;
       এক-ক্লিক-নীরব — দ্বি-ক্লিকেই-বিলোপ + টোস্ট; হিন্ট = DOM-যোগ .hr322-hint) */
    .hr317-tip.hr319-live .hr318-sum { cursor: pointer; }
    .hr317-tip.hr319-live .hr318-sum:hover { text-decoration: underline dotted rgba(220, 38, 38, 0.5); text-underline-offset: 3px; }
    .hr322-hint { display: block; margin-top: 4px; padding-top: 3px; border-top: 1px dashed rgba(220, 38, 38, 0.28); font-size: 0.55rem; font-weight: 600; color: rgba(220, 38, 38, 0.78); white-space: nowrap; }
    .hr322-hint:hover { color: rgba(220, 38, 38, 0.95); }
    /* সেশন ৩২৩ (hr323): Delete ×২-নিরামড-ভিজ্যুয়াল (sum-লাল-টিন্ট + dotted-আন্ডারলাইন —
       ধ্বংসাত্মক-প্রস্তুতি-সংকেত; ৩s-স্বয়ং-নিরামড; hint-সহ-উজ্জ্বল) */
    .hr317-tip.hr323-armed .hr318-sum { color: rgba(220, 38, 38, 0.92); text-decoration: underline dotted rgba(220, 38, 38, 0.55); text-underline-offset: 3px; }
    .hr317-tip.hr323-armed .hr322-hint { color: rgba(220, 38, 38, 0.95); }
    /* সেশন ৩২৪ (hr324): ইতিহাস-রপ্তাই-বার (তালিকাযুক্ত-টুলটিপেই — hr319-live-গেট-উত্তরাধিকার;
       দ্বি-বাটন নেটিভ-বাটন — pointer-পথ; কীবোর্ড-পথ = E/D-শর্টকাট — s320/s323-keydown-রীতি;
       focusout-জীবনচক্ষে-ট্যাব-অপ্রাপ্য — বাটন-নয়-শর্টকাট-ই কীবোর্ড-parity) */
    .hr324-bar { display: flex; gap: 5px; margin-top: 4px; padding-top: 4px; border-top: 1px dashed rgba(6, 95, 70, 0.3); }
    .hr324-btn { flex: 1 1 auto; display: inline-flex; align-items: center; justify-content: center; gap: 4px; font: inherit; font-size: 0.55rem; font-weight: 700; color: rgba(6, 95, 70, 0.95); background: rgba(4, 120, 87, 0.08); border: 1px solid rgba(4, 120, 87, 0.32); border-radius: 5px; padding: 3px 7px; cursor: pointer; white-space: nowrap; transition: background 0.12s ease, border-color 0.12s ease; }
    .hr324-btn:hover { background: rgba(4, 120, 87, 0.16); border-color: rgba(4, 120, 87, 0.5); }
    .hr324-btn:focus-visible { outline: 2px solid rgba(5, 150, 105, 0.75); outline-offset: 1px; }
    .hr324-btn.hr324-done { background: rgba(5, 150, 105, 0.2); border-color: rgba(5, 150, 105, 0.85); color: rgba(6, 95, 70, 1); }
    .hr324-kbd { display: block; margin-top: 3px; font-size: 0.52rem; color: rgba(6, 95, 70, 0.66); white-space: nowrap; }
    /* সেশন ৩২৫ (hr325): ইতিহাস-সারি-একক-বিলোপ ×-নিয়ন্ত্রণ (তালিকাযুক্ত-টুলটিপেই — hr319-live-গেট;
       সারি-হোভার/focus-within-এ প্রকাশ — ঘন-তালিকায়-স্থায়ী-ঘোষণা-বিভ্রান্তি-শূন্য; কীবোর্ড-পথ =
       X-শর্টকাট (পয়েন্টার-সারি — hr320-পয়েন্টার — s320/s324-keydown-রীতি); লাল-টিন্ট =
       hr322/hr323-বিলোপ-রীতি; rgba-only) */
    .hr325-x { flex: 0 0 auto; opacity: 0; border: 0; background: transparent; color: rgba(6, 95, 70, 0.55); font-size: 0.6rem; line-height: 1; padding: 1px 3px; border-radius: 3px; cursor: pointer; transition: opacity 0.12s ease, color 0.12s ease, background 0.12s ease; }
    .hr318-row:hover .hr325-x, .hr318-row:focus-within .hr325-x { opacity: 1; }
    .hr325-x:hover { color: rgba(220, 38, 38, 0.95); background: rgba(220, 38, 38, 0.1); }
    .hr325-x:focus-visible { outline: 2px solid rgba(220, 38, 38, 0.6); outline-offset: 1px; opacity: 1; }
    .hr325-x:active { color: rgba(185, 28, 28, 1); }
    @media (prefers-reduced-motion: reduce) { .hr325-x { transition: none; } }
    /* সেশন ৩২৬ (hr326): রপ্তাই-বিন্যাস-অপশন বাটন (hr324-বার-পরিবার — .hr324-btn-উত্তরাধিকার;
       dashed-বর্ডার = বিন্যাস-নির্বাচক-রীতি; কীবোর্ড-পথ = F-শর্টকাট — s320/s324-keydown-রীতি;
       স্থায়ীকরণ = sessionStorage 'hr326-fmt' — যাচাই-কৃত-মান-এক-উৎস; rgba-only) */
    .hr326-fmt { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: 4px; font: inherit; font-size: 0.55rem; font-weight: 600; color: rgba(6, 95, 70, 0.8); background: rgba(4, 120, 87, 0.08); border: 1px dashed rgba(4, 120, 87, 0.32); border-radius: 5px; padding: 3px 7px; cursor: pointer; white-space: nowrap; transition: background 0.12s ease, border-color 0.12s ease; }
    .hr326-fmt:hover { border-style: solid; background: rgba(4, 120, 87, 0.16); border-color: rgba(4, 120, 87, 0.5); }
    .hr326-fmt:focus-visible { outline: 2px solid rgba(5, 150, 105, 0.75); outline-offset: 1px; }
    .hr326-fmt.hr324-done { background: rgba(5, 150, 105, 0.2); border-color: rgba(5, 150, 105, 0.85); color: rgba(6, 95, 70, 1); }
    /* সেশন ৩২৭ (hr327): রপ্তাই-পূর্বরূপ-প্রিভিউ (hr324-বার-পরিবার — .hr324-btn-উত্তরাধিকার;
       স্বতন্ত্র-শ্রেণি .hr327-pv — s324-.hr324-btn-গণনা-চুক্তি-অটুট; dotted-বর্ডার —
       hr326-dashed-পার্থক্য; .hr327-pre = বার-পূর্বে ঝলক-ব্লক — DOM-API/textContent-কেবল
       (XSS-নিরাপদ); টগল in-memory — পুনঃরেন্ডারে বন্ধ; rgba-only) */
    .hr327-pv { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: 4px; font: inherit; font-size: 0.55rem; font-weight: 600; color: rgba(6, 95, 70, 0.8); background: rgba(4, 120, 87, 0.08); border: 1px dotted rgba(4, 120, 87, 0.4); border-radius: 5px; padding: 3px 7px; cursor: pointer; white-space: nowrap; transition: background 0.12s ease, border-color 0.12s ease; }
    .hr327-pv:hover { border-style: solid; background: rgba(4, 120, 87, 0.16); border-color: rgba(4, 120, 87, 0.55); }
    .hr327-pv:focus-visible { outline: 2px solid rgba(5, 150, 105, 0.75); outline-offset: 1px; }
    .hr327-pv[aria-expanded="true"] { background: rgba(5, 150, 105, 0.14); border-color: rgba(5, 150, 105, 0.7); color: rgba(6, 95, 70, 1); }
    .hr327-pv.hr324-done { background: rgba(5, 150, 105, 0.2); border-color: rgba(5, 150, 105, 0.85); color: rgba(6, 95, 70, 1); }
    .hr327-pre { display: block; margin-top: 5px; padding: 5px 7px; background: rgba(4, 120, 87, 0.05); border: 1px dashed rgba(6, 95, 70, 0.28); border-radius: 5px; max-height: 132px; overflow: auto; white-space: pre-wrap; word-break: break-word; font-size: 0.55rem; line-height: 1.5; color: rgba(6, 95, 70, 0.92); }
    .hr327-pre .hr327-meta { display: block; font-weight: 700; color: rgba(4, 120, 87, 0.95); margin-bottom: 3px; padding-bottom: 3px; border-bottom: 1px dotted rgba(6, 95, 70, 0.22); white-space: normal; }
    .hr327-pre .hr327-text { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.54rem; }
    @media (prefers-reduced-motion: reduce) { .hr327-pv { transition: none; } }
    /* সেশন ৩২৮ (hr328): প্রিভিউ-কপি-বাটন (hr327-pre-পরিবার — স্বতন্ত্র-শ্রেণি —
       s324-.hr324-btn-গণনা-চুক্তি-অটুট; কেবল-প্রিভিউ-খোলা-অবস্থায়-বিদ্যমান —
       meta↔text-মাঝে সন্নিবেশ; rgba-only) */
    .hr328-cp { display: inline-flex; align-items: center; gap: 4px; font: inherit; font-size: 0.55rem; font-weight: 700; color: rgba(6, 95, 70, 0.9); background: rgba(4, 120, 87, 0.1); border: 1px solid rgba(4, 120, 87, 0.35); border-radius: 5px; padding: 2px 8px; margin: 0 0 4px; cursor: pointer; transition: background 0.12s ease, border-color 0.12s ease; }
    .hr328-cp:hover { background: rgba(4, 120, 87, 0.18); border-color: rgba(4, 120, 87, 0.55); }
    .hr328-cp:focus-visible { outline: 2px solid rgba(5, 150, 105, 0.75); outline-offset: 1px; }
    .hr328-cp.hr324-done { background: rgba(5, 150, 105, 0.2); border-color: rgba(5, 150, 105, 0.85); color: rgba(6, 95, 70, 1); }
    @media (prefers-reduced-motion: reduce) { .hr328-cp { transition: none; } }

    /* সেশন ৩২৯ (hr329): প্রিভিউ-ডাউনলোড-বাটন (hr324-D-সমতা — স্বতন্ত্র-শ্রেণি —
       s324-.hr324-btn-গণনা-চুক্তি-অটুট; কেবল-প্রিভিউ-খোলা-অবস্থায়-বিদ্যমান — copy-পরে
       সন্নিবেশ; double-বর্ডার — hr326-dashed/hr327-dotted/hr328-solid-পার্থক্ষ্য; rgba-only) */
    .hr329-dl { display: inline-flex; align-items: center; gap: 4px; font: inherit; font-size: 0.55rem; font-weight: 700; color: rgba(6, 95, 70, 0.9); background: rgba(4, 120, 87, 0.06); border: 3px double rgba(4, 120, 87, 0.4); border-radius: 5px; padding: 0 7px; margin: 0 0 4px; cursor: pointer; transition: background 0.12s ease, border-color 0.12s ease; }
    .hr329-dl:hover { background: rgba(4, 120, 87, 0.14); border-color: rgba(4, 120, 87, 0.6); }
    .hr329-dl:focus-visible { outline: 2px solid rgba(5, 150, 105, 0.75); outline-offset: 1px; }
    .hr329-dl.hr324-done { background: rgba(5, 150, 105, 0.2); border-color: rgba(5, 150, 105, 0.85); color: rgba(6, 95, 70, 1); }
    .hr327-meta.hr329-restored { color: rgba(5, 150, 105, 1); font-weight: 700; }
    @media (prefers-reduced-motion: reduce) { .hr329-dl { transition: none; } }

    /* সেশন ৩৩০ (hr330): '?'-শর্টকাট-সহায়তা-ওভারলে (স্বতন্ত্র-শ্রেণি-পরিবার — rgba-only —
       body-স্থির-অবস্থান — নন-মোডাল — focus-visible-রিং + reduced-motion-সমতা) */
    .hr330-ov { position: fixed; right: 14px; bottom: 14px; z-index: 9999; width: min(320px, calc(100vw - 28px)); margin: 0; background: rgba(255, 255, 255, 0.98); border: 1px solid rgba(4, 120, 87, 0.35); border-radius: 8px; box-shadow: 0 12px 32px -12px rgba(2, 6, 23, 0.35); font-family: inherit; font-size: 0.72rem; color: rgba(6, 78, 59, 1); overflow: hidden; }
    .hr330-ov[hidden] { display: none; }
    .hr330-hd { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 10px; background: rgba(4, 120, 87, 0.08); border-bottom: 1px solid rgba(4, 120, 87, 0.18); font-weight: 700; }
    .hr330-x { font: inherit; font-size: 0.62rem; font-weight: 700; color: rgba(6, 95, 70, 0.9); background: rgba(255, 255, 255, 0.72); border: 1px solid rgba(4, 120, 87, 0.3); border-radius: 4px; padding: 2px 7px; cursor: pointer; transition: background 0.12s ease, border-color 0.12s ease; }
    .hr330-x:hover { background: rgba(4, 120, 87, 0.12); border-color: rgba(4, 120, 87, 0.5); }
    .hr330-x:focus-visible { outline: 2px solid rgba(5, 150, 105, 0.75); outline-offset: 1px; }
    .hr330-list { margin: 0; padding: 6px 10px 8px; list-style: none; }
    .hr330-li { display: flex; align-items: center; gap: 8px; padding: 3px 0; }
    .hr330-k { flex: 0 0 auto; min-width: 20px; text-align: center; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.62rem; font-weight: 700; color: rgba(6, 95, 70, 1); background: rgba(4, 120, 87, 0.1); border: 1px solid rgba(4, 120, 87, 0.28); border-radius: 4px; padding: 1px 5px; }
    .hr330-d { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hr330-ft { padding: 5px 10px 7px; border-top: 1px dashed rgba(4, 120, 87, 0.2); color: rgba(6, 95, 70, 0.72); font-size: 0.6rem; line-height: 1.45; }
    @media (prefers-reduced-motion: reduce) { .hr330-ov, .hr330-x { transition: none; } }
  </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1 style="margin:0;font-size:1.15rem;font-weight:800;">হোমপেজ সাজান</h1>
      <p style="margin:2px 0 0;font-size:.8rem;color:#6b7280;">সর্বশেষ সংরক্ষণ সাথে সাথেই পাবলিক হোমপেজে প্রতিফলিত হয়</p>
    </div>
  </div>
  <div class="admin-content hr-wrap">
    <% if (saved) { %>
      <div class="hr-toast" id="hrSavedToast"><i class="fas fa-check-circle"></i> হোমপেজের নতুন ক্রম সফলভাবে সংরক্ষিত হয়েছে!</div>
    <% } %>

    <form method="post" action="/admin/home-reorder" id="hrForm">
      <input type="hidden" name="_csrf" value="" />
      <input type="hidden" name="sectionsJson" id="sectionsJson193" value="" />
      <input type="hidden" name="membersJson" id="membersJson193" value="" />
      <input type="hidden" name="feedJson" id="feedJson193" value="" />

      <div class="hr-head">
        <div>
          <h1><span class="hr-emblem"><i class="fas fa-arrow-up-down"></i></span> হোমপেজ লেআউট ও কন্টেন্ট রি-অর্ডারিং</h1>
          <p>মূল সেকশনসমূহ ও ভেতরের কার্ডগুলোর ক্রম উপরে-নিচে পরিবর্তন করুন — বাঁ-পাশের তালিকা থেকে সেকশন বেছে নিন</p>
        </div>
        <button type="submit" class="hr-save" id="hrSaveBtn"><i class="fas fa-check"></i> পরিবর্তন সংরক্ষণ করুন</button>
      </div>

      <div class="hr-grid">
        <!-- ১. মূল সেকশনের ক্রম -->
        <div class="hr-panel">
          <div class="hr-panel-head">
            <h2>১. মূল সেকশনের ক্রম (Homepage Structure)</h2>
            <span class="hr-hint">সারিতে ক্লিক করে ভেতরের কার্ড সাজান</span>
          </div>
          <div id="hrSectionList"></div>
          <div class="hr-note">
            <b>নোট:</b> আইকনের পাশের <b>চোখ</b> বাটনে ক্লিক করে যেকোনো সেকশন সাময়িকভাবে লুকানো যায়।
            আজকের কন্টেন্ট/কুইজ চ্যালেঞ্জ/সাম্প্রতিক লেখা — এই তিনটির ডেটা না-থাকলে সে-সেকশন সক্রিয় থাকলেও সেদিন হোমে আসে না (খালি-সেকশন দেখায় না)।
          </div>
        </div>

        <!-- ২. নির্বাচিত সেকশনের ভেতরের কার্ড -->
        <div class="hr-panel">
          <div class="hr-panel-head">
            <div>
              <h2>২. নির্বাচিত সেকশনের ভেতরের কার্ডের ক্রম</h2>
              <div class="hr-active-label" id="hrActiveLabel"></div>
            </div>
            <span class="hr-hint">▲▼ দিয়ে ক্রম বদলান</span>
          </div>
          <div id="hrInnerList"></div>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  'use strict';
  var SECTIONS = <%- JSON.stringify(sections193) %>;
  var MEMBER_GROUPS = <%- JSON.stringify(memberGroups193) %>;
  var FEED_SLIDES = <%- JSON.stringify(feedSlides193) %>;
  var activeKey = 'LEADERSHIP_CURRENT';
  /* সেশন ৩১৫ (hr315): ফোন-ফিড গ্রুপ-কী-সেট (feed.ejs sfsGroups313-র স্লাগ-সত্য) —
     এই-কী-গুলোতেই স্থিতিশীল aria-জোড়া (sfs314-glab-* ↔ sfs314-grows-*) বিদ্যমান। */
  var SFS314_PAIRS = { 'real-latest': true, 'real-popular': true };

  var listEl = document.getElementById('hrSectionList');
  var innerEl = document.getElementById('hrInnerList');
  var activeLabel = document.getElementById('hrActiveLabel');

  var bnNum = function (n) { return String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); };

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function move(arr, i, dir) {
    var j = i + dir;
    if (j < 0 || j >= arr.length) return false;
    var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    return true;
  }

  function renderSections() {
    listEl.innerHTML = '';
    SECTIONS.forEach(function (sec, i) {
      var row = document.createElement('div');
      row.className = 'hr-sec-row' + (sec.key === activeKey ? ' active' : '') + (sec.enabled ? '' : ' off');
      row.innerHTML =
        '<span class="hr-sec-id">' + bnNum(i + 1) + '</span>' +
        '<div class="hr-sec-meta"><h3>' + esc(sec.label) + '</h3><span>কী: ' + esc(sec.key) + '</span></div>' +
        '<div class="hr-btns">' +
          '<button type="button" class="hr-btn hr-eye" data-eye="' + i + '" title="' + (sec.enabled ? 'লুকিয়ে রাখুন' : 'দৃশ্যমান করুন') + '"><i class="fas ' + (sec.enabled ? 'fa-eye' : 'fa-eye-slash') + '"></i></button>' +
          '<button type="button" class="hr-btn" data-up="' + i + '" title="উপরে নিন" ' + (i === 0 ? 'disabled' : '') + '>▲</button>' +
          '<button type="button" class="hr-btn" data-down="' + i + '" title="নিচে নিন" ' + (i === SECTIONS.length - 1 ? 'disabled' : '') + '>▼</button>' +
        '</div>';
      row.addEventListener('click', function (e) {
        if (e.target.closest('[data-eye]') || e.target.closest('[data-up]') || e.target.closest('[data-down]')) return;
        activeKey = sec.key;
        renderSections(); renderInner();
      });
      listEl.appendChild(row);
    });
    listEl.querySelectorAll('[data-eye]').forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        var i = +b.getAttribute('data-eye');
        SECTIONS[i].enabled = !SECTIONS[i].enabled;
        renderSections();
      });
    });
    listEl.querySelectorAll('[data-up]').forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        if (move(SECTIONS, +b.getAttribute('data-up'), -1)) renderSections();
      });
    });
    listEl.querySelectorAll('[data-down]').forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        if (move(SECTIONS, +b.getAttribute('data-down'), 1)) renderSections();
      });
    });
  }

  function innerRow(idx, total, idTxt, title, sub, onUp, onDown, ariaChip) {
    var row = document.createElement('div');
    row.className = 'hr-inner-row';
    row.innerHTML =
      '<span class="hr-item-id">' + bnNum(idx + 1) + '</span>' +
      '<div class="hr-inner-meta"><h4>' + esc(title) + '</h4>' + (sub ? '<p>' + esc(sub) + '</p>' : '') + (ariaChip ? '<code class="hr-aria-chip" title="ফোন-ফিড গ্রুপের কীবোর্ড-নেভ aria-জোড়া (স্থিতিশীল-স্লাগ)">' + esc(ariaChip) + '<button type="button" class="hr-aria-copy" data-copy="' + esc(ariaChip) + '" aria-label="' + esc(ariaChip) + ' — কপি করুন" title="কী-জোড়া কপি করুন"><i class="fas fa-copy"></i></button></code>' : '') + '</div>' +
      '<div class="hr-btns">' +
        '<button type="button" class="hr-btn" ' + (onUp ? '' : 'disabled') + '>▲</button>' +
        '<button type="button" class="hr-btn" ' + (onDown ? '' : 'disabled') + '>▼</button>' +
      '</div>';
    var btns = row.querySelectorAll('.hr-btn:not(.hr-eye)');
    if (onUp) btns[0].addEventListener('click', onUp);
    if (onDown) btns[1].addEventListener('click', onDown);
    return row;
  }

  function renderInner() {
    innerEl.innerHTML = '';
    var sec = SECTIONS.filter(function (s) { return s.key === activeKey; })[0];
    activeLabel.textContent = sec ? ('সক্রিয়: ' + sec.label) : '';

    if (activeKey === 'USER_FEED') {
      var box = document.createElement('div');
      box.className = 'hr-subgroup';
      var lbl = document.createElement('div');
      lbl.className = 'hr-subgroup-label';
      lbl.innerHTML = '<i class="fas fa-bolt"></i> ফিড-স্লাইডারের স্লাইডসমূহ';
      box.appendChild(lbl);
      /* সেশন ৩১৫ (hr315): aria-জোড়া-সচেতন কী-তালিকা — অ্যাডমিন-শিক্ষা-কপি
         (PLANS session314-প্রস্তাব-③): ফোন-ফিড গ্রুপ-কী-তে স্থিতিশীল aria-স্লাগ-জোড়া
         প্রদর্শন — ক্রম-বদলেও স্লাগ অপরিবর্তিত (স্ক্রিন-রিডার/কীবোর্ড-অ্যাঙ্কর)। */
      var ariaNote = document.createElement('div');
      ariaNote.className = 'hr-aria-note';
      ariaNote.innerHTML = '<i class="fas fa-keyboard"></i> <b>ফোন-ফিড গ্রুপ কীবোর্ড-নেভিগেবল:</b> হোমপেজের ফোন-প্রিভিউতে <b>ArrowUp/ArrowDown</b> চেপে গ্রুপ-লেবেল হাইলাইট করা যায় (Escape = বিলোপ)। নিচের <code>sfs314-glab-*</code> ↔ <code>sfs314-grows-*</code> জোড়া-স্লাগ ক্রম-বদলেও স্থিতিশীল — স্ক্রিন-রিডার ও কীবোর্ড-ব্যবহারকারীর নির্ভরযোগ্য অ্যাঙ্কর।';
      box.appendChild(ariaNote);
      FEED_SLIDES.forEach(function (s, i) {
        var chip315 = SFS314_PAIRS[s.key] ? ('sfs314-glab-' + s.key + ' ↔ sfs314-grows-' + s.key) : '';
        box.appendChild(innerRow(i, FEED_SLIDES.length, s.key, s.title, s.sub,
          i === 0 ? null : function () { move(FEED_SLIDES, i, -1); renderInner(); },
          i === FEED_SLIDES.length - 1 ? null : function () { move(FEED_SLIDES, i, 1); renderInner(); },
          chip315));
      });
      innerEl.appendChild(box);
      return;
    }

    var groups = MEMBER_GROUPS.filter(function (g) { return g.sectionKey === activeKey; });
    if (!groups.length) {
      innerEl.innerHTML = '<div class="hr-empty"><i class="fas fa-layer-group"></i>এই সেকশনে আলাদা কোনো অভ্যন্তরীণ কার্ড-তালিকা নেই</div>';
      return;
    }
    groups.forEach(function (g) {
      var box = document.createElement('div');
      box.className = 'hr-subgroup';
      var lbl = document.createElement('div');
      lbl.className = 'hr-subgroup-label';
      lbl.innerHTML = '<i class="fas ' + esc(g.icon || 'fa-users') + '"></i> ' + esc(g.label);
      box.appendChild(lbl);
      if (!g.items.length) {
        var em = document.createElement('div');
        em.className = 'hr-empty';
        em.innerHTML = '<i class="fas fa-seedling"></i>এই গ্রুপে কোনো সদস্য নেই';
        box.appendChild(em);
      }
      g.items.forEach(function (it, i) {
        box.appendChild(innerRow(i, g.items.length, it.id, it.name,
          [it.role, it.term ? (it.term + ' কার্যবর্ষ') : ''].filter(Boolean).join(' • '),
          i === 0 ? null : function () { move(g.items, i, -1); renderInner(); },
          i === g.items.length - 1 ? null : function () { move(g.items, i, 1); renderInner(); }));
      });
      innerEl.appendChild(box);
    });
  }

  /* সাবমিট → AJAX সেভ (সেশন ১৯৩) — sections.ejs-এর sec-ajax-প্যাটার্নের মিরর।
     সাধারণ form-POST প্রিভিউ-গেটওয়েতে XTransformPort হারায়, তাই fetch-ই চুক্তি। */
  var hrForm = document.getElementById('hrForm');
  hrForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var meta = document.querySelector('meta[name="csrf-token"]');
    var btn = document.getElementById('hrSaveBtn');
    var fd = new URLSearchParams();
    fd.set('_csrf', meta ? meta.content : '');
    fd.set('_ajax', '1');
    fd.set('sectionsJson', JSON.stringify(SECTIONS.map(function (s) { return { key: s.key, enabled: !!s.enabled }; })));
    var memMap = {};
    MEMBER_GROUPS.forEach(function (g) { memMap[g.key] = g.items.map(function (it) { return it.id; }); });
    fd.set('membersJson', JSON.stringify(memMap));
    fd.set('feedJson', JSON.stringify(FEED_SLIDES.map(function (s) { return s.key; })));
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> সংরক্ষণ হচ্ছে...'; }
    fetch(hrForm.getAttribute('action'), { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'অপ্রত্যাশিত রেসপন্স' }; }); })
      .then(function (d) {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> পরিবর্তন সংরক্ষণ করুন'; }
