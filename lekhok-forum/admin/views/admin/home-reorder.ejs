        tm323 = setTimeout(function () { armed323 = false; tm323 = null; if (tip317) tip317.classList.remove('hr323-armed'); }, 3000);
        if (tip317) tip317.classList.add('hr323-armed');
        showToast(true, 'আবার Delete চাপুন — কপি-ইতিহাস মুছে যাবে');
        q323h.armed += 1;
