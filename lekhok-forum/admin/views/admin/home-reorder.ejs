        r318.setAttribute('data-copy', e318.key); /* s319: সারি-ক্লিক-পুনঃকপি-লক্ষ্য */
        var k318e = document.createElement('span'); k318e.className = 'hr318-k'; k318e.textContent = e318.key;
        var n318e = document.createElement('span'); n318e.className = 'hr318-n'; n318e.textContent = bn317a(e318.n) + ' বার';
        var t318e = document.createElement('span'); t318e.className = 'hr318-t'; t318e.textContent = ago317(e318.at);
        r318.appendChild(k318e); r318.appendChild(n318e); r318.appendChild(t318e);
