  renderInner();

  /* সেশন ৩১৫ QA-হুক — aria-জোড়া-তালিকা-প্রমাণ (রেজিস্ট্রি-সত্য; note/chips = ফাংশনাল-গেটার —
     প্রারম্ভিক activeKey LEADERSHIP_CURRENT হওয়ায় বুটে শূন্য-ই স্বাভাবিক; USER_FEED-নির্বাচনে পূর্ণ) */
  window.__hrAria315QA = {
