<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>সংবেদনশীল তথ্য — সুপার এডমিন</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">

  <div class="admin-header">
    <div>
      <h1><i class="fas fa-shield-halved super-ico"></i> সংবেদনশীল তথ্য ও নিয়ন্ত্রণ</h1>
      <p>সাইটের পরিচয়, যোগাযোগ-তথ্য, সোশ্যাল লিংক ও সাইট-ওয়াইড নিরাপত্তা-টগল</p>
    </div>
    <div class="header-actions">
      <span class="chip chip-super"><i class="fas fa-crown"></i> সুপার এডমিন এক্সক্লুসিভ</span>
    </div>
  </div>

  <% if (flash) { %><div class="success"><%= flash %></div><% } %>

  <div class="card">
    <h3 class="card-title"><i class="fas fa-id-card"></i> সাইটের পরিচয়</h3>
    <form method="POST" action="/admin/super/settings">
      <div class="form-row-2">
        <div class="form-group"><label>সাইটের নাম</label><input type="text" name="site_name" value="<%= settings.site_name %>"></div>
        <div class="form-group"><label>মূলমন্ত্র</label><input type="text" name="motto" value="<%= settings.motto %>"></div>
      </div>
      <div class="form-group"><label>ট্যাগলাইন</label><input type="text" name="tagline" value="<%= settings.tagline %>"></div>

      <h3 class="card-title" style="margin-top:24px;"><i class="fas fa-address-book"></i> যোগাযোগ-তথ্য (সংবেদনশীল)</h3>
      <div class="form-row-2">
        <div class="form-group"><label>ইমেইল</label><input type="email" name="contact_email" value="<%= settings.contact_email %>"></div>
        <div class="form-group"><label>ফোন / বিকাশ-নগদ</label><input type="text" name="contact_phone" value="<%= settings.contact_phone %>"></div>
      </div>
      <div class="form-group"><label>ঠিকানা</label><input type="text" name="contact_address" value="<%= settings.contact_address %>"></div>

      <h3 class="card-title" style="margin-top:24px;"><i class="fas fa-share-alt"></i> সোশ্যাল মিডিয়া</h3>
      <div class="form-row-2">
        <div class="form-group"><label>Facebook URL</label><input type="url" name="facebook_url" value="<%= settings.facebook_url %>" placeholder="https://facebook.com/…"></div>
        <div class="form-group"><label>Telegram URL</label><input type="url" name="telegram_url" value="<%= settings.telegram_url %>" placeholder="https://t.me/…"></div>
      </div>
      <div class="form-row-2">
        <div class="form-group"><label>YouTube URL</label><input type="url" name="youtube_url" value="<%= settings.youtube_url %>" placeholder="https://youtube.com/…"></div>
        <div class="form-group"><label>Twitter / X URL</label><input type="url" name="twitter_url" value="<%= settings.twitter_url %>" placeholder="https://x.com/…"></div>
      </div>

      <h3 class="card-title" style="margin-top:24px;"><i class="fas fa-shield-halved"></i> সাইট-ওয়াইড নিরাপত্তা-টগল</h3>
      <div class="toggle-stack">
        <label class="super-toggle">
          <input type="checkbox" name="require_registration_approval" <%= settings.require_registration_approval === '1' ? 'checked' : '' %>>
          <span class="st-track"><span class="st-thumb"></span></span>
          <span class="st-label"><strong>রেজিস্ট্রেশন-অনুমোদন</strong><small>নতুন অ্যাকাউন্ট সুপার-এডমিন/অ্যাডমিন অনুমোদনের আগে সক্রিয় হবে না</small></span>
        </label>
        <label class="super-toggle">
          <input type="checkbox" name="account_claim_requires_admin_approval" <%= settings.account_claim_requires_admin_approval === '1' ? 'checked' : '' %>>
          <span class="st-track"><span class="st-thumb"></span></span>
          <span class="st-label"><strong>ক্লেইম-অনুমোদন</strong><small>মেম্বার-প্রোফাইল ক্লেইম অনুমোদন ছাড়া সক্রিয় হবে না</small></span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> সংরক্ষণ করুন</button>
    </form>
  </div>

  <div class="card super-danger-card">
    <h3 class="card-title"><i class="fas fa-power-off"></i> রক্ষণাবেক্ষণ-মোড (সাইট-লক)</h3>
    <p style="color:#64748b;font-size:.9rem;">চালু করলে সাধারণ দর্শকরা একটি রক্ষণাবেক্ষণ-পেজ দেখবে; স্টাফ (অ্যাডমিন/মডারেটর) স্বাভাবিকভাবে ব্রাউজ করতে পারবেন এবং প্যানেল সবসময় খোলা থাকবে।</p>
    <form method="POST" action="/admin/super/maintenance" class="js-confirm" data-msg="রক্ষণাবেক্ষণ-মোড বদলাবেন?">
      <button type="submit" class="btn <%= settings.maintenance_mode === '1' ? 'btn-primary' : 'btn-danger' %>">
        <i class="fas <%= settings.maintenance_mode === '1' ? 'fa-play' : 'fa-power-off' %>"></i>
        <%= settings.maintenance_mode === '1' ? 'সাইট আবার চালু করুন' : 'রক্ষণাবেক্ষণ-মোড চালু করুন' %>
      </button>
    </form>
  </div>

</div>
<script>
(function () {
  document.querySelectorAll('form.js-confirm').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      if (!window.confirm(f.dataset.msg || 'নিশ্চিত?')) { e.preventDefault(); }
    });
  });
})();
</script>
</body>
</html>
