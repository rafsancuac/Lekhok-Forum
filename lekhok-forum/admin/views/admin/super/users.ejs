<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ইউজার তথ্য ও পাসওয়ার্ড সাপোর্ট — সুপার এডমিন</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" /><%# session136: টোকেন-রেজোলিউশন (var(--lf-*) admin.css) %>
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">

  <div class="admin-header">
    <div>
      <h1><i class="fas fa-id-card super-ico"></i> ইউজার তথ্য ও পাসওয়ার্ড সাপোর্ট</h1>
      <p>ব্যবহারকারীর পরিচয়-তথ্য (আইডি, নাম, ইমেইল, সর্বশেষ পাসওয়ার্ড-পরিবর্তন) যাচাই ও নিরাপদ অ্যাকাউন্ট-রিকভারি</p>
    </div>
    <div class="header-actions">
      <span class="chip chip-super"><i class="fas fa-users"></i> <%= stats.total %> ব্যবহারকারী</span>
      <span class="chip chip-warn"><i class="fas fa-key"></i> <%= stats.tempActive %> টেম্পোরারি সক্রিয়</span>
    </div>
  </div>

  <% if (flash) { %><div class="success"><%= flash %></div><% } %>
  <% if (flashErr) { %><div class="error"><%= flashErr %></div><% } %>

  <%# ── নিরাপত্তা-নীতি নোট — কেন মূল পাসওয়ার্ড দেখা যায় না ── %>
  <div class="us-note">
    <i class="fas fa-shield-halved"></i>
    <div>
      <strong>নিরাপত্তা-নীতি:</strong> পাসওয়ার্ড একমুখী bcrypt-হ্যাশে সংরক্ষিত — কেউই (এমনকি সুপার এডমিনও) মূল পাসওয়ার্ড দেখতে পারবেন না। বিপদে পড়া ব্যবহারকারীকে সহায়তার ইন্ডাস্ট্রি-স্ট্যান্ডার্ড পথ: নিচের তালিকা থেকে সঠিক ব্যক্তিকে যাচাই করে একটি <em>অস্থায়ী পাসওয়ার্ড</em> তৈরি করে দিন — লগইন করা মাত্রই সিস্টেম তাকে নিজের নতুন পাসওয়ার্ড সেট করতে বাধ্য করবে। প্রতিটি অ্যাকশন অডিট-লগে রেকর্ড হয়।
    </div>
  </div>

  <%# ── অ্যাম্বার অ্যালার্ট — সদ্য তৈরি হওয়া অস্থায়ী পাসওয়ার্ড (একবারই দৃশ্যমান) ── %>
  <div class="us-alert" id="usAlert" hidden role="status" aria-live="polite">
    <div class="us-alert-body">
      <div class="us-alert-title"><i class="fas fa-key"></i> অস্থায়ী পাসওয়ার্ড তৈরি সম্পন্ন হয়েছে!</div>
      <div class="us-alert-user">ব্যবহারকারী: <strong id="usAlertName"></strong></div>
      <div class="us-alert-pwd-row">
        <code class="us-pwd" id="usAlertPwd" title="ক্লিক করে সিলেক্ট করুন"></code>
        <button type="button" class="btn btn-outline btn-sm" id="usCopyBtn"><i class="far fa-copy"></i> কপি</button>
      </div>
      <div class="us-alert-hint">
        <i class="fas fa-circle-info"></i>
        ব্যবহারকারীকে এই পাসওয়ার্ডটি দিন — লগইন আইডি: <strong id="usAlertLogin"></strong>।
        এই পাসওয়ার্ডে লগইন করা মাত্রই তাকে নতুন নিজস্ব পাসওয়ার্ড সেট করতে হবে। এই পাসওয়ার্ড আর দ্বিতীয়বার দেখানো যাবে না।
      </div>
    </div>
    <button type="button" class="us-alert-close" id="usAlertClose" aria-label="বন্ধ করুন"><i class="fas fa-xmark"></i></button>
  </div>

  <%# ── সার্চ + পরিসংখ্যান ── %>
  <form class="us-searchbar" method="GET" action="/admin/super/users-support">
    <div class="us-search-wrap">
      <i class="fas fa-magnifying-glass"></i>
      <input type="text" id="usSearch" name="q" value="<%= q %>"
             placeholder="নাম, ইউজারনেম, ইমেইল, ফোন বা আইডি দিয়ে খুঁজুন..." autocomplete="off" />
      <button type="button" class="us-clear" id="usClear" aria-label="সার্চ মুছুন" hidden><i class="fas fa-xmark"></i></button>
    </div>
    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> খুঁজুন</button>
    <% if (q) { %><a href="/admin/super/users-support" class="btn btn-secondary"><i class="fas fa-rotate-left"></i> রিসেট</a><% } %>
    <span class="us-count" id="usCount"><%= users.length %> জন</span>
  </form>

  <div class="us-chips">
    <span class="chip chip-info"><i class="fas fa-circle-check"></i> সক্রিয়: <%= stats.active %></span>
    <span class="chip"><i class="fas fa-hourglass-half"></i> অপেক্ষমাণ: <%= stats.pending %></span>
    <span class="chip chip-danger"><i class="fas fa-ban"></i> নিষিদ্ধ: <%= stats.banned %></span>
    <span class="chip chip-warn"><i class="fas fa-key"></i> টেম্পোরারি: <%= stats.tempActive %></span>
    <span class="chip"><i class="fas fa-mobile-screen"></i> 2FA: <%= stats.with2fa %></span>
  </div>

  <%# ── ব্যবহারকারী তালিকা ── %>
    <%# ── session273 — su273 তাৎক্ষণিক-ফিল্টার (au270/av271/ch272-প্যাটার্ন-মিরর, একক-স্ট্রিপ — 'f'-মালিকানা-নির্দ্বিধা) ── %>
  <div class="su273-instant" id="suInstant273">
    <i class="fas fa-filter su273-ico" aria-hidden="true"></i>
    <input type="text" id="suFilter273" class="su273-input" placeholder="তাৎক্ষণিক ফিল্টার — রোল / স্ট্যাটাস / নাম / ইমেইল / 2FA" autocomplete="off" aria-label="ইউজার-তালিকা তাৎক্ষণিক ফিল্টার" />
    <button type="button" id="suClear273" class="su273-clear" aria-label="ফিল্টার মুছুন" hidden><i class="fas fa-times"></i></button>
    <span class="su273-count-chip" id="suCount273" hidden></span>
    <span class="su273-kbd-hint" aria-hidden="true"><kbd>f</kbd> ফোকাস · <kbd>Esc</kbd> মুছুন</span>
  </div>

  <div class="us-table-wrap">
    <table class="us-table">
      <thead>
        <tr>
          <th>ব্যবহারকারী</th>
          <th>ইউজার আইডি</th>
          <th>যোগাযোগ</th>
          <th>রোল ও স্ট্যাটাস</th>
          <th>সর্বশেষ পাসওয়ার্ড পরিবর্তন</th>
          <th>শেষ লগইন</th>
          <th>পাসওয়ার্ড স্ট্যাটাস</th>
          <th class="th-action">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody id="usTbody">
        <% if (users.length === 0) { %>
          <tr><td colspan="8" class="us-empty"><i class="fas fa-user-slash"></i> কোনো ব্যবহারকারী পাওয়া যায়নি</td></tr>
        <% } %>
        <%
          const bnDT = (s) => {
            if (!s) return '';
            const d = new Date(String(s).replace(' ', 'T'));
            if (isNaN(d.getTime())) return '';
            return d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' })
              + ', ' + d.toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' });
          };
          const ROLE_LABEL = { user: 'ইউজার', moderator: 'মডারেটর', admin: 'এডমিন', superadmin: 'সুপার এডমিন' };
          const ROLE_CLASS = { user: 'role-user', moderator: 'role-moderator', admin: 'role-admin', superadmin: 'role-superadmin' };
          const STATUS_LABEL = { active: 'সক্রিয়', pending: 'অপেক্ষমাণ', banned: 'নিষিদ্ধ', inactive: 'নিষ্ক্রিয়' };
          const STATUS_CLASS = { active: 'status-active', pending: 'status-pending', banned: 'status-banned', inactive: 'status-closed' };
        %>
        <% users.forEach((u, suI273) => { %>
          <%
            const searchable = [u.id, u.username, u.full_name, u.pen_name, u.email, u.phone, u.member_id]
              .filter(Boolean).join(' ').toLowerCase();
            /* session273 — su273 দ্বিভাষিক data-kw (রোল/স্ট্যাটাস/টেম্পো/2FA/ইমেইল/ফোন/মেম্বার — হোয়াইটস্পেস-নরমালাইজড) */
            const suKw273 = [
              '#' + u.id,
              'ইউজার user',
              '@' + u.username,
              'নাম name', String(u.full_name || u.username || '').replace(/\s+/g, ' '),
              u.pen_name ? 'কলমী penname ' + String(u.pen_name).replace(/\s+/g, ' ') : '',
              'রোল role', ROLE_LABEL[u.role] || u.role,
              /* ROLE_ALIAS273 — মান-টোকেনও দ্বিভাষিক (av271-চুক্তি) */
              ({ user: 'user', moderator: 'moderator', admin: 'admin', superadmin: 'superadmin' })[u.role] || '',
              'স্ট্যাটাস status', STATUS_LABEL[u.status] || u.status,
              ({ active: 'active', pending: 'pending', banned: 'banned', inactive: 'inactive' })[u.status] || '',
              u.must_change_password ? 'টেম্পোরারি-সক্রিয় temporary অস্থায়ী' : 'স্বাভাবিক normal',
              u.totp_enabled ? '2FA totp দুই-স্তর' : '',
              u.email ? 'ইমেইল email ' + String(u.email).replace(/\s+/g, ' ') : '',
              u.phone ? 'ফোন phone ' + String(u.phone).replace(/\s+/g, ' ') : '',
              u.member_id ? 'মেম্বার member ' + u.member_id : ''
            ].filter(Boolean).join(' ');
          %>
          <tr class="us-row <%= u.must_change_password ? 'us-row-temp' : '' %>" data-search="<%= searchable %>" data-uid="<%= u.id %>" data-su-row="<%= suI273 %>" data-kw="<%= suKw273 %>">
            <td>
              <div class="us-user">
                <img src="<%= u.avatar_url || '/avatar/' + u.id %>" class="us-avatar" alt="<%= u.full_name || u.username %>"
                     onerror="this.src='/assets/img/avatar-placeholder.svg'" />
                <div class="us-user-meta">
                  <a href="/profile/<%= encodeURIComponent(u.username) %>" target="_blank" class="us-name"><%= u.full_name || u.username %></a>
                  <div class="us-username">@<%= u.username %><% if (u.pen_name) { %> <span class="us-pen" title="কলমী নাম">✒ <%= u.pen_name %></span><% } %></div>
                </div>
              </div>
            </td>
            <td class="us-ids">
              <span class="us-idchip" title="ডাটাবেজ আইডি"><i class="fas fa-hashtag"></i> <%= u.id %></span>
              <% if (u.member_id) { %><span class="us-idchip us-idmem" title="মেম্বার আইডি (লগইন-যোগ্য)"><i class="fas fa-id-badge"></i> <%= u.member_id %></span><% } %>
            </td>
            <td class="us-contact">
              <% if (u.email) { %><div class="us-c-line"><i class="fas fa-envelope"></i> <%= u.email %></div><% } %>
              <% if (u.phone) { %><div class="us-c-line"><i class="fas fa-phone"></i> <%= u.phone %></div><% } %>
              <% if (!u.email && !u.phone) { %><span class="us-none">—</span><% } %>
            </td>
            <td class="us-rolecell">
              <span class="badge-soft <%= ROLE_CLASS[u.role] || 'role-user' %>"><%= ROLE_LABEL[u.role] || u.role %></span>
              <span class="badge-soft <%= STATUS_CLASS[u.status] || 'status-closed' %>"><%= STATUS_LABEL[u.status] || u.status %></span>
              <% if (u.totp_enabled) { %><span class="badge-soft" title="দুই-স্তর যাচাই সক্রিয় — টেম্পোরারি পাসওয়ার্ডেও 2FA কোড লাগবে"><i class="fas fa-mobile-screen"></i> 2FA</span><% } %>
            </td>
            <td class="us-pwdate"><%= u.password_changed_at ? bnDT(u.password_changed_at) : 'তথ্য নেই' %></td>
            <td class="us-lastlogin"><%= u.last_login ? bnDT(u.last_login) : 'কখনো নয়' %></td>
            <td class="us-pwstatus">
              <% if (u.must_change_password) { %>
                <span class="badge-soft status-pending"><i class="fas fa-key"></i> টেম্পোরারি সক্রিয়</span>
              <% } else { %>
                <span class="badge-soft status-active">স্বাভাবিক</span>
              <% } %>
            </td>
            <td class="us-action">
              <button type="button" class="btn btn-primary btn-sm us-gen"
                      data-uid="<%= u.id %>" data-uname="<%= u.username %>" data-name="<%= u.full_name || u.username %>">
                <i class="fas fa-key"></i> অস্থায়ী পাসওয়ার্ড দিন
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

    <div class="su273-zero" id="suZero273" data-su-empty hidden>
    <i class="fas fa-filter-circle-xmark" aria-hidden="true"></i>
    <span>কোনো ব্যবহারকারী মেলেনি — ফিল্টার মুছে আবার চেষ্টা করুন</span>
  </div>

  <% if (users.length >= 300) { %>
    <p class="us-more-hint"><i class="fas fa-circle-info"></i> সর্বশেষ ৩০০ জন দেখানো হচ্ছে — আরও সুনির্দিষ্ট ফলাফলের জন্য সার্চ ব্যবহার করুন।</p>
  <% } %>

</div>

<script>
(function () {
  'use strict';
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var searchInput = document.getElementById('usSearch');
  var clearBtn = document.getElementById('usClear');
  var countEl = document.getElementById('usCount');
  var rows = Array.prototype.slice.call(document.querySelectorAll('#usTbody tr[data-search]'));
  var alertBox = document.getElementById('usAlert');
  var alertPwd = document.getElementById('usAlertPwd');
  var alertName = document.getElementById('usAlertName');
  var alertLogin = document.getElementById('usAlertLogin');
  var copyBtn = document.getElementById('usCopyBtn');

  // ── তাৎক্ষণিক ক্লায়েন্ট-ফিল্টার (প্রতিটি কী-স্ট্রোকে) ──
  function applyFilter() {
    var q = (searchInput.value || '').trim().toLowerCase();
    if (clearBtn) clearBtn.hidden = !searchInput.value;
    var shown = 0;
    rows.forEach(function (r) {
      var hit = !q || r.getAttribute('data-search').indexOf(q) !== -1;
      r.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    if (countEl) countEl.textContent = shown + ' জন' + (shown < rows.length ? ' (মোট ' + rows.length + ')' : '');
    var emptyRow = document.querySelector('#usTbody .us-empty');
    if (emptyRow) emptyRow.parentNode.style.display = rows.length === 0 ? '' : 'none';
  }
  if (searchInput) {
    searchInput.addEventListener('input', applyFilter);
    if (searchInput.value) applyFilter();
  }
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      searchInput.value = '';
      applyFilter();
      searchInput.focus();
    });
  }

  // ── অ্যাম্বার অ্যালার্ট-বক্স ──
  function showAlert(data) {
    alertName.textContent = data.fullName || data.username || '';
    alertLogin.textContent = data.loginHint || data.username || '';
    alertPwd.textContent = data.temporaryPassword || '';
    alertBox.hidden = false;
    alertBox.classList.remove('is-anim');
    void alertBox.offsetWidth; // reflow → অ্যানিমেশন রিস্টার্ট
    alertBox.classList.add('is-anim');
    try { alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) {}
  }
  var closeBtn = document.getElementById('usAlertClose');
  if (closeBtn) closeBtn.addEventListener('click', function () { alertBox.hidden = true; });

  // কপি (clipboard-API + লিগ্যাসি ফলব্যাক)
  function copyText(txt) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(txt);
    }
    return new Promise(function (resolve, reject) {
      var ta = document.createElement('textarea');
      ta.value = txt; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy') ? resolve() : reject(); }
      catch (e) { reject(e); }
      finally { ta.remove(); }
    });
  }
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      var btn = this;
      copyText(alertPwd.textContent).then(function () {
        btn.innerHTML = '<i class="fas fa-check"></i> কপি হয়েছে ✓';
        setTimeout(function () { btn.innerHTML = '<i class="far fa-copy"></i> কপি'; }, 1800);
      }).catch(function () { alertPwd.focus(); });
    });
  }
  if (alertPwd) {
    alertPwd.addEventListener('click', function () {
      var range = document.createRange();
      range.selectNodeContents(alertPwd);
      var sel = window.getSelection();
      sel.removeAllRanges(); sel.addRange(range);
    });
  }

  // ── অস্থায়ী পাসওয়ার্ড জেনারেশন (fetch + কনফার্ম) ──
  function bnNow() {
    var d = new Date();
    return d.toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' })
      + ', ' + d.toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' });
  }
  document.querySelectorAll('.us-gen').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var uid = btn.getAttribute('data-uid');
      var uname = btn.getAttribute('data-uname');
      var name = btn.getAttribute('data-name');
      if (!window.confirm('আপনি কি নিশ্চিত যে "' + name + '" (@' + uname + ') এর জন্য একটি নতুন অস্থায়ী পাসওয়ার্ড তৈরি করবেন?\n\nযেহেতু পাসওয়ার্ড একমুখী-এনক্রিপ্টেড, মূল পাসওয়ার্ড উদ্ধার সম্ভব নয় — পুরনো পাসওয়ার্ড বাতিল হয়ে নতুন অস্থায়ী পাসওয়ার্ড সেট হবে।')) return;
      var origHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> জেনারেট হচ্ছে...';
      try {
        var res = await fetch('/admin/super/users/' + uid + '/reset-temp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
          body: JSON.stringify({})
        });
        var data = await res.json().catch(function () { return {}; });
        if (res.ok && data.ok) {
          showAlert(data);
          // সারি-আপডেট: স্ট্যাটাস → টেম্পোরারি সক্রিয়, তারিখ → এইমাত্র
          var row = document.querySelector('tr[data-uid="' + uid + '"]');
          if (row) {
            row.classList.add('us-row-temp');
            var pwst = row.querySelector('.us-pwstatus');
            if (pwst) pwst.innerHTML = '<span class="badge-soft status-pending"><i class="fas fa-key"></i> টেম্পোরারি সক্রিয়</span>';
            var pwdt = row.querySelector('.us-pwdate');
            if (pwdt) pwdt.textContent = bnNow();
          }
        } else {
          window.alert(data.error || 'পাসওয়ার্ড তৈরি ব্যর্থ হয়েছে — আবার চেষ্টা করুন।');
        }
      } catch (e) {
        window.alert('নেটওয়ার্ক সমস্যা — আবার চেষ্টা করুন।');
      } finally {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    });
  });
})();
</script>
<script>
  (function () {
    /* session273 — su273 তাৎক্ষণিক-ফিল্টার (au270/av271/ch272-প্যাটার্ন-মিরর, একক-স্ট্রিপ — 'f'-ফোকাস-মালিকানা-নির্দ্বিধা: data-kw-সারফেস + কাউন্ট-চিপ + শূন্য-অবস্থা + 'f'-ফোকাস-ফিল্ড-গার্ড + Escape + __suQA — সারফেস-শূন্যে-ও-সংজ্ঞায়িত; বিদ্যমান us-সার্চ-ফিল্টার-অক্ষুণ্ণ — দুই-স্বাধীন-ডাইমেনশন) */
    var rows = Array.prototype.slice.call(document.querySelectorAll('tr[data-su-row]'));
    var input = document.getElementById('suFilter273');
    var clearBtn = document.getElementById('suClear273');
    var countChip = document.getElementById('suCount273');
    var zeroBox = document.getElementById('suZero273');
    if (!input) { return; }
    var total = rows.length;
    function suApply273() {
      var q = (input.value || '').trim().toLowerCase();
      var shown = 0;
      rows.forEach(function (row) {
        var kw = (row.getAttribute('data-kw') || '').toLowerCase();
        var hit = !q || kw.indexOf(q) !== -1;
        row.hidden = !hit;
        if (hit) { shown++; }
      });
      if (countChip) { countChip.hidden = !q; if (q) { countChip.textContent = shown + ' / ' + total; } }
      if (clearBtn) { clearBtn.hidden = !q; }
      if (zeroBox) { zeroBox.hidden = !(q && shown === 0); }
    }
    function suClearFn273() {
      input.value = '';
      suApply273();
      input.blur();
    }
    input.addEventListener('input', suApply273);
    if (clearBtn) { clearBtn.addEventListener('click', suClearFn273); }
    input.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape') { ev.stopPropagation(); suClearFn273(); }
    });
    document.addEventListener('keydown', function (ev) {
      if (ev.key !== 'f' || ev.altKey || ev.ctrlKey || ev.metaKey) { return; }
      var t = ev.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) { return; }
      ev.preventDefault();
      input.focus();
      input.select();
    });
    window.__suQA = {
      total: function () { return total; },
      count: function () { return rows.filter(function (r) { return !r.hidden; }).length; },
      apply: suApply273,
      clear: suClearFn273
    };
  })();
</script>
<style>
    /* session273 — su273 তাৎক্ষণিক-ফিল্টার স্টাইল (au270-প্যাটার্ন-মিরর — হেক্স-শূন্য টোকেন-শুধু) */
    .su273-instant { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 14px; padding: 10px 14px; border: 1px solid var(--lf-fb-border); border-radius: 14px; background: var(--lf-white); }
    .su273-ico { color: var(--lf-brandgreen); opacity: .75; }
    .su273-input { flex: 1 1 230px; min-width: 0; border: 1px solid transparent; border-radius: 10px; padding: 8px 12px; font: inherit; color: var(--lf-slate); background: var(--lf-brandgreen-soft); transition: none; }
    .su273-input:focus { outline: none; border-color: color-mix(in srgb, var(--lf-brandgreen) 45%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--lf-brandgreen) 15%, transparent); }
    .su273-clear { border: 0; background: transparent; color: var(--lf-brandgreen); cursor: pointer; padding: 6px 9px; border-radius: 9px; transition: none; }
    .su273-clear:hover { background: var(--lf-brandgreen-soft); }
    .su273-clear:active { transform: scale(.96); }
    .su273-count-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: .82rem; font-weight: 600; color: var(--lf-brandgreen-deep); background: var(--lf-brandgreen-soft-2); }
    .su273-count-chip[hidden] { display: none; }
    .su273-kbd-hint { display: inline-flex; align-items: center; gap: 5px; font-size: .78rem; color: var(--lf-slate); }
    .su273-kbd-hint kbd { padding: 2px 7px; border: 1px dashed color-mix(in srgb, var(--lf-brandgreen) 55%, transparent); border-radius: 7px; font: inherit; font-size: .74rem; color: var(--lf-brandgreen-deep); background: var(--lf-white); }
    .su273-zero { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; padding: 14px 16px; border: 1px dashed color-mix(in srgb, var(--lf-brandgreen) 35%, transparent); border-radius: 12px; color: var(--lf-slate); background: var(--lf-brandgreen-soft); }
    .su273-zero[hidden] { display: none; }
    tr[data-su-row][hidden] { display: none !important; }
    @media (prefers-reduced-motion: reduce) { .su273-clear:active { transform: none; } }
    @media (max-width: 640px) { .su273-kbd-hint { display: none; } .su273-instant { padding: 9px 11px; } }
  </style>
</body>
</html>
