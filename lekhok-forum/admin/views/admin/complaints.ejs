<%- include('./partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>অভিযোগ ব্যবস্থাপনা</h1>
    <p><%= newCount %> টি নতুন অভিযোগ — এই তথ্য গোপনীয়, শুধু নির্ধারিত কর্মীরা দেখতে পারেন</p>
  </div>
  <div style="margin-bottom:12px;">
    <a href="/admin/complaints" class="btn <%= !status ? 'btn-primary' : '' %> btn-sm">সব</a>
    <a href="/admin/complaints?status=new" class="btn <%= status === 'new' ? 'btn-primary' : '' %> btn-sm">নতুন</a>
    <a href="/admin/complaints?status=in_review" class="btn <%= status === 'in_review' ? 'btn-primary' : '' %> btn-sm">পর্যালোচনাধীন</a>
    <a href="/admin/complaints?status=resolved" class="btn <%= status === 'resolved' ? 'btn-primary' : '' %> btn-sm">সমাধান হয়েছে</a>
    <a href="/admin/complaints?status=dismissed" class="btn <%= status === 'dismissed' ? 'btn-primary' : '' %> btn-sm">বাতিল</a>
  </div>
  <% if (complaints.length === 0) { %>
    <div class="card empty">কোনো অভিযোগ নেই</div>
  <% } else { %>
    <% complaints.forEach(c => { %>
    <div class="card" style="margin-bottom:14px;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;">
        <div>
          <strong style="font-size:1.05rem;"><%= c.subject %></strong>
          <div style="color:#666; font-size:.85rem; margin-top:4px;">
            <i class="fas fa-user"></i>
            <% if (c.submitter_username) { %>
              <a href="/profile/<%= c.submitter_username %>"><%= c.submitter_name || c.submitter_username %></a>
            <% } else { %>
              অজানা ব্যবহারকারী
            <% } %>
            &middot; <%= c.created_at %>
          </div>
        </div>
        <span style="padding:3px 10px; border-radius:12px; font-size:.8rem; font-weight:600;
          <%= c.status === 'new' ? 'background:#fdecea; color:#c41033;' : c.status === 'in_review' ? 'background:#fff7e0; color:#9a6b00;' : c.status === 'resolved' ? 'background:#e6f6ea; color:#0a7d33;' : 'background:#eee; color:#555;' %>">
          <%= c.status === 'new' ? 'নতুন' : c.status === 'in_review' ? 'পর্যালোচনাধীন' : c.status === 'resolved' ? 'সমাধান হয়েছে' : 'বাতিল' %>
        </span>
      </div>
      <% if (c.body) { %><p style="margin:10px 0; white-space:pre-wrap;"><%= c.body %></p><% } %>
      <% if (c.file_url) { %>
        <p style="margin:8px 0;">
          <i class="fas fa-paperclip"></i>
          <a href="<%= c.file_url %>" target="_blank" download><%= c.file_name || 'সংযুক্ত ফাইল' %></a>
        </p>
      <% } %>
      <form method="POST" action="/admin/complaints/<%= c.id %>?_method=PUT" style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-top:8px;">
        <select name="status" style="width:auto;">
          <option value="new" <%= c.status === 'new' ? 'selected' : '' %>>নতুন</option>
          <option value="in_review" <%= c.status === 'in_review' ? 'selected' : '' %>>পর্যালোচনাধীন</option>
          <option value="resolved" <%= c.status === 'resolved' ? 'selected' : '' %>>সমাধান হয়েছে</option>
          <option value="dismissed" <%= c.status === 'dismissed' ? 'selected' : '' %>>বাতিল</option>
        </select>
        <input type="text" name="admin_notes" placeholder="অভ্যন্তরীণ নোট" value="<%= c.admin_notes || '' %>" style="flex:1; min-width:180px;">
        <button type="submit" class="btn btn-primary btn-sm">সংরক্ষণ</button>
      </form>
      <form method="POST" action="/admin/complaints/<%= c.id %>?_method=DELETE" style="margin-top:6px;" onsubmit="return confirm('অভিযোগটি মুছে ফেলতে চান?')">
        <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> মুছুন</button>
      </form>
    </div>
    <% }) %>
  <% } %>
</div>
