<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>বাংলাদেশ তরুণ কলাম লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><%= event ? 'ইভেন্ট সম্পাদনা' : 'নতুন ইভেন্ট' %></h1>
    <p><a href="/admin/events">← ইভেন্ট তালিকায় ফিরে যান</a></p>
  </div>
  <div class="card">
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="<%= event ? '/admin/events/' + event.id + '?_method=PUT' : '/admin/events' %>">
      <div class="form-group"><label>শিরোনাম *</label><input type="text" name="title" value="<%= event ? event.title : '' %>" required></div>
      <div class="form-group"><label>বিবরণ</label><textarea name="description" rows="4"><%= event ? (event.description || '') : '' %></textarea></div>
      <div class="form-group"><label>তারিখ</label><input type="text" name="date" value="<%= event ? (event.date || '') : '' %>" placeholder="YYYY-MM-DD"></div>
      <div class="form-group"><label>শেষ তারিখ</label><input type="text" name="end_date" value="<%= event ? (event.end_date || '') : '' %>" placeholder="YYYY-MM-DD"></div>
      <div class="form-group"><label>স্থান</label><input type="text" name="location" value="<%= event ? (event.location || '') : '' %>"></div>
      <div class="form-group"><label>ছবির URL</label><input type="url" name="image_url" value="<%= event ? (event.image_url || '') : '' %>" placeholder="https://..."></div>
      <div class="form-group"><label><input type="checkbox" name="featured" value="1" <%= event && event.featured ? 'checked' : '' %>> বিশেষ ইভেন্ট (Featured)</label></div>
      <button type="submit" class="btn btn-primary"><%= event ? 'আপডেট' : 'তৈরি করুন' %></button>
    </form>
  </div>
</div>
</body>
</html>
