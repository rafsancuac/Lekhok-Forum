<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>কনটেন্ট সম্পাদক | লেখক ফোরাম অ্যাডমিন</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body class="ce-body">
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><i class="fas fa-pen-square"></i> কনটেন্ট সম্পাদক</h1>
    <a class="btn btn-sm" href="/admin/content/history" style="margin-left:10px;"><i class="fas fa-history"></i> রিভিশন হিস্ট্রি</a>
    <p>সাইটের প্রতিটি পেজের প্রতিটি সেকশনের লেখা ও ছবি এখান থেকে বদলান। সেকশনে <b>সম্পাদনা</b> চেপে শুধু সেই সেকশনটি বদলে <b>সেভ করুন</b> — পুরো পেজ রিলোড হয় না। ফিল্ড খালি রাখলে ডিফল্ট লেখাটিই দেখাবে।</p>
  </div>

  <% if (saved) { %>
    <div class="ce-banner ce-banner-success"><i class="fas fa-check-circle"></i> সব পরিবর্তন সফলভাবে সংরক্ষিত হয়েছে।</div>
  <% } %>
  <% if (error) { %>
    <div class="ce-banner ce-banner-error"><i class="fas fa-exclamation-triangle"></i> <%= error %></div>
  <% } %>

  <form method="POST" action="/admin/content" id="contentForm" autocomplete="off" enctype="multipart/form-data">
    <input type="hidden" name="__page" id="ceActivePage" value="<%= activePage %>" />

    <div class="ce-wrap">
      <!-- ── বাম: পেজ ট্যাব ── -->
      <aside class="ce-tabs" id="ceTabs">
        <div class="ce-tabs-title"><i class="fas fa-layer-group"></i> পেজসমূহ</div>
        <% pages.forEach((p, pi) => { %>
          <button type="button" class="ce-tab <%= p.key === activePage ? 'active' : '' %>" data-page="<%= p.key %>">
            <span class="ce-tab-ico"><i class="<%= p.icon || 'fas fa-file-alt' %>"></i></span>
            <span class="ce-tab-body">
              <span class="ce-tab-label"><%= p.label %></span>
              <span class="ce-tab-meta"><%= p.groups.reduce((n, g) => n + g.fields.length, 0) %> ফিল্ড</span>
            </span>
          </button>
        <% }) %>
      </aside>

      <!-- ── ডান: প্যানেলসমূহ ── -->
      <div class="ce-panels">
        <% pages.forEach((p) => { %>
        <section class="ce-panel <%= p.key === activePage ? 'active' : '' %>" data-page="<%= p.key %>">
          <div class="ce-panel-head">
            <div class="ce-panel-title">
              <span class="ce-panel-ico"><i class="<%= p.icon || 'fas fa-file-alt' %>"></i></span>
              <div>
                <h2><%= p.label %></h2>
                <p>নিচের ফিল্ডগুলো <%= p.path %> পেজে প্রদর্শিত হয়</p>
              </div>
            </div>
            <a class="ce-view-link" href="<%= p.path %>" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> সাইটে দেখুন</a>
          </div>

          <% p.groups.forEach((g) => { %>
          <div class="ce-group is-locked" data-group="<%= g.key %>">
            <div class="ce-group-head">
              <h3 class="ce-group-title"><%= g.label %> <span class="ce-group-count"><%= g.fields.length %></span></h3>
              <div class="ce-group-actions">
                <span class="ce-group-status" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-sm ce-edit-btn"><i class="fas fa-pen"></i> সম্পাদনা</button>
                <button type="button" class="btn btn-sm btn-primary ce-save-section-btn" hidden><i class="fas fa-check"></i> সেভ করুন</button>
                <button type="button" class="btn btn-sm ce-cancel-btn" hidden><i class="fas fa-times"></i> বাতিল</button>
              </div>
            </div>
            <div class="ce-grid">
              <% g.fields.forEach((f) => { %>
              <% const isImg = f.type === 'image'; %>
              <div class="ce-field ce-t-<%= f.type %>">
                <div class="ce-label-row">
                  <label for="f_<%= f.key %>"><%= f.label %></label>
                  <% if (!isImg) { %>
                  <button type="button" class="ce-reset" data-key="<%= f.key %>" title="ডিফল্ট লেখায় ফিরিয়ে আনুন">
                    <i class="fas fa-rotate-left"></i> ডিফল্ট
                  </button>
                  <% } %>
                </div>

                <% if (isImg) { %>
                  <%# ── সেশন ৩৫: ছবি/ব্যানার আপলোড-ফিল্ড ── %>
                  <div class="ce-img" data-key="<%= f.key %>">
                    <input type="hidden" name="reset_<%= f.key %>" value="0" class="ce-img-reset-flag" />
                    <div class="ce-img-preview">
                      <% if (values[f.key]) { %>
                        <img src="<%= values[f.key] %>?v=<%= AV %>" alt="<%= f.label %>" />
                        <span class="ce-img-set-badge"><i class="fas fa-check"></i> কাস্টম ছবি সেট আছে</span>
                      <% } else { %>
                        <span class="ce-img-empty"><i class="fas fa-image"></i> কোনো ছবি সেট করা নেই — ডিফল্ট ডিজাইন দেখাবে</span>
                      <% } %>
                    </div>
                    <div class="ce-img-actions">
                      <label class="ce-img-upload" for="f_<%= f.key %>">
                        <i class="fas fa-cloud-upload-alt"></i> <%= values[f.key] ? 'ছবি বদলান' : 'ছবি আপলোড করুন' %>
                        <input type="file" id="f_<%= f.key %>" name="img_<%= f.key %>" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" hidden />
                      </label>
                      <% if (values[f.key]) { %>
                      <button type="button" class="ce-img-reset" data-key="<%= f.key %>">
                        <i class="fas fa-rotate-left"></i> রিসেট টু ডিফল্ট
                      </button>
                      <% } %>
                    </div>
                    <small class="ce-img-fileinfo" hidden></small>
                    <% if (f.hint) { %><small class="ce-hint"><%= f.hint %></small><% } %>
                  </div>
                <% } else if (f.type === 'textarea') { %>
                  <textarea id="f_<%= f.key %>" name="<%= f.key %>" rows="<%= f.rows || 3 %>" readonly data-default="<%= defaults[f.key] || '' %>"><%= values[f.key] %></textarea>
                <% } else { %>
                  <input id="f_<%= f.key %>" name="<%= f.key %>" type="text" readonly value="<%= values[f.key] %>" data-default="<%= defaults[f.key] || '' %>"
                         <%= f.type === 'number' ? 'inputmode="numeric"' : '' %> />
                <% } %>
                <% if (f.type === 'icon') { %>
                  <span class="ce-icon-preview"><i class="fas <%= values[f.key] %>"></i></span>
                <% } %>
                <% if (f.hint && !isImg) { %><small class="ce-hint"><%= f.hint %></small><% } %>
                <% if (f.type === 'icon') { %><small class="ce-hint">Font Awesome ক্লাস | যেমন fa-pen-fancy</small><% } %>
              </div>
              <% }) %>
            </div>
          </div>
          <% }) %>
        </section>
        <% }) %>
      </div>
    </div>

    <!-- ── স্টিকি সেভ বার (সব পেজ একসাথে সেভ করার ফলব্যাক) ── -->
    <div class="ce-savebar" id="ceSavebar">
      <div class="ce-savebar-info">
        <i class="fas fa-circle-info"></i>
        <span><strong id="ceDirtyCount">০</strong>টি ফিল্ডে অসংরক্ষিত পরিবর্তন • সাধারণত সেকশন-ভিত্তিক সেভ ব্যবহার করুন</span>
      </div>
      <button type="submit" class="btn btn-primary ce-save-btn" id="ceSaveBtn"><i class="fas fa-save"></i> সব পেজ একসাথে সংরক্ষণ</button>
    </div>
  </form>
</div>

<script>
(function () {
  'use strict';
  var form = document.getElementById('contentForm');
  if (!form) return;
  var AV = '<%= AV || "" %>';

  /* ── ট্যাব সুইচিং ──────────────────────────────────────────────── */
  var tabs = document.querySelectorAll('.ce-tab');
  var panels = document.querySelectorAll('.ce-panel');
  var activeInput = document.getElementById('ceActivePage');

  function showPage(key, push) {
    tabs.forEach(function (t) { t.classList.toggle('active', t.getAttribute('data-page') === key); });
    panels.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-page') === key); });
    if (activeInput) activeInput.value = key;
    try { localStorage.setItem('ceTab', key); } catch (e) {}
    if (push) {
      var url = location.pathname + '?page=' + encodeURIComponent(key);
      history.replaceState(null, '', url);
    }
    var panel = document.querySelector('.ce-panel.active');
    if (panel) window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  tabs.forEach(function (t) {
    t.addEventListener('click', function () { showPage(t.getAttribute('data-page'), true); });
  });

  try {
    var saved = localStorage.getItem('ceTab');
    var qs = new URLSearchParams(location.search).get('page');
    var initial = qs || saved;
    if (initial && !document.querySelector('.ce-panel.active[data-page="' + initial + '"]')) {
      if (document.querySelector('.ce-panel[data-page="' + initial + '"]')) showPage(initial, false);
    }
  } catch (e) {}

  /* ── অসংরক্ষিত পরিবর্তন গণনা ──────────────────────────────────── */
  var dirty = {};
  function bn(n) { return String(n).replace(/[0-9]/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; }); }
  function refresh() {
    var n = Object.keys(dirty).length;
    var el = document.getElementById('ceDirtyCount');
    if (el) el.textContent = bn(n);
    var btn = document.getElementById('ceSaveBtn');
    if (btn) btn.classList.toggle('has-dirty', n > 0);
  }
  form.querySelectorAll('input[type=text], textarea').forEach(function (el) {
    if (!el.name) return;
    var orig = el.value;
    el.addEventListener('input', function () {
      if (el.value === orig) delete dirty[el.name];
      else dirty[el.name] = true;
      refresh();
      var wrap = el.closest('.ce-field');
      if (wrap && wrap.classList.contains('ce-t-icon')) {
        var ic = wrap.querySelector('.ce-icon-preview i');
        if (ic) ic.className = 'fas ' + el.value.trim();
      }
    });
  });

  /* ── সেশন ৩৫: প্রতি-ফিল্ড "রিসেট টু ডিফল্ট" (টেক্সট/টেক্সটেরিয়া/সংখ্যা/আইকন) ── */
  form.querySelectorAll('.ce-reset').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-key');
      var input = document.getElementById('f_' + key);
      if (!input) return;
      var def = input.getAttribute('data-default') || '';
      input.value = def;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
      btn.classList.add('flashed');
      setTimeout(function () { btn.classList.remove('flashed'); }, 900);
    });
  });

  /* ── সেশন ৩৫: ছবি/ব্যানার আপলোড-ফিল্ড ───────────────────────────── */
  form.querySelectorAll('.ce-img').forEach(function (box) {
    var key = box.getAttribute('data-key');
    var fileInput = box.querySelector('input[type=file]');
    var fileinfo = box.querySelector('.ce-img-fileinfo');
    var resetFlag = box.querySelector('.ce-img-reset-flag');
    var resetBtn = box.querySelector('.ce-img-reset');

    if (fileInput && fileinfo) {
      fileInput.addEventListener('change', function () {
        if (!fileInput.files || !fileInput.files.length) return;
        var f = fileInput.files[0];
        fileinfo.hidden = false;
        fileinfo.textContent = 'নির্বাচিত: ' + f.name + ' (' + bn(Math.round(f.size / 1024)) + ' KB)';
        box.classList.add('has-new');
        dirty['img_' + key] = true;
        if (resetFlag) resetFlag.value = '0';
        refresh();
      });
    }
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (fileInput) fileInput.value = '';
        if (fileinfo) { fileinfo.hidden = true; fileinfo.textContent = ''; }
        if (resetFlag) resetFlag.value = '1';
        box.classList.remove('has-new');
        box.classList.add('will-reset');
        var prev = box.querySelector('.ce-img-preview');
        if (prev) {
          prev.innerHTML = '<span class="ce-img-empty"><i class="fas fa-rotate-left"></i> সেভ করলে ডিফল্ট ডিজাইনে ফিরে যাবে</span>';
        }
        var upLbl = box.querySelector('.ce-img-upload');
        if (upLbl) {
          var txt = upLbl.childNodes[upLbl.childNodes.length - 1];
          if (txt && txt.nodeType === 3) txt.textContent = ' ছবি আপলোড করুন';
        }
        dirty['reset_' + key] = true;
        refresh();
      });
    }
  });

  /* ── টাস্ক ১৩ খ: সেকশন-ভিত্তিক সম্পাদনা ও সেভ ───────────────────── */
  var groups = document.querySelectorAll('.ce-group');

  function setStatus(group, kind, html) {
    var s = group.querySelector('.ce-group-status');
    if (!s) return;
    s.className = 'ce-group-status' + (kind ? ' ' + kind : '');
    s.innerHTML = html || '';
  }

  function enterEdit(group) {
    if (group.classList.contains('is-editing')) return;
    var snapshot = [];
    group.querySelectorAll('input[type=text], textarea').forEach(function (el) {
      snapshot.push({ el: el, val: el.value });
    });
    group.querySelectorAll('.ce-img').forEach(function (box) {
      snapshot.push({ img: box, preview: box.querySelector('.ce-img-preview').innerHTML });
    });
    group._snapshot = snapshot;
    group.classList.remove('is-locked');
    group.classList.add('is-editing');
    group.querySelectorAll('input[type=text], textarea').forEach(function (el) { el.removeAttribute('readonly'); });
    group.querySelector('.ce-edit-btn').hidden = true;
    group.querySelector('.ce-save-section-btn').hidden = false;
    group.querySelector('.ce-cancel-btn').hidden = false;
    setStatus(group, '', '');
    var first = group.querySelector('input[type=text], textarea');
    if (first) first.focus();
  }

  function exitEdit(group) {
    group.classList.add('is-locked');
    group.classList.remove('is-editing');
    group.querySelectorAll('input[type=text], textarea').forEach(function (el) { el.setAttribute('readonly', ''); });
    group.querySelector('.ce-edit-btn').hidden = false;
    group.querySelector('.ce-save-section-btn').hidden = true;
    group.querySelector('.ce-cancel-btn').hidden = true;
  }

  function cancelEdit(group) {
    (group._snapshot || []).forEach(function (s) {
      if (s.el) s.el.value = s.val;
      if (s.img) {
        s.img.querySelector('.ce-img-preview').innerHTML = s.preview;
        s.img.classList.remove('has-new', 'will-reset');
      }
    });
    group.querySelectorAll('.ce-img').forEach(function (box) {
      var fi = box.querySelector('input[type=file]'); if (fi) fi.value = '';
      var rf = box.querySelector('.ce-img-reset-flag'); if (rf) rf.value = '0';
      var info = box.querySelector('.ce-img-fileinfo'); if (info) { info.hidden = true; info.textContent = ''; }
    });
    group.querySelectorAll('.ce-t-icon input').forEach(function (el) {
      var ic = el.closest('.ce-field').querySelector('.ce-icon-preview i');
      if (ic) ic.className = 'fas ' + el.value.trim();
    });
    group.querySelectorAll('input[type=text], textarea').forEach(function (el) { if (el.name) delete dirty[el.name]; });
    exitEdit(group);
    refresh();
  }

  function saveSection(group) {
    var page = group.closest('.ce-panel').getAttribute('data-page');
    var gkey = group.getAttribute('data-group');
    var fd = new FormData();
    fd.append('__page', page);
    fd.append('__group', gkey);
    group.querySelectorAll('input[type=text], textarea').forEach(function (el) {
      if (el.name) fd.append(el.name, el.value);
    });
    group.querySelectorAll('.ce-img').forEach(function (box) {
      var key = box.getAttribute('data-key');
      var fi = box.querySelector('input[type=file]');
      if (fi && fi.files && fi.files.length) fd.append('img_' + key, fi.files[0]);
      var rf = box.querySelector('.ce-img-reset-flag');
      if (rf && rf.value === '1') fd.append('reset_' + key, '1');
    });

    var saveBtn = group.querySelector('.ce-save-section-btn');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> সেভ হচ্ছে...'; }
    setStatus(group, '', '');

    var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    fetch('/admin/content/section', { method: 'POST', body: fd, headers: { 'Accept': 'application/json', 'X-CSRF-Token': CSRF } })
      .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
      .then(function (res) {
        if (res.status >= 400 || !res.data.ok) throw new Error(res.data.error || 'সংরক্ষণ ব্যর্থ');
        var imgs = res.data.images || {};
        group.querySelectorAll('.ce-img').forEach(function (box) {
          var key = box.getAttribute('data-key');
          var fi = box.querySelector('input[type=file]'); if (fi) fi.value = '';
          var rf = box.querySelector('.ce-img-reset-flag'); if (rf) rf.value = '0';
          var info = box.querySelector('.ce-img-fileinfo'); if (info) { info.hidden = true; info.textContent = ''; }
          box.classList.remove('has-new', 'will-reset');
          var url = imgs[key];
          var preview = box.querySelector('.ce-img-preview');
          var upLbl = box.querySelector('.ce-img-upload');
          var setTxt = function (t) {
            if (!upLbl) return;
            var node = upLbl.childNodes[upLbl.childNodes.length - 1];
            if (node && node.nodeType === 3) node.textContent = t;
          };
          if (preview) {
            if (url) {
              preview.innerHTML = '<img src="' + url + '?v=' + AV + '" alt=""/>' +
                '<span class="ce-img-set-badge"><i class="fas fa-check"></i> কাস্টম ছবি সেট আছে</span>';
              setTxt(' ছবি বদলান');
            } else {
              preview.innerHTML = '<span class="ce-img-empty"><i class="fas fa-image"></i> কোনো ছবি সেট করা নেই — ডিফল্ট ডিজাইন দেখাবে</span>';
              setTxt(' ছবি আপলোড করুন');
            }
          }
        });
        exitEdit(group);
        setStatus(group, 'ok', '<i class="fas fa-check-circle"></i> সংরক্ষিত হয়েছে');
        group.querySelectorAll('input[type=text], textarea').forEach(function (el) { if (el.name) delete dirty[el.name]; });
        refresh();
      })
      .catch(function (err) {
        setStatus(group, 'err', '<i class="fas fa-exclamation-triangle"></i> ' + (err.message || 'নেটওয়ার্ক সমস্যা'));
      })
      .finally(function () {
        if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="fas fa-check"></i> সেভ করুন'; }
      });
  }

  groups.forEach(function (group) {
    group.querySelector('.ce-edit-btn').addEventListener('click', function () { enterEdit(group); });
    group.querySelector('.ce-cancel-btn').addEventListener('click', function () { cancelEdit(group); });
    group.querySelector('.ce-save-section-btn').addEventListener('click', function () { saveSection(group); });
  });

  /* ── সাবমিটে ডাবল-ক্লিক গার্ড ─────────────────────────────────── */
  form.addEventListener('submit', function () {
    var btn = document.getElementById('ceSaveBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> সংরক্ষণ হচ্ছে...'; }
    try { localStorage.removeItem('adminDraft:' + location.pathname + ':f0:/admin/content'); } catch (e) {}
    setTimeout(function () {
      if (btn && btn.disabled) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> সব পেজ একসাথে সংরক্ষণ'; }
    }, 15000);
  });
  refresh();
})();

function uploadImage(fieldKey) {
  const input = document.createElement('input');
  input.type = 'file'; input.accept = 'image/*';
  input.onchange = async function() {
    const file = input.files[0]; if (!file) return;
    const fd = new FormData(); fd.append('file', file);
    const btn = event.target.closest('.cm-upload-btn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    try {
      const res = await fetch('/admin/content/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (data.ok) {
        document.querySelector('input[name="' + fieldKey + '"]').value = data.url;
        const preview = btn.parentElement.querySelector('.cm-image-preview');
        if (preview) { preview.src = data.url; preview.style.display = 'block'; }
        else {
          const img = document.createElement('img');
          img.src = data.url; img.className = 'cm-image-preview';
          img.style.cssText = 'max-width:200px;max-height:120px;border-radius:5px;margin-top:8px;display:block;';
          btn.parentElement.appendChild(img);
        }
      } else { alert(data.error || 'আপলোড ব্যর্থ'); }
    } catch(e) { alert('নেটওয়ার্ক সমস্যা'); }
    btn.innerHTML = '<i class="fas fa-upload"></i> আপলোড';
  };
  input.click();
}
</script>
</body>
</html>
