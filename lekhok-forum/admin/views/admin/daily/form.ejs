<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ডেইলি কনটেন্ট ফর্ম — লেখক ফোরাম অ্যাডমিন</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><%= item ? 'কনটেন্ট সম্পাদনা' : 'নতুন ডেইলি কনটেন্ট' %></h1>
    <p><a href="/admin/daily">← তালিকায় ফিরে যান</a> — প্রকাশ করলেই সব ইউজার নোটিফিকেশন পাবেন</p>
  </div>
  <div class="card">
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <% if (item) { %>
      <div class="sf-section" data-save-url="/admin/daily/<%= item.id %>/section">
        <div class="sf-head">
          <h3>মূল তথ্য <span class="sf-count">৫</span></h3>
          <div class="sf-actions">
            <span class="sf-status" role="status" aria-live="polite"></span>
            <button type="button" class="btn btn-sm sf-edit"><i class="fas fa-pen"></i> সম্পাদনা</button>
            <button type="button" class="btn btn-sm btn-primary sf-save" hidden><i class="fas fa-check"></i> সেভ</button>
            <button type="button" class="btn btn-sm sf-cancel" hidden><i class="fas fa-times"></i> বাতিল</button>
          </div>
        </div>
        <div class="form-group">
          <label>ধরন *</label>
          <select name="content_type" disabled>
            <option value="">— নির্বাচন করুন —</option>
            <% Object.keys(DAILY_TYPES).forEach(t => { %>
              <option value="<%= t %>" <%= item.content_type === t ? 'selected' : '' %>><%= DAILY_TYPES[t].label %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group"><label>শিরোনাম *</label><input type="text" name="title" value="<%= item.title %>" readonly required></div>
        <div class="form-group"><label>লিংক URL (ঐচ্ছিক — যেমন ই-পেপার PDF লিংক)</label><input type="url" name="link_url" value="<%= item.link_url || '' %>" readonly placeholder="https://..."></div>
        <div class="form-group"><label>প্রকাশের তারিখ</label><input type="date" name="scheduled_date" value="<%= item.scheduled_date || '' %>" readonly></div>
        <div class="form-group"><label style="display:flex; align-items:center; gap:8px; font-weight:normal;"><input type="checkbox" name="published" value="1" <%= item.published ? 'checked' : '' %> disabled> এখনই প্রকাশ করুন (সব ইউজার নোটিফিকেশন পাবেন)</label></div>
      </div>

      <div class="sf-section" data-save-url="/admin/daily/<%= item.id %>/section">
        <div class="sf-head">
          <h3>বিষয়বস্তু <span class="sf-count">১</span></h3>
          <div class="sf-actions">
            <span class="sf-status" role="status" aria-live="polite"></span>
            <button type="button" class="btn btn-sm sf-edit"><i class="fas fa-pen"></i> সম্পাদনা</button>
            <button type="button" class="btn btn-sm btn-primary sf-save" hidden><i class="fas fa-check"></i> সেভ</button>
            <button type="button" class="btn btn-sm sf-cancel" hidden><i class="fas fa-times"></i> বাতিল</button>
          </div>
        </div>
        <div class="form-group"><label>বিষয়বস্তু</label><textarea name="body" rows="7" readonly><%= item.body || '' %></textarea></div>
      </div>

      <div class="sf-section" data-save-url="/admin/daily/<%= item.id %>/section">
        <div class="sf-head">
          <h3>ছবি ও কভার <span class="sf-count"><%= (images || []).length %></span></h3>
          <div class="sf-actions">
            <span class="sf-status" role="status" aria-live="polite"></span>
            <button type="button" class="btn btn-sm sf-edit"><i class="fas fa-pen"></i> সম্পাদনা</button>
            <button type="button" class="btn btn-sm btn-primary sf-save" hidden><i class="fas fa-check"></i> সেভ</button>
            <button type="button" class="btn btn-sm sf-cancel" hidden><i class="fas fa-times"></i> বাতিল</button>
          </div>
        </div>
        <div class="form-group"><label>কভার ছবির URL (ঐচ্ছিক)</label><input type="url" name="image_url" value="<%= item.image_url || '' %>" readonly placeholder="https://..."></div>
        <%- include('../partials/multi-image', { images: images || [] }) %>
      </div>
    <% } else { %>
      <form method="POST" action="/admin/daily">
        <div class="form-group">
          <label>ধরন *</label>
          <select name="content_type" required>
            <option value="">— নির্বাচন করুন —</option>
            <% Object.keys(DAILY_TYPES).forEach(t => { %>
              <option value="<%= t %>"><%= DAILY_TYPES[t].label %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group"><label>শিরোনাম *</label><input type="text" name="title" required></div>
        <div class="form-group"><label>বিষয়বস্তু</label><textarea name="body" rows="6"></textarea></div>
        <div class="form-group"><label>কভার ছবির URL (ঐচ্ছিক)</label><input type="url" name="image_url" placeholder="https://..."></div>
        <%- include('../partials/multi-image', { images: images || [] }) %>
        <div class="form-group"><label>লিংক URL (ঐচ্ছিক — যেমন ই-পেপার PDF লিংক)</label><input type="url" name="link_url" placeholder="https://..."></div>
        <div class="form-group"><label>প্রকাশের তারিখ</label><input type="date" name="scheduled_date" value="<%= today %>"></div>
        <div class="form-group"><label style="display:flex; align-items:center; gap:8px; font-weight:normal;"><input type="checkbox" name="published" value="1" checked> এখনই প্রকাশ করুন (সব ইউজার নোটিফিকেশন পাবেন)</label></div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> তৈরি করুন</button>
      </form>
    <% } %>
  </div>
</div>
</body>
</html>
