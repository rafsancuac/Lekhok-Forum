<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ডেইলি কনটেন্ট — লেখক ফোরাম অ্যাডমিন</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1><i class="fas fa-sun"></i> ডেইলি কনটেন্ট</h1>
      <p>কুইজ, এই দিনে, ই-পেপার, কার্যক্রম — প্রকাশ করলেই সব ইউজার নোটিফিকেশন পাবেন</p>
    </div>
    <div class="header-actions">
      <a href="/admin/daily/new" class="btn btn-primary"><i class="fas fa-plus"></i> নতুন কনটেন্ট</a>
    </div>
  </div>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="<%= flash.type === 'error' ? 'error' : 'success' %>"><%= flash.message %></div>
  <% } %>

  <div class="section-head">
    <h2>সব কন্টেন্ট</h2>
    <span class="count-pill"><%= items.length %></span>
  </div>

  <% if (items.length === 0) { %>
    <div class="empty-state-full">
      <i class="fas fa-sun"></i>
      <p>কোনো ডেইলি কন্টেন্ট নেই</p>
      <a href="/admin/daily/new" class="btn btn-primary" style="margin-top:14px;"><i class="fas fa-plus"></i> নতুন কন্টেন্ট যোগ করুন</a>
    </div>
  <% } else { %>

    <!-- Type filter chips -->
    <% const types = {};
       items.forEach(it => { types[it.content_type] = (types[it.content_type] || 0) + 1; });
       const totalItems = items.length; %>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
      <span class="chip chip-accent"><i class="fas fa-layer-group"></i> সব <%= totalItems %></span>
      <% Object.keys(DAILY_TYPES).forEach(t => {
           if (types[t]) { %>
            <span class="chip"><i class="<%= DAILY_TYPES[t].icon || 'fas fa-circle' %>"></i> <%= DAILY_TYPES[t].label %> <%= types[t] %></span>
      <% } }); %>
    </div>

    <div class="card" style="padding:0;overflow:hidden;">
    <table>
      <thead>
        <tr>
          <th style="width:60px;">ধরন</th>
          <th>শিরোনাম</th>
          <th style="width:120px;">তারিখ</th>
          <th style="width:120px;">স্ট্যাটাস</th>
          <th style="width:170px;">কার্যক্রম</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(it => { %>
          <tr>
            <td>
              <span class="chip" style="font-size:.78rem;padding:4px 10px;">
                <i class="<%= DAILY_TYPES[it.content_type] ? DAILY_TYPES[it.content_type].icon : 'fas fa-circle' %>" style="color:#059669;"></i>
                <%= DAILY_TYPES[it.content_type] ? DAILY_TYPES[it.content_type].label : it.content_type %>
              </span>
            </td>
            <td>
              <strong><%= it.title %></strong>
              <% if (it.body) { %>
                <div style="color:#64748b; font-size:.82rem; margin-top:2px; max-width:480px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                  <%= it.body %>
                </div>
              <% } %>
              <% if (it.image_url) { %>
                <div style="margin-top:6px;"><img src="<%= it.image_url %>" alt="" style="width:48px;height:32px;object-fit:cover;border-radius:4px;border:1px solid #e2e8f0;"></div>
              <% } %>
            </td>
            <td style="color:#64748b; font-size:.88rem;">
              <i class="far fa-calendar-alt"></i> <%= it.scheduled_date || '—' %>
            </td>
            <td>
              <% if (it.published) { %>
                <span class="badge-soft published"><i class="fas fa-check"></i> প্রকাশিত</span>
              <% } else { %>
                <span class="badge-soft draft"><i class="far fa-circle"></i> খসড়া</span>
              <% } %>
            </td>
            <td>
              <div class="row-actions">
                <a href="/admin/daily/<%= it.id %>/edit" class="btn btn-primary btn-sm"><i class="fas fa-pen"></i> সম্পাদনা</a>
                <form method="POST" action="/admin/daily/<%= it.id %>?_method=DELETE" onsubmit="return confirm('মুছে ফেলতে চান?')">
                  <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>
</body>
</html>
