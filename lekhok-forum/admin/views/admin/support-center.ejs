  // ── session232 — স্পার্ক/ট্রেন্ড-টুলটিপ (এক-শেয়ার্ড #scSparkTip; data-d/data-v/data-unit এক-উৎস; টেক্সট-নোড-শুধু — innerHTML-নিষিদ্ধ-রীতি; কার্ড-ফোকাসে আজ-বার) ──
  var tipEl = document.getElementById('scSparkTip');
  var wkEl = document.getElementById('scSparkTipWk');
  var lastCenter = 0; // session235 — daychip-প্রশস্ত-পুনঃক্ল্যাম্পের-জন্য মূল-বার-কেন্দ্র (s234-ক্ল্যাম্প-চুক্তি-সম্প্রসারণ)
  function wkClamp() {
    var ww = wkEl.offsetWidth || 0;
    if (ww > 0 && lastCenter > 0) {
      var half = ww / 2 + 8;
      wkEl.style.left = Math.min(Math.max(lastCenter, half), window.innerWidth - half) + 'px';
    }
  }
  function tipShow(bar) {
