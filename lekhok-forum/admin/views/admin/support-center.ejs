  // ── লাইভ: SSE (support-changed) + ৩০সে-পোল-ফলব্যাক ──
  var knownCounts = { PENDING: <%= counts.PENDING %>, IN_PROGRESS: <%= counts.IN_PROGRESS %>, RESOLVED: <%= counts.RESOLVED %> };
  var reloading = false;
  function maybeReload(reason) {
    if (reloading || document.hidden) return;
    reloading = true;
    toast((reason || 'হালনাগাদ') + ' — রিফ্রেশ হচ্ছে…');
    setTimeout(function () { reloadSoon(0); }, 900);
  }
  function pollCounts() {
    if (document.hidden || reloading) return;
    fetch('/admin/support-center/data' + location.search, { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.ok || reloading) return;
        ['PENDING', 'IN_PROGRESS', 'RESOLVED'].forEach(function (k) {
          if (d.counts[k] !== knownCounts[k]) maybeReload('নতুন অভিযোগ-কার্যক্রম');
        });
      }).catch(function () {});
  }
  try {
    var es = new EventSource('/api/events');
    es.addEventListener('open', function () {
      document.getElementById('scLive').classList.add('on');
      document.getElementById('scLiveTxt').textContent = 'লাইভ';
    });
    es.addEventListener('support-changed', function () { maybeReload('সাপোর্ট-হালনাগাদ'); });
    es.addEventListener('error', function () {
      document.getElementById('scLive').classList.remove('on');
      document.getElementById('scLiveTxt').textContent = 'পোলিং';
    });
  } catch (_) {}
  setInterval(pollCounts, 30000);

  // ── session228 — কীবোর্ড-দক্ষতা (Next-সেশন212-চুক্তি-পোর্ট: j/k কার্সর + 1/2/3/0 ভিউ + / সার্চ + ? সহায়িকা + Esc-স্তর) ──
  var scHelp = document.getElementById('scHelp');
  var scHelpPanel = document.getElementById('scHelpPanel');
  var scHelpClose = document.getElementById('scHelpClose');
  var helpPrevFocus = null;
  function helpOpen() {
    if (scHelp.classList.contains('open')) return;
    helpPrevFocus = document.activeElement;
    scHelp.hidden = false;
    scHelp.classList.add('open');
    scHelpPanel.focus();
  }
  function helpClose() {
    if (!scHelp.classList.contains('open')) return;
    scHelp.classList.remove('open');
    scHelp.hidden = true;
    if (helpPrevFocus && helpPrevFocus.focus) helpPrevFocus.focus();
  }
  scHelpClose.addEventListener('click', helpClose);
  scHelp.addEventListener('click', function (e) { if (e.target === scHelp) helpClose(); });
  var scHelpBtn = document.getElementById('scHelpBtn');
  if (scHelpBtn) scHelpBtn.addEventListener('click', function () {
    if (scHelp.classList.contains('open')) helpClose(); else helpOpen();
  });
  // ── session229 — সার্চ-ক্লিয়ার (q-চিহ্নিত হলে ✕-বাটন: status/media/range-সংরক্ষণে q-সরান) ──
  var scSearchClear = document.getElementById('scSearchClear');
  if (scSearchClear) scSearchClear.addEventListener('click', function () {
    var sp = new URLSearchParams(location.search);
    var parts = [];
    if (sp.get('status')) parts.push('status=' + sp.get('status'));
    if (sp.get('media')) parts.push('media=' + sp.get('media'));
    if (sp.get('range')) parts.push('range=' + sp.get('range'));
    location.href = '/admin/support-center?' + parts.filter(Boolean).join('&');
  });

  var cards = Array.prototype.slice.call(document.querySelectorAll('.sc-card'));
  var cursor = -1;
  function cursorClear() {
    if (cursor < 0 || !cards[cursor]) { cursor = -1; return; }
    cards[cursor].classList.remove('sc-cursor');
    cards[cursor].removeAttribute('aria-current');
    cursor = -1;
  }
  function cursorMove(delta) {
    if (!cards.length) return;
    var next = Math.min(cards.length - 1, Math.max(0, cursor + delta));
    if (cursor === next && cursor >= 0) return;
    if (cursor >= 0 && cards[cursor]) {
      cards[cursor].classList.remove('sc-cursor');
      cards[cursor].removeAttribute('aria-current');
    }
    cursor = next;
    cards[cursor].classList.add('sc-cursor');
    cards[cursor].setAttribute('aria-current', 'true');
    cards[cursor].scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
  function statusJump(st) {
    var sp = new URLSearchParams(location.search);
    var parts = [];
    if (st) parts.push('status=' + st);
    if (sp.get('media')) parts.push('media=' + sp.get('media'));
    if (sp.get('q')) parts.push('q=' + encodeURIComponent(sp.get('q')));
    if (sp.get('range')) parts.push('range=' + sp.get('range'));
    location.href = '/admin/support-center?' + parts.filter(Boolean).join('&');
  }
  // ── session230 — x-নির্বাচন + বাল্ক-স্ট্যাটাস (Next-session206/212-চুক্তি-পোর্ট; sequential-PUT; সম-স্টেটাস নীরব-স্কিপ session229-চুক্তি; toast-ত্রুটি true-প্যারাম) ──
  var bulkEl = document.getElementById('scBulk');
  var bulkCount = document.getElementById('scBulkCount');
  var sel = new Set();
  var bulkBusy = false;
  function bnJs(n) { var d = '০১২৩৪৫৬৭৮৯'; return String(n).replace(/[0-9]/g, function (c) { return d[+c]; }); }
  function selSync() {
    cards.forEach(function (c, i) {
      var on = sel.has(i);
      var b = c.querySelector('[data-sel]');
      if (b) { b.classList.toggle('on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); }
      c.classList.toggle('sc-selcard', on);
    });
    bulkEl.hidden = sel.size === 0;
    bulkCount.textContent = bnJs(sel.size) + ' টি নির্বাচিত';
  }
  function selToggle(i) { if (sel.has(i)) sel.delete(i); else sel.add(i); selSync(); }
  function bulkClear() { sel.clear(); selSync(); }
  document.querySelectorAll('[data-sel]').forEach(function (b) {
    b.addEventListener('click', function () { if (!bulkBusy) selToggle(cards.indexOf(b.closest('.sc-card'))); });
  });
  document.getElementById('scBulkAll').addEventListener('click', function () {
    if (bulkBusy) return;
    cards.forEach(function (_, i) { sel.add(i); });
    selSync();
  });
  document.getElementById('scBulkNone').addEventListener('click', function () { if (!bulkBusy) bulkClear(); });
  document.getElementById('scBulkClose').addEventListener('click', function () { if (!bulkBusy) bulkClear(); });
  document.querySelectorAll('[data-bulk-st]').forEach(function (b) {
    b.addEventListener('click', function () {
      if (bulkBusy || !sel.size) return;
      var st = b.getAttribute('data-bulk-st');
      var targets = cards.filter(function (_, i) { return sel.has(i); });
      var lbl = st === 'PENDING' ? 'নতুন' : st === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান';
      bulkBusy = true;
      bulkEl.querySelectorAll('button').forEach(function (x) { x.disabled = true; });
      toast('বাল্ক হালনাগাদ চলছে…');
      var done = 0, okN = 0, skipN = 0, failN = 0;
      var okItems = []; // session231 — গ্রুপ-আন্ডু-এন্ট্রির-জন্য-সফল-বদলের-তালিকা
      function finish() {
        bulkBusy = false;
        bulkEl.querySelectorAll('button').forEach(function (x) { x.disabled = false; });
        if (failN) { toast(bnJs(okN) + ' হালনাগাদ, ' + bnJs(failN) + ' ব্যর্থ — নির্বাচন অক্ষত আছে', true); return; }
        if (!okN) { toast('কোনো পরিবর্তন নেই'); return; }
        if (okItems.length) undoPush({ group: 1, items: okItems }); // session231 — এক-গ্রুপ-এন্ট্রি (Ctrl+Z-এ সমগ্র-ব্যাচ ফেরত)
        toast(bnJs(okN) + ' টি → ' + lbl + ' হালনাগাদ ✓');
        reloadSoon(750);
      }
      (function next() {
        if (done >= targets.length) { finish(); return; }
        var c = targets[done++];
        if (c.getAttribute('data-status') === st) { skipN++; next(); return; } // সম-স্টেটাস = নীরব-স্কিপ (PUT/ইতিহাস/নোটিফিকেশন-শূন্য)
        api('/admin/support-center/' + c.getAttribute('data-id'), 'PUT',
          { status: st, adminNote: c.querySelector('[data-sc-note]').value.trim() }).then(function (res) {
          if (res.ok && !res.unchanged) { okN++; okItems.push({ id: c.getAttribute('data-id'), from: c.getAttribute('data-status'), to: st }); }
          else if (res.ok) skipN++; else failN++;
        }).catch(function () { failN++; }).then(next);
      })();
    });
  });
  // ── session231 — Ctrl+Z স্ট্যাটাস-আন্ডু-স্ট্যাক (Next-session222-চুক্তি-পোর্ট, Express-রূপ) ──
  // Express-ডেস্কে প্রতিটি-বদল reload-করে → স্ট্যাক sessionStorage-এ (reload-টিকষ্ণ; ট্যাব-স্কোপড = সেশন-চুক্তি-সমতুল্য); ক্যাপ ১০
  var UNDO_KEY = 'sc-undo';
  var undoStack = (function () {
    try { var a = JSON.parse(sessionStorage.getItem(UNDO_KEY) || '[]'); return Array.isArray(a) ? a : []; } catch (_) { return []; }
  })();
  function undoSave() { try { sessionStorage.setItem(UNDO_KEY, JSON.stringify(undoStack.slice(-10))); } catch (_) {} }
  function undoPush(entry) { undoStack.push(entry); if (undoStack.length > 10) undoStack.shift(); undoSave(); }
  var undoBusy = false;
  function undoPop() {
    if (undoBusy) return;
    if (!undoStack.length) { toast('আন্ডু-স্ট্যাক খালি'); return; }
    var entry = undoStack.pop(); undoSave();
    var items = entry.group ? entry.items : [entry];
    undoBusy = true;
    toast('আন্ডু চলছে… ' + bnJs(items.length) + ' টি', false, true);
    var doneU = 0, okU = 0, failU = 0;
    function finishU() {
      undoBusy = false;
      if (failU) { undoStack.push(entry); undoSave(); toast(bnJs(okU) + ' ফেরত, ' + bnJs(failU) + ' ব্যর্থ — আবার চেষ্টা করা যাবে', true); return; }
      toast(bnJs(okU) + ' টি পূর্বাবস্থায় ✓' + (undoStack.length ? ' (বাকি ' + bnJs(undoStack.length) + ')' : ''), false, true);
      reloadSoon(650);
    }
    (function nextU() {
      if (doneU >= items.length) { finishU(); return; }
      var it = items[doneU++];
      // আন্ডু-PUT = status-শুধু (note-অস্পৃষ্ট); আন্ডু-কল কখনো-স্ট্যাকে-ফেরে-না (পিং-পং-বর্জন — session222-চুক্তি)
      api('/admin/support-center/' + it.id, 'PUT', { status: it.from }).then(function (res) {
        if (res.ok) okU++; else failU++;
      }).catch(function () { failU++; }).then(nextU);
    })();
  }
  document.addEventListener('keydown', function (e) {
    var t = e.target;
    var typing = t && ((t.closest && t.closest('input, textarea, select')) || t.isContentEditable);
    if ((e.ctrlKey || e.metaKey) && !e.altKey && (e.key === 'z' || e.key === 'Z')) {
      if (typing) return; // নেটিভ-টেক্সট-আন্ডু অক্ষুণ্ণ (preventDefault-নেই — session222-চুক্তি)
      if (scHelp.classList.contains('open')) return; // সহায়িকা-খোলা থাকলে ব্রাউজার-ডিফল্ট
      e.preventDefault();
      undoPop();
      return;
    }
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === 'Escape' || e.key === 'Esc') {
      if (scHelp.classList.contains('open')) { helpClose(); return; }
      if (typing) return;
      if (sel.size) { bulkClear(); return; } // session230 — Esc-স্তর: নির্বাচন → কার্সর
      if (cursor >= 0) { cursorClear(); return; }
      return;
    }
    if (typing) return;
    if (e.key === '?' || (e.key === '/' && e.shiftKey)) {
      e.preventDefault();
      if (scHelp.classList.contains('open')) helpClose(); else helpOpen();
      return;
    }
    if (e.key === 'j' || e.key === 'J') { e.preventDefault(); cursorMove(1); return; }
    if (e.key === 'k' || e.key === 'K') { e.preventDefault(); cursorMove(-1); return; }
    if (e.key === 'x' || e.key === 'X') { e.preventDefault(); if (!bulkBusy) { if (cursor < 0) cursorMove(1); selToggle(cursor); } return; } // session230 — নির্বাচন-টগল
    if (e.key === '/') { e.preventDefault(); var si = document.querySelector('.sc-search input'); if (si) si.focus(); return; }
    if (e.key === 'd' || e.key === 'D') { e.preventDefault(); compactToggle(); return; } // session232 — কমপ্যাক্ট-টগল (typing-গার্ডের-পরে-ই-আসে)
    // ── session229 — Shift+1/2/3 কার্সর-কার্ডে দ্রুত-স্ট্যাটাস (Next-session222-চুক্তি: e.code-লেআউট-স্বাধীন; সম-স্টেটাসে নীরব-স্কিপ) ──
    if (e.shiftKey && (e.code === 'Digit1' || e.code === 'Digit2' || e.code === 'Digit3')) {
      if (cursor < 0 || !cards[cursor]) { toast('কার্সর-কার্ড নেই — আগে j/k দিয়ে কার্ড বাছুন'); return; }
      var stQ = e.code === 'Digit1' ? 'PENDING' : e.code === 'Digit2' ? 'IN_PROGRESS' : 'RESOLVED';
      var qcard = cards[cursor];
      if (qcard.getAttribute('data-status') === stQ) return;
      var qsel = qcard.querySelector('[data-sc-status]');
      if (qsel) qsel.value = stQ;
      var stLbl = stQ === 'PENDING' ? 'নতুন' : stQ === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান';
      var qFrom = qcard.getAttribute('data-status'); // session231 — আন্ডু-এন্ট্রির-জন্য-পূর্ব-স্ট্যাটাস
      api('/admin/support-center/' + qcard.getAttribute('data-id'), 'PUT',
        { status: stQ, adminNote: qcard.querySelector('[data-sc-note]').value.trim() }).then(function (res) {
        if (res.ok && !res.unchanged) { undoPush({ id: qcard.getAttribute('data-id'), from: qFrom, to: stQ }); toast('স্ট্যাটাস হালনাগাদ → ' + stLbl); reloadSoon(650); }
        else if (res.ok) { toast('কোনো পরিবর্তন নেই'); }
        else toast(res.error || 'স্ট্যাটাস-বদল ব্যর্থ', true);
      }).catch(function () { toast('নেটওয়ার্ক ব্যর্থ', true); });
      return;
    }
    if (e.key === '1') { statusJump('PENDING'); return; }
    if (e.key === '2') { statusJump('IN_PROGRESS'); return; }
    if (e.key === '3') { statusJump('RESOLVED'); return; }
    if (e.key === '0') { statusJump(''); return; }
  });
})();
</script>
</body>
</html>
