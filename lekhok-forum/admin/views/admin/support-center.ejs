            sb.style.height = (sn > 0 && mxS > 0 ? Math.max(3, Math.round(sn / mxS * 10)) : 2) + 'px';
            // session235 — মিনি-বারে দিন-হুক (data-d=dayLabels[i] এক-উৎস + data-v=bnJs-এক-উৎস + data-u=unit) —
            // ফরম্যাট = মূল-টুলটিপ-চুক্তির-সমস্বর (d + ' — ' + v + ' ' + unit)
