    var host = bar.closest('[data-unit]');
    tipEl.textContent = d + ' — ' + v + ' ' + (host ? host.getAttribute('data-unit') : 'টি');
    var r = bar.getBoundingClientRect();
    tipEl.style.left = Math.min(Math.max(r.left + r.width / 2, 70), window.innerWidth - 70) + 'px';
    tipEl.style.top = Math.max(r.top, 44) + 'px';
    lastCenter = r.left + r.width / 2;
    tipEl.setAttribute('data-on', '1');
    tipEl.setAttribute('aria-hidden', 'false');
    // session233 — সপ্তাহ-ওভারভিউ চিপ (বারের-নিচে; data-wk EJS-এক-উৎস; #scSparkTip-textContent-চুক্তি-অক্ষুণ্ণ — s232-সুইট-সামঞ্জস্য)
    // session234 — চিপে ৭-দিন-মিনি-বার-স্ট্রিপ (data-bars কাঁচা-CSV; DOM-API-নির্মাণ — innerHTML-নিষিদ্ধ-রীতি-অটুট; label-span-textContent = data-wk-হুবহু — s233-সমতা-রক্ষা)
    if (wkEl) {
      var wk = bar.closest('[data-wk]');
