          <span title="<%= r.created_at %>"><%= r.created_at %></span>
          <%# session237 — তুলনামূলক-সময় চিপ (helpers relTimeBn এক-উৎস; সার্ভার-গণনা — ক্লায়েন্ট-TZ-ঝুঁকি-শূন্য; title-এ পূর্ণ-তারিখ) %>
          <% if (r.rel) { %><span class="sc-rel" title="<%= r.created_at %>"><i class="fas fa-clock" aria-hidden="true"></i><%= r.rel %></span><% } %>
        </small>
      </div>
      <span class="sc-badge m-<%= r.media_type %>"><i class="fas <%= r.media_type === 'TEXT' ? 'fa-pen' : r.media_type === 'IMAGE' ? 'fa-image' : r.media_type === 'AUDIO' ? 'fa-microphone' : 'fa-video' %>"></i><%= r.media_type === 'TEXT' ? 'লেখা' : r.media_type === 'IMAGE' ? 'ছবি' : r.media_type === 'AUDIO' ? 'ভয়েস' : 'ভিডিও' %></span>
      <% if (r.aging.label) { %><span class="sc-aging"><%= r.aging.label %></span><% } %>
      <span class="sc-badge st-<%= r.status %>"><%= r.status === 'PENDING' ? 'নতুন' : r.status === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান হয়েছে' %></span>
    </div>

    <p class="sc-body"><%= r.message_text %></p>

    <% if (r.media_url && r.media_type === 'IMAGE') { %>
      <%# session238 — লাইটবক্স-হুক (data-lbox+data-lcap; href/target_শূন্য-বদল — মধ্য-ক্লিক/সংশোধক-কী = নেটিভ-নতুন-ট্যাব) %>
      <div class="sc-media"><a href="<%= r.media_url %>" target="_blank" rel="noopener" data-lbox data-lcap="<%= (r.sender_name || 'অজানা ব্যবহারকারী') %> · <%= r.created_at %>"><img src="<%= r.media_url %>" alt="অভিযোগ-সংযুক্তি" loading="lazy" /></a></div>
    <% } else if (r.media_url && r.media_type === 'AUDIO') { %>
      <div class="sc-media"><audio controls preload="none" src="<%= r.media_url %>"></audio></div>
    <% } else if (r.media_url && r.media_type === 'VIDEO') { %>
      <div class="sc-media"><video controls preload="metadata" src="<%= r.media_url %>"></video></div>
    <% } else if (r.media_url) { %>
      <div class="sc-media"><a class="btn btn-sm" href="<%= r.media_url %>" target="_blank"><i class="fas fa-paperclip"></i> সংযুক্তি</a></div>
    <% } %>

    <div class="sc-actions">
      <select data-sc-status aria-label="স্ট্যাটাস">
        <option value="PENDING" <%= r.status === 'PENDING' ? 'selected' : '' %>>নতুন</option>
        <option value="IN_PROGRESS" <%= r.status === 'IN_PROGRESS' ? 'selected' : '' %>>চলমান</option>
        <option value="RESOLVED" <%= r.status === 'RESOLVED' ? 'selected' : '' %>>সমাধান হয়েছে</option>
      </select>
      <div class="sc-note-box">
        <textarea data-sc-note maxlength="2000" placeholder="ম্যানেজমেন্টের জবাব লিখুন (রিপোর্টার দেখতে পাবেন)…"><%= r.admin_note || '' %></textarea>
        <%# session237 — অক্ষর-গণনা (bnNum-এক-উৎস EJS-প্রথম-পেইন্ট; JS-ইনপুটে bnJs-এক-উৎস; aria-hidden — maxlength-ই-বাস্তব-সীমা) %>
        <span class="sc-note-count" data-note-count aria-hidden="true"><%= bnNum((r.admin_note || '').length) %>/<%= bnNum(2000) %></span>
        <div class="sc-tpl">
          <button type="button" data-tpl="আপনার অভিযোগ গৃহীত হয়েছে — ধন্যবাদ।">গৃহীত</button>
          <button type="button" data-tpl="আপনার অভিযোগ পর্যালোচনাধীন আছে — শীঘ্রই হালনাগাদ জানানো হবে।">পর্যালোচনাধীন</button>
          <button type="button" data-tpl="প্রয়োজনীয় ব্যবস্থা নেওয়া হয়েছে। সহযোগিতার জন্য ধন্যবাদ।">ব্যবস্থা নেওয়া হয়েছে</button>
          <button type="button" data-tpl="অতিরিক্ত তথ্য/প্রমাণ পেলে এই থ্রেডে পাঠান।">তথ্য চাওয়া হয়েছে</button>
          <button type="button" data-tpl="অভিযোগটি সমাধান হয়েছে। আরও সমস্যা হলে জানাবেন।">সমাধান</button>
          <%# session237 — লেখা-কপি (ক্লিপবোর্ড-API → execCommand-ফলব্যাক headless-নিরাপদ; খালি-লেখায় টোস্ট) %>
          <button type="button" class="sc-tpl-copy" data-note-copy title="লেখা ক্লিপবোর্ডে কপি করুন" aria-label="লেখা ক্লিপবোর্ডে কপি করুন"><i class="fas fa-copy" aria-hidden="true"></i> কপি</button>
        </div>
      </div>
      <button type="button" class="btn btn-primary btn-sm" data-sc-save><i class="fas fa-save"></i> সংরক্ষণ</button>
    </div>

    <% if (r.history.length) { %>
    <div class="sc-hist">
      <div class="sc-hist-title"><i class="fas fa-clock-rotate-left"></i> অ্যাকশন-ইতিহাস</div>
      <% r.history.forEach((h, hi) => { %>
      <div class="sc-hentry" data-hidx="<%= hi %>" data-entry="<%= encodeURIComponent(JSON.stringify(h)) %>">
        <span class="sc-hico t-<%= h.t %>"><i class="fas <%= h.t === 'status' ? 'fa-arrow-right-arrow-left' : 'fa-reply' %>"></i></span>
        <div class="sc-hbody">
          <% if (h.t === 'status') { %>
            স্ট্যাটাস: <strong><%= h.from === 'PENDING' ? 'নতুন' : h.from === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান' %> → <%= h.to === 'PENDING' ? 'নতুন' : h.to === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান' %></strong>
            <div class="sc-hmeta"><%= h.by %> · <%= String(h.at || '').replace('T', ' ').slice(0, 16) %></div>
          <% } else { %>
            <span data-hnote><%= h.note %></span><% if (h.editedAt) { %><span class="sc-hedited">সম্পাদিত</span><% } %>
            <div class="sc-hmeta"><%= h.by %> · <%= String(h.at || '').replace('T', ' ').slice(0, 16) %><%= h.editedAt ? ' · সম্পাদনা: ' + String(h.editedAt).replace('T', ' ').slice(0, 16) : '' %></div>
          <% } %>
        </div>
        <% if (h.t === 'note') { %>
        <div class="sc-hbtns">
          <%# session237 — জবাব-কপি (edit/delete-সহ এক-সারি; DOM-টেক্সট-উৎস — data-entry-পুনঃপার্স-শূন্য) %>
          <button type="button" data-hcopy title="জবাব কপি করুন" aria-label="জবাব কপি করুন"><i class="fas fa-copy"></i></button>
          <button type="button" data-hedit title="জবাব সম্পাদনা" aria-label="জবাব সম্পাদনা"><i class="fas fa-pen"></i></button>
          <button type="button" data-hdel title="জবাব মুছুন" aria-label="জবাব মুছুন"><i class="fas fa-trash"></i></button>
        </div>
        <% } %>
      </div>
      <% }) %>
      <div data-hundo style="display:none;margin-top:8px">
        <button type="button" class="btn btn-sm" data-hundo-btn><i class="fas fa-rotate-left"></i> মুছে-ফেলা জবাব ফেরত আনুন</button>
      </div>
    </div>
    <% } %>
  </div>
  <% }) %>
</div>

<%# session228 — কীবোর্ড-সহায়িকা ওভারলে (dialog + Esc/ব্যাকড্রপ-বন্ধ; z-স্তর-চুক্তি সহায়িকা-স্তর) %>
<div class="sc-help" id="scHelp" role="dialog" aria-modal="true" aria-label="কীবোর্ড শর্টকাট সহায়িকা" hidden>
  <div class="sc-help-panel" id="scHelpPanel" tabindex="-1">
    <h2><i class="fas fa-keyboard" style="color:var(--ad-accent)"></i> কীবোর্ড শর্টকাট</h2>
    <p class="sc-help-sub">ডেস্ক-নেভিগেশন দ্রুত করুন — লেখা-বক্স/সার্চে টাইপ-করার-সময় শর্টকাট-নিষ্ক্রিয়</p>
    <div class="sc-help-row"><span>পরবর্তী/পূর্ববর্তী কার্ড-কার্সর</span><span class="keys"><kbd class="sc-kbd">j</kbd><kbd class="sc-kbd">k</kbd></span></div>
    <div class="sc-help-row"><span>স্ট্যাটাস-ভিউ: নতুন / চলমান / সমাধান</span><span class="keys"><kbd class="sc-kbd">1</kbd><kbd class="sc-kbd">2</kbd><kbd class="sc-kbd">3</kbd></span></div>
    <div class="sc-help-row"><span>সব-অভিযোগ ভিউ</span><span class="keys"><kbd class="sc-kbd">0</kbd></span></div>
    <div class="sc-help-row"><span>সার্চ-বক্সে ফোকাস</span><span class="keys"><kbd class="sc-kbd">/</kbd></span></div>
    <div class="sc-help-row"><span>কার্সর-কার্ডে দ্রুত-স্ট্যাটাস সেট (নতুন / চলমান / সমাধান)</span><span class="keys"><kbd class="sc-kbd">Shift</kbd><kbd class="sc-kbd">1</kbd><kbd class="sc-kbd">2</kbd><kbd class="sc-kbd">3</kbd></span></div>
    <div class="sc-help-row"><span>কার্সর-কার্ড নির্বাচন/বাদ — বাল্ক-স্ট্যাটাস (Esc-এ নির্বাচন-পরিষ্কার)</span><span class="keys"><kbd class="sc-kbd">x</kbd><kbd class="sc-kbd">Esc</kbd></span></div>
    <div class="sc-help-row"><span>শেষ স্ট্যাটাস-বদল আন্ডু (বাল্ক-গ্রুপ-সহ; লেখা-বক্সে নেটিভ-আন্ডু)</span><span class="keys"><kbd class="sc-kbd">Ctrl</kbd><kbd class="sc-kbd">Z</kbd></span></div>
    <div class="sc-help-row"><span>কমপ্যাক্ট-মোড টগল — কার্ড-ঘনত্ব (স্মরণ-রাখে)</span><span class="keys"><kbd class="sc-kbd">d</kbd></span></div>
    <div class="sc-help-row"><span>রিফ্রেশ-এখন — গণনা তৎক্ষণাৎ আনুন (বিরতি-অবস্থায়-ও চলে)</span><span class="keys"><kbd class="sc-kbd">r</kbd></span></div>
    <div class="sc-help-row"><span>অটো-হালনাগাদ বিরতি/চালু — পোল+SSE-স্বয়ংক্রিয়-রিলোড (স্মরণ-রাখে)</span><span class="keys"><kbd class="sc-kbd">p</kbd></span></div>
    <div class="sc-help-row"><span>স্পার্ক/ট্রেন্ড-বারে হোভার — দিনভিত্তিক-গণনা টুলটিপ</span><span class="keys"><kbd class="sc-kbd">হোভার</kbd></span></div>
    <div class="sc-help-row"><span>জবাব/লেখা এক-ক্লিকে ক্লিপবোর্ডে কপি (মেসেঞ্জারে-পেস্ট-প্রস্তুত)</span><span class="keys"><kbd class="sc-kbd">কপি-বাটন</kbd></span></div>
    <div class="sc-help-row"><span>সংযুক্তি-ছবি কার্ড ছাড়াই বড় করে দেখুন — ক্লিকে খোলে, Esc/বাইরে-ক্লিকে বন্ধ (Ctrl+ক্লিক = নতুন-ট্যাব)</span><span class="keys"><kbd class="sc-kbd">ক্লিক</kbd></span></div>
    <div class="sc-help-row"><span>সপ্তাহ-রিপোর্ট ক্লিপবোর্ডে কপি — KPI+গণনা-সারাংশ (টেলিগ্রামে-পেস্ট-প্রস্তুত)</span><span class="keys"><kbd class="sc-kbd">w</kbd></span></div>
    <div class="sc-help-row"><span>রিপোর্ট-ব্যাপ্তি ৭/৩০ দিন — কপি-রিপোর্টের সময়সীমা বদল (স্মরণ-রাখে)</span><span class="keys"><kbd class="sc-kbd">৭/৩০</kbd></span></div>
    <div class="sc-help-row"><span>স্পার্ক/ট্রেন্ড-বারে ট্যাপ (টাচ-স্ক্রিন) — সপ্তাহ-ওভারভিউসহ টুলটিপ</span><span class="keys"><kbd class="sc-kbd">ট্যাপ</kbd></span></div>
    <div class="sc-help-row"><span>সহায়িকা খুলুন/বন্ধ করুন</span><span class="keys"><kbd class="sc-kbd">?</kbd></span></div>
    <div class="sc-help-row"><span>কার্সর-সরান (সহায়িকা-খোলা-থাকলে আগে-বন্ধ)</span><span class="keys"><kbd class="sc-kbd">Esc</kbd></span></div>
    <div class="sc-help-row"><span>লেখা-বদলে রিফ্রেশ-আটকে-রাখা (অসংরক্ষিত-জবাব-সুরক্ষা)</span><span class="keys"><kbd class="sc-kbd">স্বয়ংক্রিয়</kbd></span></div>
    <button type="button" class="btn btn-primary btn-sm sc-help-close" id="scHelpClose">বন্ধ করুন</button>
  </div>
</div>

<%# session230 — বাল্ক-স্ট্যাটাস টুলবার (x-নির্বাচন; z-স্তর-চুক্তি: বাল্ক-টুলবার 80 > সহায়িকা 70; টোস্ট সর্বোচ্চ) %>
<div class="sc-bulk" id="scBulk" hidden role="toolbar" aria-label="বাল্ক-স্ট্যাটাস টুলবার">
  <span class="sc-bulk-count" id="scBulkCount">০ টি নির্বাচিত</span>
  <span class="sc-bulk-sep" aria-hidden="true"></span>
  <button type="button" class="sc-bulk-btn" id="scBulkAll">সব-নির্বাচন</button>
  <button type="button" class="sc-bulk-btn" id="scBulkNone">পরিষ্কার</button>
  <span class="sc-bulk-sep" aria-hidden="true"></span>
  <span class="sc-bulk-lbl">স্ট্যাটাস →</span>
  <button type="button" class="sc-bulk-btn sc-bulk-go" data-bulk-st="PENDING"><i class="fas fa-inbox" aria-hidden="true"></i> নতুন</button>
  <button type="button" class="sc-bulk-btn sc-bulk-go" data-bulk-st="IN_PROGRESS"><i class="fas fa-spinner" aria-hidden="true"></i> চলমান</button>
  <button type="button" class="sc-bulk-btn sc-bulk-go sc-bulk-res" data-bulk-st="RESOLVED"><i class="fas fa-circle-check" aria-hidden="true"></i> সমাধান</button>
  <button type="button" class="sc-bulk-x" id="scBulkClose" aria-label="নির্বাচন পরিষ্কার করুন"><i class="fas fa-xmark" aria-hidden="true"></i></button>
</div>

<%# session232 — স্পার্ক/ট্রেন্ড-বার টুলটিপ (এক-শেয়ার্ড-এলিমেন্ট; JS-এ পজিশন/কনটেন্ট; z-স্তর-চুক্তি ৬০) %>
<div id="scSparkTip" role="tooltip" aria-hidden="true"></div>
<%# session233 — সপ্তাহ-ওভারভিউ চিপ (বারের-নিচে; aria-hidden — সজ্জা; #scSparkTip-এর-textContent-চুক্তি-অক্ষুণ্ণ রাখতে আলাদা-এলিমেন্ট) %>
<div id="scSparkTipWk" aria-hidden="true"></div>
<%# session238 — কার্ড-লাইটবক্স ডায়ালগ (এক-শেয়ার্ড; Esc/ব্যাকড্রপ/বাটন-বন্ধ; z-স্তর ৯০ — বাল্ক 80 এর-উপরে, টোস্ট 1300 এর-নিচে) %>
<div id="scLbox" role="dialog" aria-modal="true" aria-label="সংযুক্তি বড় করে দেখুন" hidden>
  <button type="button" id="scLboxClose" aria-label="বন্ধ করুন (Esc)"><i class="fas fa-xmark" aria-hidden="true"></i></button>
  <figure>
    <img id="scLboxImg" alt="" />
    <figcaption id="scLboxCap"></figcaption>
  </figure>
</div>
<div id="scToast" role="status" aria-live="polite"></div>
<script>
(function () {
  'use strict';
  var deskPath = '/admin/support-center' + location.search;
  var toastEl = document.getElementById('scToast');
  var toastTimer = null;
  function toast(msg, isError, isUndo) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    toastEl.classList.toggle('error', !!isError);
    toastEl.classList.toggle('undo', !!isUndo); // session231 — ↩-আইকন (CSS ::before; error-ওভাররাইড-নিরাপদ)
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 2600);
  }
  function api(url, method, body) {
    return fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: body ? JSON.stringify(body) : undefined
    }).then(function (r) { return r.json().catch(function () { return { ok: false, error: 'রেসপন্স পার্স ব্যর্থ' }; }); });
  }
  var lastDeleted = null; // আনডু-উইন্ডো (কার্ড-প্রতি শেষ মুছে-ফেলা জবাব)

  // ── session238 — কার্ড-লাইটবক্স (IMAGE-সংযুক্তি কার্ডেই-বড়; এক-শেয়ার্ড-ডায়ালগ; ফোকাস-ফেরত) ──
  // চুক্তি: href/target_শূন্য-বদল — মধ্য-ক্লিক/সংশোধক-কী (Ctrl/Meta/Shift/Alt) = নেটিভ-নতুন-ট্যাব (E2E-নিরাপদ);
  // Esc-হ্যান্ডল = নিচের-মূল-keydown-এর Esc-শৃঙ্খলে-সর্বপ্রথম (মোডাল-অগ্রাধিকার); body-স্ক্রল-লক (খোলা-অবস্থায়)
  var lbox = document.getElementById('scLbox');
  var lboxImg = document.getElementById('scLboxImg');
  var lboxCap = document.getElementById('scLboxCap');
  var lboxClose = document.getElementById('scLboxClose');
  var lboxSrc = null; // ফোকাস-ফেরত-উৎস (ট্রিগার-লিঙ্ক)
  function lboxOpen(a) {
    lboxSrc = a;
    lboxImg.src = a.getAttribute('href');
    var cap = a.getAttribute('data-lcap') || '';
    lboxImg.alt = cap;
    lboxCap.textContent = cap;
    lbox.hidden = false;
    document.body.style.overflow = 'hidden';
    lboxClose.focus();
  }
  function lboxHide() {
    if (lbox.hidden) return;
    lbox.hidden = true;
    lboxImg.src = '';
    lboxCap.textContent = '';
    document.body.style.overflow = '';
    if (lboxSrc) { try { lboxSrc.focus(); } catch (_) {} lboxSrc = null; }
  }
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[data-lbox]') : null;
    if (!a) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return; // নেটিভ-নতুন-ট্যাব
    e.preventDefault();
    lboxOpen(a);
  });
  lboxClose.addEventListener('click', lboxHide);
  lbox.addEventListener('click', function (e) { if (e.target === lbox || e.target.tagName === 'FIGURE') lboxHide(); }); // ব্যাকড্রপ-ক্লিক


  // ── session228 — অসংরক্ষিত-জবাব সুরক্ষা (dirty-guard: লেখা-বদলে অটু-রিফ্রেশ/বন্ধ-আটকায়) ──
  var dirty = false, dirtyWarned = false;
  window.__scQA = { dirty: false, paused: false, refreshing: false }; // session236 — ফিল্ড-স্টাইল (রিফ্রেশ/বিরতি-অবস্থা-একই-অবজেক্টে)
  window.__scQA.lboxOpen = function () { return !lbox.hidden; }; // session238 — QA-হুক (অবশ্যই __scQA-পুনঃসৃজনের-পরে — রাউন্ডে-ধরা-বাগ)
  function markDirty() { dirty = true; window.__scQA.dirty = true; }
  function clearDirty() { dirty = false; dirtyWarned = false; window.__scQA.dirty = false; }
  clearDirty();
  document.addEventListener('input', function (e) {
    if (e.target.closest && e.target.closest('.sc-note-box, [data-heditbox]')) markDirty();
  });
  document.addEventListener('change', function (e) {
    if (e.target.closest && e.target.closest('.sc-actions select')) markDirty();
  });
  window.addEventListener('beforeunload', function (e) {
    if (!dirty) return;
    e.preventDefault(); e.returnValue = '';
  });
