  // কীবোর্ড-ব্যবহারকারী: KPI-কার্ড-ফোকাসে আজ-বার-মান (মাউস-বর্জন-নয় — aria-hidden-স্পার্ক, কার্ডের-নিজ-aria-label-অক্ষুণ্ণ)
  document.addEventListener('focusin', function (e) {
