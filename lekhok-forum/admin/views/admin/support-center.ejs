  // ── session233 — টাচ-ট্যাপ: বারে ট্যাপে টুলটিপ+সপ্তাহ-ওভারভিউ, বাইরে ট্যাপ/ক্লিকে লুকায় ──
  // KPI-কার্ড-ভিতরের-স্পার্ক-বারে ট্যাপ = টুলটিপ-অভিপ্রায় (নেভিগেশন-নয়) → closest('a')-হলে preventDefault;
  // কার্ডের-বাকি-অঞ্চল (বড়-সংখ্যা/লেবেল) স্বাভাবিক-জাম্প-অক্ষুণ্ণ; hover-চুক্তি-অপরিবর্তিত
  document.addEventListener('click', function (e) {
