<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>সাপোর্ট ডেস্ক — লেখক ফোরাম অ্যাডমিন</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
  <style>
    /* সাপোর্ট-ডেস্ক (Next-পোর্ট) — সব রঙ var() টোকেন (hex-ratchet-সেফ) */
    .sc-wrap{max-width:960px}
    .sc-live{display:inline-flex;align-items:center;gap:6px;font-size:.78rem;font-weight:700;color:var(--ad-muted);
      border:1px solid var(--ad-line);border-radius:999px;padding:3px 10px;background:var(--ad-card)}
    .sc-live .dot{width:8px;height:8px;border-radius:50%;background:var(--ad-muted)}
    .sc-live.on{color:var(--ad-accent-ink);border-color:var(--ad-accent-ring)}
    .sc-live.on .dot{background:var(--ad-accent);animation:scPulse 1.6s ease infinite}
    @keyframes scPulse{0%,100%{opacity:1}50%{opacity:.35}}
    .sc-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
    .sc-stat{background:var(--ad-card);border:1px solid var(--ad-line);border-radius:var(--ad-radius);padding:12px 14px;cursor:pointer;
      display:flex;flex-direction:column;gap:2px;transition:box-shadow .2s, transform .2s}
    .sc-stat:hover{box-shadow:var(--ad-shadow-lg);transform:translateY(-1px)}
    .sc-stat b{font-size:1.5rem;font-family:var(--font-heading)}
    .sc-stat span{font-size:.8rem;color:var(--ad-muted);font-weight:600}
    .sc-stat.s-pending b{color:var(--ad-red)} .sc-stat.s-progress b{color:var(--lf-amber-deep)} .sc-stat.s-resolved b{color:var(--lf-ok-deep)}
    .sc-filters{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:14px}
    .sc-chip{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:600;padding:5px 12px;border-radius:999px;
      border:1px solid var(--ad-line);background:var(--ad-card);color:var(--ad-ink-2);cursor:pointer}
    .sc-chip:hover{border-color:var(--ad-accent-ring)}
    .sc-chip.active{background:var(--ad-accent-soft);border-color:var(--ad-accent);color:var(--ad-accent-ink)}
    .sc-search{display:flex;gap:6px;margin-left:auto}
    .sc-search input{border:1px solid var(--ad-line);border-radius:var(--ad-radius-sm);padding:6px 10px;font-family:inherit;min-width:170px;background:var(--ad-card);color:var(--ad-ink)}
    .sc-stale{background:var(--lf-amber-soft);border:1px solid var(--lf-amber-soft-3);color:var(--lf-amber-ink);
      border-radius:var(--ad-radius);padding:9px 14px;font-size:.86rem;font-weight:600;margin-bottom:12px}
    /* session227 — ২৪ঘ-সারাংশ KPI (digestStats এক-উৎস; টোন-ব্যান্ড + hover-লিফট + focus-ring; সব-রঙ var()-টোকেন) */
    .sc-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:0 0 12px}
    @media (max-width:640px){.sc-kpis{grid-template-columns:repeat(2,1fr)}}
    .sc-kpi{background:var(--ad-card);border:1px solid var(--ad-line);border-radius:var(--ad-radius);padding:11px 13px;
      display:flex;flex-direction:column;gap:3px;text-decoration:none;cursor:pointer;
      transition:box-shadow .2s, transform .2s, border-color .2s}
    .sc-kpi:hover{box-shadow:var(--ad-shadow-lg);transform:translateY(-1px);border-color:var(--ad-accent-ring)}
    .sc-kpi:focus-visible{outline:2px solid var(--ad-accent);outline-offset:2px}
    .sc-kpi .k-head{display:flex;align-items:center;gap:7px;font-size:.72rem;font-weight:700;color:var(--ad-muted)}
    .sc-kpi .k-ic{width:24px;height:24px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;flex:none}
    .sc-kpi b{font-size:1.3rem;font-family:var(--font-heading);line-height:1}
    .sc-kpi small{font-size:.68rem;color:var(--ad-muted);font-weight:600}
    .sc-kpi.k-fresh{border-top:3px solid var(--lf-amber-deep)}
    .sc-kpi.k-fresh .k-ic{background:var(--lf-amber-soft-2);color:var(--lf-amber-ink)}
    .sc-kpi.k-fresh b{color:var(--lf-amber-deep)}
    .sc-kpi.k-res{border-top:3px solid var(--lf-ok-deep)}
    .sc-kpi.k-res .k-ic{background:var(--lf-ok-soft);color:var(--lf-ok-deep)}
    .sc-kpi.k-res b{color:var(--lf-ok-deep)}
    .sc-kpi.k-stale{border-top:3px solid var(--lf-danger-deep)}
    .sc-kpi.k-stale .k-ic{background:var(--lf-danger-soft);color:var(--lf-danger-deep)}
    .sc-kpi.k-stale b{color:var(--lf-danger-deep)}
    .sc-kpi.k-avg{border-top:3px solid var(--ad-accent)}
    .sc-kpi.k-avg .k-ic{background:var(--ad-accent-soft);color:var(--ad-accent-ink)}
    .sc-kpi.k-avg b{color:var(--ad-accent-ink)}
    /* session226 — ৭-দিনের প্রবণতা (trend7 এক-উৎস; বার স্ট্যাটিক — reduced-motion-নিরাপদ; সব-রঙ var()-টোকেন) */
    .sc-trend{background:var(--ad-card);border:1px solid var(--ad-line);border-radius:var(--ad-radius);padding:12px 14px;margin-bottom:12px}
    .sc-trend-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px;flex-wrap:wrap}
    .sc-trend-head b{font-size:.86rem}
    .sc-trend-head span{font-size:.72rem;color:var(--ad-muted);font-weight:600}
    .sc-trend-row{display:flex;align-items:center;gap:10px;margin-top:8px}
    .sc-trend-lbl{width:64px;flex:none;text-align:right;font-size:.74rem;font-weight:700;color:var(--ad-muted)}
    .sc-trend-bars{flex:1;display:flex;align-items:flex-end;gap:2px;height:26px;border-bottom:1px solid var(--ad-line)}
    .sc-trend-bars span{flex:1;min-width:3px;border-radius:2px 2px 0 0;background:var(--ad-icon-bg)}
    .sc-trend-bars .sc-tb-new{background:var(--lf-amber-soft-2)}
    .sc-trend-bars .sc-tb-new.today{background:var(--lf-amber-deep)}
    .sc-trend-bars .sc-tb-res{background:var(--lf-ok-soft)}
    .sc-trend-bars .sc-tb-res.today{background:var(--lf-ok-deep)}
    @media (prefers-reduced-motion: reduce){.sc-trend *{transition:none !important;animation:none !important}}
    .sc-card{background:var(--ad-card);border:1px solid var(--ad-line);border-radius:var(--ad-radius);padding:16px;margin-bottom:14px;box-shadow:var(--ad-shadow)}
    .sc-card.sc-heat-stale{border-color:var(--lf-amber-soft-3);box-shadow:0 0 0 3px var(--lf-amber-soft-2)}
    .sc-card-head{display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap}
    .sc-card-head img.sc-av{width:40px;height:40px;border-radius:50%;object-fit:cover;background:var(--ad-icon-bg)}
    .sc-who{flex:1;min-width:150px}
    .sc-who b{font-size:.98rem}
    .sc-who small{display:block;color:var(--ad-muted);font-size:.78rem;margin-top:1px}
    .sc-badge{font-size:.72rem;font-weight:700;padding:2px 9px;border-radius:999px;white-space:nowrap}
    .sc-badge.m-TEXT{background:var(--ad-icon-bg);color:var(--ad-ink-2)}
    .sc-badge.m-IMAGE{background:var(--ad-accent-soft);color:var(--ad-accent-ink)}
    .sc-badge.m-AUDIO{background:var(--lf-ok-soft);color:var(--lf-ok-deep)}
    .sc-badge.m-VIDEO{background:var(--lf-amber-soft-2);color:var(--lf-amber-ink)}
    .sc-badge.st-PENDING{background:var(--lf-danger-soft);color:var(--lf-danger-deep)}
    .sc-badge.st-IN_PROGRESS{background:var(--lf-amber-soft-2);color:var(--lf-amber-ink)}
    .sc-badge.st-RESOLVED{background:var(--lf-ok-soft);color:var(--lf-ok-deep)}
    .sc-aging{font-size:.72rem;font-weight:700;color:var(--lf-amber-ink);background:var(--lf-amber-soft-2);border-radius:999px;padding:2px 9px}
    .sc-body{margin:10px 0 0;white-space:pre-wrap;line-height:1.6;font-size:.94rem}
    .sc-media{margin-top:10px}
    .sc-media img{max-width:100%;max-height:300px;border-radius:var(--ad-radius-sm);border:1px solid var(--ad-line)}
    .sc-media audio,.sc-media video{width:100%;max-width:420px}
    .sc-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-start;margin-top:12px;padding-top:12px;border-top:1px solid var(--ad-line-soft)}
    .sc-actions select{width:auto}
    .sc-note-box{flex:1;min-width:230px;display:flex;flex-direction:column;gap:6px}
    .sc-note-box textarea{min-height:64px;resize:vertical;font-family:inherit}
    .sc-tpl{display:flex;gap:6px;flex-wrap:wrap}
    .sc-tpl button{font-size:.72rem;font-weight:600;border:1px dashed var(--ad-line);background:var(--ad-bg);color:var(--ad-muted);
      border-radius:999px;padding:3px 10px;cursor:pointer;font-family:inherit}
    .sc-tpl button:hover{color:var(--ad-accent-ink);border-color:var(--ad-accent-ring)}
    .sc-hist{margin-top:12px;border-top:1px dashed var(--ad-line);padding-top:10px}
    .sc-hist-title{font-size:.78rem;font-weight:700;color:var(--ad-muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:.4px}
    .sc-hentry{display:flex;gap:8px;align-items:flex-start;font-size:.86rem;padding:6px 0;border-bottom:1px dashed var(--ad-line-soft)}
    .sc-hentry:last-child{border-bottom:0}
    .sc-hico{width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.66rem;flex-shrink:0;margin-top:1px}
    .sc-hico.t-status{background:var(--ad-accent-soft);color:var(--ad-accent-ink)}
    .sc-hico.t-note{background:var(--lf-ok-soft);color:var(--lf-ok-deep)}
    .sc-hbody{flex:1}
    .sc-hmeta{font-size:.72rem;color:var(--ad-muted);margin-top:2px}
    .sc-hedited{font-size:.68rem;font-weight:700;color:var(--lf-amber-ink);background:var(--lf-amber-soft-2);border-radius:6px;padding:1px 6px;margin-left:6px}
    .sc-hbtns{display:flex;gap:4px;flex-shrink:0}
    .sc-hbtns button{border:1px solid var(--ad-line);background:var(--ad-card);color:var(--ad-muted);border-radius:6px;width:26px;height:26px;cursor:pointer;font-size:.72rem}
    .sc-hbtns button:hover{color:var(--ad-accent-ink);border-color:var(--ad-accent-ring)}
    .sc-empty{background:var(--ad-card);border:1px dashed var(--ad-line);border-radius:var(--ad-radius);padding:34px;text-align:center;color:var(--ad-muted)}
    .sc-cfg-chip{display:inline-flex;align-items:center;gap:6px;font-size:.78rem;color:var(--ad-ink-2);background:var(--ad-card);border:1px solid var(--ad-line);border-radius:999px;padding:3px 10px 3px 4px}
    .sc-cfg-chip img{width:22px;height:22px;border-radius:50%;object-fit:cover}
    #scToast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--lf-fb-ink);color:var(--lf-white);
      border-radius:var(--ad-radius-sm);padding:10px 18px;font-size:.88rem;font-weight:600;opacity:0;pointer-events:none;transition:opacity .3s, transform .3s;z-index:1300;max-width:90vw}
    #scToast.show{opacity:1;transform:translateX(-50%) translateY(0)}
    @media (max-width:640px){ .sc-stats{grid-template-columns:1fr 1fr 1fr;gap:6px} .sc-stat b{font-size:1.15rem} .sc-search{margin-left:0;width:100%} .sc-search input{flex:1} }
    @media (prefers-reduced-motion: reduce){ .sc-live.on .dot{animation:none} .sc-stat:hover{transform:none} }
    /* ── session228 — স্টাইল-সমৃদ্ধি (সব-রঙ var()-টোকেন; reduced-motion-সম্মানী) ── */
    .sc-badge i{margin-right:4px;font-size:.66rem;opacity:.85}
    .sc-card{animation:scCardIn .34s ease backwards}
    .sc-card:nth-child(2){animation-delay:.045s} .sc-card:nth-child(3){animation-delay:.09s}
    .sc-card:nth-child(4){animation-delay:.135s} .sc-card:nth-child(5){animation-delay:.18s}
    .sc-card:nth-child(6){animation-delay:.225s} .sc-card:nth-child(7){animation-delay:.27s}
    .sc-card:nth-child(8){animation-delay:.315s} .sc-card:nth-child(n+9){animation-delay:.34s}
    @keyframes scCardIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    .sc-card.sc-cursor{outline:2px solid var(--ad-accent);outline-offset:2px;box-shadow:var(--ad-shadow-lg)}
    .sc-tpl button:active{transform:translateY(1px)}
    .sc-tpl button:focus-visible,.sc-chip:focus-visible,.sc-hbtns button:focus-visible,.sc-search button:focus-visible{outline:2px solid var(--ad-accent);outline-offset:2px}
    .sc-note-box textarea:focus-visible,.sc-search input:focus-visible,.sc-actions select:focus-visible{outline:2px solid var(--ad-accent);outline-offset:1px}
    .sc-hentry{position:relative}
    .sc-hentry::before{content:'';position:absolute;left:10px;top:30px;bottom:-8px;width:2px;background:var(--ad-line-soft)}
    .sc-hentry:last-child::before{display:none}
    .sc-empty .sc-empty-ic{width:52px;height:52px;border-radius:50%;background:var(--ad-icon-bg);display:inline-flex;align-items:center;justify-content:center;margin-bottom:10px}
    .sc-empty-reset{display:inline-flex;align-items:center;gap:6px;margin-top:12px;font-size:.8rem;font-weight:700;color:var(--ad-accent-ink);
      border:1px solid var(--ad-accent-ring);background:var(--ad-accent-soft);border-radius:999px;padding:6px 14px;cursor:pointer;text-decoration:none}
    .sc-empty-reset:hover{box-shadow:var(--ad-shadow)}
    /* কীবোর্ড-সহায়িকা ওভারলে (z-স্তর-চুক্তি: সহায়িকা-স্তর) */
    .sc-help{position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);
      z-index:70;display:none;align-items:center;justify-content:center;padding:16px}
    .sc-help.open{display:flex}
    .sc-help-panel{background:var(--ad-card);border:1px solid var(--ad-line);border-radius:var(--ad-radius);box-shadow:var(--ad-shadow-lg);
      max-width:430px;width:100%;max-height:86vh;overflow:auto;padding:18px 20px}
    .sc-help-panel h2{font-size:.95rem;margin:0 0 4px;display:flex;align-items:center;gap:8px}
    .sc-help-panel p.sc-help-sub{font-size:.76rem;color:var(--ad-muted);margin:0 0 12px}
    .sc-help-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px dashed var(--ad-line-soft);font-size:.84rem}
    .sc-help-row:last-of-type{border-bottom:0}
    .sc-help-row .keys{display:flex;gap:4px;flex:none}
    .sc-kbd{display:inline-block;min-width:22px;text-align:center;font-family:var(--font-mono,monospace);font-size:.72rem;font-weight:700;color:var(--ad-ink);
      background:var(--ad-bg);border:1px solid var(--ad-line);border-bottom-width:2px;border-radius:6px;padding:2px 6px}
    .sc-help-close{margin-top:12px;width:100%;justify-content:center}
    @media (prefers-reduced-motion: reduce){ .sc-card{animation:none} .sc-empty-reset:hover{box-shadow:none} }
  </style>
</head>
<body>
<%- include('./partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1><i class="fas fa-headset"></i> সাপোর্ট-অভিযোগ রিভিউ ডেস্ক</h1>
      <p>ইউজাররা নির্ধারিত সাপোর্ট-অ্যাডমিনকে মেসেঞ্জারে লিখলে এখানে রেকর্ড হয় — স্ট্যাটাস, জবাব ও ইতিহাস এখানে ম্যানেজ হয়</p>
    </div>
    <div class="header-actions">
      <% if (supportAdmin) { %>
        <span class="sc-cfg-chip" title="নির্ধারিত সাপোর্ট-অ্যাডমিন">
          <img src="<%= supportAdmin.avatar_url || '/avatar/' + supportAdmin.id %>" alt="" />
          <i class="fas fa-headset" style="color:var(--ad-accent)"></i> <%= supportAdmin.full_name %>
        </span>
      <% } else { %>
        <a href="/admin/super/support-settings" class="sc-cfg-chip" style="color:var(--lf-amber-ink)"><i class="fas fa-triangle-exclamation"></i> কোনো সাপোর্ট-অ্যাডমিন নির্ধারিত নেই</a>
      <% } %>
      <span class="sc-live" id="scLive"><span class="dot"></span> <span id="scLiveTxt">লাইভ</span></span>
      <button type="button" class="btn btn-sm" id="scHelpBtn" title="কীবোর্ড শর্টকাট দেখুন" aria-label="কীবোর্ড শর্টকাট সহায়িকা খুলুন"><i class="fas fa-keyboard"></i> শর্টকাট <kbd class="sc-kbd" style="margin-left:2px">?</kbd></button>
      <a class="btn btn-sm" href="/admin/support-center/export.csv?<%= [status ? 'status='+status : '', media ? 'media='+media : '', q ? 'q='+encodeURIComponent(q) : ''].filter(Boolean).join('&') %>"><i class="fas fa-file-csv"></i> CSV</a>
    </div>
  </div>

  <% if (staleN > 0) { %>
  <div class="sc-stale"><i class="fas fa-hourglass-half"></i> <%= staleN %> টি অভিযোগ ৩ দিনের বেশি সময় ধরে অমীমাংসিত — দ্রুত নিষ্পত্তির অনুরোধ</div>
  <% } %>
  <%# session226 — ৭-দিনের প্রবণতা (helpers trend7 এক-উৎস; বার aria-hidden, লেবেল দৃশ্যমান; আজ-বার গাড়-টোকেন) %>
  <div class="sc-trend" role="group" aria-label="৭ দিনের প্রবণতা">
    <div class="sc-trend-head">
      <b>৭-দিনের প্রবণতা</b>
      <span><%= trend.dayLabels[0] %> → <%= trend.dayLabels[6] %></span>
    </div>
    <% [['নতুন', trend.newPerDay, 'sc-tb-new'], ['সমাধান', trend.resolvedPerDay, 'sc-tb-res']].forEach(function(row){ var maxV = Math.max.apply(null, row[1].concat([0])); %>
    <div class="sc-trend-row">
      <span class="sc-trend-lbl"><%= row[0] %></span>
      <div class="sc-trend-bars" aria-hidden="true">
        <% row[1].forEach(function(v, i){ %>
        <span class="<%= row[2] %> <%= i === 6 ? 'today' : '' %>" style="height:<%= v > 0 && maxV > 0 ? Math.max(3, Math.round(v / maxV * 20)) : 2 %>px" title="<%= trend.dayLabels[i] %> — <%= bnNum(v) %> টি"></span>
        <% }) %>
      </div>
    </div>
    <% }) %>
  </div>

  <%# session227 — ২৪ঘ-সারাংশ KPI (helpers digestStats এক-উৎস; ক্লিকে ফিল্টার-ভিউ-জাম্প: status+range) %>
  <div class="sc-kpis" role="group" aria-label="২৪ ঘণ্টার সারসংক্ষেপ">
    <a class="sc-kpi k-fresh" href="/admin/support-center?status=PENDING&range=today"
       aria-label="২৪ ঘণ্টায় <%= bnNum(digest.fresh24) %>টি নতুন অমীমাংসিত — আজকের নতুন-ভিউতে যান">
      <span class="k-head"><span class="k-ic"><i class="fas fa-inbox"></i></span>২৪ ঘণ্টায় নতুন</span>
      <b><%= bnNum(digest.fresh24) %></b>
      <small>২৪ঘ-এর-কম-পুরোনো অমীমাংসিত</small>
    </a>
    <a class="sc-kpi k-res" href="/admin/support-center?status=RESOLVED&range=today"
       aria-label="গত ২৪ ঘণ্টায় <%= bnNum(digest.resolved24) %>টি সমাধান — আজকের সমাধান-ভিউতে যান">
      <span class="k-head"><span class="k-ic"><i class="fas fa-circle-check"></i></span>২৪ ঘণ্টায় সমাধান</span>
      <b><%= bnNum(digest.resolved24) %></b>
      <small>গত-২৪ঘ-বে-সমাধান-হওয়া</small>
    </a>
    <a class="sc-kpi k-stale" href="/admin/support-center?status=PENDING"
       aria-label="<%= bnNum(digest.stale) %>টি স্টেল অভিযোগ (৩+ দিন অমীমাংসিত) — নতুন-তালিকায় যান">
      <span class="k-head"><span class="k-ic"><i class="fas fa-hourglass-half"></i></span>স্টেল (৩+ দিন)</span>
      <b><%= bnNum(digest.stale) %></b>
      <small><%= digest.oldestOpenDays !== null ? 'পুরোনোতম ' + bnNum(digest.oldestOpenDays) + ' দিন ধরে' : '৩+ দিন ধরে অমীমাংসিত' %></small>
    </a>
    <a class="sc-kpi k-avg" href="/admin/support-center?status=RESOLVED"
       aria-label="<%= digest.avgResolveHours !== null ? 'গড় সমাধান-সময় ' + bnNum(digest.avgResolveHours) + ' ঘণ্টা' : 'গড় সমাধান-সময় এখনো-গণনাযোগ্য নয়' %> — সমাধান-তালিকায় যান">
      <span class="k-head"><span class="k-ic"><i class="fas fa-clock"></i></span>গড় সমাধান-সময়</span>
      <b><%= digest.avgResolveHours !== null ? bnNum(digest.avgResolveHours) + ' ঘ' : '—' %></b>
      <small><%= digest.avgResolveHours !== null ? 'সমাধান-ইতিহাসের-গড়' : 'সমাধান-ইতিহাস-নেই' %></small>
    </a>
  </div>

  <div class="sc-stats">
    <button type="button" class="sc-stat s-pending" onclick="location.href='/admin/support-center?<%= [media?'media='+media:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:''].filter(Boolean).join('&') %>'">
      <b><%= counts.PENDING %></b><span>নতুন অভিযোগ</span>
    </button>
    <button type="button" class="sc-stat s-progress" onclick="location.href='/admin/support-center?<%= ['status=IN_PROGRESS', media?'media='+media:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:''].filter(Boolean).join('&') %>'">
      <b><%= counts.IN_PROGRESS %></b><span>চলমান</span>
    </button>
    <button type="button" class="sc-stat s-resolved" onclick="location.href='/admin/support-center?<%= ['status=RESOLVED', media?'media='+media:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:''].filter(Boolean).join('&') %>'">
      <b><%= counts.RESOLVED %></b><span>সমাধান হয়েছে</span>
    </button>
  </div>

  <div class="sc-filters">
    <a class="sc-chip <%= !status ? 'active' : '' %>" href="/admin/support-center?<%= [media?'media='+media:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:''].filter(Boolean).join('&') %>">সব</a>
    <a class="sc-chip <%= status === 'PENDING' ? 'active' : '' %>" href="/admin/support-center?<%= ['status=PENDING', media?'media='+media:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:''].filter(Boolean).join('&') %>">নতুন (<%= counts.PENDING %>)</a>
    <a class="sc-chip <%= status === 'IN_PROGRESS' ? 'active' : '' %>" href="/admin/support-center?<%= ['status=IN_PROGRESS', media?'media='+media:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:''].filter(Boolean).join('&') %>">চলমান (<%= counts.IN_PROGRESS %>)</a>
    <a class="sc-chip <%= status === 'RESOLVED' ? 'active' : '' %>" href="/admin/support-center?<%= ['status=RESOLVED', media?'media='+media:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:''].filter(Boolean).join('&') %>">সমাধান (<%= counts.RESOLVED %>)</a>
    <span style="width:1px;height:20px;background:var(--ad-line)"></span>
    <%# session227 — সময়-সীমা chips (range প্যারাম; অন্য-ফিল্টার-সংরক্ষণ) %>
    <% ['today', '7d', '30d'].forEach(function(r){ var lbl = r === 'today' ? 'আজ' : (r === '7d' ? '৭ দিন' : '৩০ দিন'); %>
    <a class="sc-chip <%= range === r ? 'active' : '' %>" aria-current="<%= range === r ? 'true' : 'false' %>" href="/admin/support-center?<%= [status?'status='+status:'', media?'media='+media:'', q?'q='+encodeURIComponent(q):'', 'range='+r].filter(Boolean).join('&') %>"><i class="fas fa-clock"></i> <%= lbl %></a>
    <% }) %>
    <% if (range) { %>
    <a class="sc-chip" href="/admin/support-center?<%= [status?'status='+status:'', media?'media='+media:'', q?'q='+encodeURIComponent(q):''].filter(Boolean).join('&') %>" title="সময়-সীমা সরান"><i class="fas fa-xmark"></i> সময়-সীমা</a>
    <% } %>
    <span style="width:1px;height:20px;background:var(--ad-line)"></span>
    <a class="sc-chip <%= media === 'TEXT' ? 'active' : '' %>" href="/admin/support-center?<%= [status?'status='+status:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:'', 'media=TEXT'].filter(Boolean).join('&') %>">লেখা</a>
    <a class="sc-chip <%= media === 'IMAGE' ? 'active' : '' %>" href="/admin/support-center?<%= [status?'status='+status:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:'', 'media=IMAGE'].filter(Boolean).join('&') %>">ছবি</a>
    <a class="sc-chip <%= media === 'AUDIO' ? 'active' : '' %>" href="/admin/support-center?<%= [status?'status='+status:'', q?'q='+encodeURIComponent(q):'', range?'range='+range:'', 'media=AUDIO'].filter(Boolean).join('&') %>">ভয়েস</a>
    <form class="sc-search" method="GET" action="/admin/support-center">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>" /><% } %>
      <% if (media) { %><input type="hidden" name="media" value="<%= media %>" /><% } %>
      <% if (range) { %><input type="hidden" name="range" value="<%= range %>" /><% } %>
      <input type="search" name="q" value="<%= q %>" placeholder="বার্তা বা প্রেরক খুঁজুন…" aria-label="ডেস্ক-সার্চ" />
      <button class="btn btn-sm" type="submit"><i class="fas fa-search"></i></button>
    </form>
  </div>

  <% if (reports.length === 0) { %>
    <div class="sc-empty">
      <span class="sc-empty-ic"><i class="fas fa-inbox" style="font-size:1.3rem"></i></span>
      কোনো অভিযোগ নেই — ফিল্টার বদলে দেখুন বা অপেক্ষা করুন
      <% if (status || media || q || range) { %>
      <div>
        <a class="sc-empty-reset" href="/admin/support-center"><i class="fas fa-filter-circle-xmark"></i> সব-ফিল্টার সরিয়ে সব-দেখুন</a>
      </div>
      <% } %>
    </div>
  <% } %>

  <% reports.forEach(r => { %>
  <div class="sc-card <%= r.aging.cls %>" data-id="<%= r.id %>" data-status="<%= r.status %>">
    <div class="sc-card-head">
      <img class="sc-av" src="<%= r.sender_avatar || '/avatar/' + r.sender_id %>" alt="" onerror="this.src='/assets/img/avatar-placeholder.svg'" />
      <div class="sc-who">
        <b><%= r.sender_name || 'অজানা ব্যবহারকারী' %></b>
        <small>
          <% if (r.sender_username) { %><a href="/profile/<%= r.sender_username %>" target="_blank">@<%= r.sender_username %></a> · <% } %>
          <span title="<%= r.created_at %>"><%= r.created_at %></span>
        </small>
      </div>
      <span class="sc-badge m-<%= r.media_type %>"><i class="fas <%= r.media_type === 'TEXT' ? 'fa-pen' : r.media_type === 'IMAGE' ? 'fa-image' : r.media_type === 'AUDIO' ? 'fa-microphone' : 'fa-video' %>"></i><%= r.media_type === 'TEXT' ? 'লেখা' : r.media_type === 'IMAGE' ? 'ছবি' : r.media_type === 'AUDIO' ? 'ভয়েস' : 'ভিডিও' %></span>
      <% if (r.aging.label) { %><span class="sc-aging"><%= r.aging.label %></span><% } %>
      <span class="sc-badge st-<%= r.status %>"><%= r.status === 'PENDING' ? 'নতুন' : r.status === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান হয়েছে' %></span>
    </div>

    <p class="sc-body"><%= r.message_text %></p>

    <% if (r.media_url && r.media_type === 'IMAGE') { %>
      <div class="sc-media"><a href="<%= r.media_url %>" target="_blank" rel="noopener"><img src="<%= r.media_url %>" alt="অভিযোগ-সংযুক্তি" loading="lazy" /></a></div>
    <% } else if (r.media_url && r.media_type === 'AUDIO') { %>
      <div class="sc-media"><audio controls preload="none" src="<%= r.media_url %>"></audio></div>
    <% } else if (r.media_url && r.media_type === 'VIDEO') { %>
      <div class="sc-media"><video controls preload="metadata" src="<%= r.media_url %>"></video></div>
    <% } else if (r.media_url) { %>
      <div class="sc-media"><a class="btn btn-sm" href="<%= r.media_url %>" target="_blank"><i class="fas fa-paperclip"></i> সংযুক্তি</a></div>
    <% } %>

    <div class="sc-actions">
      <select data-sc-status aria-label="স্ট্যাটাস">
        <option value="PENDING" <%= r.status === 'PENDING' ? 'selected' : '' %>>নতুন</option>
        <option value="IN_PROGRESS" <%= r.status === 'IN_PROGRESS' ? 'selected' : '' %>>চলমান</option>
        <option value="RESOLVED" <%= r.status === 'RESOLVED' ? 'selected' : '' %>>সমাধান হয়েছে</option>
      </select>
      <div class="sc-note-box">
        <textarea data-sc-note maxlength="2000" placeholder="ম্যানেজমেন্টের জবাব লিখুন (রিপোর্টার দেখতে পাবেন)…"><%= r.admin_note || '' %></textarea>
        <div class="sc-tpl">
          <button type="button" data-tpl="আপনার অভিযোগ গৃহীত হয়েছে — ধন্যবাদ।">গৃহীত</button>
          <button type="button" data-tpl="আপনার অভিযোগ পর্যালোচনাধীন আছে — শীঘ্রই হালনাগাদ জানানো হবে।">পর্যালোচনাধীন</button>
          <button type="button" data-tpl="প্রয়োজনীয় ব্যবস্থা নেওয়া হয়েছে। সহযোগিতার জন্য ধন্যবাদ।">ব্যবস্থা নেওয়া হয়েছে</button>
          <button type="button" data-tpl="অতিরিক্ত তথ্য/প্রমাণ পেলে এই থ্রেডে পাঠান।">তথ্য চাওয়া হয়েছে</button>
          <button type="button" data-tpl="অভিযোগটি সমাধান হয়েছে। আরও সমস্যা হলে জানাবেন।">সমাধান</button>
        </div>
      </div>
      <button type="button" class="btn btn-primary btn-sm" data-sc-save><i class="fas fa-save"></i> সংরক্ষণ</button>
    </div>

    <% if (r.history.length) { %>
    <div class="sc-hist">
      <div class="sc-hist-title"><i class="fas fa-clock-rotate-left"></i> অ্যাকশন-ইতিহাস</div>
      <% r.history.forEach((h, hi) => { %>
      <div class="sc-hentry" data-hidx="<%= hi %>" data-entry="<%= encodeURIComponent(JSON.stringify(h)) %>">
        <span class="sc-hico t-<%= h.t %>"><i class="fas <%= h.t === 'status' ? 'fa-arrow-right-arrow-left' : 'fa-reply' %>"></i></span>
        <div class="sc-hbody">
          <% if (h.t === 'status') { %>
            স্ট্যাটাস: <strong><%= h.from === 'PENDING' ? 'নতুন' : h.from === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান' %> → <%= h.to === 'PENDING' ? 'নতুন' : h.to === 'IN_PROGRESS' ? 'চলমান' : 'সমাধান' %></strong>
            <div class="sc-hmeta"><%= h.by %> · <%= String(h.at || '').replace('T', ' ').slice(0, 16) %></div>
          <% } else { %>
            <span data-hnote><%= h.note %></span><% if (h.editedAt) { %><span class="sc-hedited">সম্পাদিত</span><% } %>
            <div class="sc-hmeta"><%= h.by %> · <%= String(h.at || '').replace('T', ' ').slice(0, 16) %><%= h.editedAt ? ' · সম্পাদনা: ' + String(h.editedAt).replace('T', ' ').slice(0, 16) : '' %></div>
          <% } %>
        </div>
        <% if (h.t === 'note') { %>
        <div class="sc-hbtns">
          <button type="button" data-hedit title="জবাব সম্পাদনা" aria-label="জবাব সম্পাদনা"><i class="fas fa-pen"></i></button>
          <button type="button" data-hdel title="জবাব মুছুন" aria-label="জবাব মুছুন"><i class="fas fa-trash"></i></button>
        </div>
        <% } %>
      </div>
      <% }) %>
      <div data-hundo style="display:none;margin-top:8px">
        <button type="button" class="btn btn-sm" data-hundo-btn><i class="fas fa-rotate-left"></i> মুছে-ফেলা জবাব ফেরত আনুন</button>
      </div>
    </div>
    <% } %>
  </div>
  <% }) %>
</div>

<%# session228 — কীবোর্ড-সহায়িকা ওভারলে (dialog + Esc/ব্যাকড্রপ-বন্ধ; z-স্তর-চুক্তি সহায়িকা-স্তর) %>
<div class="sc-help" id="scHelp" role="dialog" aria-modal="true" aria-label="কীবোর্ড শর্টকাট সহায়িকা" hidden>
  <div class="sc-help-panel" id="scHelpPanel" tabindex="-1">
    <h2><i class="fas fa-keyboard" style="color:var(--ad-accent)"></i> কীবোর্ড শর্টকাট</h2>
    <p class="sc-help-sub">ডেস্ক-নেভিগেশন দ্রুত করুন — লেখা-বক্স/সার্চে টাইপ-করার-সময় শর্টকাট-নিষ্ক্রিয়</p>
    <div class="sc-help-row"><span>পরবর্তী/পূর্ববর্তী কার্ড-কার্সর</span><span class="keys"><kbd class="sc-kbd">j</kbd><kbd class="sc-kbd">k</kbd></span></div>
    <div class="sc-help-row"><span>স্ট্যাটাস-ভিউ: নতুন / চলমান / সমাধান</span><span class="keys"><kbd class="sc-kbd">1</kbd><kbd class="sc-kbd">2</kbd><kbd class="sc-kbd">3</kbd></span></div>
    <div class="sc-help-row"><span>সব-অভিযোগ ভিউ</span><span class="keys"><kbd class="sc-kbd">0</kbd></span></div>
    <div class="sc-help-row"><span>সার্চ-বক্সে ফোকাস</span><span class="keys"><kbd class="sc-kbd">/</kbd></span></div>
    <div class="sc-help-row"><span>সহায়িকা খুলুন/বন্ধ করুন</span><span class="keys"><kbd class="sc-kbd">?</kbd></span></div>
    <div class="sc-help-row"><span>কার্সর-সরান (সহায়িকা-খোলা-থাকলে আগে-বন্ধ)</span><span class="keys"><kbd class="sc-kbd">Esc</kbd></span></div>
    <div class="sc-help-row"><span>লেখা-বদলে রিফ্রেশ-আটকে-রাখা (অসংরক্ষিত-জবাব-সুরক্ষা)</span><span class="keys"><kbd class="sc-kbd">স্বয়ংক্রিয়</kbd></span></div>
    <button type="button" class="btn btn-primary btn-sm sc-help-close" id="scHelpClose">বন্ধ করুন</button>
  </div>
</div>

<div id="scToast" role="status" aria-live="polite"></div>
<script>
(function () {
  'use strict';
  var deskPath = '/admin/support-center' + location.search;
  var toastEl = document.getElementById('scToast');
  var toastTimer = null;
  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 2600);
  }
  function api(url, method, body) {
    return fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: body ? JSON.stringify(body) : undefined
    }).then(function (r) { return r.json().catch(function () { return { ok: false, error: 'রেসপন্স পার্স ব্যর্থ' }; }); });
  }
  var lastDeleted = null; // আনডু-উইন্ডো (কার্ড-প্রতি শেষ মুছে-ফেলা জবাব)

  // ── session228 — অসংরক্ষিত-জবাব সুরক্ষা (dirty-guard: লেখা-বদলে অটু-রিফ্রেশ/বন্ধ-আটকায়) ──
  var dirty = false;
  function markDirty() { dirty = true; window.__scQA = { dirty: true }; }
  function clearDirty() { dirty = false; window.__scQA = { dirty: false }; }
  clearDirty();
  document.addEventListener('input', function (e) {
    if (e.target.closest && e.target.closest('.sc-note-box, [data-heditbox]')) markDirty();
  });
  document.addEventListener('change', function (e) {
    if (e.target.closest && e.target.closest('.sc-actions select')) markDirty();
  });
  window.addEventListener('beforeunload', function (e) {
    if (!dirty) return;
    e.preventDefault(); e.returnValue = '';
  });
  function reloadSoon(ms) { clearDirty(); setTimeout(function () { location.reload(); }, ms || 0); }

  // ── টেমপ্লেট-বাটন ──
  document.querySelectorAll('.sc-tpl button').forEach(function (b) {
    b.addEventListener('click', function () {
      var box = b.closest('.sc-actions').querySelector('[data-sc-note]');
      box.value = b.getAttribute('data-tpl');
      box.focus();
    });
  });

  // ── সংরক্ষণ (স্ট্যাটাস + জবাব) ──
  document.querySelectorAll('[data-sc-save]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var card = btn.closest('.sc-card');
      var id = card.getAttribute('data-id');
      var status = card.querySelector('[data-sc-status]').value;
      var note = card.querySelector('[data-sc-note]').value.trim();
      btn.disabled = true;
      api('/admin/support-center/' + id, 'PUT', { status: status, adminNote: note }).then(function (res) {
        btn.disabled = false;
        if (res.ok) { toast(res.unchanged ? 'কোনো পরিবর্তন নেই' : 'সংরক্ষিত হয়েছে ✓'); reloadSoon(650); }
        else toast(res.error || 'সংরক্ষণ ব্যর্থ', 'error');
      }).catch(function () { btn.disabled = false; toast('নেটওয়ার্ক ব্যর্থ', 'error'); });
    });
  });

  // ── হিস্ট্রি: সম্পাদনা ──
  document.addEventListener('click', function (e) {
    var editBtn = e.target.closest('[data-hedit]');
    if (editBtn) {
      var row = editBtn.closest('.sc-hentry');
      var noteEl = row.querySelector('[data-hnote]');
      if (row.querySelector('[data-heditbox]')) return;
      var cur = noteEl.textContent;
      var box = document.createElement('div');
      box.setAttribute('data-heditbox', '1');
      box.style.cssText = 'display:flex;gap:6px;margin-top:4px';
      box.innerHTML = '<textarea style="flex:1;min-height:52px;font-family:inherit" maxlength="2000"></textarea>' +
        '<button type="button" class="btn btn-primary btn-sm">ঠিক</button><button type="button" class="btn btn-sm">বাতিল</button>';
      box.querySelector('textarea').value = cur;
      noteEl.style.display = 'none';
      noteEl.after(box);
      var btns = box.querySelectorAll('button');
      btns[0].addEventListener('click', function () {
        var nv = box.querySelector('textarea').value.trim();
        if (!nv) { toast('খালি জবাব রাখা যায় না'); return; }
        var card = row.closest('.sc-card');
        api('/admin/support-center/' + card.getAttribute('data-id') + '/history', 'PATCH',
          { index: parseInt(row.getAttribute('data-hidx'), 10), action: 'edit-note', note: nv }).then(function (res) {
          if (res.ok) { toast('জবাব সম্পাদিত ✓'); reloadSoon(600); }
          else toast(res.error || 'সম্পাদনা ব্যর্থ');
        });
      });
      btns[1].addEventListener('click', function () { box.remove(); noteEl.style.display = ''; });
      return;
    }
    // ── হিস্ট্রি: মুছে-ফেলা + আনডু ──
    var delBtn = e.target.closest('[data-hdel]');
    if (delBtn) {
      var drow = delBtn.closest('.sc-hentry');
      var dcard = delBtn.closest('.sc-card');
      var idx = parseInt(drow.getAttribute('data-hidx'), 10);
      var entry = null;
      try { entry = JSON.parse(decodeURIComponent(drow.getAttribute('data-entry') || 'null')); } catch (_) { entry = null; }
      if (!window.confirm('এই জবাবটি মুছে ফেলবেন? (ফেরত আনা যাবে)')) return;
      api('/admin/support-center/' + dcard.getAttribute('data-id') + '/history', 'PATCH', { index: idx, action: 'delete-note' }).then(function (res) {
        if (res.ok) {
          lastDeleted = { id: dcard.getAttribute('data-id'), index: idx, entry: entry };
          var undo = dcard.querySelector('[data-hundo]');
          if (undo && entry) { undo.style.display = ''; }
          toast('জবাব মুছে ফেলা হয়েছে — ৮ সেকেন্ডে ফেরাতে পারবেন');
          reloadSoon(8000);
        } else toast(res.error || 'মুছে ফেলা ব্যর্থ');
      });
      return;
    }
    var undoBtn = e.target.closest('[data-hundo-btn]');
    if (undoBtn && lastDeleted) {
      var ucard = undoBtn.closest('.sc-card');
      api('/admin/support-center/' + (lastDeleted.id || ucard.getAttribute('data-id')) + '/history', 'PATCH',
        { index: lastDeleted.index, action: 'restore-note', entry: lastDeleted.entry }).then(function (res) {
        if (res.ok) { toast('জবাব ফেরত আনা হয়েছে ✓'); reloadSoon(600); }
        else toast(res.error || 'ফেরত আনা ব্যর্থ');
      });
      return;
    }
  });

  // ── লাইভ: SSE (support-changed) + ৩০সে-পোল-ফলব্যাক ──
  var knownCounts = { PENDING: <%= counts.PENDING %>, IN_PROGRESS: <%= counts.IN_PROGRESS %>, RESOLVED: <%= counts.RESOLVED %> };
  var reloading = false;
  function maybeReload(reason) {
    if (reloading || document.hidden) return;
    reloading = true;
    toast((reason || 'হালনাগাদ') + ' — রিফ্রেশ হচ্ছে…');
    setTimeout(function () { reloadSoon(0); }, 900);
  }
  function pollCounts() {
    if (document.hidden || reloading) return;
    fetch('/admin/support-center/data' + location.search, { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.ok || reloading) return;
        ['PENDING', 'IN_PROGRESS', 'RESOLVED'].forEach(function (k) {
          if (d.counts[k] !== knownCounts[k]) maybeReload('নতুন অভিযোগ-কার্যক্রম');
        });
      }).catch(function () {});
  }
  try {
    var es = new EventSource('/api/events');
    es.addEventListener('open', function () {
      document.getElementById('scLive').classList.add('on');
      document.getElementById('scLiveTxt').textContent = 'লাইভ';
    });
    es.addEventListener('support-changed', function () { maybeReload('সাপোর্ট-হালনাগাদ'); });
    es.addEventListener('error', function () {
      document.getElementById('scLive').classList.remove('on');
      document.getElementById('scLiveTxt').textContent = 'পোলিং';
    });
  } catch (_) {}
  setInterval(pollCounts, 30000);

  // ── session228 — কীবোর্ড-দক্ষতা (Next-সেশন212-চুক্তি-পোর্ট: j/k কার্সর + 1/2/3/0 ভিউ + / সার্চ + ? সহায়িকা + Esc-স্তর) ──
  var scHelp = document.getElementById('scHelp');
  var scHelpPanel = document.getElementById('scHelpPanel');
  var scHelpClose = document.getElementById('scHelpClose');
  var helpPrevFocus = null;
  function helpOpen() {
    if (scHelp.classList.contains('open')) return;
    helpPrevFocus = document.activeElement;
    scHelp.hidden = false;
    scHelp.classList.add('open');
    scHelpPanel.focus();
  }
  function helpClose() {
    if (!scHelp.classList.contains('open')) return;
    scHelp.classList.remove('open');
    scHelp.hidden = true;
    if (helpPrevFocus && helpPrevFocus.focus) helpPrevFocus.focus();
  }
  scHelpClose.addEventListener('click', helpClose);
  scHelp.addEventListener('click', function (e) { if (e.target === scHelp) helpClose(); });
  var scHelpBtn = document.getElementById('scHelpBtn');
  if (scHelpBtn) scHelpBtn.addEventListener('click', function () {
    if (scHelp.classList.contains('open')) helpClose(); else helpOpen();
  });

  var cards = Array.prototype.slice.call(document.querySelectorAll('.sc-card'));
  var cursor = -1;
  function cursorClear() {
    if (cursor < 0 || !cards[cursor]) { cursor = -1; return; }
    cards[cursor].classList.remove('sc-cursor');
    cards[cursor].removeAttribute('aria-current');
    cursor = -1;
  }
  function cursorMove(delta) {
    if (!cards.length) return;
    var next = Math.min(cards.length - 1, Math.max(0, cursor + delta));
    if (cursor === next && cursor >= 0) return;
    if (cursor >= 0 && cards[cursor]) {
      cards[cursor].classList.remove('sc-cursor');
      cards[cursor].removeAttribute('aria-current');
    }
    cursor = next;
    cards[cursor].classList.add('sc-cursor');
    cards[cursor].setAttribute('aria-current', 'true');
    cards[cursor].scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
  function statusJump(st) {
    var sp = new URLSearchParams(location.search);
    var parts = [];
    if (st) parts.push('status=' + st);
    if (sp.get('media')) parts.push('media=' + sp.get('media'));
    if (sp.get('q')) parts.push('q=' + encodeURIComponent(sp.get('q')));
    if (sp.get('range')) parts.push('range=' + sp.get('range'));
    location.href = '/admin/support-center?' + parts.filter(Boolean).join('&');
  }
  document.addEventListener('keydown', function (e) {
    var t = e.target;
    var typing = t && ((t.closest && t.closest('input, textarea, select')) || t.isContentEditable);
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === 'Escape' || e.key === 'Esc') {
      if (scHelp.classList.contains('open')) { helpClose(); return; }
      if (typing) return;
      if (cursor >= 0) { cursorClear(); return; }
      return;
    }
    if (typing) return;
    if (e.key === '?' || (e.key === '/' && e.shiftKey)) {
      e.preventDefault();
      if (scHelp.classList.contains('open')) helpClose(); else helpOpen();
      return;
    }
    if (e.key === 'j' || e.key === 'J') { e.preventDefault(); cursorMove(1); return; }
    if (e.key === 'k' || e.key === 'K') { e.preventDefault(); cursorMove(-1); return; }
    if (e.key === '/') { e.preventDefault(); var si = document.querySelector('.sc-search input'); if (si) si.focus(); return; }
    if (e.key === '1') { statusJump('PENDING'); return; }
    if (e.key === '2') { statusJump('IN_PROGRESS'); return; }
    if (e.key === '3') { statusJump('RESOLVED'); return; }
    if (e.key === '0') { statusJump(''); return; }
  });
})();
</script>
</body>
</html>
