<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>কমিটি সদস্য</h1>
    <p><%= members.length %> জন সদস্য |
      <a href="/admin/members/new">+ নতুন সদস্য</a> |
      <a href="/admin/members/import"><i class="fas fa-upload"></i> বাল্ক ইমপোর্ট</a> |
      <a href="/admin/members/export.csv"><i class="fas fa-download"></i> এক্সপোর্ট</a>
    </p>
  </div>

  <form method="POST" action="/admin/members/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড আইটেমগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
  </form>
  <% if (members.length === 0) { %>
    <div class="card empty">কোনো সদস্য নেই</div>
  <% } else { %>
  <table>
    <thead><tr><th style="width:34px;"><input type="checkbox" data-bulk-all aria-label="সব সিলেক্ট করুন"></th><th>মেম্বার আইডি</th><th>নাম</th><th>পদ</th><th>ডিপার্টমেন্ট</th><th>কার্যবর্ষ</th><th>ধরন</th><th>স্ট্যাটাস</th><th>কার্যক্রম</th></tr></thead>
    <tbody>
      <% members.forEach(m => { %>
        <tr>
          <td style="width:34px;"><input type="checkbox" name="bulk_ids" value="<%= m.id %>" aria-label="সিলেক্ট"></td>
          <td><code><%= m.member_id || '—' %></code></td>
          <td><strong><%= m.name %></strong></td>
          <td><%= m.role || '—' %></td>
          <td><%= m.department || '—' %></td>
          <td><%= m.term_year || '—' %></td>
          <td><%= m.member_type === 'central' ? 'কেন্দ্রীয়' : m.member_type === 'advisory' ? 'উপদেষ্টা' : m.member_type === 'permanent' ? 'স্থায়ী পরিষদ' : m.member_type === 'founder' ? 'প্রতিষ্ঠাতা' : 'বিশ্ববিদ্যালয়' %></td>
          <td>
            <% const st = m.account_status || (m.user_id ? 'active' : 'unclaimed'); %>
            <span class="badge badge-<%= st === 'active' ? 'success' : st === 'pending' ? 'info' : st === 'suspended' ? 'danger' : 'warn' %>">
              <%= st === 'active' ? 'অ্যাক্টিভ' : st === 'pending' ? 'পেন্ডিং' : st === 'suspended' ? 'স্থগিত' : 'আনক্লেইমড' %>
            </span>
          </td>
          <td>
            <a href="/admin/members/<%= m.id %>/edit" class="btn btn-primary btn-sm">সম্পাদনা</a>
            <% if (st === 'suspended') { %>
              <form method="POST" action="/admin/members/<%= m.id %>/restore" style="display:inline;">
                <button class="btn btn-sm" title="পুনঃসক্রিয়"><i class="fas fa-rotate-left"></i> পুনঃসক্রিয়</button>
              </form>
            <% } else { %>
              <form method="POST" action="/admin/members/<%= m.id %>/suspend" style="display:inline;" onsubmit="return confirm('এই সদস্যের অ্যাকাউন্ট স্থগিত করবেন?');">
                <button class="btn btn-sm" title="স্থগিত"><i class="fas fa-pause"></i> স্থগিত</button>
              </form>
            <% } %>
            <form method="POST" action="/admin/members/<%= m.id %>?_method=DELETE" style="display:inline;">
              <button class="btn btn-danger btn-sm">মুছুন</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
</body>
</html>
