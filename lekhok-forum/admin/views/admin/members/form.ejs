<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><%= member ? 'সদস্য সম্পাদনা' : 'নতুন সদস্য' %></h1>
    <p><a href="/admin/members">← সদস্য তালিকায় ফিরে যান</a></p>
  </div>
  <div class="card">
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="<%= member ? '/admin/members/' + member.id + '?_method=PUT' : '/admin/members' %>">
      <div class="form-group"><label>নাম *</label><input type="text" name="name" value="<%= member ? member.name : '' %>" required></div>
      <%# টাস্ক ১৪: মেম্বার আইডি — নতুন হলে ঐচ্ছিক (খালি = অটো-জেনারেট), এডিটে অপরিবর্তনীয় %>
      <div class="form-group">
        <label>মেম্বার আইডি</label>
        <% if (member && member.member_id) { %>
          <input type="text" value="<%= member.member_id %>" readonly disabled>
          <small style="color:#64748b">মেম্বার আইডি স্থায়ী — পরিবর্তনযোগ্য নয়।</small>
        <% } else { %>
          <input type="text" name="member_id" value="<%= (member && member.member_id) ? member.member_id : (typeof suggestedMemberId !== 'undefined' ? suggestedMemberId : '') %>" placeholder="MEM-XXXXX">
          <small style="color:#64748b">সাজেস্টেড আইডি আগে থেকে বসানো আছে — ইচ্ছে করলে বদলে নিন; খালি রাখলে স্বয়ংক্রিয়ভাবে পরবর্তী ইউনিক আইডি তৈরি হবে।</small>
        <% } %>
      </div>
      <div class="form-group"><label>পদ</label><input type="text" name="role" value="<%= member ? (member.role || '') : '' %>" placeholder="যেমন: সভাপতি"></div>
      <div class="form-group"><label>পদবি</label><input type="text" name="designation" value="<%= member ? (member.designation || '') : '' %>" placeholder="যেমন: কেন্দ্রীয় কমিটি"></div>
      <div class="form-group"><label>ডিপার্টমেন্ট</label><input type="text" name="department" value="<%= member ? (member.department || '') : '' %>" placeholder="যেমন: বাংলা বিভাগ"></div>
      <div class="form-group"><label>বায়ো</label><textarea name="bio" rows="3"><%= member ? (member.bio || '') : '' %></textarea></div>
      <div class="form-group"><label>বাণী (message/quote)</label><textarea name="message" rows="3" placeholder="কার্ডে দেখানো সংক্ষিপ্ত বাণী — খালি রাখলে বায়ো দেখাবে"><%= member ? (member.message || '') : '' %></textarea></div>
      <div class="form-group">
        <label>ছবির URL</label>
        <input type="url" name="image_url" value="<%= member ? (member.image_url || '') : '' %>" placeholder="https://… (না দিলে প্লেসহোল্ডার অবতার)">
        <small style="color:#64748b">সদস্যের ছবির সরাসরি লিংক — কমিটি/হোম-পেজের নেতৃত্ব কার্ডে দেখাবে। সিডি-র ইউআরএল দিলে ডান পাশের আপলোড বোতামে সরাসরি ছবি বসানো যায়।</small>
      </div>
      <div class="form-group">
        <label>আইডির ইউয়ারএল (প্রোফাইল লিংক)</label>
        <input type="url" name="profile_url" value="<%= member ? (member.profile_url || '') : '' %>" placeholder="যেমন: https://facebook.com/… বা /profile/username">
        <small style="color:#64748b">হোম-পেজের নেতৃত্ব কার্ডে ক্লিক/আইডি-আইকনে এই লিংক খোলে। ফেসবুক প্রোফাইল বা সাইটের প্রোফাইল — যেকোনো লিংক দেওয়া যায়; অ্যাকাউন্ট লিংক করা থাকলে খালি রাখলেও সাইট-প্রোফাইলে যাবে।</small>
      </div>
      <div class="form-group">
        <label>সদস্যের অ্যাকাউন্ট লিংক</label>
        <%# সেশন ৪০: নাম/ইউজারনেম/আইডি দিয়ে খুঁজে নির্দিষ্ট ইউজার লিংক করার সার্চ-ফিল্টার %>
        <input type="search" id="userLinkSearch" placeholder="নাম / ইউজারনেম / আইডি লিখে খুঁজুন…" autocomplete="off" style="margin-bottom:8px;" />
        <select name="user_id" id="userLinkSelect" size="6" style="min-height:120px;">
          <option value="">— লিংক নেই —</option>
          <% (allUsers || []).forEach(u => { %>
            <option value="<%= u.id %>" <%= member && member.user_id == u.id ? 'selected' : '' %>>
              <%= u.full_name %> (<%= u.username %>)
            </option>
          <% }); %>
        </select>
        <small style="color:#64748b">এই সদস্য যদি নিবন্ধিত ইউজার হয়, তাহলে তার প্রোফাইল ছবি ও নাম সব জায়গায় ব্যবহার হবে। সার্চ বক্সে লিখলে তালিকা ফিল্টার হবে; আইডি জানা থাকলে সরাসরি লিখে এন্টার চাপুন।</small>
      </div>
      <script>
      (function () {
        var q = document.getElementById('userLinkSearch');
        var sel = document.getElementById('userLinkSelect');
        if (!q || !sel) return;
        var opts = Array.prototype.slice.call(sel.options);
        q.addEventListener('input', function () {
          var v = q.value.trim().toLowerCase();
          var shown = 0;
          opts.forEach(function (o) {
            var hit = !v || o.textContent.toLowerCase().indexOf(v) !== -1 || o.value === v;
            o.hidden = !hit;
            if (hit) shown++;
          });
          if (shown === 1) {
            var one = opts.filter(function (o) { return !o.hidden && o.value; })[0];
            if (one) sel.value = one.value;
          }
        });
        q.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            var exact = opts.filter(function (o) { return o.value === q.value.trim(); })[0];
            if (exact) { sel.value = exact.value; q.value = ''; q.dispatchEvent(new Event('input')); }
          }
        });
      })();
      </script>
      <div class="form-group"><label>ফেসবুক</label><input type="url" name="social_fb" value="<%= member ? (member.social_fb || '') : '' %>"></div>
      <div class="form-group"><label>LinkedIn</label><input type="url" name="social_linkedin" value="<%= member ? (member.social_linkedin || '') : '' %>"></div>
      <div class="form-group"><label>ইমেইল</label><input type="email" name="social_email" value="<%= member ? (member.social_email || '') : '' %>"></div>
      <div class="form-group">
        <label>ধরন</label>
        <select name="member_type">
          <option value="central"  <%= member && member.member_type === 'central'  ? 'selected' : '' %>>কেন্দ্রীয় কমিটি</option>
          <option value="advisory" <%= member && member.member_type === 'advisory' ? 'selected' : '' %>>উপদেষ্টা পরিষদ</option>
          <option value="founder"  <%= member && member.member_type === 'founder'  ? 'selected' : '' %>>প্রতিষ্ঠাতা সদস্য</option>
          <option value="branch"   <%= member && member.member_type === 'branch'   ? 'selected' : '' %>>বিশ্ববিদ্যালয় শাখা</option>
          <option value="permanent" <%= member && member.member_type === 'permanent' ? 'selected' : '' %>>স্থায়ী পরিষদ</option>
        </select>
        <small style="color:#64748b">হোম-পেজের ৮টি নেতৃত্ব কার্ড এখান থেকেই তৈরি: “প্রতিষ্ঠাতা সদস্য” ২টি + “উপদেষ্টা পরিষদ” ৪টি (পুরনো ২ + বর্তমান ২) + সর্বশেষ কার্যবর্ষের কেন্দ্রীয় “সভাপতি” ও “সাধারণ সম্পাদক” ২টি। প্রতিটি কার্ডে উপরের ছবির URL ও আইডির ইউয়ারএল কাজ করে।</small>
      </div>
      <div class="form-group">
        <label>কার্যবর্ষ</label>
        <input type="text" name="term_year" list="termYears" value="<%= member ? (member.term_year || '') : '' %>" placeholder="যেমন: ২০২৪-২৫">
        <datalist id="termYears">
          <option value="২০২৫-২৬"><option value="২০২৪-২৫"><option value="২০২৩-২৪">
          <option value="২০২২-২৩"><option value="২০২১-২২"><option value="২০২০-২১"><option value="২০১৯-২০">
        </datalist>
        <small style="color:#64748b">কমিটি পেইজের কার্যবর্ষ ফিল্টারে দেখাতে এটা দিন (যেমন: ২০১৯-২০)।</small>
      </div>
      <div class="form-group"><label>ক্রম (sort order)</label><input type="number" name="sort_order" value="<%= member ? member.sort_order : 0 %>"></div>
      <button type="submit" class="btn btn-primary"><%= member ? 'আপডেট' : 'তৈরি করুন' %></button>
    </form>
  </div>
</div>
</body>
</html>
