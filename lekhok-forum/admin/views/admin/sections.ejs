<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>সেকশন আইটেম | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
  <style>
    .sec-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
    .sec-tab { padding: 8px 14px; border: 1px solid #d1d5db; border-radius: 5px; font-size: .85rem; font-weight: 600; color: #374151; text-decoration: none; background: #fff; }
    .sec-tab.active { background: #059669; border-color: #059669; color: #fff; }
    .sec-item { border: 1px solid #e5e7eb; border-radius: 5px; margin-bottom: 10px; background: #fff; }
    .sec-item summary { display: flex; align-items: center; gap: 10px; padding: 12px 14px; cursor: pointer; list-style: none; }
    .sec-item summary::-webkit-details-marker { display: none; }
    .sec-item .ord { font-size: .75rem; color: #6b7280; min-width: 30px; }
    .sec-item .ttl { font-weight: 700; flex: 1; }
    .sec-item .off { opacity: .5; }
    .sec-body { padding: 0 14px 14px; border-top: 1px dashed #e5e7eb; }
    .sec-body label { display: block; font-size: .8rem; font-weight: 600; margin: 10px 0 4px; color: #374151; }
    .sec-body input[type=text], .sec-body textarea { width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 5px; font-family: inherit; font-size: .9rem; }
    .mini-btn { border: 1px solid #d1d5db; background: #f9fafb; border-radius: 5px; padding: 5px 10px; font-size: .78rem; cursor: pointer; font-family: inherit; }
    .mini-btn:hover { background: #e5e7eb; }
    .mini-btn:disabled { opacity: .55; cursor: wait; }
    .sec-item[draggable="true"] { cursor: grab; }
    .sec-item.drag-over { outline: 2px dashed #059669; outline-offset: 2px; }
    .sec-prev-img { width: 34px; height: 34px; object-fit: cover; border-radius: 5px; border: 1px solid #e5e7eb; }
    .sec-img-prev { max-width: 120px; max-height: 80px; border-radius: 5px; border: 1px solid #e5e7eb; margin-top: 8px; display: block; }
    .sec-toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); z-index: 200; display: flex; align-items: center; gap: 10px; background: #065f46; color: #fff; padding: 11px 16px; border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.22); font-size: .86rem; }
    .sec-toast.err { background: #991b1b; }
    .sec-toast button { background: rgba(255,255,255,.18); border: none; color: #fff; border-radius: 4px; padding: 5px 10px; font-size: .78rem; font-weight: 700; cursor: pointer; }
  </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1><i class="fas fa-layer-group"></i> সেকশন আইটেম ম্যানেজার</h1>
      <p class="subtitle">সাইটের পাবলিক সেকশনগুলোর আইটেম/কার্ড যোগ, সম্পাদনা, লুকানো, সাজানো ও বাদ দেওয়া — প্রতিটি সেভ পেজ রিলোড ছাড়াই সংরক্ষিত হয়</p>
    </div>
  </div>

  <div class="sec-tabs">
    <% Object.keys(SECTIONS).forEach(k => { %>
    <a class="sec-tab <%= k === active ? 'active' : '' %>" href="?section=<%= k %>"><%= SECTIONS[k].label %></a>
    <% }); %>
  </div>

  <%- include('partials/sections-list', { rows: rows, active: active, SECTIONS: SECTIONS, BASE: (typeof moderatorView !== 'undefined' && moderatorView) ? '/moderator' : '/admin' }) %>
</div>
<script>
(function () {
  'use strict';
  var BASE = '<%= (typeof moderatorView !== 'undefined' && moderatorView) ? '/moderator' : '/admin' %>';
  var ACTIVE = '<%= active %>';
  var csrf = function () { var m = document.querySelector('meta[name="csrf-token"]'); return m ? m.content : ''; };

  function toast(html, isErr) {
    var t = document.createElement('div');
    t.className = 'sec-toast' + (isErr ? ' err' : '');
    t.innerHTML = html;
    document.body.appendChild(t);
    setTimeout(function () { t.style.opacity = '0'; t.style.transition = 'opacity .3s'; }, 9000);
    setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 9500);
    return t;
  }

  function reRenderList(section) {
    return fetch(BASE + '/sections?section=' + encodeURIComponent(section) + '&partial=1', { headers: { 'Accept': 'text/html' } })
      .then(function (r) { if (!r.ok) throw new Error('রিফ্রেশ ব্যর্থ'); return r.text(); })
      .then(function (html) {
        var list = document.getElementById('secList');
        if (list) list.outerHTML = html;
        initList();
      });
  }

  // ── ছবি আপলোড + প্রিভিউ ──
  function bindImages(scope) {
    scope.querySelectorAll('.sec-img-file').forEach(function (file) {
      file.addEventListener('change', function () {
        if (!file.files || !file.files[0]) return;
        var fd = new FormData(); fd.append('image', file.files[0]);
        fetch('/admin/upload-image', { method: 'POST', body: fd, headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf() } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var urlInp = file.closest('div').parentElement.querySelector('.sec-img-url');
            var prev = file.closest('div').parentElement.querySelector('.sec-img-prev');
            if (d && d.ok) { if (urlInp) urlInp.value = d.url; if (prev) { prev.src = d.url; prev.style.display = 'block'; } }
            else toast('<i class="fas fa-exclamation-triangle"></i> ' + ((d && d.error) || 'আপলোড ব্যর্থ'), true);
          })
          .catch(function () { toast('<i class="fas fa-exclamation-triangle"></i> আপলোড ব্যর্থ', true); });
      });
    });
    scope.querySelectorAll('.sec-img-url').forEach(function (inp) {
      inp.addEventListener('input', function () {
        var prev = inp.closest('div').parentElement.querySelector('.sec-img-prev');
        if (prev) { prev.src = inp.value || ''; prev.style.display = inp.value ? 'block' : 'none'; }
      });
    });
  }

  // ── AJAX ফর্ম সাবমিট (সেভ/অ্যাড/টগল/মুভ/ডিলিট) ──
  function bindForms(scope) {
    scope.querySelectorAll('form.sec-ajax').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = form.querySelector('button[type=submit]');
        if (btn && btn.disabled) return;
        var data = new URLSearchParams(new FormData(form));
        data.set('_csrf', csrf()); data.set('_ajax', '1');
        if (btn) { btn.disabled = true; var old = btn.innerHTML; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }
        fetch(form.getAttribute('action'), { method: 'POST', body: data, headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'অপ্রত্যাশিত রেসপন্স' }; }); })
          .then(function (d) {
            if (btn) { btn.disabled = false; btn.innerHTML = old; }
            if (!d || !d.ok) throw new Error((d && d.error) || 'কাজটি ব্যর্থ হয়েছে');
            return d;
          })
          .then(function (d) {
            if (d.action === 'save' && d.id) {
              // সেভ সফল — আন্ডু টোস্ট + লিস্ট রিফ্রেশ
              var t = toast('<i class="fas fa-check-circle"></i> সংরক্ষিত হয়েছে। <button type="button" id="secUndoBtn"><i class="fas fa-undo"></i> আন্ডু</button>');
              var ub = t.querySelector('#secUndoBtn');
              if (ub) ub.addEventListener('click', function () {
                var fd = new URLSearchParams(); fd.set('_csrf', csrf()); fd.set('_ajax', '1');
                fetch(BASE + '/sections/' + d.id + '/undo', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } })
                  .then(function () { reRenderList(d.section || ACTIVE); });
                if (t.parentNode) t.parentNode.removeChild(t);
              });
            } else if (d.action === 'delete') {
              toast('<i class="fas fa-trash"></i> আইটেমটি ট্র্যাশে সরানো হয়েছে।');
            } else if (d.action === 'add') {
              toast('<i class="fas fa-plus"></i> নতুন আইটেম যোগ হয়েছে।');
            } else if (d.action === 'toggle') {
              toast('<i class="fas fa-eye"></i> দৃশ্যমানতা পরিবর্তিত হয়েছে।');
            }
            return reRenderList(d.section || ACTIVE);
          })
          .catch(function (err) {
            if (btn) { btn.disabled = false; btn.innerHTML = old; }
            toast('<i class="fas fa-exclamation-triangle"></i> ' + (err.message || 'কাজটি ব্যর্থ হয়েছে'), true);
          });
      });
    });
  }

  // ── ড্র্যাগ-রিঅর্ডার ──
  function bindDrag(scope) {
    var dragEl = null;
    scope.querySelectorAll('.sec-item[draggable="true"]').forEach(function (el) {
      el.addEventListener('dragstart', function () { dragEl = el; });
      el.addEventListener('dragover', function (e) { e.preventDefault(); if (dragEl && dragEl !== el) el.classList.add('drag-over'); });
      el.addEventListener('dragleave', function () { el.classList.remove('drag-over'); });
      el.addEventListener('drop', function (e) {
        e.preventDefault(); el.classList.remove('drag-over');
        if (!dragEl || dragEl === el) return;
        el.parentNode.insertBefore(dragEl, el);
        var ids = Array.prototype.map.call(scope.querySelectorAll('.sec-item[data-sec-id]'), function (x) { return x.getAttribute('data-sec-id'); });
        var fd = new URLSearchParams();
        fd.set('section', ACTIVE);
        ids.forEach(function (id) { fd.append('ids', id); });
        fd.set('_csrf', csrf()); fd.set('_ajax', '1');
        fetch(BASE + '/sections/reorder', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
          .then(function (d) {
            if (d && d.ok) toast('<i class="fas fa-arrows-alt-v"></i> ক্রম সংরক্ষিত হয়েছে।');
            else toast('<i class="fas fa-exclamation-triangle"></i> ক্রম সংরক্ষণ ব্যর্থ', true);
          })
          .catch(function () { toast('<i class="fas fa-exclamation-triangle"></i> ক্রম সংরক্ষণ ব্যর্থ', true); });
      });
    });
  }

  function initList() {
    var list = document.getElementById('secList');
    if (!list) return;
    bindImages(list); bindForms(list); bindDrag(list);
  }

  initList();
})();
</script>
</body>
</html>
