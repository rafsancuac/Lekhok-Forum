<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>সেকশন আইটেম | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" /><%# session136: টোকেন-রেজোলিউশন (var(--lf-*) admin.css) %>
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>">
  <style>
    .sec-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
    .sec-tab { padding: 8px 14px; border: 1px solid #d1d5db; border-radius: 5px; font-size: .85rem; font-weight: 600; color: #374151; text-decoration: none; background: #fff; }
    .sec-tab.active { background: #059669; border-color: #059669; color: #fff; }
    .sec-item { border: 1px solid #e5e7eb; border-radius: 5px; margin-bottom: 10px; background: #fff; }
    .sec-item summary { display: flex; align-items: center; gap: 10px; padding: 12px 14px; cursor: pointer; list-style: none; }
    .sec-item summary::-webkit-details-marker { display: none; }
    .sec-item .ord { font-size: .75rem; color: #6b7280; min-width: 30px; }
    .sec-item .ttl { font-weight: 700; flex: 1; }
    .sec-item .off { opacity: .5; }
    .sec-body { padding: 0 14px 14px; border-top: 1px dashed #e5e7eb; }
    .sec-body label { display: block; font-size: .8rem; font-weight: 600; margin: 10px 0 4px; color: #374151; }
    .sec-body input[type=text], .sec-body textarea { width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 5px; font-family: inherit; font-size: .9rem; }
    .mini-btn { border: 1px solid #d1d5db; background: #f9fafb; border-radius: 5px; padding: 5px 10px; font-size: .78rem; cursor: pointer; font-family: inherit; }
    .mini-btn:hover { background: #e5e7eb; }
    .mini-btn:disabled { opacity: .55; cursor: wait; }
    .sec-item[draggable="true"] { cursor: grab; }
    .sec-item.drag-over { outline: 2px dashed #059669; outline-offset: 2px; }
    .sec-prev-img { width: 34px; height: 34px; object-fit: cover; border-radius: 5px; border: 1px solid #e5e7eb; }
    .sec-img-prev { max-width: 120px; max-height: 80px; border-radius: 5px; border: 1px solid #e5e7eb; margin-top: 8px; display: block; }
    .sec-toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); z-index: 200; display: flex; align-items: center; gap: 10px; background: #065f46; color: #fff; padding: 11px 16px; border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.22); font-size: .86rem; }
    .sec-toast.err { background: #991b1b; }
    .sec-toast button { background: rgba(255,255,255,.18); border: none; color: #fff; border-radius: 4px; padding: 5px 10px; font-size: .78rem; font-weight: 700; cursor: pointer; }
    /* session298 — lsf298 তাৎক্ষণিক-ফিল্টার স্টাইল (cej294-প্যাটার্ন-মিরর — হেক্স-শূন্য টোকেন-শুধু; brandgreen-পরিবার) */
    .lsf298-instant { position: relative; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 14px; padding: 10px 14px; border: 1px solid var(--lf-fb-border); border-radius: 14px; background: var(--lf-white); transition: border-color .15s, box-shadow .15s; }
    .lsf298-instant:hover { border-color: color-mix(in srgb, var(--lf-brandgreen-deep) 35%, transparent); box-shadow: 0 2px 10px color-mix(in srgb, var(--lf-slate) 8%, transparent); }
    .lsf298-ico { color: var(--lf-brandgreen-deep); opacity: .75; }
    .lsf298-input { flex: 1 1 240px; min-width: 0; border: 1px solid transparent; border-radius: 10px; padding: 8px 12px; font: inherit; color: var(--lf-slate); background: var(--lf-brandgreen-soft); }
    .lsf298-input:focus { outline: none; border-color: color-mix(in srgb, var(--lf-brandgreen-deep) 45%, transparent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--lf-brandgreen-deep) 15%, transparent); }
    .lsf298-clear { border: 0; background: transparent; color: var(--lf-brandgreen-deep); cursor: pointer; padding: 6px 9px; border-radius: 9px; transition: background .12s, transform .12s; }
    .lsf298-clear:hover { background: var(--lf-brandgreen-soft); }
    .lsf298-clear:active { transform: scale(.96); }
    .lsf298-count-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: .82rem; font-weight: 600; color: var(--lf-brandgreen-deep); background: var(--lf-brandgreen-soft); }
    .lsf298-kbd-hint { display: inline-flex; align-items: center; gap: 5px; font-size: .78rem; color: var(--lf-slate); }
    .lsf298-kbd-hint kbd { padding: 2px 7px; border: 1px dashed color-mix(in srgb, var(--lf-brandgreen-deep) 55%, transparent); border-radius: 7px; font: inherit; font-size: .74rem; color: var(--lf-brandgreen-deep); background: var(--lf-white); }
    .lsf298-zero { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; padding: 14px 16px; border: 1px dashed color-mix(in srgb, var(--lf-brandgreen-deep) 35%, transparent); border-radius: 12px; color: var(--lf-slate); background: var(--lf-brandgreen-soft); }
    .lsf298-count-chip[hidden], .lsf298-zero[hidden], .lsf298-clear[hidden] { display: none; }
    .sec-item[hidden] { display: none !important; }
    .sec-item.lsf298-flash { outline: 2px solid color-mix(in srgb, var(--lf-brandgreen) 55%, transparent); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { .lsf298-clear:active { transform: none; } .lsf298-instant { transition: none; } }
    @media (max-width: 640px) { .lsf298-kbd-hint { display: none; } .lsf298-instant { padding: 9px 11px; } }
  </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1><i class="fas fa-layer-group"></i> সেকশন আইটেম ম্যানেজার</h1>
      <p class="subtitle">সাইটের পাবলিক সেকশনগুলোর আইটেম/কার্ড যোগ, সম্পাদনা, লুকানো, সাজানো ও বাদ দেওয়া — প্রতিটি সেভ পেজ রিলোড ছাড়াই সংরক্ষিত হয়</p>
    </div>
  </div>

  <div class="sec-tabs">
    <% Object.keys(SECTIONS).forEach(k => { %>
    <a class="sec-tab <%= k === active ? 'active' : '' %>" href="?section=<%= k %>"><%= SECTIONS[k].label %></a>
    <% }); %>
  </div>

  <!-- session298: lsf298 তাৎক্ষণিক-ফিল্টার (mo268/sb269/dcf293/cej294-পরিবার; form-বহির্ভূত; রানটাইম-ইনডেক্স) -->
  <div class="lsf298-instant" id="lsfStrip298">
    <i class="fas fa-filter lsf298-ico" aria-hidden="true"></i>
    <input type="text" id="lsfInput298" class="lsf298-input" placeholder="আইটেম খুঁজুন — শিরোনাম / বিবরণ / #আইডি…" aria-label="সেকশন আইটেম ফিল্টার করুন" autocomplete="off">
    <button type="button" id="lsfClear298" class="lsf298-clear" hidden aria-label="ফিল্টার পরিষ্কার"><i class="fas fa-xmark"></i></button>
    <span class="lsf298-count-chip" id="lsfCount298" hidden><i class="fas fa-list-ul" aria-hidden="true"></i> <span id="lsfCountTxt298">০ / ০</span></span>
    <span class="lsf298-kbd-hint"><kbd>F</kbd> খুঁজুন · <kbd>Enter</kbd> প্রথম-মিল · <kbd>Esc</kbd> পরিষ্কার</span>
  </div>
  <div class="lsf298-zero" id="lsfZero298" hidden><i class="fas fa-magnifying-glass-minus" aria-hidden="true"></i> কোনো আইটেম মেলে-না — অন্য কীওয়ার্ড দিন</div>

  <%- include('partials/sections-list', { rows: rows, active: active, SECTIONS: SECTIONS, BASE: (typeof moderatorView !== 'undefined' && moderatorView) ? '/moderator' : '/admin' }) %>
</div>
<script>
(function () {
  'use strict';
  var BASE = '<%= (typeof moderatorView !== 'undefined' && moderatorView) ? '/moderator' : '/admin' %>';
  var ACTIVE = '<%= active %>';
  var csrf = function () { var m = document.querySelector('meta[name="csrf-token"]'); return m ? m.content : ''; };

  function toast(html, isErr) {
    var t = document.createElement('div');
    t.className = 'sec-toast' + (isErr ? ' err' : '');
    t.innerHTML = html;
    document.body.appendChild(t);
    setTimeout(function () { t.style.opacity = '0'; t.style.transition = 'opacity .3s'; }, 9000);
    setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 9500);
    return t;
  }

  function reRenderList(section) {
    return fetch(BASE + '/sections?section=' + encodeURIComponent(section) + '&partial=1', { headers: { 'Accept': 'text/html' } })
      .then(function (r) { if (!r.ok) throw new Error('রিফ্রেশ ব্যর্থ'); return r.text(); })
      .then(function (html) {
        var list = document.getElementById('secList');
        if (list) list.outerHTML = html;
        initList();
      });
  }

  // ── ছবি আপলোড + প্রিভিউ ──
  function bindImages(scope) {
    scope.querySelectorAll('.sec-img-file').forEach(function (file) {
      file.addEventListener('change', function () {
        if (!file.files || !file.files[0]) return;
        var fd = new FormData(); fd.append('image', file.files[0]);
        fetch('/admin/upload-image', { method: 'POST', body: fd, headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf() } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var urlInp = file.closest('div').parentElement.querySelector('.sec-img-url');
            var prev = file.closest('div').parentElement.querySelector('.sec-img-prev');
            if (d && d.ok) { if (urlInp) urlInp.value = d.url; if (prev) { prev.src = d.url; prev.style.display = 'block'; } }
            else toast('<i class="fas fa-exclamation-triangle"></i> ' + ((d && d.error) || 'আপলোড ব্যর্থ'), true);
          })
          .catch(function () { toast('<i class="fas fa-exclamation-triangle"></i> আপলোড ব্যর্থ', true); });
      });
    });
    scope.querySelectorAll('.sec-img-url').forEach(function (inp) {
      inp.addEventListener('input', function () {
        var prev = inp.closest('div').parentElement.querySelector('.sec-img-prev');
        if (prev) { prev.src = inp.value || ''; prev.style.display = inp.value ? 'block' : 'none'; }
      });
    });
  }

  // ── AJAX ফর্ম সাবমিট (সেভ/অ্যাড/টগল/মুভ/ডিলিট) ──
  function bindForms(scope) {
    scope.querySelectorAll('form.sec-ajax').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = form.querySelector('button[type=submit]');
        if (btn && btn.disabled) return;
        var data = new URLSearchParams(new FormData(form));
        data.set('_csrf', csrf()); data.set('_ajax', '1');
        if (btn) { btn.disabled = true; var old = btn.innerHTML; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }
        fetch(form.getAttribute('action'), { method: 'POST', body: data, headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'অপ্রত্যাশিত রেসপন্স' }; }); })
          .then(function (d) {
            if (btn) { btn.disabled = false; btn.innerHTML = old; }
            if (!d || !d.ok) throw new Error((d && d.error) || 'কাজটি ব্যর্থ হয়েছে');
            return d;
          })
          .then(function (d) {
            if (d.action === 'save' && d.id) {
              // সেভ সফল — আন্ডু টোস্ট + লিস্ট রিফ্রেশ
              var t = toast('<i class="fas fa-check-circle"></i> সংরক্ষিত হয়েছে। <button type="button" id="secUndoBtn"><i class="fas fa-undo"></i> আন্ডু</button>');
              var ub = t.querySelector('#secUndoBtn');
              if (ub) ub.addEventListener('click', function () {
                var fd = new URLSearchParams(); fd.set('_csrf', csrf()); fd.set('_ajax', '1');
                fetch(BASE + '/sections/' + d.id + '/undo', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } })
                  .then(function () { reRenderList(d.section || ACTIVE); });
                if (t.parentNode) t.parentNode.removeChild(t);
              });
            } else if (d.action === 'delete') {
              toast('<i class="fas fa-trash"></i> আইটেমটি ট্র্যাশে সরানো হয়েছে।');
            } else if (d.action === 'add') {
              toast('<i class="fas fa-plus"></i> নতুন আইটেম যোগ হয়েছে।');
            } else if (d.action === 'toggle') {
              toast('<i class="fas fa-eye"></i> দৃশ্যমানতা পরিবর্তিত হয়েছে।');
            }
            return reRenderList(d.section || ACTIVE);
          })
          .catch(function (err) {
            if (btn) { btn.disabled = false; btn.innerHTML = old; }
            toast('<i class="fas fa-exclamation-triangle"></i> ' + (err.message || 'কাজটি ব্যর্থ হয়েছে'), true);
          });
      });
    });
  }

  // ── ড্র্যাগ-রিঅর্ডার ──
  function bindDrag(scope) {
    var dragEl = null;
    scope.querySelectorAll('.sec-item[draggable="true"]').forEach(function (el) {
      el.addEventListener('dragstart', function () { dragEl = el; });
      el.addEventListener('dragover', function (e) { e.preventDefault(); if (dragEl && dragEl !== el) el.classList.add('drag-over'); });
      el.addEventListener('dragleave', function () { el.classList.remove('drag-over'); });
      el.addEventListener('drop', function (e) {
        e.preventDefault(); el.classList.remove('drag-over');
        if (!dragEl || dragEl === el) return;
        el.parentNode.insertBefore(dragEl, el);
        var ids = Array.prototype.map.call(scope.querySelectorAll('.sec-item[data-sec-id]'), function (x) { return x.getAttribute('data-sec-id'); });
        var fd = new URLSearchParams();
        fd.set('section', ACTIVE);
        ids.forEach(function (id) { fd.append('ids', id); });
        fd.set('_csrf', csrf()); fd.set('_ajax', '1');
        fetch(BASE + '/sections/reorder', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
          .then(function (d) {
            if (d && d.ok) toast('<i class="fas fa-arrows-alt-v"></i> ক্রম সংরক্ষিত হয়েছে।');
            else toast('<i class="fas fa-exclamation-triangle"></i> ক্রম সংরক্ষণ ব্যর্থ', true);
          })
          .catch(function () { toast('<i class="fas fa-exclamation-triangle"></i> ক্রম সংরক্ষণ ব্যর্থ', true); });
      });
    });
  }

  function initList() {
    var list = document.getElementById('secList');
    if (!list) return;
    bindImages(list); bindForms(list); bindDrag(list);
  }

  initList();
})();
</script>
<script>
(function () {
  'use strict';
  /* session298 — lsf298 তাৎক্ষণিক-ফিল্টার (sections-সারফেস; রানটাইম-ইনডেক্স: প্রতি-apply-এ DOM-পুনঃস্ক্যান → AJAX-re-render/আন্ডু-পরেও নির্ভুল — পরিবার: mo268/sb269/dcf293/cej294;
     MutationObserver (childList+characterData-শুধু — attribute-ওয়াচ-শূন্য → নিজের-hidden-লেখায়-লুপ-ঝুঁকি-শূন্য);
     countTxt-লেখা change-guarded (characterData-মিউটেশন-স্টর্ম-প্রতিরোধ)) */
  if (window.__lsf298wired) return; window.__lsf298wired = true;
  var input = document.getElementById('lsfInput298');
  var clearBtn = document.getElementById('lsfClear298');
  var countChip = document.getElementById('lsfCount298');
  var countTxt = document.getElementById('lsfCountTxt298');
  var zeroBox = document.getElementById('lsfZero298');
  if (!input) return;
  var bn298 = function (n) { return String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[+d]; }); };
  var norm298 = function (s) { return (s || '').replace(/\s+/g, ' ').trim().toLowerCase(); };
  var last298 = [], total298 = 0;
  function lsfActive298() { return !!(input.value || '').trim(); }
  function rows298() { return Array.prototype.slice.call(document.querySelectorAll('.sec-item[data-sec-id][data-lsf-row298]')); }
  function lsfApply298() {
    var q = norm298(input.value);
    var act = lsfActive298();
    var all = rows298();
    total298 = all.length;
    last298 = [];
    all.forEach(function (el) {
      var kw = el.getAttribute('data-kw') || '';
      var live298 = '';
      var hit = !q || norm298(kw + live298).indexOf(q) !== -1;
      if (hit) { last298.push(el); el.setAttribute('data-lsf-hit298', '1'); } else { el.removeAttribute('data-lsf-hit298'); }
      if (act && !hit) { if (!el.hasAttribute('hidden')) el.setAttribute('hidden', ''); }
      else { if (el.hasAttribute('hidden')) el.removeAttribute('hidden'); }
    });
    if (countChip) { countChip.hidden = !act; }
    if (act && countTxt) { var nt = bn298(last298.length) + ' মিল · ' + bn298(total298) + ' আইটেম'; if (countTxt.textContent !== nt) countTxt.textContent = nt; }
    if (clearBtn) { clearBtn.hidden = !act; }
    if (zeroBox) { zeroBox.hidden = !(act && last298.length === 0); }
    return last298.length;
  }
  function lsfClear298() { input.value = ''; lsfApply298(); try { input.blur(); } catch (e) {} }
  function lsfJumpFirst298() {
    if (!last298.length) return 0;
    var el = last298[0];
    try { el.scrollIntoView({ block: 'center' }); } catch (e) {}
    el.classList.add('lsf298-flash');
    setTimeout(function () { el.classList.remove('lsf298-flash'); }, 1600);
    return 1;
  }
  input.addEventListener('input', lsfApply298);
  input.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') { ev.stopPropagation(); lsfClear298(); }
    if (ev.key === 'Enter') { ev.preventDefault(); lsfJumpFirst298(); }
  });
  if (clearBtn) { clearBtn.addEventListener('click', lsfClear298); }
  document.addEventListener('keydown', function (ev) {
    if (ev.key !== 'f' || ev.altKey || ev.ctrlKey || ev.metaKey) { return; }
    var t = ev.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) { return; }
    ev.preventDefault();
    input.focus();
    input.select();
  });
  var lsfTimer298 = null;
  var host298 = document.querySelector('.admin-main');
  if (host298 && window.MutationObserver) {
    new MutationObserver(function () {
      if (lsfTimer298) return;
      lsfTimer298 = setTimeout(function () { lsfTimer298 = null; if (lsfActive298()) lsfApply298(); }, 140);
    }).observe(host298, { childList: true, subtree: true, characterData: true });
  }
  window.__lsf298QA = {
    surface: 'sections',
    rows: function () { return rows298().length; },
    matches: function () { return last298.length; },
    total: function () { return total298; },
    active: lsfActive298,
    firstMatch: function () { return last298.length ? (last298[0].getAttribute('data-sec-id') || '') : null; },
    apply: lsfApply298,
    clear: lsfClear298,
    jumpFirst: lsfJumpFirst298
  };
})();
</script>
</body>
</html>
