<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>নিউজলেটার সাবস্ক্রাইবার — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><i class="fas fa-paper-plane"></i> নিউজলেটার সাবস্ক্রাইবার</h1>
    <p>ফুটার ফর্ম থেকে সাবস্ক্রাইব করা সদস্যদের তালিকা ও ইমেইল নোটিফিকেশনের রেকর্ড</p>
  </div>

  <div class="stat-grid">
    <div class="stat-box"><i class="fas fa-users"></i><div><strong><%= stats.total %></strong><span>মোট সাবস্ক্রাইবার</span></div></div>
    <div class="stat-box"><i class="fas fa-user-check"></i><div><strong><%= stats.active %></strong><span>সক্রিয়</span></div></div>
    <div class="stat-box"><i class="fas fa-paper-plane"></i><div><strong><%= stats.sent %></strong><span>ইমেইল পাঠানো</span></div></div>
    <div class="stat-box"><i class="fas fa-clock"></i><div><strong><%= stats.pending %></strong><span>কিউতে অপেক্ষমাণ</span></div></div>
  </div>

  <% if (!stats.mailConfigured) { %>
    <div class="card" style="border-left:4px solid #f59e0b; margin-bottom:16px;">
      <strong><i class="fas fa-triangle-exclamation"></i> ইমেইল সার্ভিস এখনো কনফিগার করা হয়নি</strong>
      <p style="margin:8px 0 0; color:#64748b; font-size:.9rem; line-height:1.7;">
        এডমিন/মডারেটর পোস্ট করলে নোটিফিকেশনগুলো <strong>কিউতে জমা হচ্ছে</strong> (উপরে "কিউতে অপেক্ষমাণ") — তালিকা হারাবে না।
        অটোমেটিক ইমেইল চালু করতে Vercel প্রজেক্টের Environment Variables-এ <code>RESEND_API_KEY</code> (resend.com থেকে ফ্রি) এবং
        ঐচ্ছিকভাবে <code>NEWSLETTER_FROM</code>, <code>SITE_URL</code> যোগ করুন। কী যোগের পর নিচের "আবার পাঠান" বাটনে কিউ থেকে পাঠানো যাবে।
      </p>
    </div>
  <% } else { %>
    <div class="card" style="border-left:4px solid #059669; margin-bottom:16px;">
      <strong><i class="fas fa-circle-check"></i> ইমেইল সার্ভিস সক্রিয়</strong>
      <p style="margin:6px 0 0; color:#64748b; font-size:.9rem;">এডমিন/মডারেটর নতুন লেখা বা বিজ্ঞপ্তি পোস্ট করার সাথে সাথেই সকল সক্রিয় সাবস্ক্রাইবার অটোমেটিক ইমেইল পাবেন।</p>
    </div>
  <% } %>

  <% const isAdmin = (typeof adminUser !== 'undefined' && adminUser) || (typeof user !== 'undefined' && user && user.role === 'admin'); %>

  <div class="admin-header" style="margin-top:8px;">
    <h2 style="font-size:1.15rem;">সাবস্ক্রাইবার তালিকা <span style="font-size:.8rem;color:#6b7280;">(মোট <%= total42 %> টি)</span></h2>
    <form method="GET" style="display:flex;gap:8px;align-items:center;">
      <input type="search" name="q" value="<%= q42 %>" placeholder="ইমেইল খুঁজুন…" style="padding:8px 12px;border:1px solid #d1d5db;border-radius:5px;font-family:inherit;">
      <button class="btn btn-sm" type="submit"><i class="fas fa-search"></i></button>
      <% if (q42) { %><a class="btn btn-sm" href="/admin/subscribers">রিসেট</a><% } %>
    </form>
    <span style="display:flex;gap:6px;align-items:center;font-size:.83rem;">
      <% if (page42 > 1) { %><a class="btn btn-sm" href="?page=<%= page42 - 1 %>">←</a><% } %>
      পেজ <%= page42 %>/<%= pages42 %>
      <% if (page42 < pages42) { %><a class="btn btn-sm" href="?page=<%= page42 + 1 %>">→</a><% } %>
    </span>
    <a class="btn btn-primary btn-sm" href="/admin/subscribers/export"><i class="fas fa-file-csv"></i> CSV ডাউনলোড</a>
  </div>
  <% if (subs.length === 0) { %>
    <div class="card empty">এখনো কোনো সাবস্ক্রাইবার নেই — ফুটারের নিউজলেটার ফর্মে সাবস্ক্রাইব করলে এখানে দেখা যাবে।</div>
  <% } else { %>
  <label style="font-size:.85rem;font-weight:600;color:#65676b;display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-bottom:8px;"><input type="checkbox" data-bulk-all style="width:16px;height:16px;"> সব সিলেক্ট</label>
  <form method="POST" action="/admin/subscribers/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড সাবস্ক্রাইবারগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
    <button type="submit" name="mode" value="publish" formaction="/admin/subscribers/bulk-toggle" class="btn btn-sm" data-bulk-msg="সিলেক্টেড সাবস্ক্রাইবারগুলো প্রকাশ করবে?"><i class="fas fa-eye"></i> প্রকাশ</button>
    <button type="submit" name="mode" value="hide" formaction="/admin/subscribers/bulk-toggle" class="btn btn-sm" data-bulk-msg="সিলেক্টেড সাবস্ক্রাইবারগুলো লুকাবে?"><i class="fas fa-eye-slash"></i> লুকান</button>
  </form>
  <table>
    <thead>
      <tr><th style="width:34px;"><input type="checkbox" data-bulk-all aria-label="সব সিলেক্ট"></th><th>#</th><th>ইমেইল</th><th>নাম</th><th>সাবস্ক্রিপশনের তারিখ</th><th>অবস্থা</th><th>অ্যাকশন</th></tr>
    </thead>
    <tbody>
      <% subs.forEach(s => { %>
        <tr>
          <td style="width:34px;"><input type="checkbox" name="bulk_ids" value="<%= s.id %>" aria-label="সিলেক্ট"></td>
          <td><%= s.id %></td>
          <td><strong><%= s.email %></strong></td>
          <td><%= s.name || '—' %></td>
          <td style="font-size:.85rem; color:#64748b;"><%= s.created_at ? new Date(String(s.created_at).replace(' ', 'T')).toLocaleString('bn-BD') : '—' %></td>
          <td>
            <% if (s.is_active) { %><span style="color:#059669; font-weight:600;"><i class="fas fa-check-circle"></i> সক্রিয়</span>
            <% } else { %><span style="color:#e74c3c; font-weight:600;"><i class="fas fa-ban"></i> বাতিল</span><% } %>
          </td>
          <td>
            <% if (isAdmin) { %>
              <form method="post" action="/admin/subscribers/<%= s.id %>/toggle" style="display:inline;">
                <button class="btn btn-secondary btn-sm" title="<%= s.is_active ? 'সাবস্ক্রিপশন বন্ধ করুন' : 'পুনরায় সক্রিয় করুন' %>"><i class="fas fa-power-off"></i></button>
              </form>
              <form method="post" action="/admin/subscribers/<%= s.id %>/delete" style="display:inline;">
                <button class="btn btn-danger btn-sm" title="মুছে ফেলুন"><i class="fas fa-trash"></i></button>
              </form>
            <% } else { %>
              <span style="color:#94a3b8; font-size:.82rem;">শুধু দেখা যাবে</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <div class="admin-header" style="margin-top:28px;">
    <h2 style="font-size:1.15rem;">ইমেইল নোটিফিকেশন রেকর্ড</h2>
  </div>
  <% if (logs.length === 0) { %>
    <div class="card empty">এখনো কোনো নোটিফিকেশন পাঠানো হয়নি। এডমিন/মডারেটর নতুন লেখা বা বিজ্ঞপ্তি পোস্ট করলে এখানে রেকর্ড দেখা যাবে।</div>
  <% } else { %>
  <table>
    <thead>
      <tr><th>শিরোনাম</th><th>ধরন</th><th>প্রেরক</th><th>তারিখ</th><th>প্রাপক</th><th>পাঠানো / ব্যর্থ</th><th>অ্যাকশন</th></tr>
    </thead>
    <tbody>
      <% logs.forEach(l => { %>
        <tr>
          <td><strong><%= l.title %></strong></td>
          <td><%= l.kind === 'notice' ? 'বিজ্ঞপ্তি' : 'লেখা' %></td>
          <td><%= l.author_name || '—' %></td>
          <td style="font-size:.85rem; color:#64748b;"><%= l.created_at ? new Date(String(l.created_at).replace(' ', 'T')).toLocaleString('bn-BD') : '—' %></td>
          <td><%= l.subscriber_count %></td>
          <td>
            <span style="color:#059669;"><%= l.sent_count %></span> / <span style="color:#e74c3c;"><%= l.failed_count %></span>
            <% if (l.sent_count === 0 && l.failed_count === 0 && l.subscriber_count > 0) { %>
              <span style="color:#f59e0b; font-size:.82rem;">(কিউতে)</span>
            <% } %>
          </td>
          <td>
            <% if (isAdmin && (l.sent_count + l.failed_count) < l.subscriber_count) { %>
              <form method="post" action="/admin/subscribers/retry/<%= l.id %>" style="display:inline;">
                <button class="btn btn-primary btn-sm"><i class="fas fa-rotate-right"></i> আবার পাঠান</button>
              </form>
            <% } else { %>—<% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
</body>
</html>
