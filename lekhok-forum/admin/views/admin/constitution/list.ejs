<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" /><%# session136: টোকেন-রেজোলিউশন (var(--lf-*) admin.css) %>
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>গঠনতন্ত্র</h1>
    <p><%= items.length %> টি ধারা | <a href="/admin/constitution/new">+ নতুন ধারা</a></p>
  </div>

  <form method="POST" action="/admin/constitution/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড আইটেমগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
  </form>
  <% if (items.length === 0) { %>
    <div class="card empty">কোনো ধারা যোগ করা হয়নি</div>
  <% } else { %>
  <table>
    <thead>
      <tr><th style="width:34px;"><input type="checkbox" data-bulk-all aria-label="সব সিলেক্ট করুন"></th><th>শিরোনাম</th><th>অধ্যায়</th><th>ক্রম</th><th>কার্যক্রম</th></tr>
    </thead>
    <tbody>
      <% items.forEach(c => {
        const chp = (c.chapter && c.chapter !== 'legacy') ? chapters.find(x => x.id === c.chapter) : null;
        const chpLabel = chp ? chp.title : (c.chapter === 'legacy' ? 'পুরাতন-সংক্ষিপ্ত' : '—');
      %>
        <tr>
          <td style="width:34px;"><input type="checkbox" name="bulk_ids" value="<%= c.id %>" aria-label="সিলেক্ট"></td>
          <td><strong><%= c.section_title %></strong></td>
          <td><span style="font-size:12px; padding:2px 8px; border-radius:9999px; white-space:nowrap; <%= chp ? 'background:var(--lf-brand-light,#E8F5E9); color:var(--lf-brand-primary,#006A4E); font-weight:700;' : (c.chapter === 'legacy' ? 'background:var(--lf-gray-soft-2,#E5E7EB); color:var(--lf-text-secondary,#65676B);' : 'color:var(--lf-text-tertiary,#8A8D91);') %>"><%= chpLabel %></span></td>
          <td><%= c.sort_order || 0 %></td>
          <td>
            <a href="/admin/constitution/<%= c.id %>/edit" class="btn btn-primary btn-sm">সম্পাদনা</a>
            <form method="POST" action="/admin/constitution/<%= c.id %>?_method=DELETE" style="display:inline;">
              <button class="btn btn-danger btn-sm">মুছুন</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
</body>
</html>
