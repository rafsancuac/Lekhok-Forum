<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" /><%# session136: টোকেন-রেজোলিউশন (var(--lf-*) admin.css) %>
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><%= item ? 'গঠনতন্ত্র সম্পাদনা' : 'নতুন গঠনতন্ত্র ধারা' %></h1>
    <p><a href="/admin/constitution">← গঠনতন্ত্র তালিকায় ফিরে যান</a></p>
  </div>
  <div class="card">
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="<%= item ? '/admin/constitution/' + item.id + '?_method=PUT' : '/admin/constitution' %>">
      <div class="form-group">
        <label>ধারার শিরোনাম *</label>
        <input type="text" name="section_title" value="<%= item ? item.section_title : '' %>" required placeholder="যেমন: ধারা-৪১ : আয়ের উৎস">
      </div>
      <%# সেশন ২০৬: অধ্যায়-লিংক — পাবলিক গেজেট-রিডারের সূচিপত্রে সঠিক অধ্যায়ে রেন্ডার হয় %>
      <div class="form-group">
        <label>অধ্যায় *</label>
        <select name="chapter" required>
          <option value="" disabled <%= item ? '' : 'selected' %> hidden>— অধ্যায় নির্বাচন করুন —</option>
          <% chapters.forEach((chp) => { %>
            <option value="<%= chp.id %>" <%= item && item.chapter === chp.id ? 'selected' : '' %>><%= chp.title %></option>
          <% }) %>
          <option value="legacy" <%= item && item.chapter === 'legacy' ? 'selected' : '' %>>পুরাতন-সংক্ষিপ্ত (পাবলিকে প্রদর্শিত হয় না)</option>
        </select>
      </div>
      <div class="form-group">
        <label>বিষয়বস্তু *</label>
        <textarea name="content" rows="10" required placeholder="এই ধারার বিস্তারিত বিধান লিখুন..."><%= item ? (item.content || '') : '' %></textarea>
      </div>
      <div class="form-group">
        <label>সর্ট অর্ডার (ছোট সংখ্যা আগে)</label>
        <input type="number" name="sort_order" value="<%= item ? (item.sort_order || 0) : 0 %>" min="0">
      </div>
      <button type="submit" class="btn btn-primary"><%= item ? 'আপডেট' : 'তৈরি করুন' %></button>
    </form>
  </div>
</div>
</body>
</html>
