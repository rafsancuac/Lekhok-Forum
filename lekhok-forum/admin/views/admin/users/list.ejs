<%- include('../partials/header', { adminUser, currentPath, pageTitle: 'ইউজার ম্যানেজমেন্ট' }) %>

<div class="admin-page">
  <div class="page-head">
    <h1><i class="fas fa-users-cog"></i> ইউজার ম্যানেজমেন্ট</h1>
    <a href="/admin/moderators" class="btn btn-secondary"><i class="fas fa-user-shield"></i> মডারেটর ম্যানেজমেন্ট</a>
  </div>

  <form class="filter-bar" method="GET">
    <input type="text" name="q" value="<%= q %>" placeholder="ইউজারনেম, নাম, ইমেইল খুঁজুন..." class="form-input">
    <select name="role" class="form-input">
      <option value="">সকল রোল</option>
      <option value="user"      <%= roleFilter === 'user' ? 'selected' : '' %>>ইউজার</option>
      <option value="moderator" <%= roleFilter === 'moderator' ? 'selected' : '' %>>মডারেটর</option>
      <option value="admin"     <%= roleFilter === 'admin' ? 'selected' : '' %>>এডমিন</option>
    </select>
    <select name="status" class="form-input">
      <option value="">সকল স্ট্যাটাস</option>
      <option value="active"  <%= statusFilter === 'active' ? 'selected' : '' %>>সক্রিয়</option>
      <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>অপেক্ষমাণ</option>
      <option value="banned"  <%= statusFilter === 'banned' ? 'selected' : '' %>>নিষিদ্ধ</option>
    </select>
    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> ফিল্টার</button>
    <% if (q || roleFilter || statusFilter) { %>
      <a href="/admin/users" class="btn btn-ghost"><i class="fas fa-times"></i> রিসেট</a>
    <% } %>
  </form>

  <div class="data-card">
    <table class="data-table">
      <thead>
        <tr>
          <th>ইউজার</th>
          <th>রোল</th>
          <th>স্ট্যাটাস</th>
          <th>পোস্ট</th>
          <th>ফলোয়ার</th>
          <th>যোগদান</th>
          <th>শেষ লগইন</th>
          <th>অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="8" class="empty-row">কোনো ইউজার পাওয়া যায়নি</td></tr>
        <% } %>
        <% users.forEach(u => { %>
          <tr>
            <td>
              <div class="user-cell">
                <img src="<%= u.avatar_url || '/avatar/' + u.id %>" class="user-avatar-sm">
                <div>
                  <a href="/profile/<%= u.username %>" target="_blank" class="user-name-link"><%= u.full_name || u.username %></a>
                  <div class="user-username">@<%= u.username %></div>
                </div>
              </div>
            </td>
            <td>
              <% if (u.role === 'admin') { %><span class="badge badge-admin">এডমিন</span>
              <% } else if (u.role === 'moderator') { %><span class="badge badge-mod">মডারেটর</span>
              <% } else { %><span class="badge badge-user">ইউজার</span><% } %>
            </td>
            <td>
              <% if (u.status === 'active') { %><span class="status-dot status-active"></span> সক্রিয়
              <% } else if (u.status === 'pending') { %><span class="status-dot status-pending"></span> অপেক্ষমাণ
              <% } else { %><span class="status-dot status-banned"></span> নিষিদ্ধ<% } %>
            </td>
            <td><%= u.post_count %></td>
            <td><%= u.follower_count %></td>
            <td><%= new Date(u.created_at).toLocaleDateString('bn-BD') %></td>
            <td><%= u.last_login ? new Date(u.last_login).toLocaleDateString('bn-BD') : '—' %></td>
            <td>
              <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i> এডিট</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <p class="hint"><i class="fas fa-info-circle"></i> সর্বমোট <strong><%= users.length %></strong> জন ইউজার দেখানো হচ্ছে (সর্বোচ্চ ২০০)।</p>
</div>

<%- include('../partials/footer') %>
