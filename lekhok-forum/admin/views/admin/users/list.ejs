<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — ইউজার ম্যানেজমেন্ট</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" /><%# session136: টোকেন-রেজোলিউশন (var(--lf-*) admin.css) %>
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><i class="fas fa-users-cog"></i> ইউজার ম্যানেজমেন্ট</h1>
    <p><a href="/admin/moderators"><i class="fas fa-user-shield"></i> মডারেটর ম্যানেজমেন্টে যান</a></p>
  </div>

  <form class="filter-bar" method="GET">
    <input type="text" name="q" value="<%= q %>" placeholder="ইউজারনেম, নাম, ইমেইল খুঁজুন..." class="form-input">
    <select name="role" class="form-input">
      <option value="">সকল রোল</option>
      <option value="user"      <%= roleFilter === 'user' ? 'selected' : '' %>>ইউজার</option>
      <option value="moderator" <%= roleFilter === 'moderator' ? 'selected' : '' %>>মডারেটর</option>
      <option value="admin"     <%= roleFilter === 'admin' ? 'selected' : '' %>>এডমিন</option>
    </select>
    <select name="status" class="form-input">
      <option value="">সকল স্ট্যাটাস</option>
      <option value="active"  <%= statusFilter === 'active' ? 'selected' : '' %>>সক্রিয়</option>
      <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>অপেক্ষমাণ</option>
      <option value="banned"  <%= statusFilter === 'banned' ? 'selected' : '' %>>নিষিদ্ধ</option>
    </select>
    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> ফিল্টার</button>
    <% if (q || roleFilter || statusFilter) { %>
      <a href="/admin/users" class="btn btn-secondary"><i class="fas fa-times"></i> রিসেট</a>
    <% } %>
  </form>

  <%# session251: তাৎক্ষণিক-ফিল্টার স্ট্রিপ — সার্ভার-রাউন্ড-ট্রিপ-হীন ক্লায়েন্ট-সাইড সংকীর্ণ
      (GET ফিল্টার-বার অক্ষুণ্ণ; ২০০-সারি পর্যন্ত তালিকায় তাৎক্ষণিক-মিল); 'f'-কী ফোকাস + Escape-ক্লিয়ার;
      QA-হুক __auQA (সারফেস-নেমস্পেস-রীতি) %>
  <div class="au251-wrap">
    <div class="au251-field">
      <input type="text" id="au251-filter" class="form-input au251-input" placeholder="তাৎক্ষণিক ফিল্টার — নাম, @ইউজারনেম, রোল..." aria-label="তাৎক্ষণিক ফিল্টার" autocomplete="off">
      <kbd class="au251-kbd" aria-hidden="true">f</kbd>
    </div>
    <span id="au251-count" class="au251-count" title="দৃশ্যমান সারি"><%= users.length %></span>
    <button type="button" id="au251-clear" class="au251-clear" hidden aria-label="ফিল্টার পরিষ্কার"><i class="fas fa-times"></i></button>
  </div>

  <table>
    <thead>
      <tr>
        <th>ইউজার</th>
        <th>রোল</th>
        <th>স্ট্যাটাস</th>
        <th>পোস্ট</th>
        <th>ফলোয়ার</th>
        <th>যোগদান</th>
        <th>শেষ লগইন</th>
        <th>অ্যাকশন</th>
      </tr>
    </thead>
    <tbody>
      <% if (users.length === 0) { %>
        <tr><td colspan="8" class="empty-row">কোনো ইউজার পাওয়া যায়নি</td></tr>
      <% } %>
      <% users.forEach(u => { %>
        <tr data-au-row data-kw="<%= (u.username + ' ' + (u.full_name || '') + ' ' + (u.email || '') + ' ' + u.role + ' ' + u.status).toLowerCase() %>">
          <td>
            <div class="user-cell">
              <img src="<%= u.avatar_url || '/avatar/' + u.id %>" class="user-avatar-sm" alt="">
              <div>
                <a href="/profile/<%= u.username %>" target="_blank" class="user-name-link"><%= u.full_name || u.username %></a>
                <div class="user-username">@<%= u.username %></div>
              </div>
            </div>
          </td>
          <td>
            <% if (u.role === 'admin') { %><span class="badge badge-admin">এডমিন</span>
            <% } else if (u.role === 'moderator') { %><span class="badge badge-mod">মডারেটর</span>
            <% } else { %><span class="badge badge-user">ইউজার</span><% } %>
          </td>
          <td>
            <% if (u.status === 'active') { %><span class="status-dot status-active"></span> সক্রিয়
            <% } else if (u.status === 'pending') { %><span class="status-dot status-pending"></span> অপেক্ষমাণ
            <% } else { %><span class="status-dot status-banned"></span> নিষিদ্ধ<% } %>
          </td>
          <td><%= u.post_count %></td>
          <td><%= u.follower_count %></td>
          <td><%= new Date(u.created_at).toLocaleDateString('bn-BD') %></td>
          <td><%= u.last_login ? new Date(u.last_login).toLocaleDateString('bn-BD') : '—' %></td>
          <td>
            <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i> এডিট</a>
          </td>
        </tr>
      <% }); %>
        <%# session251: তাৎক্ষণিক-ফিল্টার-শূন্য-অবস্থা (ক্লায়েন্ট-সাইডেই টগল হয়) %>
        <tr data-au-empty hidden><td colspan="8" class="empty-row">এই ফিল্টারে কোনো ইউজার মেলেনি</td></tr>
    </tbody>
  </table>

  <p class="hint"><i class="fas fa-info-circle"></i> সর্বমোট <strong><%= users.length %></strong> জন ইউজার দেখানো হচ্ছে (সর্বোচ্চ ২০০)।</p>
</div>

<style>
.filter-bar { display: flex; gap: 10px; flex-wrap: wrap; background: #fff; padding: 14px 18px; border-radius: 5px; border: 1px solid #f0f1f4; box-shadow: 0 1px 2px rgba(28,30,33,0.06), 0 1px 3px rgba(28,30,33,0.05); margin-bottom: 18px; }
.form-input { padding: 10px 12px; border: 1px solid #ccd0d5; border-radius: 5px; font-family: inherit; font-size: 0.95rem; background: #fff; color: #1c1e21; }
.form-input:focus { outline: none; border-color: #059669; box-shadow: 0 0 0 4px rgba(5,150,105,0.14); }
.badge { display: inline-block; padding: 4px 10px; border-radius: 5px; font-size: 0.78rem; font-weight: 600; }
.badge-admin { background: #ede9fe; color: #5b21b6; }
.badge-mod   { background: #d9f0ff; color: #0b5cad; }
.badge-user  { background: #f1f2f4; color: #444950; }
.empty-row   { text-align: center; color: #94a3b8; padding: 30px !important; }
.hint        { color: #64748b; font-size: 0.85rem; margin-top: 14px; }
.user-cell { display: flex; align-items: center; gap: 10px; }
.user-avatar-sm { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
.user-name-link { color: #1c1e21; font-weight: 600; }
.user-name-link:hover { color: #059669; }
.user-username { font-size: 12px; color: #94a3b8; }
.status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; }
.status-active  { background: #16a34a; }
.status-pending { background: #f59e0b; }
.status-banned  { background: #dc2626; }

/* ── session251 — তাৎক্ষণিক-ফিল্টার (টোকেন-শুধু; guard-হেক্স-র্যাচেট-নিরাপদ; fr-kbd249-প্যাটার্ন-মিরর) ── */
.au251-wrap { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.au251-field { position: relative; flex: 0 1 420px; }
.au251-input { width: 100%; padding-right: 52px; transition: border-color .15s ease, box-shadow .15s ease; }
.au251-input:focus { outline: none; border-color: var(--lf-brandgreen); box-shadow: 0 0 0 4px color-mix(in srgb, var(--lf-brandgreen) 14%, transparent); }
.au251-kbd { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); pointer-events: none; font: inherit; font-size: 10px; font-weight: 700; line-height: 1; color: var(--lf-text-tertiary); background: var(--lf-ui-canvas); border: 1px dashed var(--lf-ui-border-strong); border-radius: 4px; padding: 2px 6px; transition: opacity .15s ease; }
.au251-field:focus-within .au251-kbd { opacity: 0; }
.au251-count { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; padding: 6px 10px; border-radius: 999px; background: var(--lf-ui-canvas); border: 1px solid var(--lf-ui-border); color: var(--lf-text-secondary); font-weight: 700; font-size: .85rem; font-variant-numeric: tabular-nums; }
.au251-count.au251-dim { color: var(--lf-text-tertiary); }
.au251-clear { border: 1px solid var(--lf-ui-border); background: var(--lf-ui-surface); color: var(--lf-text-tertiary); border-radius: 5px; padding: 8px 11px; cursor: pointer; transition: color .15s ease, border-color .15s ease; }
.au251-clear:hover { color: var(--lf-green-ink); border-color: var(--lf-brandgreen); }
.au251-clear:active { transform: scale(.96); }
@media (max-width: 640px) { .au251-field { flex-basis: 100%; } .au251-input { padding-right: 12px; } .au251-kbd { display: none; } }
@media (prefers-reduced-motion: reduce) { .au251-input, .au251-kbd { transition: none; } .au251-clear:active { transform: none; } }
</style>

<script>
(function () {
  'use strict';
  var input = document.getElementById('au251-filter');
  var count = document.getElementById('au251-count');
  var clearBtn = document.getElementById('au251-clear');
  var rows = Array.prototype.slice.call(document.querySelectorAll('tr[data-au-row]'));
  var emptyRow = document.querySelector('tr[data-au-empty]');
  var total = rows.length;
  function apply251() {
    var v = (input.value || '').trim().toLowerCase();
    var vis = 0;
    rows.forEach(function (r) {
      var kw = r.getAttribute('data-kw') || '';
      var hit = !v || kw.indexOf(v) >= 0;
      r.hidden = !hit;
      if (hit) vis++;
    });
    count.textContent = vis;
    count.classList.toggle('au251-dim', !!v && vis !== total);
    if (emptyRow) emptyRow.hidden = vis !== 0;
    if (clearBtn) clearBtn.hidden = !v;
  }
  if (input) {
    input.addEventListener('input', apply251);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { input.value = ''; apply251(); input.blur(); }
    });
  }
  if (clearBtn) clearBtn.addEventListener('click', function () { input.value = ''; apply251(); input.focus(); });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'f' || e.ctrlKey || e.metaKey || e.altKey) return;
    var t = e.target && e.target.tagName;
    if (t === 'INPUT' || t === 'TEXTAREA' || t === 'SELECT' || (e.target && e.target.isContentEditable)) return;
    e.preventDefault();
    input.focus();
    input.select();
  });
  /* session251 QA-হুক (__auQA — সারফেস-নেমস্পেস-রীতি; print/গাঢ়-অংশের পরে ক্রমের-শেষ) */
  window.__auQA = {
    focus: function () { input.focus(); return true; },
    clear: function () { input.value = ''; apply251(); return true; },
    count: function () { return document.querySelectorAll('tr[data-au-row]:not([hidden])').length; },
    total: function () { return total; }
  };
})();
</script>
</body>
</html>
