<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>রিসোর্স</h1>
    <p><%= resources.length %> টি রিসোর্স | <a href="/admin/resources/new">+ নতুন রিসোর্স</a></p>
  </div>

  <form method="POST" action="/admin/resources/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড আইটেমগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
  </form>
  <% if (resources.length === 0) { %>
    <div class="card empty">কোনো রিসোর্স নেই</div>
  <% } else { %>
  <table>
    <thead><tr><th style="width:34px;"><input type="checkbox" data-bulk-all aria-label="সব সিলেক্ট করুন"></th><th>শিরোনাম</th><th>ক্যাটাগরি</th><th>লেখক</th><th>কার্যক্রম</th></tr></thead>
    <tbody>
      <% resources.forEach(r => { %>
        <tr>
          <td style="width:34px;"><input type="checkbox" name="bulk_ids" value="<%= r.id %>" aria-label="সিলেক্ট"></td>
          <td><strong><%= r.title %></strong></td>
          <td><%= r.category %></td>
          <td><%= r.author || '—' %></td>
          <td>
            <a href="/admin/resources/<%= r.id %>/edit" class="btn btn-primary btn-sm">সম্পাদনা</a>
            <form method="POST" action="/admin/resources/<%= r.id %>?_method=DELETE" style="display:inline;" onsubmit="return confirm('মুছে ফেলতে চান?')">
              <button class="btn btn-danger btn-sm">মুছুন</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
</body>
</html>
