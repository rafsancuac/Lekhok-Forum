<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>টাস্ক — লেখক ফোরাম অ্যাডমিন</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('partials/sidebar', { adminUser, currentPath }) %>
<div class="admin-main">
  <div class="admin-topbar">
    <div>
      <h1><i class="fas fa-tasks"></i> মডারেটর টাস্ক</h1>
      <p>মডারেটরদের কাজ বরাদ্দ দিন, অগ্রগতি ট্র্যাক করুন</p>
    </div>
  </div>
  <div style="max-width:900px; margin:0 auto;">
    <div class="card" style="margin-bottom:18px;">
      <h3 class="card-title"><i class="fas fa-plus-circle"></i> নতুন টাস্ক তৈরি</h3>
      <form method="POST" action="/admin/tasks">
        <div class="form-row">
          <div class="form-group">
            <label>টাস্ক শিরোনাম</label>
            <input type="text" name="title" required>
          </div>
          <div class="form-group">
            <label>মডারেটর</label>
            <select name="assignee_id">
              <option value="">-- নির্বাচন করুন --</option>
              <% moderators.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.full_name %> (@<%= m.username %>)</option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>অগ্রাধিকার</label>
            <select name="priority">
              <option value="normal">সাধারণ</option>
              <option value="high">উচ্চ</option>
              <option value="urgent">জরুরি</option>
            </select>
          </div>
          <div class="form-group">
            <label>ডেডলাইন</label>
            <input type="date" name="due_date">
          </div>
        </div>
        <div class="form-group">
          <label>বিবরণ</label>
          <textarea name="description" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> টাস্ক তৈরি করুন</button>
      </form>
    </div>

    <div class="card">
      <h3 class="card-title" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;"><i class="fas fa-list"></i> টাস্ক তালিকা
        <form method="GET" style="display:flex;gap:8px;align-items:center;margin-left:auto;">
          <input type="search" name="q" value="<%= typeof q42 !== 'undefined' ? q42 : '' %>" placeholder="টাস্ক খুঁজুন…" style="padding:7px 10px;border:1px solid #d1d5db;border-radius:5px;font-family:inherit;font-size:.85rem;">
          <button class="btn btn-sm" type="submit"><i class="fas fa-search"></i></button>
        </form>
        <span style="font-size:.8rem;color:#6b7280;">
          <% if (typeof page42 !== 'undefined' && page42 > 1) { %><a class="btn btn-sm" href="?page=<%= page42 - 1 %>">←</a><% } %>
          পেজ <%= typeof page42 !== 'undefined' ? page42 : 1 %>/<%= typeof pages42 !== 'undefined' ? pages42 : 1 %>
          <% if (typeof page42 !== 'undefined' && page42 < pages42) { %><a class="btn btn-sm" href="?page=<%= page42 + 1 %>">→</a><% } %>
        </span>
      </h3>
      <% if (tasks && tasks.length) { %>
        <div class="table-wrap">
  <label style="font-size:.85rem;font-weight:600;color:#65676b;display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-bottom:8px;"><input type="checkbox" data-bulk-all style="width:16px;height:16px;"> সব সিলেক্ট</label>
  <form method="POST" action="/admin/tasks/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড টাস্কগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
  </form>
        <table>
          <thead>
            <tr>
              <th style="width:34px;"><input type="checkbox" data-bulk-all aria-label="সব সিলেক্ট"></th>
              <th>টাস্ক</th>
              <th>মডারেটর</th>
              <th>অগ্রাধিকার</th>
              <th>স্ট্যাটাস</th>
              <th>ডেডলাইন</th>
              <th>অ্যাকশন</th>
            </tr>
          </thead>
          <tbody>
            <% tasks.forEach(t => { %>
              <tr>
                <td style="width:34px;"><input type="checkbox" name="bulk_ids" value="<%= t.id %>" aria-label="সিলেক্ট"></td>
                <td>
                  <strong><%= t.title %></strong>
                  <% if (t.description) { %><br><small style="color:#65676b;"><%= t.description.substring(0,60) %></small><% } %>
                </td>
                <td><%= t.assignee_name || '—' %></td>
                <td>
                  <% if (t.priority === 'urgent') { %><span class="badge-soft status-banned">জরুরি</span><% } %>
                  <% if (t.priority === 'high') { %><span class="badge-soft status-pending">উচ্চ</span><% } %>
                  <% if (t.priority === 'normal') { %><span class="badge-soft status-new">সাধারণ</span><% } %>
                </td>
                <td>
                  <form method="POST" action="/admin/tasks/<%= t.id %>/status" style="display:inline;">
                    <select name="status" onchange="this.form.submit()" style="padding:4px 8px; border:1px solid #ccd0d5; border-radius:5px; font-size:12px; font-family:inherit; background:#fff;">
                      <option value="pending" <%= t.status==='pending'?'selected':'' %>>বাকি</option>
                      <option value="in_progress" <%= t.status==='in_progress'?'selected':'' %>>চলমান</option>
                      <option value="done" <%= t.status==='done'?'selected':'' %>>সম্পন্ন</option>
                    </select>
                  </form>
                </td>
                <td><%= t.due_date || '—' %></td>
                <td>
                  <form method="POST" action="/admin/tasks/<%= t.id %>/delete" style="display:inline;" onsubmit="return confirm('মুছবেন?')">
                    <button type="submit" class="btn btn-danger btn-sm" title="মুছুন"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } else { %>
        <div class="empty-state-full">
          <i class="fas fa-clipboard-list"></i>
          <p>কোনো টাস্ক নেই</p>
        </div>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>
