<%- include('./partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>মডারেটর ও ইউজার ব্যবস্থাপনা</h1>
    <p>কার্যের পরিধি নিয়ন্ত্রণ করুন — কোন মডারেটর কোন সেকশনে কাজ করবে</p>
  </div>

  <h2 style="margin:0 0 10px; font-size:1.15rem;">কর্মী (অ্যাডমিন/মডারেটর)</h2>
  <% if (staff.length === 0) { %>
    <div class="card empty">কোনো মডারেটর নেই — নিচের তালিকা থেকে ইউজারকে মডারেটর করুন</div>
  <% } %>
  <% staff.forEach(u => { %>
    <div class="card" style="margin-bottom:14px;">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:10px;">
          <img src="<%= u.avatar_url || '/avatar/' + u.id %>" style="width:44px;height:44px;border-radius:50%;object-fit:cover;" alt="">
          <div>
            <strong><%= u.full_name %></strong> <span style="color:#888;">@<%= u.username %></span>
            <div style="font-size:.8rem; color:#666;"><%= u.post_count %> পোস্ট &middot; <%= u.scope_count %> পারমিশন</div>
          </div>
        </div>
        <form method="POST" action="/admin/users/<%= u.id %>/role" style="display:flex; gap:6px; align-items:center;">
          <select name="role" style="width:auto;">
            <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>ইউজার</option>
            <option value="moderator" <%= u.role === 'moderator' ? 'selected' : '' %>>মডারেটর</option>
            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>অ্যাডমিন</option>
          </select>
          <button class="btn btn-primary btn-sm">রোল সেভ</button>
        </form>
      </div>
      <% if (u.role === 'moderator') { %>
      <form method="POST" action="/admin/users/<%= u.id %>/scopes" style="margin-top:10px; padding-top:10px; border-top:1px dashed #e5e5e5;">
        <label style="font-weight:600; font-size:.85rem; display:block; margin-bottom:6px;">কাজের পরিধি:</label>
        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <% CANONICAL_SCOPES.forEach(s => {
               const has = (u.scopes || []).includes(s.key);
          %>
            <label style="font-weight:normal; display:flex; align-items:center; gap:5px; font-size:.9rem;">
              <input type="checkbox" name="scopes" value="<%= s.key %>" <%= has ? 'checked' : '' %>> <%= s.label %>
            </label>
          <% }) %>
        </div>
        <button class="btn btn-primary btn-sm" style="margin-top:8px;">পারমিশন সেভ</button>
      </form>
      <% } %>
    </div>
  <% }) %>

  <h2 style="margin:20px 0 10px; font-size:1.15rem;">সব ইউজার (<%= users.length %>)</h2>
  <table>
    <thead>
      <tr><th>নাম</th><th>রোল</th><th>স্ট্যাটাস</th><th>যোগদান</th><th>অ্যাকশন</th></tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td>
            <div style="display:flex; align-items:center; gap:8px;">
              <img src="<%= u.avatar_url || '/avatar/' + u.id %>" style="width:32px;height:32px;border-radius:50%;object-fit:cover;" alt="">
              <div>
                <strong><%= u.full_name %></strong><br>
                <span style="font-size:.78rem; color:#888;">@<%= u.username %></span>
              </div>
            </div>
          </td>
          <td><%= u.role === 'admin' ? 'অ্যাডমিন' : u.role === 'moderator' ? 'মডারেটর' : 'ইউজার' %></td>
          <td><%= u.status === 'active' ? 'সক্রিয়' : u.status === 'banned' ? 'নিষিদ্ধ' : u.status %></td>
          <td><%= (u.created_at || '').split(' ')[0] %></td>
          <td>
            <form method="POST" action="/admin/users/<%= u.id %>/role" style="display:flex; gap:5px; align-items:center;">
              <select name="status" style="width:auto; font-size:.85rem;">
                <option value="active" <%= u.status === 'active' ? 'selected' : '' %>>সক্রিয়</option>
                <option value="pending" <%= u.status === 'pending' ? 'selected' : '' %>>অপেক্ষমাণ</option>
                <option value="banned" <%= u.status === 'banned' ? 'selected' : '' %>>নিষিদ্ধ</option>
              </select>
              <button class="btn btn-primary btn-sm">সেভ</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
