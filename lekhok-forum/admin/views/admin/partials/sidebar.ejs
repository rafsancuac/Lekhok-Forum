<%
  // সাইডবার — গ্রুপড নেভিগেশন + সার্চ + ইউজার কার্ড + মোবাইল ড্রয়ার + টোস্ট + ড্রাফট অটোসেভ
  const _path = currentPath || '';
  const _active = (p) => _path === p || _path.startsWith(p + '/') ? 'active' : '';
  const _isAdmin = !!(adminUser || (user && user.role === 'admin'));
  const _staffName = (adminUser && adminUser.display_name) || (user && user.full_name) || 'স্টাফ';
  const _roleLabel = adminUser ? 'অ্যাডমিন' : (user && user.role === 'admin' ? 'অ্যাডমিন' : 'মডারেটর');
  const _initial = (_staffName || 'স').trim().charAt(0);
  const _avatar = user ? '/avatar/' + user.id : null;
%>
<button class="admin-hamburger" id="adminHamburger" aria-label="মেনু" aria-controls="adminSidebar" aria-expanded="false" type="button"><i class="fas fa-bars"></i></button>
<div class="admin-backdrop" id="adminBackdrop"></div>
<aside class="admin-sidebar" id="adminSidebar" aria-label="অ্যাডমিন নেভিগেশন">
  <div class="logo">
    <div class="brand-emblem"><i class="fas fa-feather-alt"></i></div>
    <strong>লেখক ফোরাম</strong>
    <span class="logo-sub"><%= _isAdmin ? 'অ্যাডমিন প্যানেল' : 'মডারেটর প্যানেল' %></span>
  </div>
  <div class="nav-search" role="search">
    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
    <input type="search" id="adminNavSearch" placeholder="সেটিংস খুঁজুন" aria-label="সেটিংস খুঁজুন" autocomplete="off" />
  </div>
  <div class="nav-search-empty" id="navSearchEmpty">কোনো মিল পাওয়া যায়নি</div>
  <nav>
    <div class="nav-group-label">মূল</div>
    <a href="/admin" class="<%= _path === '/admin' ? 'active' : '' %>"><i class="fas fa-tachometer-alt"></i> ড্যাশবোর্ড</a>

    <% if (_isAdmin) { %>
    <div class="nav-group-label">সংগঠন</div>
    <a href="/admin/members"        class="<%= _active('/admin/members') %>"><i class="fas fa-users"></i> কমিটি সদস্য</a>
    <a href="/admin/achievements"   class="<%= _active('/admin/achievements') %>"><i class="fas fa-trophy"></i> অর্জন</a>
    <a href="/admin/constitution"   class="<%= _active('/admin/constitution') %>"><i class="fas fa-scroll"></i> গঠনতন্ত্র</a>
    <a href="/admin/past-leaders"   class="<%= _active('/admin/past-leaders') %>"><i class="fas fa-history"></i> প্রাক্তন নেতৃত্ব</a>
    <% } %>

    <div class="nav-group-label">কনটেন্ট</div>
    <a href="/admin/notices"        class="<%= _active('/admin/notices') %>"><i class="fas fa-bell"></i> বিজ্ঞপ্তি</a>
    <a href="/admin/events"         class="<%= _active('/admin/events') %>"><i class="fas fa-calendar-alt"></i> ইভেন্ট</a>
    <a href="/admin/daily"          class="<%= _active('/admin/daily') %>"><i class="fas fa-sun"></i> ডেইলি কনটেন্ট</a>
    <a href="/admin/gallery"        class="<%= _active('/admin/gallery') %>"><i class="fas fa-images"></i> গ্যালারি</a>
    <% if (_isAdmin) { %>
    <a href="/admin/resources"      class="<%= _active('/admin/resources') %>"><i class="fas fa-book"></i> রিসোর্স</a>
    <% } %>

    <div class="nav-group-label">কমিউনিটি</div>
    <% if (_isAdmin) { %>
    <a href="/admin/users"          class="<%= _active('/admin/users') %>"><i class="fas fa-users-cog"></i> ইউজার</a>
    <a href="/admin/moderators"     class="<%= _active('/admin/moderators') %>"><i class="fas fa-user-shield"></i> মডারেটর</a>
    <% } %>
    <a href="/admin/messages"       class="<%= _active('/admin/messages') %>"><i class="fas fa-envelope"></i> বার্তা</a>
    <a href="/admin/subscribers"    class="<%= _active('/admin/subscribers') %>"><i class="fas fa-paper-plane"></i> নিউজলেটার</a>
    <a href="/admin/complaints"     class="<%= _active('/admin/complaints') %>"><i class="fas fa-flag"></i> অভিযোগ</a>

    <div class="nav-group-label">সিস্টেম</div>
    <% if (_isAdmin) { %>
    <a href="/admin/content"     class="<%= _active('/admin/content') %>"><i class="fas fa-pen-square"></i> কনটেন্ট সম্পাদক</a>
    <% } %>
    <a href="/admin/navigation"     class="<%= _active('/admin/navigation') %>"><i class="fas fa-bars"></i> মেনু ব্যবস্থাপনা</a>
    <% if (_isAdmin) { %>
    <a href="/admin/tasks"         class="<%= _active('/admin/tasks') %>"><i class="fas fa-tasks"></i> মডারেটর টাস্ক</a>
    <a href="/admin/settings"       class="<%= _active('/admin/settings') %>"><i class="fas fa-cog"></i> সেটিংস</a>
    <% } %>
    <a href="/" target="_blank" class="nav-external"><i class="fas fa-external-link-alt"></i> সাইট দেখুন</a>
  </nav>
  <div class="sidebar-user">
    <div class="su-avatar">
      <% if (_avatar) { %><img src="<%= _avatar %>" alt=""><% } else { %><%= _initial %><% } %>
    </div>
    <div class="su-meta">
      <div class="su-name"><%= _staffName %></div>
      <div class="su-role"><i class="fas fa-shield-alt"></i> <%= _roleLabel %></div>
    </div>
    <a href="/admin/logout" class="su-logout" title="লগআউট"><i class="fas fa-sign-out-alt"></i></a>
  </div>
</aside>

<div class="toast-zone" id="toastZone"></div>

<script>
(function () {
  'use strict';

  /* ── মোবাইল ড্রয়ার ─────────────────────────────────────────────── */
  var hb = document.getElementById('adminHamburger');
  var bd = document.getElementById('adminBackdrop');
  function closeNav() {
    document.body.classList.remove('sidebar-open');
    if (bd) bd.classList.remove('show');
    if (hb) hb.setAttribute('aria-expanded', 'false');
  }
  if (hb) hb.addEventListener('click', function () {
    var open = document.body.classList.toggle('sidebar-open');
    if (bd) bd.classList.toggle('show', open);
    hb.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  if (bd) bd.addEventListener('click', closeNav);
  document.querySelectorAll('.admin-sidebar nav a').forEach(function (a) {
    a.addEventListener('click', closeNav);
    if (a.classList.contains('active')) a.setAttribute('aria-current', 'page');
  });

  /* ── সাইডবার সার্চ — নেভ আইটেম ফিল্টার (ক্লায়েন্ট-সাইড) ────────── */
  try {
    var searchInput = document.getElementById('adminNavSearch');
    var emptyHint = document.getElementById('navSearchEmpty');
    if (searchInput) {
      var navLinks = Array.prototype.slice.call(document.querySelectorAll('.admin-sidebar nav a'));
      var groupLabels = Array.prototype.slice.call(document.querySelectorAll('.admin-sidebar nav .nav-group-label'));
      searchInput.addEventListener('input', function () {
        var q = searchInput.value.trim().toLowerCase();
        var visible = 0;
        navLinks.forEach(function (a) {
          var hit = !q || a.textContent.toLowerCase().indexOf(q) !== -1;
          a.classList.toggle('nav-hidden', !hit);
          if (hit && !a.classList.contains('nav-external')) visible++;
        });
        /* খালি গ্রুপ-লেবেল লুকান */
        groupLabels.forEach(function (lbl) {
          var el = lbl.nextElementSibling, any = false;
          while (el && !el.classList.contains('nav-group-label')) {
            if (el.tagName === 'A' && !el.classList.contains('nav-hidden')) { any = true; break; }
            el = el.nextElementSibling;
          }
          lbl.classList.toggle('nav-hidden', !any);
        });
        if (emptyHint) emptyHint.classList.toggle('show', q && visible === 0);
      });
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { searchInput.value = ''; searchInput.dispatchEvent(new Event('input')); }
      });
    }
  } catch (e) {}

  /* ── ব্রেডক্রাম্ব ইনজেকশন — নেভ-ম্যাপ থেকে কেন্দ্রীয়ভাবে ────────────
     নোট: সাইডবার স্ক্রিপ্ট .admin-main-এর আগে চলে — তাই DOM-রেডি গার্ড। */
  var injectCrumbs = function () {
    try {
    var header = document.querySelector('.admin-main .admin-header') || document.querySelector('.admin-main .admin-topbar');
    var prependTo = header || document.querySelector('.admin-main');
    if (prependTo && !document.querySelector('.admin-main .crumbs')) {
      var map = [];
      var curGroup = 'মূল';
      document.querySelectorAll('.admin-sidebar nav > *').forEach(function (el) {
        if (el.classList.contains('nav-group-label')) curGroup = el.textContent.trim();
        else if (el.tagName === 'A') map.push({ href: el.getAttribute('href'), group: curGroup, label: el.textContent.trim() });
      });
      var here = location.pathname;
      var best = null;
      map.forEach(function (m) {
        if (m.href === '/admin') return;
        if (here === m.href || here.indexOf(m.href + '/') === 0) {
          if (!best || m.href.length > best.href.length) best = m;
        }
      });
      if (!best) {
        var dash = map.filter(function (m) { return m.href === '/admin'; })[0];
        if (dash && (here === '/admin' || here === '/admin/')) best = dash;
      }
      if (best) {
        var extra = here.replace(best.href, '').replace(/^\//, '');
        var extraLabel = '';
        if (extra === 'new') extraLabel = 'নতুন';
        else if (extra.indexOf('edit') !== -1) extraLabel = 'সম্পাদনা';
        else if (extra) extraLabel = 'বিস্তারিত';
        var crumbs = document.createElement('div');
        crumbs.className = 'crumbs';
        crumbs.setAttribute('aria-label', 'ব্রেডক্রাম্ব');
        var html = '<a href="/admin">অ্যাডমিন</a><i class="fas fa-chevron-right"></i>' +
                   '<span>' + best.group + '</span><i class="fas fa-chevron-right"></i>';
        html += extraLabel
          ? '<a href="' + best.href + '">' + best.label + '</a><i class="fas fa-chevron-right"></i><span class="crumbs-here">' + extraLabel + '</span>'
          : '<span class="crumbs-here">' + best.label + '</span>';
        crumbs.innerHTML = html;
        if (!header) crumbs.style.marginBottom = '14px';
        prependTo.insertBefore(crumbs, prependTo.firstChild);
      }
    }
    } catch (e) {}
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', injectCrumbs);
  else injectCrumbs();

  /* ── টোস্ট ফিডব্যাক (?saved=1 / ?error=...) ─────────────────────── */
  try {
    var qs = new URLSearchParams(location.search);
    var msg = qs.get('saved'), err = qs.get('error');
    if (msg || err) {
      var zone = document.getElementById('toastZone');
      var t = document.createElement('div');
      t.className = 'toast ' + (err ? 't-error' : 't-success');
      t.setAttribute('role', 'status');
      t.innerHTML = (err
        ? '<i class="fas fa-exclamation-circle t-ico"></i>'
        : '<i class="fas fa-check-circle t-ico"></i>')
        + '<span>' + (err || 'সফলভাবে সম্পন্ন হয়েছে') + '</span>'
        + '<i class="fas fa-times t-close"></i>';
      zone.appendChild(t);
      var kill = function () { t.classList.add('t-out'); setTimeout(function () { t.remove(); }, 320); };
      t.querySelector('.t-close').addEventListener('click', kill);
      setTimeout(kill, 3800);
      qs.delete('saved'); qs.delete('error');
      var clean = location.pathname + (qs.toString() ? '?' + qs.toString() : '');
      history.replaceState(null, '', clean);
    }
  } catch (e) {}

  /* ── ফর্ম ড্রাফট অটোসেভ — লিখে রাখা সবকিছু ফিরে পাওয়া ────────────
     ইউজার ফর্মে যা লিখে গেছে (সেভ না করে চলে গেলেও) পরের বার এসে
     ঠিক সেভাবেই ফিরে পায়। সফল সাবমিটে খসড়া মুছে যায়।
     নোট: স্ক্রিপ্টটি সাইডবারে (DOM-এর ঊর্ধ্বে) — ফর্ম পেতে DOMContentLoaded। */
  var initDrafts = function () {
    try {
      var forms = document.querySelectorAll('.admin-main form');
      if (!forms.length) return;
      forms.forEach(function (form, fi) {
        var fields = form.querySelectorAll('input[type=text],input[type=url],input[type=email],input[type=number],input[type=date],input[type=tel],textarea,select');
        if (!fields.length) return;
        var key = 'adminDraft:' + location.pathname + ':f' + fi + ':' + (form.getAttribute('action') || '');
        var saved = null;
        try { saved = JSON.parse(localStorage.getItem(key) || 'null'); } catch (e) {}
        if (saved) {
          fields.forEach(function (el) {
            if (el.name && saved[el.name] !== undefined && saved[el.name] !== '') el.value = saved[el.name];
          });
        }
        var timer;
        fields.forEach(function (el) {
          el.addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
              var data = {};
              fields.forEach(function (f) { if (f.name) data[f.name] = f.value; });
              try { localStorage.setItem(key, JSON.stringify(data)); } catch (e) {}
            }, 350);
          });
        });
        form.addEventListener('submit', function () {
          try { localStorage.removeItem(key); } catch (e) {}
        });
      });
    } catch (e) {}
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initDrafts);
  else initDrafts();
})();
</script>
