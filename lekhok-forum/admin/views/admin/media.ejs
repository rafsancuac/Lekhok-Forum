<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>মিডিয়া লাইব্রেরি | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
  <style>
    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; padding: 16px; }
    .media-card { border: 1px solid #e5e7eb; border-radius: 5px; overflow: hidden; background: #fff; }
    .media-card img { width: 100%; height: 110px; object-fit: cover; display: block; background: #f3f4f6; }
    .media-card .mc-body { padding: 8px 10px; font-size: .75rem; color: #6b7280; }
    .media-card .mc-name { font-weight: 700; color: #111827; font-size: .78rem; word-break: break-all; }
    .media-card .mc-actions { display: flex; gap: 6px; padding: 0 10px 10px; flex-wrap: wrap; }
    .mc-badge { display: inline-block; font-size: .65rem; font-weight: 700; padding: 1px 6px; border-radius: 3px; margin-left: 4px; vertical-align: 1px; }
    .mc-badge.webp { background: #d1fae5; color: #047857; }
    .mc-badge.opt { background: #fef3c7; color: #b45309; }
  </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1><i class="fas fa-photo-film"></i> মিডিয়া লাইব্রেরি</h1>
      <p class="subtitle">আপলোড করা সব ছবি — আপলোড, রিপ্লেস, URL কপি, WebP অপটিমাইজ, প্রিভিউ ও ডিলিট (<%= items.length %> টি)</p>
    </div>
  </div>
  <% if (saved) { %><div class="flash ok"><i class="fas fa-check-circle"></i> ছবি মুছে ফেলা হয়েছে।</div><% } %>
  <% if (uploaded) { %><div class="flash ok"><i class="fas fa-cloud-upload-alt"></i> আপলোড হয়েছে (অটো-অপটিমাইজড): <strong><%= uploaded %></strong></div><% } %>
  <% if (replaced) { %><div class="flash ok"><i class="fas fa-sync-alt"></i> রিপ্লেস হয়েছে: <strong><%= replaced %></strong><% if (old && old !== replaced) { %> (আগের: <%= old %>)<% } %></div><% } %>
  <% if (optimized && delta === '0') { %><div class="flash ok"><i class="fas fa-check-circle"></i> <strong><%= optimized %></strong> ইতিমধ্যে যথেষ্ট অপটিমাইজড — আর ছোট করা যায়নি।</div><% } %>
  <% if (optimized && delta && delta !== '0') { %><div class="flash ok"><i class="fas fa-bolt"></i> <strong><%= optimized %></strong> তৈরি হয়েছে — সাইজ <strong><%= delta %>% কমেছে</strong> (WebP)। মূল ফাইল অক্ষত রাখা হয়েছে।</div><% } %>
  <% if (skipped) { %><div class="flash warn"><i class="fas fa-info-circle"></i> <strong><%= skipped %></strong> — শুধু JPEG/PNG অপটিমাইজ করা যায় (WebP/GIF/SVG বাদ)।</div><% } %>
  <% if (err === 'opt_failed') { %><div class="flash error"><i class="fas fa-exclamation-circle"></i> অপটিমাইজেশন ব্যর্থ হয়েছে — ছবিটি সম্ভবত ক্ষতিগ্রস্ত।</div><% } %>
  <% if (err === '1') { %><div class="flash error"><i class="fas fa-exclamation-circle"></i> অবৈধ ফাইল পাথ।</div><% } %>
  <% if (err && err !== '1' && err !== 'opt_failed') { %><div class="flash error"><i class="fas fa-exclamation-circle"></i> <%= err %></div><% } %>
  <div class="card" style="padding:18px;margin-bottom:16px;">
    <h3 style="margin:0 0 4px;font-size:15px;"><i class="fas fa-cloud-upload-alt"></i> নতুন ছবি আপলোড</h3>
    <p style="color:#64748b;font-size:13px;margin:0 0 12px;">JPEG/PNG অটো-WebP-তে অপটিমাইজ হয়ে সেভ হবে।</p>
    <form method="POST" action="/admin/media/upload" enctype="multipart/form-data" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
      <input type="file" name="file" accept="image/*" required style="border:1px solid #cbd5e1;border-radius:5px;padding:8px;background:#fff;">
      <select name="subdir" style="border:1px solid #cbd5e1;border-radius:5px;padding:8px;background:#fff;">
        <option value="content">কনটেন্ট</option>
        <option value="gallery">গ্যালারি</option>
        <option value="avatars">অ্যাভাটার</option>
        <option value="covers">কভার</option>
        <option value="attachments">অ্যাটাচমেন্ট</option>
        <option value="press">প্রেস কাটিং</option>
        <option value="epaper">ই-পেপার</option>
      </select>
      <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> আপলোড করুন</button>
    </form>
  </div>
  <div class="card" style="padding:0;">
    <% if (!items.length) { %>
    <div class="empty"><i class="fas fa-photo-film"></i><p>কোনো আপলোড নেই।</p></div>
    <% } else { %>
    <div class="media-grid">
      <% items.forEach(m => { %>
      <% const ext = (m.name || '').split('.').pop().toLowerCase(); const optable = (ext === 'jpg' || ext === 'jpeg' || ext === 'png'); %>
      <div class="media-card">
        <img src="<%= m.url %>" loading="lazy" alt="">
        <div class="mc-body">
          <div class="mc-name"><%= m.name %><% if (ext === 'webp') { %><span class="mc-badge webp">WebP</span><% } else if (optable) { %><span class="mc-badge opt">JPEG/PNG</span><% } %></div>
          <div><%= (m.size / 1024).toFixed(0) %> KB · <%= m.mtime %></div>
        </div>
        <div class="mc-actions">
          <button class="btn btn-sm" type="button" onclick="navigator.clipboard.writeText(location.origin + '<%= m.url %>').then(()=>alert('URL কপি হয়েছে ✓'))"><i class="fas fa-link"></i> URL</button>
          <% if (optable) { %>
          <form method="POST" action="/admin/media/optimize">
            <input type="hidden" name="url" value="<%= m.url %>">
            <button class="btn btn-sm" type="submit" title="WebP-তে অপটিমাইজ করুন"><i class="fas fa-bolt"></i> WebP</button>
          </form>
          <% } %>
          <form method="POST" action="/admin/media/delete">
            <input type="hidden" name="url" value="<%= m.url %>">
            <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash"></i></button>
          </form>
          <form method="POST" action="/admin/media/replace" enctype="multipart/form-data" style="display:flex;gap:4px;align-items:center;width:100%;">
            <input type="hidden" name="url" value="<%= m.url %>">
            <input type="file" name="file" accept="image/*" required title="একই URL-এ নতুন ছবি বসান" style="flex:1;min-width:0;font-size:11px;border:1px solid #cbd5e1;border-radius:3px;background:#fff;">
            <button class="btn btn-sm" type="submit" title="এই ছবি রিপ্লেস করুন (URL অপরিবর্তিত)"><i class="fas fa-sync-alt"></i> রিপ্লেস</button>
          </form>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
