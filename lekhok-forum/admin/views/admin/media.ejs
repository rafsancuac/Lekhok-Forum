<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>মিডিয়া লাইব্রেরি | লেখক ফোরাম</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
  <style>
    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; padding: 16px; }
    .media-card { border: 1px solid #e5e7eb; border-radius: 5px; overflow: hidden; background: #fff; }
    .media-card img { width: 100%; height: 110px; object-fit: cover; display: block; background: #f3f4f6; }
    .media-card .mc-body { padding: 8px 10px; font-size: .75rem; color: #6b7280; }
    .media-card .mc-name { font-weight: 700; color: #111827; font-size: .78rem; word-break: break-all; }
    .media-card .mc-actions { display: flex; gap: 6px; padding: 0 10px 10px; }
  </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1><i class="fas fa-photo-film"></i> মিডিয়া লাইব্রেরি</h1>
      <p class="subtitle">আপলোড করা সব ছবি — URL কপি, প্রিভিউ ও ডিলিট (<%= items.length %> টি)</p>
    </div>
  </div>
  <% if (typeof saved !== 'undefined' && saved) { %><div class="flash ok"><i class="fas fa-check-circle"></i> ছবি মুছে ফেলা হয়েছে।</div><% } %>
  <div class="card" style="padding:0;">
    <% if (!items.length) { %>
    <div class="empty"><i class="fas fa-photo-film"></i><p>কোনো আপলোড নেই।</p></div>
    <% } else { %>
    <div class="media-grid">
      <% items.forEach(m => { %>
      <div class="media-card">
        <img src="<%= m.url %>" loading="lazy" alt="">
        <div class="mc-body">
          <div class="mc-name"><%= m.name %></div>
          <div><%= (m.size / 1024).toFixed(0) %> KB · <%= m.mtime %></div>
        </div>
        <div class="mc-actions">
          <button class="btn btn-sm" type="button" onclick="navigator.clipboard.writeText(location.origin + '<%= m.url %>').then(()=>alert('URL কপি হয়েছে ✓'))"><i class="fas fa-link"></i> URL</button>
          <form method="POST" action="/admin/media/delete" onsubmit="return confirm('ছবিটি মুছে ফেলবেন? যেসব জায়গায় ব্যবহার হয়েছে সেখানে ভাঙা দেখাবে।');">
            <input type="hidden" name="url" value="<%= m.url %>">
            <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash"></i></button>
          </form>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
