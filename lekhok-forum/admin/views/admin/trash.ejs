<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ট্র্যাশ | লেখক ফোরাম</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" /><%# session136: টোকেন-রেজোলিউশন (var(--lf-*) admin.css) %>
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>">
  <style>
    .tr-prev { margin: 6px 0 0; padding: 10px 14px; background: #f9fafb; border: 1px dashed #d1d5db; border-radius: 5px; font-size: .8rem; }
    .tr-prev div { margin: 2px 0; }
    .tr-prev b { color: #374151; }
  </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <div>
      <h1><i class="fas fa-trash-can"></i> ট্র্যাশ (সফট-ডিলিট)</h1>
      <p class="subtitle">মুছে ফেলা আইটেম ৩০ দিন পর্যন্ত এখানে থাকে — ফেরত নেওয়া বা স্থায়ীভাবে মুছে ফেলা যায়</p>
    </div>
    <form method="GET" style="display:flex;gap:8px;flex-wrap:wrap;">
      <input type="search" name="q" value="<%= q42 %>" placeholder="খুঁজুন…" style="padding:9px 12px;border:1px solid #d1d5db;border-radius:5px;font-family:inherit;">
      <select name="table" style="padding:9px 10px;border:1px solid #d1d5db;border-radius:5px;font-family:inherit;">
        <option value="">সব টেবিল</option>
        <% ((typeof tables43 !== 'undefined' && tables43) || []).forEach(t => { %>
        <option value="<%= t.table_name %>" <%= (typeof tbl43 !== 'undefined' && tbl43 === t.table_name) ? 'selected' : '' %>><%= t.table_name %> (<%= t.c %>)</option>
        <% }); %>
      </select>
      <button class="btn btn-sm" type="submit"><i class="fas fa-filter"></i> ফিল্টার</button>
    </form>
  </div>

  <% if (typeof restoredFlag !== 'undefined' && restoredFlag) { %><div class="flash ok"><i class="fas fa-undo"></i> <%= restoredFlag %> টি আইটেম ফেরত দেওয়া হয়েছে।</div><% } %>
  <% if (typeof purgeN !== 'undefined' && purgeN) { %><div class="flash ok"><i class="fas fa-fire"></i> <%= purgeN %> টি আইটেম স্থায়ীভাবে মুছে ফেলা হয়েছে।</div><% } %>

  <%# ── সেশন ১৯২: নির্বাচিত-আইটেম বাল্ক ফেরত/স্থায়ী-ডিলিট (মার্ক-অল/আনমার্ক-অল) — অ্যাডমিন-ভিউতে ── %>
  <% if (!(typeof moderatorView !== 'undefined' && moderatorView)) { %>
  <form method="POST" action="/admin/trash/bulk-restore" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-primary btn-sm" data-bulk-msg="নির্বাচিত আইটেমগুলো ট্র্যাশ থেকে ফেরত আনা হবে?"><i class="fas fa-undo"></i> রিস্টোর</button>
    <button type="submit" formaction="/admin/trash/bulk-purge" class="btn btn-danger btn-sm" data-bulk-msg="⚠️ সতর্কতা: নির্বাচিত আইটেমগুলো ডাটাবেজ থেকে চিরতরে মুছে যাবে — ফেরত আনা যাবে না! নিশ্চিত?"><i class="fas fa-fire"></i> স্থায়ী ডিলিট</button>
  </form>
  <% } %>

  <div style="display:flex;gap:10px;margin:0 0 14px;flex-wrap:wrap;">
    <form method="POST" action="<%= (typeof moderatorView !== 'undefined' && moderatorView) ? '/moderator' : '/admin' %>/trash/restore-all">
      <button class="btn btn-primary btn-sm" type="submit"><i class="fas fa-undo-alt"></i> সব ফেরত</button>
    </form>
    <% if (typeof tbl43 !== 'undefined' && tbl43) { %>
    <form method="POST" action="<%= (typeof moderatorView !== 'undefined' && moderatorView) ? '/moderator' : '/admin' %>/trash/restore-all">
      <input type="hidden" name="table" value="<%= tbl43 %>">
      <button class="btn btn-sm" type="submit"><i class="fas fa-undo"></i> "<%= tbl43 %>"-এর সব ফেরত</button>
    </form>
    <% } %>
  </div>

  <div class="card" style="padding:0;overflow:hidden;">
    <% if (!rows.length) { %>
    <div class="empty"><i class="fas fa-trash-can"></i><p>ট্র্যাশ খালি — ডিলিট করা আইটেম এখানে ৩০ দিন থাকবে।</p></div>
    <% } else { %>
    <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th style="width:34px;"><input type="checkbox" data-bulk-all aria-label="সব সিলেক্ট/আনসিলেক্ট" title="সব মার্ক / সব আনমার্ক"></th><th style="width:60px;">আইডি</th><th style="width:150px;">টেবিল</th><th>স্ন্যাপশট</th><th style="width:130px;">মুছেছেন</th><th style="width:140px;">সময়</th><th style="width:170px;">অ্যাকশন</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(r => {
             let o = {};
             try { o = JSON.parse(r.payload); } catch (e) {}
             const prev = o.title || o.name || o.email || '';
             const base = (typeof moderatorView !== 'undefined' && moderatorView) ? '/moderator' : '/admin';
        %>
        <tr>
          <td style="width:34px;"><input type="checkbox" name="bulk_ids" value="<%= r.id %>" aria-label="সিলেক্ট"></td>
          <td>#<%= r.id %></td>
          <td><code><%= r.table_name %></code></td>
          <td>
            <details>
              <summary style="cursor:pointer;"><strong><%= String(prev).slice(0, 60) %></strong> <span style="color:#6b7280;font-size:.75rem;">(বিস্তারিত দেখুন)</span></summary>
              <div class="tr-prev">
                <% Object.keys(o).slice(0, 14).forEach(k => { %>
                <div><b><%= k %>:</b> <%= String(o[k] == null ? '' : o[k]).slice(0, 120) %></div>
                <% }); %>
              </div>
            </details>
          </td>
          <td><%= r.deleted_by_name || '—' %></td>
          <td><%= r.deleted_at %></td>
          <td style="white-space:nowrap;">
            <form method="POST" action="<%= base %>/trash/<%= r.id %>/restore" style="display:inline;">
              <button class="btn btn-sm btn-primary" type="submit"><i class="fas fa-undo"></i> ফেরত</button>
            </form>
            <% if (!(typeof moderatorView !== 'undefined' && moderatorView)) { %>
            <form method="POST" action="/admin/trash/<%= r.id %>/purge" style="display:inline;">
              <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-fire"></i> স্থায়ী</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
