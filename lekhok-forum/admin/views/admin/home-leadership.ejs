<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — হোম নেতৃত্ব ব্যবস্থাপনা</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/tokens.css?v=<%= AV %>" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
  <style>
    /* সেশন ৫৫: হোম-নেতৃত্ব প্যানেল — সেকশন-ভিত্তিক স্লট-গ্রিড।
       সেশন ৬২ (এই সংস্করণ): পপ-আপ-মডাল সম্পূর্ণ বাদ — প্রতিটি কার্ডের ভেতরেই
       ইনলাইন-এডিটর; সেভ/ত্রুটির প্রতিক্রিয়া কার্ডের ভেতরেই (alert-শূন্য);
       খালি-স্লটে সরাসরি-ইনপুট (নতুন সদস্য-রো স্বয়ংক্রিয়-তৈরি); কার্যবর্ষ ড্রপডাউন। */
    .hl-section { margin-bottom: 34px; }
    .hl-section-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 6px; }
    .hl-section-head h2 { margin: 0; font-size: 17px; display: flex; align-items: center; gap: 8px; }
    .hl-section-head h2 i { color: #059669; }
    .hl-section-head .hint { font-size: 12px; color: #64748b; }
    .hl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
    /* hidden-অ্যাট্রিবিউট যেন লেখক-স্টাইল (display:inline-flex ইত্যাদি) দিয়ে চাপা না পড়ে */
    .hl-slot [hidden] { display: none !important; }
    .hl-slot { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; display: flex; flex-direction: column; gap: 10px; transition: box-shadow .15s, border-color .15s; }
    .hl-slot:hover { box-shadow: 0 6px 18px rgba(15,23,42,.08); border-color: #a7f3d0; }
    .hl-slot.editing { border-color: #10b981; box-shadow: 0 0 0 2px rgba(16,185,129,.18); }
    /* সেশন ৬৩: প্রতি-স্লট হোম-ভিজিবিলিটি সুইচ — অন = সবুজ/দৃশ্যমান, অফ = ধূসর/লুকানো;
       লুকানো কার্ড কিছুটা ম্লাট (opacity) — ডাটা না-হারিয়ে শুধু হোম-প্রদর্শন বন্ধ */
    .hl-vis { display: inline-flex; align-items: center; gap: 6px; }
    .hl-vis-label { font-size: 10.5px; font-weight: 700; color: #059669; white-space: nowrap; }
    .hl-vis.is-off .hl-vis-label { color: #94a3b8; }
    .hl-switch { width: 36px; height: 20px; border-radius: 999px; background: #10b981; border: none; padding: 2px; cursor: pointer; display: inline-flex; align-items: center; transition: background .18s; flex-shrink: 0; }
    .hl-switch .hl-knob { width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(15,23,42,.25); transform: translateX(16px); transition: transform .18s; }
    .hl-switch.off { background: #cbd5e1; }
    .hl-switch.off .hl-knob { transform: translateX(0); }
    .hl-switch:disabled { opacity: .55; cursor: wait; }
    .hl-slot.vis-hidden { opacity: .62; }
    .hl-slot.vis-hidden:hover { opacity: 1; }
    .hl-slot-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .hl-slot-tag { align-self: flex-start; font-size: 11px; font-weight: 700; color: #047857; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 999px; padding: 3px 10px; }
    .hl-okbadge { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: #065f46; background: #d1fae5; border: 1px solid #6ee7b7; border-radius: 999px; padding: 3px 9px; }
    .hl-errbadge { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: #991b1b; background: #fee2e2; border: 1px solid #fecaca; border-radius: 999px; padding: 3px 9px; }
    .hl-slot-id { font-size: 11px; color: #94a3b8; }
    .hl-person { display: flex; align-items: center; gap: 12px; }
    .hl-photo { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; background: #f8fafc; flex-shrink: 0; }
    .hl-person h3 { margin: 0; font-size: 14.5px; }
    .hl-person .role { margin: 2px 0 0; font-size: 12px; color: #059669; font-weight: 600; }
    .hl-person .term { margin: 1px 0 0; font-size: 11px; color: #64748b; }
    .hl-bani { font-size: 12px; color: #475569; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 10px; margin: 0; }
    .hl-src { font-size: 10.5px; color: #94a3b8; display: inline-flex; align-items: center; gap: 4px; }
    .hl-actions { margin-top: auto; display: flex; gap: 8px; align-items: center; justify-content: space-between; }
    /* খালি-স্লটের বন্ধুত্বপূর্ণ নোট (সেশন ৬২: হলুদ-সতর্কবার্তার বদলে সবুজ নির্দেশনা) */
    .hl-empty-new { font-size: 12px; color: #047857; background: #f0fdf4; border: 1.5px dashed #6ee7b7; border-radius: 8px; padding: 12px 12px; text-align: center; }
    .hl-empty-new i { font-size: 15px; display: block; margin-bottom: 5px; color: #10b981; }
    .hl-empty-new strong { display: block; font-size: 12.5px; margin-bottom: 2px; }
    .hl-empty-new span.sub { color: #64748b; font-size: 11px; }
    /* ইনলাইন-এডিটর */
    .hl-edit { display: flex; flex-direction: column; gap: 9px; }
    .hl-edit[hidden] { display: none; }
    .hl-photo-edit { display: flex; gap: 12px; align-items: center; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 9px 10px; }
    .hl-photo-preview { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2px solid #a7f3d0; background: #fff; flex-shrink: 0; }
    .hl-fieldstack { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 0; }
    .hl-fieldstack input[type="file"] { font-size: 11px; max-width: 100%; }
    .hl-fieldstack small { color: #64748b; font-size: 10.5px; line-height: 1.4; }
    .hl-edit .form-group { margin: 0; }
    .hl-edit label { font-size: 11.5px; font-weight: 700; color: #475569; margin-bottom: 3px; display: block; }
    .hl-edit input[type="text"], .hl-edit input[type="url"], .hl-edit input[type="email"],
    .hl-edit select, .hl-edit textarea { width: 100%; font-size: 12.5px; padding: 7px 9px; border: 1px solid #cbd5e1; border-radius: 7px; background: #fff; color: #0f172a; outline: none; transition: border-color .12s, box-shadow .12s; }
    .hl-edit input:focus, .hl-edit select:focus, .hl-edit textarea:focus { border-color: #10b981; box-shadow: 0 0 0 2px rgba(16,185,129,.14); }
    .hl-edit select { cursor: pointer; }
    .hl-edit textarea { resize: vertical; min-height: 52px; }
    .hl-extra { border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 10px; background: #fcfcfd; }
    .hl-extra summary { font-size: 11.5px; font-weight: 700; color: #64748b; cursor: pointer; user-select: none; display: flex; align-items: center; gap: 6px; }
    .hl-extra[open] summary { margin-bottom: 8px; }
    .hl-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    @media (max-width: 560px) { .hl-row2 { grid-template-columns: 1fr; } }
    .hl-sync { display: flex; align-items: flex-start; gap: 7px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 7px; padding: 7px 9px; font-size: 11.5px; color: #166534; }
    .hl-sync label { margin: 0 !important; cursor: pointer; font-weight: 600 !important; }
    .hl-statusline { font-size: 11.5px; min-height: 16px; font-weight: 600; }
    .hl-statusline.err { color: #b91c1c; }
    .hl-edit-actions { display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid #e2e8f0; padding-top: 10px; }
    .hl-banner { border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: 13.5px; }
    .hl-banner.ok { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .hl-banner.err { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    /* সেশন ৬৪: অতিরিক্ত-উপদেষ্টা কার্ড + নতুন-যোগ টাইল */
    .hl-addtile { border: 1.5px dashed #6ee7b7; border-radius: 10px; background: #f0fdf4; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 20px 14px; min-height: 130px; text-align: center; cursor: pointer; transition: background .15s, border-color .15s; }
    .hl-addtile:hover { background: #ecfdf5; border-color: #10b981; }
    .hl-addtile i { font-size: 20px; color: #10b981; }
    .hl-addtile strong { font-size: 13px; color: #065f46; }
    .hl-addtile span.sub { font-size: 11px; color: #64748b; }
    .hl-addtile.editing { cursor: default; align-items: stretch; text-align: left; background: #fff; }
    .hl-delbtn { font-size: 11px; color: #e11d48; background: none; border: none; cursor: pointer; padding: 4px 2px; font-weight: 600; }
    .hl-delbtn:hover { text-decoration: underline; }
    .hl-delbtn.armed { color: #fff; background: #e11d48; border-radius: 6px; padding: 4px 8px; }
  </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>হোম নেতৃত্ব ব্যবস্থাপনা</h1>
    <p>হোমপেজের <strong>“নেতৃত্বের ধারা”</strong> ও <strong>“বর্তমান নেতৃত্ব”</strong> সেকশনের কার্ডগুলো — প্রতিটি কার্ডের ভেতরেই <strong>সম্পাদনা</strong> চেপে নাম, ছবি, পদবি, কার্যবর্ষ ও বাণী বদলান; সংরক্ষণের সাথে-সাথে হোমপেজে দেখা যাবে। প্রতিটি কার্ডের কোণার <strong>অন/অফ সুইচে</strong> ক্লিক করলেই সেটি হোমপেজে দেখা বা লুকানো যায় (যেমন: উপদেষ্টা নিয়োগ না-দেওয়া পর্যন্ত উপদেষ্টা-কার্ড লুকিয়ে রাখুন)। <strong>“＋ নতুন উপদেষ্টা যোগ করুন”</strong> টাইল থেকে যত-খুশি নতুন উপদেষ্টা যোগ করা যায় — তৈরির পর টগল-অন করলেই হোমপেজে চলে আসবে
      | <a href="/" target="_blank"><i class="fas fa-up-right-from-square"></i> হোমপেজ দেখুন</a></p>
  </div>

  <% if (saved) { %><div class="hl-banner ok"><i class="fas fa-circle-check"></i> সফলভাবে সংরক্ষিত হয়েছে — হোমপেজে এখনই দেখা যাবে।</div><% } %>
  <% if (error) { %><div class="hl-banner err"><i class="fas fa-triangle-exclamation"></i> <%= error %></div><% } %>

  <% ['legacy', 'current'].forEach(sec => { const secSlots = slots.filter(s => s.section === sec); %>
  <div class="hl-section">
    <div class="hl-section-head">
      <h2><i class="fas <%= sec === 'legacy' ? 'fa-landmark' : 'fa-users-rectangle' %>"></i> <%= sec === 'legacy' ? 'নেতৃত্বের ধারা (প্রতিষ্ঠাতা ও প্রতিষ্ঠাকালীন উপদেষ্টা)' : 'বর্তমান নেতৃত্ব (কার্যনির্বাহী ও উপদেষ্টা)' %></h2>
      <% if (sec === 'current' && latestTerm) { %><span class="hint">সর্বশেষ কার্যবর্ষ: <strong><%= latestTerm %></strong></span><% } %>
    </div>
    <div class="hl-grid">
      <% secSlots.forEach(slot => {
           const m = slot.member;
           const displayName = m ? (m.user_full_name || m.name) : '';
           const displayImg  = m ? (m.user_avatar_url || m.image_url || '/assets/img/avatar-placeholder.svg?v=2') : '/assets/img/avatar-placeholder.svg?v=2';
           const shownBani   = m ? ((m.message && String(m.message).trim()) ? String(m.message) : ((m.bio && String(m.bio).trim()) ? String(m.bio) : slot.statement)) : slot.statement;
           const baniSource  = m ? ((m.message && String(m.message).trim()) ? 'বাণী ফিল্ড' : ((m.bio && String(m.bio).trim()) ? 'বায়ো' : 'ফলব্যাক-বাণী')) : 'ফলব্যাক-বাণী';
           const selTerm     = (m && m.term_year) ? m.term_year : (sec === 'current' && latestTerm ? latestTerm : '');
      %>
      <div class="hl-slot<%= hiddenSlots.includes(slot.key) ? ' vis-hidden' : '' %>" id="slot-<%= slot.key %>" data-slot="<%= slot.key %>">
        <div class="hl-slot-head">
          <span class="hl-slot-tag"><%= slot.title %></span>
          <span class="hl-okbadge" data-role="saveOk" hidden><i class="fas fa-check"></i> সংরক্ষিত হয়েছে</span>
          <%# সেশন ৬৩: অন/অফ সুইচ — ক্লিকেই হোমপেজে দেখা/লুকানো (রিলোড-পপআপ-শূন্য) %>
          <div class="hl-vis <%= hiddenSlots.includes(slot.key) ? 'is-off' : '' %>" data-role="visWrap">
            <span class="hl-vis-label" data-role="visLabel"><%= hiddenSlots.includes(slot.key) ? 'লুকানো' : 'দৃশ্যমান' %></span>
            <button type="button" class="hl-switch <%= hiddenSlots.includes(slot.key) ? 'off' : '' %>" data-vis data-slot="<%= slot.key %>" aria-pressed="<%= hiddenSlots.includes(slot.key) ? 'false' : 'true' %>" aria-label="হোমপেজে কার্ড দেখান বা লুকান" title="<%= hiddenSlots.includes(slot.key) ? 'হোমপেজে দেখাতে ক্লিক করুন' : 'হোমপেজ থেকে লুকাতে ক্লিক করুন' %>"><span class="hl-knob"></span></button>
          </div>
        </div>

        <%# ═══════════ ভিউ-মোড ═══════════ %>
        <div data-role="view">
          <div data-role="person" <%= m ? '' : 'hidden' %>>
            <div class="hl-person">
              <img class="hl-photo" data-role="photo" src="<%= displayImg %>" alt="<%= displayName %>" onerror="this.src='/assets/img/avatar-placeholder.svg?v=2'">
              <div>
                <h3 data-role="name"><%= displayName %></h3>
                <p class="role" data-role="role"><%= m ? (m.role || '—') : '' %></p>
                <p class="term" data-role="term"><%= m ? ((m.term_year ? '(' + m.term_year + ')' : '') + (m.user_id ? ' · লিংকড অ্যাকাউন্ট' : '')) : '' %></p>
              </div>
            </div>
          </div>
          <div class="hl-empty-new" data-role="empty" <%= m ? 'hidden' : '' %>>
            <i class="fas fa-user-plus"></i>
            <strong>সদস্য যুক্ত নেই</strong>
            <span class="sub">নিচের <strong>তথ্য দিন</strong> বাটনে ক্লিক করে সরাসরি নাম, ছবি, পদবি ও বাণী লিখে সংরক্ষণ করুন — স্লটেই বসে যাবে।</span>
          </div>
          <p class="hl-bani" data-role="bani" <%= m ? '' : 'hidden' %>><%= m ? (shownBani || '—') : '' %></p>
          <span class="hl-src" data-role="src" <%= m ? '' : 'hidden' %>><i class="fas fa-quote-left"></i> উৎস: <%= baniSource %></span>
        </div>

        <%# ═══════════ ইনলাইন-এডিটর (কার্ডের ভেতরেই — কোনো পপ-আপ নেই) ═══════════ %>
        <form class="hl-edit" hidden method="POST" action="/admin/home-leadership/slot" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="slot" value="<%= slot.key %>">
          <input type="hidden" name="member_id" value="<%= m ? m.id : '' %>">

          <div class="hl-photo-edit">
            <img class="hl-photo-preview" data-role="preview" src="<%= displayImg %>" alt="প্রিভিউ" onerror="this.src='/assets/img/avatar-placeholder.svg?v=2'">
            <div class="hl-fieldstack">
              <input type="file" name="member_photo" data-role="file" accept="image/jpeg,image/png,image/webp,image/gif">
              <input type="url" name="image_url" data-role="url" placeholder="অথবা ছবির সরাসরি লিংক (https://…)" value="<%= m ? (m.image_url || '') : '' %>">
              <small>ফাইল দিলে সেটাই প্রাধান্য পাবে (WebP-অপটিমাইজ); নইলে URL।</small>
            </div>
          </div>

          <div class="hl-row2">
            <div class="form-group">
              <label>নাম <%= m ? '*' : '' %></label>
              <input type="text" name="name" required placeholder="পূর্ণ নাম লিখুন…" value="<%= m ? (m.name || '') : '' %>">
            </div>
            <div class="form-group">
              <label>পদবি</label>
              <input type="text" name="role" placeholder="যেমন: সভাপতি" value="<%= m ? (m.role || '') : '' %>">
            </div>
          </div>

          <div class="hl-row2">
            <div class="form-group">
              <label>কার্যবর্ষ</label>
              <select name="term_year">
                <option value="">(কার্যবর্ষ নেই)</option>
                <% (termOptions || []).forEach(t => { %>
                <option value="<%= t %>" <%= t === selTerm ? 'selected' : '' %>><%= t %></option>
                <% }); %>
                <% if (selTerm && !(termOptions || []).includes(selTerm)) { %>
                <option value="<%= selTerm %>" selected><%= selTerm %></option>
                <% } %>
              </select>
            </div>
            <div class="form-group">
              <label>আইডি / প্রোফাইল লিংক</label>
              <input type="url" name="profile_url" placeholder="https://facebook.com/… বা /profile/username" value="<%= m ? (m.profile_url || '') : '' %>">
            </div>
          </div>

          <div class="form-group">
            <label>বাণী (কার্ডে প্রাধান্য পায়)</label>
            <textarea name="message" rows="3" placeholder="এই লেখাটিই কার্ডে দেখাবে — খালি রাখলে বায়ো, তারপর ফলব্যাক-বাণী"><%= m ? (m.message || '') : '' %></textarea>
          </div>

          <div class="form-group">
            <label>ফলব্যাক-বাণী (বাণী ও বায়ো খালি হলে এটা দেখাবে)</label>
            <textarea name="statement" rows="2"><%= slot.statement || '' %></textarea>
          </div>

          <details class="hl-extra">
            <summary><i class="fas fa-link"></i> সোশ্যাল-লিংক ও অ্যাকাউন্ট-সিঙ্ক (ঐচ্ছিক)</summary>
            <div class="hl-row2">
              <div class="form-group"><label>ফেসবুক</label><input type="url" name="social_fb" value="<%= m ? (m.social_fb || '') : '' %>"></div>
              <div class="form-group"><label>LinkedIn</label><input type="url" name="social_linkedin" value="<%= m ? (m.social_linkedin || '') : '' %>"></div>
            </div>
            <div class="form-group"><label>ইমেইল</label><input type="email" name="social_email" value="<%= m ? (m.social_email || '') : '' %>"></div>
            <% if (m && m.user_id) { %>
            <div class="hl-sync">
              <input type="checkbox" name="sync_profile" id="sync-<%= slot.key %>" value="1">
              <label for="sync-<%= slot.key %>">এই নাম ও ছবি লিংকড অ্যাকাউন্টের প্রোফাইলেও বসিয়ে দিন (<%= m.user_full_name || displayName %>)</label>
            </div>
            <% } %>
          </details>

          <div class="hl-statusline" data-role="status"></div>
          <div class="hl-edit-actions">
            <button type="button" class="btn btn-sm" data-cancel>বাতিল</button>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-floppy-disk"></i> সংরক্ষণ করুন</button>
          </div>
        </form>

        <div class="hl-actions">
          <span class="hl-slot-id">স্লট: <code><%= slot.key %></code></span>
          <button type="button" class="btn btn-primary btn-sm" data-edit>
            <i class="fas fa-pen-to-square"></i> <%= m ? 'সম্পাদনা' : 'তথ্য দিন' %>
          </button>
        </div>
      </div>
      <% }); %>
      <%# ═══════════ সেশন ৬৪: অতিরিক্ত-উপদেষ্টা কার্ড (বাউন্ডারি-কার্যবর্ষের ৩য়+ সদস্য) ═══════════
          home_extra_members (opt-in)-এ থাকলেই হোমপেজে দেখায়; সম্পাদনা/টগল/ডিলিট-সমর্থ।
          এডিট-ফর্ম /home-leadership/slot-এই POST করে (slot=বেস-স্লট শুধু মেটা-ফলব্যাকে)। %>
      <% const extras64 = (sec === 'legacy' ? (typeof legacyExtras !== 'undefined' ? legacyExtras : []) : (typeof currentExtras !== 'undefined' ? currentExtras : [])); %>
      <% const baseSlot64 = sec === 'legacy' ? 'founding_advisor_2' : 'current_advisor_2'; %>
      <% const extraActive64 = (typeof extraActive !== 'undefined' ? extraActive : []); %>
      <% extras64.forEach(x => { const xActive = extraActive64.includes(Number(x.id)); const xName = x.user_full_name || x.name || ''; const xImg = x.user_avatar_url || x.image_url || '/assets/img/avatar-placeholder.svg?v=2'; const xBani = (x.message && String(x.message).trim()) ? x.message : (x.bio || ''); %>
      <div class="hl-slot<%= xActive ? '' : ' vis-hidden' %>" id="extra-<%= x.id %>" data-extra="<%= x.id %>">
        <div class="hl-slot-head">
          <span class="hl-slot-tag">অতিরিক্ত উপদেষ্টা</span>
          <span class="hl-okbadge" data-role="saveOk" hidden><i class="fas fa-check"></i> সংরক্ষিত হয়েছে</span>
          <div class="hl-vis <%= xActive ? '' : 'is-off' %>" data-role="visWrap">
            <span class="hl-vis-label" data-role="visLabel"><%= xActive ? 'দৃশ্যমান' : 'লুকানো' %></span>
            <button type="button" class="hl-switch <%= xActive ? '' : 'off' %>" data-vis aria-pressed="<%= xActive ? 'true' : 'false' %>" aria-label="হোমপেজে কার্ড দেখান বা লুকান" title="<%= xActive ? 'হোমপেজ থেকে লুকাতে ক্লিক করুন' : 'হোমপেজে দেখাতে ক্লিক করুন' %>"><span class="hl-knob"></span></button>
          </div>
        </div>
        <div data-role="view">
          <div data-role="person">
            <div class="hl-person">
              <img class="hl-photo" data-role="photo" src="<%= xImg %>" alt="<%= xName %>" onerror="this.src='/assets/img/avatar-placeholder.svg?v=2'">
              <div>
                <h3 data-role="name"><%= xName || '(নাম খালি)' %></h3>
                <p class="role" data-role="role"><%= x.role || '—' %></p>
                <p class="term" data-role="term"><%= x.term_year ? '(' + x.term_year + ')' : '' %><%= x.user_id ? ' · লিংকড অ্যাকাউন্ট' : '' %></p>
              </div>
            </div>
          </div>
          <p class="hl-bani" data-role="bani" <%= xBani ? '' : 'hidden' %>><%= xBani || '—' %></p>
          <span class="hl-src" data-role="src" <%= xBani ? '' : 'hidden' %>><i class="fas fa-quote-left"></i> উৎস: <%= (x.message && String(x.message).trim()) ? 'বাণী ফিল্ড' : 'বায়ো' %></span>
        </div>
        <form class="hl-edit" hidden method="POST" action="/admin/home-leadership/slot" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="slot" value="<%= baseSlot64 %>">
          <input type="hidden" name="member_id" value="<%= x.id %>">
          <div class="hl-photo-edit">
            <img class="hl-photo-preview" data-role="preview" src="<%= xImg %>" alt="প্রিভিউ" onerror="this.src='/assets/img/avatar-placeholder.svg?v=2'">
            <div class="hl-fieldstack">
              <input type="file" name="member_photo" data-role="file" accept="image/jpeg,image/png,image/webp,image/gif">
              <input type="url" name="image_url" data-role="url" placeholder="অথবা ছবির সরাসরি লিংক (https://…)" value="<%= x.image_url || '' %>">
              <small>ফাইল দিলে সেটাই প্রাধান্য পাবে (WebP-অপটিমাইজ); নইলে URL।</small>
            </div>
          </div>
          <div class="hl-row2">
            <div class="form-group">
              <label>নাম *</label>
              <input type="text" name="name" required placeholder="পূর্ণ নাম লিখুন…" value="<%= x.name || '' %>">
            </div>
            <div class="form-group">
              <label>পদবি</label>
              <input type="text" name="role" placeholder="যেমন: উপদেষ্টা" value="<%= x.role || '' %>">
            </div>
          </div>
          <div class="hl-row2">
            <div class="form-group">
              <label>কার্যবর্ষ</label>
              <select name="term_year">
                <option value="">(কার্যবর্ষ নেই)</option>
                <% (termOptions || []).forEach(t => { %>
                <option value="<%= t %>" <%= t === x.term_year ? 'selected' : '' %>><%= t %></option>
                <% }); %>
                <% if (x.term_year && !(termOptions || []).includes(x.term_year)) { %>
                <option value="<%= x.term_year %>" selected><%= x.term_year %></option>
                <% } %>
              </select>
            </div>
            <div class="form-group">
              <label>আইডি / প্রোফাইল লিংক</label>
              <input type="url" name="profile_url" placeholder="https://facebook.com/… বা /profile/username" value="<%= x.profile_url || '' %>">
            </div>
          </div>
          <div class="form-group">
            <label>বাণী (কার্ডে প্রাধান্য পায়)</label>
            <textarea name="message" rows="3" placeholder="এই লেখাটিই কার্ডে দেখাবে"><%= x.message || '' %></textarea>
          </div>
          <details class="hl-extra">
            <summary><i class="fas fa-link"></i> সোশ্যাল-লিংক (ঐচ্ছিক)</summary>
            <div class="hl-row2">
              <div class="form-group"><label>ফেসবুক</label><input type="url" name="social_fb" value="<%= x.social_fb || '' %>"></div>
              <div class="form-group"><label>LinkedIn</label><input type="url" name="social_linkedin" value="<%= x.social_linkedin || '' %>"></div>
            </div>
            <div class="form-group"><label>ইমেইল</label><input type="email" name="social_email" value="<%= x.social_email || '' %>"></div>
          </details>
          <div class="hl-statusline" data-role="status"></div>
          <div class="hl-edit-actions">
            <button type="button" class="btn btn-sm" data-cancel>বাতিল</button>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-floppy-disk"></i> সংরক্ষণ করুন</button>
          </div>
        </form>
        <div class="hl-actions">
          <% if (!x.user_id && (!x.account_status || x.account_status === 'unclaimed')) { %>
          <button type="button" class="hl-delbtn" data-del data-member="<%= x.id %>">মুছে ফেলুন</button>
          <% } else { %>
          <span class="hl-slot-id">লিংকড — শুধু লুকানো যাবে</span>
          <% } %>
          <button type="button" class="btn btn-primary btn-sm" data-edit>
            <i class="fas fa-pen-to-square"></i> সম্পাদনা
          </button>
        </div>
      </div>
      <% }); %>
      <%# ═══════════ সেশন ৬৪: "＋ নতুন উপদেষ্টা যোগ করুন" টাইল — যত-খুশি নতুন কার্ড ═══════════ %>
      <div class="hl-addtile" data-addtile data-group="<%= sec %>">
        <div data-role="addprompt">
          <i class="fas fa-user-plus"></i>
          <strong>＋ নতুন উপদেষ্টা / সদস্য যোগ করুন</strong>
          <span class="sub"><%= sec === 'legacy' ? 'প্রতিষ্ঠাকালীন উপদেষ্টা' : 'বর্তমান উপদেষ্টা' %> — তৈরির পর টগল-অন করলেই হোমপেজে দেখাবে</span>
        </div>
        <form class="hl-edit" hidden method="POST" action="/admin/home-leadership/extra" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="group" value="<%= sec %>">
          <div class="hl-photo-edit">
            <img class="hl-photo-preview" data-role="preview" src="/assets/img/avatar-placeholder.svg?v=2" alt="প্রিভিউ" onerror="this.src='/assets/img/avatar-placeholder.svg?v=2'">
            <div class="hl-fieldstack">
              <input type="file" name="member_photo" data-role="file" accept="image/jpeg,image/png,image/webp,image/gif">
              <input type="url" name="image_url" data-role="url" placeholder="অথবা ছবির সরাসরি লিংক (https://…)">
              <small>ছবি ঐচ্ছিক — খালি রাখলে অ্যাভাটার-প্লেসহোল্ডার দেখাবে।</small>
            </div>
          </div>
          <div class="hl-row2">
            <div class="form-group">
              <label>নাম *</label>
              <input type="text" name="name" required placeholder="পূর্ণ নাম লিখুন…">
            </div>
            <div class="form-group">
              <label>পদবি</label>
              <input type="text" name="role" placeholder="যেমন: উপদেষ্টা" value="উপদেষ্টা">
            </div>
          </div>
          <div class="form-group">
            <label>কার্যবর্ষ (খালি রাখলে <%= sec === 'legacy' ? 'প্রাচীনতম' : 'সর্বশেষ' %> কার্যবর্ষ ধরা হবে)</label>
            <select name="term_year">
              <option value="">(স্বয়ংক্রিয় — গ্রুপের বর্তমান কার্যবর্ষ)</option>
              <% (termOptions || []).forEach(t => { %>
              <option value="<%= t %>"><%= t %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>বাণী (ঐচ্ছিক)</label>
            <textarea name="message" rows="2" placeholder="কার্ডে দেখাতে চাইলে লিখুন"></textarea>
          </div>
          <div class="hl-statusline" data-role="status"></div>
          <div class="hl-edit-actions">
            <button type="button" class="btn btn-sm" data-cancel>বাতিল</button>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> তৈরি করুন</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<script>
/* সেশন ৬২ — ইনলাইন-এডিটর: কোনো মডাল নেই, কোনো alert() নেই।
   • সম্পাদনা → কার্ডের ভেতরেই ফর্ম; সংরক্ষণ → fetch + কার্ড ইন-প্লেস-আপডেট।
   • ফলস-এরর-ফিক্স: আগের কোড {s,j}-অবজেক্টে res.ok দেখত (সবসময় undefined) —
     ফলে সফল-সেভেও "সংরক্ষণ ব্যর্থ" অ্যালার্ট আসত। এখন স্ট্যাটাস-কোড যাচাই।
   • খালি-স্লটে নাম দিলে নতুন সদস্য-রো তৈরি হয় (created:true → member_id-বসানো)।
   সেশন ৬৩ — প্রতি-স্লট ভিজিবিলিটি-সুইচ: ক্লিকেই POST /home-leadership/visibility →
   settings 'home_hidden_slots' → হোমপেজে সাথে-সাথে কার্ড দেখা/লুকানো (রিলোড নেই)। */
(function () {
  var PLACEHOLDER = '/assets/img/avatar-placeholder.svg?v=2';

  function wireCard(card) {
    var view   = card.querySelector('[data-role="view"]');
    var form   = card.querySelector('form.hl-edit');
    var person = view.querySelector('[data-role="person"]');
    var empty  = view.querySelector('[data-role="empty"]');
    var bani   = view.querySelector('[data-role="bani"]');
    var src    = view.querySelector('[data-role="src"]');
    var okBadge  = card.querySelector('[data-role="saveOk"]');
    var statusEl = form.querySelector('[data-role="status"]');
    var editBtn  = card.querySelector('[data-edit]');
    var preview  = form.querySelector('[data-role="preview"]');
    var fileIn   = form.querySelector('[data-role="file"]');
    var urlIn    = form.querySelector('[data-role="url"]');
    var submitBtn = form.querySelector('button[type="submit"]');
    var okTimer = null;

    /* ── সেশন ৬৩: ভিজিবিলিটি-সুইচ — অপটিমিস্টিক টগল + সার্ভার-কনফার্ম; ব্যর্থে রোলব্যাক ──
       সেশন ৬৪: অতিরিক্ত-উপদেষ্টা (data-extra) হলে {member_id, active}-ব্রাঞ্চ —
       active = !willHide (সুইচ-অন = opt-in তালিকায়, অফ = বাইরে) */
    var visBtn   = card.querySelector('[data-vis]');
    var visWrap  = card.querySelector('[data-role="visWrap"]');
    var visLabel = card.querySelector('[data-role="visLabel"]');
    var isExtra64 = card.hasAttribute('data-extra');
    if (visBtn && visWrap && visLabel) {
      visBtn.addEventListener('click', function () {
        var willHide = !visBtn.classList.contains('off'); /* এখন অন → ক্লিকে অফ(লুকাও) */
        var oldLabel = visLabel.textContent;
        visBtn.disabled = true;
        /* অপটিমিস্টিক: সাথে-সাথে সুইচ-অবস্থা বদলাও */
        visBtn.classList.toggle('off', willHide);
        visWrap.classList.toggle('is-off', willHide);
        visLabel.textContent = willHide ? 'লুকানো' : 'দৃশ্যমান';
        visBtn.setAttribute('aria-pressed', willHide ? 'false' : 'true');
        card.classList.toggle('vis-hidden', willHide);
        var tok = (form.querySelector('input[name="_csrf"]') || {}).value || '';
        var body64 = isExtra64
          ? { member_id: card.getAttribute('data-extra'), active: !willHide }
          : { slot: card.getAttribute('data-slot'), hidden: willHide };
        fetch('/admin/home-leadership/visibility', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': tok },
          credentials: 'same-origin',
          body: JSON.stringify(body64)
        }).then(function (r) {
          return r.json().then(function (j) { return { s: r.status, j: j }; });
        }).then(function (res) {
          var ok = res.s >= 200 && res.s < 300 && res.j && res.j.ok;
          if (!ok) {
            /* রোলব্যাক — আগের-অবস্থায় ফিরে যাও */
            visBtn.classList.toggle('off', !willHide);
            visWrap.classList.toggle('is-off', !willHide);
            visLabel.textContent = oldLabel;
            visBtn.setAttribute('aria-pressed', willHide ? 'true' : 'false');
            card.classList.toggle('vis-hidden', !willHide);
            okBadge.innerHTML = '<i class="fas fa-triangle-exclamation"></i> টগল ব্যর্থ';
            okBadge.hidden = false;
            setTimeout(function () { okBadge.hidden = true; }, 2600);
          } else {
            showOk();
          }
          visBtn.disabled = false;
        }).catch(function () {
          visBtn.classList.toggle('off', !willHide);
          visWrap.classList.toggle('is-off', !willHide);
          visLabel.textContent = oldLabel;
          visBtn.disabled = false;
        });
      });
    }

    /* ── সেশন ৬৪: টু-স্টেপ-ডিলিট (শুধু অতিরিক্ত-উপদেষ্টা — পপ-আপ/confirm() শূন্য):
       ১ম-ক্লিকে বাটন লাল "নিশ্চিত?" (৩.৫সে-পরে নিজেই থিতিয়ে যায়), ২য়-ক্লিকে DELETE →
       সফল হলে কার্ড DOM-থেকেই সরে যায় */
    var delBtn64 = card.querySelector('[data-del]');
    if (delBtn64) {
      var disarm64 = null;
      delBtn64.addEventListener('click', function () {
        if (!delBtn64.classList.contains('armed')) {
          delBtn64.classList.add('armed');
          delBtn64.textContent = 'নিশ্চিতভাবে মুছবেন?';
          disarm64 = setTimeout(function () {
            delBtn64.classList.remove('armed');
            delBtn64.textContent = 'মুছে ফেলুন';
          }, 3500);
          return;
        }
        if (disarm64) clearTimeout(disarm64);
        delBtn64.disabled = true;
        var tok64 = (form.querySelector('input[name="_csrf"]') || {}).value || '';
        fetch('/admin/home-leadership/extra?id=' + encodeURIComponent(card.getAttribute('data-del') || delBtn64.getAttribute('data-member')), {
          method: 'DELETE',
          headers: { 'Accept': 'application/json', 'X-CSRF-Token': tok64 },
          credentials: 'same-origin'
        }).then(function (r) {
          return r.json().then(function (j) { return { s: r.status, j: j }; });
        }).then(function (res) {
          if (res.s >= 200 && res.s < 300 && res.j && res.j.ok) {
            card.remove();
          } else {
            delBtn64.disabled = false;
            delBtn64.classList.remove('armed');
            delBtn64.textContent = 'মুছে ফেলুন';
            okBadge.innerHTML = '<i class="fas fa-triangle-exclamation"></i> ' + ((res.j && res.j.error) || 'ডিলিট ব্যর্থ');
            okBadge.hidden = false;
            setTimeout(function () { okBadge.hidden = true; }, 3200);
          }
        }).catch(function () {
          delBtn64.disabled = false;
          delBtn64.classList.remove('armed');
          delBtn64.textContent = 'মুছে ফেলুন';
        });
      });
    }

    function enterEdit() {
      statusEl.textContent = ''; statusEl.classList.remove('err');
      okBadge.hidden = true;
      view.hidden = true; form.hidden = false; card.classList.add('editing');
      var f = form.querySelector('input[name="name"]');
      if (f && !f.value) f.focus();
    }
    function exitEdit() {
      form.hidden = true; view.hidden = false; card.classList.remove('editing');
      statusEl.textContent = ''; statusEl.classList.remove('err');
    }
    function showOk() {
      okBadge.hidden = false;
      if (okTimer) clearTimeout(okTimer);
      okTimer = setTimeout(function () { okBadge.hidden = true; }, 2600);
    }

    editBtn.addEventListener('click', function () {
      if (form.hidden) enterEdit(); else exitEdit();
    });
    form.querySelector('[data-cancel]').addEventListener('click', exitEdit);

    // ছবি-প্রিভিউ: ফাইল বাছলে সেটা, নইলে URL
    fileIn.addEventListener('change', function () {
      if (this.files && this.files[0]) {
        var r = new FileReader();
        r.onload = function (ev) { preview.src = ev.target.result; };
        r.readAsDataURL(this.files[0]);
        urlIn.value = '';
      }
    });
    urlIn.addEventListener('input', function () {
      var v = this.value.trim();
      preview.src = v || PLACEHOLDER;
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      statusEl.textContent = ''; statusEl.classList.remove('err');
      var old = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> সংরক্ষণ হচ্ছে…';
      var fd = new FormData(form);
      var tok = (form.querySelector('input[name="_csrf"]') || {}).value || '';
      fetch(form.action, {
        method: 'POST', body: fd,
        headers: { 'Accept': 'application/json', 'X-CSRF-Token': tok },
        credentials: 'same-origin'
      }).then(function (r) {
        return r.json().then(function (j) { return { s: r.status, j: j }; });
      }).then(function (res) {
        // ── ফিক্স: স্ট্যাটাস-কোড যাচাই (আগে res.ok — সবসময় undefined) ──
        var statusOk = res.s >= 200 && res.s < 300;
        if (statusOk && res.j && res.j.ok) {
          var d = res.j.display || {};
          var hasMember = !!(d.name || res.j.memberId);
          if (hasMember) {
            person.hidden = false; if (empty) empty.hidden = true; /* সেশন ৬৪: অতিরিক্ত-কার্ডে empty-নোড নেই */
            bani.hidden = false; src.hidden = false;
            if (d.name) view.querySelector('[data-role="name"]').textContent = d.name;
            if (d.img)  view.querySelector('[data-role="photo"]').src = d.img;
            view.querySelector('[data-role="role"]').textContent = d.role || '—';
            view.querySelector('[data-role="term"]').textContent = d.termText || '';
            view.querySelector('[data-role="bani"]').textContent = d.bani || '—';
            var srcEl = view.querySelector('[data-role="src"]');
            srcEl.innerHTML = '<i class="fas fa-quote-left"></i> উৎস: ' + (d.src || 'ফলব্যাক-বাণী');
            if (res.j.memberId) form.querySelector('input[name="member_id"]').value = res.j.memberId;
            editBtn.innerHTML = '<i class="fas fa-pen-to-square"></i> সম্পাদনা';
          }
          exitEdit();
          showOk();
          /* সেশন ১৭৯: জোড়ার কার্যবর্ষ-সিঙ্ক হলে ছোট-নোট (উদা: "জোড়ার পদের কার্যবর্ষও ২০২৬-২৭ করা হয়েছে") */
          if (res.j.note) statusEl.textContent = res.j.note;
          submitBtn.disabled = false; submitBtn.innerHTML = old;
        } else {
          statusEl.textContent = (res.j && res.j.error) ? res.j.error : 'সংরক্ষণ ব্যর্থ হয়েছে — আবার চেষ্টা করুন।';
          statusEl.classList.add('err');
          submitBtn.disabled = false; submitBtn.innerHTML = old;
        }
      }).catch(function (err) {
        console.error('hl save failed', err);
        statusEl.textContent = 'নেটওয়ার্ক সমস্যা — আবার চেষ্টা করুন।';
        statusEl.classList.add('err');
        submitBtn.disabled = false; submitBtn.innerHTML = old;
      });
    });
  }

  document.querySelectorAll('.hl-slot').forEach(wireCard);

  /* ── সেশন ৬৪: "＋ নতুন উপদেষ্টা" টাইল — টাইল-ক্লিকে ইনলাইন-ফর্ম; তৈরির পর
     নতুন কার্ডের অ্যাঙ্করে স্ক্রল-সহ রিলোড (কোনো পপ-আপ নেই)। ছবি-প্রিভিউ এক-ই নিয়ম। */
  document.querySelectorAll('[data-addtile]').forEach(function (tile) {
    var prompt64 = tile.querySelector('[data-role="addprompt"]');
    var aForm    = tile.querySelector('form.hl-edit');
    var aStatus  = aForm.querySelector('[data-role="status"]');
    var aFile    = aForm.querySelector('[data-role="file"]');
    var aUrl     = aForm.querySelector('[data-role="url"]');
    var aPrev    = aForm.querySelector('[data-role="preview"]');
    var aSubmit  = aForm.querySelector('button[type="submit"]');
    tile.addEventListener('click', function (ev) {
      if (ev.target.closest('form') || ev.target.closest('button') || ev.target.closest('a')) return;
      if (aForm.hidden) {
        prompt64.hidden = true;
        aForm.hidden = false;
        tile.classList.add('editing');
        var n64 = aForm.querySelector('input[name="name"]');
        if (n64) n64.focus();
      }
    });
    aForm.querySelector('[data-cancel]').addEventListener('click', function () {
      aForm.reset();
      aPrev.src = '/assets/img/avatar-placeholder.svg?v=2';
      aStatus.textContent = ''; aStatus.classList.remove('err');
      aForm.hidden = true;
      prompt64.hidden = false;
      tile.classList.remove('editing');
    });
    aFile.addEventListener('change', function () {
      if (this.files && this.files[0]) {
        var rr = new FileReader();
        rr.onload = function (ev2) { aPrev.src = ev2.target.result; };
        rr.readAsDataURL(this.files[0]);
        aUrl.value = '';
      }
    });
    aUrl.addEventListener('input', function () {
      aPrev.src = this.value.trim() || '/assets/img/avatar-placeholder.svg?v=2';
    });
    aForm.addEventListener('submit', function (e) {
      e.preventDefault();
      aStatus.textContent = ''; aStatus.classList.remove('err');
      var oldHtml64 = aSubmit.innerHTML;
      aSubmit.disabled = true;
      aSubmit.innerHTML = '<i class="fas fa-spinner fa-spin"></i> তৈরি হচ্ছে…';
      var fd64 = new FormData(aForm);
      var tok64 = (aForm.querySelector('input[name="_csrf"]') || {}).value || '';
      fetch(aForm.action, {
        method: 'POST', body: fd64,
        headers: { 'Accept': 'application/json', 'X-CSRF-Token': tok64 },
        credentials: 'same-origin'
      }).then(function (r) {
        return r.json().then(function (j) { return { s: r.status, j: j }; });
      }).then(function (res) {
        if (res.s >= 200 && res.s < 300 && res.j && res.j.ok && res.j.memberId) {
          window.location.hash = 'extra-' + res.j.memberId;
          window.location.reload();
        } else {
          aStatus.textContent = (res.j && res.j.error) ? res.j.error : 'তৈরি ব্যর্থ হয়েছে — আবার চেষ্টা করুন।';
          aStatus.classList.add('err');
          aSubmit.disabled = false; aSubmit.innerHTML = oldHtml64;
        }
      }).catch(function () {
        aStatus.textContent = 'নেটওয়ার্ক সমস্যা — আবার চেষ্টা করুন।';
        aStatus.classList.add('err');
        aSubmit.disabled = false; aSubmit.innerHTML = oldHtml64;
      });
    });
  });

  // Esc — খোলা ইনলাইন-এডিটর বন্ধ (পরিবর্তন না-সেভ করেই)
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var openForm = document.querySelector('.hl-slot.editing');
      if (openForm) {
        openForm.classList.remove('editing');
        openForm.querySelector('form.hl-edit').hidden = true;
        openForm.querySelector('[data-role="view"]').hidden = false;
      }
    }
  });
})();
</script>
</body>
</html>
