<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1><%= item ? 'ছবি সম্পাদনা' : 'নতুন ছবি' %></h1>
    <p><a href="/admin/gallery">← গ্যালারিতে ফিরে যান</a></p>
  </div>
  <div class="card">
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="<%= item ? '/admin/gallery/' + item.id + '?_method=PUT' : '/admin/gallery' %>" enctype="multipart/form-data">
      <div class="form-group">
        <label>ছবি আপলোড করুন</label>
        <input type="file" name="image" accept="image/*">
      </div>
      <div class="form-group">
        <label>অথবা ছবির URL</label>
        <input type="url" name="image_url" value="<%= item ? (item.image_url || '') : '' %>" placeholder="https://...">
      </div>
      <div class="form-group"><label>শিরোনাম</label><input type="text" name="title" value="<%= item ? (item.title || '') : '' %>"></div>
      <div class="form-group"><label>ক্যাপশন</label><textarea name="caption" rows="3"><%= item ? (item.caption || '') : '' %></textarea></div>
      <div class="form-group">
        <label>ক্যাটাগরি</label>
        <select name="category">
          <% [['events','ইভেন্ট'],['workshops','কর্মশালা'],['meetings','সভা'],['awards','পুরস্কার'],['press','প্রেস ও মিডিয়া'],['cultural','সাংস্কৃতিক'],['seminar','সেমিনার'],['general','সাধারণ']].forEach(([v, l]) => { %>
            <option value="<%= v %>" <%= item && item.category === v ? 'selected' : '' %>><%= l %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary"><%= item ? 'আপডেট' : 'তৈরি করুন' %></button>
    </form>
  </div>
</div>
</body>
</html>
