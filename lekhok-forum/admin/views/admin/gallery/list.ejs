<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>গ্যালারি</h1>
    <p><%= items.length %> টি ছবি | <a href="/admin/gallery/new">+ নতুন ছবি</a></p>
  </div>
  <% if (items.length === 0) { %>
    <div class="card empty">কোনো ছবি নেই</div>
  <% } else { %>
  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap:16px;">
    <% items.forEach(g => { %>
      <div class="card" style="padding:8px;">
        <img src="<%= g.image_url %>" alt="<%= g.title || '' %>" style="width:100%; height:160px; object-fit:cover; border-radius:4px;" loading="lazy" />
        <p style="font-weight:600; margin:8px 0 4px;"><%= g.title || '(শিরোনাম নেই)' %></p>
        <p style="color:#666; font-size:0.85rem; min-height:30px;"><%= g.caption || '' %></p>
        <div style="margin-top:8px; display:flex; gap:6px;">
          <a href="/admin/gallery/<%= g.id %>/edit" class="btn btn-primary btn-sm">সম্পাদনা</a>
          <form method="POST" action="/admin/gallery/<%= g.id %>?_method=DELETE" style="display:inline;" onsubmit="return confirm('মুছে ফেলতে চান?')">
            <button class="btn btn-danger btn-sm">মুছুন</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>
</div>
