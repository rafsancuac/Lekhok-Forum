<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>লেখক ফোরাম — অ্যাডমিন প্যানেল</title>
  <link rel="stylesheet" href="/assets/css/fonts.css?v=<%= AV %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/admin.css?v=<%= AV %>" />
</head>
<body>
<%- include('../partials/sidebar') %>
<div class="admin-main">
  <div class="admin-header">
    <h1>গ্যালারি</h1>
    <p><%= items.length %> টি ছবি | <a href="/admin/gallery/new">+ নতুন ছবি</a></p>
  </div>
  <% if (items.length === 0) { %>
    <div class="card empty">কোনো ছবি নেই</div>
  <% } else { %>

  <form method="POST" action="/admin/gallery/bulk-delete" class="bulk-bar" id="bulkBar">
    <span class="bulk-count"><i class="fas fa-check-double"></i> <strong>০</strong>টি সিলেক্টেড</span>
    <button type="submit" class="btn btn-danger btn-sm" data-bulk-msg="সিলেক্টেড আইটেমগুলো মুছে ফেলতে চান?"><i class="fas fa-trash"></i> মুছুন</button>
  </form>
  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap:16px;">
    <% items.forEach(g => { %>
      <div class="card" style="padding:8px; position:relative;">
        <label style="position:absolute; top:14px; left:14px; z-index:2; background:rgba(255,255,255,0.92); border:1px solid #ccd0d5; border-radius:6px; padding:4px 6px; cursor:pointer;"><input type="checkbox" name="bulk_ids" value="<%= g.id %>" style="margin:0; accent-color:#059669;"></label>
        <img src="<%= g.image_url %>" alt="<%= g.title || '' %>" style="width:100%; height:160px; object-fit:cover; border-radius:4px;" loading="lazy" />
        <p style="font-weight:600; margin:8px 0 4px;"><%= g.title || '(শিরোনাম নেই)' %></p>
        <p style="color:#666; font-size:0.85rem; min-height:30px;"><%= g.caption || '' %></p>
        <div style="margin-top:8px; display:flex; gap:6px;">
          <a href="/admin/gallery/<%= g.id %>/edit" class="btn btn-primary btn-sm">সম্পাদনা</a>
          <form method="POST" action="/admin/gallery/<%= g.id %>?_method=DELETE" style="display:inline;" onsubmit="return confirm('মুছে ফেলতে চান?')">
            <button class="btn btn-danger btn-sm">মুছুন</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>
</div>
</body>
</html>
