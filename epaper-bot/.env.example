# ── epaper-bot কনফিগ — .env.example-কে .env করে পূরণ করুন ──────────────────────
# ⚠️ আসল-সিক্রেট কখনো এই-ফাইলে লিখবেন না (GitHub-push-protection ব্লক করে) — শুধু .env-এ
# ১) টেলিগ্রাম (my.telegram.org → API development tools) — api_id + api_hash আবশ্যক
TG_API_ID=
TG_API_HASH=
TG_PHONE=01859569175
# লগইনের পরে সেশন-স্ট্রিং এখানে জমা হবে (login.ts স্বয়ংক্রিয়ভাবে লেখে)
TG_SESSION=

# ২) গুগল-ড্রাইভ OAuth — ইউজার-প্রদত্ত ক্লায়েন্ট (আসল-মান সাইট-অ্যাডমিনের .env-এ; এখানে প্লেসহোল্ডার)
GOOGLE_CLIENT_ID=আপনার-ক্লায়েন্ট-আইডি.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# `bun run token` চালিয়ে কনসেন্ট-URL ঘুরে আসা কোড দিলে রিফ্রেশ-টোকেন প্রিন্ট হবে — এখানে বসান
GOOGLE_REFRESH_TOKEN=
# আপলোডের লক্ষ্য-ফোল্ডার (খালি = ড্রাইভের রুটে 'Lekhok ePaper' ফোল্ডার তৈরি/ব্যবহার)
GOOGLE_FOLDER_ID=

# ৩) সাইট-সিঙ্ক
SITE_URL=http://localhost:8080
SITE_SYNC_TOKEN=একটি-দীর্ঘ-গোপন-টোকেন-লিখুন
# টেলিগ্রাম-সোর্স চ্যানেল
EPAPER_CHANNEL=ePaperXpress
# পোল-ইন্টারভাল (মিনিট)
POLL_MINUTES=20
