// 🚀 স্মার্ট টোস্ট নোটিফিকেশন ফাংশন 🚀
function showToast(msg, isError = false) {
    const toast = document.getElementById('homeToast');
    toast.innerHTML = isError ? `<i class="fas fa-exclamation-circle" style="color:#ef4444;"></i> ${msg}` : `<i class="fas fa-check-circle" style="color:#10b981;"></i> ${msg}`;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
}

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.continuousSwiper').forEach(function(slider) {
        new Swiper(slider, {
            slidesPerView: 2, spaceBetween: 20, loop: true, speed: 6000,
            autoplay: { delay: 0, disableOnInteraction: false }, 
            allowTouchMove: false,
            breakpoints: { 576: { slidesPerView: 2 }, 768: { slidesPerView: 2 }, 1024: { slidesPerView: 2 } } 
        });
    });

    let bdayCount = document.querySelector('.bdaySwiper') ? parseInt(document.querySelector('.bdaySwiper').getAttribute('data-count')) : 0;
    if(bdayCount > 0) {
        new Swiper(".bdaySwiper", { 
            direction: 'vertical', loop: bdayCount > 4, autoplay: { delay: 2500, disableOnInteraction: false },
            slidesPerView: Math.min(bdayCount, 4), spaceBetween: 10
        });
    }
});

function switchNoticeTab(evt, tabName) {
    var i, tabcontent, tablinks;
    tabcontent = document.getElementsByClassName("tab-content");
    for (i = 0; i < tabcontent.length; i++) { tabcontent[i].style.display = "none"; }
    tablinks = document.getElementsByClassName("tab-btn");
    for (i = 0; i < tablinks.length; i++) { tablinks[i].className = tablinks[i].className.replace(" active", ""); }
    document.getElementById(tabName).style.display = "block";
    evt.currentTarget.className += " active";
}

function submitAjaxVote(index) {
    if(document.cookie.indexOf("btclf_voted=true") !== -1) { 
        showToast('আপনি ইতিমধ্যে ভোট দিয়েছেন।', true); 
        return; 
    }
    const radios = document.querySelectorAll('input[name="poll"]'); radios[index].checked = true;
    const totalOptions = document.getElementById('surveyOptionsList').getAttribute('data-total-options') || radios.length;
    const fd = new FormData(); fd.append('action', 'btclf_submit_vote'); fd.append('option_index', index); fd.append('total_options', totalOptions);
    
    fetch('https://bycwf.org/wp-admin/admin-ajax.php', { method: 'POST', body: fd }).then(r => r.json()).then(r => {
        if(r.success) {
            document.cookie = "btclf_voted=true; max-age=31536000; path=/";
            const bars = document.querySelectorAll('.srv-bar'), texts = document.querySelectorAll('.survey-vote-percent');
            r.data.results.forEach((p, i) => { 
                bars[i].style.width = p + '%'; 
                texts[i].style.display = 'block'; 
                const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
                const toBn = n => n.toString().split('').map(d => bnDigits[d] || d).join('');
                texts[i].innerText = toBn(p) + '%'; 
                radios[i].disabled = true; 
            });
            
            const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
            const toBn = n => n.toString().split('').map(d => bnDigits[d] || d).join('');
            document.getElementById('total_vote_count').innerText = toBn(r.data.total); 
            
            showToast('ভোট গ্রহণ করা হয়েছে। ধন্যবাদ!');
        } else { 
            showToast('ভোট গ্রহণ করা যায়নি।', true); 
        }
    }).catch(() => showToast('সার্ভার সমস্যা দেখা দিয়েছে।', true));
}
