        };

        function loadDistricts() {
            const div = document.getElementById('bb_div').value;
            const distSelect = document.getElementById('bb_dist');
            distSelect.innerHTML = '<option value="">সব জেলা</option>';
            if(bdDistricts[div]) { bdDistricts[div].forEach(d => { distSelect.innerHTML += `<option value="${d}">${d}</option>`; }); } 
        }

        function openBloodBankModal() {
            document.getElementById('btclfBloodBankModal').style.display = 'flex';
            document.body.style.overflow = 'hidden'; 
        }

        function closeBloodBankModal() {
            document.getElementById('btclfBloodBankModal').style.display = 'none';
            document.body.style.overflow = 'auto'; 
        }

        document.addEventListener('DOMContentLoaded', function() {
            // 🛑 Kill Switch: আগের বিরক্তিকর পপআপ চিরতরে বন্ধ করার লজিক
            const oldModals = document.querySelectorAll('div, section');
            oldModals.forEach(el => {
                if(el.innerHTML && el.innerHTML.includes('01700000000') && el.innerHTML.includes('জরুরি ব্লাড ব্যাংক')) {
                    el.remove(); // আগের পপআপটি HTML থেকে পুরোপুরি ডিলিট করে দেবে
                }
            });

            // ব্লাড ব্যাংক লিংকে ক্লিক করার লজিক
            const allLinks = document.querySelectorAll('a, button');
            allLinks.forEach(link => {
                if((link.innerText && link.innerText.includes('ব্লাড ব্যাংক')) || link.getAttribute('href') === '#blood-bank') {
                    link.addEventListener('click', function(e) {
                        e.preventDefault(); 
                        e.stopPropagation(); // আগের কোনো স্ক্রিপ্ট কাজ করতে দেবে না
                        e.stopImmediatePropagation();
                        openBloodBankModal();
                    }, true); // true মানে সবার আগে এই ক্লিক কাজ করবে
                    link.style.cursor = 'pointer';
                }
            });
        });

        function searchBloodBank(e) {
            e.preventDefault();
            const bg = document.getElementById('bb_group').value;
            const div = document.getElementById('bb_div').value;
            const dist = document.getElementById('bb_dist').value;
            
            document.getElementById('bbResultsArea').innerHTML = '';
            document.getElementById('bbLoader').style.display = 'block';

            const fd = new FormData();
            fd.append('action', 'btclf_blood_search_ajax');
            fd.append('bg', bg);
            fd.append('div', div);
            fd.append('dist', dist);

            fetch('https://bycwf.org/wp-admin/admin-ajax.php', { method: 'POST', body: fd })
            .then(res => res.text())
            .then(html => {
                document.getElementById('bbLoader').style.display = 'none';
                document.getElementById('bbResultsArea').innerHTML = html;
            });
        }
    </script>
